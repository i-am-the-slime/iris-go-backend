-- a version asked for its least key after a later version deleted it
[(Just 1),(Just 2),(Just 4),(Just 3)]
-- every version of a fold kept, each asked for its greatest key at the end
[(Just { key: 2, value: 1 }),(Just { key: 4, value: 2 }),(Just { key: 6, value: 3 }),(Just { key: 8, value: 4 }),(Just { key: 10, value: 5 }),(Just { key: 12, value: 6 }),(Just { key: 14, value: 7 }),(Just { key: 16, value: 8 })]
-- two branches grown from one map
"(Just { key: 2, value: 4 })(Just { key: 0, value: 0 })(Just { key: 1, value: 1 })(Just { key: 2, value: 4 })"
-- a map that a closure keeps, asked for its least key after the next version is made
"(Just { key: 1, value: 1 })(Just { key: 2, value: 2 })"
-- the same map as two fields of a record, each changed on its own
"(Just { key: 5, value: 5 })(Just { key: 2, value: 2 })"
-- an ordered map in a pair whose version is read twice
"(Just { key: 2, value: 2 })(Just { key: 1, value: 1 })28"
-- a map a fold owns, shared once the fold is done
"(Just { key: 9, value: 9 })(Just { key: 9, value: 9 })(Just { key: 10, value: 10 })"
(Just { key: 20, value: 20 })
