[$&] replace    b[an]ana
[$&] replaceAll b[an][an]a
[$&] regex      b[an][an]a
$$ replace    b$ana
$$ replaceAll b$$a
$$ regex      b$$a
$` replace    bbana
$` replaceAll bbbana
$` regex      bbbana
$' replace    banaana
$' replaceAll banaaa
$' regex      banaaa
$1 replace    b$1ana
$1 replaceAll b$1$1a
$1 regex      banana
$ replace    b$ana
$ replaceAll b$$a
$ regex      b$$a
