// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

func Show(ordering Ordering) string {
	switch ordering {
	case OrderingLT:
		return "LT"
	case OrderingGT:
		return "GT"
	default: // OrderingEQ
		return "EQ"
	}
}

func AppendShowArrayOrdering(buffer []byte, array []Ordering) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShow(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShow(buffer []byte, ordering Ordering) []byte {
	switch ordering {
	case OrderingLT:
		buffer = append(buffer, "LT"...)
	case OrderingGT:
		buffer = append(buffer, "GT"...)
	default: // OrderingEQ
		buffer = append(buffer, "EQ"...)
	}
	return buffer
}

func ArrayOrdering(array []Ordering) string {
	return string(AppendShowArrayOrdering(nil, array))
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []int{1, 2, 3}
	mapped := make([]string, len(array))
	for index, n := range array {
		mapped[index] = "item" + strconv.Itoa(n)
	}
	array2 := []ordering.Ordering{ordering.OrderingLT, ordering.OrderingEQ, ordering.OrderingGT}
	mapped2 := make([]ordering.Ordering, len(array2))
	for index, reified := range array2 {
		mapped2[index] = reified
	}
	return []string{"42", "-8", "7", "erin!", "false", "false", "greater", show.ArrayString(mapped), show.ArrayString(reifiedEach(0, []string{})), ordering.ArrayOrdering(mapped2)}
}

func reifiedEach(n int, done []string) []string {
	done = slices.Clip(done)
	for {
		if n > 3 {
			return done
		}
		n, done = n+1, append(done, "n="+strconv.Itoa(n*10+n)+"n="+strconv.Itoa(n*10+1))
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
