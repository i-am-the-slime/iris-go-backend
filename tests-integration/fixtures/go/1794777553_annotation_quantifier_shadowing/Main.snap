// Data/List/Types/types.go
package types

import (
	"fixture/Data/Tuple"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/direct"
)

type ListTupleStringBoolean struct {
	Cons0 tuple.TupleStringBoolean
	Cons1 *ListTupleStringBoolean
}

var SharedListTupleStringBooleanNil = &ListTupleStringBoolean{}

type ListTupleStringString struct {
	Cons0 tuple.TupleStringString
	Cons1 *ListTupleStringString
}

var SharedListTupleStringStringNil = &ListTupleStringString{}

func Foldr(f func(tuple.TupleStringBoolean) func(*direct.ConsList[tuple.TupleStringBoolean]) *direct.ConsList[tuple.TupleStringBoolean], b *direct.ConsList[tuple.TupleStringBoolean]) func(*ListTupleStringBoolean) *direct.ConsList[tuple.TupleStringBoolean] {
	return func(x *ListTupleStringBoolean) *direct.ConsList[tuple.TupleStringBoolean] {
		return FoldrGo(f, b, MainGoGo(SharedListTupleStringBooleanNil, x))
	}
}

func Foldr2(f func(tuple.TupleStringString) func(*direct.ConsList[tuple.TupleStringString]) *direct.ConsList[tuple.TupleStringString], b *direct.ConsList[tuple.TupleStringString]) func(*ListTupleStringString) *direct.ConsList[tuple.TupleStringString] {
	return func(x *ListTupleStringString) *direct.ConsList[tuple.TupleStringString] {
		return FoldrGo2(f, b, MainGoGo2(SharedListTupleStringStringNil, x))
	}
}

func MainGoGo(b *ListTupleStringBoolean, value *ListTupleStringBoolean) *ListTupleStringBoolean {
	var listTupleStringBooleanCells alloc.Cells[ListTupleStringBoolean]
	for {
		if value == SharedListTupleStringBooleanNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		b, value = listTupleStringBooleanCells.New(ListTupleStringBoolean{Cons0: a, Cons1: b}), as
	}
}

func MainGoGo2(b *ListTupleStringString, value *ListTupleStringString) *ListTupleStringString {
	var listTupleStringStringCells alloc.Cells[ListTupleStringString]
	for {
		if value == SharedListTupleStringStringNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		b, value = listTupleStringStringCells.New(ListTupleStringString{Cons0: a, Cons1: b}), as
	}
}

func FoldrGo(f func(tuple.TupleStringBoolean) func(*direct.ConsList[tuple.TupleStringBoolean]) *direct.ConsList[tuple.TupleStringBoolean], b *direct.ConsList[tuple.TupleStringBoolean], value *ListTupleStringBoolean) *direct.ConsList[tuple.TupleStringBoolean] {
	for {
		if value == SharedListTupleStringBooleanNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		b, value = f(a)(b), as
	}
}

func FoldrGo2(f func(tuple.TupleStringString) func(*direct.ConsList[tuple.TupleStringString]) *direct.ConsList[tuple.TupleStringString], b *direct.ConsList[tuple.TupleStringString], value *ListTupleStringString) *direct.ConsList[tuple.TupleStringString] {
	for {
		if value == SharedListTupleStringStringNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		b, value = f(a)(b), as
	}
}

func MainGoGoReusing(b *ListTupleStringString, value *ListTupleStringString) *ListTupleStringString {
	for {
		if value == SharedListTupleStringStringNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		value.Cons0 = a
		value.Cons1 = b
		b, value = value, as
	}
}

func MainGoGoReusing2(b *ListTupleStringBoolean, value *ListTupleStringBoolean) *ListTupleStringBoolean {
	for {
		if value == SharedListTupleStringBooleanNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		value.Cons0 = a
		value.Cons1 = b
		b, value = value, as
	}
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

// Data/Show/show.go
package show

func Show(boolean bool) string {
	if boolean {
		return "true"
	}
	return "false"
}

// Data/Tuple/tuple.go
package tuple

type TupleStringBoolean struct {
	First  string
	Second bool
}

type TupleStringString struct {
	First  string
	Second string
}

type TupleTupleStringBooleanInt struct {
	First  TupleStringBoolean
	Second int32
}

type TupleTupleStringStringInt struct {
	First  TupleStringString
	Second int32
}

func SndStringBoolean(tuple TupleStringBoolean) bool {
	return tuple.Second
}

func SndStringString(tuple TupleStringString) string {
	return tuple.Second
}

// main.go
package main

import (
	"fixture/Data/List/Types"
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/Data/Tuple"
	"fixture/shared/Data.Tuple+Data.Maybe"
	"github.com/i-am-the-slime/iris-go/alloc"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array := []bool{true, false}
	mapped := make([]tuple.TupleStringBoolean, len(array))
	for index, boolean := range array {
		mapped[index] = tuple.TupleStringBoolean{First: "label", Second: boolean}
	}
	len_ := int32(len(mapped))
	array2 := direct.FromFoldable(func(f func(tuple.TupleStringBoolean) func(*direct.ConsList[tuple.TupleStringBoolean]) *direct.ConsList[tuple.TupleStringBoolean]) func(*direct.ConsList[tuple.TupleStringBoolean]) func(*types.ListTupleStringBoolean) *direct.ConsList[tuple.TupleStringBoolean] {
		return func(b *direct.ConsList[tuple.TupleStringBoolean]) func(*types.ListTupleStringBoolean) *direct.ConsList[tuple.TupleStringBoolean] {
			return types.Foldr(f, b)
		}
	}, mainGoReusing(mapped, len_, 0, types.SharedListTupleStringBooleanNil))
	mapped2 := make([]string, len(array2))
	for index, element := range array2 {
		mapped2[index] = show.Show(tuple.SndStringBoolean(element))
	}
	array3 := []string{"kept"}
	mapped3 := make([]tuple.TupleStringString, len(array3))
	for index, s := range array3 {
		mapped3[index] = tuple.TupleStringString{First: "label", Second: s}
	}
	len_2 := int32(len(mapped3))
	array4 := direct.FromFoldable(func(f func(tuple.TupleStringString) func(*direct.ConsList[tuple.TupleStringString]) *direct.ConsList[tuple.TupleStringString]) func(*direct.ConsList[tuple.TupleStringString]) func(*types.ListTupleStringString) *direct.ConsList[tuple.TupleStringString] {
		return func(b *direct.ConsList[tuple.TupleStringString]) func(*types.ListTupleStringString) *direct.ConsList[tuple.TupleStringString] {
			return types.Foldr2(f, b)
		}
	}, mainGoReusing2(mapped3, len_2, 0, types.SharedListTupleStringStringNil))
	mapped4 := make([]string, len(array4))
	for index, element := range array4 {
		mapped4[index] = tuple.SndStringString(element)
	}
	return arraypkg.Append(mapped2, mapped4)
}

func mainGoReusing(xs []tuple.TupleStringBoolean, len_ int32, source int32, memo *types.ListTupleStringBoolean) *types.ListTupleStringBoolean {
	var listTupleStringBooleanCells alloc.Cells[types.ListTupleStringBoolean]
	for {
		var result tuple_maybe.MaybeTupleTupleStringBooleanInt
		if source < len_ {
			result = tuple_maybe.JustTupleTupleStringBooleanInt(tuple.TupleTupleStringBooleanInt{First: xs[source], Second: source + 1})
		} else {
			result = tuple_maybe.NoTupleTupleStringBooleanInt
		}
		if result.Tag == maybe.TagNothing {
			return types.MainGoGoReusing2(types.SharedListTupleStringBooleanNil, memo)
		}
		source, memo = result.Just.Second, listTupleStringBooleanCells.New(types.ListTupleStringBoolean{Cons0: result.Just.First, Cons1: memo})
	}
}

func mainGoReusing2(xs []tuple.TupleStringString, len_ int32, source int32, memo *types.ListTupleStringString) *types.ListTupleStringString {
	var listTupleStringStringCells alloc.Cells[types.ListTupleStringString]
	for {
		var result tuple_maybe.MaybeTupleTupleStringStringInt
		if source < len_ {
			result = tuple_maybe.JustTupleTupleStringStringInt(tuple.TupleTupleStringStringInt{First: xs[source], Second: source + 1})
		} else {
			result = tuple_maybe.NoTupleTupleStringStringInt
		}
		if result.Tag == maybe.TagNothing {
			return types.MainGoGoReusing(types.SharedListTupleStringStringNil, memo)
		}
		source, memo = result.Just.Second, listTupleStringStringCells.New(types.ListTupleStringString{Cons0: result.Just.First, Cons1: memo})
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/Data.Tuple+Data.Maybe/tuple_maybe.go
package tuple_maybe

import (
	"fixture/Data/Maybe"
	"fixture/Data/Tuple"
)

type MaybeTupleTupleStringBooleanInt struct {
	Just tuple.TupleTupleStringBooleanInt
	Tag  uint8
}

func JustTupleTupleStringBooleanInt(just tuple.TupleTupleStringBooleanInt) MaybeTupleTupleStringBooleanInt {
	return MaybeTupleTupleStringBooleanInt{Tag: maybe.TagJust, Just: just}
}

var NoTupleTupleStringBooleanInt = MaybeTupleTupleStringBooleanInt{Tag: maybe.TagNothing}

type MaybeTupleTupleStringStringInt struct {
	Just tuple.TupleTupleStringStringInt
	Tag  uint8
}

func JustTupleTupleStringStringInt(just tuple.TupleTupleStringStringInt) MaybeTupleTupleStringStringInt {
	return MaybeTupleTupleStringStringInt{Tag: maybe.TagJust, Just: just}
}

var NoTupleTupleStringStringInt = MaybeTupleTupleStringStringInt{Tag: maybe.TagNothing}
