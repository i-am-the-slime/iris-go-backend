// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

// Foreign/foreign.go
package foreign

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"math"
	"strconv"
)

type ForeignError struct {
	Field0           string
	Field1           string
	ErrorAtIndex1    *ForeignError
	ErrorAtProperty0 string
	ErrorAtProperty1 *ForeignError
	ErrorAtIndex0    int
	Tag              uint8
}

const (
	ForeignErrorForeignError = iota
	ForeignErrorTypeMismatch
	ForeignErrorErrorAtIndex
	ForeignErrorErrorAtProperty
)

type List struct {
	Cons0 *ForeignError
	Cons1 *List
}

var SharedListNil = &List{}

type NonEmpty struct {
	First  *ForeignError
	Second *List
}

type Either struct {
	Left  NonEmpty
	Right int
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func ShowNonEmptyListForeignError(errors NonEmpty) string {
	shown := []string{Show(errors.First)}
	cell := errors.Second
	for {
		if cell == SharedListNil {
			break
		}
		shown = append(shown, Show(cell.Cons0))
		cell = cell.Cons1
	}
	return foreignvalue.ShowErrors(shown)
}

type NonEmptyFailure struct {
	Failed bool
	Left   NonEmpty
}

func TypeMismatch(field0 string, field1 string) *ForeignError {
	return &ForeignError{Tag: ForeignErrorTypeMismatch, Field0: field0, Field1: field1}
}

func ReadInt(value any) (int, NonEmptyFailure) {
	if foreignvalue.TagOf(value) == "Number" {
		number := foreignvalue.Number(value)
		var integer maybe.Int
		if math.Trunc(number) == number && (number >= math.MinInt && number < -math.MinInt) {
			integer = maybe.JustInt(int(number))
		} else {
			integer = maybe.NoInt
		}
		switch integer.Tag {
		case maybe.TagNothing:
			return 0, NonEmptyFailure{Failed: true, Left: NonEmpty{First: TypeMismatch("Int", foreignvalue.TagOf(value)), Second: SharedListNil}}
		default: // maybe.TagJust
			return integer.Just, NonEmptyFailure{}
		}
	}
	return 0, NonEmptyFailure{Failed: true, Left: NonEmpty{First: TypeMismatch("Int", foreignvalue.TagOf(value)), Second: SharedListNil}}
}

func Show(foreignError *ForeignError) string {
	return string(AppendShow(nil, foreignError))
}

func AppendShow(buffer []byte, foreignError *ForeignError) []byte {
	switch foreignError.Tag {
	case ForeignErrorForeignError:
		buffer = append(buffer, "(ForeignError "...)
		buffer = prim.AppendShowString(buffer, foreignError.Field0)
		buffer = append(buffer, ')')
	case ForeignErrorErrorAtIndex:
		buffer = append(buffer, "(ErrorAtIndex "...)
		buffer = strconv.AppendInt(buffer, int64(foreignError.ErrorAtIndex0), 10)
		buffer = append(buffer, ' ')
		buffer = AppendShow(buffer, foreignError.ErrorAtIndex1)
		buffer = append(buffer, ')')
	case ForeignErrorErrorAtProperty:
		buffer = append(buffer, "(ErrorAtProperty "...)
		buffer = prim.AppendShowString(buffer, foreignError.ErrorAtProperty0)
		buffer = append(buffer, ' ')
		buffer = AppendShow(buffer, foreignError.ErrorAtProperty1)
		buffer = append(buffer, ')')
	default: // ForeignErrorTypeMismatch
		buffer = append(buffer, "(TypeMismatch "...)
		buffer = prim.AppendShowString(buffer, foreignError.Field0)
		buffer = append(buffer, ' ')
		buffer = prim.AppendShowString(buffer, foreignError.Field1)
		buffer = append(buffer, ')')
	}
	return buffer
}

// main.go
package main

import (
	"fixture/Foreign"
	journal "fixture/Journal_ffi"
	"strconv"
)

func main() {
	ref := foreign.ReadInt
	i, err := ref(int(42))
	var result string
	if err.Failed {
		result = "failed: " + foreign.ShowNonEmptyListForeignError(err.Left)
	} else {
		result = strconv.Itoa(i)
	}
	journal.Log(result)
	i2, err := ref("forty-two")
	var result2 string
	if err.Failed {
		result2 = "failed: " + foreign.ShowNonEmptyListForeignError(err.Left)
	} else {
		result2 = strconv.Itoa(i2)
	}
	journal.Log(result2)
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}
