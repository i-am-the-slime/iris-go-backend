// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	accumulator := []int{0, 0, 0, 0, 0, 0}
	accumulator = slices.Clone(accumulator)
	for element := 0; element < 5; element++ {
		accumulator = overwriteOwning(accumulator, element)
	}
	return []string{show.ArrayInt(accumulator), show.ArrayInt([]int{0, 3, 0, 0, 0, 0}), show.ArrayInt([]int{0, 0, 0, 0, 0, 0})}
}

func overwriteOwning(current []int, position int) []int {
	if position < len(current) {
		value := position * 3
		updated := current
		updated[position] = value
		return updated
	}
	return current
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
