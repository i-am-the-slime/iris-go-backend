// Data/Eq/eq.go
package eq

func Eq(i int, i2 int) bool {
	return i == i2
}

// Effect/Exception/exception.go
package effectexception

import "github.com/i-am-the-slime/iris-go/exception"

func Throw(x string) {
	panic(exception.NewError(x))
}

// main.go
package main

import (
	actions "fixture/Actions_ffi"
	"fixture/Data/Eq"
	"fixture/Effect/Exception"
	"github.com/i-am-the-slime/iris-go/array"
)

func main() {
	accumulator := 0
	for value := 1; value < 101; value++ {
		accumulator += value
	}
	accumulator2 := 0
	for value := 1; value < 11; value++ {
		accumulator2 += value
	}
	if !array.Eq(eq.Eq, []int{accumulator, accumulator2}, []int{5050, 55}) {
		effectexception.Throw("the deferred values are wrong")
	}
	bound := actions.RunWhenAsked(func() int {
		accumulator3 := 0
		for value := 1; value < 11; value++ {
			accumulator3 += value
		}
		return accumulator3
	})
	mapped := actions.RunWhenAsked(func() int {
		accumulator3 := 0
		for value := 1; value < 21; value++ {
			accumulator3 += value
		}
		return accumulator3
	})
	free := actions.RunWhenAsked(answer)
	if !array.Eq(eq.Eq, []int{bound, mapped, free}, []int{55, 210, 42}) {
		effectexception.Throw("the continued values are wrong")
	}
	if !array.Eq(eq.Eq, array.Append(shifted(10, []int{1, 2}), shifted(4, []int{1})), []int{56, 57, 11}) {
		effectexception.Throw("the shifted values are wrong")
	}
	checked(10, []int{1, 2})
	checked(4, []int{1, 2})
}

func answer() int {
	return 42
}

func shifted(n int, array2 []int) []int {
	mapped := make([]int, len(array2))
	step, count := array.RangeSteps(1, n)
	for index, x := range array2 {
		accumulator := 0
		for index2 := range count {
			value := 1 + index2*step
			accumulator += value
		}
		mapped[index] = x + accumulator
	}
	return mapped
}

func checked(n int, xs []int) {
	step, count := array.RangeSteps(1, n)
	for _, i := range xs {
		accumulator := 0
		for index := range count {
			value := 1 + index*step
			accumulator += value
		}
		if i+accumulator < 0 {
			effectexception.Throw("negative")
		}
	}
}
