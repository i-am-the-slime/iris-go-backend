---
source: tests-integration/src/fixtures.rs
---
// Data/Eq/eq.go
package eq

func Eq(i int32, i2 int32) bool {
	return i == i2
}

// Effect/Exception/exception.go
package effectexception

import "github.com/i-am-the-slime/iris-go/exception"

func ThrowUnit(x string) {
	panic(exception.NewError(x))
}

// main.go
package main

import (
	actions "fixture/Actions_ffi"
	"fixture/Data/Eq"
	"fixture/Effect/Exception"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
)

func main() {
	array := arraypkg.Map(func(n int32) func(struct{}) int32 {
		return func(ignored struct{}) int32 {
			return deferred(n, ignored)
		}
	}, []int32{100, 10})
	mapped := make([]int32, len(array))
	for index, element := range array {
		mapped[index] = forceInt(element)
	}
	if !arraypkg.Eq(eq.Eq, mapped, []int32{5050, 55}) {
		effectexception.ThrowUnit("the deferred values are wrong")
	}
	bound := actions.RunWhenAsked(func() int32 {
		var accumulator int32 = 0
		for value := int32(1); value < 11; value++ {
			accumulator += value
		}
		return accumulator
	})
	mapped2 := actions.RunWhenAsked(func() int32 {
		var accumulator int32 = 0
		for value := int32(1); value < 21; value++ {
			accumulator += value
		}
		return accumulator
	})
	free := actions.RunWhenAsked(answer)
	if !arraypkg.Eq(eq.Eq, []int32{bound, mapped2, free}, []int32{55, 210, 42}) {
		effectexception.ThrowUnit("the continued values are wrong")
	}
	if !arraypkg.Eq(eq.Eq, arraypkg.Append(shifted(10, []int32{1, 2}), shifted(4, []int32{1})), []int32{56, 57, 11}) {
		effectexception.ThrowUnit("the shifted values are wrong")
	}
	checked(10, []int32{1, 2})
	checked(4, []int32{1, 2})
}

func deferred(n int32, ignored struct{}) int32 {
	step, count := arraypkg.RangeSteps(1, n)
	var accumulator int32 = 0
	for index := range count {
		value := 1 + int32(index)*step
		accumulator += value
	}
	return accumulator
}

func forceInt(later func(struct{}) int32) int32 {
	return later(struct{}{})
}

func answer() int32 {
	return 42
}

func shifted(n int32, array []int32) []int32 {
	mapped := make([]int32, len(array))
	step, count := arraypkg.RangeSteps(1, n)
	for index, x := range array {
		var accumulator int32 = 0
		for index2 := range count {
			value := 1 + int32(index2)*step
			accumulator += value
		}
		mapped[index] = x + accumulator
	}
	return mapped
}

func checked(n int32, xs []int32) {
	step, count := arraypkg.RangeSteps(1, n)
	for _, i := range xs {
		var accumulator int32 = 0
		for index := range count {
			value := 1 + int32(index)*step
			accumulator += value
		}
		if i+accumulator < 0 {
			effectexception.ThrowUnit("negative")
		}
	}
}
