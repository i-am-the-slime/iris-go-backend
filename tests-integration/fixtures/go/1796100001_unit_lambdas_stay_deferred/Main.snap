// Data/Eq/eq.go
package eq

func Eq(i int32, i2 int32) bool {
	return i == i2
}

// Effect/Exception/exception.go
package effectexception

import "github.com/i-am-the-slime/iris-go/exception"

func ThrowUnit(x string) {
	panic(exception.NewError(x))
}

// main.go
package main

import (
	"fixture/Actions_ffi"
	"fixture/Data/Eq"
	"fixture/Effect/Exception"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
)

func main() {
	array := arraypkg.Map(func(n int32) func(struct{}) int32 {
		return func(ignored struct{}) int32 {
			return deferred(n, ignored)
		}
	}, []int32{100, 10})
	mapped := make([]int32, len(array))
	for index, element := range array {
		mapped[index] = forceInt(element)
	}
	if arraypkg.Eq(eq.Eq, mapped, []int32{5050, 55}) == false {
		effectexception.ThrowUnit("the deferred values are wrong")
	}
	bound := Actions_ffi.RunWhenAsked(func() int32 {
		var accumulator int32 = 0
		for value := int32(1); value < 11; value++ {
			accumulator += value
		}
		return accumulator
	})
	mapped2 := Actions_ffi.RunWhenAsked(func() int32 {
		var accumulator int32 = 0
		for value := int32(1); value < 21; value++ {
			accumulator += value
		}
		return accumulator
	})
	free := Actions_ffi.RunWhenAsked(answer)
	if arraypkg.Eq(eq.Eq, []int32{bound, mapped2, free}, []int32{55, 210, 42}) == false {
		effectexception.ThrowUnit("the continued values are wrong")
	}
	array2 := []int32{1, 2}
	mapped3 := make([]int32, len(array2))
	for index, x := range array2 {
		var accumulator int32 = 0
		for value := int32(1); value < 11; value++ {
			accumulator += value
		}
		mapped3[index] = x + accumulator
	}
	array3 := []int32{1}
	mapped4 := make([]int32, len(array3))
	for index, x := range array3 {
		var accumulator int32 = 0
		for value := int32(1); value < 5; value++ {
			accumulator += value
		}
		mapped4[index] = x + accumulator
	}
	if arraypkg.Eq(eq.Eq, arraypkg.Append(mapped3, mapped4), []int32{56, 57, 11}) == false {
		effectexception.ThrowUnit("the shifted values are wrong")
	}
	for _, i := range []int32{1, 2} {
		var accumulator int32 = 0
		for value := int32(1); value < 11; value++ {
			accumulator += value
		}
		if i+accumulator < 0 {
			effectexception.ThrowUnit("negative")
		}
	}
	for _, i := range []int32{1, 2} {
		var accumulator int32 = 0
		for value := int32(1); value < 5; value++ {
			accumulator += value
		}
		if i+accumulator < 0 {
			effectexception.ThrowUnit("negative")
		}
	}
}

func deferred(n int32, ignored struct{}) int32 {
	step, count := arraypkg.RangeSteps(1, n)
	var accumulator int32 = 0
	for index := range count {
		value := 1 + int32(index)*step
		accumulator += value
	}
	return accumulator
}

func forceInt(later func(struct{}) int32) int32 {
	return later(struct{}{})
}

func answer() int32 {
	return 42
}
