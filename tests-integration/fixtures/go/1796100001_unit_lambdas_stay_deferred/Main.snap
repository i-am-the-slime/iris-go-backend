source: tests-integration/src/fixtures.rs
---
// Data/Eq/eq.go
package eq

func Eq(i int, i2 int) bool {
	return i == i2
}

// Effect/Exception/exception.go
package effectexception

import "github.com/i-am-the-slime/iris-go/exception"

func Throw(x string) {
	panic(exception.NewError(x))
}

// main.go
package main

import (
	actions "fixture/Actions_ffi"
	"fixture/Data/Eq"
	"fixture/Effect/Exception"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
)

func main() {
	array := arraypkg.Map(func(n int) func(struct{}) int {
		return func(ignored struct{}) int {
			return deferred(n, ignored)
		}
	}, []int{100, 10})
	mapped := make([]int, len(array))
	for index, element := range array {
		mapped[index] = force(element)
	}
	if !arraypkg.Eq(eq.Eq, mapped, []int{5050, 55}) {
		effectexception.Throw("the deferred values are wrong")
	}
	bound := actions.RunWhenAsked(func() int {
		accumulator := 0
		for value := 1; value < 11; value++ {
			accumulator += value
		}
		return accumulator
	})
	mapped2 := actions.RunWhenAsked(func() int {
		accumulator := 0
		for value := 1; value < 21; value++ {
			accumulator += value
		}
		return accumulator
	})
	free := actions.RunWhenAsked(answer)
	if !arraypkg.Eq(eq.Eq, []int{bound, mapped2, free}, []int{55, 210, 42}) {
		effectexception.Throw("the continued values are wrong")
	}
	if !arraypkg.Eq(eq.Eq, arraypkg.Append(shifted(10, []int{1, 2}), shifted(4, []int{1})), []int{56, 57, 11}) {
		effectexception.Throw("the shifted values are wrong")
	}
	checked(10, []int{1, 2})
	checked(4, []int{1, 2})
}

func deferred(n int, ignored struct{}) int {
	step, count := arraypkg.RangeSteps(1, n)
	accumulator := 0
	for index := range count {
		value := 1 + index*step
		accumulator += value
	}
	return accumulator
}

func force(later func(struct{}) int) int {
	return later(struct{}{})
}

func answer() int {
	return 42
}

func shifted(n int, array []int) []int {
	mapped := make([]int, len(array))
	step, count := arraypkg.RangeSteps(1, n)
	for index, x := range array {
		accumulator := 0
		for index2 := range count {
			value := 1 + index2*step
			accumulator += value
		}
		mapped[index] = x + accumulator
	}
	return mapped
}

func checked(n int, xs []int) {
	step, count := arraypkg.RangeSteps(1, n)
	for _, i := range xs {
		accumulator := 0
		for index := range count {
			value := 1 + index*step
			accumulator += value
		}
		if i+accumulator < 0 {
			effectexception.Throw("negative")
		}
	}
}
