// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Show"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"strconv"
	"strings"
)

type ShapeNonEmptyArrayInt struct {
	Shape string
	Value []int
}

type ShapeFnIntNonEmptyArrayInt struct {
	Shape string
	Value func(int) []int
}

var main_ = initializeMain_()

func initializeMain_() []string {
	text := []byte("(NonEmptyArray ")
	text = show.AppendShowArrayInt(text, traverse1Function2([]int{1, 2, 3}).Value)
	text = append(text, ')')
	return []string{traverse1Function([]int{1}).Shape, traverse1Function([]int{1, 2}).Shape, traverse1Function([]int{1, 2, 3, 4, 5}).Shape, string(text)}
}

func traverse1Function(array2 []int) ShapeNonEmptyArrayInt {
	append_ := direct.Appender[int]()
	x := array2[0]
	array := arraypkg.Slice(1, len(array2), array2)
	accumulator := ShapeNonEmptyArrayInt{Shape: strconv.Itoa(x), Value: []int{x}}
	for _, element := range array {
		shapeFnIntNonEmptyArrayInt := ShapeFnIntNonEmptyArrayInt{Shape: accumulator.Shape, Value: append_(accumulator.Value)}
		accumulator = ShapeNonEmptyArrayInt{Shape: "(" + shapeFnIntNonEmptyArrayInt.Shape + " " + strconv.Itoa(element) + ")", Value: shapeFnIntNonEmptyArrayInt.Value(element)}
	}
	return accumulator
}

func traverse1Function2(array2 []int) ShapeNonEmptyArrayInt {
	append_ := direct.Appender[int]()
	array := arraypkg.Slice(1, len(array2), array2)
	accumulator := ShapeNonEmptyArrayInt{Shape: "", Value: []int{array2[0] * 10}}
	for _, element := range array {
		shapeFnIntNonEmptyArrayInt := ShapeFnIntNonEmptyArrayInt{Shape: accumulator.Shape, Value: append_(accumulator.Value)}
		accumulator = ShapeNonEmptyArrayInt{Shape: "(" + shapeFnIntNonEmptyArrayInt.Shape + " )", Value: shapeFnIntNonEmptyArrayInt.Value(element * 10)}
	}
	return accumulator
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
