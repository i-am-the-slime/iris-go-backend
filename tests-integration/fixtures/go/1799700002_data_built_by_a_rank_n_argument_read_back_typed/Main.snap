// main.go
package main

import journal "fixture/Journal_ffi"

type Pair struct {
	Second string
	First  int
}

type AwaitInt struct {
	Await func(int) int
}

type Await struct {
	Await func(int) any
}

func convert(value AwaitInt) *Await {
	return &Await{Await: func(coerced int) any {
		return value.Await(coerced)
	}}
}

type EmitString struct {
	Second string
	First  int
}

type Emit struct {
	Second any
	First  int
}

func convert2(value EmitString) *Emit {
	return &Emit{First: value.First, Second: value.Second}
}

func main() {
	times := journal.Count()
	journal.Log(mainGo(Pair{First: times, Second: "apples"})(struct{}{}))
}

func mainGo(pair Pair) func(struct{}) string {
	times := pair.First
	name := pair.Second
	if times > 0 {
		scrutinee := convert(AwaitInt{Await: func(value int) int {
			return value - 1
		}})
		scrutinee2 := convert2(EmitString{First: times, Second: name + "!"})
		pair2 := Pair{First: scrutinee.Await(scrutinee2.First).(int), Second: scrutinee2.Second.(string)}
		return func(_ struct{}) string {
			return mainGo(pair2)(struct{}{})
		}
	}
	return func(_ struct{}) string {
		return name
	}
}
