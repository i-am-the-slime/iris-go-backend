// main.go
package main

import (
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/array"
	"strconv"
)

func main() {
	journal.Log(strconv.Itoa(mainGo(0, array.Range(1, 1000))))
	journal.Log(strconv.Itoa(mainGo2(0, []int{3, 1, 4, 1, 5})))
}

func mainGo(total int, rest []int) int {
	for {
		if len(rest) == 0 {
			return total
		}
		total, rest = total+rest[0], array.Tail(rest)
	}
}

func mainGo2(weighted int, rest []int) int {
	for {
		if len(rest) == 0 {
			return weighted
		}
		index := len(rest) - 1
		if index >= 0 {
			weighted, rest = weighted*10+rest[index], array.Slice(0, len(rest)-1, rest)
			continue
		}
		return weighted
	}
}
