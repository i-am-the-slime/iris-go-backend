// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type IdentityOfString struct {
	Second string
	First  int
}

type IdentityOfUnit struct {
	Second struct{}
	First  int
}

var main_ = initializeMain_()

func initializeMain_() []int {
	updated := IdentityOfString{First: 1, Second: "s"}
	updated.First = 99
	updated2 := IdentityOfUnit{First: 0, Second: struct{}{}}
	updated2.First = 3
	return []int{updated.First, 7, updated2.First}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
