// Data/Either/either.go
package either

type Either struct {
	Right struct{}
	Left  string
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type StringFailure struct {
	Failed bool
	Left   string
}

// main.go
package main

import (
	"fixture/Data/Either"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"strconv"
)

func main() {
	sent := &shared.Ref[int]{Value: 0}
	ref := &shared.Ref[int]{Value: 0}
	ref2 := &shared.Ref[int]{Value: 500}
	foldPulledFPull2(sent, ref2, ref, 1000, struct{}{})
	total := sent.Value
	journal.Log(strconv.Itoa(total))
	sent2 := &shared.Ref[int]{Value: 0}
	foldPulledFPull(sent2, struct{}{})
	none := sent2.Value
	journal.Log(strconv.Itoa(none))
}

func foldPulledFPull(ref *shared.Ref[int], context struct{}) (struct{}, either.StringFailure) {
	return struct{}{}, either.StringFailure{}
}

func foldPulledFPull2(ref *shared.Ref[int], ref2 *shared.Ref[int], ref3 *shared.Ref[int], i int, context struct{}) (struct{}, either.StringFailure) {
	for {
		i2 := ref2.Value
		if i2 <= 0 {
			return struct{}{}, either.StringFailure{}
		}
		i3 := ref3.Value
		if i3 >= i {
			return struct{}{}, either.StringFailure{}
		}
		y := i3 + 64
		stop := min(i, y)
		ref3.Value = stop
		var whole int
		if i3 < stop {
			whole = stop - i3
		} else {
			whole = i3 - stop + 2
		}
		taken := min(i2, whole)
		length := max(taken, 0)
		var step int
		if i3 < stop {
			step = 1
		} else {
			step = -1
		}
		ref2.Value = i2 - length
		var err either.StringFailure
		index := 0
	foldPulledFPullFrom:
		for {
			if index >= 0 && index < length {
				tripled := (i3 + index*step) * 3
				s := ref.Value
				s_ := s + tripled
				ref.Value = s_
				index += 1
				continue
			}
			err = either.StringFailure{}
			break foldPulledFPullFrom
		}
		if err.Failed {
			return struct{}{}, err
		}
		continue
	}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
