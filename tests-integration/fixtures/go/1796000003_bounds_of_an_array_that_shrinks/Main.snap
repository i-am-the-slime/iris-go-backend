// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	result := *array.Thaw([]int{1, 5, 2, 7, 3})
	size := len(result)
	for i := 0; i < size; i++ {
		within := i < len(result)
		var i2 int
		if within {
			i2 = result[i]
		} else {
			i2 = -1
		}
		if i2 > 2 {
			if len(result) > 0 {
				result = shared.WithoutLast(result)
			}
		}
		if i < len(result) {
			result[i] = i2 * 10
		}
	}
	performed := shared.Frozen(result)
	result2 := *array.Thaw([]int{1, 2})
	size2 := len(result2)
	end := size2 * 2
	for i := 0; i < end; i++ {
		within := i < len(result2)
		var i2 int
		if within {
			i2 = result2[i]
		} else {
			i2 = 0
		}
		result2 = append(result2, i2+1)
	}
	performed2 := shared.Frozen(result2)
	return array.Append(performed, performed2)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func WithoutLast[T any](elements []T) []T {
	var zero T
	elements[len(elements)-1] = zero
	return elements[:len(elements)-1]
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
