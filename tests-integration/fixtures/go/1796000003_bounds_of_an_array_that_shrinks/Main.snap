// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{1, 5, 2, 7, 3})()
	size := int32(len(*array2))
	for i := int32(0); i < size; i++ {
		within := int(i) < len(*array2)
		var i2 int32
		if within {
			i2 = (*array2)[i]
		} else {
			i2 = -1
		}
		if i2 > 2 {
			array.Pop(func(payload int32) maybe.Int {
				return maybe.Int(payload)
			}, maybe.NoInt, array2)()
		}
		if int(i) < len(*array2) {
			(*array2)[i] = i2 * 10
		}
	}
	performed := array.UnsafeFreeze(array2)()
	array3 := array.Thaw([]int32{1, 2})()
	size2 := int32(len(*array3))
	end := size2 * 2
	for i := int32(0); i < end; i++ {
		within := int(i) < len(*array3)
		var i2 int32
		if within {
			i2 = (*array3)[i]
		} else {
			i2 = 0
		}
		*array3 = array.Bounded(append(*array3, i2+1))
	}
	performed2 := array.UnsafeFreeze(array3)()
	return array.Append(performed, performed2)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
