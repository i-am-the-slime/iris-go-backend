// main.go
package main

import "fmt"

type TreeInt struct {
	Pair any
	Leaf int32
	Tag  uint8
}

const (
	TreeIntLeaf = iota
	TreeIntPair
)

type TreeFnIntInt struct {
	Leaf func(int32) int32
	Pair any
	Tag  uint8
}

const (
	TreeFnIntIntLeaf = iota
	TreeFnIntIntPair
)

type PairEIntInt struct {
	First  TreeFnIntInt
	Second TreeInt
}

type TreeFn struct {
	Leaf func(any) any
	Pair any
	Tag  uint8
}

const (
	TreeFnLeaf = iota
	TreeFnPair
)

type Tree struct {
	Field0 any
	Tag    uint8
}

const (
	TreeLeaf = iota
	TreePair
)

type PairE struct {
	First  *TreeFn
	Second *Tree
}

func convert(value TreeFnIntInt) *TreeFn {
	switch value.Tag {
	case TreeFnIntIntLeaf:
		return &TreeFn{Tag: TreeFnLeaf, Leaf: func(coerced any) any {
			return value.Leaf(coerced.(int32))
		}}
	default: // TreeFnIntIntPair
		return &TreeFn{Tag: TreeFnPair, Pair: value.Pair}
	}
}

func convert2(value TreeInt) *Tree {
	switch value.Tag {
	case TreeIntLeaf:
		return &Tree{Tag: TreeLeaf, Field0: value.Leaf}
	default: // TreeIntPair
		return &Tree{Tag: TreePair, Field0: value.Pair}
	}
}

func convert3(value PairEIntInt) *PairE {
	return &PairE{First: convert(value.First), Second: convert2(value.Second)}
}

type TreeFnIntFnIntInt struct {
	Leaf func(int32) func(int32) int32
	Pair any
	Tag  uint8
}

const (
	TreeFnIntFnIntIntLeaf = iota
	TreeFnIntFnIntIntPair
)

type PairEFnIntIntInt struct {
	First  TreeFnIntFnIntInt
	Second TreeInt
}

func convert4(value TreeFnIntFnIntInt) *TreeFn {
	switch value.Tag {
	case TreeFnIntFnIntIntLeaf:
		return &TreeFn{Tag: TreeFnLeaf, Leaf: func(coerced2 any) any {
			original := value.Leaf(coerced2.(int32))
			return func(coerced3 any) any {
				return original(coerced3.(int32))
			}
		}}
	default: // TreeFnIntFnIntIntPair
		return &TreeFn{Tag: TreeFnPair, Pair: value.Pair}
	}
}

func convert5(value PairEFnIntIntInt) *PairE {
	return &PairE{First: convert4(value.First), Second: convert2(value.Second)}
}

type TreeFnInt struct {
	Leaf func(any) int32
	Pair any
	Tag  uint8
}

const (
	TreeFnIntLeaf = iota
	TreeFnIntPair
)

type PairEInt struct {
	First  *TreeFnInt
	Second *Tree
}

func convert6(value *TreeFn) *TreeFnInt {
	switch value.Tag {
	case TreeFnLeaf:
		return &TreeFnInt{Tag: TreeFnIntLeaf, Leaf: func(coerced any) int32 {
			return value.Leaf(coerced).(int32)
		}}
	default: // TreeFnPair
		return &TreeFnInt{Tag: TreeFnIntPair, Pair: value.Pair}
	}
}

func convert7(value *PairE) *PairEInt {
	return &PairEInt{First: convert6(value.First), Second: value.Second}
}

func convert8(value *TreeFnInt) *Tree {
	switch value.Tag {
	case TreeFnIntLeaf:
		return &Tree{Tag: TreeLeaf, Field0: func(coerced4 any) any {
			return value.Leaf(coerced4)
		}}
	default: // TreeFnIntPair
		return &Tree{Tag: TreePair, Field0: value.Pair}
	}
}

func convert9(value *TreeFn) *Tree {
	switch value.Tag {
	case TreeFnLeaf:
		return &Tree{Tag: TreeLeaf, Field0: value.Leaf}
	default: // TreeFnPair
		return &Tree{Tag: TreePair, Field0: value.Pair}
	}
}

var main_ []int32 = []int32{leavesInt(TreeInt{Tag: TreeIntLeaf, Leaf: 1}), leavesInt(TreeInt{Tag: TreeIntPair, Pair: convert3(PairEIntInt{First: TreeFnIntInt{Tag: TreeFnIntIntLeaf, Leaf: func(value int32) int32 {
	return value + 1
}}, Second: TreeInt{Tag: TreeIntLeaf, Leaf: 1}})}), leavesInt(TreeInt{Tag: TreeIntPair, Pair: convert3(PairEIntInt{First: TreeFnIntInt{Tag: TreeFnIntIntPair, Pair: convert5(PairEFnIntIntInt{First: TreeFnIntFnIntInt{Tag: TreeFnIntFnIntIntLeaf, Leaf: func(x int32) func(int32) int32 {
	return func(y int32) int32 {
		return x + y
	}
}}, Second: TreeInt{Tag: TreeIntLeaf, Leaf: 1}})}, Second: TreeInt{Tag: TreeIntLeaf, Leaf: 2}})})}

func leavesInt(argument1 TreeInt) int32 {
	return leavesIntGo(0, argument1)
}

func leavesIntGo(argument0 int32, argument1 TreeInt) int32 {
	switch argument1.Tag {
	case TreeIntLeaf:
		return argument0 + 1
	default: // TreeIntPair
		scrutinee := convert7(argument1.Pair.(*PairE))
		original := func(argument02 int32) func(*Tree) int32 {
			return func(argument12 *Tree) int32 {
				return leavesIntGo2(argument02, argument12)
			}
		}
		return func(coerced2 int32) func(*TreeFnInt) int32 {
			original2 := original(coerced2)
			return func(coerced3 *TreeFnInt) int32 {
				return original2(convert8(coerced3))
			}
		}(argument0 + 1)(scrutinee.First) + leavesIntGo3(argument0 + 1, scrutinee.Second)
	}
}

func leavesIntGo2(argument0 int32, argument1 *Tree) int32 {
	switch argument1.Tag {
	case TreeLeaf:
		return argument0 + 1
	default: // TreePair
		scrutinee := argument1.Field0.(*PairE)
		original := func(argument02 int32) func(*Tree) int32 {
			return func(argument12 *Tree) int32 {
				return leavesIntGo2(argument02, argument12)
			}
		}
		return func(coerced int32) func(*TreeFn) int32 {
			original2 := original(coerced)
			return func(coerced2 *TreeFn) int32 {
				return original2(convert9(coerced2))
			}
		}(argument0 + 1)(scrutinee.First) + leavesIntGo3(argument0 + 1, scrutinee.Second)
	}
}

func leavesIntGo3(argument0 int32, argument1 *Tree) int32 {
	switch argument1.Tag {
	case TreeLeaf:
		return argument0 + 1
	default: // TreePair
		scrutinee := argument1.Field0.(*PairE)
		original := func(argument02 int32) func(*Tree) int32 {
			return func(argument12 *Tree) int32 {
				return leavesIntGo2(argument02, argument12)
			}
		}
		return func(coerced int32) func(*TreeFn) int32 {
			original2 := original(coerced)
			return func(coerced2 *TreeFn) int32 {
				return original2(convert9(coerced2))
			}
		}(argument0 + 1)(scrutinee.First) + leavesIntGo3(argument0 + 1, scrutinee.Second)
	}
}

func main() {
	fmt.Println(main_)
}
