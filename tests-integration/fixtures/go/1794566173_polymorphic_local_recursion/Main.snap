// Data/Exists/exists.go
package exists

type ExistsPairEFnIntFnIntInt uint8

func Convert(value ExistsPairEFnIntFnIntInt) any {
	return nil
}

// main.go
package main

import (
	"fixture/Data/Exists"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
)

type TreeFnIntFnIntInt struct {
	Leaf func(int32) func(int32) int32
	Tag  uint8
	Pair exists.ExistsPairEFnIntFnIntInt
}

const (
	TreeFnIntFnIntIntLeaf = iota
	TreeFnIntFnIntIntPair
)

type PairEFnIntIntInt struct {
	First  TreeFnIntFnIntInt
	Second *TreeInt
}

type ExistsPairEFnIntInt struct {
	Int *PairEFnIntIntInt
}

type TreeFnIntInt struct {
	Leaf func(int32) int32
	Pair *ExistsPairEFnIntInt
	Tag  uint8
}

const (
	TreeFnIntIntLeaf = iota
	TreeFnIntIntPair
)

type PairEIntInt struct {
	First  *TreeFnIntInt
	Second *TreeInt
}

type ExistsPairEInt struct {
	Int *PairEIntInt
}

type TreeInt struct {
	Pair *ExistsPairEInt
	Leaf int32
	Tag  uint8
}

const (
	TreeIntLeaf = iota
	TreeIntPair
)

type Tree struct {
	Field0 any
	Tag    uint8
}

const (
	TreeLeaf = iota
	TreePair
)

type TreeFn struct {
	Leaf func(any) any
	Pair any
	Tag  uint8
}

const (
	TreeFnLeaf = iota
	TreeFnPair
)

type PairE struct {
	First  *TreeFn
	Second *Tree
}

func convert(value TreeFnIntFnIntInt) *TreeFn {
	switch value.Tag {
	case TreeFnIntFnIntIntLeaf:
		return &TreeFn{Tag: TreeFnLeaf, Leaf: func(coerced any) any {
			original := value.Leaf(coerced.(int32))
			return func(coerced2 any) any {
				return original(coerced2.(int32))
			}
		}}
	default: // TreeFnIntFnIntIntPair
		return &TreeFn{Tag: TreeFnPair, Pair: exists.Convert(value.Pair)}
	}
}

func convert2(value *TreeFnIntInt) *TreeFn {
	switch value.Tag {
	case TreeFnIntIntLeaf:
		return &TreeFn{Tag: TreeFnLeaf, Leaf: func(coerced any) any {
			return value.Leaf(coerced.(int32))
		}}
	default: // TreeFnIntIntPair
		return &TreeFn{Tag: TreeFnPair, Pair: convert7(value.Pair)}
	}
}

func convert3(value *PairEIntInt) *PairE {
	return &PairE{First: convert2(value.First), Second: convert5(value.Second)}
}

func convert4(value *ExistsPairEInt) any {
	return convert3(value.Int)
}

func convert5(value *TreeInt) *Tree {
	switch value.Tag {
	case TreeIntLeaf:
		return &Tree{Tag: TreeLeaf, Field0: value.Leaf}
	default: // TreeIntPair
		return &Tree{Tag: TreePair, Field0: convert4(value.Pair)}
	}
}

func convert6(value *PairEFnIntIntInt) *PairE {
	return &PairE{First: convert(value.First), Second: convert5(value.Second)}
}

func convert7(value *ExistsPairEFnIntInt) any {
	return convert6(value.Int)
}

func convert8(value *TreeFnIntInt) *Tree {
	switch value.Tag {
	case TreeFnIntIntLeaf:
		return &Tree{Tag: TreeLeaf, Field0: func(coerced any) any {
			return value.Leaf(coerced.(int32))
		}}
	default: // TreeFnIntIntPair
		return &Tree{Tag: TreePair, Field0: convert7(value.Pair)}
	}
}

func convert9(value *TreeFn) *Tree {
	switch value.Tag {
	case TreeFnLeaf:
		return &Tree{Tag: TreeLeaf, Field0: value.Leaf}
	default: // TreeFnPair
		return &Tree{Tag: TreePair, Field0: value.Pair}
	}
}

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	return []int32{leavesInt(&TreeInt{Tag: TreeIntLeaf, Leaf: 1}), leavesInt(&TreeInt{Tag: TreeIntPair, Pair: &ExistsPairEInt{Int: &PairEIntInt{First: &TreeFnIntInt{Tag: TreeFnIntIntLeaf, Leaf: func(value int32) int32 {
		return value + 1
	}}, Second: &TreeInt{Tag: TreeIntLeaf, Leaf: 1}}}}), leavesInt(&TreeInt{Tag: TreeIntPair, Pair: &ExistsPairEInt{Int: &PairEIntInt{First: &TreeFnIntInt{Tag: TreeFnIntIntPair, Pair: &ExistsPairEFnIntInt{Int: &PairEFnIntIntInt{First: TreeFnIntFnIntInt{Tag: TreeFnIntFnIntIntLeaf, Leaf: func(x int32) func(int32) int32 {
		return func(y int32) int32 {
			return x + y
		}
	}}, Second: &TreeInt{Tag: TreeIntLeaf, Leaf: 1}}}}, Second: &TreeInt{Tag: TreeIntLeaf, Leaf: 2}}}})}
}

func leavesInt(tree *TreeInt) int32 {
	return leavesIntGo(0, tree)
}

func leavesIntGo(depth int32, tree *TreeInt) int32 {
	switch tree.Tag {
	case TreeIntLeaf:
		return depth + 1
	default: // TreeIntPair
		original := func(depth2 int32) func(*Tree) int32 {
			return func(tree2 *Tree) int32 {
				return leavesIntGo2(depth2, tree2)
			}
		}
		return original(depth+1)(convert8(tree.Pair.Int.First)) + leavesIntGo(depth+1, tree.Pair.Int.Second)
	}
}

func leavesIntGo2(depth int32, tree *Tree) int32 {
	switch tree.Tag {
	case TreeLeaf:
		return depth + 1
	default: // TreePair
		scrutinee := tree.Field0.(*PairE)
		original := func(depth2 int32) func(*Tree) int32 {
			return func(tree2 *Tree) int32 {
				return leavesIntGo2(depth2, tree2)
			}
		}
		return original(depth+1)(convert9(scrutinee.First)) + leavesIntGo3(depth+1, scrutinee.Second)
	}
}

func leavesIntGo3(depth int32, tree *Tree) int32 {
	switch tree.Tag {
	case TreeLeaf:
		return depth + 1
	default: // TreePair
		scrutinee := tree.Field0.(*PairE)
		original := func(depth2 int32) func(*Tree) int32 {
			return func(tree2 *Tree) int32 {
				return leavesIntGo2(depth2, tree2)
			}
		}
		return original(depth+1)(convert9(scrutinee.First)) + leavesIntGo3(depth+1, scrutinee.Second)
	}
}

func main() {
	fmt.Println(main_)
}
