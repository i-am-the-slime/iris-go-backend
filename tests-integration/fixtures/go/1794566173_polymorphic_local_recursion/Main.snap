// Data/Exists/exists.go
package exists

type Exists uint8

func Convert(value Exists) any {
	return nil
}

// main.go
package main

import (
	"fixture/Data/Exists"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type TreeFnIntFnIntInt struct {
	Leaf func(int) func(int) int
	Tag  uint8
	Pair exists.Exists
}

const (
	TreeFnIntFnIntIntLeaf = iota
	TreeFnIntFnIntIntPair
)

type PairEFnIntInt struct {
	First  TreeFnIntFnIntInt
	Second *TreeInt
}

type ExistsPairEFnIntInt struct {
	Int *PairEFnIntInt
}

type TreeFnIntInt struct {
	Leaf func(int) int
	Pair *ExistsPairEFnIntInt
	Tag  uint8
}

const (
	TreeFnIntIntLeaf = iota
	TreeFnIntIntPair
)

type PairEInt struct {
	First  *TreeFnIntInt
	Second *TreeInt
}

type ExistsPairEInt struct {
	Int *PairEInt
}

type TreeInt struct {
	Pair *ExistsPairEInt
	Leaf int
	Tag  uint8
}

const (
	TreeIntLeaf = iota
	TreeIntPair
)

type Tree struct {
	Field0 any
	Tag    uint8
}

const (
	TreeLeaf = iota
	TreePair
)

type TreeFn struct {
	Leaf func(any) any
	Pair any
	Tag  uint8
}

const (
	TreeFnLeaf = iota
	TreeFnPair
)

type PairE struct {
	First  *TreeFn
	Second *Tree
}

func convert(value TreeFnIntFnIntInt) *TreeFn {
	switch value.Tag {
	case TreeFnIntFnIntIntLeaf:
		return &TreeFn{Tag: TreeFnLeaf, Leaf: func(coerced any) any {
			original := value.Leaf(coerced.(int))
			return func(coerced2 any) any {
				return original(coerced2.(int))
			}
		}}
	default: // TreeFnIntFnIntIntPair
		return &TreeFn{Tag: TreeFnPair, Pair: exists.Convert(value.Pair)}
	}
}

func convert2(value *TreeFnIntInt) *TreeFn {
	if value == nil {
		return nil
	}
	switch value.Tag {
	case TreeFnIntIntLeaf:
		return &TreeFn{Tag: TreeFnLeaf, Leaf: func(coerced any) any {
			return value.Leaf(coerced.(int))
		}}
	default: // TreeFnIntIntPair
		return &TreeFn{Tag: TreeFnPair, Pair: convert7(value.Pair)}
	}
}

func convert3(value *PairEInt) *PairE {
	if value == nil {
		return nil
	}
	return &PairE{First: convert2(value.First), Second: convert5(value.Second)}
}

func convert4(value *ExistsPairEInt) any {
	return convert3(value.Int)
}

func convert5(value *TreeInt) *Tree {
	if value == nil {
		return nil
	}
	switch value.Tag {
	case TreeIntLeaf:
		return &Tree{Tag: TreeLeaf, Field0: value.Leaf}
	default: // TreeIntPair
		return &Tree{Tag: TreePair, Field0: convert4(value.Pair)}
	}
}

func convert6(value *PairEFnIntInt) *PairE {
	if value == nil {
		return nil
	}
	return &PairE{First: convert(value.First), Second: convert5(value.Second)}
}

func convert7(value *ExistsPairEFnIntInt) any {
	return convert6(value.Int)
}

func convert8(value *TreeFnIntInt) *Tree {
	if value == nil {
		return nil
	}
	switch value.Tag {
	case TreeFnIntIntLeaf:
		return &Tree{Tag: TreeLeaf, Field0: func(coerced any) any {
			return value.Leaf(coerced.(int))
		}}
	default: // TreeFnIntIntPair
		return &Tree{Tag: TreePair, Field0: convert7(value.Pair)}
	}
}

func convert9(value *TreeFn) *Tree {
	if value == nil {
		return nil
	}
	switch value.Tag {
	case TreeFnLeaf:
		return &Tree{Tag: TreeLeaf, Field0: value.Leaf}
	default: // TreeFnPair
		return &Tree{Tag: TreePair, Field0: value.Pair}
	}
}

func LeafTreeInt(leaf int) *TreeInt {
	return &TreeInt{Tag: TreeIntLeaf, Leaf: leaf}
}

func LeafTreeFnIntInt(leaf func(int) int) *TreeFnIntInt {
	return &TreeFnIntInt{Tag: TreeFnIntIntLeaf, Leaf: leaf}
}

func PairTreeInt(pair *ExistsPairEInt) *TreeInt {
	return &TreeInt{Tag: TreeIntPair, Pair: pair}
}

func LeafTreeFnIntFnIntInt(leaf func(int) func(int) int) TreeFnIntFnIntInt {
	return TreeFnIntFnIntInt{Tag: TreeFnIntFnIntIntLeaf, Leaf: leaf}
}

func PairTreeFnIntInt(pair *ExistsPairEFnIntInt) *TreeFnIntInt {
	return &TreeFnIntInt{Tag: TreeFnIntIntPair, Pair: pair}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	return []int{leaves(LeafTreeInt(1)), leaves(PairTreeInt(&ExistsPairEInt{Int: &PairEInt{First: LeafTreeFnIntInt(func(value int) int {
		return value + 1
	}), Second: LeafTreeInt(1)}})), leaves(PairTreeInt(&ExistsPairEInt{Int: &PairEInt{First: PairTreeFnIntInt(&ExistsPairEFnIntInt{Int: &PairEFnIntInt{First: LeafTreeFnIntFnIntInt(func(x int) func(int) int {
		return func(y int) int {
			return x + y
		}
	}), Second: LeafTreeInt(1)}}), Second: LeafTreeInt(2)}}))}
}

func leaves(tree *TreeInt) int {
	return leavesGo(0, tree)
}

func leavesGo(depth int, tree *TreeInt) int {
	switch tree.Tag {
	case TreeIntLeaf:
		return depth + 1
	default: // TreeIntPair
		original := func(depth2 int) func(*Tree) int {
			return func(tree2 *Tree) int {
				return leavesGo2(depth2, tree2)
			}
		}
		return original(depth+1)(convert8(tree.Pair.Int.First)) + leavesGo(depth+1, tree.Pair.Int.Second)
	}
}

func leavesGo2(depth int, tree *Tree) int {
	switch tree.Tag {
	case TreeLeaf:
		return depth + 1
	default: // TreePair
		scrutinee := tree.Field0.(*PairE)
		original := func(depth2 int) func(*Tree) int {
			return func(tree2 *Tree) int {
				return leavesGo2(depth2, tree2)
			}
		}
		return original(depth+1)(convert9(scrutinee.First)) + leavesGo3(depth+1, scrutinee.Second)
	}
}

func leavesGo3(depth int, tree *Tree) int {
	switch tree.Tag {
	case TreeLeaf:
		return depth + 1
	default: // TreePair
		scrutinee := tree.Field0.(*PairE)
		original := func(depth2 int) func(*Tree) int {
			return func(tree2 *Tree) int {
				return leavesGo2(depth2, tree2)
			}
		}
		return original(depth+1)(convert9(scrutinee.First)) + leavesGo3(depth+1, scrutinee.Second)
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
