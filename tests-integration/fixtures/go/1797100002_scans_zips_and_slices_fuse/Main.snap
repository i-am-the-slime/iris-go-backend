				built16[index] = element
			}
			mapped6[slot] = countAlong(built16)
		}
		result2 = mapped6
	}
	return []string{show.ArrayInt(mapped), show.ArrayInt(mapped2), show.ArrayInt(mapped3), show.ArrayInt(built), show.ArrayInt(built2), show.ArrayInt(built3), show.ArrayInt(built4), strconv.Itoa(accumulator), strconv.Itoa(accumulator2), strconv.Itoa(len(array5)), strconv.FormatBool(found), strconv.FormatBool(every), show.ArrayInt(kept), show.ArrayInt(bound), show.ArrayInt(built6), show.ArrayInt(built7), show.ArrayXY(built8), show.ArrayInt(built9), show.ArrayInt(built10), show.ArrayInt(built11), strconv.Itoa(accumulator3), show.ArrayInt(built12), show.ArrayInt(mapped4), strconv.Itoa(count11), strconv.FormatBool(every2), show.ArrayString(mapped5), "20", show.ArrayInt(built13), show.ArrayInt(built14), show.ArrayInt([]int{7, 8, 3, 6}), show.ArrayInt(built15), show.ArrayInt(row([]rune{'a', 'b'}, []int{0, 1, 2}, 'b')), strconv.Itoa(foldLanes(result, 0)), strconv.Itoa(foldLanes(result2, 0)), "9", "13"}
}

func row(letters []rune, previous []int, letter rune) []int {
	array := arraypkg.Slice(0, 1, previous)
	accumulator := 0
	for _, value := range array {
		accumulator += value
	}
	first := accumulator + 1
	scanned := first
	array2 := arraypkg.Slice(1, len(previous), previous)
	count := min(len(previous), len(letters))
	count2 := min(len(array2), count)
	built := make([]int, count2+1)
	built[0] = first
	for index := range count2 {
		value := array2[index]
		diagonal := previous[index]
		other := letters[index]
		var result int
		if other == letter {
			result = 0
		} else {
			result = 1
		}
		element := diagonal + result
		cheapest := ord.Min_(value+1, element)
		x := scanned + 1
		if x <= cheapest {
			scanned = x
		} else {
			scanned = cheapest
		}
		built[index+1] = scanned
	}
	return built
}

func countAlong(matches []bool) int {
	accumulatorBefore := 0
	accumulatorMatches := 0
	accumulatorTotal := 0
	for _, same := range matches {
		if same {
			accumulatorMatches += 1
		} else {
			starts := accumulatorMatches + 1
			accumulatorBefore, accumulatorMatches = starts, 0
		}
		accumulatorTotal += accumulatorBefore
	}
	return accumulatorTotal
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"simd/archsimd"
	"unsafe"
)

func foldLanesLanes(xs []int64, initial int64) int64 {
	acc0 := archsimd.BroadcastInt64x2(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt64x2(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt64x2(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [2]int64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
func foldLanes(xs []int, initial int) int {
	return int(foldLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)), int64(initial)))
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int, initial int) int {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"simd"
	"unsafe"
)

func foldLanesLanes(xs []int64, initial int64) int64 {
	acc0 := simd.BroadcastInt64s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt64s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt64s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt64s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt64s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [8]int64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
func foldLanes(xs []int, initial int) int {
	return int(foldLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)), int64(initial)))
}

