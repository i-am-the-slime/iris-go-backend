	}
	return []string{string(show.AppendShowArrayInt(nil, mapped)), string(show.AppendShowArrayInt(nil, mapped2)), string(show.AppendShowArrayInt(nil, mapped3)), string(show.AppendShowArrayInt(nil, built)), string(show.AppendShowArrayInt(nil, built2)), string(show.AppendShowArrayInt(nil, built3)), string(show.AppendShowArrayInt(nil, built4)), strconv.Itoa(int(accumulator)), strconv.Itoa(int(accumulator2)), strconv.Itoa(len(array4)), strconv.FormatBool(found), strconv.FormatBool(every), string(show.AppendShowArrayInt(nil, kept)), string(show.AppendShowArrayInt(nil, arraypkg.Bounded(bound))), string(show.AppendShowArrayInt(nil, built6)), string(show.AppendShowArrayInt(nil, built7)), string(show.AppendShowArrayXY(nil, built8)), string(show.AppendShowArrayInt(nil, built9)), string(show.AppendShowArrayInt(nil, built10)), string(show.AppendShowArrayInt(nil, built11)), strconv.Itoa(int(accumulator3)), string(show.AppendShowArrayInt(nil, built12)), string(show.AppendShowArrayInt(nil, mapped4)), strconv.Itoa(int(int32(count11))), strconv.FormatBool(every2), string(show.AppendShowArrayString(nil, mapped5)), strconv.Itoa(int(accumulator4)), string(show.AppendShowArrayInt(nil, built13)), string(show.AppendShowArrayInt(nil, built14)), string(show.AppendShowArrayInt(nil, built15)), string(show.AppendShowArrayInt(nil, built16)), string(show.AppendShowArrayInt(nil, row([]rune{'a', 'b'}, []int32{0, 1, 2}, 'b'))), strconv.Itoa(int(foldLanes(result, 0))), strconv.Itoa(int(result2)), strconv.Itoa(int(countAlong([]bool{true, false, true, true, false}))), strconv.Itoa(int(accumulator7.High))}
}

func row(letters []rune, previous []int32, letter rune) []int32 {
	array := arraypkg.Slice(0, 1, previous)
	var accumulator int32 = 0
	for _, value := range array {
		accumulator += value
	}
	first := accumulator + 1
	scanned := first
	array2 := arraypkg.Slice(1, int32(len(previous)), previous)
	count := min(len(previous), len(letters))
	count2 := min(len(array2), count)
	built := make([]int32, count2+1)
	built[0] = first
	for index := range count2 {
		value := array2[index]
		diagonal := previous[index]
		other := letters[index]
		var result int32
		if other == letter {
			result = 0
		} else {
			result = 1
		}
		element := diagonal + result
		cheapest := ord.MinInt(value+1, element)
		x := scanned + 1
		if x <= cheapest {
			scanned = x
		} else {
			scanned = cheapest
		}
		built[index+1] = scanned
	}
	return built
}

func countAlong(matches []bool) int32 {
	var accumulatorBefore int32 = 0
	var accumulatorMatches int32 = 0
	var accumulatorTotal int32 = 0
	for _, same := range matches {
		if same {
			accumulatorMatches += 1
		} else {
			starts := accumulatorMatches + 1
			accumulatorBefore, accumulatorMatches = starts, 0
		}
		accumulatorTotal += accumulatorBefore
	}
	return accumulatorTotal
}

