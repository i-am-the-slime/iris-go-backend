// Data/Ord/ord.go
package ord

func Min_(x int, y int) int {
	if x <= y {
		return x
	}
	return y
}

// Data/Semiring/semiring.go
package semiring

func Add(i int, i2 int) int {
	return i + i2
}

// Data/Show/show.go
package show

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int) string {
	return strconv.Itoa(i)
}

func ShowXYConsIntConsIntNil(record shared.XY) string {
	return string(AppendShowXYConsIntConsIntNil(nil, record))
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayXY(buffer []byte, array []shared.XY) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowXYConsIntConsIntNil(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowXYConsIntConsIntNil(buffer []byte, record shared.XY) []byte {
	buffer = append(buffer, "{ x: "...)
	buffer = strconv.AppendInt(buffer, int64(record.X), 10)
	buffer = append(buffer, ", y: "...)
	buffer = strconv.AppendInt(buffer, int64(record.Y), 10)
	buffer = append(buffer, " }"...)
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayXY(array []shared.XY) string {
	return string(AppendShowArrayXY(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

