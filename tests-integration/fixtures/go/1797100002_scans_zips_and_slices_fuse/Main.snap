	return []string{show.ArrayInt(mapped), show.ArrayInt(mapped2), show.ArrayInt(mapped3), show.ArrayInt(built), show.ArrayInt(built2), show.ArrayInt(built3), show.ArrayInt(built4), strconv.Itoa(accumulator), strconv.Itoa(accumulator2), strconv.Itoa(len(array4)), strconv.FormatBool(found), strconv.FormatBool(every), show.ArrayInt(kept), show.ArrayInt(bound), show.ArrayInt(built6), show.ArrayInt(built7), show.ArrayXY(built8), show.ArrayInt(built9), show.ArrayInt(built10), show.ArrayInt(built11), strconv.Itoa(accumulator3), show.ArrayInt(built12), show.ArrayInt(mapped4), strconv.Itoa(count11), strconv.FormatBool(every2), show.ArrayString(mapped5), strconv.Itoa(accumulator4), show.ArrayInt(built13), show.ArrayInt(built14), show.ArrayInt(built15), show.ArrayInt(built16), show.ArrayInt(row([]rune{'a', 'b'}, []int{0, 1, 2}, 'b')), strconv.Itoa(accumulator6), strconv.Itoa(result2), strconv.Itoa(countAlong([]bool{true, false, true, true, false})), strconv.Itoa(accumulator8.High)}
