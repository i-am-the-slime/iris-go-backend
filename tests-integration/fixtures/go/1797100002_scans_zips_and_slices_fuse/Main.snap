	var result []int
	if n2 < 1 {
		result = accumulator4
	} else {
		result = arraypkg.Slice(n2, len(accumulator4), accumulator4)
	}
	xs := []int{1, 2, 1, 1}
	ys := []int{2, 1, 1}
	var result2 []int
	if len(xs) == 0 {
