// Data/Maybe/maybe.go
package maybe

import "fixture/shared"

const TagNothing = 0

const TagJust = 1

type MainTiming struct {
	Just shared.MainTiming
	Tag  uint8
}

func JustMainTiming(just shared.MainTiming) MainTiming {
	return MainTiming{Tag: TagJust, Just: just}
}

var NoMainTiming = MainTiming{Tag: TagNothing}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(number float64) string {
	return prim.ShowNumber(number)
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() string {
	var text []byte
	array := []maybe.MainTiming{maybe.JustMainTiming(shared.MainTiming{Start: 2.0, End: 3.0}), maybe.NoMainTiming}
	var accumulator float64 = 0.0
	for timingIndex := range array {
		var result float64
		switch array[timingIndex].Tag {
		case maybe.TagJust:
			x := array[timingIndex].Just
			result = x.End - x.Start
		default:
			result = 0.0
		}
		accumulator += result
	}
	array2 := []shared.Adjustment{{Factor: 3.0, Offset: 1.0}}
	var accumulator2 float64 = 2.0
	for adjustmentIndex := range array2 {
		accumulator2 = accumulator2*array2[adjustmentIndex].Factor + array2[adjustmentIndex].Offset
	}
	array3 := []shared.Margin{{Top: 1.0, Bottom: 2.0}}
	var accumulator3 float64 = 0.0
	for marginIndex := range array3 {
		accumulator3 = accumulator3 + array3[marginIndex].Top + array3[marginIndex].Bottom
	}
	array4 := []shared.ShapesTiming{{Width: 2.0, Height: 3.0, Label: "box"}}
	var accumulator4 float64 = 0.0
	for shapeIndex := range array4 {
		accumulator4 += array4[shapeIndex].Width * array4[shapeIndex].Height
	}
	text = show.AppendShowArrayNumber(text, []float64{3.0, accumulator, accumulator2, accumulator3, accumulator4})
	array5 := []shared.Span{{From: 2, To: 7}}
	var accumulator5 int32 = 0
	for spanIndex := range array5 {
		accumulator5 = accumulator5 + array5[spanIndex].To - array5[spanIndex].From
	}
	array6 := []shared.PairInt{{Left: 1, Right: 2}}
	var accumulator6 int32 = 0
	for pairIndex := range array6 {
		accumulator6 = accumulator6 + array6[pairIndex].Left + array6[pairIndex].Right
	}
	text = strconv.AppendInt(text, int64(accumulator5+accumulator6), 10)
	array7 := []shared.PairString{{Left: "a", Right: "b"}}
	accumulator7 := []byte("")
	for pairIndex := range array7 {
		accumulator7 = prim.AppendString(accumulator7, array7[pairIndex].Left)
		accumulator7 = prim.AppendString(accumulator7, array7[pairIndex].Right)
	}
	built := string(accumulator7)
	text = prim.AppendString(text, built)
	return string(text)
}

func main() {
	console.Print(main_)
}

// shared/shared.go
package shared

type MainTiming struct {
	End   float64
	Start float64
}

type Adjustment struct {
	Factor float64
	Offset float64
}

type Margin struct {
	Bottom float64
	Top    float64
}

type ShapesTiming struct {
	Label  string
	Height float64
	Width  float64
}

type Span struct {
	From int32
	To   int32
}

type PairInt struct {
	Left  int32
	Right int32
}

type PairString struct {
	Left  string
	Right string
}
