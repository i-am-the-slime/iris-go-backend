// Data/Maybe/maybe.go
package maybe

import "fixture/shared"

type MaybeTiming struct {
	Just shared.Timing
	Tag  uint8
}

const (
	MaybeTimingNothing = iota
	MaybeTimingJust
)

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(number float64) string {
	return prim.ShowNumber(number)
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Adjustment struct {
	Factor float64
	Offset float64
}

type Margin struct {
	Bottom float64
	Top    float64
}

type Timing struct {
	Label  string
	Height float64
	Width  float64
}

type Span struct {
	From int32
	To   int32
}

type PairInt struct {
	Left  int32
	Right int32
}

type PairString struct {
	Left  string
	Right string
}

var main_ = initializeMain_()

func initializeMain_() string {
	defer exception.ReportUncaught()
	array := []maybe.MaybeTiming{maybe.MaybeTiming{Tag: maybe.MaybeTimingJust, Just: shared.Timing{Start: 2.0, End: 3.0}}, maybe.MaybeTiming{Tag: maybe.MaybeTimingNothing}}
	var accumulator float64 = 0.0
	for timingIndex := range array {
		acc := accumulator
		var result float64
		switch array[timingIndex].Tag {
		case maybe.MaybeTimingJust:
			x := array[timingIndex].Just
			result = x.End - x.Start
		default:
			result = 0.0
		}
		accumulator = acc + result
	}
	array2 := []Adjustment{Adjustment{Factor: 3.0, Offset: 1.0}}
	var accumulator2 float64 = 2.0
	for adjustmentIndex := range array2 {
		acc := accumulator2
		accumulator2 = float64(acc * array2[adjustmentIndex].Factor) + array2[adjustmentIndex].Offset
	}
	array3 := []Margin{Margin{Top: 1.0, Bottom: 2.0}}
	var accumulator3 float64 = 0.0
	for marginIndex := range array3 {
		acc := accumulator3
		accumulator3 = acc + array3[marginIndex].Top + array3[marginIndex].Bottom
	}
	array4 := []Timing{Timing{Width: 2.0, Height: 3.0, Label: "box"}}
	var accumulator4 float64 = 0.0
	for shapeIndex := range array4 {
		acc := accumulator4
		accumulator4 = acc + float64(array4[shapeIndex].Width * array4[shapeIndex].Height)
	}
	array5 := []Span{Span{From: 2, To: 7}}
	var accumulator5 int32 = 0
	for spanIndex := range array5 {
		acc := accumulator5
		accumulator5 = acc + array5[spanIndex].To - array5[spanIndex].From
	}
	array6 := []PairInt{PairInt{Left: 1, Right: 2}}
	var accumulator6 int32 = 0
	for pairIndex := range array6 {
		acc := accumulator6
		accumulator6 = acc + array6[pairIndex].Left + array6[pairIndex].Right
	}
	array7 := []PairString{PairString{Left: "a", Right: "b"}}
	accumulator7 := ""
	for pairIndex := range array7 {
		acc := accumulator7
		accumulator7 = prim.Concat(acc, array7[pairIndex].Left, array7[pairIndex].Right)
	}
	return prim.ShowArray(show.Show, []float64{3.0, accumulator, accumulator2, accumulator3, accumulator4}) + prim.ShowInt(accumulator5 + accumulator6) + accumulator7
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type Timing struct {
	End   float64
	Start float64
}
