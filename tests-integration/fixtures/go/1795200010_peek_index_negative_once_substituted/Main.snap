// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	array2 := array.Thaw([]int32{10, 20, 30})()
	elements := []func(int32) int32{func(value int32) int32 {
		return value + 1
	}}
	within := 1 < len(*array2)
	var kept bool
	if within {
		element := (*array2)[1]
		var result int32
		result = elements[0](element)
		var poked bool
		if 1 < len(*array2) {
			(*array2)[1] = result
			poked = true
		} else {
			poked = false
		}
		kept = poked
	} else {
		kept = false
	}
	array3 := array.UnsafeFreeze(array2)()
	var result2 int32
	if kept {
		result2 = 1
	} else {
		result2 = 0
	}
	performed := array.Append(array3, []int32{0, result2})
	return performed
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
