// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type ArrayString struct {
	Just []string
	Tag  uint8
}

func JustArrayString(just []string) ArrayString {
	return ArrayString{Tag: TagJust, Just: just}
}

var NoArrayString = ArrayString{Tag: TagNothing}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	accumulator := maybe.JustArrayString([]string{})
	accumulator.Just = slices.Clip(accumulator.Just)
	for _, tag := range origin.Tags {
		if accumulator.Tag == maybe.TagNothing {
			break
		}
		switch accumulator.Tag {
		case maybe.TagJust:
			if tag == "" {
				accumulator = maybe.NoArrayString
			} else {
				accumulator = maybe.JustArrayString(array.Bounded(append(accumulator.Just, tag+"!")))
			}
		default:
			accumulator = maybe.NoArrayString
		}
	}
	var result string
	switch accumulator.Tag {
	case maybe.TagJust:
		text := []byte("(Just ")
		text = show.AppendShowArrayString(text, accumulator.Just)
		text = append(text, ')')
		result = string(text)
	default:
		result = "Nothing"
	}
	return []string{"6", "4", "(Just 2)", "Nothing", "5", result, "1", strconv.Itoa(int(bump(3, origin).X))}
}

var origin shared.Point = shared.Point{X: 3, Tags: []string{"a", "b"}}

func bump(n int32, point shared.Point) shared.Point {
	for {
		switch n {
		case 0:
			return point
		default:
			n, point = n-1, shared.Point{Tags: point.Tags, X: point.X + n*2}
			continue
		}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Point struct {
	Tags []string
	X    int32
}
