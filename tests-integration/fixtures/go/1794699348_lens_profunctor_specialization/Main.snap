// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type ArrayString struct {
	Just []string
	Tag  uint8
}

func JustArrayString(just []string) ArrayString {
	return ArrayString{Tag: TagJust, Just: just}
}

var NoArrayString = ArrayString{Tag: TagNothing}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	append_ := direct.Appender[string]()
	accumulator := maybe.JustArrayString([]string{})
	for _, element := range origin.Tags {
		switch accumulator.Tag {
		case maybe.TagJust:
			if element == "" {
				accumulator = maybe.NoArrayString
			} else {
				accumulator = maybe.JustArrayString(append_(accumulator.Just)(element + "!"))
			}
		default:
			accumulator = maybe.NoArrayString
		}
	}
	var result string
	switch accumulator.Tag {
	case maybe.TagJust:
		result = "(Just " + prim.ShowArray(show.Show, (shared.Point{Tags: accumulator.Just, X: origin.X}).Tags) + ")"
	default:
		result = "Nothing"
	}
	return []string{prim.ShowInt(prim.MultiplyInt32(origin.X, 2)), prim.ShowInt((shared.Point{Tags: origin.Tags, X: origin.X + 1}).X), "(Just " + prim.ShowInt(2) + ")", "Nothing", prim.ShowInt(5), result, prim.ShowInt(1), prim.ShowInt(bump(3, origin).X)}
}

var origin shared.Point = shared.Point{X: 3, Tags: []string{"a", "b"}}

func bump(n int32, point shared.Point) shared.Point {
	for {
		switch n {
		case 0:
			return point
		default:
			n, point = n - 1, shared.Point{Tags: point.Tags, X: point.X + prim.MultiplyInt32(n, 2)}
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type Point struct {
	Tags []string
	X    int32
}
