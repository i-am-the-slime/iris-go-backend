// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	kept := []int{}
	for value := 1; value < 101; value++ {
		value2 := value - 5
		if value2 > 0 {
			kept = append(kept, value2)
		}
	}
	accumulator := 0
	for _, value := range kept {
		value2 := value * 2
		accumulator += value2
	}
	step, count := arraypkg.RangeSteps(1, len(kept))
	accumulator2 := 0.0
	for index := range count {
		i := 1 + index*step
		price := float64(i)
		number := price * 1.19
		accumulator2 += number
	}
	return []string{strconv.Itoa(shortLiteralStaysScalar), show.ArrayInt(shortRangeStaysScalar), strconv.Itoa(accumulator), prim.ShowNumber(accumulator2)}
}

var shortLiteralStaysScalar = initializeShortLiteralStaysScalar()

func initializeShortLiteralStaysScalar() int {
	array := []int{1, 2, 3}
	accumulator := 0
	for _, value := range array {
		value2 := value * 2
		accumulator += value2
	}
	return accumulator
}

var shortRangeStaysScalar = initializeShortRangeStaysScalar()

func initializeShortRangeStaysScalar() []int {
	mapped := make([]int, 20)
	for index := range 20 {
		value := 1 + index
		mapped[index] = value * 3
	}
	return mapped
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
