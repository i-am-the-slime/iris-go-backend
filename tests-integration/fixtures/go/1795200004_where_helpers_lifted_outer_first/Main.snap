// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	array2 := *array.Thaw([]int32{3, 1, 2})()
	size := int32(len(array2))
	for i := int32(1); i < size; i++ {
		within := int(i) < len(array2)
		var current int32
		if within {
			current = array2[i]
		} else {
			current = 0
		}
		var j int32 = i - 1
	mainShiftDown:
		for {
			if j < 0 {
				if 0 < len(array2) {
					array2[0] = current
				}
				break mainShiftDown
			}
			within2 := int(j) < len(array2)
			var previous int32
			if within2 {
				previous = array2[j]
			} else {
				previous = 0
			}
			if previous > current {
				index := j + 1
				if int(index) < len(array2) {
					array2[index] = previous
				}
				j -= 1
				continue
			}
			index2 := j + 1
			if int(index2) < len(array2) {
				array2[index2] = current
			}
			break mainShiftDown
		}
	}
	performed := shared.Frozen(array2)
	return array.Append([]int32{mainGo(100, 0)}, performed)
}

func mainDigitSum(x int32, acc int32) int32 {
	for {
		if x == 0 {
			return acc
		}
		x, acc = prim.IntDivPositive(x, 10), acc+prim.IntModPositive(x, 10)
	}
}

func mainGo(i int32, acc int32) int32 {
	for {
		if i == 0 {
			return acc
		}
		i, acc = i-1, acc+mainDigitSum(i, 0)
	}
}

func mainShiftDown(array *[]int32, current int32, j int32) {
	array2 := *array
	for {
		if j < 0 {
			if 0 < len(array2) {
				array2[0] = current
			}
			*array = array2
			return
		}
		within := j >= 0 && int(j) < len(array2)
		var previous int32
		if within {
			previous = array2[j]
		} else {
			previous = 0
		}
		if previous > current {
			index := j + 1
			if index >= 0 && int(index) < len(array2) {
				array2[index] = previous
			}
			j -= 1
			continue
		}
		index2 := j + 1
		if index2 >= 0 && int(index2) < len(array2) {
			array2[index2] = current
		}
		*array = array2
		return
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
