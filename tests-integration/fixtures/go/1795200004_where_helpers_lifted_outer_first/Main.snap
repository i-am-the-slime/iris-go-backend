// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{3, 1, 2})()
	i := int32(len(*array2))
	elements := *array2
	for i2 := int32(1); i2 < i; i2++ {
		within := i2 >= 0 && int(i2) < len(elements)
		var i3 int32
		if within {
			element := elements[i2]
			i3 = element
		} else {
			i3 = 0
		}
		mainShiftDown(elements, i3, i2 - 1)
	}
	performed := array.UnsafeFreeze(array2)()
	return array.Append([]int32{mainGo(100, 0)}, performed)
}

func mainDigitSum(x int32, acc int32) int32 {
	for {
		if x == 0 {
			return acc
		}
		x, acc = prim.IntDiv(x, 10), acc + prim.IntMod(x, 10)
	}
}

func mainGo(i int32, acc int32) int32 {
	for {
		if i == 0 {
			return acc
		}
		i, acc = i - 1, acc + mainDigitSum(i, 0)
	}
}

func mainShiftDown(array []int32, current int32, j int32) {
	for {
		if j < 0 {
			if 0 < len(array) {
				array[0] = current
			}
			return
		}
		within := j >= 0 && int(j) < len(array)
		var i int32
		if within {
			element := array[j]
			i = element
		} else {
			i = 0
		}
		if i > current {
			index := j + 1
			if index >= 0 && int(index) < len(array) {
				array[index] = i
			}
			j = j - 1
			continue
		}
		index2 := j + 1
		if index2 >= 0 && int(index2) < len(array) {
			array[index2] = current
		}
		return
	}
}

func main() {
	fmt.Println(main_)
}
