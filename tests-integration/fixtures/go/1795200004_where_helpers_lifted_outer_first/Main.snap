// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

func JustInt(just int32) Int {
	return Int(just)
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{3, 1, 2})()
	i := array.Length(array2)()
	for i2 := int32(1); i2 < i; i2++ {
		i3 := mainPeekOrZero(array2, i2)
		mainShiftDown(array2, i3, i2 - 1)
	}
	performed := array.UnsafeFreeze(array2)()
	return array.Append([]int32{mainGo(100, 0)}, performed)
}

func mainDigitSum(x int32, acc int32) int32 {
	for {
		if x == 0 {
			return acc
		}
		x, acc = prim.IntDiv(x, 10), acc + prim.IntMod(x, 10)
	}
}

func mainGo(i int32, acc int32) int32 {
	for {
		if i == 0 {
			return acc
		}
		i, acc = i - 1, acc + mainDigitSum(i, 0)
	}
}

func mainPeekOrZero(array2 *[]int32, i int32) int32 {
	maybe2 := array.Peek(maybe.JustInt, maybe.NoInt, i, array2)()
	var result int32
	if maybe2 == maybe.NoInt {
		result = 0
	} else {
		result = int32(maybe2)
	}
	return result
}

func mainShiftDown(array2 *[]int32, current int32, j int32) {
	for {
		if j < 0 {
			array.Poke(0, current, array2)()
			return
		}
		i := mainPeekOrZero(array2, j)
		if i > current {
			array.Poke(j + 1, i, array2)()
			j = j - 1
			continue
		}
		array.Poke(j + 1, current, array2)()
		return
	}
}

func main() {
	fmt.Println(main_)
}
