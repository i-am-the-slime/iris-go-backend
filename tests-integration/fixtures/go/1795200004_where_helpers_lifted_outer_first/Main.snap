// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{3, 1, 2})()
	i := int32(len(*array2))
	for i2 := int32(1); i2 < i; i2++ {
		i3 := mainPeekOrZero(array2, i2)
		mainShiftDown(array2, i3, i2 - 1)
	}
	performed := array.UnsafeFreeze(array2)()
	return array.Append([]int32{mainGo(100, 0)}, performed)
}

func mainDigitSum(x int32, acc int32) int32 {
	for {
		if x == 0 {
			return acc
		}
		x, acc = prim.IntDiv(x, 10), acc + prim.IntMod(x, 10)
	}
}

func mainGo(i int32, acc int32) int32 {
	for {
		if i == 0 {
			return acc
		}
		i, acc = i - 1, acc + mainDigitSum(i, 0)
	}
}

func mainPeekOrZero(array *[]int32, i int32) int32 {
	var peeked maybe.Int
	if i >= 0 && int(i) < len(*array) {
		peeked = maybe.Int((*array)[i])
	} else {
		peeked = maybe.NoInt
	}
	var result int32
	if peeked == maybe.NoInt {
		result = 0
	} else {
		result = int32(peeked)
	}
	return result
}

func mainShiftDown(array *[]int32, current int32, j int32) {
	for {
		if j < 0 {
			if 0 < len(*array) {
				(*array)[0] = current
			}
			return
		}
		i := mainPeekOrZero(array, j)
		if i > current {
			index := j + 1
			if index >= 0 && int(index) < len(*array) {
				(*array)[index] = i
			}
			j = j - 1
			continue
		}
		index2 := j + 1
		if index2 >= 0 && int(index2) < len(*array) {
			(*array)[index2] = current
		}
		return
	}
}

func main() {
	fmt.Println(main_)
}
