// Control/Category/category.go
package category

func Identity(x int) int {
	return x
}

// main.go
package main

import (
	"fixture/Control/Category"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	mapped := make([]int, len(partiallyApplied))
	for index, f := range partiallyApplied {
		mapped[index] = f(1)
	}
	mapped2 := make([]int, len(onlyTheFunction))
	for index, f := range onlyTheFunction {
		mapped2[index] = f(3)(1)
	}
	return array.Append([]int{composeTimesDouble(5)(1), composeTimesDouble(3)(7), composeTimesF2(4)(0)}, array.Append(mapped, mapped2))
}

var partiallyApplied = initializePartiallyApplied()

func initializePartiallyApplied() []func(int) int {
	return []func(int) int{composeTimesDouble(2), composeTimesF(2)}
}

var onlyTheFunction []func(int) func(int) int = []func(int) func(int) int{composeTimesDouble, composeTimesF}

func composeTimesDouble(n int) func(int) int {
	if n <= 0 {
		return category.Identity
	}
	g := composeTimesDouble(n - 1)
	return func(x int) int {
		return g(x) * 2
	}
}

func composeTimesF(n int) func(int) int {
	if n <= 0 {
		return category.Identity
	}
	g := composeTimesF(n - 1)
	return func(x int) int {
		return g(x) + 3
	}
}

func composeTimesF2(n int) func(int) int {
	if n <= 0 {
		return category.Identity
	}
	g := composeTimesF2(n - 1)
	return func(x int) int {
		return g(x) + 1
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
