// Data/Maybe/maybe.go
package maybe

type Char int64

const NoChar Char = 1 << 32

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type Light uint8

const (
	LightRed Light = iota
	LightAmber
	LightGreen
)

var main_ = initializeMain_()

func initializeMain_() []string {
	value, found := prim.CodeUnitCharAt(0, "abc")
	var result string
	if found && value == 'a' {
		result = "starts with a"
	} else if found {
		result = "starts otherwise"
	} else {
		result = "empty"
	}
	n := opaque(7)
	var left Light
	if n > 10 {
		left = LightRed
	} else if n > 5 {
		left = LightAmber
	} else {
		left = LightGreen
	}
	n2 := opaque(12)
	var right Light
	if n2 > 10 {
		right = LightRed
	} else if n2 > 5 {
		right = LightAmber
	} else {
		right = LightGreen
	}
	n3 := opaque(3)
	result2 := !(n3 > 10) && n3 <= 5
	return []string{strconv.Itoa(3 + opaque(3)), show.ArrayString([]string{"4", strconv.Itoa(opaque(5))}), "6," + strconv.Itoa(opaque(7)) + ",", result, strconv.FormatBool(left == right), strconv.FormatBool(result2)}
}

func opaque(x int) int {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
