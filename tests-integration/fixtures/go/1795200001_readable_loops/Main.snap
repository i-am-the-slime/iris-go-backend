// Data/Maybe/maybe.go
package maybe

type Char int64

const NoChar Char = 1 << 32

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type Light uint8

const (
	LightRed Light = iota
	LightAmber
	LightGreen
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []int{1, 2, opaque(3)}
	accumulator := 0
	for _, value := range array {
		accumulator += value
	}
	array2 := []int{4, opaque(5)}
	mapped := make([]string, len(array2))
	for index, value := range array2 {
		mapped[index] = strconv.Itoa(value)
	}
	array3 := []int{6, opaque(7)}
	accumulator2 := ""
	for index := len(array3) - 1; index >= 0; index-- {
		x := array3[index]
		accumulator2 = strconv.Itoa(x) + "," + accumulator2
	}
	value2, found := prim.CodeUnitCharAt(0, "abc")
	var codeUnitCharAt maybe.Char
	if found {
		codeUnitCharAt = maybe.Char(value2)
	} else {
		codeUnitCharAt = maybe.NoChar
	}
	var result string
	if codeUnitCharAt != maybe.NoChar && rune(codeUnitCharAt) == 'a' {
		result = "starts with a"
	} else if codeUnitCharAt != maybe.NoChar {
		result = "starts otherwise"
	} else {
		result = "empty"
	}
	n := opaque(7)
	var left Light
	if n > 10 {
		left = LightRed
	} else if n > 5 {
		left = LightAmber
	} else {
		left = LightGreen
	}
	n2 := opaque(12)
	var right Light
	if n2 > 10 {
		right = LightRed
	} else if n2 > 5 {
		right = LightAmber
	} else {
		right = LightGreen
	}
	n3 := opaque(3)
	result2 := !(n3 > 10) && n3 <= 5
	return []string{strconv.Itoa(accumulator), show.ArrayString(mapped), accumulator2, result, strconv.FormatBool(left == right), strconv.FormatBool(result2)}
}

func opaque(x int) int {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
