// Data/Maybe/maybe.go
package maybe

type Char int64

const NoChar Char = 1 << 32

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Light uint8

const (
	LightRed Light = iota
	LightAmber
	LightGreen
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array := []int32{1, 2, opaque(3)}
	var accumulator int32 = 0
	for _, value := range array {
		accumulator = accumulator + value
	}
	array2 := []int32{4, opaque(5)}
	mapped := make([]string, len(array2))
	for index, value := range array2 {
		mapped[index] = prim.ShowInt(value)
	}
	array3 := []int32{6, opaque(7)}
	accumulator2 := ""
	for index := len(array3) - 1; index >= 0; index-- {
		x := array3[index]
		accumulator2 = prim.ShowInt(x) + "," + accumulator2
	}
	codeUnitCharAt := prim.CodeUnitCharAt(func(payload rune) maybe.Char {
		return maybe.Char(payload)
	}, maybe.NoChar, 0, "abc")
	var result string
	if codeUnitCharAt != maybe.NoChar && rune(codeUnitCharAt) == 'a' {
		result = "starts with a"
	} else if codeUnitCharAt != maybe.NoChar {
		result = "starts otherwise"
	} else {
		result = "empty"
	}
	n := opaque(7)
	n2 := opaque(12)
	var result2 Light
	if n > 10 {
		result2 = LightRed
	} else if n > 5 {
		result2 = LightAmber
	} else {
		result2 = LightGreen
	}
	var result3 Light
	if n2 > 10 {
		result3 = LightRed
	} else if n2 > 5 {
		result3 = LightAmber
	} else {
		result3 = LightGreen
	}
	var result4 string
	if result2 == LightRed && result3 == LightRed {
		result4 = "true"
	} else if result2 == LightAmber && result3 == LightAmber {
		result4 = "true"
	} else if result2 == LightGreen && result3 == LightGreen {
		result4 = "true"
	} else {
		result4 = "false"
	}
	n3 := opaque(3)
	result5 := !(n3 > 10) && n3 <= 5
	var result6 string
	if result5 {
		result6 = "true"
	} else {
		result6 = "false"
	}
	return []string{prim.ShowInt(accumulator), prim.ShowArray(show.Show, mapped), accumulator2, result, result4, result6}
}

func opaque(x int32) int32 {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	fmt.Println(main_)
}
