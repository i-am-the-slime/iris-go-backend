// Data/List/Types/types.go
package types

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
}

var SharedListIntNil = &ListInt{}

func Cons(cons0 int32, cons1 *ListInt) *ListInt {
	return &ListInt{Cons0: cons0, Cons1: cons1}
}

func SumIntList(value *ListInt) int32 {
	return SumIntListGo(0, value)
}

func SumIntListGo(b int32, value *ListInt) int32 {
	for {
		if value == SharedListIntNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		b, value = b+a, as
	}
}

// RedBlack/redblack.go
package redblack

import "fixture/shared"

type Color uint8

const (
	ColorRed Color = iota
	ColorBlack
)

type Tree struct {
	Node1  *Tree
	Node4  *Tree
	Node2  int32
	Node0  Color
	Node3  bool
	Unique uint8
}

var SharedTreeLeaf = &Tree{}

func Node(node0 Color, node1 *Tree, node2 int32, node3 bool, node4 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: node1, Node2: node2, Node3: node3, Node4: node4}
}

func Size(value *Tree) int32 {
	if value == SharedTreeLeaf {
		return 0
	}
	return Size(value.Node1) + 1 + Size(value.Node4)
}

func Checksum(value *Tree) int32 {
	return ChecksumGo(0, value)
}

func BlackHeight(value *Tree) int32 {
	if value == SharedTreeLeaf {
		return 1
	}
	color := value.Node0
	l := value.Node1
	r := value.Node4
	left := BlackHeight(l)
	var result bool
	switch color {
	case ColorRed:
		result2 := l != SharedTreeLeaf && l.Node0 == ColorRed
		result3 := r != SharedTreeLeaf && r.Node0 == ColorRed
		result = result2 || result3
	default: // ColorBlack
		result = false
	}
	if left < 0 || (left != BlackHeight(r) || result) {
		return -1
	}
	var result4 int32
	switch color {
	case ColorRed:
		result4 = 0
	default: // ColorBlack
		result4 = 1
	}
	return left + result4
}

func Ordered(low int32, high int32, value *Tree) bool {
	for {
		if value == SharedTreeLeaf {
			return true
		}
		l := value.Node1
		k := value.Node2
		r := value.Node4
		if low < k {
			if k < high {
				if Ordered(low, k, l) {
					low, value = k, r
					continue
				}
				return false
			}
			return false
		}
		return false
	}
}

func Ins(kx int32, vx bool, value *Tree) *Tree {
	if value == SharedTreeLeaf {
		return &Tree{Node0: ColorRed, Node1: SharedTreeLeaf, Node2: kx, Node3: vx, Node4: SharedTreeLeaf, Unique: 3}
	}
	if value.Node0 == ColorRed {
		a := value.Node1
		ky := value.Node2
		vy := value.Node3
		b := value.Node4
		if kx < ky {
			return &Tree{Node0: ColorRed, Node1: Ins(kx, vx, a), Node2: ky, Node3: vy, Node4: b, Unique: 1}
		}
		if kx == ky {
			return Node(ColorRed, a, kx, vx, b)
		}
		return &Tree{Node0: ColorRed, Node1: a, Node2: ky, Node3: vy, Node4: Ins(kx, vx, b), Unique: 2}
	}
	a2 := value.Node1
	ky2 := value.Node2
	vy2 := value.Node3
	b2 := value.Node4
	if kx < ky2 {
		if a2 != SharedTreeLeaf && a2.Node0 == ColorRed {
			scrutinee := Ins(kx, vx, a2)
			if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
				trees := make([]Tree, 3)
				trees[0] = Tree{Node0: ColorRed, Node1: &trees[1], Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: &trees[2], Unique: 3}
				trees[1] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1.Node1, Node2: scrutinee.Node1.Node2, Node3: scrutinee.Node1.Node3, Node4: scrutinee.Node1.Node4}
				trees[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4, Node2: ky2, Node3: vy2, Node4: b2}
				return &trees[0]
			}
			if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
				trees2 := make([]Tree, 3)
				trees2[0] = Tree{Node0: ColorRed, Node1: &trees2[1], Node2: scrutinee.Node4.Node2, Node3: scrutinee.Node4.Node3, Node4: &trees2[2], Unique: 3}
				trees2[1] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4.Node1}
				trees2[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4.Node4, Node2: ky2, Node3: vy2, Node4: b2}
				return &trees2[0]
			}
			if scrutinee != SharedTreeLeaf {
				return &Tree{Node0: ColorBlack, Node1: Node(ColorRed, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4), Node2: ky2, Node3: vy2, Node4: b2, Unique: 1}
			}
			return SharedTreeLeaf
		}
		return &Tree{Node0: ColorBlack, Node1: Ins(kx, vx, a2), Node2: ky2, Node3: vy2, Node4: b2, Unique: 1}
	}
	if kx == ky2 {
		return Node(ColorBlack, a2, kx, vx, b2)
	}
	if b2 != SharedTreeLeaf && b2.Node0 == ColorRed {
		scrutinee := Ins(kx, vx, b2)
		if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
			trees3 := make([]Tree, 3)
			trees3[0] = Tree{Node0: ColorRed, Node1: &trees3[1], Node2: scrutinee.Node1.Node2, Node3: scrutinee.Node1.Node3, Node4: &trees3[2], Unique: 3}
			trees3[1] = Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: scrutinee.Node1.Node1}
			trees3[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1.Node4, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}
			return &trees3[0]
		}
		if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
			trees4 := make([]Tree, 3)
			trees4[0] = Tree{Node0: ColorRed, Node1: &trees4[1], Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: &trees4[2], Unique: 3}
			trees4[1] = Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: scrutinee.Node1}
			trees4[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4.Node1, Node2: scrutinee.Node4.Node2, Node3: scrutinee.Node4.Node3, Node4: scrutinee.Node4.Node4}
			return &trees4[0]
		}
		if scrutinee != SharedTreeLeaf {
			return &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: Node(ColorRed, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4), Unique: 2}
		}
		return SharedTreeLeaf
	}
	return &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: Ins(kx, vx, b2), Unique: 2}
}

func ChecksumGo(acc int32, value *Tree) int32 {
	for {
		if value == SharedTreeLeaf {
			return acc
		}
		l := value.Node1
		k := value.Node2
		v := value.Node3
		r := value.Node4
		var result int32
		if v {
			result = k
		} else {
			result = 1
		}
		acc, value = ChecksumGo(acc, l)+result, r
	}
}

func InsChecked(kx int32, vx bool, value *Tree, valueOwned bool) *Tree {
	if value == SharedTreeLeaf {
		return &Tree{Node0: ColorRed, Node1: SharedTreeLeaf, Node2: kx, Node3: vx, Node4: SharedTreeLeaf, Unique: 3}
	}
	if value.Node0 == ColorRed {
		a := value.Node1
		ky := value.Node2
		vy := value.Node3
		b := value.Node4
		aOwned := valueOwned && value.Unique&1 != 0
		bOwned := valueOwned && value.Unique&2 != 0
		if kx < ky {
			field := InsChecked(kx, vx, a, aOwned)
			if valueOwned {
				value.Node1 = field
				value.Unique = 1 | shared.UniqueBit(bOwned, 2)
				return value
			}
			return &Tree{Node0: ColorRed, Node1: field, Node2: ky, Node3: vy, Node4: b, Unique: 1 | shared.UniqueBit(bOwned, 2)}
		}
		if kx == ky {
			if valueOwned {
				value.Node2 = kx
				value.Node3 = vx
				value.Unique = shared.UniqueBit(aOwned, 1) | shared.UniqueBit(bOwned, 2)
				return value
			}
			return &Tree{Node0: ColorRed, Node1: a, Node2: kx, Node3: vx, Node4: b, Unique: shared.UniqueBit(aOwned, 1) | shared.UniqueBit(bOwned, 2)}
		}
		field2 := InsChecked(kx, vx, b, bOwned)
		if valueOwned {
			value.Node4 = field2
			value.Unique = 2 | shared.UniqueBit(aOwned, 1)
			return value
		}
		return &Tree{Node0: ColorRed, Node1: a, Node2: ky, Node3: vy, Node4: field2, Unique: 2 | shared.UniqueBit(aOwned, 1)}
	}
	a2 := value.Node1
	ky2 := value.Node2
	vy2 := value.Node3
	b2 := value.Node4
	aOwned2 := valueOwned && value.Unique&1 != 0
	bOwned2 := valueOwned && value.Unique&2 != 0
	if kx < ky2 {
		if a2 != SharedTreeLeaf && a2.Node0 == ColorRed {
			scrutinee := InsChecked(kx, vx, a2, aOwned2)
			if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
				cell := scrutinee.Node1
				l := scrutinee.Node1.Node1
				kx2 := scrutinee.Node1.Node2
				vx2 := scrutinee.Node1.Node3
				r1 := scrutinee.Node1.Node4
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				r2 := scrutinee.Node4
				cellOwned := scrutinee.Unique&1 != 0
				lOwned := cellOwned && cell.Unique&1 != 0
				r1Owned := cellOwned && cell.Unique&2 != 0
				r2Owned := scrutinee.Unique&2 != 0
				var field *Tree
				if valueOwned {
					value.Node1 = l
					value.Node2 = kx2
					value.Node3 = vx2
					value.Node4 = r1
					value.Unique = shared.UniqueBit(lOwned, 1) | shared.UniqueBit(r1Owned, 2)
					field = value
				} else {
					field = &Tree{Node0: ColorBlack, Node1: l, Node2: kx2, Node3: vx2, Node4: r1, Unique: shared.UniqueBit(lOwned, 1) | shared.UniqueBit(r1Owned, 2)}
				}
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = r2
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				scrutinee.Unique = shared.UniqueBit(r2Owned, 1) | shared.UniqueBit(bOwned2, 2)
				if cellOwned {
					cell.Node1 = field
					cell.Node2 = ky
					cell.Node3 = vy
					cell.Node4 = scrutinee
					cell.Unique = 3
					return cell
				}
				return &Tree{Node0: ColorRed, Node1: field, Node2: ky, Node3: vy, Node4: scrutinee, Unique: 3}
			}
			if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
				l1 := scrutinee.Node1
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				cell := scrutinee.Node4
				l2 := scrutinee.Node4.Node1
				kx2 := scrutinee.Node4.Node2
				vx2 := scrutinee.Node4.Node3
				r := scrutinee.Node4.Node4
				l1Owned := scrutinee.Unique&1 != 0
				cellOwned := scrutinee.Unique&2 != 0
				l2Owned := cellOwned && cell.Unique&1 != 0
				rOwned := cellOwned && cell.Unique&2 != 0
				var field *Tree
				if valueOwned {
					value.Node1 = l1
					value.Node2 = ky
					value.Node3 = vy
					value.Node4 = l2
					value.Unique = shared.UniqueBit(l1Owned, 1) | shared.UniqueBit(l2Owned, 2)
					field = value
				} else {
					field = &Tree{Node0: ColorBlack, Node1: l1, Node2: ky, Node3: vy, Node4: l2, Unique: shared.UniqueBit(l1Owned, 1) | shared.UniqueBit(l2Owned, 2)}
				}
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = r
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				scrutinee.Unique = shared.UniqueBit(rOwned, 1) | shared.UniqueBit(bOwned2, 2)
				if cellOwned {
					cell.Node1 = field
					cell.Node4 = scrutinee
					cell.Unique = 3
					return cell
				}
				return &Tree{Node0: ColorRed, Node1: field, Node2: kx2, Node3: vx2, Node4: scrutinee, Unique: 3}
			}
			if scrutinee != SharedTreeLeaf {
				l := scrutinee.Node1
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				r := scrutinee.Node4
				lOwned := scrutinee.Unique&1 != 0
				rOwned := scrutinee.Unique&2 != 0
				var result *Tree
				if valueOwned {
					value.Node0 = ColorRed
					value.Node1 = l
					value.Node2 = ky
					value.Node3 = vy
					value.Node4 = r
					value.Unique = shared.UniqueBit(lOwned, 1) | shared.UniqueBit(rOwned, 2)
					result = value
				} else {
					result = &Tree{Node0: ColorRed, Node1: l, Node2: ky, Node3: vy, Node4: r, Unique: shared.UniqueBit(lOwned, 1) | shared.UniqueBit(rOwned, 2)}
				}
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = result
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				scrutinee.Unique = 1 | shared.UniqueBit(bOwned2, 2)
				return scrutinee
			}
			return SharedTreeLeaf
		}
		field2 := InsChecked(kx, vx, a2, aOwned2)
		if valueOwned {
			value.Node1 = field2
			value.Unique = 1 | shared.UniqueBit(bOwned2, 2)
			return value
		}
		return &Tree{Node0: ColorBlack, Node1: field2, Node2: ky2, Node3: vy2, Node4: b2, Unique: 1 | shared.UniqueBit(bOwned2, 2)}
	}
	if kx == ky2 {
		if valueOwned {
			value.Node2 = kx
			value.Node3 = vx
			value.Unique = shared.UniqueBit(aOwned2, 1) | shared.UniqueBit(bOwned2, 2)
			return value
		}
		return &Tree{Node0: ColorBlack, Node1: a2, Node2: kx, Node3: vx, Node4: b2, Unique: shared.UniqueBit(aOwned2, 1) | shared.UniqueBit(bOwned2, 2)}
	}
	if b2 != SharedTreeLeaf && b2.Node0 == ColorRed {
		scrutinee := InsChecked(kx, vx, b2, bOwned2)
		if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
			cell := scrutinee.Node1
			l := scrutinee.Node1.Node1
			kx1 := scrutinee.Node1.Node2
			vx1 := scrutinee.Node1.Node3
			r1 := scrutinee.Node1.Node4
			cellOwned := scrutinee.Unique&1 != 0
			lOwned := cellOwned && cell.Unique&1 != 0
			r1Owned := cellOwned && cell.Unique&2 != 0
			r2Owned := scrutinee.Unique&2 != 0
			var field *Tree
			if valueOwned {
				value.Node4 = l
				value.Unique = shared.UniqueBit(aOwned2, 1) | shared.UniqueBit(lOwned, 2)
				field = value
			} else {
				field = &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: l, Unique: shared.UniqueBit(aOwned2, 1) | shared.UniqueBit(lOwned, 2)}
			}
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = r1
			scrutinee.Unique = shared.UniqueBit(r1Owned, 1) | shared.UniqueBit(r2Owned, 2)
			if cellOwned {
				cell.Node1 = field
				cell.Node4 = scrutinee
				cell.Unique = 3
				return cell
			}
			return &Tree{Node0: ColorRed, Node1: field, Node2: kx1, Node3: vx1, Node4: scrutinee, Unique: 3}
		}
		if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
			l1 := scrutinee.Node1
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			cell := scrutinee.Node4
			l2 := scrutinee.Node4.Node1
			kx2 := scrutinee.Node4.Node2
			vx2 := scrutinee.Node4.Node3
			r2 := scrutinee.Node4.Node4
			l1Owned := scrutinee.Unique&1 != 0
			cellOwned := scrutinee.Unique&2 != 0
			l2Owned := cellOwned && cell.Unique&1 != 0
			r2Owned := cellOwned && cell.Unique&2 != 0
			var field *Tree
			if valueOwned {
				value.Node4 = l1
				value.Unique = shared.UniqueBit(aOwned2, 1) | shared.UniqueBit(l1Owned, 2)
				field = value
			} else {
				field = &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: l1, Unique: shared.UniqueBit(aOwned2, 1) | shared.UniqueBit(l1Owned, 2)}
			}
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = l2
			scrutinee.Node2 = kx2
			scrutinee.Node3 = vx2
			scrutinee.Node4 = r2
			scrutinee.Unique = shared.UniqueBit(l2Owned, 1) | shared.UniqueBit(r2Owned, 2)
			if cellOwned {
				cell.Node1 = field
				cell.Node2 = ky
				cell.Node3 = vy
				cell.Node4 = scrutinee
				cell.Unique = 3
				return cell
			}
			return &Tree{Node0: ColorRed, Node1: field, Node2: ky, Node3: vy, Node4: scrutinee, Unique: 3}
		}
		if scrutinee != SharedTreeLeaf {
			l := scrutinee.Node1
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			r := scrutinee.Node4
			lOwned := scrutinee.Unique&1 != 0
			rOwned := scrutinee.Unique&2 != 0
			var result *Tree
			if valueOwned {
				value.Node0 = ColorRed
				value.Node1 = l
				value.Node2 = ky
				value.Node3 = vy
				value.Node4 = r
				value.Unique = shared.UniqueBit(lOwned, 1) | shared.UniqueBit(rOwned, 2)
				result = value
			} else {
				result = &Tree{Node0: ColorRed, Node1: l, Node2: ky, Node3: vy, Node4: r, Unique: shared.UniqueBit(lOwned, 1) | shared.UniqueBit(rOwned, 2)}
			}
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = a2
			scrutinee.Node2 = ky2
			scrutinee.Node3 = vy2
			scrutinee.Node4 = result
			scrutinee.Unique = 2 | shared.UniqueBit(aOwned2, 1)
			return scrutinee
		}
		return SharedTreeLeaf
	}
	field3 := InsChecked(kx, vx, b2, bOwned2)
	if valueOwned {
		value.Node4 = field3
		value.Unique = 2 | shared.UniqueBit(aOwned2, 1)
		return value
	}
	return &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: field3, Unique: 2 | shared.UniqueBit(aOwned2, 1)}
}

// main.go
package main

import (
	"fixture/Data/List/Types"
	"fixture/RedBlack"
	"fixture/shared"
	"fixture/shared/Data.List+RedBlack"
	"fixture/shared/RedBlack+Data.List.Types"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	result := projectedChild(1000)
	return []int32{result.Probed, list_redblack.LengthTree(result.Trees), types.SumIntList(redblack_types.MapSize(result.Trees)), types.SumIntList(redblack_types.Map_(redblack.Checksum, result.Trees)), list_redblack.LengthTree(mainGoReusing(redblack_types.SharedListTreeNil, result.Trees))}
}

func projectedChild(steps int32) redblack_types.ProbedTrees {
	return projectedChildGoReusing(redblack.SharedTreeLeaf, redblack_types.SharedListTreeNil, 0, steps)
}

func projectedChildGoOrProjectedChildGoChecked(step int, tree *redblack.Tree, kept *redblack_types.ListTree, probed int32, n int32, treeOwned bool) redblack_types.ProbedTrees {
	var listTreeCells alloc.Cells[redblack_types.ListTree]
	for {
		switch step {
		case shared.ProjectedChildGoStep:
			if n <= 0 {
				return redblack_types.ProbedTrees{Probed: probed, Trees: redblack_types.Cons(tree, kept)}
			}
			if n%50 == 0 {
				key := n + 100000
				k := n*2 + 1
				var tree2 *redblack.Tree
				if tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed {
					scrutinee := redblack.Ins(k, true, tree)
					if scrutinee != redblack.SharedTreeLeaf {
						tree2 = redblack.Node(redblack.ColorBlack, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4)
					} else {
						tree2 = redblack.SharedTreeLeaf
					}
				} else {
					tree2 = redblack.Ins(k, true, tree)
				}
				var child *redblack.Tree
				if tree2 != redblack.SharedTreeLeaf {
					child = tree2.Node1
				} else {
					child = redblack.SharedTreeLeaf
				}
				var probedTreesGrown *redblack.Tree
				if tree2 != redblack.SharedTreeLeaf && tree2.Node0 == redblack.ColorRed {
					scrutinee := redblack.Ins(key, true, tree2)
					if scrutinee != redblack.SharedTreeLeaf {
						probedTreesGrown = redblack.Node(redblack.ColorBlack, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4)
					} else {
						probedTreesGrown = redblack.SharedTreeLeaf
					}
				} else {
					probedTreesGrown = redblack.Ins(key, true, tree2)
				}
				kept, probed, n = listTreeCells.New(redblack_types.ListTree{Cons0: probedTreesGrown, Cons1: kept}), probed+redblack.Checksum(child), n-1
				continue
			}
			k2 := n * 2
			v := n%3 == 0
			var next *redblack.Tree
			if tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed {
				scrutinee := redblack.Ins(k2, v, tree)
				if scrutinee != redblack.SharedTreeLeaf {
					next = redblack.Node(redblack.ColorBlack, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4)
				} else {
					next = redblack.SharedTreeLeaf
				}
			} else {
				next = redblack.Ins(k2, v, tree)
			}
			var result *redblack_types.ListTree
			if n%7 == 0 {
				result = redblack_types.Cons(next, kept)
			} else {
				result = kept
			}
			step, tree, kept, n, treeOwned = shared.ProjectedChildGoCheckedStep, next, result, n-1, !(n%7 == 0)
		default: // shared.ProjectedChildGoCheckedStep
			if n <= 0 {
				return redblack_types.ProbedTrees{Probed: probed, Trees: redblack_types.Cons(tree, kept)}
			}
			if n%50 == 0 {
				key := n + 100000
				k := n*2 + 1
				var tree2 *redblack.Tree
				if tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed {
					scrutinee := redblack.Ins(k, true, tree)
					if scrutinee != redblack.SharedTreeLeaf {
						lOwned := scrutinee.Unique&1 != 0
						rOwned := scrutinee.Unique&2 != 0
						scrutinee.Node0 = redblack.ColorBlack
						scrutinee.Unique = shared.UniqueBit(lOwned, 1) | shared.UniqueBit(rOwned, 2)
						tree2 = scrutinee
					} else {
						tree2 = redblack.SharedTreeLeaf
					}
				} else {
					tree2 = redblack.Ins(k, true, tree)
				}
				var child *redblack.Tree
				if tree2 != redblack.SharedTreeLeaf {
					child = tree2.Node1
				} else {
					child = redblack.SharedTreeLeaf
				}
				var probedTreesGrown *redblack.Tree
				if tree2 != redblack.SharedTreeLeaf && tree2.Node0 == redblack.ColorRed {
					scrutinee := redblack.Ins(key, true, tree2)
					if scrutinee != redblack.SharedTreeLeaf {
						lOwned := scrutinee.Unique&1 != 0
						rOwned := scrutinee.Unique&2 != 0
						scrutinee.Node0 = redblack.ColorBlack
						scrutinee.Unique = shared.UniqueBit(lOwned, 1) | shared.UniqueBit(rOwned, 2)
						probedTreesGrown = scrutinee
					} else {
						probedTreesGrown = redblack.SharedTreeLeaf
					}
				} else {
					probedTreesGrown = redblack.Ins(key, true, tree2)
				}
				step, kept, probed, n = shared.ProjectedChildGoStep, listTreeCells.New(redblack_types.ListTree{Cons0: probedTreesGrown, Cons1: kept}), probed+redblack.Checksum(child), n-1
				continue
			}
			k2 := n * 2
			v := n%3 == 0
			var next *redblack.Tree
			if tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed {
				scrutinee := redblack.InsChecked(k2, v, tree, treeOwned)
				if scrutinee != redblack.SharedTreeLeaf {
					lOwned := scrutinee.Unique&1 != 0
					rOwned := scrutinee.Unique&2 != 0
					scrutinee.Node0 = redblack.ColorBlack
					scrutinee.Unique = shared.UniqueBit(lOwned, 1) | shared.UniqueBit(rOwned, 2)
					next = scrutinee
				} else {
					next = redblack.SharedTreeLeaf
				}
			} else {
				next = redblack.InsChecked(k2, v, tree, treeOwned)
			}
			var result *redblack_types.ListTree
			if n%7 == 0 {
				result = redblack_types.Cons(next, kept)
			} else {
				result = kept
			}
			tree, kept, n, treeOwned = next, result, n-1, !(n%7 == 0)
		}
	}
}

func projectedChildGo(tree *redblack.Tree, kept *redblack_types.ListTree, probed int32, n int32) redblack_types.ProbedTrees {
	return projectedChildGoOrProjectedChildGoChecked(shared.ProjectedChildGoStep, tree, kept, probed, n, false)
}

func projectedChildGoChecked(tree *redblack.Tree, kept *redblack_types.ListTree, probed int32, n int32, treeOwned bool) redblack_types.ProbedTrees {
	return projectedChildGoOrProjectedChildGoChecked(shared.ProjectedChildGoCheckedStep, tree, kept, probed, n, treeOwned)
}

func projectedChildGoReusing(tree *redblack.Tree, kept *redblack_types.ListTree, probed int32, n int32) redblack_types.ProbedTrees {
	if n <= 0 {
		return redblack_types.ProbedTrees{Probed: probed, Trees: redblack_types.Cons(tree, kept)}
	}
	if n%50 == 0 {
		key := n + 100000
		k := n*2 + 1
		var tree2 *redblack.Tree
		if tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed {
			scrutinee := redblack.Ins(k, true, tree)
			if scrutinee != redblack.SharedTreeLeaf {
				tree2 = redblack.Node(redblack.ColorBlack, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4)
			} else {
				tree2 = redblack.SharedTreeLeaf
			}
		} else {
			tree2 = redblack.Ins(k, true, tree)
		}
		var child *redblack.Tree
		if tree2 != redblack.SharedTreeLeaf {
			child = tree2.Node1
		} else {
			child = redblack.SharedTreeLeaf
		}
		var probedTreesGrown *redblack.Tree
		if tree2 != redblack.SharedTreeLeaf && tree2.Node0 == redblack.ColorRed {
			scrutinee := redblack.Ins(key, true, tree2)
			if scrutinee != redblack.SharedTreeLeaf {
				probedTreesGrown = redblack.Node(redblack.ColorBlack, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4)
			} else {
				probedTreesGrown = redblack.SharedTreeLeaf
			}
		} else {
			probedTreesGrown = redblack.Ins(key, true, tree2)
		}
		return projectedChildGo(tree, redblack_types.Cons(probedTreesGrown, kept), probed+redblack.Checksum(child), n-1)
	}
	k2 := n * 2
	v := n%3 == 0
	var next *redblack.Tree
	if tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed {
		scrutinee := redblack.InsChecked(k2, v, tree, true)
		if scrutinee != redblack.SharedTreeLeaf {
			next = redblack.Node(redblack.ColorBlack, scrutinee.Node1, scrutinee.Node2, scrutinee.Node3, scrutinee.Node4)
		} else {
			next = redblack.SharedTreeLeaf
		}
	} else {
		next = redblack.InsChecked(k2, v, tree, true)
	}
	var result *redblack_types.ListTree
	if n%7 == 0 {
		result = redblack_types.Cons(next, kept)
	} else {
		result = kept
	}
	return projectedChildGoChecked(next, result, probed, n-1, !(n%7 == 0))
}

func mainGoReusing(acc *redblack_types.ListTree, list *redblack_types.ListTree) *redblack_types.ListTree {
	var listTreeCells alloc.Cells[redblack_types.ListTree]
	for {
		if list == redblack_types.SharedListTreeNil {
			return list_redblack.ReverseTreeReusing(acc)
		}
		x := list.Cons0
		xs := list.Cons1
		if !(redblack.BlackHeight(x) > 0 && redblack.Ordered(-1000000, 1000000, x)) {
			acc, list = listTreeCells.New(redblack_types.ListTree{Cons0: x, Cons1: acc}), xs
			continue
		}
		list = xs
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/Data.List+RedBlack/list_redblack.go
package list_redblack

import "fixture/shared/RedBlack+Data.List.Types"

func LengthTree(value *redblack_types.ListTree) int32 {
	return LengthTreeGo(0, value)
}

func LengthTreeGo(b int32, value *redblack_types.ListTree) int32 {
	for {
		if value == redblack_types.SharedListTreeNil {
			return b
		}
		as := value.Cons1
		b, value = b+1, as
	}
}

func ReverseTreeReusing(list *redblack_types.ListTree) *redblack_types.ListTree {
	return ReverseTreeGoReusing(redblack_types.SharedListTreeNil, list)
}

func ReverseTreeGoReusing(acc *redblack_types.ListTree, list *redblack_types.ListTree) *redblack_types.ListTree {
	for {
		if list == redblack_types.SharedListTreeNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// shared/RedBlack+Data.List.Types/redblack_types.go
package redblack_types

import (
	"fixture/Data/List/Types"
	"fixture/RedBlack"
	"github.com/i-am-the-slime/iris-go/alloc"
)

type ListTree struct {
	Cons0 *redblack.Tree
	Cons1 *ListTree
}

var SharedListTreeNil = &ListTree{}

type ProbedTrees struct {
	Trees  *ListTree
	Probed int32
}

type ListListTree struct {
	Cons0 *ListTree
	Cons1 *ListListTree
}

var SharedListListTreeNil = &ListListTree{}

func Cons(cons0 *redblack.Tree, cons1 *ListTree) *ListTree {
	return &ListTree{Cons0: cons0, Cons1: cons1}
}

func Map_(f func(*redblack.Tree) int32, list *ListTree) *types.ListInt {
	return MapChunkedRevMap(f, SharedListListTreeNil, list)
}

func MapSize(list *ListTree) *types.ListInt {
	return MapSizeChunkedRevMap(SharedListListTreeNil, list)
}

func MapChunkedRevMap(f func(*redblack.Tree) int32, chunksAcc *ListListTree, chunk *ListTree) *types.ListInt {
	var listListTreeCells alloc.Cells[ListListTree]
	for {
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 != SharedListTreeNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListTreeCells.New(ListListTree{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *types.ListInt
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 == SharedListTreeNil {
			result = types.Cons(f(chunk.Cons0), types.Cons(f(chunk.Cons1.Cons0), types.SharedListIntNil))
		} else if chunk != SharedListTreeNil && chunk.Cons1 == SharedListTreeNil {
			result = types.Cons(f(chunk.Cons0), types.SharedListIntNil)
		} else {
			result = types.SharedListIntNil
		}
		return MapChunkedRevMapReverseUnrolledMap(f, chunksAcc, result)
	}
}

func MapChunkedRevMapReverseUnrolledMap(f func(*redblack.Tree) int32, list *ListListTree, acc *types.ListInt) *types.ListInt {
	var listIntCells alloc.Cells[types.ListInt]
	for {
		if list != SharedListListTreeNil && list.Cons0 != SharedListTreeNil && list.Cons0.Cons1 != SharedListTreeNil && list.Cons0.Cons1.Cons1 != SharedListTreeNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listIntCells.New(types.ListInt{Cons0: f(x1), Cons1: listIntCells.New(types.ListInt{Cons0: f(x2), Cons1: listIntCells.New(types.ListInt{Cons0: f(x3), Cons1: acc})})})
			continue
		}
		return acc
	}
}

func MapSizeChunkedRevMap(chunksAcc *ListListTree, chunk *ListTree) *types.ListInt {
	var listListTreeCells alloc.Cells[ListListTree]
	for {
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 != SharedListTreeNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListTreeCells.New(ListListTree{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *types.ListInt
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 == SharedListTreeNil {
			result = types.Cons(redblack.Size(chunk.Cons0), types.Cons(redblack.Size(chunk.Cons1.Cons0), types.SharedListIntNil))
		} else if chunk != SharedListTreeNil && chunk.Cons1 == SharedListTreeNil {
			result = types.Cons(redblack.Size(chunk.Cons0), types.SharedListIntNil)
		} else {
			result = types.SharedListIntNil
		}
		return MapSizeChunkedRevMapReverseUnrolledMap(chunksAcc, result)
	}
}

func MapSizeChunkedRevMapReverseUnrolledMap(list *ListListTree, acc *types.ListInt) *types.ListInt {
	var listIntCells alloc.Cells[types.ListInt]
	for {
		if list != SharedListListTreeNil && list.Cons0 != SharedListTreeNil && list.Cons0.Cons1 != SharedListTreeNil && list.Cons0.Cons1.Cons1 != SharedListTreeNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listIntCells.New(types.ListInt{Cons0: redblack.Size(x1), Cons1: listIntCells.New(types.ListInt{Cons0: redblack.Size(x2), Cons1: listIntCells.New(types.ListInt{Cons0: redblack.Size(x3), Cons1: acc})})})
			continue
		}
		return acc
	}
}

// shared/shared.go
package shared

func UniqueBit(owned bool, bit uint8) uint8 {
	if owned {
		return bit
	}
	return 0
}

const (
	ProjectedChildGoStep = iota
	ProjectedChildGoCheckedStep
)
