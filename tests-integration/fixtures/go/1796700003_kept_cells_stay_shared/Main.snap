// main.go
package main

import (
	keeper "fixture/Keeper_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int
}

var sharedTreeLeaf = &Tree{}

type TotalTree struct {
	Tree  *Tree
	Total int
}

func Node(node0 *Tree, node1 int, node2 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: node1, Node2: node2}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	tree := sample(3)
	i := stashedAfter(2, tree)
	var fromStoring int
	if i > 0 {
		fromStoring = total(incremented(tree))
	} else {
		fromStoring = 0
	}
	effect := func() []int {
		var fromTheRef *Tree
		if fromStoring > 0 {
			fromTheRef = stashed.Value
		} else {
			fromTheRef = sharedTreeLeaf
		}
		tree2 := sample(3)
		var fromKeeping int
		if keptAfter(2, tree2) > 0 {
			fromKeeping = total(incremented(tree2))
		} else {
			fromKeeping = 0
		}
		var fromTheForeign *Tree
		if fromKeeping > 0 {
			fromTheForeign = keeper.Kept[*Tree]()
		} else {
			fromTheForeign = sharedTreeLeaf
		}
		tree3 := sample(3)
		record := withTotalAfter(2, tree3)
		var result int
		if record.Total > 0 {
			result = total(incremented(tree3))*1000 + total(record.Tree)
		} else {
			result = 0
		}
		tree4 := sample(3)
		later := totalLaterAfter(2, tree4)
		var result2 int
		if later(struct{}{}) > 0 {
			result2 = total(incremented(tree4))*1000 + later(struct{}{})
		} else {
			result2 = 0
		}
		return []int{fromStoring, total(fromTheRef), result, result2, fromKeeping, total(fromTheForeign)}
	}
	return effect()
}

var stashed = initializeStashed()

func initializeStashed() *shared.Ref[*Tree] {
	return &shared.Ref[*Tree]{Value: sharedTreeLeaf}
}

func total(value *Tree) int {
	if value == sharedTreeLeaf {
		return 0
	}
	return total(value.Node0) + value.Node1 + total(value.Node2)
}

func sample(depth int) *Tree {
	var cells alloc.Cells[Tree]
	return sampleChunked(depth, &cells)
}

func sampleChunked(depth int, cells *alloc.Cells[Tree]) *Tree {
	if depth == 0 {
		return sharedTreeLeaf
	}
	return cells.New(Tree{Node0: sampleChunked(depth-1, cells), Node1: depth, Node2: sampleChunked(depth-1, cells)})
}

func stashedAfter(countdown int, tree *Tree) int {
	for {
		treeCaptured := tree
		if countdown == 0 {
			effect := func() int {
				stashed.Value = treeCaptured
				return total(treeCaptured)
			}
			return effect()
		}
		countdown, tree = countdown-1, treeCaptured
	}
}

func incremented(value *Tree) *Tree {
	if value == sharedTreeLeaf {
		return sharedTreeLeaf
	}
	return Node(incremented(value.Node0), value.Node1+1, incremented(value.Node2))
}

func keptAfter(countdown int, tree *Tree) int {
	for {
		if countdown == 0 {
			return keeper.Keep(tree)
		}
		countdown -= 1
	}
}

func withTotalAfter(countdown int, tree *Tree) TotalTree {
	for {
		if countdown == 0 {
			argument := total(tree)
			return TotalTree{Total: argument, Tree: tree}
		}
		countdown -= 1
	}
}

func totalLaterAfter(countdown int, tree *Tree) func(struct{}) int {
	for {
		treeCaptured := tree
		if countdown == 0 {
			return func(_ struct{}) int {
				return total(treeCaptured)
			}
		}
		countdown, tree = countdown-1, treeCaptured
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}
