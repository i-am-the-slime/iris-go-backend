// Data/Array/array.go
package dataarray

import (
	"fixture/Data/Tuple"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/direct"
)

func FoldMEffectTupleUnitUnitUnitF(ref *shared.Ref[int32], b struct{}, array []tuple.TupleUnitUnit) {
	function := func(_ struct{}) {
	}
	direct.Uncons(func(unit struct{}) func() {
		return func() {
			function(unit)
		}
	}, func(a tuple.TupleUnitUnit, as []tuple.TupleUnitUnit) func() {
		return func() {
			s := ref.Value
			s_ := s + 1
			ref.Value = s_
			FoldMEffectTupleUnitUnitUnitF(ref, struct{}{}, as)
		}
	}, array)()
}

// Data/Tuple/tuple.go
package tuple

type TupleUnitUnit struct {
	First  struct{}
	Second struct{}
}

// main.go
package main

import (
	"fixture/Data/Array"
	"fixture/Data/Tuple"
	"fixture/shared"
	"os"
)

func main_() int32 {
	var same int32 = 1
	count := &shared.Ref[int32]{Value: 0}
	dataarray.FoldMEffectTupleUnitUnitUnitF(count, struct{}{}, units)
	counted := count.Value
	var accumulator int32 = 0
	for range units {
		accumulator += 1
	}
	return same*100 + counted*10 + accumulator
}

var units []tuple.TupleUnitUnit = []tuple.TupleUnitUnit{{First: struct{}{}, Second: struct{}{}}, {First: struct{}{}, Second: struct{}{}}}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type ActualExpected struct {
	Actual   struct{}
	Expected struct{}
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
