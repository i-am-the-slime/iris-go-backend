// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  struct{}
	Second struct{}
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"os"
)

func main_() int {
	count := 0
	for range units {
		count += 1
	}
	accumulator := 0
	for range units {
		accumulator += 1
	}
	return 100 + count*10 + accumulator
}

var units []tuple.Tuple = []tuple.Tuple{{First: struct{}{}, Second: struct{}{}}, {First: struct{}{}, Second: struct{}{}}}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
