// Data/Array/array.go
package dataarray

import (
	"fixture/Data/Tuple"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
)

func FoldMEffectTupleUnitUnitUnit(f func(struct{}, tuple.TupleUnitUnit), b struct{}, array []tuple.TupleUnitUnit) {
	function := func(_ struct{}) {
	}
	direct.Uncons(func(unit struct{}) func() {
		return func() {
			function(unit)
		}
	}, func(a tuple.TupleUnitUnit, as []tuple.TupleUnitUnit) func() {
		return func() {
			f(b, a)
			FoldMEffectTupleUnitUnitUnit(f, struct{}{}, as)
		}
	}, array)()
}

// Data/Tuple/tuple.go
package tuple

type TupleUnitUnit struct {
	First  struct{}
	Second struct{}
}

// main.go
package main

import (
	"fixture/Data/Array"
	"fixture/Data/Tuple"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
	"os"
)

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

func main_() int32 {
	var i int32 = 1
	ref := &Ref[int32]{Value: 0}
	dataarray.FoldMEffectTupleUnitUnitUnit(func(_ struct{}, pair tuple.TupleUnitUnit) {
		s := ref.Value
		s_ := s + 1
		modified := StateValue{State: s_, Value: s_}
		ref.Value = modified.State
	}, struct{}{}, units)
	i2 := ref.Value
	var accumulator int32 = 0
	for range units {
		total := accumulator
		accumulator = total + 1
	}
	return prim.MultiplyInt32(i, 100) + prim.MultiplyInt32(i2, 10) + accumulator
}

var units []tuple.TupleUnitUnit = []tuple.TupleUnitUnit{tuple.TupleUnitUnit{First: struct{}{}, Second: struct{}{}}, tuple.TupleUnitUnit{First: struct{}{}, Second: struct{}{}}}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type ActualExpected struct {
	Actual   struct{}
	Expected struct{}
}
