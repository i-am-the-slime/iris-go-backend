// Data/Tuple/tuple.go
package tuple

type TupleUnitUnit struct {
	First  struct{}
	Second struct{}
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"os"
)

func main_() int32 {
	var count int32 = 0
	for range units {
		count += 1
	}
	var accumulator int32 = 0
	for range units {
		accumulator += 1
	}
	return 100 + count*10 + accumulator
}

var units []tuple.TupleUnitUnit = []tuple.TupleUnitUnit{{First: struct{}{}, Second: struct{}{}}, {First: struct{}{}, Second: struct{}{}}}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

type ActualExpected struct {
	Actual   struct{}
	Expected struct{}
}
