// Data/Either/either.go
package either

type EitherStringInt struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringIntLeft = iota
	EitherStringIntRight
)

// Data/List/Types/types.go
package types

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
}

var SharedListIntNil = &ListInt{}

// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/List/Types"
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared/Data.Either+Data.Tuple"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Labelled struct {
	Tag0 string
	Tag  uint8
}

const (
	LabelledTag = iota
	LabelledUntagged
)

type Entry struct {
	Duo0   string
	Duo1   string
	Trio0  string
	Trio1  string
	Field0 int32
	Field1 int32
	Tag    uint8
}

const (
	EntryField = iota
	EntryDuo
	EntryTrio
)

var main_ = initializeMain_()

func initializeMain_() string {
	array := []either_tuple.TupleMaybeIntEitherStringInt{{First: maybe.Int(1), Second: either.EitherStringInt{Tag: either.EitherStringIntRight, Right: 2}}, {First: maybe.NoInt, Second: either.EitherStringInt{Tag: either.EitherStringIntLeft, Left: "x"}}}
	var accumulator int32 = 0
	for tupleIndex := range array {
		if array[tupleIndex].First != maybe.NoInt && array[tupleIndex].Second.Tag == either.EitherStringIntRight {
			accumulator = accumulator + int32(array[tupleIndex].First) + array[tupleIndex].Second.Right
		} else if array[tupleIndex].Second.Tag == either.EitherStringIntLeft {
			accumulator -= 1
		}
	}
	array2 := []Labelled{{Tag: LabelledTag, Tag0: "t"}, {Tag: LabelledUntagged}}
	mapped := make([]string, len(array2))
	for index, element := range array2 {
		mapped[index] = label(element)
	}
	array3 := []Entry{{Tag: EntryField, Field0: 5, Field1: 1}, {Tag: EntryDuo, Duo0: "a", Duo1: "b"}, {Tag: EntryTrio, Trio0: "c", Trio1: "d"}}
	mapped2 := make([]string, len(array3))
	for index, element := range array3 {
		mapped2[index] = entry(element)
	}
	return strconv.Itoa(int(accumulator+mainSum(&types.ListInt{Cons0: 3, Cons1: &types.ListInt{Cons0: 4, Cons1: types.SharedListIntNil}}))) + prim.ShowArray(show.Show, mapped) + prim.ShowArray(show.Show, mapped2)
}

func label(labelled Labelled) string {
	switch labelled.Tag {
	case LabelledTag:
		return labelled.Tag0
	default: // LabelledUntagged
		return "none"
	}
}

func entry(entry Entry) string {
	switch entry.Tag {
	case EntryField:
		return strconv.Itoa(int(entry.Field0 - entry.Field1))
	case EntryDuo:
		return prim.Append(entry.Duo0, entry.Duo1)
	default: // EntryTrio
		return prim.Append(entry.Trio1, entry.Trio0)
	}
}

func mainSum(list *types.ListInt) int32 {
	if list == types.SharedListIntNil {
		return 0
	}
	return list.Cons0 + mainSum(list.Cons1)
}

func main() {
	console.Print(main_)
}

// shared/Data.Either+Data.Tuple/either_tuple.go
package either_tuple

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
)

type TupleMaybeIntEitherStringInt struct {
	Second either.EitherStringInt
	First  maybe.Int
}
