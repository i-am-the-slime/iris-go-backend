// Data/Either/either.go
package either

type Either struct {
	Left  string
	Right int
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Right(right int) Either {
	return Either{Tag: EitherRight, Right: right}
}

func Left(left string) Either {
	return Either{Tag: EitherLeft, Left: left}
}

// Data/List/Types/types.go
package types

type List struct {
	Cons1 *List
	Cons0 int
}

var SharedListNil = &List{}

func Cons(cons0 int, cons1 *List) *List {
	return &List{Cons0: cons0, Cons1: cons1}
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/List/Types"
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared/Data.Either+Data.Tuple"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Labelled struct {
	Tag0 string
	Tag  uint8
}

const (
	LabelledTag = iota
	LabelledUntagged
)

type Entry struct {
	Duo0   string
	Duo1   string
	Trio0  string
	Trio1  string
	Field0 int
	Field1 int
	Tag    uint8
}

const (
	EntryField = iota
	EntryDuo
	EntryTrio
)

func Tag(tag0 string) Labelled {
	return Labelled{Tag: LabelledTag, Tag0: tag0}
}

func Field(field0 int, field1 int) Entry {
	return Entry{Tag: EntryField, Field0: field0, Field1: field1}
}

func Duo(duo0 string, duo1 string) Entry {
	return Entry{Tag: EntryDuo, Duo0: duo0, Duo1: duo1}
}

func Trio(trio0 string, trio1 string) Entry {
	return Entry{Tag: EntryTrio, Trio0: trio0, Trio1: trio1}
}

var main_ = initializeMain_()

func initializeMain_() string {
	var text []byte
	array := []either_tuple.Tuple{{First: maybe.JustInt(1), Second: either.Right(2)}, {First: maybe.NoInt, Second: either.Left("x")}}
	accumulator := 0
	for tupleIndex := range array {
		if array[tupleIndex].First.Tag == maybe.TagJust && array[tupleIndex].Second.Tag == either.EitherRight {
			accumulator = accumulator + array[tupleIndex].First.Just + array[tupleIndex].Second.Right
		} else if array[tupleIndex].Second.Tag == either.EitherLeft {
			accumulator -= 1
		}
	}
	text = strconv.AppendInt(text, int64(accumulator+mainSumCons(3, types.Cons(4, types.SharedListNil))), 10)
	array2 := []Labelled{Tag("t"), {Tag: LabelledUntagged}}
	mapped := make([]string, len(array2))
	for index, element := range array2 {
		mapped[index] = label(element)
	}
	text = show.AppendShowArrayString(text, mapped)
	array3 := []Entry{Field(5, 1), Duo("a", "b"), Trio("c", "d")}
	mapped2 := make([]string, len(array3))
	for index, element := range array3 {
		mapped2[index] = entry(element)
	}
	text = show.AppendShowArrayString(text, mapped2)
	return string(text)
}

func label(labelled Labelled) string {
	switch labelled.Tag {
	case LabelledTag:
		return labelled.Tag0
	default: // LabelledUntagged
		return "none"
	}
}

func entry(entry Entry) string {
	switch entry.Tag {
	case EntryField:
		return strconv.Itoa(entry.Field0 - entry.Field1)
	case EntryDuo:
		return prim.Append(entry.Duo0, entry.Duo1)
	default: // EntryTrio
		return prim.Append(entry.Trio1, entry.Trio0)
	}
}

func mainSum(list *types.List) int {
	if list == types.SharedListNil {
		return 0
	}
	return list.Cons0 + mainSum(list.Cons1)
}

func mainSumCons(head int, tail *types.List) int {
	return head + mainSum(tail)
}

func main() {
	console.Print(main_)
}

// shared/Data.Either+Data.Tuple/either_tuple.go
package either_tuple

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
)

type Tuple struct {
	Second either.Either
	First  maybe.Int
}
