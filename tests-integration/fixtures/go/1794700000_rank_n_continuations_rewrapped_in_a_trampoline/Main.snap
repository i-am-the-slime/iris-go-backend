// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Step struct {
	More func(struct{}) Step
	Stop string
	Done int
	Tag  uint8
}

const (
	StepMore = iota
	StepStop
	StepDone
)

func More(more func(struct{}) Step) Step {
	return Step{Tag: StepMore, More: more}
}

type Failure struct {
	Failure string
}

func Done(done int) Step {
	return Step{Tag: StepDone, Done: done}
}

type M func(int, func(func(struct{}) Step) Step, func(Failure) Step, func(int) Step) Step

func Stop(stop string) Step {
	return Step{Tag: StepStop, Stop: stop}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	scrutinee := mainGo(loop(30, 0)(0, More, func(failure Failure) Step {
		return Stop(failure.Failure)
	}, Done))
	var result int
	switch scrutinee.Tag {
	case StepDone:
		result = scrutinee.Done
	case StepStop:
		result = -1
	default: // StepMore
		result = -2
	}
	return []int{result}
}

func loop(i int, total int) M {
	if i <= 0 {
		return func(_ int, _ func(func(struct{}) Step) Step, _ func(Failure) Step, done func(int) Step) Step {
			return done(total)
		}
	}
	return func(env int, more func(func(struct{}) Step) Step, failure func(Failure) Step, done func(int) Step) Step {
		return more(func(_ struct{}) Step {
			return ask(env+i, more, failure, func(shifted int) Step {
				m := countdown(prim.IntModPositive(i, 3))
				return more(func(_ struct{}) Step {
					return more(func(_ struct{}) Step {
						return m(env, more, failure, func(counted int) Step {
							n := loop(i-1, prim.IntModPositive(total+shifted+counted, 1000003))
							return more(func(_ struct{}) Step {
								return n(env, more, failure, done)
							})
						})
					})
				})
			})
		})
	}
}

var ask M = func(env int, _ func(func(struct{}) Step) Step, _ func(Failure) Step, done func(int) Step) Step {
	return done(env)
}

func countdown(n int) M {
	if n <= 0 {
		return ask
	}
	return func(env int, more func(func(struct{}) Step) Step, failure func(Failure) Step, done func(int) Step) Step {
		return more(func(_ struct{}) Step {
			return ask(env, more, failure, func(_ int) Step {
				n2 := countdown(n - 1)
				return more(func(_ struct{}) Step {
					return n2(env, more, failure, done)
				})
			})
		})
	}
}

func mainGo(value Step) Step {
	for {
		switch value.Tag {
		case StepMore:
			next := value.More
			value = next(struct{}{})
			continue
		default:
			return value
		}
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
