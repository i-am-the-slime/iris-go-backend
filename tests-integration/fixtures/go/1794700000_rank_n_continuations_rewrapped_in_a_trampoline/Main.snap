// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type StepInt struct {
	More func(struct{}) StepInt
	Stop string
	Done int32
	Tag  uint8
}

const (
	StepIntMore = iota
	StepIntStop
	StepIntDone
)

func More(more func(struct{}) StepInt) StepInt {
	return StepInt{Tag: StepIntMore, More: more}
}

type Failure struct {
	Failure string
}

func Done(done int32) StepInt {
	return StepInt{Tag: StepIntDone, Done: done}
}

type M func(int32, func(func(struct{}) StepInt) StepInt, func(Failure) StepInt, func(int32) StepInt) StepInt

var main_ = initializeMain_()

func initializeMain_() []int32 {
	scrutinee := mainGo(loop(30, 0)(0, More, func(failure Failure) StepInt {
		return StepInt{Tag: StepIntStop, Stop: failure.Failure}
	}, Done))
	var result int32
	switch scrutinee.Tag {
	case StepIntDone:
		result = scrutinee.Done
	case StepIntStop:
		result = -1
	default: // StepIntMore
		result = -2
	}
	return []int32{result}
}

func loop(i int32, total int32) M {
	if i <= 0 {
		return func(_ int32, _ func(func(struct{}) StepInt) StepInt, _ func(Failure) StepInt, done func(int32) StepInt) StepInt {
			return done(total)
		}
	}
	return func(env int32, more func(func(struct{}) StepInt) StepInt, failure func(Failure) StepInt, done func(int32) StepInt) StepInt {
		return more(func(_ struct{}) StepInt {
			return askParse(env+i, more, failure, func(a int32) StepInt {
				m := countdown(prim.IntModPositive(i, 3))
				return more(func(_ struct{}) StepInt {
					return more(func(_ struct{}) StepInt {
						return m(env, more, failure, func(a2 int32) StepInt {
							n := loop(i-1, prim.IntModPositive(total+a+a2, 1000003))
							return more(func(_ struct{}) StepInt {
								return n(env, more, failure, done)
							})
						})
					})
				})
			})
		})
	}
}

var askParse M = func(env int32, _ func(func(struct{}) StepInt) StepInt, _ func(Failure) StepInt, done func(int32) StepInt) StepInt {
	return done(env)
}

func countdown(n int32) M {
	if n <= 0 {
		return askParse
	}
	return func(env int32, more func(func(struct{}) StepInt) StepInt, failure func(Failure) StepInt, done func(int32) StepInt) StepInt {
		return more(func(_ struct{}) StepInt {
			return askParse(env, more, failure, func(_ int32) StepInt {
				n2 := countdown(n - 1)
				return more(func(_ struct{}) StepInt {
					return n2(env, more, failure, done)
				})
			})
		})
	}
}

func mainGo(value StepInt) StepInt {
	for {
		switch value.Tag {
		case StepIntMore:
			next := value.More
			value = next(struct{}{})
			continue
		default:
			return value
		}
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
