// Data/Maybe/maybe.go
package maybe

import "fixture/shared"

const TagNothing = 0

const TagJust = 1

type Inner struct {
	Just shared.Inner
	Tag  uint8
}

func JustInner(just shared.Inner) Inner {
	return Inner{Tag: TagJust, Just: just}
}

var NoInner = Inner{Tag: TagNothing}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int) string {
	return strconv.Itoa(i)
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayArrayInt(array [][]int) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	repeated "fixture/Repeated_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main_() []string {
	array := []shared.Inner{{A: 1, B: "one"}, {A: 2, B: "two"}}
	accumulator := repeated.Empty[shared.Inner]()
	for _, inner := range array {
		accumulator = repeated.SnocImpl(accumulator, inner)
	}
	array2 := []shared.Outer{{Name: "outer", Inner: shared.Inner{A: 3, B: "three"}, Tags: repeated.Freeze(accumulator)}}
	accumulator2 := repeated.Empty[shared.Outer]()
	for _, outer2 := range array2 {
		accumulator2 = repeated.SnocImpl(accumulator2, outer2)
	}
	outer := repeated.IndexOrImpl(shared.Outer{Name: "none", Inner: shared.Inner{A: 0, B: ""}, Tags: []shared.Inner{}}, 0, accumulator2)
	array3 := repeated.Freeze(accumulator)
	mapped := make([]int, len(array3))
	for index := range array3 {
		mapped[index] = array3[index].A
	}
	text := prim.AppendString(nil, outer.Name)
	text = prim.AppendString(text, outer.Inner.B)
	mapped2 := make([]int, len(outer.Tags))
	for index, value := range outer.Tags {
		mapped2[index] = value.A
	}
	text = show.AppendShowArrayInt(text, mapped2)
	array4 := [][]shared.Inner{{{A: 4, B: "four"}}, {}}
	accumulator3 := repeated.Empty[[]shared.Inner]()
	for _, array5 := range array4 {
		accumulator3 = repeated.SnocImpl(accumulator3, array5)
	}
	array6 := repeated.Freeze(accumulator3)
	mapped3 := make([][]int, len(array6))
	for index, array5 := range array6 {
		mapped4 := make([]int, len(array5))
		for index2 := range array5 {
			mapped4[index2] = array5[index2].A
		}
		mapped3[index] = mapped4
	}
	array7 := []maybe.Inner{maybe.JustInner(shared.Inner{A: 5, B: "five"}), maybe.NoInner}
	accumulator4 := repeated.Empty[maybe.Inner]()
	for _, maybe := range array7 {
		accumulator4 = repeated.SnocImpl(accumulator4, maybe)
	}
	array8 := repeated.Freeze(accumulator4)
	mapped5 := make([]string, len(array8))
	for index := range array8 {
		var result string
		switch array8[index].Tag {
		case maybe.TagNothing:
			result = ""
		default: // maybe.TagJust
			result = array8[index].Just.B
		}
		mapped5[index] = result
	}
	return []string{show.ArrayInt(mapped), strconv.Itoa(repeated.Length(accumulator2)), string(text), show.ArrayArrayInt(mapped3), show.ArrayString(mapped5), repeated.Describe(any(repeated.IndexOrImpl(shared.Inner{A: 0, B: ""}, 1, accumulator))), repeated.Describe(7)}
}

func main() {
	main_()
}

// shared/shared.go
package shared

type Inner struct {
	B string
	A int
}

type Outer struct {
	Inner Inner
	Name  string
	Tags  []Inner
}
