// Data/Maybe/maybe.go
package maybe

import "fixture/shared"

const TagNothing = 0

const TagJust = 1

type Inner struct {
	Just shared.Inner
	Tag  uint8
}

func JustInner(just shared.Inner) Inner {
	return Inner{Tag: TagJust, Just: just}
}

var NoInner = Inner{Tag: TagNothing}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayArrayInt(array [][]int) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	repeated "fixture/Repeated_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main_() []string {
	inners := repeated.SnocImpl(repeated.SnocImpl(repeated.Empty[shared.Inner](), shared.Inner{A: 1, B: "one"}), shared.Inner{A: 2, B: "two"})
	outers := repeated.SnocImpl(repeated.Empty[shared.Outer](), shared.Outer{Name: "outer", Inner: shared.Inner{A: 3, B: "three"}, Tags: repeated.Freeze(inners)})
	outer := repeated.IndexOrImpl(shared.Outer{Name: "none", Inner: shared.Inner{A: 0, B: ""}, Tags: []shared.Inner{}}, 0, outers)
	array := repeated.Freeze(inners)
	mapped := make([]int, len(array))
	for index := range array {
		mapped[index] = array[index].A
	}
	text := prim.AppendString(nil, outer.Name)
	text = prim.AppendString(text, outer.Inner.B)
	mapped2 := make([]int, len(outer.Tags))
	for index, value := range outer.Tags {
		mapped2[index] = value.A
	}
	text = show.AppendShowArrayInt(text, mapped2)
	array2 := repeated.Freeze(repeated.SnocImpl(repeated.SnocImpl(repeated.Empty[[]shared.Inner](), []shared.Inner{{A: 4, B: "four"}}), []shared.Inner{}))
	mapped3 := make([][]int, len(array2))
	for index, array3 := range array2 {
		mapped4 := make([]int, len(array3))
		for index2 := range array3 {
			mapped4[index2] = array3[index2].A
		}
		mapped3[index] = mapped4
	}
	array4 := repeated.Freeze(repeated.SnocImpl(repeated.SnocImpl(repeated.Empty[maybe.Inner](), maybe.JustInner(shared.Inner{A: 5, B: "five"})), maybe.NoInner))
	mapped5 := make([]string, len(array4))
	for index := range array4 {
		var result string
		switch array4[index].Tag {
		case maybe.TagNothing:
			result = ""
		default: // maybe.TagJust
			result = array4[index].Just.B
		}
		mapped5[index] = result
	}
	return []string{show.ArrayInt(mapped), strconv.Itoa(repeated.Length(outers)), string(text), show.ArrayArrayInt(mapped3), show.ArrayString(mapped5), repeated.Describe(any(repeated.IndexOrImpl(shared.Inner{A: 0, B: ""}, 1, inners))), repeated.Describe(7)}
}

func main() {
	main_()
}

// shared/shared.go
package shared

type Inner struct {
	B string
	A int
}

type Outer struct {
	Inner Inner
	Name  string
	Tags  []Inner
}
