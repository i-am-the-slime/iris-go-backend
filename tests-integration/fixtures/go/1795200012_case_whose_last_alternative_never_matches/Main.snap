---
source: tests-integration/src/fixtures.rs
---
// Data/List/Types/types.go
package types

type List struct {
	Cons0 struct{}
	Cons1 *List
}

var SharedListNil = &List{}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

// main.go
package main

import (
	list "fixture/Data/List/Types"
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	var result int
	switch maybe.NoInt.Tag {
	case maybe.TagNothing:
		var result2 int
		switch maybe.NoInt.Tag {
		case maybe.TagNothing:
			result2 = -17
		default: // maybe.TagJust
			result2 = maybe.NoInt.Just
		}
		listUnits := make([]list.List, 3)
		listUnits[0] = list.List{Cons0: struct{}{}, Cons1: &listUnits[1]}
		listUnits[1] = list.List{Cons0: struct{}{}, Cons1: &listUnits[2]}
		listUnits[2] = list.List{Cons0: struct{}{}, Cons1: list.SharedListNil}
		result = mainGo(func(x int) int {
			return x
		}, &listUnits[0])(result2)
	default: // maybe.TagJust
		result = maybe.NoInt.Just
	}
	var result3 int
	switch maybe.NoInt.Tag {
	case maybe.TagNothing:
		var result2 int
		switch maybe.NoInt.Tag {
		case maybe.TagNothing:
			result2 = -17
		default: // maybe.TagJust
			result2 = maybe.NoInt.Just
		}
		listUnits2 := make([]list.List, 3)
		listUnits2[0] = list.List{Cons0: struct{}{}, Cons1: &listUnits2[1]}
		listUnits2[1] = list.List{Cons0: struct{}{}, Cons1: &listUnits2[2]}
		listUnits2[2] = list.List{Cons0: struct{}{}, Cons1: list.SharedListNil}
		result3 = mainGo(func(x int) int {
			return x
		}, &listUnits2[0])(result2)
	default: // maybe.TagJust
		result3 = maybe.NoInt.Just
	}
	var result4 int
	switch maybe.NoInt.Tag {
	case maybe.TagNothing:
		var result2 int
		switch maybe.NoInt.Tag {
		case maybe.TagNothing:
			result2 = -17
		default: // maybe.TagJust
			result2 = maybe.NoInt.Just
		}
		listUnits3 := make([]list.List, 3)
		listUnits3[0] = list.List{Cons0: struct{}{}, Cons1: &listUnits3[1]}
		listUnits3[1] = list.List{Cons0: struct{}{}, Cons1: &listUnits3[2]}
		listUnits3[2] = list.List{Cons0: struct{}{}, Cons1: list.SharedListNil}
		result4 = mainGo(func(x int) int {
			return x
		}, &listUnits3[0])(result2)
	default: // maybe.TagJust
		result4 = maybe.NoInt.Just
	}
	return []int{result, result3, result4}
}

func mainGo(b func(int) int, value *list.List) func(int) int {
	for {
		if value == list.SharedListNil {
			return b
		}
		value = value.Cons1
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
