source: tests-integration/src/fixtures.rs
---
// Data/List/Types/types.go
package types

type List struct {
	Cons0 struct{}
	Cons1 *List
}

var SharedListNil = &List{}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

// main.go
package main

import (
	list "fixture/Data/List/Types"
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	return []int{defaulted(1.0), defaulted(2.0), defaulted(3.0)}
}

func defaulted(ignored float64) int {
	switch maybe.NoInt.Tag {
	case maybe.TagNothing:
		array := []struct{}{{}, {}, {}}
		accumulator := list.SharedListNil
		var listUnitCells alloc.Cells[list.List]
		for index := len(array) - 1; index >= 0; index-- {
			unit := array[index]
			accumulator = listUnitCells.New(list.List{Cons0: unit, Cons1: accumulator})
		}
		var result int
		switch maybe.NoInt.Tag {
		case maybe.TagNothing:
			result = -17
		default: // maybe.TagJust
			result = maybe.NoInt.Just
		}
		return defaultedGo(func(x int) int {
			return x
		}, accumulator)(result)
	default: // maybe.TagJust
		return maybe.NoInt.Just
	}
}

func defaultedGo(b func(int) int, value *list.List) func(int) int {
	for {
		if value == list.SharedListNil {
			return b
		}
		value = value.Cons1
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
