// Data/List/Types/types.go
package types

type List struct {
	Cons0 struct{}
	Cons1 *List
}

var SharedListNil = &List{}

// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	list "fixture/Data/List/Types"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	return []int32{defaulted(1.0), defaulted(2.0), defaulted(3.0)}
}

func defaulted(ignored float64) int32 {
	array := []struct{}{{}, {}, {}}
	accumulator := list.SharedListNil
	var listUnitCells alloc.Cells[list.List]
	for index := len(array) - 1; index >= 0; index-- {
		unit := array[index]
		accumulator = listUnitCells.New(list.List{Cons0: unit, Cons1: accumulator})
	}
	var result int32
	result = -17
	return defaultedGo(func(x int32) int32 {
		return x
	}, accumulator)(result)
}

func defaultedGo(b func(int32) int32, value *list.List) func(int32) int32 {
	for {
		if value == list.SharedListNil {
			return b
		}
		value = value.Cons1
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
