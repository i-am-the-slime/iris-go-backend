// Data/List/Types/types.go
package types

type ListUnit struct {
	Cons0 struct{}
	Cons1 *ListUnit
}

var SharedListUnitNil = &ListUnit{}

// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	list "fixture/Data/List/Types"
	"fmt"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	return []int32{defaulted(1.0), defaulted(2.0), defaulted(3.0)}
}

func defaulted(ignored float64) int32 {
	array := []struct{}{{}, {}, {}}
	accumulator := list.SharedListUnitNil
	var listUnitCells alloc.Cells[list.ListUnit]
	for index := len(array) - 1; index >= 0; index-- {
		unit := array[index]
		accumulator = listUnitCells.New(list.ListUnit{Cons0: unit, Cons1: accumulator})
	}
	var result int32
	result = -17
	return defaultedGo(func(x int32) int32 {
		return x
	}, accumulator)(result)
}

func defaultedGo(b func(int32) int32, value *list.ListUnit) func(int32) int32 {
	for {
		if value == list.SharedListUnitNil {
			return b
		}
		as := value.Cons1
		value = as
	}
}

func main() {
	fmt.Println(main_)
}
