// Control/Category/category.go
package category

func Identity(x int32) int32 {
	return x
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(i int32) string {
	return prim.ShowInt(i)
}

func Show2(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Show"
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return []string{"x" + prim.ShowInt(2), pairs, joined, prim.ShowArray(show.Show2, mainGo(show.Show, 3, []string{})) + prim.ShowArray(show.Show, mainGo2(category.Identity, 3, []int32{}))}
}

var pairs = initializePairs()

func initializePairs() string {
	defer exception.ReportUncaught()
	return "true" + prim.ShowInt(pairsF(pairsF(1)))
}

var joined = initializeJoined()

func initializeJoined() string {
	defer exception.ReportUncaught()
	return "<" + prim.ShowInt(3) + "><" + prim.ShowString("y") + ">"
}

func mainGo(f func(int32) string, n int32, accumulated []string) []string {
	accumulated = slices.Clip(accumulated)
	for {
		if n <= 0 {
			return accumulated
		}
		n, accumulated = n - 1, array.Bounded(append(accumulated, f(n)))
	}
}

func mainGo2(f func(int32) int32, n int32, accumulated []int32) []int32 {
	accumulated = slices.Clip(accumulated)
	for {
		if n <= 0 {
			return accumulated
		}
		n, accumulated = n - 1, array.Bounded(append(accumulated, f(n)))
	}
}

func pairsF(value int32) int32 {
	return value + 1
}

func main() {
	fmt.Println(main_)
}
