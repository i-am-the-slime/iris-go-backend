// Control/Category/category.go
package category

func Identity(x int32) int32 {
	return x
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int32) string {
	return strconv.Itoa(int(i))
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	text := show.AppendShowArrayString(nil, mainGo(show.ShowInt, 3, []string{}))
	text = show.AppendShowArrayInt(text, mainGo2(category.Identity, 3, []int32{}))
	return []string{"x2", pairs, joined, string(text)}
}

var pairs = initializePairs()

func initializePairs() string {
	return "true" + strconv.Itoa(int(pairsF(pairsF(1))))
}

var joined = initializeJoined()

func initializeJoined() string {
	return "<3><" + prim.ShowString("y") + ">"
}

func mainGo(f func(int32) string, n int32, accumulated []string) []string {
	accumulated = slices.Clip(accumulated)
	for {
		if n <= 0 {
			return accumulated
		}
		n, accumulated = n-1, array.Bounded(append(accumulated, f(n)))
	}
}

func mainGo2(f func(int32) int32, n int32, accumulated []int32) []int32 {
	accumulated = slices.Clip(accumulated)
	for {
		if n <= 0 {
			return accumulated
		}
		n, accumulated = n-1, array.Bounded(append(accumulated, f(n)))
	}
}

func pairsF(value int32) int32 {
	return value + 1
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
