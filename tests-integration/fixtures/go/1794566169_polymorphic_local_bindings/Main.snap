// Control/Category/category.go
package category

func Identity(x int32) int32 {
	return x
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(argument0 int32) string {
	return prim.ShowInt(argument0)
}

func Show2(argument0 string) string {
	return prim.ShowString(argument0)
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Show"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
	"slices"
)

var main_ []string = []string{"x" + prim.ShowInt(2), pairs, joined, prim.ShowArray(show.Show2, mainGo(show.Show, 3, []string{})) + prim.ShowArray(show.Show, mainGo2(category.Identity, 3, []int32{}))}

var pairs string = "true" + prim.ShowInt(pairsF(pairsF(1)))

var joined string = "<" + prim.ShowInt(3) + "><" + prim.ShowString("y") + ">"

func mainGo(f func(int32) string, n int32, accumulated []string) []string {
	accumulated = slices.Clip(accumulated)
	for {
		if n <= 0 {
			return accumulated
		}
		n, accumulated = n - 1, append(accumulated, f(n))
	}
}

func mainGo2(f func(int32) int32, n int32, accumulated []int32) []int32 {
	accumulated = slices.Clip(accumulated)
	for {
		if n <= 0 {
			return accumulated
		}
		n, accumulated = n - 1, append(accumulated, f(n))
	}
}

func pairsF(value int32) int32 {
	return value + 1
}

func main() {
	fmt.Println(main_)
}
