// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func ArrayInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Nested struct {
	Flat any
	Nest *Nested
	Tag  uint8
}

const (
	NestedFlat = iota
	NestedNest
)

var main_ = initializeMain_()

func initializeMain_() []string {
	text := []byte("Nest ")
	text = appendShowNestedArrayInt(text, shared.Show{Show: func(coerced any) string {
		return show.ArrayInt(shared.Convert(coerced))
	}}, &Nested{Tag: NestedNest, Nest: &Nested{Tag: NestedFlat, Flat: shared.Convert2([][]int32{{1, 2}, {3}})}})
	return []string{"1", string(text)}
}

func showNestedArrayInt(showDictionary shared.Show, nested *Nested) string {
	return string(appendShowNestedArrayInt(nil, showDictionary, nested))
}

func appendShowNestedArrayInt(buffer []byte, showDictionary shared.Show, nested *Nested) []byte {
	switch nested.Tag {
	case NestedFlat:
		buffer = prim.AppendString(buffer, showDictionary.Show(nested.Flat))
	default: // NestedNest
		buffer = append(buffer, "Nest "...)
		buffer = appendShowNestedArrayInt(buffer, shared.Show{Show: func(coerced any) string {
			return prim.ShowArray(showDictionary.Show, coerced.([]any))
		}}, nested.Nest)
	}
	return buffer
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value any) []int32 {
	array := value.([]any)
	converted := make([]int32, len(array))
	for index, element := range array {
		converted[index] = element.(int32)
	}
	return converted
}

type Show struct {
	Show func(any) string
}

func Convert2(value [][]int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = Convert3(element)
	}
	return converted
}

func Convert3(value []int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}
