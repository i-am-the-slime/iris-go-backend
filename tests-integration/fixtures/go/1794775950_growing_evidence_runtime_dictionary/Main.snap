// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func ShowInt(array []int32) string {
	return prim.ShowArray(Show, array)
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Nested struct {
	Flat any
	Nest *Nested
	Tag  uint8
}

const (
	NestedFlat = iota
	NestedNest
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return []string{"1", "Nest " + showNestedArrayInt(shared.Show{Show: func(coerced any) string {
		return show.ShowInt(shared.Convert(coerced))
	}}, &Nested{Tag: NestedNest, Nest: &Nested{Tag: NestedFlat, Flat: shared.Convert2([][]int32{{1, 2}, {3}})}})}
}

func showNestedArrayInt(showDictionary shared.Show, nested *Nested) string {
	switch nested.Tag {
	case NestedFlat:
		return showDictionary.Show(nested.Flat)
	default: // NestedNest
		return "Nest " + showNestedArrayInt(shared.Show{Show: func(coerced any) string {
			return prim.ShowArray(showDictionary.Show, coerced.([]any))
		}}, nested.Nest)
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value any) []int32 {
	array := value.([]any)
	converted := make([]int32, len(array))
	for index, element := range array {
		converted[index] = element.(int32)
	}
	return converted
}

type Show struct {
	Show func(any) string
}

func Convert2(value [][]int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = Convert3(element)
	}
	return converted
}

func Convert3(value []int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}
