// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	datashow "fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Nested struct {
	Flat any
	Nest *Nested
	Tag  uint8
}

const (
	NestedFlat = iota
	NestedNest
)

var main_ = initializeMain_()

func initializeMain_() []string {
	text := []byte("Nest ")
	text = appendShowNestedShowDictionaryNest(text, func(coerced any) string {
		return datashow.ArrayInt(shared.Convert(coerced))
	}, &Nested{Tag: NestedFlat, Flat: shared.Convert2([][]int32{{1, 2}, {3}})})
	return []string{"1", string(text)}
}

func showNestedShowDictionary(show func(any) string, nested *Nested) string {
	return string(appendShowNestedShowDictionary(nil, show, nested))
}

func showNestedShowDictionaryNest(show func(any) string, inner *Nested) string {
	return string(appendShowNestedShowDictionaryNest(nil, show, inner))
}

func appendShowNestedShowDictionary(buffer []byte, show func(any) string, nested *Nested) []byte {
	switch nested.Tag {
	case NestedFlat:
		buffer = prim.AppendString(buffer, show(nested.Flat))
	default: // NestedNest
		buffer = append(buffer, "Nest "...)
		buffer = appendShowNestedShowDictionary(buffer, func(coerced any) string {
			return prim.ShowArray(show, coerced.([]any))
		}, nested.Nest)
	}
	return buffer
}

func appendShowNestedShowDictionaryNest(buffer []byte, show func(any) string, inner *Nested) []byte {
	buffer = append(buffer, "Nest "...)
	buffer = appendShowNestedShowDictionary(buffer, func(coerced any) string {
		return prim.ShowArray(show, coerced.([]any))
	}, inner)
	return buffer
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value any) []int32 {
	array := value.([]any)
	converted := make([]int32, len(array))
	for index, element := range array {
		converted[index] = element.(int32)
	}
	return converted
}

func Convert2(value [][]int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = Convert3(element)
	}
	return converted
}

func Convert3(value []int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}

// note: Main.showNested takes its Show dictionary at run time, because polymorphic recursion reaches it at ever larger types; only this definition is slower
