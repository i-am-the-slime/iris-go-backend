// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

func AppendShowArrayOrdering(buffer []byte, array []Ordering) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowOrdering(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowOrdering(buffer []byte, ordering Ordering) []byte {
	switch ordering {
	case OrderingLT:
		buffer = append(buffer, "LT"...)
	case OrderingGT:
		buffer = append(buffer, "GT"...)
	default: // OrderingEQ
		buffer = append(buffer, "EQ"...)
	}
	return buffer
}

func ArrayOrdering(array []Ordering) string {
	return string(AppendShowArrayOrdering(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{ordering.ArrayOrdering([]ordering.Ordering{ordering.OrderingLT, ordering.OrderingEQ, ordering.OrderingGT}), "GT", "true"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
