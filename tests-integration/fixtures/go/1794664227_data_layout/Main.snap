// main.go
package main

import "fixture/shared"

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int32
	Tag    uint8
}

const (
	ExprVal = iota
	ExprAdd
	ExprMul
	ExprSub
)

func Val(val int) *Expr {
	return &Expr{Tag: ExprVal, Val: int32(val)}
}

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	exprs := make([]Expr, 5)
	exprs[0] = Expr{Tag: ExprSub, Field0: &exprs[1], Field1: &exprs[4]}
	exprs[1] = Expr{Tag: ExprMul, Field0: &exprs[2], Field1: &exprs[3]}
	exprs[2] = Expr{Tag: ExprVal, Val: 2}
	exprs[3] = Expr{Tag: ExprVal, Val: 3}
	exprs[4] = Expr{Tag: ExprVal, Val: 4}
	return shared.MainResult{Expression: evaluateAdd(Val(1), &exprs[0]), Shapes: []string{"circle 1.0", "square 2.0", "label atrue", "caption bfalse", "point"}, Items: []int{0, 3, 12}, Colours: []string{"red", "green", "blue"}, Sample: "strue0.53"}
}

func evaluate(expr *Expr) int {
	switch expr.Tag {
	case ExprVal:
		return int(expr.Val)
	case ExprAdd:
		return evaluate(expr.Field0) + evaluate(expr.Field1)
	case ExprMul:
		return evaluate(expr.Field0) * evaluate(expr.Field1)
	default: // ExprSub
		return evaluate(expr.Field0) - evaluate(expr.Field1)
	}
}

func evaluateAdd(left *Expr, right *Expr) int {
	return evaluate(left) + evaluate(right)
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Colours    []string
	Items      []int
	Sample     string
	Shapes     []string
	Expression int
}

// note: the entry's value of type { colours, expression, items, sample, shapes } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
