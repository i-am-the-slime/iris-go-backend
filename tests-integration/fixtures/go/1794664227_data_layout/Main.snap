// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int32
	Tag    uint8
}

const (
	ExprVal = iota
	ExprAdd
	ExprMul
	ExprSub
)

type Shape struct {
	FieldB0 string
	FieldA0 float64
	Tag     uint8
	FieldB1 bool
}

const (
	ShapeCircle = iota
	ShapeSquare
	ShapeLabel
	ShapeCaption
	ShapePoint
)

type Item struct {
	Field  string
	Field0 int32
	Field1 int32
	Tag    uint8
}

const (
	ItemField = iota
	ItemPair
	ItemCouple
)

type Colour uint8

const (
	ColourRed Colour = iota
	ColourGreen
	ColourBlue
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	array := []Shape{{Tag: ShapeCircle, FieldA0: 1.0}, {Tag: ShapeSquare, FieldA0: 2.0}, {Tag: ShapeLabel, FieldB0: "a", FieldB1: true}, {Tag: ShapeCaption, FieldB0: "b", FieldB1: false}, {Tag: ShapePoint}}
	mapped := make([]string, len(array))
	for index, element := range array {
		mapped[index] = describe(element)
	}
	array2 := []Item{{Tag: ItemField, Field: "x"}, {Tag: ItemPair, Field0: 1, Field1: 2}, {Tag: ItemCouple, Field0: 3, Field1: 4}}
	mapped2 := make([]int32, len(array2))
	for index, element := range array2 {
		mapped2[index] = itemTotal(element)
	}
	array3 := []Colour{ColourRed, ColourGreen, ColourBlue}
	mapped3 := make([]string, len(array3))
	for index, element := range array3 {
		mapped3[index] = colourName(element)
	}
	exprs := make([]Expr, 7)
	exprs[0] = Expr{Tag: ExprAdd, Field0: &exprs[1], Field1: &exprs[2]}
	exprs[1] = Expr{Tag: ExprVal, Val: 1}
	exprs[2] = Expr{Tag: ExprSub, Field0: &exprs[3], Field1: &exprs[6]}
	exprs[3] = Expr{Tag: ExprMul, Field0: &exprs[4], Field1: &exprs[5]}
	exprs[4] = Expr{Tag: ExprVal, Val: 2}
	exprs[5] = Expr{Tag: ExprVal, Val: 3}
	exprs[6] = Expr{Tag: ExprVal, Val: 4}
	return shared.MainResult{Expression: evaluate(&exprs[0]), Shapes: mapped, Items: mapped2, Colours: mapped3, Sample: "strue" + prim.ShowNumber(0.5) + "3"}
}

func evaluate(expr *Expr) int32 {
	switch expr.Tag {
	case ExprVal:
		return expr.Val
	case ExprAdd:
		return evaluate(expr.Field0) + evaluate(expr.Field1)
	case ExprMul:
		return evaluate(expr.Field0) * evaluate(expr.Field1)
	default: // ExprSub
		return evaluate(expr.Field0) - evaluate(expr.Field1)
	}
}

func describe(shape Shape) string {
	switch shape.Tag {
	case ShapeCircle:
		return "circle " + prim.ShowNumber(shape.FieldA0)
	case ShapeSquare:
		return "square " + prim.ShowNumber(shape.FieldA0)
	case ShapeLabel:
		return "label " + shape.FieldB0 + strconv.FormatBool(shape.FieldB1)
	case ShapeCaption:
		return "caption " + shape.FieldB0 + strconv.FormatBool(shape.FieldB1)
	default: // ShapePoint
		return "point"
	}
}

func itemTotal(item Item) int32 {
	switch item.Tag {
	case ItemField:
		return 0
	case ItemPair:
		return item.Field0 + item.Field1
	default: // ItemCouple
		return item.Field0 * item.Field1
	}
}

func colourName(colour Colour) string {
	switch colour {
	case ColourRed:
		return "red"
	case ColourGreen:
		return "green"
	default: // ColourBlue
		return "blue"
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	Colours    []string
	Items      []int32
	Sample     string
	Shapes     []string
	Expression int32
}
