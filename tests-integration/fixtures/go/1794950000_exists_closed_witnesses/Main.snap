// Control/Category/category.go
package category

func Identity(x string) string {
	return x
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int32) string {
	return strconv.Itoa(int(i))
}

func ShowNumber(number float64) string {
	return prim.ShowNumber(number)
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func ArrayNumber(array []float64) string {
	return string(AppendShowArrayNumber(nil, array))
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type DescribedInt struct {
	Second func(int32) string
	Third  func(int32) int32
	First  int32
}

type DescribedString struct {
	First  string
	Second func(string) string
	Third  func(string) string
}

type DescribedArrayNumber struct {
	First  []float64
	Second func([]float64) string
	Third  func([]float64) []float64
}

type ExistsDescribed struct {
	Int         DescribedInt
	String      DescribedString
	ArrayNumber DescribedArrayNumber
	Tag         uint8
}

const (
	ExistsDescribedInt = iota
	ExistsDescribedString
	ExistsDescribedArrayNumber
)

var main_ = initializeMain_()

func initializeMain_() []string {
	mapped := make([]string, len(things))
	for index := range things {
		var result string
		switch things[index].Tag {
		case ExistsDescribedInt:
			result = things[index].Int.Second(things[index].Int.Third(things[index].Int.First))
		case ExistsDescribedString:
			result = things[index].String.Second(things[index].String.Third(things[index].String.First))
		default: // ExistsDescribedArrayNumber
			result = things[index].ArrayNumber.Second(things[index].ArrayNumber.Third(things[index].ArrayNumber.First))
		}
		var result2 string
		switch things[index].Tag {
		case ExistsDescribedInt:
			value := things[index].Int.First
			describe := things[index].Int.Second
			result2 = prim.Append(describe(value), describe(things[index].Int.Third(value)))
		case ExistsDescribedString:
			value := things[index].String.First
			describe := things[index].String.Second
			result2 = prim.Append(describe(value), describe(things[index].String.Third(value)))
		default: // ExistsDescribedArrayNumber
			value := things[index].ArrayNumber.First
			describe := things[index].ArrayNumber.Second
			result2 = prim.Append(describe(value), describe(things[index].ArrayNumber.Third(value)))
		}
		mapped[index] = prim.Append(result, result2)
	}
	return mapped
}

var things []ExistsDescribed = []ExistsDescribed{{Tag: ExistsDescribedInt, Int: DescribedInt{First: 1, Second: show.ShowInt, Third: func(value int32) int32 {
	return value + 1
}}}, {Tag: ExistsDescribedString, String: DescribedString{First: "a", Second: category.Identity, Third: func(value string) string {
	return value + "!"
}}}, {Tag: ExistsDescribedArrayNumber, ArrayNumber: DescribedArrayNumber{First: []float64{1.5}, Second: show.ArrayNumber, Third: func(array []float64) []float64 {
	return mapLanes(array)
}}}}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func mapLanes(xs []float64) []float64 {
	c0 := archsimd.BroadcastFloat64x2(2.0)
	out := make([]float64, len(xs))
	const step = 2
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadFloat64x2(xs[i : i+step])
		x.Mul(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadFloat64x2Part(xs[i:])
		x.Mul(c0).StorePart(out[i:])
	}
	return out
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func mapLanes(xs []float64) []float64 {
	out := make([]float64, len(xs))
	for i, x := range xs {
		out[i] = x * 2.0
	}
	return out
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func mapLanes(xs []float64) []float64 {
	c0 := simd.BroadcastFloat64s(2.0)
	out := make([]float64, len(xs))
	step := simd.Float64s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadFloat64s(xs[i : i+step])
		x.Mul(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadFloat64sPart(xs[i:])
		x.Mul(c0).StorePart(out[i:])
	}
	return out
}
