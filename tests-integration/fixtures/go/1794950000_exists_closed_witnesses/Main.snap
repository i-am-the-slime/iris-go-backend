// Control/Category/category.go
package category

func Identity(x string) string {
	return x
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(i int32) string {
	return prim.ShowInt(i)
}

func ShowNumber(array []float64) string {
	return prim.ShowArray(Show2, array)
}

func Show2(number float64) string {
	return prim.ShowNumber(number)
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Show"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type DescribedInt struct {
	Second func(int32) string
	Third  func(int32) int32
	First  int32
}

type DescribedString struct {
	First  string
	Second func(string) string
	Third  func(string) string
}

type DescribedArrayNumber struct {
	First  []float64
	Second func([]float64) string
	Third  func([]float64) []float64
}

type ExistsDescribed struct {
	Int         DescribedInt
	String      DescribedString
	ArrayNumber DescribedArrayNumber
	Tag         uint8
}

const (
	ExistsDescribedInt = iota
	ExistsDescribedString
	ExistsDescribedArrayNumber
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	mapped := make([]string, len(things))
	for index := range things {
		var result string
		switch things[index].Tag {
		case ExistsDescribedInt:
			result = things[index].Int.Second(things[index].Int.Third(things[index].Int.First))
		case ExistsDescribedString:
			result = things[index].String.Second(things[index].String.Third(things[index].String.First))
		default: // ExistsDescribedArrayNumber
			result = things[index].ArrayNumber.Second(things[index].ArrayNumber.Third(things[index].ArrayNumber.First))
		}
		var result2 string
		switch things[index].Tag {
		case ExistsDescribedInt:
			value := things[index].Int.First
			describe := things[index].Int.Second
			result2 = prim.Append(describe(value), describe(things[index].Int.Third(value)))
		case ExistsDescribedString:
			value := things[index].String.First
			describe := things[index].String.Second
			result2 = prim.Append(describe(value), describe(things[index].String.Third(value)))
		default: // ExistsDescribedArrayNumber
			value := things[index].ArrayNumber.First
			describe := things[index].ArrayNumber.Second
			result2 = prim.Append(describe(value), describe(things[index].ArrayNumber.Third(value)))
		}
		mapped[index] = prim.Append(result, result2)
	}
	return mapped
}

var things []ExistsDescribed = []ExistsDescribed{ExistsDescribed{Tag: ExistsDescribedInt, Int: DescribedInt{First: 1, Second: show.Show, Third: func(value int32) int32 {
	return value + 1
}}}, ExistsDescribed{Tag: ExistsDescribedString, String: DescribedString{First: "a", Second: category.Identity, Third: func(value string) string {
	return value + "!"
}}}, ExistsDescribed{Tag: ExistsDescribedArrayNumber, ArrayNumber: DescribedArrayNumber{First: []float64{1.5}, Second: show.ShowNumber, Third: func(array []float64) []float64 {
	mapped := make([]float64, len(array))
	for index, value := range array {
		mapped[index] = float64(value * 2.0)
	}
	return mapped
}}}}

func main() {
	fmt.Println(main_)
}
