// Foreign/foreign.go
package foreign

type ForeignError struct {
	ForeignError     string
	TypeMismatch0    string
	TypeMismatch1    string
	ErrorAtIndex1    *ForeignError
	ErrorAtProperty0 string
	ErrorAtProperty1 *ForeignError
	ErrorAtIndex0    int32
	Tag              uint8
}

const (
	ForeignErrorForeignError = iota
	ForeignErrorTypeMismatch
	ForeignErrorErrorAtIndex
	ForeignErrorErrorAtProperty
)

type ListForeignError struct {
	Cons0 *ForeignError
	Cons1 *ListForeignError
}

var SharedListForeignErrorNil = &ListForeignError{}

type NonEmptyListForeignError struct {
	First  *ForeignError
	Second *ListForeignError
}

type EitherNonEmptyListForeignErrorForeign struct {
	Left  NonEmptyListForeignError
	Right any
	Tag   uint8
}

const (
	EitherNonEmptyListForeignErrorForeignLeft = iota
	EitherNonEmptyListForeignErrorForeignRight
)

func TypeMismatch(typeMismatch0 string, typeMismatch1 string) *ForeignError {
	return &ForeignError{Tag: ForeignErrorTypeMismatch, TypeMismatch0: typeMismatch0, TypeMismatch1: typeMismatch1}
}

func Left(left NonEmptyListForeignError) EitherNonEmptyListForeignErrorForeign {
	return EitherNonEmptyListForeignErrorForeign{Tag: EitherNonEmptyListForeignErrorForeignLeft, Left: left}
}

func PureIdentityNonEmptyListForeignError(x any) EitherNonEmptyListForeignErrorForeign {
	return EitherNonEmptyListForeignErrorForeign{Tag: EitherNonEmptyListForeignErrorForeignRight, Right: x}
}

// main.go
package main

import (
	"fixture/Foreign"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
)

func main() {
	value := direct.ForeignRecord([]string{"name"}, []any{"iris"})
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
		return foreign.Left(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(value)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.PureIdentityNonEmptyListForeignError, "name", value)
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherNonEmptyListForeignErrorForeignLeft:
		panic(exception.NewError("reading a present property fails"))
	default: // foreign.EitherNonEmptyListForeignErrorForeignRight
	}
}
