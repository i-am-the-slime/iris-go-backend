// Foreign/foreign.go
package foreign

type ForeignError struct {
	Field0           string
	Field1           string
	ErrorAtIndex1    *ForeignError
	ErrorAtProperty0 string
	ErrorAtProperty1 *ForeignError
	ErrorAtIndex0    int32
	Tag              uint8
}

const (
	ForeignErrorForeignError = iota
	ForeignErrorTypeMismatch
	ForeignErrorErrorAtIndex
	ForeignErrorErrorAtProperty
)

type List struct {
	Cons0 *ForeignError
	Cons1 *List
}

var SharedListNil = &List{}

type NonEmpty struct {
	First  *ForeignError
	Second *List
}

type Either struct {
	Left  NonEmpty
	Right any
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func TypeMismatch(field0 string, field1 string) *ForeignError {
	return &ForeignError{Tag: ForeignErrorTypeMismatch, Field0: field0, Field1: field1}
}

func Left(left NonEmpty) Either {
	return Either{Tag: EitherLeft, Left: left}
}

func Pure(x any) Either {
	return Either{Tag: EitherRight, Right: x}
}

// main.go
package main

import (
	"fixture/Foreign"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
)

func main() {
	value := direct.ForeignRecord([]string{"name"}, []any{"iris"})
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.Either {
		return foreign.Left(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(value)), Second: foreign.SharedListNil})
	}, foreign.Pure, "name", value)
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherLeft:
		panic(exception.NewError("reading a present property fails"))
	default: // foreign.EitherRight
	}
}
