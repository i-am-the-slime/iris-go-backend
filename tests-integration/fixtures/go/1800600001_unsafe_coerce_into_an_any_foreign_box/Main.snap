// Data/Maybe/maybe.go
package maybe

import boxes "fixture/Boxes_ffi"

const TagNothing = 0

const TagJust = 1

type Box struct {
	Just boxes.Box
	Tag  uint8
}

func JustBox(just boxes.Box) Box {
	return Box{Tag: TagJust, Just: just}
}

var NoBox = Box{Tag: TagNothing}

// main.go
package main

import (
	boxes "fixture/Boxes_ffi"
	"fixture/Data/Maybe"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"strconv"
)

func main() {
	original := shared.Name{Name: "first"}
	table := make(map[int]boxes.Box)
	table[1] = direct.ForeignRecord([]string{"name"}, []any{original.Name})
	table[2] = int(42)
	original2 := shared.Name{Name: "boxed"}
	cell := direct.ForeignRecord([]string{"name"}, []any{original2.Name})
	journal.Log((shared.Name{Name: direct.ForeignField(cell, "name").(string)}).Name)
	value, found := table[1]
	var entry maybe.Box
	if found {
		entry = maybe.JustBox(value)
	} else {
		entry = maybe.NoBox
	}
	var result string
	switch entry.Tag {
	case maybe.TagNothing:
		result = "missing"
	default: // maybe.TagJust
		result = (shared.Name{Name: direct.ForeignField(entry.Just, "name").(string)}).Name
	}
	journal.Log(result)
	value2, found2 := table[2]
	var entry2 maybe.Box
	if found2 {
		entry2 = maybe.JustBox(value2)
	} else {
		entry2 = maybe.NoBox
	}
	var result2 int
	switch entry2.Tag {
	case maybe.TagJust:
		result2 = foreignvalue.Int(entry2.Just)
	default:
		result2 = 0
	}
	journal.Log(strconv.Itoa(result2))
}

// shared/shared.go
package shared

type Name struct {
	Name string
}

type Ref[T any] struct {
	Value T
}
