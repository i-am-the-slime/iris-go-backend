func AdjustMilliseconds(d float64, dt DateTime) MaybeDateTime {
	d2 := dt.First
	t := dt.Second
	var result int32
	switch d2.Second {
	case component.MonthJanuary:
		result = 1
	case component.MonthFebruary:
		result = 2
	case component.MonthMarch:
