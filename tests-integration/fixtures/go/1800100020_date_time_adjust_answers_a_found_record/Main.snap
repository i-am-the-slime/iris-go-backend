}

func AdjustJoin(n int32, x component.Month) func(int32) date.MaybeDate {
	return func(d int32) date.MaybeDate {
		dt := date.Date{First: n, Second: x, Third: d}
		scrutinee := date.CanonicalDate(n, x, d)
		var result bool
		if scrutinee.First == dt.First {
			if scrutinee.Second == dt.Second {
				result = scrutinee.Third == dt.Third
			} else {
				result = false
			}
		} else {
			result = false
		}
		if result {
			return date.JustDate(dt)
		}
		return date.NoDate
	}
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

// Data/Time/time.go
package time

type Time struct {
	First  int32
	Second int32
	Third  int32
	Fourth int32
}

// main.go
package main

import (
	"fixture/Data/Date"
	"fixture/Data/Date/Component"
	datadatetime "fixture/Data/DateTime"
	"fixture/Data/Maybe"
	"fixture/Data/Time"
	journal "fixture/Journal_ffi"
)

func main() {
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(1.0, newYear)))
	journal.Log(datadatetime.Show(datadatetime.AdjustHours(24.5, newYear)))
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(-1.0, dateTime(2024, 3, 1, 0, 0, 0, 0))))
	journal.Log(datadatetime.Show(datadatetime.AdjustMinutes(-1.0, dateTime(2000, 1, 1, 0, 0, 0, 0))))
	journal.Log(datadatetime.Show(datadatetime.AdjustMilliseconds(1.7, dateTime(2000, 1, 1, 0, 0, 0, 999))))
	journal.Log(datadatetime.Show(datadatetime.AdjustMilliseconds(-0.5, dateTime(2000, 1, 1, 0, 0, 0, 0))))
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(365.0, dateTime(50, 6, 15, 12, 30, 0, 0))))
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(-20000.0, dateTime(1970, 1, 1, 0, 0, 0, 0))))
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(1.0e9, newYear)))
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(-1000000000.0, newYear)))
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(1.0, dateTime(275759, 12, 31, 0, 0, 0, 0))))
	journal.Log(datadatetime.Show(datadatetime.AdjustDays(-1.0, dateTime(-271820, 1, 1, 0, 0, 0, 0))))
	scrutinee := datadatetime.AdjustMilliseconds(0.0, newYear)
	var result string
	switch scrutinee.Tag {
	case maybe.TagNothing:
		result = "false"
	default: // maybe.TagJust
		result = "true"
	}
	journal.Log(result)
}

var newYear = initializeNewYear()

func initializeNewYear() datadatetime.DateTime {
	return dateTime(2026, 12, 31, 0, 0, 0, 0)
}

func dateTime(y int32, mo int32, d int32, h int32, mi int32, s int32, ms int32) datadatetime.DateTime {
	var result int32
	if y >= -271820 && y <= 275759 {
		result = y
	} else {
		panic("Failed pattern match")
	}
	var result2 component.MaybeMonth
	switch mo {
	case 1:
		result2 = component.JustMonth(component.MonthJanuary)
	case 2:
		result2 = component.JustMonth(component.MonthFebruary)
	case 3:
		result2 = component.JustMonth(component.MonthMarch)
	case 4:
		result2 = component.JustMonth(component.MonthApril)
	case 5:
		result2 = component.JustMonth(component.MonthMay)
	case 6:
		result2 = component.JustMonth(component.MonthJune)
	case 7:
		result2 = component.JustMonth(component.MonthJuly)
	case 8:
		result2 = component.JustMonth(component.MonthAugust)
	case 9:
		result2 = component.JustMonth(component.MonthSeptember)
	case 10:
		result2 = component.JustMonth(component.MonthOctober)
	case 11:
		result2 = component.JustMonth(component.MonthNovember)
	case 12:
		result2 = component.JustMonth(component.MonthDecember)
	default:
		result2 = component.NoMonth
	}
	var result3 int32
	if d >= 1 && d <= 31 {
		result3 = d
	} else {
		panic("Failed pattern match")
	}
	var result4 int32
	if h >= 0 && h <= 23 {
		result4 = h
	} else {
		panic("Failed pattern match")
	}
	var result5 int32
	if mi >= 0 && mi <= 59 {
		result5 = mi
	} else {
		panic("Failed pattern match")
	}
	var result6 int32
	if s >= 0 && s <= 59 {
		result6 = s
	} else {
		panic("Failed pattern match")
	}
	var result7 int32
	if ms >= 0 && ms <= 999 {
		result7 = ms
	} else {
		panic("Failed pattern match")
	}
	return datadatetime.DateTime{First: date.CanonicalDate(result, component.FromJust(result2), result3), Second: time.Time{First: result4, Second: result5, Third: result6, Fourth: result7}}
}
