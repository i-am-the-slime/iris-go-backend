// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	union := shared.AZ{A: 1, Z: 'z'}
	record := shared.Defaults{A: "shadowed", Z: 'y'}
	record2 := shared.ABZ{A: "shadowed", Z: 'z', B: true}
	return []string{strconv.Itoa(union.A) + " " + prim.ShowChar(union.Z), "{ a: " + strconv.Itoa(built.A) + ", z: " + prim.ShowChar(built.Z) + " }", "{ a: " + strconv.Itoa(merged.A) + ", z: " + prim.ShowChar(merged.Z) + " }", "{ a: " + prim.ShowString(flipped.A) + ", z: " + prim.ShowChar(flipped.Z) + " }", "{ a: " + prim.ShowString(record.A) + ", z: " + prim.ShowChar(record.Z) + " }", "{ a: " + prim.ShowString(record2.A) + ", b: " + strconv.FormatBool(record2.B) + ", z: " + prim.ShowChar(record2.Z) + " }"}
}

var built shared.AZ = shared.AZ{A: 2, Z: 'z'}

var merged shared.AZ = shared.AZ{A: 3, Z: 'z'}

var flipped shared.Defaults = shared.Defaults{A: "shadowed", Z: 'z'}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type AZ struct {
	A int
	Z rune
}

type Defaults struct {
	A string
	Z rune
}

type ABZ struct {
	A string
	Z rune
	B bool
}
