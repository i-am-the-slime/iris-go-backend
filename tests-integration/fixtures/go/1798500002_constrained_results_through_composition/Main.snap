// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"strconv"
)

func main_() []string {
	constant := maybe.JustInt(20)
	var result string
	switch constant.Tag {
	case maybe.TagJust:
		result = "(Just " + strconv.Itoa(constant.Just) + ")"
	default: // maybe.TagNothing
		result = "Nothing"
	}
	return []string{"(Just 20)", "Nothing", "(Just 10)", result}
}

func main() {
	main_()
}
