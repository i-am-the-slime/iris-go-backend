// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	"fixture/Data/Maybe"
	"strconv"
)

func main_() []string {
	constant := maybe.Int(20)
	var result string
	if constant != maybe.NoInt {
		result = "(Just " + strconv.Itoa(int(int32(constant))) + ")"
	} else {
		result = "Nothing"
	}
	return []string{"(Just 20)", "Nothing", "(Just 10)", result}
}

func main() {
	main_()
}
