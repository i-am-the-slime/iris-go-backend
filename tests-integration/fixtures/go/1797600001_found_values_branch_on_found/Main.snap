// Data/Maybe/maybe.go
package maybe

import "github.com/i-am-the-slime/iris-go/prim"

type Char int64

const NoChar Char = 1 << 32

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func AppendShowArrayMaybeChar(buffer []byte, array []Char) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowMaybeChar(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowMaybeChar(buffer []byte, maybe Char) []byte {
	if maybe != NoChar {
		buffer = append(buffer, "(Just "...)
		buffer = prim.AppendShowChar(buffer, rune(maybe))
		buffer = append(buffer, ')')
	} else {
		buffer = append(buffer, "Nothing"...)
	}
	return buffer
}

func ArrayMaybeChar(array []Char) string {
	return string(AppendShowArrayMaybeChar(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/object"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	result, found := prim.CodeUnitCharAt(0, "plum")
	if !found {
		result = '?'
	}
	result2, found2 := prim.CodeUnitCharAt(0, "")
	if !found2 {
		result2 = '?'
	}
	at, found3 := prim.CodeUnitIndexOf("b", "abc")
	var result3 string
	if found3 {
		result3 = "b at " + strconv.Itoa(at)
	} else {
		result3 = "no b"
	}
	at2, found4 := prim.CodeUnitIndexOf("b", "xyz")
	var result4 string
	if found4 {
		result4 = "b at " + strconv.Itoa(at2)
	} else {
		result4 = "no b"
	}
	result5, found5 := object.Lookup("pear", prices)
	if !found5 {
		result5 = 0
	}
	result6, found6 := object.Lookup("fig", prices)
	if !found6 {
		result6 = 0
	}
	_, found7 := object.Lookup("apple", prices)
	_, found8 := object.Lookup("fig", prices)
	number, found9 := prim.IntFromStringAs(10, "21")
	var result7 int
	if found9 {
		result7 = number * 2
	} else {
		result7 = -1
	}
	number2, found10 := prim.IntFromStringAs(10, "x")
	var result8 int
	if found10 {
		result8 = number2 * 2
	} else {
		result8 = -1
	}
	array := []string{"ab", "c"}
	mapped := make([]maybe.Char, len(array))
	for index, s := range array {
		value, found11 := prim.CodeUnitCharAt(1, s)
		var codeUnitCharAt maybe.Char
		if found11 {
			codeUnitCharAt = maybe.Char(value)
		} else {
			codeUnitCharAt = maybe.NoChar
		}
		mapped[index] = codeUnitCharAt
	}
	return []string{prim.ShowChar(result), prim.ShowChar(result2), result3, result4, strconv.Itoa(result5), strconv.Itoa(result6), strconv.FormatBool(found7), strconv.FormatBool(found8), strconv.Itoa(result7), strconv.Itoa(result8), maybe.ArrayMaybeChar(mapped)}
}

var prices = initializePrices()

func initializePrices() *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int
} {
	return object.FromEntries([]string{"apple", "pear"}, []int{3, 5})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
