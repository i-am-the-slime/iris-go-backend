// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

type Reader struct {
	Reader *Reader
	N      int32
	Tag    uint8
}

const (
	ReaderMain = iota
	ReaderPlus
)

var sharedReaderMain = &Reader{Tag: ReaderMain}

var main_ = initializeMain_()

func initializeMain_() int32 {
	defer exception.ReportUncaught()
	return runReader(2, addAll(4, sharedReaderMain))
}

func addAll(n int32, reader *Reader) *Reader {
	var readerCells alloc.Cells[Reader]
	for {
		switch n {
		case 0:
			return reader
		default:
			n, reader = n-1, readerCells.New(Reader{Tag: ReaderPlus, N: n, Reader: reader})
			continue
		}
	}
}

func plus(n int32, reader *Reader, environment int32) int32 {
	for {
		if n > 100 {
			n -= 100
			continue
		}
		return runReader(environment, reader) + n*environment
	}
}

func runReader(environment int32, reader *Reader) int32 {
	switch reader.Tag {
	case ReaderMain:
		return environment
	default: // ReaderPlus
		return plus(reader.N, reader.Reader, environment)
	}
}

func main() {
	console.Print(prim.ShowInt(main_))
}
