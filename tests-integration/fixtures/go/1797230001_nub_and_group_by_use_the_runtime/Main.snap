// Data/Array/array.go
package dataarray

import (
	"fixture/Data/Ordering"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
)

func Nub(xs []float64) []float64 {
	mapped := make([]tuple.TupleNumber, len(xs))
	for slot, number := range xs {
		mapped[slot] = tuple.TupleNumber{First: slot, Second: number}
	}
	indexedAndSorted := direct.SortBy(mapped, func(x tuple.TupleNumber, y tuple.TupleNumber) int {
		number := x.Second
		number2 := y.Second
		var result ordering.Ordering
		if number < number2 {
			result = ordering.OrderingLT
		} else if number == number2 {
			result = ordering.OrderingEQ
		} else {
			result = ordering.OrderingGT
		}
		switch result {
		case ordering.OrderingLT:
			return -1
		case ordering.OrderingGT:
			return 1
		}
		return 0
	})
	if len(indexedAndSorted) > 0 {
		array2 := *arraypkg.UnsafeThaw([]tuple.TupleNumber{indexedAndSorted[0]})
		for _, pair := range indexedAndSorted {
			x_ := pair.Second
			array3 := shared.Frozen(array2)
			index := len(array3) - 1
			var result tuple.TupleNumber
			if index >= 0 && index < len(array3) {
				result = array3[index]
			} else {
				panic("Failed pattern match")
			}
			lst := result.Second
			if lst < x_ {
				array2 = append(array2, pair)
			} else if lst != x_ {
				array2 = append(array2, pair)
			}
		}
		performed := shared.Frozen(array2)
		array := shared.SortByKey(performed, func(x tuple.TupleNumber) int {
			return x.First
		})
		mapped2 := make([]float64, len(array))
		for index := range array {
			mapped2[index] = array[index].Second
		}
		return mapped2
	}
	return []float64{}
}

// Data/Eq/eq.go
package eq

func Eq(i int, i2 int) bool {
	return i == i2
}

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayArrayInt(buffer []byte, array [][]int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayBoolean(buffer []byte, array []bool) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendBool(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayChar(buffer []byte, array []rune) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowChar(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayArrayInt(array [][]int) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

func ArrayNumber(array []float64) string {
	return string(AppendShowArrayNumber(nil, array))
}

func ArrayBoolean(array []bool) string {
	return string(AppendShowArrayBoolean(nil, array))
}

func ArrayChar(array []rune) string {
	return string(AppendShowArrayChar(nil, array))
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// Data/Tuple/tuple.go
package tuple

type TupleInt struct {
	First  int
	Second int
}

type TupleNumber struct {
	Second float64
	First  int
}

// main.go
package main

import (
	"fixture/Data/Array"
	"fixture/Data/Eq"
	"fixture/Data/Ordering"
	"fixture/Data/Show"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main() {
	shown := &shared.Ref[string]{Value: ""}
	mainRecord(shown, show.ArrayInt(arraypkg.NubComparable([]int{3, 1, 3, 2, 1})))
	mainRecord(shown, show.ArrayString(arraypkg.NubComparable([]string{"b", "a", "b"})))
	mainRecord(shown, show.ArrayChar(arraypkg.NubComparable([]rune{'x', 'y', 'x'})))
	mainRecord(shown, show.ArrayBoolean(arraypkg.NubComparable([]bool{true, false, true})))
	mainRecord(shown, show.ArrayNumber(dataarray.Nub([]float64{1.5, 0.5, 1.5})))
	indexedAndSorted := shared.SortByKey([]tuple.TupleInt{{First: 0, Second: 1}, {First: 1, Second: 4}, {First: 2, Second: 2}, {First: 3, Second: 5}, {First: 4, Second: 3}}, func(x tuple.TupleInt) int {
		return prim.IntModPositive(x.Second, 3)
	})
	var result []int
	if len(indexedAndSorted) > 0 {
		array2 := *arraypkg.UnsafeThaw([]tuple.TupleInt{indexedAndSorted[0]})
		for _, pair := range indexedAndSorted {
			array3 := shared.Frozen(array2)
			index := len(array3) - 1
			var result2 tuple.TupleInt
			if index >= 0 && index < len(array3) {
				result2 = array3[index]
			} else {
				panic("Failed pattern match")
			}
			lst := result2.Second
			if mainComp(lst, pair.Second) != ordering.OrderingEQ {
				array2 = append(array2, pair)
			}
		}
		performed := shared.Frozen(array2)
		array := shared.SortByKey(performed, func(x tuple.TupleInt) int {
			return x.First
		})
		mapped := make([]int, len(array))
		for index := range array {
			mapped[index] = array[index].Second
		}
		result = mapped
	} else {
		result = []int{}
	}
	mainRecord(shown, show.ArrayInt(result))
	array4 := arraypkg.GroupBy(eq.Eq, []int{1, 1, 2, 3, 3})
	mapped2 := make([][]int, len(array4))
	for index, element := range array4 {
		mapped2[index] = element
	}
	mainRecord(shown, show.ArrayArrayInt(mapped2))
	array5 := arraypkg.GroupBy(func(first int, x int) bool {
		return x-first < 2
	}, []int{1, 2, 3, 4, 7})
	mapped3 := make([][]int, len(array5))
	for index, element := range array5 {
		mapped3[index] = element
	}
	mainRecord(shown, show.ArrayArrayInt(mapped3))
}

func mainRecord(shown *shared.Ref[string], text string) {
	s := shown.Value
	s_ := prim.Append(s, text)
	shown.Value = s_
}

func mainComp(x int, y int) ordering.Ordering {
	i := prim.IntModPositive(x, 3)
	i2 := prim.IntModPositive(y, 3)
	if i < i2 {
		return ordering.OrderingLT
	}
	if i == i2 {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type SortByKeyOrdered interface {
	~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64
}

type SortByKeyEntry[K SortByKeyOrdered] struct {
	key   K
	index int
}

func SortByKey[T any, K SortByKeyOrdered](xs []T, key func(T) K) []T {
	entries := make([]SortByKeyEntry[K], len(xs))
	for index, x := range xs {
		entries[index] = SortByKeyEntry[K]{key: key(x), index: index}
	}
	if len(xs) > 1 {
		scratch := make([]SortByKeyEntry[K], len(xs))
		copy(scratch, entries)
		SortByKeyMerge(entries, scratch, 0, len(xs))
	}
	sorted := make([]T, len(xs))
	for index, entry := range entries {
		sorted[index] = xs[entry.index]
	}
	return sorted
}

func SortByKeyMerge[K SortByKeyOrdered](into []SortByKeyEntry[K], from []SortByKeyEntry[K], low int, high int) {
	middle := low + (high-low)>>1
	if middle-low > 1 {
		SortByKeyMerge(from, into, low, middle)
	}
	if high-middle > 1 {
		SortByKeyMerge(from, into, middle, high)
	}
	i, j, k := low, middle, low
	for i < middle && j < high {
		if from[j].key < from[i].key {
			into[k] = from[j]
			j++
		} else {
			into[k] = from[i]
			i++
		}
		k++
	}
	k += copy(into[k:], from[i:middle])
	copy(into[k:], from[j:high])
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}

type StateValue struct {
	State string
	Value string
}
