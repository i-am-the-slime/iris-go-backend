// Data/Array/NonEmpty/nonempty.go
package nonempty

func ToArrayInt(array []int32) []int32 {
	return array
}

// Data/Eq/eq.go
package eq

func Eq(i int32, i2 int32) bool {
	return i == i2
}

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

func ShowInt2(i int32) string {
	return strconv.Itoa(int(i))
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

func ShowChar(char rune) string {
	return prim.ShowChar(char)
}

func ShowBoolean(boolean bool) string {
	if boolean {
		return "true"
	}
	return "false"
}

func ShowNumber(number float64) string {
	return prim.ShowNumber(number)
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayBoolean(buffer []byte, array []bool) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendBool(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayChar(buffer []byte, array []rune) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = prim.AppendShowChar(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// Data/Tuple/tuple.go
package tuple

type TupleIntNumber struct {
	Second float64
	First  int32
}

type TupleIntInt struct {
	First  int32
	Second int32
}

func SndIntInt(tuple TupleIntInt) int32 {
	return tuple.Second
}

func SndIntNumber(tuple TupleIntNumber) float64 {
	return tuple.Second
}

// main.go
package main

import (
	nonemptyarray "fixture/Data/Array/NonEmpty"
	"fixture/Data/Eq"
	"fixture/Data/Ordering"
	"fixture/Data/Show"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main() {
	shown := &shared.Ref[string]{Value: ""}
	mainRecord(shown, string(show.AppendShowArrayInt(nil, arraypkg.NubComparable([]int32{3, 1, 3, 2, 1}))))
	mainRecord(shown, string(show.AppendShowArrayString(nil, arraypkg.NubComparable([]string{"b", "a", "b"}))))
	mainRecord(shown, string(show.AppendShowArrayChar(nil, arraypkg.NubComparable([]rune{'x', 'y', 'x'}))))
	mainRecord(shown, string(show.AppendShowArrayBoolean(nil, arraypkg.NubComparable([]bool{true, false, true}))))
	array := []float64{1.5, 0.5, 1.5}
	mapped := make([]tuple.TupleIntNumber, len(array))
	for slot, number := range array {
		i := int32(slot)
		mapped[slot] = tuple.TupleIntNumber{First: i, Second: number}
	}
	indexedAndSorted := direct.SortBy(func(x tuple.TupleIntNumber, y tuple.TupleIntNumber) ordering.Ordering {
		number := x.Second
		number2 := y.Second
		if number < number2 {
			return ordering.OrderingLT
		}
		if number == number2 {
			return ordering.OrderingEQ
		}
		return ordering.OrderingGT
	}, func(value ordering.Ordering) int32 {
		switch value {
		case ordering.OrderingGT:
			return 1
		case ordering.OrderingEQ:
			return 0
		default: // ordering.OrderingLT
			return -1
		}
	}, mapped)
	var result []float64
	if 0 < int32(len(indexedAndSorted)) {
		array2 := *arraypkg.UnsafeThaw([]tuple.TupleIntNumber{indexedAndSorted[0]})()
		for _, pair := range indexedAndSorted {
			x_ := pair.Second
			array3 := shared.Frozen(array2)
			index := int32(len(array3)) - 1
			var result2 tuple.TupleIntNumber
			if index >= 0 && index < int32(len(array3)) {
				result2 = array3[index]
			} else {
				panic("Failed pattern match")
			}
			lst := result2.Second
			result3 := !(lst < x_) && lst == x_
			if result3 == false {
				array2 = arraypkg.Bounded(append(array2, pair))
			}
		}
		performed := shared.Frozen(array2)
		array4 := direct.SortBy(func(x tuple.TupleIntNumber, y tuple.TupleIntNumber) ordering.Ordering {
			i := x.First
			i2 := y.First
			if i < i2 {
				return ordering.OrderingLT
			}
			if i == i2 {
				return ordering.OrderingEQ
			}
			return ordering.OrderingGT
		}, func(value ordering.Ordering) int32 {
			switch value {
			case ordering.OrderingGT:
				return 1
			case ordering.OrderingEQ:
				return 0
			default: // ordering.OrderingLT
				return -1
			}
		}, performed)
		mapped2 := make([]float64, len(array4))
		for index, element := range array4 {
			mapped2[index] = tuple.SndIntNumber(element)
		}
		result = mapped2
	} else {
		result = []float64{}
	}
	mainRecord(shown, string(show.AppendShowArrayNumber(nil, result)))
	array5 := []int32{1, 4, 2, 5, 3}
	mapped3 := make([]tuple.TupleIntInt, len(array5))
	for slot, i := range array5 {
		i2 := int32(slot)
		mapped3[slot] = tuple.TupleIntInt{First: i2, Second: i}
	}
	indexedAndSorted2 := direct.SortBy(func(x tuple.TupleIntInt, y tuple.TupleIntInt) ordering.Ordering {
		return mainComp(x.Second, y.Second)
	}, func(value ordering.Ordering) int32 {
		switch value {
		case ordering.OrderingGT:
			return 1
		case ordering.OrderingEQ:
			return 0
		default: // ordering.OrderingLT
			return -1
		}
	}, mapped3)
	var result4 []int32
	if 0 < int32(len(indexedAndSorted2)) {
		array2 := *arraypkg.UnsafeThaw([]tuple.TupleIntInt{indexedAndSorted2[0]})()
		for _, pair := range indexedAndSorted2 {
			array3 := shared.Frozen(array2)
			index := int32(len(array3)) - 1
			var result2 tuple.TupleIntInt
			if index >= 0 && index < int32(len(array3)) {
				result2 = array3[index]
			} else {
				panic("Failed pattern match")
			}
			lst := result2.Second
			scrutinee := mainComp(lst, pair.Second)
			var result3 bool
			switch scrutinee {
			case ordering.OrderingEQ:
				result3 = true
			default:
				result3 = false
			}
			if result3 == false {
				array2 = arraypkg.Bounded(append(array2, pair))
			}
		}
		performed := shared.Frozen(array2)
		array4 := direct.SortBy(func(x tuple.TupleIntInt, y tuple.TupleIntInt) ordering.Ordering {
			i := x.First
			i2 := y.First
			if i < i2 {
				return ordering.OrderingLT
			}
			if i == i2 {
				return ordering.OrderingEQ
			}
			return ordering.OrderingGT
		}, func(value ordering.Ordering) int32 {
			switch value {
			case ordering.OrderingGT:
				return 1
			case ordering.OrderingEQ:
				return 0
			default: // ordering.OrderingLT
				return -1
			}
		}, performed)
		mapped2 := make([]int32, len(array4))
		for index, element := range array4 {
			mapped2[index] = tuple.SndIntInt(element)
		}
		result4 = mapped2
	} else {
		result4 = []int32{}
	}
	mainRecord(shown, string(show.AppendShowArrayInt(nil, result4)))
	array6 := arraypkg.GroupBy(eq.Eq, []int32{1, 1, 2, 3, 3})
	mapped4 := make([][]int32, len(array6))
	for index, element := range array6 {
		mapped4[index] = nonemptyarray.ToArrayInt(element)
	}
	mainRecord(shown, string(show.AppendShowArrayArrayInt(nil, mapped4)))
	array7 := arraypkg.GroupBy(func(first int32, x int32) bool {
		return x-first < 2
	}, []int32{1, 2, 3, 4, 7})
	mapped5 := make([][]int32, len(array7))
	for index, element := range array7 {
		mapped5[index] = nonemptyarray.ToArrayInt(element)
	}
	mainRecord(shown, string(show.AppendShowArrayArrayInt(nil, mapped5)))
}

func mainRecord(shown *shared.Ref[string], text string) {
	s := shown.Value
	s_ := prim.Append(s, text)
	shown.Value = s_
}

func mainF(value int32) int32 {
	return prim.IntModPositive(value, 3)
}

func mainComp(x int32, y int32) ordering.Ordering {
	i := mainF(x)
	i2 := mainF(y)
	if i < i2 {
		return ordering.OrderingLT
	}
	if i == i2 {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}

type StateValue struct {
	State string
	Value string
}
