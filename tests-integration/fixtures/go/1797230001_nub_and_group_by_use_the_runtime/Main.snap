// Data/Array/array.go
package dataarray

import (
	"fixture/Data/Ordering"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
)

func Nub(xs []float64) []float64 {
	mapped := make([]tuple.TupleNumber, len(xs))
	for slot, number := range xs {
		i := int32(slot)
		mapped[slot] = tuple.TupleNumber{First: i, Second: number}
	}
	indexedAndSorted := direct.SortBy(mapped, func(x tuple.TupleNumber, y tuple.TupleNumber) int {
		number := x.Second
		number2 := y.Second
		var result ordering.Ordering
		if number < number2 {
			result = ordering.OrderingLT
		} else if number == number2 {
			result = ordering.OrderingEQ
		} else {
			result = ordering.OrderingGT
		}
		switch result {
		case ordering.OrderingLT:
			return -1
		case ordering.OrderingGT:
			return 1
		}
		return 0
	})
	if len(indexedAndSorted) > 0 {
		array2 := *arraypkg.UnsafeThaw([]tuple.TupleNumber{indexedAndSorted[0]})
		for _, pair := range indexedAndSorted {
			x_ := pair.Second
			array3 := shared.Frozen(array2)
			index := int32(len(array3)) - 1
			var result tuple.TupleNumber
			if index >= 0 && index < int32(len(array3)) {
				result = array3[index]
			} else {
				panic("Failed pattern match")
			}
			lst := result.Second
			if lst < x_ {
				array2 = arraypkg.Bounded(append(array2, pair))
			} else if lst != x_ {
				array2 = arraypkg.Bounded(append(array2, pair))
			}
		}
		performed := shared.Frozen(array2)
		array := direct.SortBy(performed, func(x tuple.TupleNumber, y tuple.TupleNumber) int {
			i := x.First
			i2 := y.First
			var result ordering.Ordering
			if i < i2 {
				result = ordering.OrderingLT
			} else if i == i2 {
				result = ordering.OrderingEQ
			} else {
				result = ordering.OrderingGT
			}
			switch result {
			case ordering.OrderingLT:
				return -1
			case ordering.OrderingGT:
				return 1
			}
			return 0
		})
		mapped2 := make([]float64, len(array))
		for index := range array {
			mapped2[index] = array[index].Second
		}
		return mapped2
	}
	return []float64{}
}

// Data/Eq/eq.go
package eq

func Eq(i int32, i2 int32) bool {
	return i == i2
}

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int32) string {
	return strconv.Itoa(int(i))
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

func ShowChar(char rune) string {
	return prim.ShowChar(char)
}

func ShowBoolean(boolean bool) string {
	if boolean {
		return "true"
	}
	return "false"
}

func ShowNumber(number float64) string {
	return prim.ShowNumber(number)
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayBoolean(buffer []byte, array []bool) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendBool(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayChar(buffer []byte, array []rune) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowChar(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayArrayInt(array [][]int32) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

func ArrayNumber(array []float64) string {
	return string(AppendShowArrayNumber(nil, array))
}

func ArrayBoolean(array []bool) string {
	return string(AppendShowArrayBoolean(nil, array))
}

func ArrayChar(array []rune) string {
	return string(AppendShowArrayChar(nil, array))
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

// Data/Tuple/tuple.go
package tuple

type TupleInt struct {
	First  int32
	Second int32
}

type TupleNumber struct {
	Second float64
	First  int32
}

// main.go
package main

import (
	"fixture/Data/Array"
	"fixture/Data/Eq"
	"fixture/Data/Ordering"
	"fixture/Data/Show"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main() {
	shown := &shared.Ref[string]{Value: ""}
	mainRecord(shown, show.ArrayInt(arraypkg.NubComparable([]int32{3, 1, 3, 2, 1})))
	mainRecord(shown, show.ArrayString(arraypkg.NubComparable([]string{"b", "a", "b"})))
	mainRecord(shown, show.ArrayChar(arraypkg.NubComparable([]rune{'x', 'y', 'x'})))
	mainRecord(shown, show.ArrayBoolean(arraypkg.NubComparable([]bool{true, false, true})))
	mainRecord(shown, show.ArrayNumber(dataarray.Nub([]float64{1.5, 0.5, 1.5})))
	array := []int32{1, 4, 2, 5, 3}
	mapped := make([]tuple.TupleInt, len(array))
	for slot, i := range array {
		i2 := int32(slot)
		mapped[slot] = tuple.TupleInt{First: i2, Second: i}
	}
	indexedAndSorted := direct.SortBy(mapped, func(x tuple.TupleInt, y tuple.TupleInt) int {
		switch mainComp(x.Second, y.Second) {
		case ordering.OrderingLT:
			return -1
		case ordering.OrderingGT:
			return 1
		}
		return 0
	})
	var result []int32
	if len(indexedAndSorted) > 0 {
		array2 := *arraypkg.UnsafeThaw([]tuple.TupleInt{indexedAndSorted[0]})
		for _, pair := range indexedAndSorted {
			array3 := shared.Frozen(array2)
			index := int32(len(array3)) - 1
			var result2 tuple.TupleInt
			if index >= 0 && index < int32(len(array3)) {
				result2 = array3[index]
			} else {
				panic("Failed pattern match")
			}
			lst := result2.Second
			if mainComp(lst, pair.Second) != ordering.OrderingEQ {
				array2 = arraypkg.Bounded(append(array2, pair))
			}
		}
		performed := shared.Frozen(array2)
		array4 := direct.SortBy(performed, func(x tuple.TupleInt, y tuple.TupleInt) int {
			i := x.First
			i2 := y.First
			var result2 ordering.Ordering
			if i < i2 {
				result2 = ordering.OrderingLT
			} else if i == i2 {
				result2 = ordering.OrderingEQ
			} else {
				result2 = ordering.OrderingGT
			}
			switch result2 {
			case ordering.OrderingLT:
				return -1
			case ordering.OrderingGT:
				return 1
			}
			return 0
		})
		mapped2 := make([]int32, len(array4))
		for index := range array4 {
			mapped2[index] = array4[index].Second
		}
		result = mapped2
	} else {
		result = []int32{}
	}
	mainRecord(shown, show.ArrayInt(result))
	array5 := arraypkg.GroupBy(eq.Eq, []int32{1, 1, 2, 3, 3})
	mapped3 := make([][]int32, len(array5))
	for index, element := range array5 {
		mapped3[index] = element
	}
	mainRecord(shown, show.ArrayArrayInt(mapped3))
	array6 := arraypkg.GroupBy(func(first int32, x int32) bool {
		return x-first < 2
	}, []int32{1, 2, 3, 4, 7})
	mapped4 := make([][]int32, len(array6))
	for index, element := range array6 {
		mapped4[index] = element
	}
	mainRecord(shown, show.ArrayArrayInt(mapped4))
}

func mainRecord(shown *shared.Ref[string], text string) {
	s := shown.Value
	s_ := prim.Append(s, text)
	shown.Value = s_
}

func mainComp(x int32, y int32) ordering.Ordering {
	i := prim.IntModPositive(x, 3)
	i2 := prim.IntModPositive(y, 3)
	if i < i2 {
		return ordering.OrderingLT
	}
	if i == i2 {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}

type StateValue struct {
	State string
	Value string
}
