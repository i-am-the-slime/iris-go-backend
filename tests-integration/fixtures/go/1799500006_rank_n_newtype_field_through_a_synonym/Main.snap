// main.go
package main

import (
	journal "fixture/Journal_ffi"
	"strconv"
)

type Resource struct {
	ForInt  func(func(int) int) int
	ForUnit func(func(int))
}

func main() {
	i := acquired.ForInt(func(x int) int {
		return x + 1
	})
	journal.Log(strconv.Itoa(i))
	acquired.ForUnit(func(x int) {
		journal.Log(strconv.Itoa(x))
	})
}

var acquired Resource = Resource{ForInt: func(use func(int) int) int {
	journal.Log("acquire")
	result := use(41)
	journal.Log("release")
	return result
}, ForUnit: func(use func(int)) {
	journal.Log("acquire")
	use(41)
	journal.Log("release")
}}
