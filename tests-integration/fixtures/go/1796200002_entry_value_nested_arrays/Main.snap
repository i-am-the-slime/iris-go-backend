// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ [][]bool = [][]bool{{false, false}, {true, false}, {true, true}}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts2 := make([]string, 0, len(element))
		for _, element2 := range element {
			texts2 = append(texts2, strconv.FormatBool(element2))
		}
		texts = append(texts, "["+strings.Join(texts2, " ")+"]")
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
