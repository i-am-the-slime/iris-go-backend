// Data/Either/either.go
package either

type EitherInt struct {
	Field0 int32
	Tag    uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type EitherEitherIntInt struct {
	Left  string
	Right EitherInt
	Tag   uint8
}

const (
	EitherEitherIntIntLeft = iota
	EitherEitherIntIntRight
)

type EitherStringInt struct {
	Left  string
	Right int
	Tag   uint8
}

const (
	EitherStringIntLeft = iota
	EitherStringIntRight
)

type IntFailure struct {
	Failed bool
	Left   int
}

type StringFailure struct {
	Failed bool
	Left   string
}

// main.go
package main

import (
	"fixture/Data/Either"
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	i, err, err2 := classify(304)
	var i2 int
	var err3 either.StringFailure
	if err2.Failed {
		err3 = err2
	} else {
		journal.Log("classified 304")
		if err.Failed {
			i2, err3 = err.Left, either.StringFailure{}
		} else {
			i2, err3 = i+1, either.StringFailure{}
		}
	}
	var result string
	if err3.Failed {
		result = "(Left " + prim.ShowString(err3.Left) + ")"
	} else {
		result = "(Right " + strconv.Itoa(i2) + ")"
	}
	journal.Log(result)
	i3, err, err2 := classify(207)
	var i4 int
	var err4 either.StringFailure
	if err2.Failed {
		err4 = err2
	} else {
		journal.Log("classified 207")
		if err.Failed {
			i4, err4 = err.Left, either.StringFailure{}
		} else {
			i4, err4 = i3+1, either.StringFailure{}
		}
	}
	var result2 string
	if err4.Failed {
		result2 = "(Left " + prim.ShowString(err4.Left) + ")"
	} else {
		result2 = "(Right " + strconv.Itoa(i4) + ")"
	}
	journal.Log(result2)
	i5, err, err2 := classify(-5)
	var i6 int
	var err5 either.StringFailure
	if err2.Failed {
		err5 = err2
	} else {
		journal.Log("classified -5")
		if err.Failed {
			i6, err5 = err.Left, either.StringFailure{}
		} else {
			i6, err5 = i5+1, either.StringFailure{}
		}
	}
	var result3 string
	if err5.Failed {
		result3 = "(Left " + prim.ShowString(err5.Left) + ")"
	} else {
		result3 = "(Right " + strconv.Itoa(i6) + ")"
	}
	journal.Log(result3)
	journal.Log("(Right 3)")
	journal.Log("(Right 56)")
	journal.Log("(Left " + prim.ShowString("negative -1") + ")")
	journal.Log("passing on 41")
	i7, err, err2 := classify(42)
	var result4 string
	if err2.Failed {
		result4 = "(Left " + prim.ShowString(err2.Left) + ")"
	} else {
		var result5 string
		if err.Failed {
			result5 = "(Left " + strconv.Itoa(err.Left) + ")"
		} else {
			result5 = "(Right " + strconv.Itoa(i7) + ")"
		}
		result4 = "(Right " + result5 + ")"
	}
	journal.Log(result4)
	journal.Log("passing on -3")
	i8, err, err2 := classify(-2)
	var result6 string
	if err2.Failed {
		result6 = "(Left " + prim.ShowString(err2.Left) + ")"
	} else {
		var result5 string
		if err.Failed {
			result5 = "(Left " + strconv.Itoa(err.Left) + ")"
		} else {
			result5 = "(Right " + strconv.Itoa(i8) + ")"
		}
		result6 = "(Right " + result5 + ")"
	}
	journal.Log(result6)
}

func classify(n int) (int, either.IntFailure, either.StringFailure) {
	for {
		if n < 0 {
			return 0, either.IntFailure{}, either.StringFailure{Failed: true, Left: "negative " + strconv.Itoa(n)}
		}
		if n > 100 {
			n -= 100
			continue
		}
		if n%2 == 0 {
			return 0, either.IntFailure{Failed: true, Left: n / 2}, either.StringFailure{}
		}
		return n*3+1, either.IntFailure{}, either.StringFailure{}
	}
}
