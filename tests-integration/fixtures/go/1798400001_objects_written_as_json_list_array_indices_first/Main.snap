// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  string
	Second int32
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/Data/Tuple"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/object"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{foreignvalue.Encode(shared.EncodeJSONObjectInt, scores), show.ArrayString(object.Keys(scores))}
}

var scores = initializeScores()

func initializeScores() *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int
} {
	object2 := object.New[int]()
	for _, tuple := range []tuple.Tuple{{First: "b", Second: 1}, {First: "10", Second: 2}, {First: "2", Second: 3}} {
		object.Poke(tuple.First, int(tuple.Second), object2)
	}
	return object2
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

import (
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/object"
)

func EncodeJSONObjectInt(e *foreignvalue.Encoder, value *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int
}) {
	e.Raw("{")
	for key, member := range object.Entries(value) {
		e.Key(key)
		e.Int(member)
	}
	e.Raw("}")
}
