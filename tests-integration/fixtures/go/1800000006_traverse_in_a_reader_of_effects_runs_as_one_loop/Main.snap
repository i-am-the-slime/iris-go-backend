// Data/Either/either.go
package either

type EitherArrayInt struct {
	Left  string
	Right []int
	Tag   uint8
}

const (
	EitherArrayIntLeft = iota
	EitherArrayIntRight
)

type EitherInt struct {
	Left  string
	Right int
	Tag   uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type StringFailure struct {
	Failed bool
	Left   string
}

// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// Data/Traversable/traversable.go
package traversable

import (
	"fixture/Data/Either"
	"slices"
)

func Traverse(function func(int, struct{}) (int, either.StringFailure), array []int, context struct{}) ([]int, either.StringFailure) {
	return TraverseFrom(function, array, 0, []int{})
}

func TraverseFrom(function func(int, struct{}) (int, either.StringFailure), array []int, index int, field0 []int) ([]int, either.StringFailure) {
	field0 = slices.Clip(field0)
	for {
		if index < len(array) {
			i, err := function(array[index], struct{}{})
			if err.Failed {
				return nil, err
			}
			index, field0 = index+1, append(field0, i)
			continue
		} else {
			return field0, either.StringFailure{}
		}
	}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Show"
	"fixture/Data/Traversable"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"slices"
	"strconv"
)

func main() {
	array_, err := mainFrom(0, []int{})
	var result string
	if err.Failed {
		result = "failed: " + err.Left
	} else {
		result = show.ArrayInt(array_)
	}
	journal.Log(result)
	seen := &shared.Ref[int]{Value: 0}
	array_2, err := traversable.Traverse(func(number int, context struct{}) (int, either.StringFailure) {
		return mainCounting(seen, number, context)
	}, array.Range(1, 5), struct{}{})
	var result2 string
	if err.Failed {
		result2 = "failed: " + err.Left
	} else {
		result2 = show.ArrayInt(array_2)
	}
	journal.Log(result2)
	array_3, err := traversable.Traverse(func(a int, context struct{}) (int, either.StringFailure) {
		number, err2 := mainCounting(seen, a, context)
		if err2.Failed {
			return 0, err2
		}
		if number >= 30 {
			return 0, either.StringFailure{Failed: true, Left: "stopped at " + strconv.Itoa(number)}
		}
		return number, either.StringFailure{}
	}, array.Range(1, 5), struct{}{})
	var result3 string
	if err.Failed {
		result3 = "failed: " + err.Left
	} else {
		result3 = show.ArrayInt(array_3)
	}
	journal.Log(result3)
	i := seen.Value
	journal.Log(strconv.Itoa(i))
}

func mainCounting(seen *shared.Ref[int], number int, context struct{}) (int, either.StringFailure) {
	x := number * 10
	s := seen.Value
	s_ := s + 1
	seen.Value = s_
	return x, either.StringFailure{}
}

func mainFrom(index int, field0 []int) ([]int, either.StringFailure) {
	field0 = slices.Clip(field0)
	for {
		if index < 5 {
			index, field0 = index+1, append(field0, (1+index)*2)
			continue
		}
		return field0, either.StringFailure{}
	}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
