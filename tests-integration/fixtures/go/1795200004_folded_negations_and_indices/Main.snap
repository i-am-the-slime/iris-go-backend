// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"os"
)

func main_() int {
	var result int
	switch missing.Tag {
	case maybe.TagNothing:
		result = 10
	default: // maybe.TagJust
		result = missing.Just
	}
	return negated + result + 101
}

var negated int = 1

var missing maybe.Int = maybe.NoInt

func main() {
	os.Exit(main_())
}
