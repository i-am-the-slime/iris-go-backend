type EitherReadError struct {
	Left   ReadError
	Right  any
	Origin any
	Tag    uint8
}

const (
	EitherReadErrorLeft = iota
	EitherReadErrorRight
)

type ReaderOfFnStringEitherReadError struct {
	Name string
	Read func(string) *EitherReadError
}

type Parser struct {
	Option ReaderOfFnStringEitherReadError
	Field0 any
	Tag    uint8
}

const (
	ParserOption = iota
	ParserDone
	ParserApply
)

func convert(value EitherFnCommandCommand) *EitherReadError {
	switch value.Tag {
	case EitherFnCommandCommandLeft:
		return &EitherReadError{Tag: EitherReadErrorLeft, Left: value.Left, Origin: value}
	default: // EitherFnCommandCommandRight
		return &EitherReadError{Tag: EitherReadErrorRight, Right: func(coerced any) any {
			return value.Right(coerced.(Command))
		}, Origin: value}
	}
}

func convert2(value ReaderFnCommandCommand) ReaderOfFnStringEitherReadError {
	return ReaderOfFnStringEitherReadError{Name: value.Name, Read: func(coerced string) *EitherReadError {
		return convert(EitherFnCommandCommandFromResults(value.Read(coerced)))
	}}
}

type EitherFn struct {
	Left   ReadError
	Right  func(any) any
	Origin any
	Tag    uint8
}

const (
	EitherFnLeft = iota
	EitherFnRight
)

type ReaderFn struct {
	Name string
	Read func(string) *EitherFn
}

type ParserFn struct {
	Option ReaderFn
	Done   func(any) any
	Apply  any
	Tag    uint8
}

const (
	ParserFnOption = iota
	ParserFnDone
	ParserFnApply
)

type Applied struct {
	First  *ParserFn
	Second *Parser
}

func convert3(value EitherFnFnCommandCommandFnCommandCommand) *EitherFn {
	switch value.Tag {
	case EitherFnFnCommandCommandFnCommandCommandLeft:
		return &EitherFn{Tag: EitherFnLeft, Left: value.Left}
	default: // EitherFnFnCommandCommandFnCommandCommandRight
		return &EitherFn{Tag: EitherFnRight, Right: func(coerced any) any {
			original := coerced.(func(any) any)
			original2 := value.Right(func(coerced2 Command) Command {
				return original(coerced2).(Command)
			})
			return func(coerced2 any) any {
				return original2(coerced2.(Command))
			}
		}}
	}
}

func convert4(value ReaderFnFnCommandCommandFnCommandCommand) ReaderFn {
	return ReaderFn{Name: value.Name, Read: func(coerced string) *EitherFn {
		return convert3(EitherFnFnCommandCommandFnCommandCommandFromResults(value.Read(coerced)))
	}}
}

func convert5(value EitherFnFnCommandCommandFnFnCommandCommandFnCommandCommand) *EitherFn {
	switch value.Tag {
	case EitherFnFnCommandCommandFnFnCommandCommandFnCommandCommandLeft:
		return &EitherFn{Tag: EitherFnLeft, Left: value.Left}
	default: // EitherFnFnCommandCommandFnFnCommandCommandFnCommandCommandRight
		return &EitherFn{Tag: EitherFnRight, Right: func(coerced any) any {
			original := coerced.(func(any) any)
			original2 := value.Right(func(coerced2 Command) Command {
				return original(coerced2).(Command)
			})
			return func(coerced2 any) any {
				original3 := coerced2.(func(any) any)
				original4 := original2(func(coerced3 Command) Command {
					return original3(coerced3).(Command)
				})
				return func(coerced3 any) any {
					return original4(coerced3.(Command))
				}
			}
		}}
	}
}

func convert6(value ReaderFnFnCommandCommandFnFnCommandCommandFnCommandCommand) ReaderFn {
	return ReaderFn{Name: value.Name, Read: func(coerced string) *EitherFn {
		return convert5(EitherFnFnCommandCommandFnFnCommandCommandFnCommandCommandFromResults(value.Read(coerced)))
	}}
}

func convert7(value ParserFnFnCommandCommandFnFnCommandCommandFnCommandCommand) *ParserFn {
	switch value.Tag {
	case ParserFnFnCommandCommandFnFnCommandCommandFnCommandCommandOption:
		return &ParserFn{Tag: ParserFnOption, Option: convert6(value.Option)}
	case ParserFnFnCommandCommandFnFnCommandCommandFnCommandCommandDone:
		return &ParserFn{Tag: ParserFnDone, Done: func(coerced any) any {
			original := coerced.(func(any) any)
			original2 := value.Done(func(coerced2 Command) Command {
				return original(coerced2).(Command)
			})
			return func(coerced2 any) any {
				original3 := coerced2.(func(any) any)
				original4 := original2(func(coerced3 Command) Command {
					return original3(coerced3).(Command)
				})
				return func(coerced3 any) any {
					return original4(coerced3.(Command))
				}
			}
		}}
	default: // ParserFnFnCommandCommandFnFnCommandCommandFnCommandCommandApply
		return &ParserFn{Tag: ParserFnApply, Apply: exists.Convert(value.Apply)}
	}
}

func convert8(value *AppliedFnFnCommandCommandFnCommandCommand) *Applied {
	if value == nil {
		return nil
	}
	return &Applied{First: convert7(value.First), Second: convert13(value.Second)}
}

func convert9(value *ExistsAppliedFnFnCommandCommandFnCommandCommand) any {
