type ReadError struct {
	Unknown string
	Tag     uint8
}

const (
	ReadErrorUnknown = iota
	ReadErrorEmpty
)

type Command uint8

const (
	CommandHello Command = iota
	CommandBye
)

type EitherFnCommandCommand struct {
	Left  ReadError
	Right func(Command) Command
