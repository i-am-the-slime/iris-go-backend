	if value == nil {
		return nil
	}
	switch value.Tag {
	case ParserFnFnCommandCommandFnCommandCommandOption:
		return &ParserFn{Tag: ParserFnOption, Option: convert4(value.Option)}
	case ParserFnFnCommandCommandFnCommandCommandDone:
		return &ParserFn{Tag: ParserFnDone, Done: func(coerced any) any {
