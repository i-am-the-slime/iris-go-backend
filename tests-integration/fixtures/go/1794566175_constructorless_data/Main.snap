// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	mapped := make([]int32, len(values))
	for index, value := range values {
		mapped[index] = value.(int32) + 1
	}
	return array.Append(mapped, []int32{3})
}

var values []any = []any{int32(1), int32(2)}

func main() {
	fmt.Println(main_)
}
