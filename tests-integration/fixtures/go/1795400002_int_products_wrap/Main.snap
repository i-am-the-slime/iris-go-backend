// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return []string{prim.ShowInt(-67153019) + "/" + prim.ShowInt(opaque(123456789) * 987654321), prim.ShowInt(1) + "/" + prim.ShowInt(opaque(2147483647) * opaque(2147483647)), prim.ShowInt(0) + "/" + prim.ShowInt(opaque(65536) * 65536), prim.ShowInt(-42) + "/" + prim.ShowInt(opaque(-7) * 6), prim.ShowInt(prim.IntPow(3, 40)) + "/" + prim.ShowInt(prim.IntPow(opaque(3), 40)), prim.ShowInt(prim.IntPow(2, 31)) + "/" + prim.ShowInt(prim.IntPow(opaque(2), 31)), prim.ShowInt(prim.IntPow(2, -1)) + "/" + prim.ShowInt(prim.IntPow(opaque(2), -1)), prim.ShowInt(prim.IntPow(-1, -3)) + "/" + prim.ShowInt(prim.IntPow(opaque(-1), -3))}
}

func opaque(x int32) int32 {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	fmt.Println(main_)
}
