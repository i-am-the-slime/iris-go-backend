// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{"121932631112635269/" + strconv.Itoa(opaque(123456789)*987654321), "4611686014132420609/" + strconv.Itoa(opaque(2147483647)*opaque(2147483647)), "4294967296/" + strconv.Itoa(opaque(65536)*65536), "-42/" + strconv.Itoa(opaque(-7)*6), strconv.Itoa(prim.IntPow(3, 40)) + "/" + strconv.Itoa(prim.IntPow(opaque(3), 40)), strconv.Itoa(prim.IntPow(2, 31)) + "/" + strconv.Itoa(prim.IntPow(opaque(2), 31)), strconv.Itoa(prim.IntPow(2, -1)) + "/" + strconv.Itoa(prim.IntPow(opaque(2), -1)), strconv.Itoa(prim.IntPow(-1, -3)) + "/" + strconv.Itoa(prim.IntPow(opaque(-1), -3))}
}

func opaque(x int) int {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
