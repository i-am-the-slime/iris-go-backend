// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"strconv"
	"strings"
)

type ValueInt struct {
	Field0       shared.Equal
	StringValue0 shared.Equal
	StringValue1 string
	Pair0        *ValueInt
	Pair1        *ValueInt
	Field1       int32
	Tag          uint8
}

const (
	ValueIntIntValue = iota
	ValueIntAgeValue
	ValueIntStringValue
	ValueIntPair
)

type ValueString struct {
	Field0       shared.Equal
	StringValue0 shared.Equal
	StringValue1 string
	Pair0        *ValueString
	Pair1        *ValueString
	Field1       int32
	Tag          uint8
}

const (
	ValueStringIntValue = iota
	ValueStringAgeValue
	ValueStringStringValue
	ValueStringPair
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	valueInts := make([]ValueInt, 3)
	valueInts[0] = ValueInt{Tag: ValueIntPair, Pair0: &valueInts[1], Pair1: &valueInts[2]}
	valueInts[1] = ValueInt{Tag: ValueIntIntValue, Field0: reflTypeInt, Field1: 41}
	valueInts[2] = ValueInt{Tag: ValueIntIntValue, Field0: reflTypeInt, Field1: 0}
	valueStrings := make([]ValueString, 3)
	valueStrings[0] = ValueString{Tag: ValueStringPair, Pair0: &valueStrings[1], Pair1: &valueStrings[2]}
	valueStrings[1] = ValueString{Tag: ValueStringStringValue, StringValue0: reflTypeInt, StringValue1: "left"}
	valueStrings[2] = ValueString{Tag: ValueStringStringValue, StringValue0: reflTypeInt, StringValue1: "right"}
	return []string{strconv.Itoa(int(evaluateInt(&valueInts[0]) + 1)), evaluateString(&valueStrings[0])}
}

func evaluateInt(value *ValueInt) int32 {
	for {
		switch value.Tag {
		case ValueIntIntValue:
			n := value.Field1
			return n
		case ValueIntAgeValue:
			age := value.Field1
			return age
		default: // ValueIntPair
			value = value.Pair0
			continue
		}
	}
}

var reflTypeInt shared.Equal = shared.Equal{}

func evaluateString(value *ValueString) string {
	for {
		switch value.Tag {
		case ValueStringStringValue:
			s := value.StringValue1
			return s
		default: // ValueStringPair
			value = value.Pair0
			continue
		}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Equal struct{}
