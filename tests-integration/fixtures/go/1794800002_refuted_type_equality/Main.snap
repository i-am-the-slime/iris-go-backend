// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type Equal struct{}

type ValueInt struct {
	Field0       Equal
	StringValue0 Equal
	StringValue1 string
	Pair0        *ValueInt
	Pair1        *ValueInt
	Field1       int32
	Tag          uint8
}

const (
	ValueIntIntValue = iota
	ValueIntAgeValue
	ValueIntStringValue
	ValueIntPair
)

type ValueString struct {
	Field0       Equal
	StringValue0 Equal
	StringValue1 string
	Pair0        *ValueString
	Pair1        *ValueString
	Field1       int32
	Tag          uint8
}

const (
	ValueStringIntValue = iota
	ValueStringAgeValue
	ValueStringStringValue
	ValueStringPair
)

func IntValue(field0 Equal, field1 int) *ValueInt {
	return &ValueInt{Tag: ValueIntIntValue, Field0: field0, Field1: int32(field1)}
}

func StringValue(stringValue0 Equal, stringValue1 string) *ValueString {
	return &ValueString{Tag: ValueStringStringValue, StringValue0: stringValue0, StringValue1: stringValue1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{strconv.Itoa(evaluateInt(IntValue(refl, 41)) + 1), evaluateString(StringValue(refl, "left"))}
}

func evaluateInt(value *ValueInt) int {
	for {
		switch value.Tag {
		case ValueIntIntValue, ValueIntAgeValue:
			return int(value.Field1)
		default: // ValueIntPair
			value = value.Pair0
			continue
		}
	}
}

var refl Equal = Equal{}

func evaluateString(value *ValueString) string {
	for {
		switch value.Tag {
		case ValueStringStringValue:
			return value.StringValue1
		default: // ValueStringPair
			value = value.Pair0
			continue
		}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
