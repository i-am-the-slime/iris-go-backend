// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	result := *array.Thaw([]int{1, 2, 3})
	size := len(result)
	for i := 0; i < size; i++ {
		var i2 int
		if i < len(result) {
			i2 = result[i]
			result[i] = i2 * 2
		} else {
			i2 = 0
		}
	}
	performed := shared.Frozen(result)
	result2 := *array.Thaw([]int{4, 5, 6})
	size2 := len(result2)
	for i := 1; i < size2; i++ {
		within := i < len(result2)
		var i2 int
		if within {
			i2 = result2[i]
		} else {
			i2 = 0
		}
		index := i - 1
		if index < len(result2) {
			result2[index] = i2
		}
	}
	performed2 := shared.Frozen(result2)
	size3 := len(performed)
	return array.Append(performed, array.Append(performed2, []int{mainGo(performed, size3, 0, 0)}))
}

func mainGo(doubled []int, size int, i int, total int) int {
	for {
		if i >= size {
			return total
		}
		var result int
		result = doubled[i]
		i, total = i+1, total+result
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
