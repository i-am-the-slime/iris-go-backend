// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	array2 := *array.Thaw([]int32{1, 2, 3})()
	size := int32(len(array2))
	for i := int32(0); i < size; i++ {
		var i2 int32
		if int(i) < len(array2) {
			i2 = array2[i]
			array2[i] = i2 * 2
		} else {
			i2 = 0
		}
	}
	performed := shared.Frozen(array2)
	array3 := *array.Thaw([]int32{4, 5, 6})()
	size2 := int32(len(array3))
	for i := int32(1); i < size2; i++ {
		within := int(i) < len(array3)
		var i2 int32
		if within {
			i2 = array3[i]
		} else {
			i2 = 0
		}
		index := i - 1
		if int(index) < len(array3) {
			array3[index] = i2
		}
	}
	performed2 := shared.Frozen(array3)
	size3 := int32(len(performed))
	return array.Append(performed, array.Append(performed2, []int32{mainGo(performed, size3, 0, 0)}))
}

func mainGo(doubled []int32, size int32, i int32, total int32) int32 {
	for {
		if i >= size {
			return total
		}
		var result int32
		result = doubled[i]
		i, total = i+1, total+result
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
