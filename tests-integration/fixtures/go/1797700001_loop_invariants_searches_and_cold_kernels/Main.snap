// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

type String struct {
	Just string
	Tag  uint8
}

var NoString = String{Tag: TagNothing}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int) string {
	return strconv.Itoa(i)
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	numbers := arraypkg.Range(0, 40)
	found := maybe.NoInt
	for _, value := range numbers {
		n := value + 1
		if n&1 == 0 {
			found = maybe.JustInt(n)
			break
		}
	}
	var result string
	switch found.Tag {
	case maybe.TagJust:
		result = "(Just " + strconv.Itoa(found.Just) + ")"
	default: // maybe.TagNothing
		result = "Nothing"
	}
	found2 := maybe.NoString
	for _, value := range numbers {
		value2 := strconv.Itoa(value)
		word := value2 + "!"
		if word > "w5" {
			found2 = maybe.JustString(word)
			break
		}
	}
	var result2 string
	switch found2.Tag {
	case maybe.TagJust:
		result2 = "(Just " + prim.ShowString(found2.Just) + ")"
	default: // maybe.TagNothing
		result2 = "Nothing"
	}
	accumulator := 0.0
	for x := 1; x < 42; x++ {
		number := float64(x) * 0.5
		accumulator += number
	}
	first := prim.ShowNumber(accumulator / float64(41))
	first2 := show.ArrayInt(clamped(numbers))
	bound := []string{}
	array := []shared.Rule{{Name: "positive", Check: func(n int) bool {
		return n > 0
	}}, {Name: "small", Check: func(n int) bool {
		return n < 3
	}}}
	for n := 0; n < 5; n++ {
		for _, rule := range array {
			if rule.Check(n) {
				bound = append(bound, rule.Name)
			}
		}
	}
	first3 := show.ArrayString(bound)
	array2 := [][]int{{1}, {2}}
	count := 0
	for range array2 {
		for value := 1; value < 4; value++ {
			count += 1
		}
	}
	first4 := strconv.Itoa(count)
	array3 := []int{1, 2}
	built := []string{result, result2, first, first2, first3, first4}
	for _, round := range array3 {
		mapped := make([]int, len(numbers))
		for index, value := range numbers {
			mapped[index] = value * round
		}
		mapped2 := make([]int, len(numbers))
		for index, x := range numbers {
			result3 := max(x, 7)
			mapped2[index] = result3
		}
		built = append(built, []string{show.ArrayInt(clamped(mapped)), show.ArrayInt(mapped2)}...)
	}
	return built
}

func clamped(array []int) []int {
	mapped := make([]int, len(array))
	for index, x := range array {
		var result int
		if x < 2 {
			result = 2
		} else if x > 40 {
			result = 40
		} else {
			result = x
		}
		mapped[index] = result
	}
	return mapped
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Rule struct {
	Check func(int) bool
	Name  string
}
