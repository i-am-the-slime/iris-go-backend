// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

const TagNothing = 0

const TagJust = 1

type String struct {
	Just string
	Tag  uint8
}

var NoString = String{Tag: TagNothing}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int32) string {
	return strconv.Itoa(int(i))
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	numbers := arraypkg.RangeInt32(0, 40)
	found := maybe.NoInt
	for _, value := range numbers {
		n := value + 1
		if n&1 == 0 {
			found = maybe.Int(n)
			break
		}
	}
	var result string
	if found != maybe.NoInt {
		result = "(Just " + strconv.Itoa(int(int32(found))) + ")"
	} else {
		result = "Nothing"
	}
	found2 := maybe.NoString
	for _, value := range numbers {
		value2 := strconv.Itoa(int(value))
		word := value2 + "!"
		if word > "w5" {
			found2 = maybe.JustString(word)
			break
		}
	}
	var result2 string
	switch found2.Tag {
	case maybe.TagJust:
		result2 = "(Just " + prim.ShowString(found2.Just) + ")"
	default: // maybe.TagNothing
		result2 = "Nothing"
	}
	mapped := make([]float64, 41)
	for index := range 41 {
		x := 1 + int32(index)
		mapped[index] = float64(x) * 0.5
	}
	first := prim.ShowNumber(foldLanes(mapped, 0.0) / float64(41))
	first2 := show.ArrayInt(clamped(numbers))
	bound := []string{}
	array := []shared.Rule{{Name: "positive", Check: func(n int32) bool {
		return n > 0
	}}, {Name: "small", Check: func(n int32) bool {
		return n < 3
	}}}
	for n := int32(0); n < 5; n++ {
		for _, rule := range array {
			if rule.Check(n) {
				bound = append(bound, rule.Name)
			}
		}
	}
	first3 := show.ArrayString(arraypkg.Bounded(bound))
	array2 := [][]int32{{1}, {2}}
	var count int32 = 0
	for range array2 {
		for value := int32(1); value < 4; value++ {
			count += 1
		}
	}
	first4 := strconv.Itoa(int(count))
	array3 := []int32{1, 2}
	built := []string{result, result2, first, first2, first3, first4}
	for _, round := range array3 {
		built = append(built, []string{show.ArrayInt(clamped(mapLanes(numbers, round))), show.ArrayInt(mapLanes2(numbers))}...)
	}
	return built
}

func clamped(array []int32) []int32 {
	return mapLanes3(array)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"math"
	"simd/archsimd"
)

func foldLanes(xs []float64, initial float64) float64 {
	acc0 := archsimd.BroadcastFloat64x2(math.Copysign(0, -1))
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadFloat64x2(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadFloat64x2(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadFloat64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadFloat64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [2]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

func mapLanes(xs []int32, round int32) []int32 {
	roundLanes := archsimd.BroadcastInt32x4(round)
	out := make([]int32, len(xs))
	const step = 4
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadInt32x4(xs[i : i+step])
		x.Mul(roundLanes).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadInt32x4Part(xs[i:])
		x.Mul(roundLanes).StorePart(out[i:])
	}
	return out
}

func mapLanes2(xs []int32) []int32 {
	c0 := archsimd.BroadcastInt32x4(7)
	out := make([]int32, len(xs))
	const step = 4
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadInt32x4(xs[i : i+step])
		x.Max(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadInt32x4Part(xs[i:])
		x.Max(c0).StorePart(out[i:])
	}
	return out
}

func mapLanes3(xs []int32) []int32 {
	c0 := archsimd.BroadcastInt32x4(2)
	c1 := archsimd.BroadcastInt32x4(40)
	out := make([]int32, len(xs))
	const step = 4
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadInt32x4(xs[i : i+step])
		c0.IfElse(x.Less(c0), x.Min(c1)).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadInt32x4Part(xs[i:])
		c0.IfElse(x.Less(c0), x.Min(c1)).StorePart(out[i:])
	}
	return out
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []float64, initial float64) float64 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

func mapLanes(xs []int32, round int32) []int32 {
	out := make([]int32, len(xs))
	for i, x := range xs {
		out[i] = x * round
	}
	return out
}

func mapLanes2(xs []int32) []int32 {
	out := make([]int32, len(xs))
	for i, x := range xs {
		out[i] = max(x, 7)
	}
	return out
}

func mapLanes3(xs []int32) []int32 {
	out := make([]int32, len(xs))
	for i, x := range xs {
		out[i] = min(max(x, 2), 40)
	}
	return out
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"math"
	"simd"
)

func foldLanes(xs []float64, initial float64) float64 {
	acc0 := simd.BroadcastFloat64s(math.Copysign(0, -1))
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadFloat64s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadFloat64s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadFloat64s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadFloat64s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [8]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

func mapLanes(xs []int32, round int32) []int32 {
	roundLanes := simd.BroadcastInt32s(round)
	out := make([]int32, len(xs))
	step := simd.Int32s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadInt32s(xs[i : i+step])
		x.Mul(roundLanes).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadInt32sPart(xs[i:])
		x.Mul(roundLanes).StorePart(out[i:])
	}
	return out
}

func mapLanes2(xs []int32) []int32 {
	c0 := simd.BroadcastInt32s(7)
	out := make([]int32, len(xs))
	step := simd.Int32s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadInt32s(xs[i : i+step])
		x.Max(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadInt32sPart(xs[i:])
		x.Max(c0).StorePart(out[i:])
	}
	return out
}

func mapLanes3(xs []int32) []int32 {
	c0 := simd.BroadcastInt32s(2)
	c1 := simd.BroadcastInt32s(40)
	out := make([]int32, len(xs))
	step := simd.Int32s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadInt32s(xs[i : i+step])
		c0.IfElse(x.Less(c0), x.Min(c1)).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadInt32sPart(xs[i:])
		c0.IfElse(x.Less(c0), x.Min(c1)).StorePart(out[i:])
	}
	return out
}

// shared/shared.go
package shared

type Rule struct {
	Check func(int32) bool
	Name  string
}
