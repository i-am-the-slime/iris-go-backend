// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

func ArrayNumber(array []float64) string {
	return string(AppendShowArrayNumber(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array2 := array.Thaw([]float64{1.0, 2.0, 3.0})
	elements := *array2
	for i := 0; i < 3; i++ {
		within := i < len(elements)
		if within {
			element := elements[i]
			elements[i] = element + mainToNumber(i)
		}
	}
	within2 := len(*array2) > 7
	if within2 {
		element := (*array2)[7]
		(*array2)[7] = element + 1.0
	}
	within3 := len(*array2) > 1
	if within3 {
		element := (*array2)[1]
		(*array2)[1] = element + 1.0
	}
	*array2 = append(*array2, 0.0)
	within4 := len(*array2) > 1
	if within4 {
		element := (*array2)[1]
		(*array2)[1] = element + 1.0
	}
	smooth(*array2, 1)
	smooth(*array2, 2)
	within5 := len(*array2) > 9
	var edge float64
	if within5 {
		edge = (*array2)[9]
	} else {
		edge = 0.0
	}
	*array2 = append(*array2, 9.0)
	var number float64
	number = (*array2)[0]
	*array2 = append(*array2, 10.0)
	i2 := len(*array2)
	i3 := i2 - 1
	var number2 float64
	number2 = (*array2)[i3]
	frozen := shared.Copied(*array2)
	return array.Append([]string{show.ArrayNumber(frozen), prim.ShowNumber(edge), prim.ShowNumber(number + number2)}, array.Append(pull, array.Append(countBefore, sortEach)))
}

func smooth(array []float64, i int) {
	i2 := i - 1
	within := i2 < len(array)
	var left float64
	if within {
		left = array[i2]
	} else {
		left = 0.0
	}
	within2 := i < len(array)
	var here float64
	if within2 {
		here = array[i]
	} else {
		here = 0.0
	}
	i3 := i + 1
	within3 := i3 < len(array)
	var right float64
	if within3 {
		right = array[i3]
	} else {
		right = 0.0
	}
	average := (left + here + right) / 3.0
	i4 := i - 1
	within4 := i4 < len(array)
	if within4 {
		element := array[i4]
		array[i4] = element + (average-left)*0.5
	}
	within5 := i < len(array)
	if within5 {
		element := array[i]
		array[i] = element + (average-here)*0.5
	}
	i5 := i + 1
	within6 := i5 < len(array)
	if within6 {
		element := array[i5]
		array[i5] = element + (average-right)*0.5
	}
	i6 := i + 2
	within7 := i6 < len(array)
	var edge float64
	if within7 {
		edge = array[i6]
	} else {
		edge = 0.0
	}
	if !(edge <= average) {
		i7 := i + 2
		within8 := i7 < len(array)
		if within8 {
			element := array[i7]
			array[i7] = element + (average - edge)
		}
	}
}

var pull = initializePull()

func initializePull() []string {
	array2 := *array.Thaw([]float64{0.0, 1.0, 3.0})
	array3 := *array.Thaw([]float64{0.0, 2.0, -1.0})
	array4 := *array.Thaw([]float64{0.0, 0.0, 0.0})
	array5 := *array.Thaw([]float64{0.0, 0.5, 0.0})
	array6 := *array.Thaw([]float64{2.0, 1.0, 0.5})
	for ignored := 0; ignored < 3; ignored++ {
		for i := 0; i < 3; i++ {
			for j := 0; j < 3; j++ {
				if i != j {
					within := j < len(array2)
					var number float64
					if within {
						number = array2[j]
					} else {
						number = 0.0
					}
					within2 := i < len(array2)
					var number2 float64
					if within2 {
						number2 = array2[i]
					} else {
						number2 = 0.0
					}
					within3 := j < len(array3)
					var number3 float64
					if within3 {
						number3 = array3[j]
					} else {
						number3 = 0.0
					}
					within4 := i < len(array3)
					var number4 float64
					if within4 {
						number4 = array3[i]
					} else {
						number4 = 0.0
					}
					within5 := j < len(array6)
					var number5 float64
					if within5 {
						number5 = array6[j]
					} else {
						number5 = 0.0
					}
					within6 := i < len(array4)
					if within6 {
						element := array4[i]
						array4[i] = element + (number-number2)*number5*0.125
					}
					within7 := i < len(array5)
					if within7 {
						element := array5[i]
						array5[i] = element + (number3-number4)*number5*0.125
					}
				}
			}
		}
		for i := 0; i < 3; i++ {
			within := i < len(array4)
			var number float64
			if within {
				number = array4[i]
			} else {
				number = 0.0
			}
			within2 := i < len(array2)
			if within2 {
				element := array2[i]
				array2[i] = element + 0.5*number
			}
			within3 := i < len(array5)
			var number2 float64
			if within3 {
				number2 = array5[i]
			} else {
				number2 = 0.0
			}
			within4 := i < len(array3)
			if within4 {
				element := array3[i]
				array3[i] = element + 0.5*number2
			}
		}
	}
	array7 := shared.Copied(array2)
	array8 := shared.Copied(array3)
	return []string{show.ArrayNumber(array7), show.ArrayNumber(array8)}
}

var countBefore = initializeCountBefore()

func initializeCountBefore() []string {
	words := *array.Thaw([]string{"pear", "apple", "fig"})
	counts := *array.Thaw([]int{0, 0, 0})
	for i := 0; i < 3; i++ {
		for j := 0; j < 3; j++ {
			within := i < len(words)
			var s string
			if within {
				s = words[i]
			} else {
				s = ""
			}
			within2 := j < len(words)
			var s2 string
			if within2 {
				s2 = words[j]
			} else {
				s2 = ""
			}
			if prim.CompareString(s2, s) < 0 {
				within3 := i < len(counts)
				if within3 {
					element := counts[i]
					counts[i] = element + 1
				}
			}
		}
	}
	frozen := shared.Copied(counts)
	return []string{show.ArrayInt(frozen)}
}

var sortEach = initializeSortEach()

func initializeSortEach() []string {
	array2 := array.Thaw([]int{3, 1, 2})
	array3 := *array.Thaw([]int{0, 0})
	for i := 0; i < 2; i++ {
		direct.SortByMutable(array2, func(a int, b int) int {
			i2 := b + i
			var result ordering.Ordering
			if i2 < a {
				result = ordering.OrderingLT
			} else if i2 == a {
				result = ordering.OrderingEQ
			} else {
				result = ordering.OrderingGT
			}
			switch result {
			case ordering.OrderingLT:
				return -1
			case ordering.OrderingGT:
				return 1
			}
			return 0
		})
		within := len(*array2) > 0
		var first int
		if within {
			first = (*array2)[0]
		} else {
			first = 0
		}
		within2 := i < len(array3)
		if within2 {
			element := array3[i]
			array3[i] = element + first
		}
	}
	sorted := shared.Copied(*array2)
	bumped := shared.Copied(array3)
	return []string{show.ArrayInt(sorted), show.ArrayInt(bumped)}
}

func mainToNumber(i int) float64 {
	if i == 0 {
		return 0.0
	}
	return 1.0 + mainToNumber(i-1)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Copied[T any](elements []T) []T {
	copied := make([]T, len(elements))
	copy(copied, elements)
	return copied
}
