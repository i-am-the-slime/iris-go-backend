// Control/Category/category.go
package category

func Identity(x int) int {
	return x
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/lazy"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	array := []func(int) int{chain(2, category.Identity), chain(3, category.Identity)}
	accumulator := 0
	for _, k := range array {
		accumulator += k(1)
	}
	return shared.MainResult{Summed: accumulator, Memoised: lazy.Defer(func() int {
		return thunks(3, func(_ struct{}) int {
			return 0
		})(struct{}{})
	}).Force()}
}

func chain(n int, k func(int) int) func(int) int {
	for {
		kCaptured := k
		switch n {
		case 0:
			return kCaptured
		default:
			n, k = n-1, func(x int) int {
				return kCaptured(x + 1)
			}
			continue
		}
	}
}

func thunks(n int, t func(struct{}) int) func(struct{}) int {
	for {
		tCaptured := t
		switch n {
		case 0:
			return tCaptured
		default:
			n, t = n-1, func(_ struct{}) int {
				return tCaptured(struct{}{}) + 1
			}
			continue
		}
	}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Memoised int
	Summed   int
}

// note: the entry's value of type { memoised, summed } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
