// Control/Category/category.go
package category

type IntToInt struct {
	K   *IntToInt
	Tag uint8
}

const (
	IntToIntIdentityFn = iota
	IntToIntChain
)

var SharedIntToIntIdentityFn = &IntToInt{Tag: IntToIntIdentityFn}

func RunIntToInt(function *IntToInt, x int) int {
	for {
		switch function.Tag {
		case IntToIntIdentityFn:
			return x
		default: // IntToIntChain
			k := function.K
			function, x = k, x+1
			continue
		}
	}
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/lazy"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	return shared.MainResult{Summed: category.RunIntToInt(chain(2, category.SharedIntToIntIdentityFn), 1) + category.RunIntToInt(chain(3, category.SharedIntToIntIdentityFn), 1), Memoised: lazy.Defer(func() int {
		return thunks(3, func(_ struct{}) int {
			return 0
		})(struct{}{})
	}).Force()}
}

func chain(n int, k *category.IntToInt) *category.IntToInt {
	var intToIntCells alloc.Cells[category.IntToInt]
	for {
		switch n {
		case 0:
			return k
		default:
			n, k = n-1, intToIntCells.New(category.IntToInt{Tag: category.IntToIntChain, K: k})
			continue
		}
	}
}

func thunks(n int, t func(struct{}) int) func(struct{}) int {
	for {
		tCaptured := t
		switch n {
		case 0:
			return tCaptured
		default:
			n, t = n-1, func(_ struct{}) int {
				return tCaptured(struct{}{}) + 1
			}
			continue
		}
	}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Memoised int
	Summed   int
}

// note: the entry's value of type { memoised, summed } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
