// Control/Category/category.go
package category

func Identity(x int32) int32 {
	return x
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/lazy"
)

type MainResult struct {
	Memoised int32
	Summed   int32
}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	array2 := []func(int32) int32{chain(2, category.Identity), chain(3, category.Identity)}
	var accumulator int32 = 0
	for _, k := range array2 {
		total := accumulator
		accumulator = total + k(1)
	}
	return MainResult{Summed: accumulator, Memoised: lazy.Defer(func() int32 {
		return thunks(3, func(_ struct{}) int32 {
			return 0
		})(struct{}{})
	}).Force()}
}

func chain(argument0 int32, argument1 func(int32) int32) func(int32) int32 {
	for {
		argument1Captured := argument1
		switch argument0 {
		case 0:
			return argument1Captured
		default:
			n := argument0
			argument0, argument1 = n - 1, func(x int32) int32 {
				return argument1Captured(x + 1)
			}
			continue
		}
	}
}

func thunks(argument0 int32, argument1 func(struct{}) int32) func(struct{}) int32 {
	for {
		argument1Captured := argument1
		switch argument0 {
		case 0:
			return argument1Captured
		default:
			n := argument0
			argument0, argument1 = n - 1, func(_ struct{}) int32 {
				return argument1Captured(struct{}{}) + 1
			}
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
