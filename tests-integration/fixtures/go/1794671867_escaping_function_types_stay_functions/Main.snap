// Control/Category/category.go
package category

func Identity(x int32) int32 {
	return x
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/lazy"
)

type MainResult struct {
	Memoised int32
	Summed   int32
}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	defer exception.ReportUncaught()
	array := []func(int32) int32{chain(2, category.Identity), chain(3, category.Identity)}
	var accumulator int32 = 0
	for _, k := range array {
		total := accumulator
		accumulator = total + k(1)
	}
	return MainResult{Summed: accumulator, Memoised: lazy.Defer(func() int32 {
		return thunks(3, func(_ struct{}) int32 {
			return 0
		})(struct{}{})
	}).Force()}
}

func chain(n int32, k func(int32) int32) func(int32) int32 {
	for {
		kCaptured := k
		switch n {
		case 0:
			return kCaptured
		default:
			n2 := n
			n, k = n2 - 1, func(x int32) int32 {
				return kCaptured(x + 1)
			}
			continue
		}
	}
}

func thunks(n int32, t func(struct{}) int32) func(struct{}) int32 {
	for {
		tCaptured := t
		switch n {
		case 0:
			return tCaptured
		default:
			n2 := n
			n, t = n2 - 1, func(_ struct{}) int32 {
				return tCaptured(struct{}{}) + 1
			}
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
