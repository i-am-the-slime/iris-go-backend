// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	return shared.MainResult{Depth: depth(0, 30), Letters: a(7, "")}
}

func depthOrBranch(step int, acc int32, n int32) int32 {
	for {
		switch step {
		case shared.DepthStep:
			if n <= 0 {
				return acc
			}
			if n%2 == 0 {
				step = shared.BranchStep
				continue
			}
			acc, n = acc+1, n-1
		default: // shared.BranchStep
			step, acc, n = shared.DepthStep, acc+depth(0, prim.IntDiv(n, 4)), n-1
		}
	}
}

func depth(acc int32, n int32) int32 {
	return depthOrBranch(shared.DepthStep, acc, n)
}

func aGroup(step int, n int32, s string) string {
	for {
		switch step {
		case shared.AStep:
			if n <= 0 {
				return s
			}
			step, n, s = shared.BStep, n-1, s+"a"
		case shared.BStep:
			if n <= 0 {
				return s
			}
			step, s, n = shared.CStep, strconv.Itoa(int(n)), n-1
		default: // shared.CStep
			step, s = shared.AStep, s+"c"
		}
	}
}

func a(n int32, s string) string {
	return aGroup(shared.AStep, n, s)
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Letters string
	Depth   int32
}

const (
	DepthStep = iota
	BranchStep
)

const (
	AStep = iota
	BStep
	CStep
)

// note: the entry's value of type { depth, letters } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
