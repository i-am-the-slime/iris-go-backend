// main.go
package main

import (
	journal "fixture/Journal_ffi"
	"strconv"
)

type Problem struct {
	Field0 int32
	Tag    uint8
}

const (
	ProblemNegative = iota
	ProblemTooLarge
)

type Either struct {
	Left  Problem
	Right int32
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type ProblemFailure struct {
	Failed bool
	Left   Problem
}

func Negative(field0 int32) Problem {
	return Problem{Tag: ProblemNegative, Field0: field0}
}

func TooLarge(field0 int32) Problem {
	return Problem{Tag: ProblemTooLarge, Field0: field0}
}

func Left(left Problem) Either {
	return Either{Tag: EitherLeft, Left: left}
}

func main() {
	s := settleRight("run 5", 15)
	journal.Log(s)
	s2 := settleLeft("run -2", Negative(-2))
	journal.Log(s2)
	s3 := settleLeft("run 2000", TooLarge(2000))
	journal.Log(s3)
	s4 := settleRight("run 40", 120)
	journal.Log(s4)
	i, err := kept(30)
	if err.Failed {
		s5 := settleLeft("kept", err.Left)
		journal.Log(s5)
	} else {
		s5 := settleRight("kept", i)
		journal.Log(s5)
	}
	i2, err := kept(2)
	var result string
	if err.Failed {
		var result2 string
		switch err.Left.Tag {
		case ProblemNegative:
			result2 = "Negative " + strconv.Itoa(int(err.Left.Field0))
		default: // ProblemTooLarge
			result2 = "TooLarge " + strconv.Itoa(int(err.Left.Field0))
		}
		result = "(Left " + result2 + ")"
	} else {
		result = "(Right " + strconv.Itoa(int(i2)) + ")"
	}
	journal.Log(result)
}

func kept(n int32) (int32, ProblemFailure) {
	if n < 0 {
		return 0, ProblemFailure{Failed: true, Left: Negative(n)}
	}
	if n > 1000 {
		return 0, ProblemFailure{Failed: true, Left: TooLarge(n)}
	}
	field := n * 3
	journal.Log("checked " + strconv.Itoa(int(field)))
	n2 := field - 50
	if n2 < 0 {
		return 0, ProblemFailure{Failed: true, Left: Negative(n2)}
	}
	if n2 > 1000 {
		return 0, ProblemFailure{Failed: true, Left: TooLarge(n2)}
	}
	return field+n2*3, ProblemFailure{}
}

func settleRight(label string, value int32) string {
	if value > 100 {
		return settleLeft(label+" again", TooLarge(value))
	}
	journal.Log(label + ": " + strconv.Itoa(int(value)))
	return "ok"
}

func settleLeft(label string, problem Problem) string {
	for {
		scrutinee := Left(problem)
		if scrutinee.Tag == EitherLeft && scrutinee.Left.Tag == ProblemNegative {
			journal.Log(label + ": below zero by " + strconv.Itoa(int(-scrutinee.Left.Field0)))
			return "negative"
		}
		if scrutinee.Tag == EitherLeft {
			var result string
			switch scrutinee.Left.Tag {
			case ProblemNegative:
				result = "Negative " + strconv.Itoa(int(scrutinee.Left.Field0))
			default: // ProblemTooLarge
				result = "TooLarge " + strconv.Itoa(int(scrutinee.Left.Field0))
			}
			journal.Log(label + ": " + result)
			return "failed"
		}
		value := scrutinee.Right
		if value > 100 {
			label, problem = label+" again", TooLarge(value)
			continue
		}
		journal.Log(label + ": " + strconv.Itoa(int(value)))
		return "ok"
	}
}
