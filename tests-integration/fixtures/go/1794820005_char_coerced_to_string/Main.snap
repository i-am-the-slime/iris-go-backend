// Data/Semigroup/semigroup.go
package semigroup

import "github.com/i-am-the-slime/iris-go/prim"

func Append_(s string, s2 string) string {
	return prim.Append(s, s2)
}

// main.go
package main

import (
	"fixture/Data/Semigroup"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
)

var main_ = initializeMain_()

func initializeMain_() string {
	array := shared.Convert([]rune{'a', 'b', 'c'})
	mapped := make([]string, len(array))
	for index, element := range array {
		mapped[index] = element
	}
	return arraypkg.Foldl1(semigroup.Append_, mapped)
}

func main() {
	console.Print(main_)
}

// shared/shared.go
package shared

import "github.com/i-am-the-slime/iris-go/prim"

func Convert(value []rune) []string {
	converted := make([]string, len(value))
	for index, element := range value {
		converted[index] = prim.CharSingleton(element)
	}
	return converted
}
