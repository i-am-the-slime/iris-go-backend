// Control/Category/category.go
package category

func Identity(x string) string {
	return x
}

// Data/Semigroup/semigroup.go
package semigroup

func Append_(s string, s2 string) string {
	return s + s2
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Semigroup"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

func convert(value []rune) []string {
	converted := []string{}
	for _, element := range value {
		converted = append(converted, prim.CharSingleton(element))
	}
	return converted
}

var main_ = initializeMain_()

func initializeMain_() string {
	array2 := convert(array.Append([]rune{'a'}, []rune{'b', 'c'}))
	mapped := make([]string, len(array2))
	for index, element := range array2 {
		mapped[index] = category.Identity(element)
	}
	return array.Foldl1(semigroup.Append_, mapped)
}

func main() {
	fmt.Println(main_)
}
