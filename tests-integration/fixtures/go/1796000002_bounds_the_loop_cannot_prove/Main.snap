// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	result := *array.Thaw([]int32{1, 2, 3})
	size := int32(len(result))
	end := size + 1
	for i := int32(0); i < end; i++ {
		var i2 int32
		if int(i) < len(result) {
			i2 = result[i]
			result[i] = i2 + 1
		} else {
			i2 = 0
		}
	}
	performed := shared.Frozen(result)
	result2 := *array.Thaw([]int32{1, 2, 3})
	size2 := int32(len(result2))
	for i := int32(0); i < size2; i++ {
		i2 := i - 1
		within := i2 >= 0 && int(i2) < len(result2)
		var previous int32
		if within {
			previous = result2[i2]
		} else {
			previous = 0
		}
		within2 := int(i) < len(result2)
		if within2 {
			element := result2[i]
			result2[i] = element + previous
		}
	}
	performed2 := shared.Frozen(result2)
	return array.Append(performed, performed2)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
