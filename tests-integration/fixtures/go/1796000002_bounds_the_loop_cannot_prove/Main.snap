// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	result := *array.Thaw([]int{1, 2, 3})
	size := len(result)
	end := size + 1
	for i := 0; i < end; i++ {
		var i2 int
		if i < len(result) {
			i2 = result[i]
			result[i] = i2 + 1
		} else {
			i2 = 0
		}
	}
	performed := shared.Frozen(result)
	result2 := *array.Thaw([]int{1, 2, 3})
	size2 := len(result2)
	for i := 0; i < size2; i++ {
		i2 := i - 1
		within := uint(i2) < uint(len(result2))
		var previous int
		if within {
			previous = result2[i2]
		} else {
			previous = 0
		}
		within2 := i < len(result2)
		if within2 {
			element := result2[i]
			result2[i] = element + previous
		}
	}
	performed2 := shared.Frozen(result2)
	return array.Append(performed, performed2)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
