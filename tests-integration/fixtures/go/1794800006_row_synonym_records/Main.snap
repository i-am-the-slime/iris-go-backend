// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type SpaceValue struct {
	Value string
	Space bool
}

type KindSpaceAfterSpaceBeforeValue struct {
	Value       string
	Kind        int32
	SpaceAfter  bool
	SpaceBefore bool
}

var main_ = initializeMain_()

func initializeMain_() string {
	defer exception.ReportUncaught()
	array := []KindSpaceAfterSpaceBeforeValue{KindSpaceAfterSpaceBeforeValue{SpaceBefore: false, SpaceAfter: true, Value: "a", Kind: 1}, KindSpaceAfterSpaceBeforeValue{SpaceBefore: true, SpaceAfter: false, Value: "b", Kind: 2}}
	accumulator := SpaceValue{Value: "", Space: false}
	for kindSpaceAfterSpaceBeforeValueIndex := range array {
		spaceValue := accumulator
		var result string
		if spaceValue.Space && array[kindSpaceAfterSpaceBeforeValueIndex].SpaceBefore {
			result = " "
		} else {
			result = ""
		}
		accumulator = SpaceValue{Value: prim.Concat(spaceValue.Value, result, array[kindSpaceAfterSpaceBeforeValueIndex].Value), Space: array[kindSpaceAfterSpaceBeforeValueIndex].SpaceAfter}
	}
	return accumulator.Value
}

func main() {
	fmt.Println(main_)
}
