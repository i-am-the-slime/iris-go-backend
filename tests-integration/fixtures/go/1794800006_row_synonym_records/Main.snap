// main.go
package main

import "fmt"

type SpaceValue struct {
	Space bool
	Value string
}

type KindSpaceAfterSpaceBeforeValue struct {
	Kind        int32
	SpaceAfter  bool
	SpaceBefore bool
	Value       string
}

var main_ = initializeMain_()

func initializeMain_() string {
	array := []KindSpaceAfterSpaceBeforeValue{KindSpaceAfterSpaceBeforeValue{SpaceBefore: false, SpaceAfter: true, Value: "a", Kind: 1}, KindSpaceAfterSpaceBeforeValue{SpaceBefore: true, SpaceAfter: false, Value: "b", Kind: 2}}
	accumulator := SpaceValue{Value: "", Space: false}
	for kindSpaceAfterSpaceBeforeValueIndex := range array {
		spaceValue := accumulator
		var result string
		if spaceValue.Space && array[kindSpaceAfterSpaceBeforeValueIndex].SpaceBefore {
			result = " "
		} else {
			result = ""
		}
		accumulator = SpaceValue{Value: spaceValue.Value + result + array[kindSpaceAfterSpaceBeforeValueIndex].Value, Space: array[kindSpaceAfterSpaceBeforeValueIndex].SpaceAfter}
	}
	return accumulator.Value
}

func main() {
	fmt.Println(main_)
}
