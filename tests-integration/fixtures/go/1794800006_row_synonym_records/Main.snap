// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() string {
	scrutinee := shared.SpaceValue{Value: "", Space: false}
	scrutineeValue := "a"
	scrutineeSpaceAfter := true
	scrutineeSpaceBefore := false
	var result string
	if scrutinee.Space && scrutineeSpaceBefore {
		result = " "
	} else {
		result = ""
	}
	scrutinee2 := shared.SpaceValue{Value: prim.Concat(scrutinee.Value, result, scrutineeValue), Space: scrutineeSpaceAfter}
	scrutineeValue2 := "b"
	scrutineeSpaceAfter2 := false
	scrutineeSpaceBefore2 := true
	var result2 string
	if scrutinee2.Space && scrutineeSpaceBefore2 {
		result2 = " "
	} else {
		result2 = ""
	}
	return (shared.SpaceValue{Value: prim.Concat(scrutinee2.Value, result2, scrutineeValue2), Space: scrutineeSpaceAfter2}).Value
}

func main() {
	console.Print(main_)
}

// shared/shared.go
package shared

type SpaceValue struct {
	Value string
	Space bool
}

type KindSpaceAfterSpaceBeforeValue struct {
	Value       string
	Kind        int
	SpaceAfter  bool
	SpaceBefore bool
}
