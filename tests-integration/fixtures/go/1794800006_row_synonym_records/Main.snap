// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() string {
	defer exception.ReportUncaught()
	array := []shared.KindSpaceAfterSpaceBeforeValue{{SpaceBefore: false, SpaceAfter: true, Value: "a", Kind: 1}, {SpaceBefore: true, SpaceAfter: false, Value: "b", Kind: 2}}
	accumulator := shared.SpaceValue{Value: "", Space: false}
	for kindSpaceAfterSpaceBeforeValueIndex := range array {
		var result string
		if accumulator.Space && array[kindSpaceAfterSpaceBeforeValueIndex].SpaceBefore {
			result = " "
		} else {
			result = ""
		}
		accumulator = shared.SpaceValue{Value: prim.Concat(accumulator.Value, result, array[kindSpaceAfterSpaceBeforeValueIndex].Value), Space: array[kindSpaceAfterSpaceBeforeValueIndex].SpaceAfter}
	}
	return accumulator.Value
}

func main() {
	console.Print(main_)
}

// shared/shared.go
package shared

type SpaceValue struct {
	Value string
	Space bool
}

type KindSpaceAfterSpaceBeforeValue struct {
	Value       string
	Kind        int32
	SpaceAfter  bool
	SpaceBefore bool
}
