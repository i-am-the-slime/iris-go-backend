// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main() {
	output := []int{}
	inputs := []int{-7, 123457, -1, 0}
	for _, i := range inputs {
		output = array.Append(output, []int{int(uint(i)>>1) % 10, int(uint(i)>>3) / 7, prim.IntModPositive(int(uint(i)>>0), 10)})
	}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State []int
	Value []int
}
