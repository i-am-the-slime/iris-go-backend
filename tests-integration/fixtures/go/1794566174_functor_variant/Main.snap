// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type VariantFRep struct {
	Map   func(func(any) any) func(any) any
	Type  string
	Value any
}

type SayInt struct {
	First  string
	Second int32
}

type Say struct {
	First  string
	Second any
	Origin any
}

func convert(value *Say) SayInt {
	if original, ok := value.Origin.(SayInt); ok {
		return original
	}
	return SayInt{First: value.First, Second: value.Second.(int32)}
}

type CountInt struct {
	Count func(int32) int32
}

type Count struct {
	Count  func(int32) any
	Origin any
}

func convert2(value *Count) CountInt {
	if original, ok := value.Origin.(CountInt); ok {
		return original
	}
	return CountInt{Count: func(coerced int32) int32 {
		return value.Count(coerced).(int32)
	}}
}

type Map_Type_ValueOfFnFnValueValueFnSaySaySayInt struct {
	Map   func(func(any) any) func(*Say) *Say
	Type  string
	Value SayInt
}

func convert3(value SayInt) *Say {
	return &Say{First: value.First, Second: value.Second, Origin: value}
}

func convert4(value Map_Type_ValueOfFnFnValueValueFnSaySaySayInt) VariantFRep {
	return VariantFRep{Map: func(coerced func(any) any) func(any) any {
		original := value.Map(coerced)
		return func(coerced2 any) any {
			return original(coerced2.(*Say))
		}
	}, Type: value.Type, Value: convert3(value.Value)}
}

type Map_Type_ValueOfFnFnValueValueFnCountCountCountInt struct {
	Map   func(func(any) any) func(*Count) *Count
	Type  string
	Value CountInt
}

func convert5(value CountInt) *Count {
	return &Count{Count: func(coerced int32) any {
		return value.Count(coerced)
	}, Origin: value}
}

func convert6(value Map_Type_ValueOfFnFnValueValueFnCountCountCountInt) VariantFRep {
	return VariantFRep{Map: func(coerced func(any) any) func(any) any {
		original := value.Map(coerced)
		return func(coerced2 any) any {
			return original(coerced2.(*Count))
		}
	}, Type: value.Type, Value: convert5(value.Value)}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	original := func(value int32) int32 {
		return prim.MultiplyInt32(value, 10)
	}
	original2 := func(value int32) int32 {
		return prim.MultiplyInt32(value, 10)
	}
	return []string{describe(say), describe(count), describe(VariantFRep{Type: say.Type, Value: say.Map(func(coerced any) any {
		return original(coerced.(int32))
	})(say.Value), Map: say.Map}), describe(VariantFRep{Type: count.Type, Value: count.Map(func(coerced any) any {
		return original2(coerced.(int32))
	})(count.Value), Map: count.Map})}
}

func describe(r VariantFRep) string {
	if r.Type == "say" {
		scrutinee := convert(r.Value.(*Say))
		return scrutinee.First + " " + prim.ShowInt(scrutinee.Second)
	}
	if r.Type == "count" {
		scrutinee := convert2(r.Value.(*Count))
		return "count " + prim.ShowInt(scrutinee.Count(2))
	}
	panic("Data.Functor.Variant: pattern match failure [" + r.Type + "]")
}

var say VariantFRep = convert4(Map_Type_ValueOfFnFnValueValueFnSaySaySayInt{Type: "say", Value: SayInt{First: "hello", Second: 4}, Map: func(f func(any) any) func(*Say) *Say {
	return func(say *Say) *Say {
		return map_(f, say)
	}
}})

var count VariantFRep = convert6(Map_Type_ValueOfFnFnValueValueFnCountCountCountInt{Type: "count", Value: CountInt{Count: func(value int32) int32 {
	return value + 1
}}, Map: func(f func(any) any) func(*Count) *Count {
	return func(count *Count) *Count {
		return map_2(f, count)
	}
}})

func map_(f func(any) any, say *Say) *Say {
	return &Say{First: say.First, Second: f(say.Second)}
}

func map_2(f func(any) any, count *Count) *Count {
	return &Count{Count: func(x int32) any {
		return f(count.Count(x))
	}}
}

func main() {
	fmt.Println(main_)
}
