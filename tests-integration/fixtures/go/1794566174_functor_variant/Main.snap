// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type SayInt struct {
	First  string
	Second int32
}

type Say struct {
	First  string
	Second any
	Origin any
}

func convert(value *Say) SayInt {
	if original, ok := value.Origin.(SayInt); ok {
		return original
	}
	return SayInt{First: value.First, Second: value.Second.(int32)}
}

type CountInt struct {
	Count func(int32) int32
}

type Count struct {
	Count  func(int32) any
	Origin any
}

func convert2(value *Count) CountInt {
	if original, ok := value.Origin.(CountInt); ok {
		return original
	}
	return CountInt{Count: func(coerced int32) int32 {
		return value.Count(coerced).(int32)
	}}
}

type MapTypeValueOfFnFnValueValueFnSaySaySayInt struct {
	Map   func(func(any) any) func(*Say) *Say
	Type  string
	Value SayInt
}

func convert3(value SayInt) *Say {
	return &Say{First: value.First, Second: value.Second, Origin: value}
}

func convert4(value MapTypeValueOfFnFnValueValueFnSaySaySayInt) shared.VariantFRep {
	return shared.VariantFRep{Map: func(coerced func(any) any) func(any) any {
		original := value.Map(coerced)
		return func(coerced2 any) any {
			return original(coerced2.(*Say))
		}
	}, Type: value.Type, Value: convert3(value.Value)}
}

type MapTypeValueOfFnFnValueValueFnCountCountCountInt struct {
	Map   func(func(any) any) func(*Count) *Count
	Type  string
	Value CountInt
}

func convert5(value CountInt) *Count {
	return &Count{Count: func(coerced int32) any {
		return value.Count(coerced)
	}, Origin: value}
}

func convert6(value MapTypeValueOfFnFnValueValueFnCountCountCountInt) shared.VariantFRep {
	return shared.VariantFRep{Map: func(coerced func(any) any) func(any) any {
		original := value.Map(coerced)
		return func(coerced2 any) any {
			return original(coerced2.(*Count))
		}
	}, Type: value.Type, Value: convert5(value.Value)}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{describe(say), describe(count), describe(shared.VariantFRep{Type: say.Type, Value: say.Map(func(coerced any) any {
		return coerced.(int32) * 10
	})(say.Value), Map: say.Map}), describe(shared.VariantFRep{Type: count.Type, Value: count.Map(func(coerced any) any {
		return coerced.(int32) * 10
	})(count.Value), Map: count.Map})}
}

func describe(r shared.VariantFRep) string {
	if r.Type == "say" {
		scrutinee := convert(r.Value.(*Say))
		return scrutinee.First + " " + strconv.Itoa(int(scrutinee.Second))
	}
	if r.Type == "count" {
		scrutinee := convert2(r.Value.(*Count))
		return "count " + strconv.Itoa(int(scrutinee.Count(2)))
	}
	panic("Data.Functor.Variant: pattern match failure [" + r.Type + "]")
}

var say = initializeSay()

func initializeSay() shared.VariantFRep {
	return convert4(MapTypeValueOfFnFnValueValueFnSaySaySayInt{Type: "say", Value: SayInt{First: "hello", Second: 4}, Map: func(f func(any) any) func(*Say) *Say {
		return func(say *Say) *Say {
			return mapSay(f, say)
		}
	}})
}

var count = initializeCount()

func initializeCount() shared.VariantFRep {
	return convert6(MapTypeValueOfFnFnValueValueFnCountCountCountInt{Type: "count", Value: CountInt{Count: func(value int32) int32 {
		return value + 1
	}}, Map: func(f func(any) any) func(*Count) *Count {
		return func(count *Count) *Count {
			return mapCount(f, count)
		}
	}})
}

func mapSay(f func(any) any, say *Say) *Say {
	return &Say{First: say.First, Second: f(say.Second)}
}

func mapCount(f func(any) any, count *Count) *Count {
	return &Count{Count: func(x int32) any {
		return f(count.Count(x))
	}}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type VariantFRep struct {
	Map   func(func(any) any) func(any) any
	Type  string
	Value any
}
