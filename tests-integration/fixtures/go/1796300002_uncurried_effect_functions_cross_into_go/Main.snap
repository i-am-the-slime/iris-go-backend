// main.go
package main

import (
	routes "fixture/Routes_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main_() []string {
	seen := &shared.Ref[[]string]{Value: []string{}}
	routes.Call(func(first string, second string, _ routes.Reply) {
		mainRemember(seen, prim.Append(first, second))
	})
	function := func(prefix string) func(string) func(routes.Reply) {
		return func(text string) func(routes.Reply) {
			return func(_ routes.Reply) {
				mainRemember(seen, prim.Append(prefix, text))
			}
		}
	}
	routes.Serve(routes.Route{Path: "/hello", Handle: func(name string, body string, _ routes.Reply) {
		mainRemember(seen, name+": "+body)
	}, Done: func(path string) {
		mainRemember(seen, "done "+path)
	}, Prefixed: func(s string) func(string, routes.Reply) {
		return func(s2 string, reply routes.Reply) {
			function(s)(s2)(reply)
		}
	}})
	routes.BuiltIn.Handle("built", "in", routes.NoReply)
	updated := routes.BuiltIn
	updated.Handle = func(name string, _ string, _ routes.Reply) {
		mainRemember(seen, "updated "+name)
	}
	routes.Serve(updated)
	routes.BuiltIn.Done(routes.BuiltIn.Path)
	routes.BuiltIn.Prefixed("q")("y", routes.NoReply)
	routes.BuiltIn.Prefixed("r")("z", routes.NoReply)
	routes.BuiltIn.Handle("kept", "aside", routes.NoReply)
	scrutinee := routes.BuiltIn
	matched := func(s string) func(string) func(routes.Reply) {
		return func(s2 string) func(routes.Reply) {
			return func(reply routes.Reply) {
				scrutinee.Handle(s, s2, reply)
			}
		}
	}
	matched("matched")("too")(routes.NoReply)
	return seen.Value
}

func mainRemember(seen *shared.Ref[[]string], text string) {
	s := seen.Value
	s_ := array.Append(s, []string{text})
	seen.Value = s_
}

func main() {
	main_()
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State []string
	Value []string
}
