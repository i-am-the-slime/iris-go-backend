// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	bound := []string{}
	for _, value := range numbers {
		if value < 4 {
			for _, value2 := range numbers {
				if value2 > value {
					bound = append(bound, prim.ShowInt(value)+":"+prim.ShowInt(value2))
				}
			}
		}
	}
	var count int32 = 0
	for _, x := range numbers {
		for _, value := range numbers {
			if value < x {
				count += 1
			}
		}
	}
	bound2 := []int32{}
	for _, x := range numbers {
		for y := int32(1); y < 3; y++ {
			var result []int32
			if x > 4 {
				result = []int32{x * y}
			} else {
				result = []int32{}
			}
			bound2 = append(bound2, result...)
		}
	}
	var accumulator int32 = 0
	for value := int32(1); value < 11; value++ {
		value2 := value * 2
		accumulator += value2
	}
	mapped := make([]int32, len(numbers))
	for slot, value := range numbers {
		x := value + 1
		i := int32(slot)
		mapped[slot] = i*100 + x
	}
	mapped2 := []string{}
	for _, value := range numbers {
		x := value + 1
		if prim.IntMod(x, 2) == 0 {
			mapped2 = append(mapped2, prim.ShowInt(x))
		}
	}
	return shared.MainResult{Pairs: array.Bounded(bound), Below: count, Comprehension: array.Bounded(bound2), OverRange: accumulator, Indexed: mapped, Materialised: mapped2}
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	Comprehension []int32
	Indexed       []int32
	Materialised  []string
	Pairs         []string
	Below         int32
	OverRange     int32
}
