// main.go
package main

import (
	"fixture/shared"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	bound := []string{}
	for _, value := range numbers {
		if value < 4 {
			for _, value2 := range numbers {
				if value2 > value {
					bound = append(bound, strconv.Itoa(value)+":"+strconv.Itoa(value2))
				}
			}
		}
	}
	count := 0
	for _, x := range numbers {
		for _, value := range numbers {
			if value < x {
				count += 1
			}
		}
	}
	bound2 := []int{}
	for _, x := range numbers {
		for y := 1; y < 3; y++ {
			var result []int
			if x > 4 {
				result = []int{x * y}
			} else {
				result = []int{}
			}
			bound2 = append(bound2, result...)
		}
	}
	accumulator := 0
	for value := 1; value < 11; value++ {
		value2 := value * 2
		accumulator += value2
	}
	mapped := make([]int, len(numbers))
	for slot, value := range numbers {
		x := value + 1
		mapped[slot] = slot*100 + x
	}
	mapped2 := []string{}
	for _, value := range numbers {
		x := value + 1
		if x&1 == 0 {
			mapped2 = append(mapped2, strconv.Itoa(x))
		}
	}
	return shared.MainResult{Pairs: bound, Below: count, Comprehension: bound2, OverRange: accumulator, Indexed: mapped, Materialised: mapped2}
}

var numbers []int = []int{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Comprehension []int
	Indexed       []int
	Materialised  []string
	Pairs         []string
	Below         int
	OverRange     int
}

// note: the entry's value of type { below, comprehension, indexed, materialised, overRange, pairs } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
