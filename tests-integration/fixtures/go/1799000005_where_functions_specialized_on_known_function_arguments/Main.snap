// main.go
package main

import "strconv"

func main_() []string {
	return []string{strconv.Itoa(mainSumOf(1000, 0, 0)), strconv.Itoa(mainSumOfF(1000, 0, 0)), strconv.Itoa(mainGo(0, 0))}
}

func mainSumOf(count int, index int, total int) int {
	for {
		if index >= count {
			return total
		}
		index, total = index+1, total+index*3
	}
}

func mainSumOfF(count int, index int, total int) int {
	for {
		if index >= count {
			return total
		}
		index, total = index+1, total+index+7
	}
}

func mainGo(index int, total int) int {
	for {
		if index >= 1000 {
			return total
		}
		index, total = index+1, total+index*5
	}
}

func main() {
	main_()
}
