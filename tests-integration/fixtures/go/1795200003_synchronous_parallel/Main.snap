// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type Either struct {
	Right struct{}
	Left  exception.Error
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type OnComplete struct {
	Handler func(func(Either))
	Rethrow bool
}

func Left(left exception.Error) Either {
	return Either{Tag: EitherLeft, Left: left}
}

func Right(right struct{}) Either {
	return Either{Tag: EitherRight, Right: right}
}

// Effect/Aff/aff.go
package effectaff

import (
	"fixture/Data/Either"
	"github.com/i-am-the-slime/iris-go/exception"
)

type Fiber struct {
	IsSuspended func() bool
	Join        func(func(either.Either)) func()
	Kill        func(exception.Error) func(func(either.Either)) func()
	OnComplete  func(either.OnComplete) func()
	Run         func()
}

// main.go
package main

import (
	"fixture/Data/Either"
	"github.com/i-am-the-slime/iris-go/aff"
	"github.com/i-am-the-slime/iris-go/eventloop"
	"github.com/i-am-the-slime/iris-go/exception"
)

func main() {
	defer eventloop.Await()
	fiber := aff.NewFiber(func() struct{} {
		array := []int{1, 2, 3}
		collected := make([]int, len(array))
		for index, x := range array {
			value := x * x
			collected[index] = value
		}
		array2 := aff.TraverseParArrayDirect(func(x int) int {
			aff.DelayDirect(nil, 1.0)
			return x + 10
		}, []int{1, 2})
		i := 12
		accumulator := 0
		for _, value := range collected {
			accumulator += value
		}
		accumulator2 := 0
		for _, value := range array2 {
			accumulator2 += value
		}
		n := accumulator + accumulator2 + i
		array3 := []func() int{func() int {
			return n
		}, func() int {
			return n + 1
		}}
		collected2 := make([]int, len(array3))
		for index, x := range array3 {
			value := x()
			collected2[index] = value
		}
		return struct{}{}
	})
	_, _, _, _, run := aff.FiberFields(fiber, func(payload exception.Error) either.Either {
		return either.Left(payload)
	}, func(payload struct{}) either.Either {
		return either.Right(payload)
	}, either.Right(struct{}{}), func(value either.OnComplete) func(func(either.Either)) {
		return value.Handler
	})
	run()
}
