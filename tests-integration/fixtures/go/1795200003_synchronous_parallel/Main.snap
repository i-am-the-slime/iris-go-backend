// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type Either struct {
	Right struct{}
	Left  exception.Error
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type OnComplete struct {
	Handler func(func(Either))
	Rethrow bool
}

type Fiber struct {
	IsSuspended func() bool
	Join        func(func(Either)) func()
	Kill        func(exception.Error) func(func(Either)) func()
	OnComplete  func(OnComplete) func()
	Run         func()
}

func Left(left exception.Error) Either {
	return Either{Tag: EitherLeft, Left: left}
}

func Right(right struct{}) Either {
	return Either{Tag: EitherRight, Right: right}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"github.com/i-am-the-slime/iris-go/aff"
	"github.com/i-am-the-slime/iris-go/eventloop"
	"github.com/i-am-the-slime/iris-go/exception"
)

func main() {
	defer eventloop.Await()
	fiber := aff.NewFiber(func() struct{} {
		array := []int32{1, 2, 3}
		collected := make([]int32, len(array))
		for index, x := range array {
			value := x * x
			collected[index] = value
		}
		array2 := aff.TraverseParArrayDirect(func(x int32) int32 {
			aff.DelayDirect(nil, 1.0)
			return x + 10
		}, []int32{1, 2})
		var i int32 = 12
		n := foldLanes(collected, 0) + foldLanes(array2, 0) + i
		array3 := []func() int32{func() int32 {
			return n
		}, func() int32 {
			return n + 1
		}}
		collected2 := make([]int32, len(array3))
		for index, x := range array3 {
			value := x()
			collected2[index] = value
		}
		return struct{}{}
	})
	_, _, _, _, run := aff.FiberFields(fiber, func(payload exception.Error) either.Either {
		return either.Left(payload)
	}, func(payload struct{}) either.Either {
		return either.Right(payload)
	}, either.Right(struct{}{}), func(value either.OnComplete) func(func(either.Either)) {
		return value.Handler
	})
	run()
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := archsimd.BroadcastInt32x4(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 4
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt32x4(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt32x4(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt32x4(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt32x4(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [4]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int32, initial int32) int32 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
