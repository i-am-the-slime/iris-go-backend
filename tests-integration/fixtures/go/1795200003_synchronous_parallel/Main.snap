// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type EitherErrorUnit struct {
	Right struct{}
	Left  exception.Error
	Tag   uint8
}

const (
	EitherErrorUnitLeft = iota
	EitherErrorUnitRight
)

type OnComplete struct {
	Handler func(func(EitherErrorUnit))
	Rethrow bool
}

type Fiber struct {
	IsSuspended func() bool
	Join        func(func(EitherErrorUnit)) func()
	Kill        func(exception.Error) func(func(EitherErrorUnit)) func()
	OnComplete  func(OnComplete) func()
	Run         func()
}

// main.go
package main

import (
	"fixture/Data/Either"
	"github.com/i-am-the-slime/iris-go/aff"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/eventloop"
	"github.com/i-am-the-slime/iris-go/exception"
)

func main() {
	defer eventloop.Await()
	fiber2 := aff.NewFiber(func() struct{} {
		func() {
			array := direct.TraverseArray(func(x int32) int32 {
				return x * x
			}, []int32{1, 2, 3})
			array2 := aff.TraverseParArrayDirect(func(x int32) int32 {
				aff.DelayDirect(nil, 1.0)
				return x + 10
			}, []int32{1, 2})
			var i int32 = 12
			n := foldLanes(array, 0) + foldLanes(array2, 0) + i
			direct.TraverseArray(func(x func() int32) int32 {
				return x()
			}, []func() int32{func() int32 {
				return n
			}, func() int32 {
				return n + 1
			}})
		}()
		return struct{}{}
	})
	isSuspended, join, kill, onComplete, run := aff.FiberFields(fiber2, func(payload exception.Error) either.EitherErrorUnit {
		return either.EitherErrorUnit{Tag: either.EitherErrorUnitLeft, Left: payload}
	}, func(payload struct{}) either.EitherErrorUnit {
		return either.EitherErrorUnit{Tag: either.EitherErrorUnitRight, Right: payload}
	}, either.EitherErrorUnit{Tag: either.EitherErrorUnitRight, Right: struct{}{}}, func(value either.OnComplete) func(func(either.EitherErrorUnit)) {
		return value.Handler
	})
	fiber := either.Fiber{IsSuspended: isSuspended, Join: join, Kill: kill, OnComplete: onComplete, Run: run}
	fiber.Run()
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := archsimd.BroadcastInt32x4(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 4
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt32x4(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt32x4(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt32x4(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt32x4(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [4]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int32, initial int32) int32 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
