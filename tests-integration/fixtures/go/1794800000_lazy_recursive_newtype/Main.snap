// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/lazy"
	"strconv"
	"strings"
)

type StreamInt = *lazy.Lazy[*TupleInt]

type TupleInt struct {
	Second StreamInt
	First  int32
}

type StreamStreamInt = *lazy.Lazy[*TupleStreamInt]

type TupleStreamInt struct {
	First  StreamInt
	Second StreamStreamInt
}

var main_ = initializeMain_()

func initializeMain_() []string {
	scrutinee := countdown(3).Force()
	scrutinee2 := countdown(3).Force()
	var result string
	if scrutinee2.Second != nil {
		scrutinee3 := scrutinee2.Second.Force()
		result = "(Just " + strconv.Itoa(int(scrutinee3.First)) + ")"
	} else {
		result = "Nothing"
	}
	scrutinee4 := tails(countdown(2)).Force()
	scrutinee5 := scrutinee4.First.Force()
	return []string{strconv.Itoa(int(scrutinee.First)), result, strconv.Itoa(int(scrutinee5.First))}
}

func countdown(n int32) *lazy.Lazy[*TupleInt] {
	return lazy.Defer(func() *TupleInt {
		var result StreamInt
		if n <= 0 {
			result = nil
		} else {
			result = countdown(n - 1)
		}
		return &TupleInt{First: n, Second: result}
	})
}

func tails(stream StreamInt) *lazy.Lazy[*TupleStreamInt] {
	return lazy.Defer(func() *TupleStreamInt {
		scrutinee := stream.Force()
		var result StreamStreamInt
		if scrutinee.Second != nil {
			result = tails(scrutinee.Second)
		} else {
			result = nil
		}
		return &TupleStreamInt{First: stream, Second: result}
	})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
