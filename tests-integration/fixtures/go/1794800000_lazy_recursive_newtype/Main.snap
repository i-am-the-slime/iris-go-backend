// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/lazy"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type StreamInt = *lazy.Lazy[*TupleIntMaybeStreamInt]

type MaybeStreamInt struct {
	Just0 StreamInt
	Tag   uint8
}

const (
	MaybeStreamIntNothing = iota
	MaybeStreamIntJust
)

type TupleIntMaybeStreamInt struct {
	Tuple1 *MaybeStreamInt
	Tuple0 int32
}

type StreamStreamInt = *lazy.Lazy[*TupleStreamIntMaybeStreamStreamInt]

type MaybeStreamStreamInt struct {
	Just0 StreamStreamInt
	Tag   uint8
}

const (
	MaybeStreamStreamIntNothing = iota
	MaybeStreamStreamIntJust
)

type TupleStreamIntMaybeStreamStreamInt struct {
	Tuple0 StreamInt
	Tuple1 *MaybeStreamStreamInt
}

var sharedMaybeStreamIntNothing = &MaybeStreamInt{Tag: MaybeStreamIntNothing}

var sharedMaybeStreamStreamIntNothing = &MaybeStreamStreamInt{Tag: MaybeStreamStreamIntNothing}

var main_ = initializeMain_()

func initializeMain_() []string {
	scrutinee := countdown(3).Force()
	scrutinee2 := countdown(3).Force()
	var result string
	switch scrutinee2.Tuple1.Tag {
	case MaybeStreamIntJust:
		scrutinee3 := scrutinee2.Tuple1.Just0.Force()
		result = "(Just " + prim.ShowInt(scrutinee3.Tuple0) + ")"
	default:
		result = "Nothing"
	}
	scrutinee4 := tailsInt(countdown(2)).Force()
	scrutinee5 := scrutinee4.Tuple0.Force()
	return []string{prim.ShowInt(scrutinee.Tuple0), result, prim.ShowInt(scrutinee5.Tuple0)}
}

func countdown(n int32) *lazy.Lazy[*TupleIntMaybeStreamInt] {
	return lazy.Defer(func() *TupleIntMaybeStreamInt {
		var result *MaybeStreamInt
		if n <= 0 {
			result = sharedMaybeStreamIntNothing
		} else {
			result = &MaybeStreamInt{Tag: MaybeStreamIntJust, Just0: countdown(n - 1)}
		}
		return &TupleIntMaybeStreamInt{Tuple0: n, Tuple1: result}
	})
}

func tailsInt(stream StreamInt) *lazy.Lazy[*TupleStreamIntMaybeStreamStreamInt] {
	return lazy.Defer(func() *TupleStreamIntMaybeStreamStreamInt {
		scrutinee := stream.Force()
		var result *MaybeStreamStreamInt
		switch scrutinee.Tuple1.Tag {
		case MaybeStreamIntJust:
			result = &MaybeStreamStreamInt{Tag: MaybeStreamStreamIntJust, Just0: tailsInt(scrutinee.Tuple1.Just0)}
		default:
			result = sharedMaybeStreamStreamIntNothing
		}
		return &TupleStreamIntMaybeStreamStreamInt{Tuple0: stream, Tuple1: result}
	})
}

func main() {
	fmt.Println(main_)
}
