// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/lazy"
	"strconv"
	"strings"
)

type StreamInt = *lazy.Lazy[*TupleIntMaybeStreamInt]

type TupleIntMaybeStreamInt struct {
	Second StreamInt
	First  int32
}

type StreamStreamInt = *lazy.Lazy[*TupleStreamIntMaybeStreamStreamInt]

type TupleStreamIntMaybeStreamStreamInt struct {
	First  StreamInt
	Second StreamStreamInt
}

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	scrutinee := countdown(3).Force()
	scrutinee2 := countdown(3).Force()
	var result string
	if scrutinee2.Second != nil {
		scrutinee3 := scrutinee2.Second.Force()
		result = "(Just " + strconv.Itoa(int(scrutinee3.First)) + ")"
	} else {
		result = "Nothing"
	}
	scrutinee4 := tailsInt(countdown(2)).Force()
	scrutinee5 := scrutinee4.First.Force()
	return []string{strconv.Itoa(int(scrutinee.First)), result, strconv.Itoa(int(scrutinee5.First))}
}

func countdown(n int32) *lazy.Lazy[*TupleIntMaybeStreamInt] {
	return lazy.Defer(func() *TupleIntMaybeStreamInt {
		var result StreamInt
		if n <= 0 {
			result = nil
		} else {
			result = countdown(n - 1)
		}
		return &TupleIntMaybeStreamInt{First: n, Second: result}
	})
}

func tailsInt(stream StreamInt) *lazy.Lazy[*TupleStreamIntMaybeStreamStreamInt] {
	return lazy.Defer(func() *TupleStreamIntMaybeStreamStreamInt {
		scrutinee := stream.Force()
		var result StreamStreamInt
		if scrutinee.Second != nil {
			result = tailsInt(scrutinee.Second)
		} else {
			result = nil
		}
		return &TupleStreamIntMaybeStreamStreamInt{First: stream, Second: result}
	})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
