// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Outcome struct {
	Found0 string
	Found1 string
	Found2 string
	Found3 string
	Found4 string
	Found5 string
	Found6 string
	Found7 string
	Found8 string
	Found9 string
	Tag    uint8
}

const (
	OutcomeFound = iota
	OutcomeMissing
)

type Entry struct {
	Entry0 string
	Entry1 string
	Entry2 string
	Entry3 string
	Entry4 string
	Entry5 string
	Entry6 string
	Entry7 string
	Entry8 string
	Entry9 string
}

var sharedEntryBlank = &Entry{}

type ListEntry struct {
	Cons0 *Entry
	Cons1 *ListEntry
}

var sharedListEntryNil = &ListEntry{}

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	scrutinee := search(3, 0)
	var result string
	switch scrutinee.Tag {
	case OutcomeFound:
		result = prim.Append(scrutinee.Found0, scrutinee.Found9)
	default: // OutcomeMissing
		result = "missing"
	}
	scrutinee2 := search(12, 0)
	var result2 string
	switch scrutinee2.Tag {
	case OutcomeFound:
		result2 = prim.Append(scrutinee2.Found0, scrutinee2.Found9)
	default: // OutcomeMissing
		result2 = "missing"
	}
	return shared.MainResult{Found: result, Missing: result2, Entries: firsts(entries)}
}

func search(target int32, key int32) Outcome {
	for {
		if key == target {
			return Outcome{Tag: OutcomeFound, Found0: strconv.Itoa(int(key)), Found1: "b", Found2: "c", Found3: "d", Found4: "e", Found5: "f", Found6: "g", Found7: "h", Found8: "i", Found9: "j"}
		}
		if key > 9 {
			return Outcome{Tag: OutcomeMissing}
		}
		key += 1
	}
}

func firsts(list *ListEntry) string {
	return string(appendFirsts(nil, list))
}

var entries *ListEntry = &ListEntry{Cons0: &Entry{Entry0: "k", Entry1: "l", Entry2: "m", Entry3: "n", Entry4: "o", Entry5: "p", Entry6: "q", Entry7: "r", Entry8: "s", Entry9: "t"}, Cons1: &ListEntry{Cons0: sharedEntryBlank, Cons1: sharedListEntryNil}}

func appendFirsts(buffer []byte, list *ListEntry) []byte {
	if list != sharedListEntryNil {
		if list != sharedListEntryNil && list.Cons0 != sharedEntryBlank {
			buffer = prim.AppendString(buffer, list.Cons0.Entry0)
			buffer = appendFirsts(buffer, list.Cons1)
		} else {
			buffer = append(buffer, "_"...)
			buffer = appendFirsts(buffer, list.Cons1)
		}
	}
	return buffer
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Entries string
	Found   string
	Missing string
}

// note: the entry's value of type { entries, found, missing } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
