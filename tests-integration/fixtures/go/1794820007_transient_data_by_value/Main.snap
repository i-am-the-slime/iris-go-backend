// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Outcome struct {
	Found0 string
	Found1 string
	Found2 string
	Found3 string
	Found4 string
	Found5 string
	Found6 string
	Found7 string
	Found8 string
	Found9 string
	Tag    uint8
}

const (
	OutcomeFound = iota
	OutcomeMissing
)

type Entry struct {
	Entry0 string
	Entry1 string
	Entry2 string
	Entry3 string
	Entry4 string
	Entry5 string
	Entry6 string
	Entry7 string
	Entry8 string
	Entry9 string
}

var sharedEntryBlank = &Entry{}

type List struct {
	Cons0 *Entry
	Cons1 *List
}

var sharedListNil = &List{}

func Found(found0 string, found1 string, found2 string, found3 string, found4 string, found5 string, found6 string, found7 string, found8 string, found9 string) Outcome {
	return Outcome{Tag: OutcomeFound, Found0: found0, Found1: found1, Found2: found2, Found3: found3, Found4: found4, Found5: found5, Found6: found6, Found7: found7, Found8: found8, Found9: found9}
}

func EntryEntry(entry0 string, entry1 string, entry2 string, entry3 string, entry4 string, entry5 string, entry6 string, entry7 string, entry8 string, entry9 string) *Entry {
	return &Entry{Entry0: entry0, Entry1: entry1, Entry2: entry2, Entry3: entry3, Entry4: entry4, Entry5: entry5, Entry6: entry6, Entry7: entry7, Entry8: entry8, Entry9: entry9}
}

func Cons(cons0 *Entry, cons1 *List) *List {
	return &List{Cons0: cons0, Cons1: cons1}
}

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	scrutinee := search(3, 0)
	var result string
	switch scrutinee.Tag {
	case OutcomeFound:
		result = prim.Append(scrutinee.Found0, scrutinee.Found9)
	default: // OutcomeMissing
		result = "missing"
	}
	scrutinee2 := search(12, 0)
	var result2 string
	switch scrutinee2.Tag {
	case OutcomeFound:
		result2 = prim.Append(scrutinee2.Found0, scrutinee2.Found9)
	default: // OutcomeMissing
		result2 = "missing"
	}
	return shared.MainResult{Found: result, Missing: result2, Entries: firsts(entries)}
}

func search(target int, key int) Outcome {
	for {
		if key == target {
			return Found(strconv.Itoa(key), "b", "c", "d", "e", "f", "g", "h", "i", "j")
		}
		if key > 9 {
			return Outcome{Tag: OutcomeMissing}
		}
		key += 1
	}
}

func firsts(list *List) string {
	return string(appendFirsts(nil, list))
}

var entries *List = Cons(EntryEntry("k", "l", "m", "n", "o", "p", "q", "r", "s", "t"), Cons(sharedEntryBlank, sharedListNil))

func appendFirsts(buffer []byte, list *List) []byte {
	if list != sharedListNil {
		if list.Cons0 != sharedEntryBlank {
			buffer = prim.AppendString(buffer, list.Cons0.Entry0)
			buffer = appendFirsts(buffer, list.Cons1)
		} else {
			buffer = append(buffer, '_')
			buffer = appendFirsts(buffer, list.Cons1)
		}
	}
	return buffer
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Entries string
	Found   string
	Missing string
}

// note: the entry's value of type { entries, found, missing } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
