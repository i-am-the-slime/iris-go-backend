// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	_, found := prim.CodeUnitIndexOf("ab", "ba")
	var result string
	if found {
		result = "true"
	} else {
		result = "false"
	}
	return []string{strconv.FormatBool(prim.CodeUnitContains("ab", "cab")), strconv.FormatBool(prim.CodeUnitContains("😀", "a😀")), result}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
