// Data/Show/show.go
package show

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

func ShowParticleConsNumberConsNumberNil(record shared.Particle) string {
	return string(AppendShowParticleConsNumberConsNumberNil(nil, record))
}

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowArrayParticle(buffer []byte, array []shared.Particle) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowParticleConsNumberConsNumberNil(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowParticleConsNumberConsNumberNil(buffer []byte, record shared.Particle) []byte {
	buffer = append(buffer, "{ position: "...)
	buffer = prim.AppendShowNumber(buffer, record.Position)
	buffer = append(buffer, ", velocity: "...)
	buffer = prim.AppendShowNumber(buffer, record.Velocity)
	buffer = append(buffer, " }"...)
	return buffer
}

// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type TupleIntParticle struct {
	Second shared.Particle
	First  int32
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{string(show.AppendShowArrayParticle(nil, mainGo(0, []shared.Particle{{Position: 0.0, Velocity: 0.0}, {Position: 1.0, Velocity: 0.5}, {Position: 4.0, Velocity: -0.25}}))), string(show.AppendShowArrayInt(nil, mainGo2(0, []int32{1, 2, 3}))), string(show.AppendShowArrayInt(nil, shrink([]int32{9, 3, 7, 5, 4}))), string(show.AppendShowArrayInt(nil, mainGo3(0, []int32{0}, []int32{1, 2}))), string(show.AppendShowArrayArrayInt(nil, mainGo4(0, [][]int32{{1}, {2}})))}
}

var shrink func([]int32) []int32 = shrinkGo

func mainGo(i int32, particles []shared.Particle) []shared.Particle {
	var particlesOwned []shared.Particle
	var particlesSpare []shared.Particle
	for {
		if i >= 50 {
			return particles
		}
		mapped := shared.Recycle(particlesSpare, len(particles))
		for index := range particles {
			i2 := int32(index)
			accumulatorPosition := particles[index].Position
			accumulatorVelocity := particles[index].Velocity
			for index2 := range particles {
				i3 := int32(index2)
				if i2 != i3 {
					accumulatorVelocity += (particles[index2].Position - accumulatorPosition) * 0.001
				}
			}
			accumulatorPosition += accumulatorVelocity
			mapped[index] = shared.Particle{Position: accumulatorPosition, Velocity: accumulatorVelocity}
		}
		particlesOwned, particlesSpare = mapped, particlesOwned
		i, particles = i+1, mapped
	}
}

func mainGo2(i int32, values []int32) []int32 {
	var valuesOwned []int32
	var valuesSpare []int32
	for {
		if i >= 10 {
			return values
		}
		mapped := shared.Recycle(valuesSpare, len(values))
		for index, value := range values {
			mapped[index] = value*2 + i
		}
		valuesOwned, valuesSpare = mapped, valuesOwned
		i, values = i+1, mapped
	}
}

func mainGo3(i int32, previous []int32, values []int32) []int32 {
	for {
		if i >= 3 {
			return array.Append(previous, values)
		}
		i, previous, values = i+1, values, mapLanes(values)
	}
}

func mainGo4(i int32, rows [][]int32) [][]int32 {
	for {
		if i >= 3 {
			return rows
		}
		mapped := make([][]int32, len(rows))
		for index, row := range rows {
			mapped[index] = array.Append(row, []int32{i})
		}
		i, rows = i+1, mapped
	}
}

func shrinkGo(values []int32) []int32 {
	var valuesOwned []int32
	var valuesSpare []int32
	for {
		if int32(len(values)) <= 1 {
			return values
		}
		mapped := shared.Recycle(valuesSpare, 0)
		for _, value := range values {
			if value > 2 {
				mapped = append(mapped, value-1)
			}
		}
		valuesOwned, valuesSpare = mapped, valuesOwned
		values = mapped
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func mapLanes(xs []int32) []int32 {
	c0 := archsimd.BroadcastInt32x4(1)
	out := make([]int32, len(xs))
	const step = 4
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadInt32x4(xs[i : i+step])
		x.Add(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadInt32x4Part(xs[i:])
		x.Add(c0).StorePart(out[i:])
	}
	return out
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func mapLanes(xs []int32) []int32 {
	out := make([]int32, len(xs))
	for i, x := range xs {
		out[i] = x + 1
	}
	return out
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func mapLanes(xs []int32) []int32 {
	c0 := simd.BroadcastInt32s(1)
	out := make([]int32, len(xs))
	step := simd.Int32s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadInt32s(xs[i : i+step])
		x.Add(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadInt32sPart(xs[i:])
		x.Add(c0).StorePart(out[i:])
	}
	return out
}

// shared/shared.go
package shared

type Particle struct {
	Position float64
	Velocity float64
}

func Recycle[T any, N ~int | ~int32 | ~int64](buffer []T, count N) []T {
	if cap(buffer) < int(count) {
		return make([]T, count)
	}
	return buffer[:count]
}
