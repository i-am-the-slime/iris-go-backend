// Data/Show/show.go
package show

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowParticleConsNumberConsNumberNil(record shared.Particle) string {
	return string(AppendShowParticleConsNumberConsNumberNil(nil, record))
}

func ShowInt(i int) string {
	return strconv.Itoa(i)
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayParticle(buffer []byte, array []shared.Particle) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowParticleConsNumberConsNumberNil(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowParticleConsNumberConsNumberNil(buffer []byte, record shared.Particle) []byte {
	buffer = append(buffer, "{ position: "...)
	buffer = prim.AppendShowNumber(buffer, record.Position)
	buffer = append(buffer, ", velocity: "...)
	buffer = prim.AppendShowNumber(buffer, record.Velocity)
	buffer = append(buffer, " }"...)
	return buffer
}

func ArrayArrayInt(array [][]int) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

func ArrayParticle(array []shared.Particle) string {
	return string(AppendShowArrayParticle(nil, array))
}

// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type Tuple struct {
	Second shared.Particle
	First  int32
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{show.ArrayParticle(mainGo(0, []shared.Particle{{Position: 0.0, Velocity: 0.0}, {Position: 1.0, Velocity: 0.5}, {Position: 4.0, Velocity: -0.25}})), show.ArrayInt(mainGo2(0, []int{1, 2, 3})), show.ArrayInt(shrink([]int{9, 3, 7, 5, 4})), show.ArrayInt(mainGo3(0, []int{0}, []int{1, 2})), show.ArrayArrayInt(mainGo4(0, [][]int{{1}, {2}}))}
}

var shrink func([]int) []int = shrinkGo

func mainGo(i int, particles []shared.Particle) []shared.Particle {
	var particlesOwned []shared.Particle
	var particlesSpare []shared.Particle
	for {
		if i >= 50 {
			return particles
		}
		mapped := shared.Recycle(particlesSpare, len(particles))
		for index := range particles {
			accumulatorPosition := particles[index].Position
			accumulatorVelocity := particles[index].Velocity
			for index2 := range particles {
				if index != index2 {
					accumulatorVelocity += (particles[index2].Position - accumulatorPosition) * 0.001
				}
			}
			accumulatorPosition += accumulatorVelocity
			mapped[index] = shared.Particle{Position: accumulatorPosition, Velocity: accumulatorVelocity}
		}
		particlesOwned, particlesSpare = mapped, particlesOwned
		i, particles = i+1, mapped
	}
}

func mainGo2(i int, values []int) []int {
	var valuesOwned []int
	var valuesSpare []int
	for {
		if i >= 10 {
			return values
		}
		mapped := shared.Recycle(valuesSpare, len(values))
		for index, value := range values {
			mapped[index] = value*2 + i
		}
		valuesOwned, valuesSpare = mapped, valuesOwned
		i, values = i+1, mapped
	}
}

func mainGo3(i int, previous []int, values []int) []int {
	for {
		if i >= 3 {
			return array.Append(previous, values)
		}
		i, previous, values = i+1, values, mapLanes(values)
	}
}

func mainGo4(i int, rows [][]int) [][]int {
	for {
		if i >= 3 {
			return rows
		}
		mapped := make([][]int, len(rows))
		for index, row := range rows {
			mapped[index] = array.Append(row, []int{i})
		}
		i, rows = i+1, mapped
	}
}

func shrinkGo(values []int) []int {
	var valuesOwned []int
	var valuesSpare []int
	for {
		if len(values) <= 1 {
			return values
		}
		mapped := shared.Recycle(valuesSpare, 0)
		for _, value := range values {
			if value > 2 {
				mapped = append(mapped, value-1)
			}
		}
		valuesOwned, valuesSpare = mapped, valuesOwned
		values = mapped
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"simd/archsimd"
	"unsafe"
)

func mapLanesLanes(xs []int64) []int64 {
	c0 := archsimd.BroadcastInt64x2(1)
	out := make([]int64, len(xs))
	const step = 2
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadInt64x2(xs[i : i+step])
		x.Add(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadInt64x2Part(xs[i:])
		x.Add(c0).StorePart(out[i:])
	}
	return out
}
func mapLanes(xs []int) []int {
	out := mapLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)))
	return unsafe.Slice((*int)(unsafe.Pointer(unsafe.SliceData(out))), len(out))
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func mapLanes(xs []int) []int {
	out := make([]int, len(xs))
	for i, x := range xs {
		out[i] = x + 1
	}
	return out
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"simd"
	"unsafe"
)

func mapLanesLanes(xs []int64) []int64 {
	c0 := simd.BroadcastInt64s(1)
	out := make([]int64, len(xs))
	step := simd.Int64s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadInt64s(xs[i : i+step])
		x.Add(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadInt64sPart(xs[i:])
		x.Add(c0).StorePart(out[i:])
	}
	return out
}
func mapLanes(xs []int) []int {
	out := mapLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)))
	return unsafe.Slice((*int)(unsafe.Pointer(unsafe.SliceData(out))), len(out))
}

// shared/shared.go
package shared

type Particle struct {
	Position float64
	Velocity float64
}

func Recycle[T any, N ~int | ~int32 | ~int64](buffer []T, count N) []T {
	if cap(buffer) < int(count) {
		return make([]T, count)
	}
	return buffer[:count]
}
