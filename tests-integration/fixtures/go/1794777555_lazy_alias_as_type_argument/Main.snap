// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/lazy"
	"github.com/i-am-the-slime/iris-go/prim"
)

type Stream = *lazy.Lazy[*TupleLabelledLazyStream]

type Labelled struct {
	First  string
	Second Stream
}

type TupleLabelledLazyStream struct {
	First  *Labelled
	Second *lazy.Lazy[*lazy.Lazy[*TupleLabelledLazyStream]]
}

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return take(3, from(1))
}

func take(n int32, stream Stream) []string {
	switch n {
	case 0:
		return []string{}
	default:
		scrutinee := stream.Force()
		return array.Append([]string{scrutinee.First.First}, take(n - 1, scrutinee.Second.Force()))
	}
}

func from(n int32) *lazy.Lazy[*TupleLabelledLazyStream] {
	return lazy.Defer(func() *TupleLabelledLazyStream {
		return &TupleLabelledLazyStream{First: &Labelled{First: prim.ShowInt(n), Second: nil}, Second: lazy.Defer(func() Stream {
			return from(n + 1)
		})}
	})
}

func main() {
	fmt.Println(main_)
}
