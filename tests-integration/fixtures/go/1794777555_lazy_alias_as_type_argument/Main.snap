// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/lazy"
	"strconv"
	"strings"
)

type Stream = *lazy.Lazy[Tuple]

type Labelled struct {
	First  string
	Second Stream
}

type Tuple struct {
	First  Labelled
	Second *lazy.Lazy[*lazy.Lazy[Tuple]]
}

var main_ = initializeMain_()

func initializeMain_() []string {
	return take(3, from(1))
}

func take(n int, cell Stream) []string {
	switch n {
	case 0:
		return []string{}
	default:
		scrutinee := cell.Force()
		return array.Append([]string{scrutinee.First.First}, take(n-1, scrutinee.Second.Force()))
	}
}

func from(n int) *lazy.Lazy[Tuple] {
	return lazy.Defer(func() Tuple {
		return Tuple{First: Labelled{First: strconv.Itoa(n), Second: nil}, Second: lazy.Defer(func() Stream {
			return from(n + 1)
		})}
	})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
