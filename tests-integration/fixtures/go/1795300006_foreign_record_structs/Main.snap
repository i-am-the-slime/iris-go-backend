// main.go
package main

import (
	"fixture/Run_ffi"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main_() []string {
	record := Run_ffi.Run("echo")()
	array := Run_ffi.RunAll([]string{"a", "b"})()
	updated := record
	updated.Stdout = record.Stdout + "!"
	return []string{Run_ffi.Describe(updated), Run_ffi.Describe(made), prim.ShowInt(int32(len(array))), updated.Stderr + prim.ShowInt(updated.ExitCode)}
}

var made Run_ffi.Output = Run_ffi.Output{Stdout: "made", Stderr: "", ExitCode: 3}

func main() {
	defer exception.ReportUncaught()
	main_()
}
