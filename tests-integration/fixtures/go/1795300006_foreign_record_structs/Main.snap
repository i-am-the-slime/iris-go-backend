// main.go
package main

import (
	"fixture/Run_ffi"
	"github.com/i-am-the-slime/iris-go/exception"
	"strconv"
)

func main_() []string {
	output := Run_ffi.Run("echo")
	outputs := Run_ffi.RunAll([]string{"a", "b"})
	output.Stdout += "!"
	return []string{Run_ffi.Describe(output), Run_ffi.Describe(made), strconv.Itoa(len(outputs)), output.Stderr + strconv.Itoa(int(output.ExitCode))}
}

var made Run_ffi.Output = Run_ffi.Output{Stdout: "made", Stderr: "", ExitCode: 3}

func main() {
	defer exception.ReportUncaught()
	main_()
}
