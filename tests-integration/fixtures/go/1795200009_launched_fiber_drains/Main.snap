// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type EitherErrorInt struct {
	Left  exception.Error
	Right int32
	Tag   uint8
}

const (
	EitherErrorIntLeft = iota
	EitherErrorIntRight
)

type EitherErrorUnit struct {
	Right struct{}
	Left  exception.Error
	Tag   uint8
}

const (
	EitherErrorUnitLeft = iota
	EitherErrorUnitRight
)

type OnCompleteInt struct {
	Handler func(func(EitherErrorInt))
	Rethrow bool
}

type FiberInt struct {
	IsSuspended func() bool
	Join        func(func(EitherErrorInt)) func()
	Kill        func(exception.Error) func(func(EitherErrorUnit)) func()
	OnComplete  func(OnCompleteInt) func()
	Run         func()
}

type OnCompleteUnit struct {
	Handler func(func(EitherErrorUnit))
	Rethrow bool
}

type FiberUnit struct {
	IsSuspended func() bool
	Join        func(func(EitherErrorUnit)) func()
	Kill        func(exception.Error) func(func(EitherErrorUnit)) func()
	OnComplete  func(OnCompleteUnit) func()
	Run         func()
}

func LeftEitherErrorInt(left exception.Error) EitherErrorInt {
	return EitherErrorInt{Tag: EitherErrorIntLeft, Left: left}
}

func RightEitherErrorInt(right int32) EitherErrorInt {
	return EitherErrorInt{Tag: EitherErrorIntRight, Right: right}
}

func RightEitherErrorUnit(right struct{}) EitherErrorUnit {
	return EitherErrorUnit{Tag: EitherErrorUnitRight, Right: right}
}

func LeftEitherErrorUnit(left exception.Error) EitherErrorUnit {
	return EitherErrorUnit{Tag: EitherErrorUnitLeft, Left: left}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/aff"
	"github.com/i-am-the-slime/iris-go/eventloop"
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

func main_() int32 {
	steps := &shared.Ref[int32]{Value: 0}
	fiber3 := aff.NewFiber(func() struct{} {
		mainStep(steps, 1)
		fiber := aff.ForkFiber(true, func() int32 {
			return 2
		})
		isSuspended, join, kill, onComplete, run := aff.FiberFields(fiber, func(payload exception.Error) either.EitherErrorInt {
			return either.LeftEitherErrorInt(payload)
		}, func(payload int32) either.EitherErrorInt {
			return either.RightEitherErrorInt(payload)
		}, either.RightEitherErrorUnit(struct{}{}), func(value either.OnCompleteInt) func(func(either.EitherErrorInt)) {
			return value.Handler
		})
		fiber2 := either.FiberInt{IsSuspended: isSuspended, Join: join, Kill: kill, OnComplete: onComplete, Run: run}
		joined := aff.MakeAffDirect(func(value either.EitherErrorInt) bool {
			return value.Tag == either.EitherErrorIntLeft
		}, func(value either.EitherErrorInt) exception.Error {
			return value.Left
		}, func(value either.EitherErrorInt) int32 {
			return value.Right
		}, func(k func(either.EitherErrorInt)) func(exception.Error) {
			effect := fiber2.Join(k)
			return func(_ exception.Error) {
				effect()
			}
		})
		mainStep(steps, joined)
		return struct{}{}
	})
	_, _, _, _, run2 := aff.FiberFields(fiber3, func(payload exception.Error) either.EitherErrorUnit {
		return either.LeftEitherErrorUnit(payload)
	}, func(payload struct{}) either.EitherErrorUnit {
		return either.RightEitherErrorUnit(payload)
	}, either.RightEitherErrorUnit(struct{}{}), func(value either.OnCompleteUnit) func(func(either.EitherErrorUnit)) {
		return value.Handler
	})
	run2()
	mainStep(steps, 3)
	return steps.Value
}

func mainStep(steps *shared.Ref[int32], digit int32) {
	s := steps.Value
	s_ := s*10 + digit
	steps.Value = s_
}

func main() {
	exitStatus := main_()
	eventloop.Await()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
