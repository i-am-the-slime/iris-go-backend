// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type EitherInt struct {
	Left  exception.Error
	Right int
	Tag   uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type EitherUnit struct {
	Right struct{}
	Left  exception.Error
	Tag   uint8
}

const (
	EitherUnitLeft = iota
	EitherUnitRight
)

type OnCompleteInt struct {
	Handler func(func(EitherInt))
	Rethrow bool
}

type OnCompleteUnit struct {
	Handler func(func(EitherUnit))
	Rethrow bool
}

func LeftEitherInt(left exception.Error) EitherInt {
	return EitherInt{Tag: EitherIntLeft, Left: left}
}

func RightEitherInt(right int) EitherInt {
	return EitherInt{Tag: EitherIntRight, Right: right}
}

func RightEitherUnit(right struct{}) EitherUnit {
	return EitherUnit{Tag: EitherUnitRight, Right: right}
}

func LeftEitherUnit(left exception.Error) EitherUnit {
	return EitherUnit{Tag: EitherUnitLeft, Left: left}
}

// Effect/Aff/aff.go
package effectaff

import (
	"fixture/Data/Either"
	"github.com/i-am-the-slime/iris-go/exception"
)

type FiberInt struct {
	IsSuspended func() bool
	Join        func(func(either.EitherInt)) func()
	Kill        func(exception.Error) func(func(either.EitherUnit)) func()
	OnComplete  func(either.OnCompleteInt) func()
	Run         func()
}

type FiberUnit struct {
	IsSuspended func() bool
	Join        func(func(either.EitherUnit)) func()
	Kill        func(exception.Error) func(func(either.EitherUnit)) func()
	OnComplete  func(either.OnCompleteUnit) func()
	Run         func()
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Effect/Aff"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/aff"
	"github.com/i-am-the-slime/iris-go/eventloop"
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

func main_() int {
	steps := &shared.Ref[int]{Value: 0}
	fiber3 := aff.NewFiber(func() struct{} {
		mainStep(steps, 1)
		fiber := aff.ForkFiber(true, func() int {
			return 2
		})
		isSuspended, join, kill, onComplete, run := aff.FiberFields(fiber, func(payload exception.Error) either.EitherInt {
			return either.LeftEitherInt(payload)
		}, func(payload int) either.EitherInt {
			return either.RightEitherInt(payload)
		}, either.RightEitherUnit(struct{}{}), func(value either.OnCompleteInt) func(func(either.EitherInt)) {
			return value.Handler
		})
		fiber2 := effectaff.FiberInt{IsSuspended: isSuspended, Join: join, Kill: kill, OnComplete: onComplete, Run: run}
		joined := aff.MakeAffDirect(func(value either.EitherInt) bool {
			return value.Tag == either.EitherIntLeft
		}, func(value either.EitherInt) exception.Error {
			return value.Left
		}, func(value either.EitherInt) int {
			return value.Right
		}, func(k func(either.EitherInt)) func(exception.Error) {
			effect := fiber2.Join(k)
			return func(_ exception.Error) {
				effect()
			}
		})
		mainStep(steps, joined)
		return struct{}{}
	})
	_, _, _, _, run2 := aff.FiberFields(fiber3, func(payload exception.Error) either.EitherUnit {
		return either.LeftEitherUnit(payload)
	}, func(payload struct{}) either.EitherUnit {
		return either.RightEitherUnit(payload)
	}, either.RightEitherUnit(struct{}{}), func(value either.OnCompleteUnit) func(func(either.EitherUnit)) {
		return value.Handler
	})
	run2()
	mainStep(steps, 3)
	return steps.Value
}

func mainStep(steps *shared.Ref[int], digit int) {
	s := steps.Value
	s_ := s*10 + digit
	steps.Value = s_
}

func main() {
	eventloop.Await()
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
