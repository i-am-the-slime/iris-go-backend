// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// main.go
package main

import (
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strings"
)

type Suit uint8

const (
	SuitHearts Suit = iota
	SuitSpades
	SuitClubs
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := *arraypkg.Thaw([]Suit{SuitSpades, SuitClubs, SuitHearts})
	slices.Sort(array)
	performed := shared.Frozen(array)
	return []string{arraySuit([]Suit{SuitHearts, SuitHearts, SuitSpades, SuitClubs}), arraySuit([]Suit{SuitClubs, SuitSpades, SuitHearts}), arraySuit(performed)}
}

func appendShowArraySuit(buffer []byte, array []Suit) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = appendShowSuit(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func appendShowSuit(buffer []byte, suit Suit) []byte {
	switch suit {
	case SuitHearts:
		buffer = append(buffer, "hearts"...)
	case SuitSpades:
		buffer = append(buffer, "spades"...)
	default: // SuitClubs
		buffer = append(buffer, "clubs"...)
	}
	return buffer
}

func arraySuit(array []Suit) string {
	return string(appendShowArraySuit(nil, array))
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
