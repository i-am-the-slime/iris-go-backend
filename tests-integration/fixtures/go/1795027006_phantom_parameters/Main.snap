// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Step struct {
	Field1 func(int) Step
	Field0 int
	Tag    uint8
}

const (
	StepStep2 = iota
	StepDone
)

func Done(field0 int) Step {
	return Step{Tag: StepDone, Field0: field0}
}

func StepStep(field0 int, field1 func(int) Step) Step {
	return Step{Tag: StepStep2, Field0: field0, Field1: field1}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	return []int{run(countdown(3))}
}

func run(step Step) int {
	switch step.Tag {
	case StepDone:
		return step.Field0
	default: // StepStep2
		n := step.Field0
		return n + run(step.Field1(n-1))
	}
}

func countdown(n int) Step {
	switch n {
	case 0:
		return Done(0)
	default:
		return StepStep(n, countdown)
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
