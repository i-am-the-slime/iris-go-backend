// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Step struct {
	Step1 func(int32) Step
	Step0 int32
	Done  int32
	Tag   uint8
}

const (
	StepStep2 = iota
	StepDone
)

func Done(done int32) Step {
	return Step{Tag: StepDone, Done: done}
}

func StepStep(step0 int32, step1 func(int32) Step) Step {
	return Step{Tag: StepStep2, Step0: step0, Step1: step1}
}

var main_ = initializeMain_()

func initializeMain_() []int32 {
	return []int32{run(countdown(3))}
}

func run(step Step) int32 {
	switch step.Tag {
	case StepDone:
		return step.Done
	default: // StepStep2
		n := step.Step0
		return n + run(step.Step1(n-1))
	}
}

func countdown(n int32) Step {
	switch n {
	case 0:
		return Done(0)
	default:
		return StepStep(n, countdown)
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
