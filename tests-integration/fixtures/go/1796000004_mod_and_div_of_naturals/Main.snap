// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	return []int32{117, 109, 65, mainGo(0, 0), -1, 3, 1}
}

func mainGo(i int32, total int32) int32 {
	for {
		if i >= 25 {
			return total
		}
		i, total = i + 1, total + i % 10 + i / 2
	}
}

func main() {
	fmt.Println(main_)
}
