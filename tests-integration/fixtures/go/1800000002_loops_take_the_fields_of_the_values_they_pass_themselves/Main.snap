// main.go
package main

import (
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	journal.Log(strconv.Itoa(mainGoJust(0, 0)))
	journal.Log(strconv.Itoa(mainGoTuple(0, 1, 40)))
	journal.Log(strconv.Itoa(mainGoState(0, 1000000, 0)))
	journal.Log(strconv.Itoa(runsIn("aaabbbcccaa")))
	journal.Log(strconv.Itoa(runsIn("")))
	journal.Log(strconv.Itoa(sumDownJust(0, 100)))
	journal.Log(strconv.Itoa(sumDownNothing(100)))
}

func runsIn(text string) int {
	chars := prim.StringToCharArray(text)
	return runsInGoFresh(chars, 0, 0)
}

func sumDownJust(s int, n int) int {
	for {
		if n <= 0 {
			return s
		}
		s, n = s+n, n-1
	}
}

func sumDownNothing(n int) int {
	return n
}

func mainGoJust(s int, i int) int {
	for {
		if i >= 1000 {
			return s
		}
		s, i = s+i, i+1
	}
}

func mainGoTuple(a int, b int, k int) int {
	for {
		if k <= 0 {
			return a
		}
		a, b, k = b, a+b, k-1
	}
}

func mainGoState(high int, low int, i int) int {
	for {
		if i >= 0 && i < 5 {
			field := []int{5, 3, 9, 1, 7}[i]
			result := max(high, field)
			result2 := min(low, field)
			high, low, i = result, result2, i+1
			continue
		}
		return high - low
	}
}

func runsInGoInRun(chars []rune, d rune, k int, runs int, i int) int {
	for {
		if i < len(chars) {
			field := chars[i]
			if field == d {
				k, i = k+1, i+1
				continue
			}
			d, k, runs, i = field, 1, runs+1, i+1
			continue
		}
		return runs
	}
}

func runsInGoFresh(chars []rune, runs int, i int) int {
	if i < len(chars) {
		return runsInGoInRun(chars, chars[i], 1, runs+1, i+1)
	}
	return runs
}
