//line Main.purs:8:1
}

//line Main.purs:8:1
const (
//line Main.purs:9:5
	ExprAdd = iota
//line Main.purs:10:5
	ExprVal
//line Main.purs:11:5
	ExprVar
//line Main.purs:8:1
