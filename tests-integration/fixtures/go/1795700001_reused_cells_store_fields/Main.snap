// main.go
package main

import "fixture/shared"

type Tree struct {
	Node2 *Tree
	Node3 *Tree
	Node0 int32
	Node1 int32
}

var sharedTreeLeaf = &Tree{}

type Chain struct {
	Field1 *Chain
	Field0 int32
	Tag    uint8
}

const (
	ChainEnd = iota
	ChainRed
	ChainBlue
)

var sharedChainEnd = &Chain{Tag: ChainEnd}

func Red(field0 int32, field1 *Chain) *Chain {
	return &Chain{Tag: ChainRed, Field0: field0, Field1: field1}
}

func Blue(field0 int32, field1 *Chain) *Chain {
	return &Chain{Tag: ChainBlue, Field0: field0, Field1: field1}
}

func Node(node0 int32, node1 int32, node2 *Tree, node3 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: node1, Node2: node2, Node3: node3}
}

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	scrutinee := insertCountsLeaf(3)
	var result *Tree
	if scrutinee != sharedTreeLeaf {
		k := scrutinee.Node0
		count := scrutinee.Node1
		left := scrutinee.Node2
		right := scrutinee.Node3
		argument := count + sizeOf(left)
		scrutinee.Node0 = argument
		scrutinee.Node1 = k
		scrutinee.Node2 = right
		scrutinee.Node3 = left
		result = scrutinee
	} else {
		result = sharedTreeLeaf
	}
	return shared.MainResult{Size: sizeOf(counts), Swapped: sizeOf(result), Blues: blues(recolourStoresTheTagRedReusing(1, Blue(2, Red(3, sharedChainEnd))))}
}

func sizeOf(tree *Tree) int32 {
	if tree == sharedTreeLeaf {
		return 0
	}
	return tree.Node1 + sizeOf(tree.Node2) + sizeOf(tree.Node3)
}

var counts = initializeCounts()

func initializeCounts() *Tree {
	return insertCountsReusing(2, insertCountsReusing(1, insertCountsLeaf(2)))
}

func blues(value *Chain) int32 {
	for {
		switch value.Tag {
		case ChainBlue:
			n := value.Field0
			rest := value.Field1
			return n + blues(rest)
		case ChainRed:
			value = value.Field1
			continue
		default: // ChainEnd
			return 0
		}
	}
}

func insertCountsLeaf(key int32) *Tree {
	return Node(key, 1, sharedTreeLeaf, sharedTreeLeaf)
}

func insertCountsReusing(key int32, value *Tree) *Tree {
	if value == sharedTreeLeaf {
		return Node(key, 1, sharedTreeLeaf, sharedTreeLeaf)
	}
	k := value.Node0
	count := value.Node1
	left := value.Node2
	right := value.Node3
	if key < k {
		field := insertCountsReusing(key, left)
		value.Node2 = field
		return value
	}
	if key > k {
		field := insertCountsReusing(key, right)
		value.Node3 = field
		return value
	}
	value.Node1 = count + 1
	return value
}

func recolourStoresTheTagRedReusing(n int32, rest *Chain) *Chain {
	return Blue(n+1, recolourStoresTheTagReusing(rest))
}

func recolourStoresTheTagReusing(value *Chain) *Chain {
	switch value.Tag {
	case ChainRed:
		n := value.Field0
		rest := value.Field1
		field := recolourStoresTheTagReusing(rest)
		value.Tag = ChainBlue
		value.Field0 = n + 1
		value.Field1 = field
		return value
	case ChainBlue:
		rest := value.Field1
		field := recolourStoresTheTagReusing(rest)
		value.Tag = ChainRed
		value.Field1 = field
		return value
	default: // ChainEnd
		return sharedChainEnd
	}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Blues   int32
	Size    int32
	Swapped int32
}

// note: the entry's value of type { blues, size, swapped } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
