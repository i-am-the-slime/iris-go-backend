// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/alloc"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int32
	Tag    uint8
}

const (
	ExprVal = iota
	ExprAdd
	ExprMul
	ExprSub
)

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
	Tag   uint8
}

const (
	ListIntNil = iota
	ListIntCons
)

var sharedListIntNil = &ListInt{Tag: ListIntNil}

func main_(n int32) shared.MainResult {
	n2 := -n
	listInts := make([]ListInt, 3)
	listInts[0] = ListInt{Tag: ListIntCons, Cons0: n, Cons1: &listInts[1]}
	listInts[1] = ListInt{Tag: ListIntCons, Cons0: 2, Cons1: &listInts[2]}
	listInts[2] = ListInt{Tag: ListIntCons, Cons0: 3, Cons1: sharedListIntNil}
	return shared.MainResult{Built: evaluate(build(4)), Mirrored: evaluate(mirrorReusing(build(3))), Two: evaluate(&Expr{Tag: ExprAdd, Field0: build(2), Field1: &Expr{Tag: ExprVal, Val: 2}}), Linked: total(mainGo(5, sharedListIntNil)), Literal: total(&listInts[0]), Positive: n > 0 && evaluate(&Expr{Tag: ExprAdd, Field0: &Expr{Tag: ExprVal, Val: n}, Field1: &Expr{Tag: ExprMul, Field0: &Expr{Tag: ExprVal, Val: 2}, Field1: &Expr{Tag: ExprVal, Val: n}}}) > 5, Negative: n2 > 0 && evaluate(&Expr{Tag: ExprAdd, Field0: &Expr{Tag: ExprVal, Val: n2}, Field1: &Expr{Tag: ExprMul, Field0: &Expr{Tag: ExprVal, Val: 2}, Field1: &Expr{Tag: ExprVal, Val: n2}}}) > 5}
}

func evaluate(expr *Expr) int32 {
	switch expr.Tag {
	case ExprVal:
		return expr.Val
	case ExprAdd:
		return evaluate(expr.Field0) + evaluate(expr.Field1)
	case ExprMul:
		return prim.MultiplyInt32(evaluate(expr.Field0), evaluate(expr.Field1))
	default: // ExprSub
		return evaluate(expr.Field0) - evaluate(expr.Field1)
	}
}

func build(n int32) *Expr {
	switch n {
	case 0:
		return &Expr{Tag: ExprVal, Val: 1}
	default:
		exprs := make([]Expr, 5)
		exprs[0] = Expr{Tag: ExprAdd, Field0: &exprs[1], Field1: &exprs[3]}
		exprs[1] = Expr{Tag: ExprMul, Field0: &exprs[2], Field1: build(n - 1)}
		exprs[2] = Expr{Tag: ExprVal, Val: n}
		exprs[3] = Expr{Tag: ExprSub, Field0: build(n - 1), Field1: &exprs[4]}
		exprs[4] = Expr{Tag: ExprVal, Val: 1}
		return &exprs[0]
	}
}

func total(list *ListInt) int32 {
	switch list.Tag {
	case ListIntNil:
		return 0
	default: // ListIntCons
		return list.Cons0 + total(list.Cons1)
	}
}

func mainGo(remaining int32, list *ListInt) *ListInt {
	var listIntCells alloc.Cells[ListInt]
	for {
		if remaining <= 0 {
			return list
		}
		remaining, list = remaining - 1, listIntCells.New(ListInt{Tag: ListIntCons, Cons0: remaining, Cons1: listIntCells.New(ListInt{Tag: ListIntCons, Cons0: prim.MultiplyInt32(remaining, 10), Cons1: list})})
	}
}

func mirrorReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprAdd:
		left := value.Field0
		right := value.Field1
		*value = Expr{Tag: ExprAdd, Field0: mirrorReusing(right), Field1: mirrorReusing(left)}
		return value
	case ExprMul:
		left := value.Field0
		right := value.Field1
		*value = Expr{Tag: ExprMul, Field0: mirrorReusing(right), Field1: mirrorReusing(left)}
		return value
	case ExprSub:
		left := value.Field0
		right := value.Field1
		*value = Expr{Tag: ExprSub, Field0: mirrorReusing(right), Field1: mirrorReusing(left)}
		return value
	default:
		return value
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	Built    int32
	Linked   int32
	Literal  int32
	Mirrored int32
	Two      int32
	Negative bool
	Positive bool
}
