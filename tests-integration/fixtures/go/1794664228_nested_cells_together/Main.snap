// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
)

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int32
	Tag    uint8
}

const (
	ExprVal = iota
	ExprAdd
	ExprMul
	ExprSub
)

type List struct {
	Cons1 *List
	Cons0 int32
}

var sharedListNil = &List{}

func Val(val int32) *Expr {
	return &Expr{Tag: ExprVal, Val: val}
}

func Add(field0 *Expr, field1 *Expr) *Expr {
	return &Expr{Tag: ExprAdd, Field0: field0, Field1: field1}
}

func Mul(field0 *Expr, field1 *Expr) *Expr {
	return &Expr{Tag: ExprMul, Field0: field0, Field1: field1}
}

func main_(n int32) shared.MainResult {
	n2 := -n
	listInts := make([]List, 3)
	listInts[0] = List{Cons0: n, Cons1: &listInts[1]}
	listInts[1] = List{Cons0: 2, Cons1: &listInts[2]}
	listInts[2] = List{Cons0: 3, Cons1: sharedListNil}
	return shared.MainResult{Built: evaluate(build(4)), Mirrored: evaluate(mirrorReusing(build(3))), Two: evaluate(Add(build(2), Val(2))), Linked: total(mainGo(5, sharedListNil)), Literal: total(&listInts[0]), Positive: n > 0 && evaluate(Add(Val(n), Mul(Val(2), Val(n)))) > 5, Negative: n2 > 0 && evaluate(Add(Val(n2), Mul(Val(2), Val(n2)))) > 5}
}

func evaluate(expr *Expr) int32 {
	switch expr.Tag {
	case ExprVal:
		return expr.Val
	case ExprAdd:
		return evaluate(expr.Field0) + evaluate(expr.Field1)
	case ExprMul:
		return evaluate(expr.Field0) * evaluate(expr.Field1)
	default: // ExprSub
		return evaluate(expr.Field0) - evaluate(expr.Field1)
	}
}

func build(n int32) *Expr {
	switch n {
	case 0:
		return Val(1)
	default:
		exprs := make([]Expr, 5)
		exprs[0] = Expr{Tag: ExprAdd, Field0: &exprs[1], Field1: &exprs[3]}
		exprs[1] = Expr{Tag: ExprMul, Field0: &exprs[2], Field1: build(n - 1)}
		exprs[2] = Expr{Tag: ExprVal, Val: n}
		exprs[3] = Expr{Tag: ExprSub, Field0: build(n - 1), Field1: &exprs[4]}
		exprs[4] = Expr{Tag: ExprVal, Val: 1}
		return &exprs[0]
	}
}

func total(list *List) int32 {
	if list == sharedListNil {
		return 0
	}
	return list.Cons0 + total(list.Cons1)
}

func mainGo(remaining int32, list *List) *List {
	var listIntCells alloc.Cells[List]
	for {
		if remaining <= 0 {
			return list
		}
		remaining, list = remaining-1, listIntCells.New(List{Cons0: remaining, Cons1: listIntCells.New(List{Cons0: remaining * 10, Cons1: list})})
	}
}

func mirrorReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprAdd, ExprMul, ExprSub:
		left := value.Field0
		right := value.Field1
		field := mirrorReusing(right)
		field2 := mirrorReusing(left)
		value.Field0 = field
		value.Field1 = field2
		return value
	default:
		return value
	}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Built    int32
	Linked   int32
	Literal  int32
	Mirrored int32
	Two      int32
	Negative bool
	Positive bool
}
