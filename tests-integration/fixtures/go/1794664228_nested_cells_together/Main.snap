// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
)

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int
	Tag    uint8
}

const (
	ExprVal = iota
	ExprAdd
	ExprMul
	ExprSub
)

type List struct {
	Cons1 *List
	Cons0 int32
}

var sharedListNil = &List{}

func Val(val int) *Expr {
	return &Expr{Tag: ExprVal, Val: val}
}

func Cons(cons0 int, cons1 *List) *List {
	return &List{Cons0: int32(cons0), Cons1: cons1}
}

func Mul(field0 *Expr, field1 *Expr) *Expr {
	return &Expr{Tag: ExprMul, Field0: field0, Field1: field1}
}

func main_(n int) shared.MainResult {
	n2 := -n
	return shared.MainResult{Built: evaluate(build(4)), Mirrored: evaluate(mirrorReusing(build(3))), Two: evaluateAdd(build(2), Val(2)), Linked: total(mainGo(5, sharedListNil)), Literal: totalCons(n, Cons(2, Cons(3, sharedListNil))), Positive: n > 0 && evaluateAdd(Val(n), Mul(Val(2), Val(n))) > 5, Negative: n2 > 0 && evaluateAdd(Val(n2), Mul(Val(2), Val(n2))) > 5}
}

func evaluate(expr *Expr) int {
	switch expr.Tag {
	case ExprVal:
		return expr.Val
	case ExprAdd:
		return evaluate(expr.Field0) + evaluate(expr.Field1)
	case ExprMul:
		return evaluate(expr.Field0) * evaluate(expr.Field1)
	default: // ExprSub
		return evaluate(expr.Field0) - evaluate(expr.Field1)
	}
}

func build(n int) *Expr {
	var cells alloc.Cells[Expr]
	return buildChunked(n, &cells)
}

func buildChunked(n int, cells *alloc.Cells[Expr]) *Expr {
	switch n {
	case 0:
		return cells.New(Expr{Tag: ExprVal, Val: 1})
	default:
		return cells.New(Expr{Tag: ExprAdd, Field0: cells.New(Expr{Tag: ExprMul, Field0: cells.New(Expr{Tag: ExprVal, Val: n}), Field1: buildChunked(n-1, cells)}), Field1: cells.New(Expr{Tag: ExprSub, Field0: buildChunked(n-1, cells), Field1: cells.New(Expr{Tag: ExprVal, Val: 1})})})
	}
}

func total(list *List) int {
	if list == sharedListNil {
		return 0
	}
	return int(list.Cons0) + total(list.Cons1)
}

func evaluateAdd(left *Expr, right *Expr) int {
	return evaluate(left) + evaluate(right)
}

func totalCons(value int, rest *List) int {
	return value + total(rest)
}

func mainGo(remaining int, list *List) *List {
	var listIntCells alloc.Cells[List]
	for {
		if remaining <= 0 {
			return list
		}
		remaining, list = remaining-1, listIntCells.New(List{Cons0: int32(remaining), Cons1: listIntCells.New(List{Cons0: int32(remaining * 10), Cons1: list})})
	}
}

func mirrorReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprAdd, ExprMul, ExprSub:
		left := value.Field0
		right := value.Field1
		field := mirrorReusing(right)
		field2 := mirrorReusing(left)
		value.Field0 = field
		value.Field1 = field2
		return value
	default:
		return value
	}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Built    int
	Linked   int
	Literal  int
	Mirrored int
	Two      int
	Negative bool
	Positive bool
}
