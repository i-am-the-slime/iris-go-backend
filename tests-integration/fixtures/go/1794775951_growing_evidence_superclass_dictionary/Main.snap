// Data/Eq/eq.go
package eq

import "github.com/i-am-the-slime/purs-backend-go/go-support/array"

func Eq(i int32, i2 int32) bool {
	return i == i2
}

func EqInt(array2 []int32, array3 []int32) bool {
	return array.Eq(Eq, array2, array3)
}

func Eq2(char rune, char2 rune) bool {
	return char == char2
}

func EqChar(array2 []rune, array3 []rune) bool {
	return array.Eq(Eq2, array2, array3)
}

// Data/Ord/ord.go
package ord

import (
	"fixture/Data/Ordering"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
)

func CompareInt(xs []int32, ys []int32) ordering.Ordering {
	i := direct.CompareArray(func(x int32, y int32) int32 {
		if x < y {
			return 1
		}
		if x == y {
			return 0
		}
		return -1
	}, xs, ys)
	if 0 < i {
		return ordering.OrderingLT
	}
	if 0 == i {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

func CompareChar(xs []rune, ys []rune) ordering.Ordering {
	i := direct.CompareArray(func(x rune, y rune) int32 {
		if x < y {
			return 1
		}
		if x == y {
			return 0
		}
		return -1
	}, xs, ys)
	if 0 < i {
		return ordering.OrderingLT
	}
	if 0 == i {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

// Data/Ordering/ordering.go
package ordering

import "fixture/shared"

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

type Ord struct {
	Eq0     shared.Eq
	Compare func(any) func(any) Ordering
}

// main.go
package main

import (
	"fixture/Data/Eq"
	"fixture/Data/Ord"
	"fixture/Data/Ordering"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	original := func(array []int32) func([]int32) bool {
		return func(array2 []int32) bool {
			return eq.EqInt(array, array2)
		}
	}
	original2 := func(xs []int32) func([]int32) ordering.Ordering {
		return func(ys []int32) ordering.Ordering {
			return ord.CompareInt(xs, ys)
		}
	}
	original3 := func(array []rune) func([]rune) bool {
		return func(array2 []rune) bool {
			return eq.EqChar(array, array2)
		}
	}
	original4 := func(xs []rune) func([]rune) ordering.Ordering {
		return func(ys []rune) ordering.Ordering {
			return ord.CompareChar(xs, ys)
		}
	}
	return []string{relateArrayInt(ordering.Ord{Eq0: shared.Eq{Eq: func(coerced any) func(any) bool {
		original5 := original(shared.Convert(coerced))
		return func(coerced2 any) bool {
			return original5(shared.Convert(coerced2))
		}
	}}, Compare: func(coerced any) func(any) ordering.Ordering {
		original5 := original2(shared.Convert(coerced))
		return func(coerced2 any) ordering.Ordering {
			return original5(shared.Convert(coerced2))
		}
	}}, 1, shared.Convert2([]int32{1}), shared.Convert2([]int32{1, 1})), relateArrayInt(ordering.Ord{Eq0: shared.Eq{Eq: func(coerced any) func(any) bool {
		original5 := original3(shared.Convert3(coerced))
		return func(coerced2 any) bool {
			return original5(shared.Convert3(coerced2))
		}
	}}, Compare: func(coerced any) func(any) ordering.Ordering {
		original5 := original4(shared.Convert3(coerced))
		return func(coerced2 any) ordering.Ordering {
			return original5(shared.Convert3(coerced2))
		}
	}}, 1, shared.Convert4([]rune{'a'}), shared.Convert4([]rune{'b', 'b'}))}
}

func relateArrayInt(ordDictionary ordering.Ord, depth int32, left any, right any) string {
	for {
		ordDictionaryCaptured := ordDictionary
		if depth == 0 {
			if ordDictionaryCaptured.Eq0.Eq(left)(right) {
				return "equal"
			}
			scrutinee := ordDictionaryCaptured.Compare(left)(right)
			switch scrutinee {
			case ordering.OrderingLT:
				return "LT"
			case ordering.OrderingGT:
				return "GT"
			default: // ordering.OrderingEQ
				return "EQ"
			}
		}
		depth2 := depth
		original := func(array2 []any) func([]any) bool {
			return func(array3 []any) bool {
				return array.Eq(func(argument any, argument2 any) bool {
					return ordDictionaryCaptured.Eq0.Eq(argument)(argument2)
				}, array2, array3)
			}
		}
		original2 := func(xs []any) func([]any) ordering.Ordering {
			return func(ys []any) ordering.Ordering {
				i := direct.CompareArray(func(x any, y any) int32 {
					scrutinee := ordDictionaryCaptured.Compare(x)(y)
					switch scrutinee {
					case ordering.OrderingEQ:
						return 0
					case ordering.OrderingLT:
						return 1
					default: // ordering.OrderingGT
						return -1
					}
				}, xs, ys)
				if 0 < i {
					return ordering.OrderingLT
				}
				if 0 == i {
					return ordering.OrderingEQ
				}
				return ordering.OrderingGT
			}
		}
		ordDictionary, depth, left, right = ordering.Ord{Eq0: shared.Eq{Eq: func(coerced any) func(any) bool {
			original3 := original(coerced.([]any))
			return func(coerced2 any) bool {
				return original3(coerced2.([]any))
			}
		}}, Compare: func(coerced any) func(any) ordering.Ordering {
			original3 := original2(coerced.([]any))
			return func(coerced2 any) ordering.Ordering {
				return original3(coerced2.([]any))
			}
		}}, depth2 - 1, []any{left}, []any{right, right}
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

func Convert(value any) []int32 {
	array := value.([]any)
	converted := make([]int32, len(array))
	for index, element := range array {
		converted[index] = element.(int32)
	}
	return converted
}

type Eq struct {
	Eq func(any) func(any) bool
}

func Convert2(value []int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}

func Convert3(value any) []rune {
	array := value.([]any)
	converted := make([]rune, len(array))
	for index, element := range array {
		converted[index] = element.(rune)
	}
	return converted
}

func Convert4(value []rune) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}
