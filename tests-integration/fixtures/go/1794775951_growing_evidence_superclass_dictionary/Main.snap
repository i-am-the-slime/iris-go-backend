// Data/Eq/eq.go
package eq

import "github.com/i-am-the-slime/iris-go/array"

func EqInt(i int, i2 int) bool {
	return i == i2
}

func EqArrayInt(array2 []int, array3 []int) bool {
	return array.Eq(EqInt, array2, array3)
}

func EqChar(char rune, char2 rune) bool {
	return char == char2
}

func EqArrayChar(array2 []rune, array3 []rune) bool {
	return array.Eq(EqChar, array2, array3)
}

// Data/Ord/ord.go
package ord

import (
	"fixture/Data/Ordering"
	"github.com/i-am-the-slime/iris-go/direct"
)

func CompareInt(xs []int, ys []int) ordering.Ordering {
	i := direct.CompareArray(func(x int, y int) int {
		if x < y {
			return 1
		}
		if x == y {
			return 0
		}
		return -1
	}, xs, ys)
	if 0 < i {
		return ordering.OrderingLT
	}
	if 0 == i {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

func CompareChar(xs []rune, ys []rune) ordering.Ordering {
	i := direct.CompareArray(func(x rune, y rune) int {
		if x < y {
			return 1
		}
		if x == y {
			return 0
		}
		return -1
	}, xs, ys)
	if 0 < i {
		return ordering.OrderingLT
	}
	if 0 == i {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

func Show(ordering Ordering) string {
	switch ordering {
	case OrderingLT:
		return "LT"
	case OrderingGT:
		return "GT"
	default: // OrderingEQ
		return "EQ"
	}
}

// main.go
package main

import (
	dataeq "fixture/Data/Eq"
	"fixture/Data/Ord"
	"fixture/Data/Ordering"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	original := func(array []int) func([]int) bool {
		return func(array2 []int) bool {
			return dataeq.EqArrayInt(array, array2)
		}
	}
	original2 := func(xs []int) func([]int) ordering.Ordering {
		return func(ys []int) ordering.Ordering {
			return ord.CompareInt(xs, ys)
		}
	}
	original3 := func(array []rune) func([]rune) bool {
		return func(array2 []rune) bool {
			return dataeq.EqArrayChar(array, array2)
		}
	}
	original4 := func(xs []rune) func([]rune) ordering.Ordering {
		return func(ys []rune) ordering.Ordering {
			return ord.CompareChar(xs, ys)
		}
	}
	return []string{relateOrdDictionaryEq0(func(coerced any) func(any) bool {
		original5 := original(shared.Convert(coerced))
		return func(coerced2 any) bool {
			return original5(shared.Convert(coerced2))
		}
	}, func(coerced any) func(any) ordering.Ordering {
		original5 := original2(shared.Convert(coerced))
		return func(coerced2 any) ordering.Ordering {
			return original5(shared.Convert(coerced2))
		}
	}, 1, shared.Convert2([]int{1}), shared.Convert2([]int{1, 1})), relateOrdDictionaryEq0(func(coerced any) func(any) bool {
		original5 := original3(shared.Convert3(coerced))
		return func(coerced2 any) bool {
			return original5(shared.Convert3(coerced2))
		}
	}, func(coerced any) func(any) ordering.Ordering {
		original5 := original4(shared.Convert3(coerced))
		return func(coerced2 any) ordering.Ordering {
			return original5(shared.Convert3(coerced2))
		}
	}, 1, shared.Convert4([]rune{'a'}), shared.Convert4([]rune{'b', 'b'}))}
}

func relateOrdDictionaryEq0(eq func(any) func(any) bool, compare func(any) func(any) ordering.Ordering, depth int, left any, right any) string {
	for {
		eqCaptured := eq
		compareCaptured := compare
		if depth == 0 {
			if eqCaptured(left)(right) {
				return "equal"
			}
			return ordering.Show(compareCaptured(left)(right))
		}
		original := func(array2 []any) func([]any) bool {
			return func(array3 []any) bool {
				return array.Eq(func(argument any, argument2 any) bool {
					return eqCaptured(argument)(argument2)
				}, array2, array3)
			}
		}
		original2 := func(xs []any) func([]any) ordering.Ordering {
			return func(ys []any) ordering.Ordering {
				i := direct.CompareArray(func(x any, y any) int {
					scrutinee := compareCaptured(x)(y)
					switch scrutinee {
					case ordering.OrderingEQ:
						return 0
					case ordering.OrderingLT:
						return 1
					default: // ordering.OrderingGT
						return -1
					}
				}, xs, ys)
				if 0 < i {
					return ordering.OrderingLT
				}
				if 0 == i {
					return ordering.OrderingEQ
				}
				return ordering.OrderingGT
			}
		}
		eq, compare, depth, left, right = func(coerced any) func(any) bool {
			original3 := original(coerced.([]any))
			return func(coerced2 any) bool {
				return original3(coerced2.([]any))
			}
		}, func(coerced any) func(any) ordering.Ordering {
			original3 := original2(coerced.([]any))
			return func(coerced2 any) ordering.Ordering {
				return original3(coerced2.([]any))
			}
		}, depth-1, []any{left}, []any{right, right}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value any) []int {
	array := value.([]any)
	converted := make([]int, len(array))
	for index, element := range array {
		converted[index] = element.(int)
	}
	return converted
}

func Convert2(value []int) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}

func Convert3(value any) []rune {
	array := value.([]any)
	converted := make([]rune, len(array))
	for index, element := range array {
		converted[index] = element.(rune)
	}
	return converted
}

func Convert4(value []rune) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}

// note: Main.relate takes its Ord dictionary at run time, because polymorphic recursion reaches it at ever larger types; only this definition is slower
