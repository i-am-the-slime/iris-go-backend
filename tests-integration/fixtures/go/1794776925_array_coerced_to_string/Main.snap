// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() string {
	return "letters: " + strings.Join([]string{"a", "b", "c"}, ",") + "; nested: " + strings.Join(array.Map(func(element []string) string {
		return strings.Join(element, ",")
	}, [][]string{{"d", "e"}, {"f"}}), ",")
}

func main() {
	console.Print(main_)
}
