// Control/Category/category.go
package category

func Identity(x struct{}) {
}

// Data/Foldable/foldable.go
package foldable

import (
	"fixture/Control/Category"
	"github.com/i-am-the-slime/iris-go/array"
)

func Traverse_F(array2 []int) []struct{} {
	function2 := func(x int) func([]struct{}) []struct{} {
		a := []int{x, x + 1}
		return func(b []struct{}) []struct{} {
			mapped := make([]func(struct{}), len(a))
			for index := range a {
				mapped[index] = category.Identity
			}
			units := make([]struct{}, len(mapped)*len(b))
			for _, function := range mapped {
				for _, value := range b {
					function(value)
				}
			}
			return units
		}
	}
	return array.Foldr(func(i int, array []struct{}) []struct{} {
		return function2(i)(array)
	}, []struct{}{{}}, array2)
}

// Data/Show/show.go
package show

func AppendShowArrayUnit(buffer []byte, array []struct{}) []byte {
	buffer = append(buffer, '[')
	for index := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = append(buffer, "unit"...)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayUnit(array []struct{}) string {
	return string(AppendShowArrayUnit(nil, array))
}

// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  int32
	Second int32
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Foldable"
	"fixture/Data/Show"
	journal "fixture/Journal_ffi"
)

func main() {
	journal.Log(show.ArrayUnit(foldable.Traverse_F([]int{1, 2})))
	array := []int{1, 2, 3}
	accumulator := []struct{}{{}}
	for index2 := len(array) - 1; index2 >= 0; index2-- {
		x := array[index2]
		array2 := []int{x}
		mapped := make([]func(struct{}), len(array2))
		for index := range array2 {
			mapped[index] = category.Identity
		}
		units := make([]struct{}, len(mapped)*len(accumulator))
		for _, function := range mapped {
			for _, value := range accumulator {
				function(value)
			}
		}
		accumulator = units
	}
	journal.Log(show.ArrayUnit(accumulator))
	array3 := [][]int{{1}, {2, 3}}
	accumulator2 := []struct{}{{}}
	for index := len(array3) - 1; index >= 0; index-- {
		x := array3[index]
		mapped := make([]func(struct{}), len(x))
		for index2 := range x {
			mapped[index2] = category.Identity
		}
		units := make([]struct{}, len(mapped)*len(accumulator2))
		for _, function := range mapped {
			for _, value := range accumulator2 {
				function(value)
			}
		}
		accumulator2 = units
	}
	journal.Log(show.ArrayUnit(accumulator2))
	array4 := []int{5, 6}
	accumulator3 := []struct{}{{}}
	for index := len(array4) - 1; index >= 0; index-- {
		i := array4[index]
		array2 := []int{index, i}
		mapped := make([]func(struct{}), len(array2))
		for index2 := range array2 {
			mapped[index2] = category.Identity
		}
		units := make([]struct{}, len(mapped)*len(accumulator3))
		for _, function := range mapped {
			for _, value := range accumulator3 {
				function(value)
			}
		}
		accumulator3 = units
	}
	journal.Log(show.ArrayUnit(accumulator3))
	functions := []func(int){func(_ int) {
	}, func(_ int) {
	}}
	values := []int{1, 2, 3}
	units2 := make([]struct{}, len(functions)*len(values))
	for _, function := range functions {
		for _, value := range values {
			function(value)
		}
	}
	journal.Log(show.ArrayUnit(units2))
}
