// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int
}

var sharedTreeLeaf = &Tree{}

func Node(node0 *Tree, node1 int, node2 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: node1, Node2: node2}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	full := fullTreeIsBuiltFromOneChunk(4)
	argument := total(full)
	return []int{argument, total(inspectedResultIsNotChunked(4)), total(insertCopiesItsPathCellByCell(5, full)), total(full)}
}

func fullTreeIsBuiltFromOneChunk(depth int) *Tree {
	var cells alloc.Cells[Tree]
	return fullTreeIsBuiltFromOneChunkChunked(depth, &cells)
}

func fullTreeIsBuiltFromOneChunkChunked(depth int, cells *alloc.Cells[Tree]) *Tree {
	if depth == 0 {
		return sharedTreeLeaf
	}
	return cells.New(Tree{Node0: fullTreeIsBuiltFromOneChunkChunked(depth-1, cells), Node1: depth, Node2: fullTreeIsBuiltFromOneChunkChunked(depth-1, cells)})
}

func total(value *Tree) int {
	if value == sharedTreeLeaf {
		return 0
	}
	return total(value.Node0) + value.Node1 + total(value.Node2)
}

func inspectedResultIsNotChunked(depth int) *Tree {
	if depth == 0 {
		return sharedTreeLeaf
	}
	scrutinee := inspectedResultIsNotChunked(depth - 1)
	if scrutinee != sharedTreeLeaf {
		scrutinee.Node1 = depth
		scrutinee.Node2 = sharedTreeLeaf
		return scrutinee
	}
	return Node(sharedTreeLeaf, depth, sharedTreeLeaf)
}

func insertCopiesItsPathCellByCell(value int, value2 *Tree) *Tree {
	if value2 == sharedTreeLeaf {
		return Node(sharedTreeLeaf, value, sharedTreeLeaf)
	}
	left := value2.Node0
	key := value2.Node1
	right := value2.Node2
	if value < key {
		return Node(insertCopiesItsPathCellByCell(value, left), key, right)
	}
	return Node(left, key, insertCopiesItsPathCellByCell(value, right))
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
