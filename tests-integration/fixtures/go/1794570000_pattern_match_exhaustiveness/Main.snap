// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

type String struct {
	Just string
	Tag  uint8
}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type Light uint8

const (
	LightRed Light = iota
	LightAmber
	LightGreen
)

type Shape struct {
	Circle     int
	Rectangle0 int
	Rectangle1 int
	Tag        uint8
}

const (
	ShapeCircle = iota
	ShapeRectangle
)

func Circle(circle int) Shape {
	return Shape{Tag: ShapeCircle, Circle: circle}
}

func Rectangle(rectangle0 int, rectangle1 int) Shape {
	return Shape{Tag: ShapeRectangle, Rectangle0: rectangle0, Rectangle1: rectangle1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []Light{LightRed, LightAmber, LightGreen}
	mapped := make([]string, len(array))
	for index, element := range array {
		mapped[index] = name(element)
	}
	array2 := []Shape{Circle(1), Rectangle(2, 3)}
	mapped2 := make([]string, len(array2))
	for index, x := range array2 {
		var result int
		switch x.Tag {
		case ShapeCircle:
			radius := x.Circle
			result = 3 * radius * radius
		default: // ShapeRectangle
			result = x.Rectangle0 * x.Rectangle1
		}
		mapped2[index] = strconv.Itoa(result)
	}
	array3 := []maybe.Int{maybe.JustInt(2), maybe.NoInt}
	mapped3 := make([]string, len(array3))
	for index := range array3 {
		var result int
		switch array3[index].Tag {
		case maybe.TagJust:
			result = 1 + array3[index].Just
		default: // maybe.TagNothing
			result = 1
		}
		mapped3[index] = strconv.Itoa(result)
	}
	array4 := []string{"start", "jump"}
	mapped4 := make([]string, len(array4))
	for index, x := range array4 {
		var result int
		switch x {
		case "start":
			result = 1
		case "stop":
			result = 2
		default:
			result = 0
		}
		mapped4[index] = strconv.Itoa(result)
	}
	array5 := []int{500, 5}
	mapped5 := make([]string, len(array5))
	for index, number := range array5 {
		var result string
		if number > 100 {
			result = "huge"
		} else {
			result = "large"
		}
		mapped5[index] = result
	}
	array6 := []shared.LeftRight{{Left: 1, Right: 2}}
	mapped6 := make([]string, len(array6))
	for index := range array6 {
		mapped6[index] = strconv.Itoa(array6[index].Left + array6[index].Right)
	}
	array7 := []maybe.String{maybe.JustString("here")}
	mapped7 := make([]string, len(array7))
	for index := range array7 {
		var result string
		switch array7[index].Tag {
		case maybe.TagJust:
			result = array7[index].Just
		default:
			panic("Failed pattern match")
		}
		mapped7[index] = result
	}
	return arraypkg.Append(mapped, arraypkg.Append(mapped2, arraypkg.Append(mapped3, arraypkg.Append(mapped4, arraypkg.Append(mapped5, arraypkg.Append(mapped6, mapped7))))))
}

func name(value Light) string {
	switch value {
	case LightRed:
		return "red"
	case LightAmber:
		return "amber"
	default: // LightGreen
		return "green"
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type LeftRight struct {
	Left  int
	Right int
}
