// Data/Maybe/maybe.go
package maybe

type MaybeInt struct {
	Just int32
	Tag  uint8
}

const (
	MaybeIntNothing = iota
	MaybeIntJust
)

type MaybeString struct {
	Just string
	Tag  uint8
}

const (
	MaybeStringNothing = iota
	MaybeStringJust
)

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Light uint8

const (
	LightRed Light = iota
	LightAmber
	LightGreen
)

type Shape struct {
	Circle     int32
	Rectangle0 int32
	Rectangle1 int32
	Tag        uint8
}

const (
	ShapeCircle = iota
	ShapeRectangle
)

type LeftRight struct {
	Left  int32
	Right int32
}

var main_ = initializeMain_()

func initializeMain_() []string {
	array2 := []Light{LightRed, LightAmber, LightGreen}
	mapped := make([]string, len(array2))
	for index, element := range array2 {
		mapped[index] = name(element)
	}
	array3 := []Shape{Shape{Tag: ShapeCircle, Circle: 1}, Shape{Tag: ShapeRectangle, Rectangle0: 2, Rectangle1: 3}}
	mapped2 := make([]string, len(array3))
	for index2 := range array3 {
		var result int32
		switch array3[index2].Tag {
		case ShapeCircle:
			radius := array3[index2].Circle
			result = prim.MultiplyInt32(prim.MultiplyInt32(3, radius), radius)
		default: // ShapeRectangle
			result = prim.MultiplyInt32(array3[index2].Rectangle0, array3[index2].Rectangle1)
		}
		mapped2[index2] = prim.ShowInt(result)
	}
	array4 := []maybe.MaybeInt{maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just: 2}, maybe.MaybeInt{Tag: maybe.MaybeIntNothing}}
	mapped3 := make([]string, len(array4))
	for index3 := range array4 {
		var result2 int32
		switch array4[index3].Tag {
		case maybe.MaybeIntJust:
			result2 = 1 + array4[index3].Just
		default: // maybe.MaybeIntNothing
			result2 = 1
		}
		mapped3[index3] = prim.ShowInt(result2)
	}
	array5 := []string{"start", "jump"}
	mapped4 := make([]string, len(array5))
	for index4, x3 := range array5 {
		var result3 int32
		switch x3 {
		case "start":
			result3 = 1
		case "stop":
			result3 = 2
		default:
			result3 = 0
		}
		mapped4[index4] = prim.ShowInt(result3)
	}
	array6 := []int32{500, 5}
	mapped5 := make([]string, len(array6))
	for index5, number := range array6 {
		var result4 string
		if number > 100 {
			result4 = "huge"
		} else {
			result4 = "large"
		}
		mapped5[index5] = result4
	}
	array7 := []LeftRight{LeftRight{Left: 1, Right: 2}}
	mapped6 := make([]string, len(array7))
	for index6 := range array7 {
		mapped6[index6] = prim.ShowInt(array7[index6].Left + array7[index6].Right)
	}
	array8 := []maybe.MaybeString{maybe.MaybeString{Tag: maybe.MaybeStringJust, Just: "here"}}
	mapped7 := make([]string, len(array8))
	for index7 := range array8 {
		var result5 string
		switch array8[index7].Tag {
		case maybe.MaybeStringJust:
			result5 = array8[index7].Just
		default:
			panic("Failed pattern match")
		}
		mapped7[index7] = result5
	}
	return array.Append(mapped, array.Append(mapped2, array.Append(mapped3, array.Append(mapped4, array.Append(mapped5, array.Append(mapped6, mapped7))))))
}

func name(value Light) string {
	switch value {
	case LightRed:
		return "red"
	case LightAmber:
		return "amber"
	default: // LightGreen
		return "green"
	}
}

func main() {
	fmt.Println(main_)
}
