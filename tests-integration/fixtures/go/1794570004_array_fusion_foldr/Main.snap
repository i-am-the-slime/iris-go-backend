// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

type MainResult struct {
	OverFilter string
	OverMap    string
	LastSmall  Int
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() maybe.MainResult {
	accumulator := ""
	for index := len(numbers) - 1; index >= 0; index-- {
		value := numbers[index]
		x := value * 2
		accumulator = strconv.Itoa(x) + "," + accumulator
	}
	kept := []int{}
	for _, value := range numbers {
		if value > 2 {
			kept = append(kept, value)
		}
	}
	accumulator2 := ""
	for index := len(kept) - 1; index >= 0; index-- {
		x := kept[index]
		accumulator2 = strconv.Itoa(x) + ";" + accumulator2
	}
	found := maybe.NoInt
	for index := len(numbers) - 1; index >= 0; index-- {
		value := numbers[index]
		value2 := value * 2
		if value2 < 5 {
			found = maybe.JustInt(index)
			break
		}
	}
	return maybe.MainResult{OverMap: accumulator, OverFilter: accumulator2, LastSmall: found}
}

var numbers []int = []int{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	_ = main_
}

// note: the entry's value of type { lastSmall, overFilter, overMap } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
