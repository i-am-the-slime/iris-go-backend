// Data/Maybe/maybe.go
package maybe

type MaybeInt struct {
	Just0 int32
	Tag   uint8
}

const (
	MaybeIntNothing = iota
	MaybeIntJust
)

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type LastSmallOverFilterOverMap struct {
	LastSmall  maybe.MaybeInt
	OverFilter string
	OverMap    string
}

var main_ = initializeMain_()

func initializeMain_() LastSmallOverFilterOverMap {
	accumulator := ""
	for index := len(numbers) - 1; index >= 0; index-- {
		value := numbers[index]
		x := prim.MultiplyInt32(value, 2)
		rest := accumulator
		accumulator = prim.ShowInt(int(x)) + "," + rest
	}
	kept := []int32{}
	for _, value2 := range numbers {
		if value2 > 2 {
			kept = append(kept, value2)
		}
	}
	accumulator2 := ""
	for index2 := len(kept) - 1; index2 >= 0; index2-- {
		x2 := kept[index2]
		rest2 := accumulator2
		accumulator2 = prim.ShowInt(int(x2)) + ";" + rest2
	}
	found := maybe.MaybeInt{Tag: maybe.MaybeIntNothing}
	for index3 := len(numbers) - 1; index3 >= 0; index3-- {
		value3 := numbers[index3]
		value4 := prim.MultiplyInt32(value3, 2)
		if value4 < 5 {
			found = maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just0: int32(index3)}
			break
		}
	}
	return LastSmallOverFilterOverMap{OverMap: accumulator, OverFilter: accumulator2, LastSmall: found}
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	fmt.Println(main_)
}
