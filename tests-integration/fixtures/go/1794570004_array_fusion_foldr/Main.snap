// Data/Maybe/maybe.go
package maybe

type MaybeInt struct {
	Just int32
	Tag  uint8
}

const (
	MaybeIntNothing = iota
	MaybeIntJust
)

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type MainResult struct {
	OverFilter string
	OverMap    string
	LastSmall  maybe.MaybeInt
}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	accumulator := ""
	for index := len(numbers) - 1; index >= 0; index-- {
		value := numbers[index]
		x := prim.MultiplyInt32(value, 2)
		rest := accumulator
		accumulator = prim.ShowInt(x) + "," + rest
	}
	kept := []int32{}
	for _, value := range numbers {
		if value > 2 {
			kept = append(kept, value)
		}
	}
	accumulator2 := ""
	for index := len(kept) - 1; index >= 0; index-- {
		x := kept[index]
		rest := accumulator2
		accumulator2 = prim.ShowInt(x) + ";" + rest
	}
	found := maybe.MaybeInt{Tag: maybe.MaybeIntNothing}
	for index := len(numbers) - 1; index >= 0; index-- {
		value := numbers[index]
		value2 := prim.MultiplyInt32(value, 2)
		if value2 < 5 {
			found = maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just: int32(index)}
			break
		}
	}
	return MainResult{OverMap: accumulator, OverFilter: accumulator2, LastSmall: found}
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	fmt.Println(main_)
}
