// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

type MainResult struct {
	OverFilter string
	OverMap    string
	LastSmall  Int
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() maybe.MainResult {
	defer exception.ReportUncaught()
	accumulator := ""
	for index := len(numbers) - 1; index >= 0; index-- {
		value := numbers[index]
		x := value * 2
		accumulator = prim.ShowInt(x) + "," + accumulator
	}
	kept := []int32{}
	for _, value := range numbers {
		if value > 2 {
			kept = append(kept, value)
		}
	}
	accumulator2 := ""
	for index := len(kept) - 1; index >= 0; index-- {
		x := kept[index]
		accumulator2 = prim.ShowInt(x) + ";" + accumulator2
	}
	found := maybe.NoInt
	for index := len(numbers) - 1; index >= 0; index-- {
		value := numbers[index]
		value2 := value * 2
		if value2 < 5 {
			found = maybe.Int(int32(index))
			break
		}
	}
	return maybe.MainResult{OverMap: accumulator, OverFilter: accumulator2, LastSmall: found}
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	fmt.Println(main_)
}
