// Data/Either/either.go
package either

type EitherStringVal struct {
	Left  string
	Right any
	Tag   uint8
}

const (
	EitherStringValLeft = iota
	EitherStringValRight
)

func Left(left string) EitherStringVal {
	return EitherStringVal{Tag: EitherStringValLeft, Left: left}
}

// Data/Void/void.go
package void

type Void struct{}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Void"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []either.EitherStringVal{either.Left("no"), either.Left("void")}
	built := make([]string, len(array)+1)
	built[0] = "2"
	for index, element := range array {
		built[index+1] = describe(element)
	}
	return built
}

func describe(either2 either.EitherStringVal) string {
	switch either2.Tag {
	case either.EitherStringValLeft:
		return either2.Left
	default: // either.EitherStringValRight
		return describeSpin(either2.Right.(void.Void))
	}
}

func describeSpin(void void.Void) string {
	for {
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
