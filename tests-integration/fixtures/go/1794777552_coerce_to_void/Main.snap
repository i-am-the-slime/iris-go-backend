// Data/Either/either.go
package either

type EitherStringVal struct {
	Left  string
	Right any
	Tag   uint8
}

const (
	EitherStringValLeft = iota
	EitherStringValRight
)

// Data/Void/void.go
package void

type Void struct{}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Void"
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array2 := []either.EitherStringVal{either.EitherStringVal{Tag: either.EitherStringValLeft, Left: "no"}, either.EitherStringVal{Tag: either.EitherStringValLeft, Left: "void"}}
	mapped := make([]string, len(array2))
	for index, element := range array2 {
		mapped[index] = describe(element)
	}
	return array.Append([]string{prim.ShowInt(2)}, mapped)
}

func describe(either2 either.EitherStringVal) string {
	switch either2.Tag {
	case either.EitherStringValLeft:
		return either2.Left
	default: // either.EitherStringValRight
		return describeSpin(either2.Right.(void.Void))
	}
}

func describeSpin(void void.Void) string {
	for {
	}
}

func main() {
	fmt.Println(main_)
}
