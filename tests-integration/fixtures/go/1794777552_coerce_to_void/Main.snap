// Data/Either/either.go
package either

type EitherStringVal struct {
	Left  string
	Right any
	Tag   uint8
}

const (
	EitherStringValLeft = iota
	EitherStringValRight
)

// Data/Void/void.go
package void

type Void struct{}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Void"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array := []either.EitherStringVal{{Tag: either.EitherStringValLeft, Left: "no"}, {Tag: either.EitherStringValLeft, Left: "void"}}
	mapped := make([]string, len(array))
	for index, element := range array {
		mapped[index] = describe(element)
	}
	return arraypkg.Append([]string{"2"}, mapped)
}

func describe(either2 either.EitherStringVal) string {
	switch either2.Tag {
	case either.EitherStringValLeft:
		return either2.Left
	default: // either.EitherStringValRight
		return describeSpin(either2.Right.(void.Void))
	}
}

func describeSpin(void void.Void) string {
	for {
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
