// Data/Either/either.go
package either

type Either struct {
	Left  string
	Right any
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type StringFailure struct {
	Failed bool
	Left   string
}

func Left(left string) Either {
	return Either{Tag: EitherLeft, Left: left}
}

func EitherFailure(either Either) StringFailure {
	if either.Tag == EitherLeft {
		return StringFailure{Failed: true, Left: either.Left}
	}
	return StringFailure{}
}

// Data/Void/void.go
package void

type Void any

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Void"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []either.Either{either.Left("no"), either.Left("void")}
	built := make([]string, len(array)+1)
	built[0] = "2"
	for index, element := range array {
		built[index+1] = describe(element.Right, either.EitherFailure(element))
	}
	return built
}

func describe(argument any, err either.StringFailure) string {
	if err.Failed {
		return err.Left
	}
	return describeSpin(argument)
}

func describeSpin(void void.Void) string {
	for {
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
