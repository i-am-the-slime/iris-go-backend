// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"os"
)

func main_() int32 {
	var ref int32 = 1
	i := ref
	s_ := ref + 1
	ref = s_
	scrutinee := i > 5
	if scrutinee {
		panic(exception.NewError("too many"))
	}
	var result int32
	if i > 100 {
		panic("too large")
	} else {
		result = prim.MultiplyInt32(i, 2)
	}
	return result
}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
