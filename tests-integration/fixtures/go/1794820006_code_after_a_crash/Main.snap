// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

func main_() int32 {
	var count int32 = 1
	seen := count
	s_ := count + 1
	count = s_
	if seen > 5 {
		panic(exception.NewError("too many"))
	}
	var result int32
	if seen > 100 {
		panic("too large")
	} else {
		result = seen * 2
	}
	return result
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
