// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

func main_() int {
	count := 1
	seen := count
	count += 1
	if seen > 5 {
		panic(exception.NewError("too many"))
	}
	var result int
	if seen > 100 {
		panic("too large")
	} else {
		result = seen * 2
	}
	return result
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
