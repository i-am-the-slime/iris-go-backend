// main.go
package main

import (
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []int32{1, 2}
	mapped := make([]string, len(array))
	for index, value := range array {
		mapped[index] = opsForLeft.Describe(opsForLeft.Double(value))
	}
	array2 := []int32{3}
	mapped2 := make([]string, len(array2))
	for index, value := range array2 {
		mapped2[index] = opsForLeft.Describe(opsForLeft.Double(value))
	}
	return arraypkg.Append(mapped, mapped2)
}

var opsForLeft shared.Ops = shared.Ops{Double: func(n int32) int32 {
	return n * 2
}, Describe: func(n int32) string {
	return "n = " + strconv.Itoa(int(n))
}}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Ops struct {
	Describe func(int32) string
	Double   func(int32) int32
}
