// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array2 := []int32{1, 2}
	mapped := make([]string, len(array2))
	for index, value := range array2 {
		mapped[index] = opsForLeft.Describe(opsForLeft.Double(value))
	}
	array3 := []int32{3}
	mapped2 := make([]string, len(array3))
	for index, value := range array3 {
		mapped2[index] = opsForLeft.Describe(opsForLeft.Double(value))
	}
	return array.Append(mapped, mapped2)
}

var opsForLeft shared.Ops = shared.Ops{Double: func(n int32) int32 {
	return prim.MultiplyInt32(n, 2)
}, Describe: func(n int32) string {
	return "n = " + prim.ShowInt(n)
}}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type Ops struct {
	Describe func(int32) string
	Double   func(int32) int32
}
