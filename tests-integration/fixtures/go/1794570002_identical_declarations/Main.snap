// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{opsForLeft.Describe(opsForLeft.Double(1)), opsForLeft.Describe(opsForLeft.Double(2)), opsForLeft.Describe(opsForLeft.Double(3))}
}

var opsForLeft shared.Ops = shared.Ops{Double: func(n int) int {
	return n * 2
}, Describe: func(n int) string {
	return "n = " + strconv.Itoa(n)
}}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Ops struct {
	Describe func(int) string
	Double   func(int) int
}
