// Data/Maybe/maybe.go
package maybe

import "strconv"

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

func Show(maybe Int) string {
	return string(AppendShow(nil, maybe))
}

func AppendShowArrayMaybeInt(buffer []byte, array []Int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShow(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShow(buffer []byte, maybe Int) []byte {
	switch maybe.Tag {
	case TagJust:
		buffer = append(buffer, "(Just "...)
		buffer = strconv.AppendInt(buffer, int64(maybe.Just), 10)
		buffer = append(buffer, ')')
	default: // TagNothing
		buffer = append(buffer, "Nothing"...)
	}
	return buffer
}

func ArrayMaybeInt(array []Int) string {
	return string(AppendShowArrayMaybeInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	journal "fixture/Journal_ffi"
	"strconv"
)

func main() {
	journal.Log(mainGoJust(0, 0))
	journal.Log(maybe.ArrayMaybeInt(stepsBelowJust(10, 0, 0)))
}

func stepsBelowJust(limit int, n int, steps int) []maybe.Int {
	for {
		if n >= limit {
			return []maybe.Int{maybe.JustInt(n), maybe.JustInt(steps)}
		}
		n, steps = n+2, steps+1
	}
}

func mainGoJust(n int, total int) string {
	for {
		if n >= 1000 {
			return strconv.Itoa(total) + " at (Just " + strconv.Itoa(n) + ")"
		}
		n, total = n+1, total+n
	}
}
