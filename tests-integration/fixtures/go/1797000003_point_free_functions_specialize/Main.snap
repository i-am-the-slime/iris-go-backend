// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{show.ArrayInt(sortByCompare(numbers)), show.ArrayInt(sortByDescending(numbers)), show.ArrayInt(sortByCompare([]int{}))}
}

var numbers []int = []int{7, 3, 9, 1, 4, 8, 2, 6, 5, 0}

func sortByCompare(xs []int) []int {
	result := array.Thaw(xs)
	length := len(*result)
	sortByCompareInsertFrom(*result, 1, length)
	return shared.Frozen(*result)
}

func sortByDescending(xs []int) []int {
	result := array.Thaw(xs)
	length := len(*result)
	sortByDescendingInsertFrom(*result, 1, length)
	return shared.Frozen(*result)
}

func sortByCompareInsertFrom(array []int, i int, length int) {
	for {
		if i < length {
			var i2 int = i
		sortByIntCompareSink:
			for {
				if i2 > 0 {
					index := i2 - 1
					var peeked maybe.Int
					peeked = maybe.JustInt(array[index])
					var peeked2 maybe.Int
					peeked2 = maybe.JustInt(array[i2])
					if peeked.Tag == maybe.TagJust && peeked2.Tag == maybe.TagJust {
						x := peeked.Just
						y := peeked2.Just
						if x > y {
							index2 := i2 - 1
							array[index2] = y
							array[i2] = x
							i2 -= 1
							continue
						}
					}
					break sortByIntCompareSink
				}
				break sortByIntCompareSink
			}
			i += 1
			continue
		}
		return
	}
}

func sortByDescendingInsertFrom(array []int, i int, length int) {
	for {
		if i < length {
			var i2 int = i
		sortByIntDescendingSink:
			for {
				if i2 > 0 {
					index := i2 - 1
					var peeked maybe.Int
					peeked = maybe.JustInt(array[index])
					var peeked2 maybe.Int
					peeked2 = maybe.JustInt(array[i2])
					if peeked.Tag == maybe.TagJust && peeked2.Tag == maybe.TagJust {
						x := peeked.Just
						y := peeked2.Just
						if y > x {
							index2 := i2 - 1
							array[index2] = y
							array[i2] = x
							i2 -= 1
							continue
						}
					}
					break sortByIntDescendingSink
				}
				break sortByIntDescendingSink
			}
			i += 1
			continue
		}
		return
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
