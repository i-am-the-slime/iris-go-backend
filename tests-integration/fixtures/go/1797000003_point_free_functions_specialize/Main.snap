// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{string(show.AppendShowArrayInt(nil, sortByIntCompare(numbers))), string(show.AppendShowArrayInt(nil, sortByIntDescending(numbers))), string(show.AppendShowArrayInt(nil, sortByIntCompare([]int32{})))}
}

var numbers []int32 = []int32{7, 3, 9, 1, 4, 8, 2, 6, 5, 0}

func sortByIntCompare(xs []int32) []int32 {
	array2 := array.Thaw(xs)()
	i := int32(len(*array2))
	sortByIntCompareInsertFrom(array2, 1, i)
	performed := shared.Frozen(*array2)
	return performed
}

func sortByIntDescending(xs []int32) []int32 {
	array2 := array.Thaw(xs)()
	i := int32(len(*array2))
	sortByIntDescendingInsertFrom(array2, 1, i)
	performed := shared.Frozen(*array2)
	return performed
}

func sortByIntCompareInsertFrom(array *[]int32, i int32, length int32) {
	array2 := *array
	for {
		if i < length {
			var i2 int32 = i
		sortByIntCompareSink:
			for {
				if i2 > 0 {
					index := i2 - 1
					var peeked maybe.Int
					peeked = maybe.Int(array2[index])
					var peeked2 maybe.Int
					peeked2 = maybe.Int(array2[i2])
					if peeked != maybe.NoInt && peeked2 != maybe.NoInt {
						x := int32(peeked)
						y := int32(peeked2)
						if x > y {
							index2 := i2 - 1
							array2[index2] = y
							array2[i2] = x
							i2 -= 1
							continue
						}
					}
					break sortByIntCompareSink
				}
				break sortByIntCompareSink
			}
			i += 1
			continue
		}
		*array = array2
		return
	}
}

func sortByIntDescendingInsertFrom(array *[]int32, i int32, length int32) {
	array2 := *array
	for {
		if i < length {
			var i2 int32 = i
		sortByIntDescendingSink:
			for {
				if i2 > 0 {
					index := i2 - 1
					var peeked maybe.Int
					peeked = maybe.Int(array2[index])
					var peeked2 maybe.Int
					peeked2 = maybe.Int(array2[i2])
					if peeked != maybe.NoInt && peeked2 != maybe.NoInt {
						x := int32(peeked)
						y := int32(peeked2)
						if y > x {
							index2 := i2 - 1
							array2[index2] = y
							array2[i2] = x
							i2 -= 1
							continue
						}
					}
					break sortByIntDescendingSink
				}
				break sortByIntDescendingSink
			}
			i += 1
			continue
		}
		*array = array2
		return
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
