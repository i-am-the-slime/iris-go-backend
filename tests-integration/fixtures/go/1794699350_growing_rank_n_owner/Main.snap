// Control/Category/category.go
package category

func Identity(x int) int {
	return x
}

func Identity2(x func(int) int) func(int) int {
	return x
}

// Data/Tuple/tuple.go
package tuple

type TupleFnInt struct {
	First  func(int) any
	Origin any
	Second int
}

type Tuple struct {
	First  any
	Second any
	Origin any
}

func Convert(value *TupleFnInt) *Tuple {
	if value == nil {
		return nil
	}
	if original, ok := value.Origin.(*Tuple); ok {
		return original
	}
	return &Tuple{First: func(coerced any) any {
		return value.First(coerced.(int))
	}, Second: value.Second, Origin: value}
}

func Convert2(value []func(int) *TupleFnInt) []func(int) any {
	converted := make([]func(int) any, len(value))
	for index, element := range value {
		converted[index] = func(coerced int) any {
			return Convert(element(coerced))
		}
	}
	return converted
}

func Convert3(value *Tuple) *TupleFnInt {
	if value == nil {
		return nil
	}
	if original, ok := value.Origin.(*TupleFnInt); ok {
		return original
	}
	original2 := value.First.(func(any) any)
	return &TupleFnInt{First: func(coerced int) any {
		return original2(coerced)
	}, Second: value.Second.(int), Origin: value}
}

func Convert4(value []any) []*TupleFnInt {
	converted := make([]*TupleFnInt, len(value))
	for index, element := range value {
		typed, _ := element.(*Tuple)
		converted[index] = Convert3(typed)
	}
	return converted
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	return shared.Convert4(func(questions []func(int) any) []any {
		mapped := make([]func(func(int) int) func(int) int, len(questions))
		for index := range questions {
			mapped[index] = category.Identity2
		}
		array := shared.Convert(mapped)
		mapped2 := make([]any, len(array))
		for index, value := range array {
			value2 := func(x int) any {
				return value(func(i int) int {
					return x + i
				})
			}
			mapped2[index] = value2(1)
		}
		array2 := tuple.Convert2(arraypkg.Map(func(f func(int) any) func(int) *tuple.TupleFnInt {
			return func(i int) *tuple.TupleFnInt {
				return &tuple.TupleFnInt{First: f, Second: i}
			}
		}, questions))
		mapped3 := make([]any, len(array2))
		for index, value := range array2 {
			mapped3[index] = value(10)
		}
		return arraypkg.Apply(arraypkg.Map(func(function func(int) int) func(*tuple.TupleFnInt) any {
			return func(tuple *tuple.TupleFnInt) any {
				return tuple.First(function(tuple.Second))
			}
		}, shared.Convert2(mapped2)), tuple.Convert4(mapped3))
	}(shared.Convert3([]func(int) int{category.Identity, func(value int) int {
		return value * 2
	}})))
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value []func(func(int) int) func(int) int) []func(func(int) int) any {
	converted := make([]func(func(int) int) any, len(value))
	for index, element := range value {
		converted[index] = func(coerced func(int) int) any {
			original := element(coerced)
			return func(coerced2 any) any {
				return original(coerced2.(int))
			}
		}
	}
	return converted
}

func Convert2(value []any) []func(int) int {
	converted := make([]func(int) int, len(value))
	for index, element := range value {
		original := element.(func(any) any)
		converted[index] = func(coerced int) int {
			return original(coerced).(int)
		}
	}
	return converted
}

func Convert3(value []func(int) int) []func(int) any {
	converted := make([]func(int) any, len(value))
	for index, element := range value {
		converted[index] = func(coerced int) any {
			return element(coerced)
		}
	}
	return converted
}

func Convert4(value []any) []int {
	converted := make([]int, len(value))
	for index, element := range value {
		converted[index] = element.(int)
	}
	return converted
}
