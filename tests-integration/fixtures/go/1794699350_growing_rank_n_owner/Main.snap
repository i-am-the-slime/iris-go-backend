// Control/Category/category.go
package category

func Identity(x int32) int32 {
	return x
}

func Identity2(x func(int32) int32) func(int32) int32 {
	return x
}

// Data/Tuple/tuple.go
package tuple

type TupleFnIntInt struct {
	First  func(int32) any
	Origin any
	Second int32
}

type Tuple struct {
	First  any
	Second any
	Origin any
}

func Convert(value *TupleFnIntInt) *Tuple {
	if original, ok := value.Origin.(*Tuple); ok {
		return original
	}
	return &Tuple{First: func(coerced any) any {
		return value.First(coerced.(int32))
	}, Second: value.Second, Origin: value}
}

func Convert2(value []func(int32) *TupleFnIntInt) []func(int32) any {
	converted := make([]func(int32) any, len(value))
	for index, element := range value {
		converted[index] = func(coerced int32) any {
			return Convert(element(coerced))
		}
	}
	return converted
}

func Convert3(value *Tuple) *TupleFnIntInt {
	if original, ok := value.Origin.(*TupleFnIntInt); ok {
		return original
	}
	original2 := value.First.(func(any) any)
	return &TupleFnIntInt{First: func(coerced int32) any {
		return original2(coerced)
	}, Second: value.Second.(int32), Origin: value}
}

func Convert4(value []any) []*TupleFnIntInt {
	converted := make([]*TupleFnIntInt, len(value))
	for index, element := range value {
		converted[index] = Convert3(element.(*Tuple))
	}
	return converted
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/Data/Tuple"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	return shared.Convert4(sampleWithIntInt(func(questions []func(int32) any) []any {
		mapped := make([]func(func(int32) int32) func(int32) int32, len(questions))
		for index := range questions {
			mapped[index] = category.Identity2
		}
		array2 := shared.Convert(mapped)
		mapped2 := make([]any, len(array2))
		for index, value := range array2 {
			value2 := func(x int32) any {
				return value(func(i int32) int32 {
					return x + i
				})
			}
			mapped2[index] = value2(1)
		}
		array3 := tuple.Convert2(array.Map(func(f func(int32) any) func(int32) *tuple.TupleFnIntInt {
			return func(i int32) *tuple.TupleFnIntInt {
				return &tuple.TupleFnIntInt{First: f, Second: i}
			}
		}, questions))
		mapped3 := make([]any, len(array3))
		for index, value := range array3 {
			mapped3[index] = value(10)
		}
		return array.Apply(array.Map(func(function func(int32) int32) func(*tuple.TupleFnIntInt) any {
			return func(tuple *tuple.TupleFnIntInt) any {
				return tuple.First(function(tuple.Second))
			}
		}, shared.Convert2(mapped2)), tuple.Convert4(mapped3))
	})(shared.Convert3([]func(int32) int32{category.Identity, func(value int32) int32 {
		return prim.MultiplyInt32(value, 2)
	}})))
}

func sampleWithIntInt(f func([]func(int32) any) []any) func([]func(int32) any) []any {
	return f
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

func Convert(value []func(func(int32) int32) func(int32) int32) []func(func(int32) int32) any {
	converted := make([]func(func(int32) int32) any, len(value))
	for index, element := range value {
		converted[index] = func(coerced func(int32) int32) any {
			original := element(coerced)
			return func(coerced2 any) any {
				return original(coerced2.(int32))
			}
		}
	}
	return converted
}

func Convert2(value []any) []func(int32) int32 {
	converted := make([]func(int32) int32, len(value))
	for index, element := range value {
		original := element.(func(any) any)
		converted[index] = func(coerced int32) int32 {
			return original(coerced).(int32)
		}
	}
	return converted
}

func Convert3(value []func(int32) int32) []func(int32) any {
	converted := make([]func(int32) any, len(value))
	for index, element := range value {
		converted[index] = func(coerced int32) any {
			return element(coerced)
		}
	}
	return converted
}

func Convert4(value []any) []int32 {
	converted := make([]int32, len(value))
	for index, element := range value {
		converted[index] = element.(int32)
	}
	return converted
}
