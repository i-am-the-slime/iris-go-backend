// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

func ArrayArrayInt(array [][]int32) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	shared := array.Replicate(3, int32(0))
	return []string{show.ArrayArrayInt(versions(0, shared, [][]int32{})), show.ArrayInt(shared)}
}

func versions(position int32, values []int32, history [][]int32) [][]int32 {
	history = slices.Clip(history)
	for {
		if position >= int32(len(values)) {
			return array.Snoc(history, values)
		}
		var result []int32
		updated := slices.Clone(values)
		updated[position] = 1
		result = updated
		position, values, history = position+1, result, array.Bounded(append(history, values))
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
