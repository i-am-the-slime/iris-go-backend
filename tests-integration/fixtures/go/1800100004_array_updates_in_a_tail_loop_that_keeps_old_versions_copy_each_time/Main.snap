// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

func ArrayArrayInt(array [][]int) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	shared := []int{0, 0, 0}
	return []string{show.ArrayArrayInt(versions(0, shared, [][]int{})), show.ArrayInt(shared)}
}

func versions(position int, values []int, history [][]int) [][]int {
	history = slices.Clip(history)
	for {
		if position >= len(values) {
			return array.Snoc(history, values)
		}
		var result []int
		updated := slices.Clone(values)
		updated[position] = 1
		result = updated
		position, values, history = position+1, result, append(history, values)
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
