// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	s := prim.CodeUnitTake(1, "𝐀")
	var result bool
	switch s {
	case "\xed\xa0\xb5":
		result = false
	default:
		result = prim.CodeUnitLengthUpTo(3, s) == 2
	}
	return []string{prim.Append(prim.CodeUnitDrop(1, "a\xed\xa0\xb5"), prim.CodeUnitDrop(1, "𝐀")), prim.Append("a\xed\xa0\xb5", prim.CodeUnitDrop(1, "𝐀")), "<" + "a\xed\xa0\xb5" + ", " + "a\xed\xa0\xb5" + ">", strconv.FormatBool(result)}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
