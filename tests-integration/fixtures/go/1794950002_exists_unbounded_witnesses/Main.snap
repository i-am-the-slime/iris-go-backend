// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type NestInt struct {
	Nest int
}

type Nest struct {
	Nest any
}

func convert(value NestInt) *Nest {
	return &Nest{Nest: value.Nest}
}

type NestString struct {
	Nest string
}

func convert2(value NestString) *Nest {
	return &Nest{Nest: value.Nest}
}

type NestNest struct {
	Nest   *Nest
	Origin any
}

func convert3(value *NestNest) *Nest {
	if value == nil {
		return nil
	}
	return &Nest{Nest: value.Nest}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	return []int{nested(3, convert(NestInt{Nest: 1})), nested(4, convert2(NestString{Nest: "deep"}))}
}

func nested(n int, e any) int {
	if n <= 0 {
		return 0
	}
	return 1 + nested(n-1, convert3(&NestNest{Nest: e.(*Nest)}))
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
