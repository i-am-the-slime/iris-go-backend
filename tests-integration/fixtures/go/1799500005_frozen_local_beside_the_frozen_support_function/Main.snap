// Data/Show/show.go
package show

import "strconv"

func Show(i int) string {
	return strconv.Itoa(i)
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Show"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"strconv"
)

func main() {
	array := []int{}
	for i := 1; i < 5; i++ {
		array = append(array, i*i)
	}
	frozen := shared.Frozen2(array)
	performed := shared.SizeValues{Values: frozen, Size: len(frozen)}
	text := show.AppendShowArrayInt(nil, performed.Values)
	text = append(text, ' ')
	text = strconv.AppendInt(text, int64(performed.Size), 10)
	journal.Log(string(text))
}

// shared/shared.go
package shared

func Frozen2[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}

type SizeValues struct {
	Values []int
	Size   int
}
