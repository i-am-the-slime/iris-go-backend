// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// main.go
package main

import "fixture/Data/Maybe"

var main_ = initializeMain_()

func initializeMain_() []maybe.Int {
	var element maybe.Int
	if len(numbers) > 1 {
		element = maybe.JustInt(numbers[1])
	} else {
		element = maybe.NoInt
	}
	return []maybe.Int{maybe.NoInt, element, maybe.NoInt}
}

var numbers []int = []int{1, 2, 3}

func main() {
	_ = main_
}

// note: the entry's value of type Array Data.Maybe.Maybe is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
