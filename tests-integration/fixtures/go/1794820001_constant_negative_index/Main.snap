// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
)

var main_ = initializeMain_()

func initializeMain_() []maybe.Int {
	defer exception.ReportUncaught()
	var element maybe.Int
	if 1 < len(numbers) {
		element = maybe.Int(numbers[1])
	} else {
		element = maybe.NoInt
	}
	return []maybe.Int{maybe.NoInt, element, maybe.NoInt}
}

var numbers []int32 = []int32{1, 2, 3}

func main() {
	fmt.Println(main_)
}
