// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
)

type LazyInt struct {
	Acc *LazyInt
	Tag uint8
}

const (
	LazyIntMain = iota
	LazyIntBuildThunks
)

var sharedLazyIntMain = &LazyInt{Tag: LazyIntMain}

type IntToInt struct {
	K   *IntToInt
	N   int
	Tag uint8
}

const (
	IntToIntMain = iota
	IntToIntCountDown
	IntToIntCountDown2
)

var sharedIntToIntMain = &IntToInt{Tag: IntToIntMain}

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	return shared.MainResult{Forced: force(buildThunks(1000, sharedLazyIntMain)), Continued: countDown(10, sharedIntToIntMain)}
}

func buildThunks(n int, acc *LazyInt) *LazyInt {
	var lazyIntCells alloc.Cells[LazyInt]
	for {
		switch n {
		case 0:
			return acc
		default:
			n, acc = n-1, lazyIntCells.New(LazyInt{Tag: LazyIntBuildThunks, Acc: acc})
			continue
		}
	}
}

func countDown(n int, k *IntToInt) int {
	var intToIntCells alloc.Cells[IntToInt]
	for {
		if n == 0 {
			return runIntToInt(k, 0)
		}
		n2 := n
		if n2&1 == 0 {
			n, k = n2-1, intToIntCells.New(IntToInt{Tag: IntToIntCountDown, K: k, N: n2})
			continue
		}
		n, k = n2-1, intToIntCells.New(IntToInt{Tag: IntToIntCountDown2, K: k})
	}
}

func force(lazy *LazyInt) int {
	switch lazy.Tag {
	case LazyIntMain:
		return 0
	default: // LazyIntBuildThunks
		return force(lazy.Acc) + 1
	}
}

func runIntToInt(function *IntToInt, x int) int {
	for {
		switch function.Tag {
		case IntToIntMain:
			return x - 1
		case IntToIntCountDown:
			k := function.K
			n := function.N
			function, x = k, x+n
			continue
		default: // IntToIntCountDown2
			k := function.K
			function, x = k, x*2
			continue
		}
	}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Continued int
	Forced    int
}

// note: the entry's value of type { continued, forced } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
