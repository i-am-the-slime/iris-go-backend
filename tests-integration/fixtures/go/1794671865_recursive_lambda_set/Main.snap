// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/alloc"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type MainResult struct {
	Continued int32
	Forced    int32
}

type LazyInt struct {
	Acc *LazyInt
	Tag uint8
}

const (
	LazyIntMain_ = iota
	LazyIntBuildThunks
)

var sharedLazyIntMain_ = &LazyInt{Tag: LazyIntMain_}

type IntToInt struct {
	K   *IntToInt
	N   int32
	Tag uint8
}

const (
	IntToIntMain_ = iota
	IntToIntCountDown
	IntToIntCountDown2
)

var sharedIntToIntMain_ = &IntToInt{Tag: IntToIntMain_}

var main_ MainResult = MainResult{Forced: forceInt(buildThunks(1000, sharedLazyIntMain_)), Continued: countDown(10, sharedIntToIntMain_)}

func buildThunks(n int32, acc *LazyInt) *LazyInt {
	var lazyIntCells alloc.Cells[LazyInt]
	for {
		switch n {
		case 0:
			return acc
		default:
			n2 := n
			n, acc = n2 - 1, lazyIntCells.New(LazyInt{Tag: LazyIntBuildThunks, Acc: acc})
			continue
		}
	}
}

func countDown(n int32, k *IntToInt) int32 {
	var intToIntCells alloc.Cells[IntToInt]
	for {
		if n == 0 {
			return runIntToInt(k, 0)
		}
		n2 := n
		if prim.IntMod(n2, 2) == 0 {
			n, k = n2 - 1, intToIntCells.New(IntToInt{Tag: IntToIntCountDown, K: k, N: n2})
			continue
		}
		n, k = n2 - 1, intToIntCells.New(IntToInt{Tag: IntToIntCountDown2, K: k})
	}
}

func forceInt(lazy *LazyInt) int32 {
	switch lazy.Tag {
	case LazyIntMain_:
		return 0
	default: // LazyIntBuildThunks
		return forceInt(lazy.Acc) + 1
	}
}

func runIntToInt(function *IntToInt, x int32) int32 {
	for {
		switch function.Tag {
		case IntToIntMain_:
			return x - 1
		case IntToIntCountDown:
			k := function.K
			n := function.N
			function, x = k, x + n
			continue
		default: // IntToIntCountDown2
			k := function.K
			function, x = k, prim.MultiplyInt32(x, 2)
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
