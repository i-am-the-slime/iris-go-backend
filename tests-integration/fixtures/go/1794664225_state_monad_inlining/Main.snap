// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() int32 {
	defer exception.ReportUncaught()
	return countDown(60, 0).State
}

func countDown(n int32, state int32) shared.StateValue {
	for {
		switch n {
		case 0:
			return shared.StateValue{Value: struct{}{}, State: state}
		default:
			n, state = n-1, state+1
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type StateValue struct {
	Value struct{}
	State int32
}
