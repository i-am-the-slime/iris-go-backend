// main.go
package main

import "fmt"

type StateValue struct {
	State int32
	Value struct{}
}

var main_ int32 = countDown(60, 0).State

func countDown(n int32, state int32) StateValue {
	for {
		switch n {
		case 0:
			return StateValue{Value: struct{}{}, State: state}
		default:
			n2 := n
			n, state = n2 - 1, state + 1
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
