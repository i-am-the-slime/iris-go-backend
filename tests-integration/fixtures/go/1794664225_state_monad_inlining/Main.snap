// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() int {
	return countDown(60, 0).State
}

func countDown(n int, state int) shared.StateValue {
	for {
		switch n {
		case 0:
			return shared.StateValue{Value: struct{}{}, State: state}
		default:
			n, state = n-1, state+1
			continue
		}
	}
}

func main() {
	console.Print(prim.ShowInt(main_))
}

// shared/shared.go
package shared

type StateValue struct {
	Value struct{}
	State int
}
