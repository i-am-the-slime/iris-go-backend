// main.go
package main

import "fmt"

type StateValue struct {
	State int32
	Value struct{}
}

var main_ int32 = countDown(60, 0).State

func countDown(argument0 int32, state int32) StateValue {
	for {
		switch argument0 {
		case 0:
			return StateValue{Value: struct{}{}, State: state}
		default:
			n := argument0
			argument0, state = n - 1, state + 1
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
