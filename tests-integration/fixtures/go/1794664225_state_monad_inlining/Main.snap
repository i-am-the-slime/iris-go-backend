// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
)

type StateValue struct {
	Value struct{}
	State int32
}

var main_ = initializeMain_()

func initializeMain_() int32 {
	defer exception.ReportUncaught()
	return countDown(60, 0).State
}

func countDown(n int32, state int32) StateValue {
	for {
		switch n {
		case 0:
			return StateValue{Value: struct{}{}, State: state}
		default:
			n2 := n
			n, state = n2 - 1, state + 1
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
