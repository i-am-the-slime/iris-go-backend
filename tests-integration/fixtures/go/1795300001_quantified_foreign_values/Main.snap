// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	optional "fixture/Optional_ffi"
	"strconv"
)

func main_() []string {
	counter := optional.NewCounter[int]()
	again := optional.NewCounter[bool]()
	return []string{show.ArrayInt([]int{optional.WithDefault(1, optional.Absent[int]()), optional.WithDefault(1, optional.Present(2))}), optional.WithDefault("fallback", optional.Absent[string]()), strconv.Itoa(len(optional.EmptyArray[string]())), show.ArrayInt([]int{optional.PairSize(optional.SwappedPair(1, "one")), optional.PairSize(optional.EmptySwappedPair[int, string]())}), strconv.Itoa(optional.WithDefault(3, counter)), strconv.FormatBool(optional.WithDefault(true, again))}
}

func main() {
	main_()
}
