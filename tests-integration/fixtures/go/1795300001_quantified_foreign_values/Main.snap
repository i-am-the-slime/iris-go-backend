// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	optional "fixture/Optional_ffi"
	"strconv"
)

func main_() []string {
	counter := optional.NewCounter[int32]()
	again := optional.NewCounter[bool]()
	return []string{show.ArrayInt([]int32{optional.WithDefault(int32(1), optional.Absent[int32]()), optional.WithDefault(int32(1), optional.Present(int32(2)))}), optional.WithDefault("fallback", optional.Absent[string]()), strconv.Itoa(len(optional.EmptyArray[string]())), show.ArrayInt([]int32{optional.PairSize(optional.SwappedPair(int32(1), "one")), optional.PairSize(optional.EmptySwappedPair[int32, string]())}), strconv.Itoa(int(optional.WithDefault(int32(3), counter))), strconv.FormatBool(optional.WithDefault(true, again))}
}

func main() {
	main_()
}
