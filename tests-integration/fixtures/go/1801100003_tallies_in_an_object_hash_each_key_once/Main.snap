// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  string
	Second int32
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() int {
	object := make(map[string]int)
	for n := 1; n < 3001; n++ {
		tuple2 := tuple.Tuple{First: strconv.Itoa(n % 97), Second: 1}
		object[tuple2.First] = object[tuple2.First] + int(tuple2.Second)
	}
	result, found := object["7"]
	if !found {
		result = 0
	}
	return len(object) + result
}

func main() {
	console.Print(prim.ShowInt(main_))
}
