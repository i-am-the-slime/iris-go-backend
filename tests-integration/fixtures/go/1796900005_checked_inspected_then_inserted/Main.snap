// Data/List/Types/types.go
package types

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
}

var SharedListIntNil = &ListInt{}

func SumIntList(value *ListInt) int32 {
	return SumIntListGo(0, value)
}

func SumIntListGo(b int32, value *ListInt) int32 {
	for {
		if value == SharedListIntNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		b, value = b+a, as
	}
}

// RedBlack/redblack.go
package redblack

type Color uint8

const (
	ColorRed Color = iota
	ColorBlack
)

type Tree struct {
	Node1 *Tree
	Node4 *Tree
	Node2 int32
	Node0 Color
	Node3 bool
}

var SharedTreeLeaf = &Tree{}

func Size(value *Tree) int32 {
	if value == SharedTreeLeaf {
		return 0
	}
	return Size(value.Node1) + 1 + Size(value.Node4)
}

func Checksum(value *Tree) int32 {
	return ChecksumGo(0, value)
}

func BlackHeight(value *Tree) int32 {
	if value == SharedTreeLeaf {
		return 1
	}
	color := value.Node0
	l := value.Node1
	r := value.Node4
	left := BlackHeight(l)
	var result bool
	switch color {
	case ColorRed:
		result2 := l != SharedTreeLeaf && l.Node0 == ColorRed
		result3 := r != SharedTreeLeaf && r.Node0 == ColorRed
		result = result2 || result3
	default: // ColorBlack
		result = false
	}
	if left < 0 || (left != BlackHeight(r) || result) {
		return -1
	}
	var result4 int32
	switch color {
	case ColorRed:
		result4 = 0
	default: // ColorBlack
		result4 = 1
	}
	return left + result4
}

func Ordered(low int32, high int32, value *Tree) bool {
	if value == SharedTreeLeaf {
		return true
	}
	k := value.Node2
	return low < k && (k < high && (Ordered(low, k, value.Node1) && Ordered(k, high, value.Node4)))
}

func Ins(kx int32, vx bool, value *Tree) *Tree {
	if value == SharedTreeLeaf {
		return &Tree{Node0: ColorRed, Node1: SharedTreeLeaf, Node2: kx, Node3: vx, Node4: SharedTreeLeaf}
	}
	if value != SharedTreeLeaf && value.Node0 == ColorRed {
		a := value.Node1
		ky := value.Node2
		vy := value.Node3
		b := value.Node4
		if kx < ky {
			return &Tree{Node0: ColorRed, Node1: Ins(kx, vx, a), Node2: ky, Node3: vy, Node4: b}
		}
		if kx == ky {
			return &Tree{Node0: ColorRed, Node1: a, Node2: kx, Node3: vx, Node4: b}
		}
		return &Tree{Node0: ColorRed, Node1: a, Node2: ky, Node3: vy, Node4: Ins(kx, vx, b)}
	}
	a2 := value.Node1
	ky2 := value.Node2
	vy2 := value.Node3
	b2 := value.Node4
	if kx < ky2 {
		result := a2 != SharedTreeLeaf && a2.Node0 == ColorRed
		if result {
			scrutinee := Ins(kx, vx, a2)
			if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
				trees := make([]Tree, 3)
				trees[0] = Tree{Node0: ColorRed, Node1: &trees[1], Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: &trees[2]}
				trees[1] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1.Node1, Node2: scrutinee.Node1.Node2, Node3: scrutinee.Node1.Node3, Node4: scrutinee.Node1.Node4}
				trees[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4, Node2: ky2, Node3: vy2, Node4: b2}
				return &trees[0]
			}
			if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
				trees2 := make([]Tree, 3)
				trees2[0] = Tree{Node0: ColorRed, Node1: &trees2[1], Node2: scrutinee.Node4.Node2, Node3: scrutinee.Node4.Node3, Node4: &trees2[2]}
				trees2[1] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4.Node1}
				trees2[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4.Node4, Node2: ky2, Node3: vy2, Node4: b2}
				return &trees2[0]
			}
			if scrutinee != SharedTreeLeaf {
				return &Tree{Node0: ColorBlack, Node1: &Tree{Node0: ColorRed, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}, Node2: ky2, Node3: vy2, Node4: b2}
			}
			return SharedTreeLeaf
		}
		return &Tree{Node0: ColorBlack, Node1: Ins(kx, vx, a2), Node2: ky2, Node3: vy2, Node4: b2}
	}
	if kx == ky2 {
		return &Tree{Node0: ColorBlack, Node1: a2, Node2: kx, Node3: vx, Node4: b2}
	}
	result2 := b2 != SharedTreeLeaf && b2.Node0 == ColorRed
	if result2 {
		scrutinee := Ins(kx, vx, b2)
		if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
			trees3 := make([]Tree, 3)
			trees3[0] = Tree{Node0: ColorRed, Node1: &trees3[1], Node2: scrutinee.Node1.Node2, Node3: scrutinee.Node1.Node3, Node4: &trees3[2]}
			trees3[1] = Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: scrutinee.Node1.Node1}
			trees3[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1.Node4, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}
			return &trees3[0]
		}
		if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
			trees4 := make([]Tree, 3)
			trees4[0] = Tree{Node0: ColorRed, Node1: &trees4[1], Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: &trees4[2]}
			trees4[1] = Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: scrutinee.Node1}
			trees4[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4.Node1, Node2: scrutinee.Node4.Node2, Node3: scrutinee.Node4.Node3, Node4: scrutinee.Node4.Node4}
			return &trees4[0]
		}
		if scrutinee != SharedTreeLeaf {
			return &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: &Tree{Node0: ColorRed, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}}
		}
		return SharedTreeLeaf
	}
	return &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: Ins(kx, vx, b2)}
}

func ChecksumGo(acc int32, value *Tree) int32 {
	for {
		if value == SharedTreeLeaf {
			return acc
		}
		l := value.Node1
		k := value.Node2
		v := value.Node3
		r := value.Node4
		var result int32
		if v {
			result = k
		} else {
			result = 1
		}
		acc, value = ChecksumGo(acc, l)+result, r
	}
}

func InsReusing(kx int32, vx bool, value *Tree) *Tree {
	if value == SharedTreeLeaf {
		return &Tree{Node0: ColorRed, Node1: SharedTreeLeaf, Node2: kx, Node3: vx, Node4: SharedTreeLeaf}
	}
	if value != SharedTreeLeaf && value.Node0 == ColorRed {
		a := value.Node1
		ky := value.Node2
		vy := value.Node3
		b := value.Node4
		if kx < ky {
			field := InsReusing(kx, vx, a)
			value.Node0 = ColorRed
			value.Node1 = field
			value.Node2 = ky
			value.Node3 = vy
			value.Node4 = b
			return value
		}
		if kx == ky {
			value.Node0 = ColorRed
			value.Node1 = a
			value.Node2 = kx
			value.Node3 = vx
			value.Node4 = b
			return value
		}
		field2 := InsReusing(kx, vx, b)
		value.Node0 = ColorRed
		value.Node1 = a
		value.Node2 = ky
		value.Node3 = vy
		value.Node4 = field2
		return value
	}
	a2 := value.Node1
	ky2 := value.Node2
	vy2 := value.Node3
	b2 := value.Node4
	if kx < ky2 {
		result := a2 != SharedTreeLeaf && a2.Node0 == ColorRed
		if result {
			scrutinee := InsReusing(kx, vx, a2)
			if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
				cell := scrutinee.Node1
				l := scrutinee.Node1.Node1
				kx2 := scrutinee.Node1.Node2
				vx2 := scrutinee.Node1.Node3
				r1 := scrutinee.Node1.Node4
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				r2 := scrutinee.Node4
				value.Node0 = ColorBlack
				value.Node1 = l
				value.Node2 = kx2
				value.Node3 = vx2
				value.Node4 = r1
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = r2
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				cell.Node0 = ColorRed
				cell.Node1 = value
				cell.Node2 = ky
				cell.Node3 = vy
				cell.Node4 = scrutinee
				return cell
			}
			if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
				l1 := scrutinee.Node1
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				cell := scrutinee.Node4
				l2 := scrutinee.Node4.Node1
				kx2 := scrutinee.Node4.Node2
				vx2 := scrutinee.Node4.Node3
				r := scrutinee.Node4.Node4
				value.Node0 = ColorBlack
				value.Node1 = l1
				value.Node2 = ky
				value.Node3 = vy
				value.Node4 = l2
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = r
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				cell.Node0 = ColorRed
				cell.Node1 = value
				cell.Node2 = kx2
				cell.Node3 = vx2
				cell.Node4 = scrutinee
				return cell
			}
			if scrutinee != SharedTreeLeaf {
				l := scrutinee.Node1
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				r := scrutinee.Node4
				value.Node0 = ColorRed
				value.Node1 = l
				value.Node2 = ky
				value.Node3 = vy
				value.Node4 = r
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = value
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				return scrutinee
			}
			return SharedTreeLeaf
		}
		field := InsReusing(kx, vx, a2)
		value.Node0 = ColorBlack
		value.Node1 = field
		value.Node2 = ky2
		value.Node3 = vy2
		value.Node4 = b2
		return value
	}
	if kx == ky2 {
		value.Node0 = ColorBlack
		value.Node1 = a2
		value.Node2 = kx
		value.Node3 = vx
		value.Node4 = b2
		return value
	}
	result2 := b2 != SharedTreeLeaf && b2.Node0 == ColorRed
	if result2 {
		scrutinee := InsReusing(kx, vx, b2)
		if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
			cell := scrutinee.Node1
			l := scrutinee.Node1.Node1
			kx1 := scrutinee.Node1.Node2
			vx1 := scrutinee.Node1.Node3
			r1 := scrutinee.Node1.Node4
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			r2 := scrutinee.Node4
			value.Node0 = ColorBlack
			value.Node1 = a2
			value.Node2 = ky2
			value.Node3 = vy2
			value.Node4 = l
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = r1
			scrutinee.Node2 = ky
			scrutinee.Node3 = vy
			scrutinee.Node4 = r2
			cell.Node0 = ColorRed
			cell.Node1 = value
			cell.Node2 = kx1
			cell.Node3 = vx1
			cell.Node4 = scrutinee
			return cell
		}
		if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
			l1 := scrutinee.Node1
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			cell := scrutinee.Node4
			l2 := scrutinee.Node4.Node1
			kx2 := scrutinee.Node4.Node2
			vx2 := scrutinee.Node4.Node3
			r2 := scrutinee.Node4.Node4
			value.Node0 = ColorBlack
			value.Node1 = a2
			value.Node2 = ky2
			value.Node3 = vy2
			value.Node4 = l1
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = l2
			scrutinee.Node2 = kx2
			scrutinee.Node3 = vx2
			scrutinee.Node4 = r2
			cell.Node0 = ColorRed
			cell.Node1 = value
			cell.Node2 = ky
			cell.Node3 = vy
			cell.Node4 = scrutinee
			return cell
		}
		if scrutinee != SharedTreeLeaf {
			l := scrutinee.Node1
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			r := scrutinee.Node4
			value.Node0 = ColorRed
			value.Node1 = l
			value.Node2 = ky
			value.Node3 = vy
			value.Node4 = r
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = a2
			scrutinee.Node2 = ky2
			scrutinee.Node3 = vy2
			scrutinee.Node4 = value
			return scrutinee
		}
		return SharedTreeLeaf
	}
	field3 := InsReusing(kx, vx, b2)
	value.Node0 = ColorBlack
	value.Node1 = a2
	value.Node2 = ky2
	value.Node3 = vy2
	value.Node4 = field3
	return value
}

// main.go
package main

import (
	"fixture/Data/List/Types"
	"fixture/RedBlack"
	"fixture/shared/Data.List+RedBlack"
	"fixture/shared/RedBlack+Data.List.Types"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	result := mainGoReusing(redblack.SharedTreeLeaf, redblack_types.SharedListTreeNil, 0, 1500)
	return []int32{result.Inspected, list_redblack.LengthTree(result.Trees), types.SumIntList(redblack_types.MapSize(result.Trees)), types.SumIntList(redblack_types.Map_(redblack.Checksum, result.Trees)), list_redblack.LengthTree(mainGoReusing2(redblack_types.SharedListTreeNil, result.Trees))}
}

func member(key int32, value *redblack.Tree) bool {
	for {
		if value == redblack.SharedTreeLeaf {
			return false
		}
		l := value.Node1
		k := value.Node2
		r := value.Node4
		if key < k {
			value = l
			continue
		}
		if key > k {
			value = r
			continue
		}
		return true
	}
}

func mainGo(tree *redblack.Tree, kept *redblack_types.ListTree, inspected int32, n int32) redblack_types.MainGoResult {
	for {
		if n <= 0 {
			return redblack_types.MainGoResult{Inspected: inspected, Trees: &redblack_types.ListTree{Cons0: tree, Cons1: kept}}
		}
		key := n * 37 % 500
		var next *redblack.Tree
		if member(key, tree) {
			next = tree
		} else {
		matched:
			for {
				result := tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed
				if result {
					scrutinee := redblack.Ins(key, true, tree)
					if scrutinee != redblack.SharedTreeLeaf {
						next = &redblack.Tree{Node0: redblack.ColorBlack, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}
					} else {
						next = redblack.SharedTreeLeaf
					}
					break matched
				}
				next = redblack.Ins(key, true, tree)
				break matched
			}
		}
		var result2 *redblack_types.ListTree
		if n%9 == 0 {
			result2 = &redblack_types.ListTree{Cons0: next, Cons1: kept}
		} else {
			result2 = kept
		}
		var result3 int32
		if n%3 == 0 {
			result3 = redblack.Checksum(next)
		} else {
			result3 = 0
		}
		tree, kept, inspected, n = next, result2, inspected+result3, n-1
	}
}

func mainGoReusing(tree *redblack.Tree, kept *redblack_types.ListTree, inspected int32, n int32) redblack_types.MainGoResult {
	if n <= 0 {
		return redblack_types.MainGoResult{Inspected: inspected, Trees: &redblack_types.ListTree{Cons0: tree, Cons1: kept}}
	}
	key := n * 37 % 500
	var next *redblack.Tree
	if member(key, tree) {
		next = tree
	} else {
	matched:
		for {
			result := tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed
			if result {
				scrutinee := redblack.InsReusing(key, true, tree)
				if scrutinee != redblack.SharedTreeLeaf {
					l := scrutinee.Node1
					k := scrutinee.Node2
					v := scrutinee.Node3
					r := scrutinee.Node4
					scrutinee.Node0 = redblack.ColorBlack
					scrutinee.Node1 = l
					scrutinee.Node2 = k
					scrutinee.Node3 = v
					scrutinee.Node4 = r
					next = scrutinee
				} else {
					next = redblack.SharedTreeLeaf
				}
				break matched
			}
			next = redblack.InsReusing(key, true, tree)
			break matched
		}
	}
	var result2 *redblack_types.ListTree
	if n%9 == 0 {
		result2 = &redblack_types.ListTree{Cons0: next, Cons1: kept}
	} else {
		result2 = kept
	}
	var result3 int32
	if n%3 == 0 {
		result3 = redblack.Checksum(next)
	} else {
		result3 = 0
	}
	return mainGo(next, result2, inspected+result3, n-1)
}

func mainGoReusing2(acc *redblack_types.ListTree, list *redblack_types.ListTree) *redblack_types.ListTree {
	var listTreeCells alloc.Cells[redblack_types.ListTree]
	for {
		if list == redblack_types.SharedListTreeNil {
			return list_redblack.ReverseTreeReusing(acc)
		}
		x := list.Cons0
		xs := list.Cons1
		if !(redblack.BlackHeight(x) > 0 && redblack.Ordered(-1000000, 1000000, x)) {
			acc, list = listTreeCells.New(redblack_types.ListTree{Cons0: x, Cons1: acc}), xs
			continue
		}
		list = xs
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/Data.List+RedBlack/list_redblack.go
package list_redblack

import "fixture/shared/RedBlack+Data.List.Types"

func LengthTree(value *redblack_types.ListTree) int32 {
	return LengthTreeGo(0, value)
}

func LengthTreeGo(b int32, value *redblack_types.ListTree) int32 {
	for {
		if value == redblack_types.SharedListTreeNil {
			return b
		}
		as := value.Cons1
		b, value = b+1, as
	}
}

func ReverseTreeReusing(list *redblack_types.ListTree) *redblack_types.ListTree {
	return ReverseTreeGoReusing(redblack_types.SharedListTreeNil, list)
}

func ReverseTreeGoReusing(acc *redblack_types.ListTree, list *redblack_types.ListTree) *redblack_types.ListTree {
	for {
		if list == redblack_types.SharedListTreeNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		list.Cons0 = x
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// shared/RedBlack+Data.List.Types/redblack_types.go
package redblack_types

import (
	"fixture/Data/List/Types"
	"fixture/RedBlack"
	"github.com/i-am-the-slime/iris-go/alloc"
)

type ListTree struct {
	Cons0 *redblack.Tree
	Cons1 *ListTree
}

var SharedListTreeNil = &ListTree{}

type ListListTree struct {
	Cons0 *ListTree
	Cons1 *ListListTree
}

var SharedListListTreeNil = &ListListTree{}

type MainGoResult struct {
	Trees     *ListTree
	Inspected int32
}

func Map_(f func(*redblack.Tree) int32, list *ListTree) *types.ListInt {
	return MapChunkedRevMap(f, SharedListListTreeNil, list)
}

func MapSize(list *ListTree) *types.ListInt {
	return MapSizeChunkedRevMap(SharedListListTreeNil, list)
}

func MapChunkedRevMap(f func(*redblack.Tree) int32, chunksAcc *ListListTree, chunk *ListTree) *types.ListInt {
	var listListTreeCells alloc.Cells[ListListTree]
	for {
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 != SharedListTreeNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListTreeCells.New(ListListTree{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *types.ListInt
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 == SharedListTreeNil {
			result = &types.ListInt{Cons0: f(chunk.Cons0), Cons1: &types.ListInt{Cons0: f(chunk.Cons1.Cons0), Cons1: types.SharedListIntNil}}
		} else if chunk != SharedListTreeNil && chunk.Cons1 == SharedListTreeNil {
			result = &types.ListInt{Cons0: f(chunk.Cons0), Cons1: types.SharedListIntNil}
		} else {
			result = types.SharedListIntNil
		}
		return MapChunkedRevMapReverseUnrolledMap(f, chunksAcc, result)
	}
}

func MapChunkedRevMapReverseUnrolledMap(f func(*redblack.Tree) int32, list *ListListTree, acc *types.ListInt) *types.ListInt {
	var listIntCells alloc.Cells[types.ListInt]
	for {
		if list != SharedListListTreeNil && list.Cons0 != SharedListTreeNil && list.Cons0.Cons1 != SharedListTreeNil && list.Cons0.Cons1.Cons1 != SharedListTreeNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listIntCells.New(types.ListInt{Cons0: f(x1), Cons1: listIntCells.New(types.ListInt{Cons0: f(x2), Cons1: listIntCells.New(types.ListInt{Cons0: f(x3), Cons1: acc})})})
			continue
		}
		return acc
	}
}

func MapSizeChunkedRevMap(chunksAcc *ListListTree, chunk *ListTree) *types.ListInt {
	var listListTreeCells alloc.Cells[ListListTree]
	for {
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 != SharedListTreeNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListTreeCells.New(ListListTree{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *types.ListInt
		if chunk != SharedListTreeNil && chunk.Cons1 != SharedListTreeNil && chunk.Cons1.Cons1 == SharedListTreeNil {
			result = &types.ListInt{Cons0: redblack.Size(chunk.Cons0), Cons1: &types.ListInt{Cons0: redblack.Size(chunk.Cons1.Cons0), Cons1: types.SharedListIntNil}}
		} else if chunk != SharedListTreeNil && chunk.Cons1 == SharedListTreeNil {
			result = &types.ListInt{Cons0: redblack.Size(chunk.Cons0), Cons1: types.SharedListIntNil}
		} else {
			result = types.SharedListIntNil
		}
		return MapSizeChunkedRevMapReverseUnrolledMap(chunksAcc, result)
	}
}

func MapSizeChunkedRevMapReverseUnrolledMap(list *ListListTree, acc *types.ListInt) *types.ListInt {
	var listIntCells alloc.Cells[types.ListInt]
	for {
		if list != SharedListListTreeNil && list.Cons0 != SharedListTreeNil && list.Cons0.Cons1 != SharedListTreeNil && list.Cons0.Cons1.Cons1 != SharedListTreeNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listIntCells.New(types.ListInt{Cons0: redblack.Size(x1), Cons1: listIntCells.New(types.ListInt{Cons0: redblack.Size(x2), Cons1: listIntCells.New(types.ListInt{Cons0: redblack.Size(x3), Cons1: acc})})})
			continue
		}
		return acc
	}
}
