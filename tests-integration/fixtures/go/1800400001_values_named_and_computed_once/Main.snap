// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main() {
	counter := 0
	counter += 1
	ref := []string{"usr", "bin"}
	ref2 := []int{1, 2}
	journal.Log("POST")
	journal.Log(show.ArrayString(ref))
	mapped := make([]string, len(ref))
	for index, s := range ref {
		mapped[index] = s
	}
	journal.Log(prim.StringJoinWith("/", mapped))
	count := min(len(ref), len(ref2))
	built := make([]string, count)
	for index := range count {
		element := ref[index]
		built[index] = element
	}
	journal.Log(show.ArrayString(built))
	for _, i := range ref2 {
		var recordInts []int
		var recordStrings []string
		if i < 1 {
			recordInts = ref2
			recordStrings = ref
		} else {
			recordInts = array.Slice(i, len(ref2), ref2)
			recordStrings = array.Slice(i, len(ref), ref)
		}
		text := []byte("{ ints: ")
		text = show.AppendShowArrayInt(text, recordInts)
		text = append(text, ", strings: "...)
		text = show.AppendShowArrayString(text, recordStrings)
		text = append(text, " }"...)
		journal.Log(string(text))
	}
	for _, name := range ref {
		upper := prim.StringToUpper(name)
		journal.Log(upper)
		journal.Log(upper + "!")
	}
	for _, word := range ref {
		journal.Log(prim.Concat(prim.StringJoinWith("", array.Replicate(5-direct.CodePointLength(word), " ")), word, "|"))
	}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
