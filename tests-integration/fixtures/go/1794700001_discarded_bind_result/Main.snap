// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"os"
)

func main_() int32 {
	var total int32 = 0
	ticks := create()
	ticks2 := create()
	previous := ticks2.Subscribe
	previous(func(n int32) {
		total += n
	})
	var latest int32 = 0
	previous(func(n int32) {
		latest = n
	})
	ticks.Subscribe(func(n int32) {
		previous2 := latest
		ticks2.Push(previous2 + n)
	})
	ticks.Push(1)
	ticks.Push(2)
	return total
}

func create() shared.Ticks {
	subscribers := []func(int32){}
	return shared.Ticks{Subscribe: func(k func(int32)) func() {
		s := subscribers
		subscribers = array.Append(s, []func(int32){k})
		return func() {
		}
	}, Push: func(n int32) {
		array := subscribers
		for _, f := range array {
			f(n)
		}
	}}
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValueOfIntInt struct {
	State int32
	Value int32
}

type Ticks struct {
	Push      func(int32)
	Subscribe func(func(int32)) func()
}

type StateValueOfArrayFnIntEffectArrayFnIntEffect struct {
	State []func(int32)
	Value []func(int32)
}
