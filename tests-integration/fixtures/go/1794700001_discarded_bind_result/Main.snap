// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"os"
)

func main_() int {
	total := 0
	ticks := create()
	ticks2 := create()
	previous := ticks2.Subscribe
	previous(func(n int) {
		total += n
	})
	latest := 0
	previous(func(n int) {
		latest = n
	})
	ticks.Subscribe(func(n int) {
		previous2 := latest
		ticks2.Push(previous2 + n)
	})
	ticks.Push(1)
	ticks.Push(2)
	return total
}

func create() shared.Ticks {
	subscribers := []func(int){}
	return shared.Ticks{Subscribe: func(k func(int)) func() {
		s := subscribers
		subscribers = array.Append(s, []func(int){k})
		return func() {
		}
	}, Push: func(n int) {
		array := subscribers
		for _, f := range array {
			f(n)
		}
	}}
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValueOfIntInt struct {
	State int
	Value int
}

type Ticks struct {
	Push      func(int)
	Subscribe func(func(int)) func()
}

type StateValueOfArrayFnIntEffectArrayFnIntEffect struct {
	State []func(int)
	Value []func(int)
}
