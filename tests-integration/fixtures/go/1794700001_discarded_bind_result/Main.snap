// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"os"
)

func main_() int32 {
	var ref int32 = 0
	createResult := create()
	createResult2 := create()
	subscribe := createResult2.Subscribe
	subscribe(func(n int32) {
		s_ := ref + n
		ref = s_
	})
	var ref2 int32 = 0
	subscribe(func(n int32) {
		ref2 = n
	})
	createResult.Subscribe(func(n int32) {
		i := ref2
		createResult2.Push(i + n)
	})
	createResult.Push(1)
	createResult.Push(2)
	return ref
}

func create() shared.CreateResult {
	ref := []func(int32){}
	return shared.CreateResult{Subscribe: func(k func(int32)) func() {
		s := ref
		s_ := array.Append(s, []func(int32){k})
		ref = s_
		return func() {
		}
	}, Push: func(n int32) {
		array := ref
		for _, f := range array {
			f(n)
		}
	}}
}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValueOfIntInt struct {
	State int32
	Value int32
}

type CreateResult struct {
	Push      func(int32)
	Subscribe func(func(int32)) func()
}

type StateValueOfArrayFnIntEffectArrayFnIntEffect struct {
	State []func(int32)
	Value []func(int32)
}
