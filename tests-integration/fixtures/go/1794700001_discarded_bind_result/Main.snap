// main.go
package main

import (
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"os"
)

type Ref[T any] struct {
	Value T
}

type StateValueOfIntInt struct {
	State int32
	Value int32
}

type CreateResult struct {
	Push      func(int32)
	Subscribe func(func(int32)) func()
}

type StateValueOfArrayFnIntEffectArrayFnIntEffect struct {
	State []func(int32)
	Value []func(int32)
}

func main_() int32 {
	ref := &Ref[int32]{Value: 0}
	createResult := create()
	createResult2 := create()
	subscribe := createResult2.Subscribe
	subscribe(func(n int32) {
		s := ref.Value
		s_ := s + n
		modified := StateValueOfIntInt{State: s_, Value: s_}
		ref.Value = modified.State
	})
	ref2 := &Ref[int32]{Value: 0}
	subscribe(func(n int32) {
		ref2.Value = n
	})
	createResult.Subscribe(func(n int32) {
		i := ref2.Value
		createResult2.Push(i + n)
	})
	createResult.Push(1)
	createResult.Push(2)
	return ref.Value
}

func create() CreateResult {
	ref := &Ref[[]func(int32)]{Value: []func(int32){}}
	return CreateResult{Subscribe: func(k func(int32)) func() {
		s := ref.Value
		s_ := array.Append(s, []func(int32){k})
		modified := StateValueOfArrayFnIntEffectArrayFnIntEffect{State: s_, Value: s_}
		ref.Value = modified.State
		return func() {
		}
	}, Push: func(n int32) {
		array := ref.Value
		for _, f := range array {
			f(n)
		}
	}}
}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}
