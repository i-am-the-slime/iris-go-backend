package main

import (
	"fmt"
)

func convert2(value []int32) []any {
	converted := []any{}
	for _, element := range value {
		converted = append(converted, element)
	}
	return converted
}

func convert(value [][]int32) []any {
	converted := []any{}
	for _, element := range value {
		converted = append(converted, convert2(element))
	}
	return converted
}

type Nested struct {
	Tag   int
	Flat0 any
	Deep0 *Nested
}

const (
	NestedFlat = iota
	NestedDeep
)

var main_ []int32 = []int32{1 + 2, 1 + depthArrayInt(&Nested{Tag: NestedDeep, Deep0: &Nested{Tag: NestedFlat, Flat0: convert([][]int32{[]int32{1}})}})}

func depthArrayInt(value *Nested) int32 {
	switch value.Tag {
	case NestedFlat:
		return 0
	case NestedDeep:
		return 1 + depthArrayInt(value.Deep0)
	}
	panic("Failed pattern match")
}

func main() {
	fmt.Println(main_)
}
