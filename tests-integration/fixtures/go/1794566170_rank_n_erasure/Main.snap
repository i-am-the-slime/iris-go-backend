// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Nested struct {
	Flat any
	Deep *Nested
	Tag  uint8
}

const (
	NestedFlat = iota
	NestedDeep
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	return []int32{3, 1 + depthDeep(&Nested{Tag: NestedFlat, Flat: shared.Convert([][]int32{{1}})})}
}

func depth(value *Nested) int32 {
	switch value.Tag {
	case NestedFlat:
		return 0
	default: // NestedDeep
		return 1 + depth(value.Deep)
	}
}

func depthDeep(inner *Nested) int32 {
	return 1 + depth(inner)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value [][]int32) any {
	return value
}
