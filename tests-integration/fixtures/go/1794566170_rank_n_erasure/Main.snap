// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
)

func convert(value []int32) []any {
	converted := []any{}
	for _, element := range value {
		converted = append(converted, element)
	}
	return converted
}

func convert2(value [][]int32) []any {
	converted := []any{}
	for _, element := range value {
		converted = append(converted, convert(element))
	}
	return converted
}

type Nested struct {
	Flat any
	Deep *Nested
	Tag  uint8
}

const (
	NestedFlat = iota
	NestedDeep
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	return []int32{3, 1 + depthArrayInt(&Nested{Tag: NestedDeep, Deep: &Nested{Tag: NestedFlat, Flat: convert2([][]int32{[]int32{1}})}})}
}

func depthArrayInt(value *Nested) int32 {
	switch value.Tag {
	case NestedFlat:
		return 0
	default: // NestedDeep
		return 1 + depthArrayInt(value.Deep)
	}
}

func main() {
	fmt.Println(main_)
}
