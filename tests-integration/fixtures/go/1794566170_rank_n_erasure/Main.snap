// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
)

type Nested struct {
	Flat any
	Deep *Nested
	Tag  uint8
}

const (
	NestedFlat = iota
	NestedDeep
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	return []int32{3, 1 + depthArrayInt(&Nested{Tag: NestedDeep, Deep: &Nested{Tag: NestedFlat, Flat: shared.Convert([][]int32{[]int32{1}})}})}
}

func depthArrayInt(value *Nested) int32 {
	switch value.Tag {
	case NestedFlat:
		return 0
	default: // NestedDeep
		return 1 + depthArrayInt(value.Deep)
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

func Convert(value [][]int32) any {
	return value
}
