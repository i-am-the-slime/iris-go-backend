// Data/Variant/variant.go
package variant

import "fixture/shared"

type InvalidLateMissing struct {
	Missing string
	Invalid int32
	Late    shared.After
	Tag     uint8
}

const (
	InvalidLateMissingInvalid = iota
	InvalidLateMissingLate
	InvalidLateMissingMissing
)

type InvalidMissing struct {
	Missing string
	Invalid int32
	Tag     uint8
}

const (
	InvalidMissingInvalid = iota
	InvalidMissingMissing
)

type LateMissing struct {
	Missing string
	Late    shared.After
	Tag     uint8
}

const (
	LateMissingLate = iota
	LateMissingMissing
)

func InvalidInvalidMissing(invalid int32) InvalidMissing {
	return InvalidMissing{Tag: InvalidMissingInvalid, Invalid: invalid}
}

func MissingInvalidMissing(missing string) InvalidMissing {
	return InvalidMissing{Tag: InvalidMissingMissing, Missing: missing}
}

func MissingInvalidLateMissing(missing string) InvalidLateMissing {
	return InvalidLateMissing{Tag: InvalidLateMissingMissing, Missing: missing}
}

func InvalidInvalidLateMissing(invalid int32) InvalidLateMissing {
	return InvalidLateMissing{Tag: InvalidLateMissingInvalid, Invalid: invalid}
}

func LateInvalidLateMissing(late shared.After) InvalidLateMissing {
	return InvalidLateMissing{Tag: InvalidLateMissingLate, Late: late}
}

func LateLateMissing(late shared.After) LateMissing {
	return LateMissing{Tag: LateMissingLate, Late: late}
}

func MissingLateMissing(missing string) LateMissing {
	return LateMissing{Tag: LateMissingMissing, Missing: missing}
}

// Record/Studio/Shrink/shrink.go
package shrink

import "fixture/shared"

func ShrinkBaseNameScaleBaseNameScaleConsIntConsStringNil(baseNameScale shared.BaseNameScale) shared.BaseName {
	return shared.BaseName{Base: baseNameScale.Base, Name: baseNameScale.Name}
}

// main.go
package main

import (
	"fixture/Data/Variant"
	"fixture/Record/Studio/Shrink"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	mapped := make([]string, len(problems))
	for index, element := range problems {
		mapped[index] = byLabel(element)
	}
	mapped2 := make([]string, len(problems))
	for index, element := range problems {
		mapped2[index] = byRecord(element)
	}
	mapped3 := make([]string, len(problems))
	for index, element := range problems {
		mapped3[index] = someLabels(element)
	}
	return array.Append(mapped, array.Append(mapped2, array.Append(mapped3, []string{shrunk.Name + strconv.Itoa(int(shrunk.Base))})))
}

func byLabel(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return byLabelX(variant.InvalidInvalidMissing(variant2.Invalid))
	case variant.InvalidLateMissingLate:
		return "late " + strconv.Itoa(int(variant2.Late.After))
	default: // variant.InvalidLateMissingMissing
		return byLabelX(variant.MissingInvalidMissing(variant2.Missing))
	}
}

var problems []variant.InvalidLateMissing = []variant.InvalidLateMissing{variant.MissingInvalidLateMissing("user"), variant.InvalidInvalidLateMissing(3), variant.LateInvalidLateMissing(shared.After{After: 5})}

func byRecord(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return "bad " + strconv.Itoa(int(variant2.Invalid*2))
	case variant.InvalidLateMissingLate:
		return "after " + strconv.Itoa(int(variant2.Late.After))
	default: // variant.InvalidLateMissingMissing
		return "no " + variant2.Missing
	}
}

func someLabels(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return strconv.Itoa(int(variant2.Invalid + 1))
	case variant.InvalidLateMissingLate:
		return someLabelsFallback(variant.LateLateMissing(variant2.Late))
	default: // variant.InvalidLateMissingMissing
		return someLabelsFallback(variant.MissingLateMissing(variant2.Missing))
	}
}

var shrunk = initializeShrunk()

func initializeShrunk() shared.BaseName {
	return shrink.ShrinkBaseNameScaleBaseNameScaleConsIntConsStringNil(shared.BaseNameScale{Base: 1, Name: "context", Scale: 2})
}

func byLabelX(variant2 variant.InvalidMissing) string {
	switch variant2.Tag {
	case variant.InvalidMissingInvalid:
		return "invalid " + strconv.Itoa(int(variant2.Invalid))
	default: // variant.InvalidMissingMissing
		return "missing " + variant2.Missing
	}
}

func someLabelsFallback(variant variant.LateMissing) string {
	return "unhandled"
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type After struct {
	After int32
}

type BaseName struct {
	Name string
	Base int32
}

type BaseNameScale struct {
	Name  string
	Base  int32
	Scale int32
}
