// Data/Variant/variant.go
package variant

import "fixture/shared"

type InvalidLateMissing struct {
	Missing string
	Invalid int
	Late    shared.After
	Tag     uint8
}

const (
	InvalidLateMissingInvalid = iota
	InvalidLateMissingLate
	InvalidLateMissingMissing
)

func Missing(missing string) InvalidLateMissing {
	return InvalidLateMissing{Tag: InvalidLateMissingMissing, Missing: missing}
}

func Invalid(invalid int) InvalidLateMissing {
	return InvalidLateMissing{Tag: InvalidLateMissingInvalid, Invalid: invalid}
}

func Late(late shared.After) InvalidLateMissing {
	return InvalidLateMissing{Tag: InvalidLateMissingLate, Late: late}
}

// Record/Studio/Shrink/shrink.go
package shrink

import "fixture/shared"

func Shrink(baseNameScale shared.BaseNameScale) shared.BaseName {
	return shared.BaseName{Base: baseNameScale.Base, Name: baseNameScale.Name}
}

// main.go
package main

import (
	"fixture/Data/Variant"
	"fixture/Record/Studio/Shrink"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	mapped := make([]string, len(problems))
	for index, element := range problems {
		mapped[index] = byLabel(element)
	}
	mapped2 := make([]string, len(problems))
	for index, element := range problems {
		mapped2[index] = byRecord(element)
	}
	mapped3 := make([]string, len(problems))
	for index, element := range problems {
		mapped3[index] = someLabels(element)
	}
	return array.Append(mapped, array.Append(mapped2, array.Append(mapped3, []string{shrunk.Name + strconv.Itoa(shrunk.Base)})))
}

func byLabel(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return "invalid " + strconv.Itoa(variant2.Invalid)
	case variant.InvalidLateMissingLate:
		return "late " + strconv.Itoa(variant2.Late.After)
	default: // variant.InvalidLateMissingMissing
		return "missing " + variant2.Missing
	}
}

var problems []variant.InvalidLateMissing = []variant.InvalidLateMissing{variant.Missing("user"), variant.Invalid(3), variant.Late(shared.After{After: 5})}

func byRecord(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return "bad " + strconv.Itoa(variant2.Invalid*2)
	case variant.InvalidLateMissingLate:
		return "after " + strconv.Itoa(variant2.Late.After)
	default: // variant.InvalidLateMissingMissing
		return "no " + variant2.Missing
	}
}

func someLabels(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return strconv.Itoa(variant2.Invalid + 1)
	case variant.InvalidLateMissingLate:
		return "unhandled"
	default: // variant.InvalidLateMissingMissing
		return "unhandled"
	}
}

var shrunk = initializeShrunk()

func initializeShrunk() shared.BaseName {
	return shrink.Shrink(shared.BaseNameScale{Base: 1, Name: "context", Scale: 2})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type After struct {
	After int
}

type BaseName struct {
	Name string
	Base int
}

type BaseNameScale struct {
	Name  string
	Base  int
	Scale int
}
