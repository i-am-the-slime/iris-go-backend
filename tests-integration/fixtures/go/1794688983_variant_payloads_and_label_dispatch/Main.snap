// Data/Variant/variant.go
package variant

import "fixture/shared"

func Case_String(r shared.VariantRepOfValue) string {
	panic("Data.Variant: pattern match failure [" + r.Type + "]")
}

// Record/Studio/Shrink/shrink.go
package shrink

import "fixture/shared"

func ShrinkBaseNameScaleBaseNameScaleConsIntConsStringNil(baseNameScale shared.BaseNameScale) shared.BaseName {
	return shared.BaseName{Base: baseNameScale.Base, Name: baseNameScale.Name}
}

// main.go
package main

import (
	"fixture/Data/Variant"
	"fixture/Record/Studio/Shrink"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	mapped := make([]string, len(problems))
	for index, element := range problems {
		mapped[index] = byLabel(element)
	}
	mapped2 := make([]string, len(problems))
	for index, element := range problems {
		mapped2[index] = byRecord(element)
	}
	mapped3 := make([]string, len(problems))
	for index, element := range problems {
		mapped3[index] = someLabels(element)
	}
	return array.Append(mapped, array.Append(mapped2, array.Append(mapped3, []string{shrunk.Name + prim.ShowInt(shrunk.Base)})))
}

func byLabel(r shared.VariantRepOfValue) string {
	if r.Type == "late" {
		scrutinee := shared.Convert(r.Value.(shared.AfterOfValue))
		return "late " + prim.ShowInt(scrutinee.After)
	}
	if r.Type == "invalid" {
		return "invalid " + prim.ShowInt(r.Value.(int32))
	}
	if r.Type == "missing" {
		return "missing " + r.Value.(string)
	}
	return variant.Case_String(r)
}

var problems = initializeProblems()

func initializeProblems() []shared.VariantRepOfValue {
	defer exception.ReportUncaught()
	return []shared.VariantRepOfValue{shared.Convert2(shared.VariantRepString{Type: "missing", Value: "user"}), shared.Convert3(shared.VariantRepInt{Type: "invalid", Value: 3}), shared.Convert5(shared.VariantRepAfter{Type: "late", Value: shared.AfterOfInt{After: 5}})}
}

func byRecord(v shared.VariantRepOfValue) string {
	s := v.Type
	var result bool
	if s == "invalid" {
		result = true
	} else if s == "late" {
		result = true
	} else {
		result = s == "missing"
	}
	if result {
		record := shared.InvalidLateMissing{Missing: func(name string) string {
			return "no " + name
		}, Invalid: func(code int32) string {
			return "bad " + prim.ShowInt(prim.MultiplyInt32(code, 2))
		}, Late: func(afterOfInt shared.AfterOfInt) string {
			return "after " + prim.ShowInt(afterOfInt.After)
		}}
		var field func(any) string
		switch v.Type {
		case "invalid":
			field = func(coerced any) string {
				return record.Invalid(coerced.(int32))
			}
		case "late":
			field = func(coerced any) string {
				return record.Late(shared.Convert(coerced.(shared.AfterOfValue)))
			}
		case "missing":
			field = func(coerced any) string {
				return record.Missing(coerced.(string))
			}
		}
		return field(v.Value)
	}
	return variant.Case_String(v)
}

func someLabels(v shared.VariantRepOfValue) string {
	if v.Type == "invalid" {
		record := shared.Invalid{Invalid: func(code int32) string {
			return prim.ShowInt(code + 1)
		}}
		var field func(any) string
		switch v.Type {
		case "invalid":
			field = func(coerced any) string {
				return record.Invalid(coerced.(int32))
			}
		}
		return field(v.Value)
	}
	return "unhandled"
}

var shrunk = initializeShrunk()

func initializeShrunk() shared.BaseName {
	defer exception.ReportUncaught()
	return shrink.ShrinkBaseNameScaleBaseNameScaleConsIntConsStringNil(shared.BaseNameScale{Base: 1, Name: "context", Scale: 2})
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type VariantRepOfValue struct {
	Type  string
	Value any
}

type AfterOfInt struct {
	After int32
}

type AfterOfValue struct {
	After any
}

func Convert(value AfterOfValue) AfterOfInt {
	return AfterOfInt{After: value.After.(int32)}
}

type VariantRepString struct {
	Type  string
	Value string
}

func Convert2(value VariantRepString) VariantRepOfValue {
	return VariantRepOfValue{Type: value.Type, Value: value.Value}
}

type VariantRepInt struct {
	Type  string
	Value int32
}

func Convert3(value VariantRepInt) VariantRepOfValue {
	return VariantRepOfValue{Type: value.Type, Value: value.Value}
}

type VariantRepAfter struct {
	Type  string
	Value AfterOfInt
}

func Convert4(value AfterOfInt) AfterOfValue {
	return AfterOfValue{After: value.After}
}

func Convert5(value VariantRepAfter) VariantRepOfValue {
	return VariantRepOfValue{Type: value.Type, Value: Convert4(value.Value)}
}

type InvalidLateMissing struct {
	Invalid func(int32) string
	Late    func(AfterOfInt) string
	Missing func(string) string
}

type Invalid struct {
	Invalid func(int32) string
}

type BaseName struct {
	Name string
	Base int32
}

type BaseNameScale struct {
	Name  string
	Base  int32
	Scale int32
}
