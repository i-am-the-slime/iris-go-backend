// Data/Variant/variant.go
package variant

import "fixture/shared"

type InvalidLateMissing struct {
	Missing string
	Invalid int32
	Late    shared.After
	Tag     uint8
}

const (
	InvalidLateMissingInvalid = iota
	InvalidLateMissingLate
	InvalidLateMissingMissing
)

type InvalidMissing struct {
	Missing string
	Invalid int32
	Tag     uint8
}

const (
	InvalidMissingInvalid = iota
	InvalidMissingMissing
)

type LateMissing struct {
	Missing string
	Late    shared.After
	Tag     uint8
}

const (
	LateMissingLate = iota
	LateMissingMissing
)

// Record/Studio/Shrink/shrink.go
package shrink

import "fixture/shared"

func ShrinkBaseNameScaleBaseNameScaleConsIntConsStringNil(baseNameScale shared.BaseNameScale) shared.BaseName {
	return shared.BaseName{Base: baseNameScale.Base, Name: baseNameScale.Name}
}

// main.go
package main

import (
	"fixture/Data/Variant"
	"fixture/Record/Studio/Shrink"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	mapped := make([]string, len(problems))
	for index, element := range problems {
		mapped[index] = byLabel(element)
	}
	mapped2 := make([]string, len(problems))
	for index, element := range problems {
		mapped2[index] = byRecord(element)
	}
	mapped3 := make([]string, len(problems))
	for index, element := range problems {
		mapped3[index] = someLabels(element)
	}
	return array.Append(mapped, array.Append(mapped2, array.Append(mapped3, []string{shrunk.Name + prim.ShowInt(shrunk.Base)})))
}

func byLabel(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return byLabelX(variant.InvalidMissing{Tag: variant.InvalidMissingInvalid, Invalid: variant2.Invalid})
	case variant.InvalidLateMissingLate:
		return "late " + prim.ShowInt(variant2.Late.After)
	default: // variant.InvalidLateMissingMissing
		return byLabelX(variant.InvalidMissing{Tag: variant.InvalidMissingMissing, Missing: variant2.Missing})
	}
}

var problems []variant.InvalidLateMissing = []variant.InvalidLateMissing{variant.InvalidLateMissing{Tag: variant.InvalidLateMissingMissing, Missing: "user"}, variant.InvalidLateMissing{Tag: variant.InvalidLateMissingInvalid, Invalid: 3}, variant.InvalidLateMissing{Tag: variant.InvalidLateMissingLate, Late: shared.After{After: 5}}}

func byRecord(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return "bad " + prim.ShowInt(prim.MultiplyInt32(variant2.Invalid, 2))
	case variant.InvalidLateMissingLate:
		return "after " + prim.ShowInt(variant2.Late.After)
	default: // variant.InvalidLateMissingMissing
		return "no " + variant2.Missing
	}
}

func someLabels(variant2 variant.InvalidLateMissing) string {
	switch variant2.Tag {
	case variant.InvalidLateMissingInvalid:
		return prim.ShowInt(variant2.Invalid + 1)
	case variant.InvalidLateMissingLate:
		return someLabelsFallback(variant.LateMissing{Tag: variant.LateMissingLate, Late: variant2.Late})
	default: // variant.InvalidLateMissingMissing
		return someLabelsFallback(variant.LateMissing{Tag: variant.LateMissingMissing, Missing: variant2.Missing})
	}
}

var shrunk = initializeShrunk()

func initializeShrunk() shared.BaseName {
	defer exception.ReportUncaught()
	return shrink.ShrinkBaseNameScaleBaseNameScaleConsIntConsStringNil(shared.BaseNameScale{Base: 1, Name: "context", Scale: 2})
}

func byLabelX(variant2 variant.InvalidMissing) string {
	switch variant2.Tag {
	case variant.InvalidMissingInvalid:
		return "invalid " + prim.ShowInt(variant2.Invalid)
	default: // variant.InvalidMissingMissing
		return "missing " + variant2.Missing
	}
}

func someLabelsFallback(variant variant.LateMissing) string {
	return "unhandled"
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type After struct {
	After int32
}

type BaseName struct {
	Name string
	Base int32
}

type BaseNameScale struct {
	Name  string
	Base  int32
	Scale int32
}
