// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// Data/Variant/variant.go
package variant

import "fixture/Type/Proxy"

type CaptionCircleSquare struct {
	Caption string
	Circle  float64
	Square  int
	Tag     uint8
}

const (
	CaptionCircleSquareCaption = iota
	CaptionCircleSquareCircle
	CaptionCircleSquareSquare
)

type Unvariant_ struct {
	ForIntRecordCaptionCircle    func(proxy.Proxy, int) CaptionCircleSquare
	ForNumberRecordCaptionSquare func(proxy.Proxy, float64) CaptionCircleSquare
	ForStringRecordCircleSquare  func(proxy.Proxy, string) CaptionCircleSquare
}

type Unvariant struct {
	ForInt                              func(proxy.Unvariant_CaptionCircleSquareInt) int
	ForString                           func(proxy.Unvariant_CaptionCircleSquareString) string
	ForVariantRecordCaptionCircleSquare func(Unvariant_) CaptionCircleSquare
}

func Circle(circle float64) CaptionCircleSquare {
	return CaptionCircleSquare{Tag: CaptionCircleSquareCircle, Circle: circle}
}

func Square(square int) CaptionCircleSquare {
	return CaptionCircleSquare{Tag: CaptionCircleSquareSquare, Square: square}
}

func Caption(caption string) CaptionCircleSquare {
	return CaptionCircleSquare{Tag: CaptionCircleSquareCaption, Caption: caption}
}

// Type/Proxy/proxy.go
package proxy

type Proxy uint8

const (
	ProxyProxy Proxy = iota
)

type Unvariant_CaptionCircleSquareInt struct {
	ForIntRecordCaptionCircle    func(Proxy, int) int
	ForNumberRecordCaptionSquare func(Proxy, float64) int
	ForStringRecordCircleSquare  func(Proxy, string) int
}

type Unvariant_CaptionCircleSquareString struct {
	ForIntRecordCaptionCircle    func(Proxy, int) string
	ForNumberRecordCaptionSquare func(Proxy, float64) string
	ForStringRecordCircleSquare  func(Proxy, string) string
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/Data/Variant"
	"fixture/Type/Proxy"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	mapped := make([]string, len(shapes))
	for index, element := range shapes {
		mapped[index] = labelOf(element)
	}
	mapped2 := make([]int, len(shapes))
	for index, element := range shapes {
		mapped2[index] = labelLength(element)
	}
	mapped3 := make([]string, len(shapes))
	for index, x := range shapes {
		scrutinee := roundTrip(x)
		var result string
		switch scrutinee.Tag {
		case variant.CaptionCircleSquareCaption:
			result = "caption " + scrutinee.Caption
		case variant.CaptionCircleSquareCircle:
			result = "circle " + prim.ShowNumber(scrutinee.Circle)
		default: // variant.CaptionCircleSquareSquare
			result = "square " + strconv.Itoa(scrutinee.Square)
		}
		mapped3[index] = result
	}
	mapped4 := make([]string, len(shapes))
	for index, x := range shapes {
		mapped4[index] = labelOf(roundTrip(roundTrip(x)))
	}
	return []string{show.ArrayString(mapped), show.ArrayInt(mapped2), show.ArrayString(mapped3), show.ArrayString(mapped4), "only"}
}

func labelOf(variant2 variant.CaptionCircleSquare) string {
	var run variant.Unvariant
	switch variant2.Tag {
	case variant.CaptionCircleSquareCaption:
		s := variant2.Caption
		run = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}}
	case variant.CaptionCircleSquareCircle:
		number := variant2.Circle
		run = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}}
	default: // variant.CaptionCircleSquareSquare
		i := variant2.Square
		run = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}}
	}
	return run.ForString(proxy.Unvariant_CaptionCircleSquareString{ForIntRecordCaptionCircle: func(_ proxy.Proxy, _ int) string {
		return "square"
	}, ForNumberRecordCaptionSquare: func(_ proxy.Proxy, _ float64) string {
		return "circle"
	}, ForStringRecordCircleSquare: func(_ proxy.Proxy, _ string) string {
		return "caption"
	}})
}

var shapes []variant.CaptionCircleSquare = []variant.CaptionCircleSquare{variant.Circle(1.5), variant.Square(2), variant.Caption("hi")}

func labelLength(variant2 variant.CaptionCircleSquare) int {
	var run variant.Unvariant
	switch variant2.Tag {
	case variant.CaptionCircleSquareCaption:
		s := variant2.Caption
		run = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}}
	case variant.CaptionCircleSquareCircle:
		number := variant2.Circle
		run = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}}
	default: // variant.CaptionCircleSquareSquare
		i := variant2.Square
		run = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}}
	}
	return run.ForInt(proxy.Unvariant_CaptionCircleSquareInt{ForIntRecordCaptionCircle: func(_ proxy.Proxy, _ int) int {
		return 6
	}, ForNumberRecordCaptionSquare: func(_ proxy.Proxy, _ float64) int {
		return 6
	}, ForStringRecordCircleSquare: func(_ proxy.Proxy, _ string) int {
		return 0
	}})
}

func roundTrip(x variant.CaptionCircleSquare) variant.CaptionCircleSquare {
	var result variant.Unvariant
	switch x.Tag {
	case variant.CaptionCircleSquareCaption:
		s := x.Caption
		result = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, s)
		}}
	case variant.CaptionCircleSquareCircle:
		number := x.Circle
		result = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, number)
		}}
	default: // variant.CaptionCircleSquareSquare
		i := x.Square
		result = variant.Unvariant{ForInt: func(continuation proxy.Unvariant_CaptionCircleSquareInt) int {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}, ForString: func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}, ForVariantRecordCaptionCircleSquare: func(continuation variant.Unvariant_) variant.CaptionCircleSquare {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, i)
		}}
	}
	return result.ForVariantRecordCaptionCircleSquare(variant.Unvariant_{ForIntRecordCaptionCircle: func(_ proxy.Proxy, i int) variant.CaptionCircleSquare {
		return variant.Square(i)
	}, ForNumberRecordCaptionSquare: func(_ proxy.Proxy, number float64) variant.CaptionCircleSquare {
		return variant.Circle(number)
	}, ForStringRecordCircleSquare: func(_ proxy.Proxy, s string) variant.CaptionCircleSquare {
		return variant.Caption(s)
	}})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
