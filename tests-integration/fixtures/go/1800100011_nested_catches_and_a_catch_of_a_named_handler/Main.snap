// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type EitherString struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringLeft = iota
	EitherStringRight
)

type EitherError struct {
	Left  exception.Error
	Right EitherString
	Tag   uint8
}

const (
	EitherErrorLeft = iota
	EitherErrorRight
)

type ErrorFailure struct {
	Failed bool
	Left   exception.Error
}

type StringFailure struct {
	Failed bool
	Left   string
}

func Left(left string) EitherString {
	return EitherString{Tag: EitherStringLeft, Left: left}
}

func Right(right int32) EitherString {
	return EitherString{Tag: EitherStringRight, Right: right}
}

func EitherStringFromResults(value int32, err StringFailure) EitherString {
	if err.Failed {
		return Left(err.Left)
	}
	return Right(value)
}

// main.go
package main

import (
	"fixture/Data/Either"
	internal "fixture/Go_IO_Internal_ffi"
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	for _, i := range []int32{1, 3, -1, -4} {
		either2, err := internal.CatchResultsImpl(func(failure exception.Error) (either.EitherString, either.ErrorFailure) {
			return either.EitherString{}, either.ErrorFailure{Failed: true, Left: failure}
		}, func() (either.EitherString, either.ErrorFailure) {
			first := either.EitherStringFromResults(internal.CatchResultsImpl(func(_ exception.Error) (int32, either.StringFailure) {
				return check(-i)
			}, func() (int32, either.StringFailure) {
				return check(i)
			}))
			if first.Tag == either.EitherStringLeft {
				if first.Left == "too many: 3" {
					panic(exception.NewError("gave up"))
				}
			}
			return first, either.ErrorFailure{}
		})
		var result string
		if err.Failed {
			result = "threw " + exception.Message(err.Left)
		} else if !err.Failed && either2.Tag == either.EitherStringLeft {
			result = "failed " + either2.Left
		} else {
			result = "got " + strconv.Itoa(int(either2.Right))
		}
		journal.Log(result)
		outcome := internal.CatchImpl(reportFailure, func() either.EitherString {
			return either.EitherStringFromResults(check(i))
		})
		var result2 string
		switch outcome.Tag {
		case either.EitherStringLeft:
			result2 = "(Left " + prim.ShowString(outcome.Left) + ")"
		default: // either.EitherStringRight
			result2 = "(Right " + strconv.Itoa(int(outcome.Right)) + ")"
		}
		journal.Log(result2)
	}
}

func check(n int32) (int32, either.StringFailure) {
	if n > 2 {
		return 0, either.StringFailure{Failed: true, Left: "too many: " + strconv.Itoa(int(n))}
	}
	if n < 0 {
		panic(exception.NewError("below zero"))
	}
	return n*10, either.StringFailure{}
}

func reportFailure(failure exception.Error) either.EitherString {
	journal.Log("reported " + exception.Message(failure))
	return either.Left(exception.Message(failure))
}
