// main.go
package main

import "os"

func main_() int32 {
	var count int32 = 0
	count += 1
	count += 10
	count += 100
	mainGo(0, struct{}{})
	count += 1000
	var performed bool
	performed = false
	count += 10000
	var result int32
	if performed {
		result = 1
	} else {
		result = 0
	}
	return count + result
}

func mainGo(n int32, acc struct{}) {
	for {
		if n <= 0 {
			return
		}
		n, _ = n-1, struct{}{}
	}
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

