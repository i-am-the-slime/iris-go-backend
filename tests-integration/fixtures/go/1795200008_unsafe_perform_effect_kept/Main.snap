// Control/Category/category.go
package category

func Identity(x any) any {
	return x
}

// main.go
package main

import "os"

func main_() int {
	count := 0
	count += 1
	count += 10
	count += 100
	mainGo(0, struct{}{})
	count += 1000
	var performed bool
	performed = false
	count += 10000
	var result int
	if performed {
		result = 1
	} else {
		result = 0
	}
	return count + result
}

func mainGo(n int, acc struct{}) {
	for {
		if n <= 0 {
			return
		}
		n, _ = n-1, struct{}{}
	}
}

func main() {
	os.Exit(main_())
}

