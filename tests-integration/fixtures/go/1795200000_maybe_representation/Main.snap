// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

type MaybeInt struct {
	Just Int
	Tag  uint8
}

func JustMaybeInt(just Int) MaybeInt {
	return MaybeInt{Tag: TagJust, Just: just}
}

var NoMaybeInt = MaybeInt{Tag: TagNothing}

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

func JustBoolean(just bool) Boolean {
	if just {
		return True
	}
	return False
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int
}

var sharedTreeLeaf = &Tree{}

type Shape struct {
	Field0 int
	Field1 int
	Tag    uint8
}

const (
	ShapeCircle = iota
	ShapeSquare
)

type MaybeShape struct {
	Just Shape
	Tag  uint8
}

func JustShape(just Shape) MaybeShape {
	return MaybeShape{Tag: maybe.TagJust, Just: just}
}

var NoShape = MaybeShape{Tag: maybe.TagNothing}

func Circle(field0 int) Shape {
	return Shape{Tag: ShapeCircle, Field0: field0}
}

func Square(field0 int, field1 int) Shape {
	return Shape{Tag: ShapeSquare, Field0: field0, Field1: field1}
}

func Node(node0 *Tree, node1 int, node2 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: node1, Node2: node2}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	x := opaque(10)
	var result int
	if x > 0 {
		result = x + 1
	} else {
		result = 0
	}
	x2 := opaque(1)
	x3 := opaque(1)
	var result2 maybe.Int
	if x2 > 0 {
		result2 = maybe.JustInt(x2 + 1)
	} else {
		result2 = maybe.NoInt
	}
	var result3 maybe.Int
	if x3 > 0 {
		result3 = maybe.JustInt(x3 + 1)
	} else {
		result3 = maybe.NoInt
	}
	var result4 bool
	if result2.Tag == maybe.TagNothing && result3.Tag == maybe.TagNothing {
		result4 = true
	} else if result2.Tag == maybe.TagJust && result3.Tag == maybe.TagJust {
		result4 = result2.Just == result3.Just
	} else {
		result4 = false
	}
	x4 := opaque(1)
	x5 := opaque(2)
	var result5 maybe.Int
	if x4 > 0 {
		result5 = maybe.JustInt(x4 + 1)
	} else {
		result5 = maybe.NoInt
	}
	var result6 maybe.Int
	if x5 > 0 {
		result6 = maybe.JustInt(x5 + 1)
	} else {
		result6 = maybe.NoInt
	}
	var result7 string
	if result5.Tag == maybe.TagNothing && result6.Tag == maybe.TagNothing {
		result7 = "EQ"
	} else if result5.Tag == maybe.TagNothing {
		result7 = "LT"
	} else if result6.Tag == maybe.TagNothing {
		result7 = "GT"
	} else {
		left0 := result5.Just
		right0 := result6.Just
		if left0 < right0 {
			result7 = "LT"
		} else if left0 == right0 {
			result7 = "EQ"
		} else {
			result7 = "GT"
		}
	}
	var result8 string
	if opaque(1) > 0 {
		result8 = "(Just " + prim.ShowChar('c') + ")"
	} else {
		result8 = "Nothing"
	}
	x6 := opaque(7)
	var result9 string
	if x6 > 0 {
		result9 = "(Just " + strconv.FormatBool(x6 > 5) + ")"
	} else {
		result9 = "Nothing"
	}
	x7 := opaque(4)
	var result10 string
	if x7 > 0 {
		result10 = "(Just " + strconv.Itoa(sumTreeNode(sharedTreeLeaf, x7, sharedTreeLeaf)) + ")"
	} else {
		result10 = "Nothing"
	}
	x8 := opaque(5)
	var result11 string
	if x8 > 0 {
		result11 = "(Just " + strconv.Itoa(1+x8) + ")"
	} else {
		result11 = "Nothing"
	}
	var result12 string
	if opaque(1) > 0 {
		result12 = "yes"
	} else {
		result12 = "no"
	}
	x9 := opaque(2)
	var result13 string
	if x9 > 0 {
		x10 := x9 - 1
		var result14 string
		if x10 > 0 {
			result14 = "(Just " + strconv.Itoa(x10+1) + ")"
		} else {
			result14 = "Nothing"
		}
		result13 = "(Just " + result14 + ")"
	} else {
		result13 = "Nothing"
	}
	x11 := opaque(-7)
	x12 := opaque(-7)
	var result15 MaybeShape
	if x11 > 0 {
		result15 = JustShape(Circle(x11))
	} else if x11 < -5 {
		result15 = JustShape(Square(x11, x11))
	} else {
		result15 = NoShape
	}
	var result16 MaybeShape
	if x12 > 0 {
		result16 = JustShape(Circle(x12))
	} else if x12 < -5 {
		result16 = JustShape(Square(x12, x12))
	} else {
		result16 = NoShape
	}
	var result17 bool
	if result15.Tag == maybe.TagNothing && result16.Tag == maybe.TagNothing {
		result17 = true
	} else if result15.Tag == maybe.TagJust && result16.Tag == maybe.TagJust {
		if result15.Just.Tag == ShapeCircle && result16.Just.Tag == ShapeCircle {
			result17 = result15.Just.Field0 == result16.Just.Field0
		} else if result15.Just.Tag == ShapeSquare && result16.Just.Tag == ShapeSquare {
			if result15.Just.Field0 == result16.Just.Field0 {
				result17 = result15.Just.Field1 == result16.Just.Field1
			} else {
				result17 = false
			}
		} else {
			result17 = false
		}
	} else {
		result17 = false
	}
	x13 := opaque(7)
	x14 := opaque(-7)
	var result18 MaybeShape
	if x13 > 0 {
		result18 = JustShape(Circle(x13))
	} else if x13 < -5 {
		result18 = JustShape(Square(x13, x13))
	} else {
		result18 = NoShape
	}
	var result19 MaybeShape
	if x14 > 0 {
		result19 = JustShape(Circle(x14))
	} else if x14 < -5 {
		result19 = JustShape(Square(x14, x14))
	} else {
		result19 = NoShape
	}
	var result20 string
	if result18.Tag == maybe.TagNothing && result19.Tag == maybe.TagNothing {
		result20 = "EQ"
	} else if result18.Tag == maybe.TagNothing {
		result20 = "LT"
	} else if result19.Tag == maybe.TagNothing {
		result20 = "GT"
	} else if result18.Just.Tag == ShapeCircle && result19.Just.Tag == ShapeCircle {
		left0 := result18.Just.Field0
		right0 := result19.Just.Field0
		if left0 < right0 {
			result20 = "LT"
		} else if left0 == right0 {
			result20 = "EQ"
		} else {
			result20 = "GT"
		}
	} else if result18.Just.Tag == ShapeCircle {
		result20 = "LT"
	} else if result19.Just.Tag == ShapeCircle {
		result20 = "GT"
	} else {
		left0 := result18.Just.Field0
		left1 := result18.Just.Field1
		right0 := result19.Just.Field0
		right1 := result19.Just.Field1
		if left0 < right0 {
			result20 = "LT"
		} else if left0 == right0 {
			if left1 < right1 {
				result20 = "LT"
			} else if left1 == right1 {
				result20 = "EQ"
			} else {
				result20 = "GT"
			}
		} else {
			result20 = "GT"
		}
	}
	x15 := opaque(1)
	var result21 maybe.Int
	if x15 > 0 {
		result21 = maybe.JustInt(x15 + 1)
	} else {
		result21 = maybe.NoInt
	}
	elements := []maybe.Int{result21, maybe.NoInt}
	var result22 string
	scrutinee := elements[0]
	var result23 string
	switch scrutinee.Tag {
	case maybe.TagJust:
		result23 = "(Just " + strconv.Itoa(scrutinee.Just) + ")"
	default: // maybe.TagNothing
		result23 = "Nothing"
	}
	result22 = "(Just " + result23 + ")"
	x16 := opaque(1)
	var result24 *Tree
	if x16 > 0 {
		result24 = Node(sharedTreeLeaf, x16, sharedTreeLeaf)
	} else {
		result24 = nil
	}
	var result25 string
	if result24 != nil && result24 != sharedTreeLeaf {
		result25 = strconv.Itoa(result24.Node1)
	} else if result24 != nil && result24 == sharedTreeLeaf {
		result25 = "leaf"
	} else {
		result25 = "none"
	}
	x17 := opaque(2)
	var result26 maybe.MaybeInt
	if x17 > 0 {
		x10 := x17 - 1
		var result14 maybe.Int
		if x10 > 0 {
			result14 = maybe.JustInt(x10 + 1)
		} else {
			result14 = maybe.NoInt
		}
		result26 = maybe.JustMaybeInt(result14)
	} else {
		result26 = maybe.NoMaybeInt
	}
	var result27 string
	if result26.Tag == maybe.TagJust && result26.Just.Tag == maybe.TagJust {
		result27 = strconv.Itoa(result26.Just.Just)
	} else if result26.Tag == maybe.TagJust && result26.Just.Tag == maybe.TagNothing {
		result27 = "just nothing"
	} else {
		result27 = "nothing"
	}
	var result28 string
	if opaque(1) > 0 {
		result28 = "c"
	} else {
		result28 = "none"
	}
	x18 := opaque(7)
	var result29 maybe.Boolean
	if x18 > 0 {
		result29 = maybe.JustBoolean(x18 > 5)
	} else {
		result29 = maybe.NoBoolean
	}
	var result30 string
	if result29 == maybe.True {
		result30 = "yes"
	} else if result29 == maybe.False {
		result30 = "no"
	} else {
		result30 = "none"
	}
	return []string{strconv.Itoa(result), strconv.FormatBool(result4), result7, result8, result9, result10, result11, result12, result13, strconv.FormatBool(result17), result20, strconv.FormatBool(opaque(0) > 0), result22, result25, result27, result28, result30}
}

func opaque(x int) int {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func sumTree(tree *Tree) int {
	if tree == sharedTreeLeaf {
		return 0
	}
	return sumTree(tree.Node0) + tree.Node1 + sumTree(tree.Node2)
}

func sumTreeNode(l *Tree, x int, r *Tree) int {
	return sumTree(l) + x + sumTree(r)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
