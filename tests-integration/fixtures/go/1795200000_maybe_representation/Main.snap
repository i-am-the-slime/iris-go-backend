// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

type MaybeInt struct {
	Just Int
	Tag  uint8
}

func JustMaybeInt(just Int) MaybeInt {
	return MaybeInt{Tag: TagJust, Just: just}
}

var NoMaybeInt = MaybeInt{Tag: TagNothing}

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

func JustBoolean(just bool) Boolean {
	if just {
		return True
	}
	return False
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int
}

var sharedTreeLeaf = &Tree{}

type Shape struct {
	Field0 int
	Field1 int
	Tag    uint8
}

const (
	ShapeCircle = iota
	ShapeSquare
)

type MaybeShape struct {
	Just Shape
	Tag  uint8
}

func JustShape(just Shape) MaybeShape {
	return MaybeShape{Tag: maybe.TagJust, Just: just}
}

var NoShape = MaybeShape{Tag: maybe.TagNothing}

func Circle(field0 int) Shape {
	return Shape{Tag: ShapeCircle, Field0: field0}
}

func Square(field0 int, field1 int) Shape {
	return Shape{Tag: ShapeSquare, Field0: field0, Field1: field1}
}

func Node(node0 *Tree, node1 int, node2 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: node1, Node2: node2}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	x := opaque(10)
	var result int
	if x > 0 {
		result = x + 1
	} else {
		result = 0
	}
	x2 := opaque(1)
	var left maybe.Int
	if x2 > 0 {
		left = maybe.JustInt(x2 + 1)
	} else {
		left = maybe.NoInt
	}
	x3 := opaque(1)
	var result2 bool
	if x3 > 0 {
		switch left.Tag {
		case maybe.TagJust:
			result2 = left.Just == x3+1
		default:
			result2 = false
		}
	} else {
		switch left.Tag {
		case maybe.TagNothing:
			result2 = true
		default:
			result2 = false
		}
	}
	x4 := opaque(1)
	var left2 maybe.Int
	if x4 > 0 {
		left2 = maybe.JustInt(x4 + 1)
	} else {
		left2 = maybe.NoInt
	}
	x5 := opaque(2)
	var result3 string
	if x5 > 0 {
		switch left2.Tag {
		case maybe.TagNothing:
			result3 = "LT"
		default: // maybe.TagJust
			left0 := left2.Just
			field := x5 + 1
			if left0 < field {
				result3 = "LT"
			} else if left0 == field {
				result3 = "EQ"
			} else {
				result3 = "GT"
			}
		}
	} else {
		switch left2.Tag {
		case maybe.TagNothing:
			result3 = "EQ"
		default:
			result3 = "GT"
		}
	}
	var result4 string
	if opaque(1) > 0 {
		result4 = "(Just " + prim.ShowChar('c') + ")"
	} else {
		result4 = "Nothing"
	}
	x6 := opaque(7)
	var result5 string
	if x6 > 0 {
		result5 = "(Just " + strconv.FormatBool(x6 > 5) + ")"
	} else {
		result5 = "Nothing"
	}
	x7 := opaque(4)
	var result6 string
	if x7 > 0 {
		result6 = "(Just " + strconv.Itoa(sumTreeNode(sharedTreeLeaf, x7, sharedTreeLeaf)) + ")"
	} else {
		result6 = "Nothing"
	}
	x8 := opaque(5)
	var result7 string
	if x8 > 0 {
		result7 = "(Just " + strconv.Itoa(1+x8) + ")"
	} else {
		result7 = "Nothing"
	}
	var result8 string
	if opaque(1) > 0 {
		result8 = "yes"
	} else {
		result8 = "no"
	}
	x9 := opaque(2)
	var result9 string
	if x9 > 0 {
		x10 := x9 - 1
		var result10 string
		if x10 > 0 {
			result10 = "(Just " + strconv.Itoa(x10+1) + ")"
		} else {
			result10 = "Nothing"
		}
		result9 = "(Just " + result10 + ")"
	} else {
		result9 = "Nothing"
	}
	x11 := opaque(-7)
	var left3 MaybeShape
	if x11 > 0 {
		left3 = JustShape(Circle(x11))
	} else if x11 < -5 {
		left3 = JustShape(Square(x11, x11))
	} else {
		left3 = NoShape
	}
	x12 := opaque(-7)
	var result11 bool
	if x12 > 0 {
		switch left3.Tag {
		case maybe.TagJust:
			result11 = mainJoin(left3.Just, Circle(x12))
		default:
			result11 = false
		}
	} else if x12 < -5 {
		switch left3.Tag {
		case maybe.TagJust:
			result11 = mainJoin(left3.Just, Square(x12, x12))
		default:
			result11 = false
		}
	} else {
		switch left3.Tag {
		case maybe.TagNothing:
			result11 = true
		default:
			result11 = false
		}
	}
	x13 := opaque(7)
	var left4 MaybeShape
	if x13 > 0 {
		left4 = JustShape(Circle(x13))
	} else if x13 < -5 {
		left4 = JustShape(Square(x13, x13))
	} else {
		left4 = NoShape
	}
	x14 := opaque(-7)
	var result12 string
	if x14 > 0 {
		switch left4.Tag {
		case maybe.TagNothing:
			result12 = "LT"
		default: // maybe.TagJust
			switch left4.Just.Tag {
			case ShapeCircle:
				left0 := left4.Just.Field0
				if left0 < x14 {
					result12 = "LT"
				} else if left0 == x14 {
					result12 = "EQ"
				} else {
					result12 = "GT"
				}
			default:
				result12 = "GT"
			}
		}
	} else if x14 < -5 {
		switch left4.Tag {
		case maybe.TagNothing:
			result12 = "LT"
		default: // maybe.TagJust
			switch left4.Just.Tag {
			case ShapeCircle:
				result12 = "LT"
			default: // ShapeSquare
				left0 := left4.Just.Field0
				left1 := left4.Just.Field1
				if left0 < x14 {
					result12 = "LT"
				} else if left0 == x14 {
					if left1 < x14 {
						result12 = "LT"
					} else if left1 == x14 {
						result12 = "EQ"
					} else {
						result12 = "GT"
					}
				} else {
					result12 = "GT"
				}
			}
		}
	} else {
		switch left4.Tag {
		case maybe.TagNothing:
			result12 = "EQ"
		default:
			result12 = "GT"
		}
	}
	x15 := opaque(1)
	var result13 maybe.Int
	if x15 > 0 {
		result13 = maybe.JustInt(x15 + 1)
	} else {
		result13 = maybe.NoInt
	}
	elements := []maybe.Int{result13, maybe.NoInt}
	var result14 string
	scrutinee := elements[0]
	var result15 string
	switch scrutinee.Tag {
	case maybe.TagJust:
		result15 = "(Just " + strconv.Itoa(scrutinee.Just) + ")"
	default: // maybe.TagNothing
		result15 = "Nothing"
	}
	result14 = "(Just " + result15 + ")"
	x16 := opaque(1)
	var result16 *Tree
	if x16 > 0 {
		result16 = Node(sharedTreeLeaf, x16, sharedTreeLeaf)
	} else {
		result16 = nil
	}
	var result17 string
	if result16 != nil && result16 != sharedTreeLeaf {
		result17 = strconv.Itoa(result16.Node1)
	} else if result16 != nil && result16 == sharedTreeLeaf {
		result17 = "leaf"
	} else {
		result17 = "none"
	}
	x17 := opaque(2)
	var result18 maybe.MaybeInt
	if x17 > 0 {
		x10 := x17 - 1
		var result10 maybe.Int
		if x10 > 0 {
			result10 = maybe.JustInt(x10 + 1)
		} else {
			result10 = maybe.NoInt
		}
		result18 = maybe.JustMaybeInt(result10)
	} else {
		result18 = maybe.NoMaybeInt
	}
	var result19 string
	if result18.Tag == maybe.TagJust && result18.Just.Tag == maybe.TagJust {
		result19 = strconv.Itoa(result18.Just.Just)
	} else if result18.Tag == maybe.TagJust && result18.Just.Tag == maybe.TagNothing {
		result19 = "just nothing"
	} else {
		result19 = "nothing"
	}
	var result20 string
	if opaque(1) > 0 {
		result20 = "c"
	} else {
		result20 = "none"
	}
	x18 := opaque(7)
	var result21 maybe.Boolean
	if x18 > 0 {
		result21 = maybe.JustBoolean(x18 > 5)
	} else {
		result21 = maybe.NoBoolean
	}
	var result22 string
	if result21 == maybe.True {
		result22 = "yes"
	} else if result21 == maybe.False {
		result22 = "no"
	} else {
		result22 = "none"
	}
	return []string{strconv.Itoa(result), strconv.FormatBool(result2), result3, result4, result5, result6, result7, result8, result9, strconv.FormatBool(result11), result12, strconv.FormatBool(opaque(0) > 0), result14, result17, result19, result20, result22}
}

func opaque(x int) int {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func sumTree(tree *Tree) int {
	if tree == sharedTreeLeaf {
		return 0
	}
	return sumTree(tree.Node0) + tree.Node1 + sumTree(tree.Node2)
}

func sumTreeNode(l *Tree, x int, r *Tree) int {
	return sumTree(l) + x + sumTree(r)
}

func mainJoin(left0 Shape, right0 Shape) bool {
	if left0.Tag == ShapeCircle && right0.Tag == ShapeCircle {
		return left0.Field0 == right0.Field0
	}
	if left0.Tag == ShapeSquare && right0.Tag == ShapeSquare {
		if left0.Field0 == right0.Field0 {
			return left0.Field1 == right0.Field1
		}
		return false
	}
	return false
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
