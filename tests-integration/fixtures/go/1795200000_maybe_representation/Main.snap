// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

const TagNothing = 0

const TagJust = 1

type MaybeInt struct {
	Just Int
	Tag  uint8
}

func JustMaybeInt(just Int) MaybeInt {
	return MaybeInt{Tag: TagJust, Just: just}
}

var NoMaybeInt = MaybeInt{Tag: TagNothing}

type Char int64

const NoChar Char = 1 << 32

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

func JustBoolean(just bool) Boolean {
	if just {
		return True
	}
	return False
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int32
}

var sharedTreeLeaf = &Tree{}

type Shape struct {
	Circle  int32
	Square0 int32
	Square1 int32
	Tag     uint8
}

const (
	ShapeCircle = iota
	ShapeSquare
)

type MaybeShape struct {
	Just Shape
	Tag  uint8
}

func JustShape(just Shape) MaybeShape {
	return MaybeShape{Tag: maybe.TagJust, Just: just}
}

var NoShape = MaybeShape{Tag: maybe.TagNothing}

func Node(node0 *Tree, node1 int32, node2 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: node1, Node2: node2}
}

func Circle(circle int32) Shape {
	return Shape{Tag: ShapeCircle, Circle: circle}
}

func Square(square0 int32, square1 int32) Shape {
	return Shape{Tag: ShapeSquare, Square0: square0, Square1: square1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	x := opaque(10)
	var result int32
	if x > 0 {
		result = x + 1
	} else {
		result = 0
	}
	x2 := opaque(1)
	x3 := opaque(1)
	var result2 maybe.Int
	if x2 > 0 {
		result2 = maybe.Int(x2 + 1)
	} else {
		result2 = maybe.NoInt
	}
	var result3 maybe.Int
	if x3 > 0 {
		result3 = maybe.Int(x3 + 1)
	} else {
		result3 = maybe.NoInt
	}
	var result4 bool
	if result2 == maybe.NoInt && result3 == maybe.NoInt {
		result4 = true
	} else if result2 != maybe.NoInt && result3 != maybe.NoInt {
		result4 = int32(result2) == int32(result3)
	} else {
		result4 = false
	}
	x4 := opaque(1)
	x5 := opaque(2)
	var result5 maybe.Int
	if x4 > 0 {
		result5 = maybe.Int(x4 + 1)
	} else {
		result5 = maybe.NoInt
	}
	var result6 maybe.Int
	if x5 > 0 {
		result6 = maybe.Int(x5 + 1)
	} else {
		result6 = maybe.NoInt
	}
	var result7 string
	if result5 == maybe.NoInt && result6 == maybe.NoInt {
		result7 = "EQ"
	} else if result5 == maybe.NoInt {
		result7 = "LT"
	} else if result6 == maybe.NoInt {
		result7 = "GT"
	} else {
		left0 := int32(result5)
		right0 := int32(result6)
		if left0 < right0 {
			result7 = "LT"
		} else if left0 == right0 {
			result7 = "EQ"
		} else {
			result7 = "GT"
		}
	}
	var result8 string
	if opaque(1) > 0 {
		result8 = "(Just " + prim.ShowChar('c') + ")"
	} else {
		result8 = "Nothing"
	}
	x6 := opaque(7)
	var result9 string
	if x6 > 0 {
		result9 = "(Just " + strconv.FormatBool(x6 > 5) + ")"
	} else {
		result9 = "Nothing"
	}
	x7 := opaque(4)
	var result10 string
	if x7 > 0 {
		result10 = "(Just " + strconv.Itoa(int(sumTree(Node(sharedTreeLeaf, x7, sharedTreeLeaf)))) + ")"
	} else {
		result10 = "Nothing"
	}
	x8 := opaque(5)
	var result11 string
	if x8 > 0 {
		result11 = "(Just " + strconv.Itoa(int(1+x8)) + ")"
	} else {
		result11 = "Nothing"
	}
	var result12 string
	if opaque(1) > 0 {
		result12 = "yes"
	} else {
		result12 = "no"
	}
	x9 := opaque(2)
	var result13 string
	if x9 > 0 {
		x10 := x9 - 1
		var result14 string
		if x10 > 0 {
			result14 = "(Just " + strconv.Itoa(int(x10+1)) + ")"
		} else {
			result14 = "Nothing"
		}
		result13 = "(Just " + result14 + ")"
	} else {
		result13 = "Nothing"
	}
	x11 := opaque(-7)
	x12 := opaque(-7)
	var result15 MaybeShape
	if x11 > 0 {
		result15 = JustShape(Circle(x11))
	} else if x11 < -5 {
		result15 = JustShape(Square(x11, x11))
	} else {
		result15 = NoShape
	}
	var result16 MaybeShape
	if x12 > 0 {
		result16 = JustShape(Circle(x12))
	} else if x12 < -5 {
		result16 = JustShape(Square(x12, x12))
	} else {
		result16 = NoShape
	}
	var result17 bool
	if result15.Tag == maybe.TagNothing && result16.Tag == maybe.TagNothing {
		result17 = true
	} else if result15.Tag == maybe.TagJust && result16.Tag == maybe.TagJust {
		if result15.Just.Tag == ShapeCircle && result16.Just.Tag == ShapeCircle {
			result17 = result15.Just.Circle == result16.Just.Circle
		} else if result15.Just.Tag == ShapeSquare && result16.Just.Tag == ShapeSquare {
			if result15.Just.Square0 == result16.Just.Square0 {
				result17 = result15.Just.Square1 == result16.Just.Square1
			} else {
				result17 = false
			}
		} else {
			result17 = false
		}
	} else {
		result17 = false
	}
	x13 := opaque(7)
	x14 := opaque(-7)
	var result18 MaybeShape
	if x13 > 0 {
		result18 = JustShape(Circle(x13))
	} else if x13 < -5 {
		result18 = JustShape(Square(x13, x13))
	} else {
		result18 = NoShape
	}
	var result19 MaybeShape
	if x14 > 0 {
		result19 = JustShape(Circle(x14))
	} else if x14 < -5 {
		result19 = JustShape(Square(x14, x14))
	} else {
		result19 = NoShape
	}
	var result20 string
	if result18.Tag == maybe.TagNothing && result19.Tag == maybe.TagNothing {
		result20 = "EQ"
	} else if result18.Tag == maybe.TagNothing {
		result20 = "LT"
	} else if result19.Tag == maybe.TagNothing {
		result20 = "GT"
	} else if result18.Just.Tag == ShapeCircle && result19.Just.Tag == ShapeCircle {
		left0 := result18.Just.Circle
		right0 := result19.Just.Circle
		if left0 < right0 {
			result20 = "LT"
		} else if left0 == right0 {
			result20 = "EQ"
		} else {
			result20 = "GT"
		}
	} else if result18.Just.Tag == ShapeCircle {
		result20 = "LT"
	} else if result19.Just.Tag == ShapeCircle {
		result20 = "GT"
	} else {
		left0 := result18.Just.Square0
		left1 := result18.Just.Square1
		right0 := result19.Just.Square0
		right1 := result19.Just.Square1
		if left0 < right0 {
			result20 = "LT"
		} else if left0 == right0 {
			if left1 < right1 {
				result20 = "LT"
			} else if left1 == right1 {
				result20 = "EQ"
			} else {
				result20 = "GT"
			}
		} else {
			result20 = "GT"
		}
	}
	x15 := opaque(1)
	var result21 maybe.Int
	if x15 > 0 {
		result21 = maybe.Int(x15 + 1)
	} else {
		result21 = maybe.NoInt
	}
	elements := []maybe.Int{result21, maybe.NoInt}
	var result22 string
	scrutinee := elements[0]
	var result23 string
	if scrutinee != maybe.NoInt {
		result23 = "(Just " + strconv.Itoa(int(int32(scrutinee))) + ")"
	} else {
		result23 = "Nothing"
	}
	result22 = "(Just " + result23 + ")"
	x16 := opaque(1)
	var result24 *Tree
	if x16 > 0 {
		result24 = Node(sharedTreeLeaf, x16, sharedTreeLeaf)
	} else {
		result24 = nil
	}
	var result25 string
	if result24 != nil && result24 != sharedTreeLeaf {
		result25 = strconv.Itoa(int(result24.Node1))
	} else if result24 != nil && result24 == sharedTreeLeaf {
		result25 = "leaf"
	} else {
		result25 = "none"
	}
	x17 := opaque(2)
	var result26 maybe.MaybeInt
	if x17 > 0 {
		x10 := x17 - 1
		var result14 maybe.Int
		if x10 > 0 {
			result14 = maybe.Int(x10 + 1)
		} else {
			result14 = maybe.NoInt
		}
		result26 = maybe.JustMaybeInt(result14)
	} else {
		result26 = maybe.NoMaybeInt
	}
	var result27 string
	if result26.Tag == maybe.TagJust && result26.Just != maybe.NoInt {
		result27 = strconv.Itoa(int(int32(result26.Just)))
	} else if result26.Tag == maybe.TagJust && result26.Just == maybe.NoInt {
		result27 = "just nothing"
	} else {
		result27 = "nothing"
	}
	var result28 maybe.Char
	if opaque(1) > 0 {
		result28 = maybe.Char('c')
	} else {
		result28 = maybe.NoChar
	}
	var result29 string
	if result28 != maybe.NoChar && rune(result28) == 'c' {
		result29 = "c"
	} else if result28 != maybe.NoChar {
		result29 = "other"
	} else {
		result29 = "none"
	}
	x18 := opaque(7)
	var result30 maybe.Boolean
	if x18 > 0 {
		result30 = maybe.JustBoolean(x18 > 5)
	} else {
		result30 = maybe.NoBoolean
	}
	var result31 string
	if result30 == maybe.True {
		result31 = "yes"
	} else if result30 == maybe.False {
		result31 = "no"
	} else {
		result31 = "none"
	}
	return []string{strconv.Itoa(int(result)), strconv.FormatBool(result4), result7, result8, result9, result10, result11, result12, result13, strconv.FormatBool(result17), result20, strconv.FormatBool(opaque(0) > 0), result22, result25, result27, result29, result31}
}

func opaque(x int32) int32 {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func sumTree(tree *Tree) int32 {
	if tree == sharedTreeLeaf {
		return 0
	}
	return sumTree(tree.Node0) + tree.Node1 + sumTree(tree.Node2)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
