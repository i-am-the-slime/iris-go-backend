// Data/Functor/Variant/variant.go
package variant

import "fixture/Data/List/Types"

func Lookup(tag string, list *types.ListString, list2 *types.List) func(func(any) any) func(any) any {
	for {
		if list != types.SharedListStringNil && list2 != types.SharedListNil {
			t := list.Cons0
			ts := list.Cons1
			m := list2.Cons0
			ms := list2.Cons1
			if t == tag {
				return m
			}
			list, list2 = ts, ms
			continue
		}
		list, list2 = types.SharedListStringNil, types.SharedListNil
	}
}

func LookupConsCons(tag string, t string, ts *types.ListString, m func(func(any) any) func(any) any, ms *types.List) func(func(any) any) func(any) any {
	if t == tag {
		return m
	}
	return Lookup(tag, ts, ms)
}

// Data/List/Types/types.go
package types

type ListString struct {
	Cons0 string
	Cons1 *ListString
}

var SharedListStringNil = &ListString{}

type List struct {
	Cons0 func(func(any) any) func(any) any
	Cons1 *List
}

var SharedListNil = &List{}

func Cons(cons0 string, cons1 *ListString) *ListString {
	return &ListString{Cons0: cons0, Cons1: cons1}
}

// main.go
package main

import (
	"fixture/Data/Functor/Variant"
	"fixture/Data/List/Types"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type BoxInt struct {
	Box int
}

type Box struct {
	Box    any
	Origin any
}

type MapTypeValueOfFnFnValueValueFnBoxBoxBoxInt struct {
	Map   func(func(any) any) func(*Box) *Box
	Type  string
	Value BoxInt
}

func convert(value BoxInt) *Box {
	return &Box{Box: value.Box, Origin: value}
}

func convert2(value MapTypeValueOfFnFnValueValueFnBoxBoxBoxInt) shared.MapTypeValue {
	return shared.MapTypeValue{Map: func(coerced func(any) any) func(any) any {
		original := value.Map(coerced)
		return func(coerced2 any) any {
			return original(coerced2.(*Box))
		}
	}, Type: value.Type, Value: convert(value.Value)}
}

func convert3(value *Box) BoxInt {
	if original, ok := value.Origin.(BoxInt); ok {
		return original
	}
	return BoxInt{Box: value.Box.(int)}
}

type PairInt struct {
	First  int
	Second int
}

type Pair struct {
	First  any
	Second any
	Origin any
}

func convert4(value *Pair) PairInt {
	if original, ok := value.Origin.(PairInt); ok {
		return original
	}
	return PairInt{First: value.First.(int), Second: value.Second.(int)}
}

type MapTypeValueOfFnFnValueValueFnPairPairPairInt struct {
	Map   func(func(any) any) func(*Pair) *Pair
	Type  string
	Value PairInt
}

func convert5(value PairInt) *Pair {
	return &Pair{First: value.First, Second: value.Second, Origin: value}
}

func convert6(value MapTypeValueOfFnFnValueValueFnPairPairPairInt) shared.MapTypeValue {
	return shared.MapTypeValue{Map: func(coerced func(any) any) func(any) any {
		original := value.Map(coerced)
		return func(coerced2 any) any {
			return original(coerced2.(*Pair))
		}
	}, Type: value.Type, Value: convert5(value.Value)}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	a := convert2(MapTypeValueOfFnFnValueValueFnBoxBoxBoxInt{Type: "first", Value: BoxInt{Box: 41}, Map: func(function func(any) any) func(*Box) *Box {
		return func(value *Box) *Box {
			return mapBox(function, value)
		}
	}})
	vValue := a.Map(func(coerced any) any {
		return coerced.(int) + 1
	})(a.Value)
	var result string
	if a.Type == "first" {
		scrutinee := convert3(vValue.(*Box))
		result = "box " + strconv.Itoa(scrutinee.Box)
	} else {
		scrutinee := convert4(vValue.(*Pair))
		result = "pair " + strconv.Itoa(scrutinee.First) + " " + strconv.Itoa(scrutinee.Second)
	}
	v := convert6(MapTypeValueOfFnFnValueValueFnPairPairPairInt{Type: "second", Value: PairInt{First: 1, Second: 2}, Map: func(function func(any) any) func(*Pair) *Pair {
		return func(value *Pair) *Pair {
			return mapPair(function, value)
		}
	}})
	var a2 shared.MapTypeValue
	if v.Type == "second" {
		scrutinee := convert4(v.Value.(*Pair))
		a2 = shared.MapTypeValue{Type: v.Type, Map: variant.LookupConsCons(v.Type, "first", types.Cons("second", types.SharedListStringNil), mapperBox, &types.List{Cons0: mapperPair, Cons1: types.SharedListNil}), Value: convert5(PairInt{First: scrutinee.Second, Second: scrutinee.First})}
	} else {
		a2 = v
	}
	vValue2 := a2.Map(func(coerced any) any {
		return coerced.(int) * 2
	})(a2.Value)
	var result2 string
	if a2.Type == "first" {
		scrutinee := convert3(vValue2.(*Box))
		result2 = "box " + strconv.Itoa(scrutinee.Box)
	} else {
		scrutinee := convert4(vValue2.(*Pair))
		result2 = "pair " + strconv.Itoa(scrutinee.First) + " " + strconv.Itoa(scrutinee.Second)
	}
	return []string{result, result2}
}

var mapperBox func(func(any) any) func(any) any = func(coerced func(any) any) func(any) any {
	original := func(value *Box) *Box {
		return mapBox(coerced, value)
	}
	return func(coerced2 any) any {
		return original(coerced2.(*Box))
	}
}

var mapperPair func(func(any) any) func(any) any = func(coerced func(any) any) func(any) any {
	original := func(value *Pair) *Pair {
		return mapPair(coerced, value)
	}
	return func(coerced2 any) any {
		return original(coerced2.(*Pair))
	}
}

func mapBox(function func(any) any, value *Box) *Box {
	return &Box{Box: function(value.Box)}
}

func mapPair(function func(any) any, value *Pair) *Pair {
	return &Pair{First: function(value.First), Second: function(value.Second)}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type MapTypeValue struct {
	Map   func(func(any) any) func(any) any
	Type  string
	Value any
}
