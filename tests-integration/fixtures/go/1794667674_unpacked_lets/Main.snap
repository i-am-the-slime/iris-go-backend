// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

type MaybeInt struct {
	Just Int
	Tag  uint8
}

func JustMaybeInt(just Int) MaybeInt {
	return MaybeInt{Tag: TagJust, Just: just}
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	boxWidth := opaque(3)
	point := shared.XY{X: opaque(5), Y: opaque(5)}
	var result shared.XY
	if point.X > 0 {
		result = point
	} else {
		result = shared.XY{X: 0, Y: point.Y}
	}
	found := maybe.JustMaybeInt(maybe.JustInt(opaque(6)))
	var result2 int
	if found.Tag == maybe.TagJust && found.Just.Tag == maybe.TagJust {
		result2 = found.Just.Just
	} else {
		switch found.Tag {
		case maybe.TagJust:
			result2 = 1
		default: // maybe.TagNothing
			result2 = 0
		}
	}
	return []int{boxWidth*opaque(4) + boxWidth, opaque(4) * opaque(6), result.Y, result2}
}

func opaque(x int) int {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type XY struct {
	X int
	Y int
}
