// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

const TagNothing = 0

const TagJust = 1

type MaybeInt struct {
	Just Int
	Tag  uint8
}

func JustMaybeInt(just Int) MaybeInt {
	return MaybeInt{Tag: TagJust, Just: just}
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	boxWidth := opaque(3)
	point := shared.XY{X: opaque(5), Y: opaque(5)}
	var result shared.XY
	if point.X > 0 {
		result = point
	} else {
		result = shared.XY{X: 0, Y: point.Y}
	}
	found := maybe.JustMaybeInt(maybe.Int(opaque(6)))
	var result2 int32
	if found.Tag == maybe.TagJust && found.Just != maybe.NoInt {
		result2 = int32(found.Just)
	} else {
		switch found.Tag {
		case maybe.TagJust:
			result2 = 1
		default: // maybe.TagNothing
			result2 = 0
		}
	}
	return []int32{boxWidth*opaque(4) + boxWidth, opaque(4) * opaque(6), result.Y, result2}
}

func opaque(x int32) int32 {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type XY struct {
	X int32
	Y int32
}
