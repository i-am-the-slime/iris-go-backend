// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  string
	Second int32
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
)

type Tree struct {
	Leaf tuple.Tuple
	Node []Tree
	Tag  uint8
}

const (
	TreeLeaf = iota
	TreeNode
)

func Leaf(leaf tuple.Tuple) Tree {
	return Tree{Tag: TreeLeaf, Leaf: leaf}
}

func Node(node []Tree) Tree {
	return Tree{Tag: TreeNode, Node: node}
}

var main_ = initializeMain_()

func initializeMain_() int {
	return count([]Tree{Leaf(tuple.Tuple{First: "a", Second: 1}), Node([]Tree{Leaf(tuple.Tuple{First: "b", Second: 2})})})
}

func count(trees []Tree) int {
	accumulator := 0
	for _, element := range trees {
		value := size(element)
		accumulator += value
	}
	return accumulator
}

func size(tree Tree) int {
	if tree.Tag == TreeLeaf {
		return int(tree.Leaf.Second)
	}
	return count(tree.Node)
}

func main() {
	console.Print(prim.ShowInt(main_))
}
