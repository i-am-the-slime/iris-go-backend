// Data/Tuple/tuple.go
package tuple

type TupleStringInt struct {
	First  string
	Second int32
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
)

type TreeTupleStringInt struct {
	Leaf tuple.TupleStringInt
	Node []TreeTupleStringInt
	Tag  uint8
}

const (
	TreeTupleStringIntLeaf = iota
	TreeTupleStringIntNode
)

func Leaf(leaf tuple.TupleStringInt) TreeTupleStringInt {
	return TreeTupleStringInt{Tag: TreeTupleStringIntLeaf, Leaf: leaf}
}

func Node(node []TreeTupleStringInt) TreeTupleStringInt {
	return TreeTupleStringInt{Tag: TreeTupleStringIntNode, Node: node}
}

var main_ = initializeMain_()

func initializeMain_() int32 {
	return countString([]TreeTupleStringInt{Leaf(tuple.TupleStringInt{First: "a", Second: 1}), Node([]TreeTupleStringInt{Leaf(tuple.TupleStringInt{First: "b", Second: 2})})})
}

func countString(trees []TreeTupleStringInt) int32 {
	var accumulator int32 = 0
	for _, element := range trees {
		value := sizeString(element)
		accumulator += value
	}
	return accumulator
}

func sizeString(tree TreeTupleStringInt) int32 {
	if tree.Tag == TreeTupleStringIntLeaf {
		return tree.Leaf.Second
	}
	return countString(tree.Node)
}

func main() {
	console.Print(prim.ShowInt(main_))
}
