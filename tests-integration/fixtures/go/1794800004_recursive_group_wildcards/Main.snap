// Data/Semiring/semiring.go
package semiring

func Add(i int32, i2 int32) int32 {
	return i + i2
}

// Data/Tuple/tuple.go
package tuple

type TupleStringInt struct {
	First  string
	Second int32
}

// main.go
package main

import (
	"fixture/Data/Semiring"
	"fixture/Data/Tuple"
	"fmt"
)

type TreeTupleStringInt struct {
	Leaf tuple.TupleStringInt
	Node []TreeTupleStringInt
	Tag  uint8
}

const (
	TreeTupleStringIntLeaf = iota
	TreeTupleStringIntNode
)

var main_ int32 = countString([]TreeTupleStringInt{TreeTupleStringInt{Tag: TreeTupleStringIntLeaf, Leaf: tuple.TupleStringInt{First: "a", Second: 1}}, TreeTupleStringInt{Tag: TreeTupleStringIntNode, Node: []TreeTupleStringInt{TreeTupleStringInt{Tag: TreeTupleStringIntLeaf, Leaf: tuple.TupleStringInt{First: "b", Second: 2}}}}})

func countString(trees []TreeTupleStringInt) int32 {
	var accumulator int32 = 0
	for _, element := range trees {
		accumulated := accumulator
		accumulator = semiring.Add(accumulated, sizeString(element))
	}
	return accumulator
}

func sizeString(tree TreeTupleStringInt) int32 {
	if tree.Tag == TreeTupleStringIntLeaf {
		return tree.Leaf.Second
	}
	return countString(tree.Node)
}

func main() {
	fmt.Println(main_)
}
