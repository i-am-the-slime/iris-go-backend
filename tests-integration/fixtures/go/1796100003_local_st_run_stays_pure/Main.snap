// main.go
package main

import "fixture/shared"

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	accumulator := 0
	for _, element := range numbers {
		value := tripled(element)
		accumulator += value
	}
	found := false
	for _, element := range numbers {
		value := tripled(element)
		if value > 20 {
			found = true
			break
		}
	}
	accumulator2 := 0
	for _, x := range numbers {
		ref := x
		s_ := ref + 1
		ref = s_
		accumulator2 += s_
	}
	return shared.MainResult{Sum: accumulator, Found: found, Counted: accumulator2, Ignored: 0}
}

func tripled(x int) int {
	ref := x
	ref *= 3
	return ref
}

var numbers []int = []int{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Counted int
	Ignored int
	Sum     int
	Found   bool
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}

// note: the entry's value of type { counted, found, ignored, sum } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
