func convert(value ApFnNumberFnIntFnBooleanPerson) *ApFn {
	switch value.Tag {
	case ApFnNumberFnIntFnBooleanPersonDone:
		return &ApFn{Tag: ApFnDone, Done: func(coerced any) any {
			original := value.Done(coerced.(float64))
			return func(coerced2 any) any {
				original2 := original(coerced2.(int))
				return func(coerced3 any) any {
					return shared.Convert(original2(coerced3.(bool)))
				}
			}
		}}
	case ApFnNumberFnIntFnBooleanPersonField:
		return &ApFn{Tag: ApFnField, Field0: value.Field0, Field1: func(coerced any) any {
			original := value.Field1(coerced.(float64))
			return func(coerced2 any) any {
				original2 := original(coerced2.(int))
				return func(coerced3 any) any {
					return shared.Convert(original2(coerced3.(bool)))
				}
			}
		}}
	default: // ApFnNumberFnIntFnBooleanPersonApply
		return &ApFn{Tag: ApFnApply, Apply: value.Apply}
	}
}

