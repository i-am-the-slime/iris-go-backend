type AdminAgeName struct {
	Admin any
	Age   any
	Name  any
}

func convert(value AdminAgeName) Person {
	return Person{Admin: value.Admin.(bool), Age: value.Age.(int32), Name: value.Name.(string)}
}

func convert2(value *ApFn) *ApFnPerson {
	switch value.Tag {
	case ApFnDone:
		return &ApFnPerson{Tag: ApFnPersonDone, Done: func(coerced any) Person {
			return convert(value.Done(coerced).(AdminAgeName))
		}}
	case ApFnField:
		return &ApFnPerson{Tag: ApFnPersonField, Field0: value.Field0, Field1: func(coerced any) Person {
			return convert(value.Field1(coerced).(AdminAgeName))
		}}
	default: // ApFnApply
		return &ApFnPerson{Tag: ApFnPersonApply, Apply: value.Apply}
	}
}

func convert3(value *ApplyE) *ApplyEPerson {
	return &ApplyEPerson{First: convert2(value.First), Second: value.Second}
}

func convert4(value Person) AdminAgeName {
	return AdminAgeName{Admin: value.Admin, Age: value.Age, Name: value.Name}
}

func convert5(value *ApFnPerson) *Ap {
	switch value.Tag {
	case ApFnPersonDone:
		return &Ap{Tag: ApDone, Done0: func(coerced any) any {
			return convert4(value.Done(coerced))
		}}
	case ApFnPersonField:
		return &Ap{Tag: ApField, Field0: value.Field0, Field1: func(coerced any) any {
			return convert4(value.Field1(coerced))
		}}
	default: // ApFnPersonApply
		return &Ap{Tag: ApApply, Apply0: value.Apply}
	}
}

