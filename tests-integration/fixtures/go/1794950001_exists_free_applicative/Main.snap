var main_ = initializeMain_()

func initializeMain_() []string {
	var result []string
	switch person.Tag {
	case ApPersonDone:
		result = []string{}
	case ApPersonField:
		result = []string{person.Field0}
	default: // ApPersonApply
		var result2 []string
		switch person.Apply.Boolean.Second.Tag {
		case ApBooleanDone:
			result2 = []string{}
		default: // ApBooleanField
			result2 = []string{person.Apply.Boolean.Second.Field0}
		}
		result = array.Append(names(convert9(person.Apply.Boolean.First)), result2)
	}
	var record shared.Person
	switch person.Tag {
	case ApPersonDone:
		record = person.Done
	case ApPersonField:
		record = person.Field1
	default: // ApPersonApply
		var result2 bool
		switch person.Apply.Boolean.Second.Tag {
		case ApBooleanDone:
			result2 = person.Apply.Boolean.Second.Done
		default: // ApBooleanField
			result2 = person.Apply.Boolean.Second.Field1
		}
		record = func(coerced ApFnBooleanPerson) func(bool) shared.Person {
			original := run(convert9(coerced)).(func(any) any)
			return func(coerced2 bool) shared.Person {
				return shared.Convert2(original(coerced2).(shared.AdminAgeName))
			}
		}(person.Apply.Boolean.First)(result2)
	}
	var result3 string
	switch greeting.Tag {
	case ApStringDone:
		result3 = prim.StringToUpper(greeting.Field0)
	case ApStringField:
		result3 = prim.StringToUpper(greeting.Field1)
	default: // ApStringApply
		original := func(f func(any) any) func(*Ap) *Ap {
			return func(value *Ap) *Ap {
				return map_(f, value)
			}
		}
		original2 := func(value func(float64) string) func(float64) string {
			return func(x float64) string {
				return prim.StringToUpper(value(x))
			}
		}
		var result2 float64
		switch greeting.Apply.Number.Second.Tag {
		case ApNumberDone:
			result2 = greeting.Apply.Number.Second.Done
		default: // ApNumberField
			result2 = greeting.Apply.Number.Second.Field1
		}
		result3 = func(coerced ApFnNumberString) func(float64) string {
			original3 := run(convert10(coerced)).(func(any) any)
			return func(coerced2 float64) string {
				return original3(coerced2).(string)
			}
		}(convert11(original(func(coerced any) any {
			original3 := coerced.(func(any) any)
			original4 := original2(func(coerced2 float64) string {
				return original3(coerced2).(string)
			})
			return func(coerced2 any) any {
				return original4(coerced2.(float64))
			}
		})(convert10(greeting.Apply.Number.First))))(result2)
	}
	var result4 string
	switch greeting.Tag {
	case ApStringDone:
		result4 = greeting.Field0
	case ApStringField:
		result4 = greeting.Field1
	default: // ApStringApply
		var result2 float64
		switch greeting.Apply.Number.Second.Tag {
		case ApNumberDone:
			result2 = greeting.Apply.Number.Second.Done
		default: // ApNumberField
			result2 = greeting.Apply.Number.Second.Field1
		}
		result4 = func(coerced ApFnNumberString) func(float64) string {
			original := run(convert10(coerced)).(func(any) any)
			return func(coerced2 float64) string {
				return original(coerced2).(string)
			}
		}(greeting.Apply.Number.First)(result2)
	}
	return []string{prim.StringJoinWith(",", result), "{ admin: " + strconv.FormatBool(record.Admin) + ", age: " + strconv.Itoa(record.Age) + ", name: " + prim.ShowString(record.Name) + " }", result3, strconv.Itoa(direct.CodePointLength(result4))}
}

var person *ApPerson = ApplyApPerson(ExistsApplyEPerson{Boolean: ApplyEPerson{First: ApplyApFnBooleanPerson(ExistsApplyEFnBooleanPerson{Int: ApplyEFnBooleanPerson{First: FieldApFnIntFnBooleanPerson("name", func(value int) func(bool) shared.Person {
	return func(value2 bool) shared.Person {
		return shared.Person{Name: "ada", Age: value, Admin: value2}
	}
}), Second: FieldApInt("age", 36)}}), Second: FieldApBoolean("admin", true)}})

var greeting = initializeGreeting()

func initializeGreeting() ApString {
	var function ApFnNumberString
	switch person.Tag {
	case ApPersonDone:
		function = Done(func(n float64) string {
			return greetingF(person.Done, n)
		})
	case ApPersonField:
		function = FieldApFnNumberString(person.Field0, func(n float64) string {
			return greetingF(person.Field1, n)
		})
	default: // ApPersonApply
		original := func(f func(any) any) func(*Ap) *Ap {
			return func(value *Ap) *Ap {
				return map_(f, value)
			}
		}
		original2 := func(value func(bool) shared.Person) func(bool) func(float64) string {
			return func(x bool) func(float64) string {
				p := value(x)
				return func(n float64) string {
					return greetingF(p, n)
				}
			}
		}
		function = ApFnNumberString{Tag: ApFnNumberStringApply, Apply: convert15(ApplyEFnNumberString{First: convert12(original(func(coerced any) any {
			original3 := coerced.(func(any) any)
			original4 := original2(func(coerced2 bool) shared.Person {
				return shared.Convert2(original3(coerced2).(shared.AdminAgeName))
			})
			return func(coerced2 any) any {
				original5 := original4(coerced2.(bool))
				return func(coerced3 any) any {
					return original5(coerced3.(float64))
				}
			}
		})(convert9(person.Apply.Boolean.First))), Second: person.Apply.Boolean.Second})}
	}
	return ApplyApString(ExistsApplyEString{Number: ApplyEString{First: function, Second: FieldApNumber("count", 3.5)}})
}

func map_(f func(any) any, value *Ap) *Ap {
	switch value.Tag {
	case ApDone:
		return &Ap{Tag: ApDone, Done0: f(value.Done0)}
	case ApField:
		return &Ap{Tag: ApField, Field0: value.Field0, Field1: f(value.Field1)}
	default: // ApApply
		scrutinee := value.Apply0.(*ApplyE)
		original := func(f2 func(any) any) func(*Ap) *Ap {
			return func(value2 *Ap) *Ap {
				return map_(f2, value2)
			}
		}
		original2 := func(value2 func(any) any) func(any) any {
			return func(x any) any {
				return f(value2(x))
			}
		}
		return &Ap{Tag: ApApply, Apply0: &ApplyE{First: convert17(original(func(coerced any) any {
			return original2(coerced.(func(any) any))
		})(convert16(scrutinee.First))), Second: scrutinee.Second}}
	}
}

func names(value *Ap) []string {
	switch value.Tag {
	case ApDone:
		return []string{}
	case ApField:
		return []string{value.Field0}
	default: // ApApply
		scrutinee := value.Apply0.(*ApplyE)
		return array.Append(names(convert16(scrutinee.First)), names(scrutinee.Second))
	}
}

func run(value *Ap) any {
	switch value.Tag {
	case ApDone:
		return value.Done0
	case ApField:
		return value.Field1
	default: // ApApply
		scrutinee := value.Apply0.(*ApplyE)
		return run(convert16(scrutinee.First)).(func(any) any)(run(scrutinee.Second))
	}
}

func greetingF(p shared.Person, n float64) string {
	return p.Name + " is " + strconv.Itoa(p.Age) + " " + prim.ShowNumber(n)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Person struct {
	Name  string
	Age   int
	Admin bool
}

type AdminAgeName struct {
	Admin any
	Age   any
	Name  any
}

func Convert(value Person) AdminAgeName {
	return AdminAgeName{Admin: value.Admin, Age: value.Age, Name: value.Name}
}

func Convert2(value AdminAgeName) Person {
	return Person{Admin: value.Admin.(bool), Age: value.Age.(int), Name: value.Name.(string)}
}
