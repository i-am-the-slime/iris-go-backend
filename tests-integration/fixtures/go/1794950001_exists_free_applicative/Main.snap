var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	var result []string
	switch person.Tag {
	case ApPersonDone:
		result = []string{}
	case ApPersonField:
		result = []string{person.Field0}
	default: // ApPersonApply
		scrutinee := convert3(person.Apply.(*ApplyE))
		result = array.Append(func(coerced *ApFnPerson) []string {
			return namesFnPerson(convert5(coerced))
		}(scrutinee.First), namesFnPerson(scrutinee.Second))
	}
	var record Person
	switch person.Tag {
	case ApPersonDone:
		record = person.Done
	case ApPersonField:
		record = person.Field1
	default: // ApPersonApply
		scrutinee := convert3(person.Apply.(*ApplyE))
		record = func(coerced *ApFnPerson) func(any) Person {
			original := runFnPerson(convert5(coerced)).(func(any) any)
			return func(coerced2 any) Person {
				return convert(original(coerced2).(AdminAgeName))
			}
		}(scrutinee.First)(runFnPerson(scrutinee.Second))
	}
	var result2 string
	if record.Admin {
		result2 = "true"
	} else {
		result2 = "false"
	}
	var result3 string
	switch greeting.Tag {
	case ApStringDone:
		result3 = prim.StringToUpper(greeting.Done)
	case ApStringField:
		result3 = prim.StringToUpper(greeting.Field1)
	default: // ApStringApply
		scrutinee := convert7(greeting.Apply.(*ApplyE))
		original := func(f func(any) any) func(*Ap) *Ap {
			return func(value *Ap) *Ap {
				return map_(f, value)
			}
		}
		result3 = func(coerced *ApFnString) func(any) string {
			original2 := runFnPerson(convert8(coerced)).(func(any) any)
			return func(coerced2 any) string {
				return original2(coerced2).(string)
			}
		}(func(coerced func(func(any) string) func(any) string) func(*ApFnString) *ApFnString {
			original4 := original(func(coerced2 any) any {
				original2 := coerced2.(func(any) any)
				original3 := coerced(func(coerced3 any) string {
					return original2(coerced3).(string)
				})
				return func(coerced3 any) any {
					return original3(coerced3)
				}
			})
			return func(coerced2 *ApFnString) *ApFnString {
				return convert9(original4(convert8(coerced2)))
			}
		}(func(value func(any) string) func(any) string {
			return func(x any) string {
				return prim.StringToUpper(value(x))
			}
		})(scrutinee.First))(runFnPerson(scrutinee.Second))
	}
	var result4 string
	switch greeting.Tag {
	case ApStringDone:
		result4 = greeting.Done
	case ApStringField:
		result4 = greeting.Field1
	default: // ApStringApply
		scrutinee := convert7(greeting.Apply.(*ApplyE))
		result4 = func(coerced *ApFnString) func(any) string {
			original := runFnPerson(convert8(coerced)).(func(any) any)
			return func(coerced2 any) string {
				return original(coerced2).(string)
			}
		}(scrutinee.First)(runFnPerson(scrutinee.Second))
	}
	return []string{prim.StringJoinWith(",", result), "{ admin: " + result2 + ", age: " + prim.ShowInt(record.Age) + ", name: " + prim.ShowString(record.Name) + " }", result3, prim.ShowInt(direct.CodePointLength(result4))}
}

var person = initializePerson()

func initializePerson() ApPerson {
	defer exception.ReportUncaught()
	return ApPerson{Tag: ApPersonApply, Apply: convert15(ApplyEPersonBoolean{First: ApFnBooleanPerson{Tag: ApFnBooleanPersonApply, Apply: convert12(ApplyEFnBooleanPersonInt{First: ApFnIntFnBooleanPerson{Tag: ApFnIntFnBooleanPersonField, Field0: "name", Field1: func(value int32) func(bool) Person {
		return func(value2 bool) Person {
			return Person{Name: "ada", Age: value, Admin: value2}
		}
	}}, Second: ApInt{Tag: ApIntField, Field0: "age", Field1: 36}})}, Second: ApBoolean{Tag: ApBooleanField, Field0: "admin", Field1: true}})}
}

var greeting = initializeGreeting()

func initializeGreeting() ApString {
	defer exception.ReportUncaught()
	var result ApFnNumberString
	switch person.Tag {
	case ApPersonDone:
		result = ApFnNumberString{Tag: ApFnNumberStringDone, Done: func(n float64) string {
			return greetingF(person.Done, n)
		}}
	case ApPersonField:
		result = ApFnNumberString{Tag: ApFnNumberStringField, Field0: person.Field0, Field1: func(n float64) string {
			return greetingF(person.Field1, n)
		}}
	default: // ApPersonApply
		scrutinee := convert3(person.Apply.(*ApplyE))
		original := func(f func(any) any) func(*Ap) *Ap {
			return func(value *Ap) *Ap {
				return map_(f, value)
			}
		}
		result = ApFnNumberString{Tag: ApFnNumberStringApply, Apply: convert18(&ApplyEFnNumberString{First: func(coerced func(func(any) Person) func(any) func(float64) string) func(*ApFnPerson) *ApFnFnNumberString {
			original5 := original(func(coerced2 any) any {
				original2 := coerced2.(func(any) any)
				original3 := coerced(func(coerced3 any) Person {
					return convert(original2(coerced3).(AdminAgeName))
				})
				return func(coerced3 any) any {
					original4 := original3(coerced3)
					return func(coerced4 any) any {
						return original4(coerced4.(float64))
					}
				}
			})
			return func(coerced2 *ApFnPerson) *ApFnFnNumberString {
				return convert16(original5(convert5(coerced2)))
			}
		}(func(value func(any) Person) func(any) func(float64) string {
			return func(x any) func(float64) string {
				p := value(x)
				return func(n float64) string {
					return greetingF(p, n)
				}
			}
		})(scrutinee.First), Second: scrutinee.Second})}
	}
	return ApString{Tag: ApStringApply, Apply: convert21(ApplyEStringNumber{First: result, Second: ApNumber{Tag: ApNumberField, Field0: "count", Field1: 3.5}})}
}

func namesFnPerson(value *Ap) []string {
	switch value.Tag {
	case ApDone:
		return []string{}
	case ApField:
		return []string{value.Field0}
	default: // ApApply
		scrutinee := value.Apply0.(*ApplyE)
		return array.Append(func(coerced *ApFn) []string {
			return namesFnPerson(convert22(coerced))
		}(scrutinee.First), namesFnPerson(scrutinee.Second))
	}
}

func runFnPerson(value *Ap) any {
	switch value.Tag {
	case ApDone:
		return value.Done0
	case ApField:
		return value.Field1
	default: // ApApply
		scrutinee := value.Apply0.(*ApplyE)
		return func(coerced *ApFn) func(any) any {
			return runFnPerson(convert22(coerced)).(func(any) any)
		}(scrutinee.First)(runFnPerson(scrutinee.Second))
	}
}

func map_(f func(any) any, value *Ap) *Ap {
	switch value.Tag {
	case ApDone:
		return &Ap{Tag: ApDone, Done0: f(value.Done0)}
	case ApField:
		return &Ap{Tag: ApField, Field0: value.Field0, Field1: f(value.Field1)}
	default: // ApApply
		scrutinee := value.Apply0.(*ApplyE)
		original := func(f2 func(any) any) func(*Ap) *Ap {
			return func(value2 *Ap) *Ap {
				return map_(f2, value2)
			}
		}
		return &Ap{Tag: ApApply, Apply0: &ApplyE{First: func(coerced func(func(any) any) func(any) any) func(*ApFn) *ApFn {
			original2 := original(func(coerced2 any) any {
				return coerced(coerced2.(func(any) any))
			})
			return func(coerced2 *ApFn) *ApFn {
				return convert23(original2(convert22(coerced2)))
			}
		}(func(value2 func(any) any) func(any) any {
			return func(x any) any {
				return f(value2(x))
			}
		})(scrutinee.First), Second: scrutinee.Second}}
	}
}

func greetingF(p Person, n float64) string {
	return p.Name + " is " + prim.ShowInt(p.Age) + " " + prim.ShowNumber(n)
}

func main() {
	fmt.Println(main_)
}
