		return original
	}
	switch value.Tag {
	case ApFnStringDone:
		return &Ap{Tag: ApDone, Done0: func(coerced any) any {
			return value.Done(coerced)
		}, Origin: value}
	case ApFnStringField:
		return &Ap{Tag: ApField, Field0: value.Field0, Field1: func(coerced any) any {
			return value.Field1(coerced)
		}, Origin: value}
	default: // ApFnStringApply
