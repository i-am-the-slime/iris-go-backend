// Data/Show/show.go
package show

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayTally(buffer []byte, array []shared.Tally) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowRecordCountLabelSeenTotalConsIntConsStringConsBooleanConsIntNil(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowRecordCountLabelSeenTotalConsIntConsStringConsBooleanConsIntNil(buffer []byte, record shared.Tally) []byte {
	buffer = append(buffer, "{ count: "...)
	buffer = strconv.AppendInt(buffer, int64(record.Count), 10)
	buffer = append(buffer, ", label: "...)
	buffer = prim.AppendShowString(buffer, record.Label)
	buffer = append(buffer, ", seen: "...)
	buffer = strconv.AppendBool(buffer, record.Seen)
	buffer = append(buffer, ", total: "...)
	buffer = strconv.AppendInt(buffer, int64(record.Total), 10)
	buffer = append(buffer, " }"...)
	return buffer
}

func AppendShowArrayBody(buffer []byte, array []shared.Body) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowRecordMassVxVyXYConsNumberConsNumberConsNumberConsNumberConsNumberNil(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowRecordMassVxVyXYConsNumberConsNumberConsNumberConsNumberConsNumberNil(buffer []byte, record shared.Body) []byte {
	buffer = append(buffer, "{ mass: "...)
	buffer = prim.AppendShowNumber(buffer, record.Mass)
	buffer = append(buffer, ", vx: "...)
	buffer = prim.AppendShowNumber(buffer, record.Vx)
	buffer = append(buffer, ", vy: "...)
	buffer = prim.AppendShowNumber(buffer, record.Vy)
	buffer = append(buffer, ", x: "...)
	buffer = prim.AppendShowNumber(buffer, record.X)
	buffer = append(buffer, ", y: "...)
	buffer = prim.AppendShowNumber(buffer, record.Y)
	buffer = append(buffer, " }"...)
	return buffer
}

func ArrayTally(array []shared.Tally) string {
	return string(AppendShowArrayTally(nil, array))
}

func ArrayBody(array []shared.Body) string {
	return string(AppendShowArrayBody(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []shared.Body{{X: 0.0, Y: 0.0, Vx: 0.0, Vy: 0.0, Mass: 1.0}, {X: 1.0, Y: 2.0, Vx: 0.5, Vy: 0.0, Mass: 0.5}, {X: -1.0, Y: 0.5, Vx: 0.0, Vy: 0.25, Mass: 2.0}}
	mapped := make([]shared.Body, len(array))
	for index, body := range array {
		var accMass float64
		var accVx float64
		var accVy float64
		var accX float64
		var accY float64
		if index == 0 {
			accMass, accVx, accVy, accX, accY = body.Mass, body.Vx, body.Vy, body.X, body.Y
		} else {
			updatedMass := body.Mass
			updatedX := body.X
			updatedY := body.Y
			updatedVx := body.Vx + (0.0-body.X)*1.0
			updatedVy := body.Vy + (0.0-body.Y)*1.0
			accMass, accVx, accVy, accX, accY = updatedMass, updatedVx, updatedVy, updatedX, updatedY
		}
		var accMass2 float64
		var accVx2 float64
		var accVy2 float64
		var accX2 float64
		var accY2 float64
		if index == 1 {
			accVx2, accVy2, accX2, accY2 = accVx, accVy, accX, accY
		} else {
			updatedVx := accVx + (1.0-accX)*0.5
			updatedVy := accVy + (2.0-accY)*0.5
			accVx2, accVy2, accX2, accY2 = updatedVx, updatedVy, accX, accY
		}
		accMass2 = accMass
		var bodyMass float64
		var bodyVx float64
		var bodyVy float64
		var bodyX float64
		var bodyY float64
		if index == 2 {
			bodyVx, bodyVy, bodyX, bodyY = accVx2, accVy2, accX2, accY2
		} else {
			updatedVx := accVx2 + (-1.0-accX2)*2.0
			updatedVy := accVy2 + (0.5-accY2)*2.0
			bodyVx, bodyVy, bodyX, bodyY = updatedVx, updatedVy, accX2, accY2
		}
		bodyMass = accMass2
		bodyX += bodyVx
		bodyY += bodyVy
		mapped[index].Mass = bodyMass
		mapped[index].Vx = bodyVx
		mapped[index].Vy = bodyVy
		mapped[index].X = bodyX
		mapped[index].Y = bodyY
	}
	record := tally([]int{1, 2, 3, 4})
	accumulatorCells := 0
	for value := 1; value < 3; value++ {
		accumulatorCells += 1
	}
	accumulatorCells2 := accumulatorCells
	for value := 1; value < 4; value++ {
		accumulatorCells2 += 1
	}
	accumulatorCells3 := accumulatorCells2
	for value := 1; value < 5; value++ {
		accumulatorCells3 += 1
	}
	accumulator := shared.Pair{Left: 1, Right: 2}
	for i := 1; i < 6; i++ {
		updated := accumulator
		updated.Left = accumulator.Right + i
		updated.Right = accumulator.Left
		accumulator = updated
	}
	return []string{show.ArrayBody(mapped), "{ count: " + strconv.Itoa(record.Count) + ", label: " + prim.ShowString(record.Label) + ", seen: " + strconv.FormatBool(record.Seen) + ", total: " + strconv.Itoa(record.Total) + " }", show.ArrayTally([]shared.Tally{tally([]int{1, 2, 3}), tally([]int{5})}), "{ cells: " + strconv.Itoa(accumulatorCells3) + ", rows: 3 }", "{ left: " + strconv.Itoa(accumulator.Left) + ", right: " + strconv.Itoa(accumulator.Right) + " }"}
}

func tally(array []int) shared.Tally {
	accumulatorLabel := ""
	accumulatorCount := 0
	accumulatorTotal := 0
	accumulatorSeen := false
	for _, n := range array {
		accumulatorCount += 1
		accumulatorTotal += n
		accumulatorLabel += strconv.Itoa(n)
		accumulatorSeen = accumulatorSeen || n > 2
	}
	return shared.Tally{Label: accumulatorLabel, Count: accumulatorCount, Total: accumulatorTotal, Seen: accumulatorSeen}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Body struct {
	Mass float64
	Vx   float64
	Vy   float64
	X    float64
	Y    float64
}

type Tally struct {
	Label string
	Count int
	Total int
	Seen  bool
}

type Cells struct {
	Cells int
	Rows  int
}

type Pair struct {
	Left  int
	Right int
}
