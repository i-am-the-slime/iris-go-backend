// Data/Show/show.go
package show

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowTally(record shared.Tally) string {
	return string(AppendShowTally(nil, record))
}

func ShowBody(record shared.Body) string {
	return string(AppendShowBody(nil, record))
}

func AppendShowArrayTally(buffer []byte, array []shared.Tally) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowTally(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowTally(buffer []byte, record shared.Tally) []byte {
	buffer = append(buffer, "{ count: "...)
	buffer = strconv.AppendInt(buffer, int64(record.Count), 10)
	buffer = append(buffer, ", label: "...)
	buffer = prim.AppendShowString(buffer, record.Label)
	buffer = append(buffer, ", seen: "...)
	buffer = strconv.AppendBool(buffer, record.Seen)
	buffer = append(buffer, ", total: "...)
	buffer = strconv.AppendInt(buffer, int64(record.Total), 10)
	buffer = append(buffer, " }"...)
	return buffer
}

func AppendShowArrayBody(buffer []byte, array []shared.Body) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowBody(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowBody(buffer []byte, record shared.Body) []byte {
	buffer = append(buffer, "{ mass: "...)
	buffer = prim.AppendShowNumber(buffer, record.Mass)
	buffer = append(buffer, ", vx: "...)
	buffer = prim.AppendShowNumber(buffer, record.Vx)
	buffer = append(buffer, ", vy: "...)
	buffer = prim.AppendShowNumber(buffer, record.Vy)
	buffer = append(buffer, ", x: "...)
	buffer = prim.AppendShowNumber(buffer, record.X)
	buffer = append(buffer, ", y: "...)
	buffer = prim.AppendShowNumber(buffer, record.Y)
	buffer = append(buffer, " }"...)
	return buffer
}

func ArrayTally(array []shared.Tally) string {
	return string(AppendShowArrayTally(nil, array))
}

func ArrayBody(array []shared.Body) string {
	return string(AppendShowArrayBody(nil, array))
}

// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type Tuple struct {
	Second shared.Body
	First  int32
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	bodies := []shared.Body{{X: 0.0, Y: 0.0, Vx: 0.0, Vy: 0.0, Mass: 1.0}, {X: 1.0, Y: 2.0, Vx: 0.5, Vy: 0.0, Mass: 0.5}, {X: -1.0, Y: 0.5, Vx: 0.0, Vy: 0.25, Mass: 2.0}}
	mapped := make([]shared.Body, len(bodies))
	for index, body := range bodies {
		accumulatorMass := body.Mass
		accumulatorVx := body.Vx
		accumulatorVy := body.Vy
		accumulatorX := body.X
		accumulatorY := body.Y
		for index2, body2 := range bodies {
			if index != index2 {
				accumulatorVx += (body2.X - accumulatorX) * body2.Mass
				accumulatorVy += (body2.Y - accumulatorY) * body2.Mass
			}
		}
		accumulatorX += accumulatorVx
		accumulatorY += accumulatorVy
		mapped[index].Mass = accumulatorMass
		mapped[index].Vx = accumulatorVx
		mapped[index].Vy = accumulatorVy
		mapped[index].X = accumulatorX
		mapped[index].Y = accumulatorY
	}
	record := tally([]int{1, 2, 3, 4})
	array := []int{2, 3, 4}
	accumulator := shared.Cells{Rows: 0, Cells: 0}
	for _, width := range array {
		updated := accumulator
		updated.Rows = accumulator.Rows + 1
		_, count := arraypkg.RangeSteps(1, width)
		accumulatorCells := accumulator.Cells
		for range count {
			accumulatorCells += 1
		}
		updated.Cells = accumulatorCells
		accumulator = updated
	}
	accumulator2 := shared.Pair{Left: 1, Right: 2}
	for i := 1; i < 6; i++ {
		updated := accumulator2
		updated.Left = accumulator2.Right + i
		updated.Right = accumulator2.Left
		accumulator2 = updated
	}
	return []string{show.ArrayBody(mapped), "{ count: " + strconv.Itoa(record.Count) + ", label: " + prim.ShowString(record.Label) + ", seen: " + strconv.FormatBool(record.Seen) + ", total: " + strconv.Itoa(record.Total) + " }", show.ArrayTally(arraypkg.Reverse([]shared.Tally{tally([]int{5}), tally([]int{1, 2, 3})})), "{ cells: " + strconv.Itoa(accumulator.Cells) + ", rows: " + strconv.Itoa(accumulator.Rows) + " }", "{ left: " + strconv.Itoa(accumulator2.Left) + ", right: " + strconv.Itoa(accumulator2.Right) + " }"}
}

func tally(array []int) shared.Tally {
	accumulatorLabel := ""
	accumulatorCount := 0
	accumulatorTotal := 0
	accumulatorSeen := false
	for _, n := range array {
		accumulatorCount += 1
		accumulatorTotal += n
		accumulatorLabel += strconv.Itoa(n)
		accumulatorSeen = accumulatorSeen || n > 2
	}
	return shared.Tally{Label: accumulatorLabel, Count: accumulatorCount, Total: accumulatorTotal, Seen: accumulatorSeen}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Body struct {
	Mass float64
	Vx   float64
	Vy   float64
	X    float64
	Y    float64
}

type Tally struct {
	Label string
	Count int
	Total int
	Seen  bool
}

type Cells struct {
	Cells int
	Rows  int
}

type Pair struct {
	Left  int
	Right int
}
