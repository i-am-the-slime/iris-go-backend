// Data/Show/show.go
package show

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowTallyConsIntConsStringConsBooleanConsIntNil(record shared.Tally) string {
	return string(AppendShowTallyConsIntConsStringConsBooleanConsIntNil(nil, record))
}

func ShowBodyConsNumberConsNumberConsNumberConsNumberConsNumberNil(record shared.Body) string {
	return string(AppendShowBodyConsNumberConsNumberConsNumberConsNumberConsNumberNil(nil, record))
}

func AppendShowArrayTally(buffer []byte, array []shared.Tally) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowTallyConsIntConsStringConsBooleanConsIntNil(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowTallyConsIntConsStringConsBooleanConsIntNil(buffer []byte, record shared.Tally) []byte {
	buffer = append(buffer, "{ count: "...)
	buffer = strconv.AppendInt(buffer, int64(record.Count), 10)
	buffer = append(buffer, ", label: "...)
	buffer = prim.AppendShowString(buffer, record.Label)
	buffer = append(buffer, ", seen: "...)
	buffer = strconv.AppendBool(buffer, record.Seen)
	buffer = append(buffer, ", total: "...)
	buffer = strconv.AppendInt(buffer, int64(record.Total), 10)
	buffer = append(buffer, " }"...)
	return buffer
}

func AppendShowArrayBody(buffer []byte, array []shared.Body) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowBodyConsNumberConsNumberConsNumberConsNumberConsNumberNil(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowBodyConsNumberConsNumberConsNumberConsNumberConsNumberNil(buffer []byte, record shared.Body) []byte {
	buffer = append(buffer, "{ mass: "...)
	buffer = prim.AppendShowNumber(buffer, record.Mass)
	buffer = append(buffer, ", vx: "...)
	buffer = prim.AppendShowNumber(buffer, record.Vx)
	buffer = append(buffer, ", vy: "...)
	buffer = prim.AppendShowNumber(buffer, record.Vy)
	buffer = append(buffer, ", x: "...)
	buffer = prim.AppendShowNumber(buffer, record.X)
	buffer = append(buffer, ", y: "...)
	buffer = prim.AppendShowNumber(buffer, record.Y)
	buffer = append(buffer, " }"...)
	return buffer
}

func ArrayTally(array []shared.Tally) string {
	return string(AppendShowArrayTally(nil, array))
}

func ArrayBody(array []shared.Body) string {
	return string(AppendShowArrayBody(nil, array))
}

// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type TupleIntBody struct {
	Second shared.Body
	First  int32
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	bodies := []shared.Body{{X: 0.0, Y: 0.0, Vx: 0.0, Vy: 0.0, Mass: 1.0}, {X: 1.0, Y: 2.0, Vx: 0.5, Vy: 0.0, Mass: 0.5}, {X: -1.0, Y: 0.5, Vx: 0.0, Vy: 0.25, Mass: 2.0}}
	mapped := make([]shared.Body, len(bodies))
	for index := range bodies {
		i := int32(index)
		accumulatorMass := bodies[index].Mass
		accumulatorVx := bodies[index].Vx
		accumulatorVy := bodies[index].Vy
		accumulatorX := bodies[index].X
		accumulatorY := bodies[index].Y
		for index2 := range bodies {
			i2 := int32(index2)
			if i != i2 {
				accumulatorVx += (bodies[index2].X - accumulatorX) * bodies[index2].Mass
				accumulatorVy += (bodies[index2].Y - accumulatorY) * bodies[index2].Mass
			}
		}
		accumulatorX += accumulatorVx
		accumulatorY += accumulatorVy
		mapped[index].Mass = accumulatorMass
		mapped[index].Vx = accumulatorVx
		mapped[index].Vy = accumulatorVy
		mapped[index].X = accumulatorX
		mapped[index].Y = accumulatorY
	}
	array := []int32{1, 2, 3, 4}
	accumulatorLabel := ""
	var accumulatorCount int32 = 0
	var accumulatorTotal int32 = 0
	accumulatorSeen := false
	for _, n := range array {
		accumulatorCount += 1
		accumulatorTotal += n
		accumulatorLabel += strconv.Itoa(int(n))
		accumulatorSeen = accumulatorSeen || n > 2
	}
	array2 := []int32{5}
	accumulatorLabel2 := ""
	var accumulatorCount2 int32 = 0
	var accumulatorTotal2 int32 = 0
	accumulatorSeen2 := false
	for _, n := range array2 {
		accumulatorCount2 += 1
		accumulatorTotal2 += n
		accumulatorLabel2 += strconv.Itoa(int(n))
		accumulatorSeen2 = accumulatorSeen2 || n > 2
	}
	array3 := []int32{1, 2, 3}
	accumulatorLabel3 := ""
	var accumulatorCount3 int32 = 0
	var accumulatorTotal3 int32 = 0
	accumulatorSeen3 := false
	for _, n := range array3 {
		accumulatorCount3 += 1
		accumulatorTotal3 += n
		accumulatorLabel3 += strconv.Itoa(int(n))
		accumulatorSeen3 = accumulatorSeen3 || n > 2
	}
	array4 := []int32{2, 3, 4}
	accumulator := shared.Cells{Rows: 0, Cells: 0}
	for _, width := range array4 {
		updated := accumulator
		updated.Rows = accumulator.Rows + 1
		_, count := arraypkg.RangeSteps(1, width)
		accumulatorCells := accumulator.Cells
		for range count {
			accumulatorCells += 1
		}
		updated.Cells = accumulatorCells
		accumulator = updated
	}
	accumulator2 := shared.Pair{Left: 1, Right: 2}
	for i := int32(1); i < 6; i++ {
		updated := accumulator2
		updated.Left = accumulator2.Right + i
		updated.Right = accumulator2.Left
		accumulator2 = updated
	}
	return []string{show.ArrayBody(mapped), "{ count: " + strconv.Itoa(int(accumulatorCount)) + ", label: " + prim.ShowString(accumulatorLabel) + ", seen: " + strconv.FormatBool(accumulatorSeen) + ", total: " + strconv.Itoa(int(accumulatorTotal)) + " }", show.ArrayTally(arraypkg.Reverse([]shared.Tally{{Label: accumulatorLabel2, Count: accumulatorCount2, Total: accumulatorTotal2, Seen: accumulatorSeen2}, {Label: accumulatorLabel3, Count: accumulatorCount3, Total: accumulatorTotal3, Seen: accumulatorSeen3}})), "{ cells: " + strconv.Itoa(int(accumulator.Cells)) + ", rows: " + strconv.Itoa(int(accumulator.Rows)) + " }", "{ left: " + strconv.Itoa(int(accumulator2.Left)) + ", right: " + strconv.Itoa(int(accumulator2.Right)) + " }"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Body struct {
	Mass float64
	Vx   float64
	Vy   float64
	X    float64
	Y    float64
}

type Tally struct {
	Label string
	Count int32
	Total int32
	Seen  bool
}

type Cells struct {
	Cells int32
	Rows  int32
}

type Pair struct {
	Left  int32
	Right int32
}
