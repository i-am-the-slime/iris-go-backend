// Data/Show/show.go
package show

import "strconv"

func Show(i int) string {
	return strconv.Itoa(i)
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
)

var main_ = initializeMain_()

func initializeMain_() string {
	text := []byte("Box Box ")
	text = show.AppendShowArrayInt(text, []int{1, 2})
	return string(text)
}

func main() {
	console.Print(main_)
}
