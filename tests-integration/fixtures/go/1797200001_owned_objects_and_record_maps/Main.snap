// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/object"
)

func main() {
	words := []string{"a", "b", "a"}
	numbers := []int{3, 1, 3, 2}
	accumulator := shared.Window{Start: 0, Seen: make(map[int]int)}
	for _, x := range numbers {
		window := accumulator
		value, found := window.Seen[x]
		var entry maybe.Int
		if found {
			entry = maybe.JustInt(value)
		} else {
			entry = maybe.NoInt
		}
		var start int
		switch entry.Tag {
		case maybe.TagJust:
			at := entry.Just
			x2 := window.Start
			if x2 < at {
				start = at
			} else {
				start = x2
			}
		default: // maybe.TagNothing
			start = window.Start
		}
		window.Seen[x] = start + 1
		accumulator = shared.Window{Start: start, Seen: window.Seen}
	}
	accumulator2 := object.Empty[int]()
	accumulator2 = object.Lend(accumulator2)
	for _, word := range words {
		value, found := object.Lookup(word, accumulator2)
		var result int
		if found {
			result = value + 1
		} else {
			result = 1
		}
		accumulator2 = object.InsertOwned(word, result, accumulator2)
	}
	output := &shared.Ref[int]{Value: object.Size(accumulator2) + accumulator.Start + len(accumulator.Seen)}
	output.Value = 0
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type Window struct {
	Seen  map[int]int
	Start int
}
