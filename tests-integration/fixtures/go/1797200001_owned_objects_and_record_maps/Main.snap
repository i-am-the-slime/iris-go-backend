// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

// main.go
package main

import "fixture/shared"

func main() {
	words := []string{"a", "b", "a"}
	numbers := []int{3, 1, 3, 2}
	accumulator := shared.Window{Start: 0, Seen: make(map[int]int)}
	for _, x := range numbers {
		window := accumulator
		at, found := window.Seen[x]
		var start int
		if found {
			x2 := window.Start
			if x2 < at {
				start = at
			} else {
				start = x2
			}
		} else {
			start = window.Start
		}
		window.Seen[x] = start + 1
		accumulator = shared.Window{Start: start, Seen: window.Seen}
	}
	accumulator2 := make(map[string]int)
	for _, word := range words {
		counts := accumulator2
		value, found := counts[word]
		var result int
		if found {
			result = value + 1
		} else {
			result = 1
		}
		counts[word] = result
		accumulator2 = counts
	}
	output := &shared.Ref[int]{Value: len(accumulator2) + accumulator.Start + len(accumulator.Seen)}
	output.Value = 0
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type Window struct {
	Seen  map[int]int
	Start int
}
