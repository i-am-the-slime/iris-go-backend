// Data/Map/Internal/internal.go
package internal

type Map struct {
	Node4 *Map
	Node5 *Map
	Node0 int32
	Node1 int32
	Node2 int32
	Node3 int32
}

var SharedMapLeaf = &Map{}

type Window struct {
	Seen  *Map
	Start int32
}

func Node(node0 int32, node1 int32, node2 int32, node3 int32, node4 *Map, node5 *Map) *Map {
	return &Map{Node0: node0, Node1: node1, Node2: node2, Node3: node3, Node4: node4, Node5: node5}
}

func UnsafeNodeInt(k int32, v int32, l *Map, r *Map) *Map {
	if l == SharedMapLeaf {
		if r == SharedMapLeaf {
			return Node(1, 1, k, v, l, r)
		}
		return Node(1+r.Node0, 1+r.Node1, k, v, l, r)
	}
	h1 := l.Node0
	s1 := l.Node1
	if r == SharedMapLeaf {
		return Node(1+h1, 1+s1, k, v, l, r)
	}
	h2 := r.Node0
	result := max(h1, h2)
	return Node(1+result, 1+s1+r.Node1, k, v, l, r)
}

func UnsafeBalancedNode(k int32, v int32, l *Map, r *Map, donor *Map) *Map {
	if l == SharedMapLeaf {
		if r == SharedMapLeaf {
			donor.Node0 = 1
			donor.Node1 = 1
			donor.Node2 = k
			donor.Node3 = v
			donor.Node4 = SharedMapLeaf
			donor.Node5 = SharedMapLeaf
			return donor
		}
		if r != SharedMapLeaf {
			rh := r.Node0
			rk := r.Node2
			rv := r.Node3
			rl := r.Node4
			rr := r.Node5
			if rh > 1 {
				return UnsafeBalancedNodeRotateLeft(k, v, l, rk, rv, rl, rr, donor)
			}
		}
		return UnsafeNodeIntReusing(k, v, l, r, donor)
	}
	lh := l.Node0
	lk := l.Node2
	lv := l.Node3
	ll := l.Node4
	lr := l.Node5
	if r != SharedMapLeaf {
		rh := r.Node0
		rk := r.Node2
		rv := r.Node3
		rl := r.Node4
		rr := r.Node5
		if rh > lh+1 {
			return UnsafeBalancedNodeRotateLeft(k, v, l, rk, rv, rl, rr, donor)
		}
		if lh > rh+1 {
			return UnsafeBalancedNodeRotateRight(k, v, lk, lv, ll, lr, r, donor)
		}
	}
	if r == SharedMapLeaf {
		if lh > 1 {
			return UnsafeBalancedNodeRotateRight(k, v, lk, lv, ll, lr, r, donor)
		}
	}
	return UnsafeNodeIntReusing(k, v, l, r, donor)
}

func UnsafeNodeIntReusing(k int32, v int32, l *Map, r *Map, donor *Map) *Map {
	if l == SharedMapLeaf {
		if r == SharedMapLeaf {
			donor.Node0 = 1
			donor.Node1 = 1
			donor.Node2 = k
			donor.Node3 = v
			donor.Node4 = l
			donor.Node5 = r
			return donor
		}
		h2 := r.Node0
		s2 := r.Node1
		donor.Node0 = 1 + h2
		donor.Node1 = 1 + s2
		donor.Node2 = k
		donor.Node3 = v
		donor.Node4 = l
		donor.Node5 = r
		return donor
	}
	h1 := l.Node0
	s1 := l.Node1
	if r == SharedMapLeaf {
		donor.Node0 = 1 + h1
		donor.Node1 = 1 + s1
		donor.Node2 = k
		donor.Node3 = v
		donor.Node4 = l
		donor.Node5 = r
		return donor
	}
	h22 := r.Node0
	s22 := r.Node1
	result := max(h1, h22)
	donor.Node0 = 1 + result
	donor.Node1 = 1 + s1 + s22
	donor.Node2 = k
	donor.Node3 = v
	donor.Node4 = l
	donor.Node5 = r
	return donor
}

func UnsafeBalancedNodeRotateLeft(k int32, v int32, l *Map, rk int32, rv int32, rl *Map, rr *Map, donor *Map) *Map {
	if rl != SharedMapLeaf {
		lh := rl.Node0
		lk := rl.Node2
		lv := rl.Node3
		ll := rl.Node4
		lr := rl.Node5
		var result int32
		if rr == SharedMapLeaf {
			result = 0
		} else {
			result = rr.Node0
		}
		if lh > result {
			return UnsafeNodeIntReusing(lk, lv, UnsafeNodeInt(k, v, l, ll), UnsafeNodeInt(rk, rv, lr, rr), donor)
		}
	}
	return UnsafeNodeIntReusing(rk, rv, UnsafeNodeInt(k, v, l, rl), rr, donor)
}

func UnsafeBalancedNodeRotateRight(k int32, v int32, lk int32, lv int32, ll *Map, lr *Map, r *Map, donor *Map) *Map {
	if lr != SharedMapLeaf {
		rh := lr.Node0
		rk := lr.Node2
		rv := lr.Node3
		rl := lr.Node4
		rr := lr.Node5
		var result int32
		if ll == SharedMapLeaf {
			result = 0
		} else {
			result = ll.Node0
		}
		if result <= rh {
			return UnsafeNodeIntReusing(rk, rv, UnsafeNodeInt(lk, lv, ll, rl), UnsafeNodeInt(k, v, rr, r), donor)
		}
	}
	return UnsafeNodeIntReusing(lk, lv, ll, UnsafeNodeInt(k, v, lr, r), donor)
}

// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	"fixture/Data/Map/Internal"
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/object"
)

func main() {
	words := []string{"a", "b", "a"}
	numbers := []int32{3, 1, 3, 2}
	accumulator := internal.Window{Start: 0, Seen: internal.SharedMapLeaf}
	for _, x := range numbers {
		seen := accumulator.Seen
		scrutinee := mainGo(x, seen)
		var start int32
		if scrutinee != maybe.NoInt {
			at := int32(scrutinee)
			x2 := accumulator.Start
			if x2 < at {
				start = at
			} else {
				start = x2
			}
		} else {
			start = accumulator.Start
		}
		v := start + 1
		accumulator = internal.Window{Start: start, Seen: mainGoReusing(x, v, seen)}
	}
	accumulator2 := object.Empty[int32]()
	accumulator2 = object.Lend(accumulator2)
	for _, word := range words {
		value, found := object.Lookup(word, accumulator2)
		var result int32
		if found {
			result = value + 1
		} else {
			result = 1
		}
		accumulator2 = object.InsertOwned(word, result, accumulator2)
	}
	var result2 int32
	if accumulator.Seen == internal.SharedMapLeaf {
		result2 = 0
	} else {
		result2 = accumulator.Seen.Node1
	}
	output := &shared.Ref[int32]{Value: object.Size(accumulator2) + accumulator.Start + result2}
	output.Value = 0
}

func mainGo(x int32, value *internal.Map) maybe.Int {
	for {
		if value == internal.SharedMapLeaf {
			return maybe.NoInt
		}
		mk := value.Node2
		mv := value.Node3
		ml := value.Node4
		mr := value.Node5
		if x < mk {
			value = ml
			continue
		}
		if x == mk {
			return maybe.Int(mv)
		}
		value = mr
	}
}

func mainGoReusing(x int32, v int32, value *internal.Map) *internal.Map {
	if value == internal.SharedMapLeaf {
		return internal.Node(1, 1, x, v, internal.SharedMapLeaf, internal.SharedMapLeaf)
	}
	mk := value.Node2
	mv := value.Node3
	ml := value.Node4
	mr := value.Node5
	if x < mk {
		return internal.UnsafeBalancedNode(mk, mv, mainGoReusing(x, v, ml), mr, value)
	}
	if x == mk {
		value.Node2 = x
		value.Node3 = v
		return value
	}
	return internal.UnsafeBalancedNode(mk, mv, ml, mainGoReusing(x, v, mr), value)
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}
