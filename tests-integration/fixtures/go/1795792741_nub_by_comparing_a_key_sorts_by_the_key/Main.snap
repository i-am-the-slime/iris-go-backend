// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  int
	Second int
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	return firstOfEachLastDigit(numbers)
}

func firstOfEachLastDigit(xs []int) []int {
	mapped := make([]tuple.Tuple, len(xs))
	for slot, i := range xs {
		mapped[slot] = tuple.Tuple{First: slot, Second: i}
	}
	indexedAndSorted := shared.SortByKey(mapped, func(x tuple.Tuple) int {
		return prim.IntModPositive(x.Second, 10)
	})
	if len(indexedAndSorted) > 0 {
		array2 := *arraypkg.UnsafeThaw([]tuple.Tuple{indexedAndSorted[0]})
		for _, pair := range indexedAndSorted {
			array3 := shared.Frozen(array2)
			index := len(array3) - 1
			var result tuple.Tuple
			if index >= 0 && index < len(array3) {
				result = array3[index]
			} else {
				panic("Failed pattern match")
			}
			lst := result.Second
			if firstOfEachLastDigitComp(lst, pair.Second) != ordering.OrderingEQ {
				array2 = append(array2, pair)
			}
		}
		performed := shared.Frozen(array2)
		array := shared.SortByKey(performed, func(x tuple.Tuple) int {
			return x.First
		})
		mapped2 := make([]int, len(array))
		for index := range array {
			mapped2[index] = array[index].Second
		}
		return mapped2
	}
	return []int{}
}

var numbers []int = []int{31, 7, 12, 40, 27, 3, 17, 22, 9, 51}

func firstOfEachLastDigitComp(x int, y int) ordering.Ordering {
	i := prim.IntModPositive(x, 10)
	i2 := prim.IntModPositive(y, 10)
	if i < i2 {
		return ordering.OrderingLT
	}
	if i == i2 {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type SortByKeyOrdered interface {
	~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64
}

type SortByKeyEntry[K SortByKeyOrdered] struct {
	key   K
	index int
}

func SortByKey[T any, K SortByKeyOrdered](xs []T, key func(T) K) []T {
	entries := make([]SortByKeyEntry[K], len(xs))
	for index, x := range xs {
		entries[index] = SortByKeyEntry[K]{key: key(x), index: index}
	}
	if len(xs) > 1 {
		scratch := make([]SortByKeyEntry[K], len(xs))
		copy(scratch, entries)
		SortByKeyMerge(entries, scratch, 0, len(xs))
	}
	sorted := make([]T, len(xs))
	for index, entry := range entries {
		sorted[index] = xs[entry.index]
	}
	return sorted
}

func SortByKeyMerge[K SortByKeyOrdered](into []SortByKeyEntry[K], from []SortByKeyEntry[K], low int, high int) {
	middle := low + (high-low)>>1
	if middle-low > 1 {
		SortByKeyMerge(from, into, low, middle)
	}
	if high-middle > 1 {
		SortByKeyMerge(from, into, middle, high)
	}
	i, j, k := low, middle, low
	for i < middle && j < high {
		if from[j].key < from[i].key {
			into[k] = from[j]
			j++
		} else {
			into[k] = from[i]
			i++
		}
		k++
	}
	k += copy(into[k:], from[i:middle])
	copy(into[k:], from[j:high])
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
