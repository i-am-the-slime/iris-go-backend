// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	"fixture/Data/Maybe"
	"math"
)

var main_ = initializeMain_()

func initializeMain_() []maybe.Int {
	number := math.Copysign(0, -1)
	var integer maybe.Int
	if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
		integer = maybe.Int(int32(number))
	} else {
		integer = maybe.NoInt
	}
	number2 := opaque(3.0e10)
	var integer2 maybe.Int
	if math.Trunc(number2) == number2 && (number2 >= math.MinInt32 && number2 <= math.MaxInt32) {
		integer2 = maybe.Int(int32(number2))
	} else {
		integer2 = maybe.NoInt
	}
	return []maybe.Int{maybe.NoInt, maybe.NoInt, maybe.Int(2147483647), maybe.Int(-2147483648), maybe.NoInt, integer, integer2}
}

func opaque(x float64) float64 {
	for {
		if x == 12345.0 {
			continue
		}
		return x
	}
}

func main() {
	_ = main_
}

// note: the entry's value of type Array Data.Maybe.Maybe is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
