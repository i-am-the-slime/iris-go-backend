// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() string {
	text := show.AppendShowArrayNumber(nil, []float64{3.0, 1.0, 7.0, 3.0, 6.0})
	text = strconv.AppendInt(text, int64(8), 10)
	text = append(text, "ab"...)
	return string(text)
}

func main() {
	console.Print(main_)
}
