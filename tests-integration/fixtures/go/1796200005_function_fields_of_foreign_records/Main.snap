// main.go
package main

import (
	server "fixture/Server_ffi"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	routes.Handle("bob", "yo", func(s string) {
		server.Log(s)
	})
	server.Log(strconv.Itoa(routes.Add(3)(4)))
	server.Log(routes.Settings.Greeting("hi")("bob"))
	server.Serve(routes)
	hooks := server.InstallHooks()
	hooks.Route("carol")("hey", func(s string) {
		server.Log(s)
	})
	server.Log(prim.ShowNumber(hooks.Fold(func(a float64) func(float64) float64 {
		return func(b float64) float64 {
			return a*10.0 + b
		}
	})))
}

var routes server.Routes = server.Routes{Handle: func(name string, body string, reply func(string)) {
	server.Log(name + ": " + body)
	reply("thanks " + name)
}, Add: func(a int) func(int) int {
	return func(b int) int {
		return a*10 + b
	}
}, Each: []func(string) func(string){func(a string) func(string) {
	return func(b string) {
		server.Log(prim.Append(a, b))
	}
}, func(a string) func(string) {
	return func(b string) {
		server.Log(prim.Append(b, a))
	}
}}, Settings: server.Settings{Greeting: func(word string) func(string) string {
	return func(name string) string {
		return word + ", " + name
	}
}}}
