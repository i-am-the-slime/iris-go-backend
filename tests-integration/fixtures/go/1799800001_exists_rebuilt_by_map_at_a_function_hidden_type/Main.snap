// Data/Either/either.go
package either

type EitherString struct {
	Left   string
	Right  any
	Origin any
	Tag    uint8
}

const (
	EitherStringLeft = iota
	EitherStringRight
)

type EitherFn struct {
	Left   string
	Right  func(any) any
	Origin any
	Tag    uint8
}

const (
	EitherFnLeft = iota
	EitherFnRight
)

func Convert(value *EitherFn) *EitherString {
	if value == nil {
		return nil
	}
	if original, ok := value.Origin.(*EitherString); ok {
		return original
	}
	switch value.Tag {
	case EitherFnLeft:
		return &EitherString{Tag: EitherStringLeft, Left: value.Left, Origin: value}
	default: // EitherFnRight
		return &EitherString{Tag: EitherStringRight, Right: value.Right, Origin: value}
	}
}

func Convert2(value *EitherString) *EitherFn {
	if value == nil {
		return nil
	}
	if original, ok := value.Origin.(*EitherFn); ok {
		return original
	}
	switch value.Tag {
	case EitherStringLeft:
		return &EitherFn{Tag: EitherFnLeft, Left: value.Left, Origin: value}
	default: // EitherStringRight
		return &EitherFn{Tag: EitherFnRight, Right: value.Right.(func(any) any), Origin: value}
	}
}

type StringFailure struct {
	Failed bool
	Left   string
}

