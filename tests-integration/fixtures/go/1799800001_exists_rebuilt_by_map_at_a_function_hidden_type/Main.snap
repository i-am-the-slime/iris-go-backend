func main() {
	var function *ParserFnFnCommandCommandFnCommandCommand
	switch modifier.Tag {
	case ParserFnCommandCommandOption:
		function = OptionParserFnFnCommandCommandFnCommandCommand(func(x string) (func(func(Command) Command) func(Command) Command, dataeither.StringFailure) {
			f, err := modifier.Option(x)
			if err.Failed {
				return nil, err
			}
			return func(g func(Command) Command) func(Command) Command {
				return func(x2 Command) Command {
					return g(f(x2))
				}
			}, dataeither.StringFailure{}
		})
	case ParserFnCommandCommandDone:
		function = DoneParserFnFnCommandCommandFnCommandCommand(func(g func(Command) Command) func(Command) Command {
			return func(x Command) Command {
				return g(modifier.Done(x))
			}
		})
	default: // ParserFnCommandCommandApply
		original := func(function2 func(any) any) func(*Parser) *Parser {
			return func(value *Parser) *Parser {
				return map_(function2, value)
			}
		}
		original2 := func(value func(func(Command) Command) func(Command) Command) func(func(Command) Command) func(func(Command) Command) func(Command) Command {
			return func(x func(Command) Command) func(func(Command) Command) func(Command) Command {
				f := value(x)
				return func(g func(Command) Command) func(Command) Command {
					return func(x2 Command) Command {
						return g(f(x2))
					}
				}
			}
		}
		function = ApplyParserFnFnCommandCommandFnCommandCommand(&ExistsAppliedFnFnCommandCommandFnCommandCommand{FnCommandCommand: &AppliedFnFnCommandCommandFnCommandCommand{First: convert14(original(func(coerced any) any {
			original3 := coerced.(func(any) any)
			original5 := original2(func(coerced2 func(Command) Command) func(Command) Command {
				original4 := original3(func(coerced3 any) any {
					return coerced2(coerced3.(Command))
				}).(func(any) any)
				return func(coerced3 Command) Command {
					return original4(coerced3).(Command)
				}
			})
			return func(coerced2 any) any {
				original4 := coerced2.(func(any) any)
				original6 := original5(func(coerced3 Command) Command {
					return original4(coerced3).(Command)
				})
				return func(coerced3 any) any {
					original7 := coerced3.(func(any) any)
					original8 := original6(func(coerced4 Command) Command {
						return original7(coerced4).(Command)
					})
					return func(coerced4 any) any {
						return original8(coerced4.(Command))
					}
				}
			}
		})(convert12(modifier.Apply.FnCommandCommand.First))), Second: modifier.Apply.FnCommandCommand.Second}})
	}
	command, err2 := parseCommand(ApplyParserCommand(&ExistsAppliedCommand{Command: &AppliedCommand{First: ApplyParserFnCommandCommand(&ExistsAppliedFnCommandCommand{FnCommandCommand: &AppliedFnCommandCommand{First: function, Second: modifier}}), Second: DoneParserCommand(CommandBye)}}), "x")
	var result string
	if err2.Failed {
		result = "(Left " + prim.ShowString(err2.Left) + ")"
	} else {
		var result2 string
		switch command {
		case CommandHello:
			result2 = "hello"
		default: // CommandBye
			result2 = "bye"
		}
		result = "(Right " + result2 + ")"
	}
	journal.Log(result)
}

func parseCommand(parser *ParserCommand, word string) (Command, dataeither.StringFailure) {
	switch parser.Tag {
	case ParserCommandOption:
		return parser.Option(word)
	case ParserCommandDone:
		return parser.Done, dataeither.StringFailure{}
	default: // ParserCommandApply
		original := func(parser2 *Parser) func(string) *dataeither.EitherString {
			return func(word2 string) *dataeither.EitherString {
				return parseFnCommandCommand(parser2, word2)
			}
		}
		scrutinee := convert15(original(convert9(parser.Apply.Command.First))(word))
		switch scrutinee.Tag {
		case EitherFnCommandCommandLeft:
			return 0, dataeither.StringFailure{Failed: true, Left: scrutinee.Left}
		default: // EitherFnCommandCommandRight
			command, err := parseCommand(parser.Apply.Command.Second, word)
			if err.Failed {
				return 0, err
			}
			return scrutinee.Right(command), dataeither.StringFailure{}
		}
	}
}

var modifier *ParserFnCommandCommand = OptionParserFnCommandCommand(func(_ string) (func(Command) Command, dataeither.StringFailure) {
	return identity, dataeither.StringFailure{}
})

func map_(function func(any) any, value *Parser) *Parser {
	switch value.Tag {
	case ParserOption:
		return &Parser{Tag: ParserOption, Option: func(x string) *dataeither.EitherString {
			scrutinee := value.Option(x)
			switch scrutinee.Tag {
			case dataeither.EitherStringLeft:
				return &dataeither.EitherString{Tag: dataeither.EitherStringLeft, Left: scrutinee.Left}
			default: // dataeither.EitherStringRight
				return &dataeither.EitherString{Tag: dataeither.EitherStringRight, Right: function(scrutinee.Right)}
			}
		}}
	case ParserDone:
		return &Parser{Tag: ParserDone, Field0: function(value.Field0)}
	default: // ParserApply
		scrutinee := value.Field0.(*Applied)
		original := func(function2 func(any) any) func(*Parser) *Parser {
			return func(value2 *Parser) *Parser {
				return map_(function2, value2)
			}
		}
		original2 := func(value2 func(any) any) func(any) any {
			return func(x any) any {
				return function(value2(x))
			}
		}
		return &Parser{Tag: ParserApply, Field0: &Applied{First: convert17(original(func(coerced any) any {
			return original2(coerced.(func(any) any))
		})(convert16(scrutinee.First))), Second: scrutinee.Second}}
	}
}

func identity(x Command) Command {
	return x
}

func parseFnCommandCommand(parser *Parser, word string) *dataeither.EitherString {
	switch parser.Tag {
	case ParserOption:
		return parser.Option(word)
	case ParserDone:
		return &dataeither.EitherString{Tag: dataeither.EitherStringRight, Right: parser.Field0}
