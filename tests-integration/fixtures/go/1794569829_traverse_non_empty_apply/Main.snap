// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type ArrayInt struct {
	Just []int32
	Tag  uint8
}

func JustArrayInt(just []int32) ArrayInt {
	return ArrayInt{Tag: TagJust, Just: just}
}

var NoArrayInt = ArrayInt{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
)

var main_ = initializeMain_()

func initializeMain_() maybe.ArrayInt {
	array2 := arraypkg.Append([]int32{2}, []int32{4, 8})
	append_ := direct.Appender[int32]()
	n := array2[0]
	var result maybe.ArrayInt
	if n&1 == 0 {
		result = maybe.JustArrayInt([]int32{n >> 1})
	} else {
		result = maybe.NoArrayInt
	}
	array := arraypkg.Slice(1, int32(len(array2)), array2)
	for _, element := range array {
		switch result.Tag {
		case maybe.TagJust:
			if element&1 == 0 {
				result = maybe.JustArrayInt(append_(result.Just)(element >> 1))
			} else {
				result = maybe.NoArrayInt
			}
		default:
			result = maybe.NoArrayInt
		}
	}
	return result
}

func main() {
	_ = main_
}

// note: the entry's value of type Data.Maybe.Maybe is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
