// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type ArrayInt struct {
	Just []int
	Tag  uint8
}

func JustArrayInt(just []int) ArrayInt {
	return ArrayInt{Tag: TagJust, Just: just}
}

var NoArrayInt = ArrayInt{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"slices"
)

var main_ = initializeMain_()

func initializeMain_() maybe.ArrayInt {
	array := arraypkg.Slice(1, 3, []int{2, 4, 8})
	accumulator := maybe.JustArrayInt([]int{1})
	accumulator.Just = slices.Grow(slices.Clip(accumulator.Just), len(array))
	carried := accumulator.Just
	for _, element := range array {
		if element&1 == 0 {
			carried = append(carried, element>>1)
		} else {
			accumulator = maybe.NoArrayInt
			break
		}
	}
	if accumulator.Tag != maybe.TagNothing {
		accumulator.Just = carried
	}
	return accumulator
}

func main() {
	_ = main_
}

// note: the entry's value of type Data.Maybe.Maybe is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
