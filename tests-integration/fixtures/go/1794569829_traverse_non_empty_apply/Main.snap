// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type ArrayInt struct {
	Just []int32
	Tag  uint8
}

func JustArrayInt(just []int32) ArrayInt {
	return ArrayInt{Tag: TagJust, Just: just}
}

var NoArrayInt = ArrayInt{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() maybe.ArrayInt {
	defer exception.ReportUncaught()
	array2 := array.Append([]int32{2}, []int32{4, 8})
	append_ := direct.Appender[int32]()
	n := array2[0]
	var result maybe.ArrayInt
	if prim.IntMod(n, 2) == 0 {
		result = maybe.JustArrayInt([]int32{prim.IntDiv(n, 2)})
	} else {
		result = maybe.NoArrayInt
	}
	array3 := array.Slice(1, int32(len(array2)), array2)
	accumulator := result
	for _, element := range array3 {
		switch accumulator.Tag {
		case maybe.TagJust:
			if prim.IntMod(element, 2) == 0 {
				accumulator = maybe.JustArrayInt(append_(accumulator.Just)(prim.IntDiv(element, 2)))
			} else {
				accumulator = maybe.NoArrayInt
			}
		default:
			accumulator = maybe.NoArrayInt
		}
	}
	return accumulator
}

func main() {
	fmt.Println(main_)
}
