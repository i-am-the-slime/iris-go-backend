// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	return []int32{combineWith(2)(3, 4), combineWith(5)(1, 1)}
}

func combineWith(n int32) func(int32, int32) int32 {
	if n > 0 {
		return func(a int32, b int32) int32 {
			return a*n + b
		}
	}
	panic("a positive weight")
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
