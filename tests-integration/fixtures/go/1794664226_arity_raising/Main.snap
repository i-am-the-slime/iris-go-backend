// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array2 := []func(int32) int32{func(x int32) int32 {
		return offset(2, x)
	}, func(x int32) int32 {
		return offset(5, x)
	}}
	mapped := make([]string, len(array2))
	for index, shift := range array2 {
		mapped[index] = prim.ShowInt(shift(1))
	}
	return array.Append(mapped, array.Append([]string{prim.ShowInt(offset(3, 4))}, array.Map(prefixed(2), []string{"a", "b"})))
}

func offset(n int32, x int32) int32 {
	switch n {
	case 0:
		return x
	default:
		return offset(n - 1, x) + 1
	}
}

func prefixed(n int32) func(string) string {
	switch n {
	case 0:
		return func(text string) string {
			return text
		}
	default:
		prefix := repeat(n)
		return func(text string) string {
			return prim.Append(prefix, prefixed(n - 1)(text))
		}
	}
}

func repeat(n int32) string {
	switch n {
	case 0:
		return ""
	default:
		return "*" + repeat(n - 1)
	}
}

func main() {
	fmt.Println(main_)
}
