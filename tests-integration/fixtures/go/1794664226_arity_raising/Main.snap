// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array2 := []func(int32) int32{func(x int32) int32 {
		return offset(2, x)
	}, func(x2 int32) int32 {
		return offset(5, x2)
	}}
	mapped := make([]string, len(array2))
	for index, shift := range array2 {
		mapped[index] = prim.ShowInt(int(shift(1)))
	}
	return array.Append(mapped, array.Append([]string{prim.ShowInt(int(offset(3, 4)))}, array.Map(prefixed(2), []string{"a", "b"})))
}

func offset(argument0 int32, x int32) int32 {
	switch argument0 {
	case 0:
		return x
	default:
		return offset(argument0 - 1, x) + 1
	}
}

func prefixed(argument0 int32) func(string) string {
	switch argument0 {
	case 0:
		return func(text string) string {
			return text
		}
	default:
		prefix := repeat(argument0)
		return func(text2 string) string {
			return prefix + prefixed(argument0 - 1)(text2)
		}
	}
}

func repeat(argument0 int32) string {
	switch argument0 {
	case 0:
		return ""
	default:
		return "*" + repeat(argument0 - 1)
	}
}

func main() {
	fmt.Println(main_)
}
