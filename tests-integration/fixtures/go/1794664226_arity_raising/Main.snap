// main.go
package main

import (
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array := []func(int32) int32{func(x int32) int32 {
		return offset(2, x)
	}, func(x int32) int32 {
		return offset(5, x)
	}}
	mapped := make([]string, len(array))
	for index, shift := range array {
		mapped[index] = strconv.Itoa(int(shift(1)))
	}
	return arraypkg.Append(mapped, arraypkg.Append([]string{strconv.Itoa(int(offset(3, 4)))}, arraypkg.Map(prefixed(2), []string{"a", "b"})))
}

func offset(n int32, x int32) int32 {
	switch n {
	case 0:
		return x
	default:
		return offset(n-1, x) + 1
	}
}

func prefixed(n int32) func(string) string {
	switch n {
	case 0:
		return func(text string) string {
			return text
		}
	default:
		prefix := repeat(n)
		return func(text string) string {
			return prim.Append(prefix, prefixed(n-1)(text))
		}
	}
}

func repeat(n int32) string {
	switch n {
	case 0:
		return ""
	default:
		return "*" + repeat(n-1)
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
