// main.go
package main

import (
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []func(int) int{func(x int) int {
		return offset(2, x)
	}, func(x int) int {
		return offset(5, x)
	}}
	mapped := make([]string, len(array))
	for index, shift := range array {
		mapped[index] = strconv.Itoa(shift(1))
	}
	return arraypkg.Append(mapped, arraypkg.Append([]string{strconv.Itoa(offset(3, 4))}, arraypkg.Map(prefixed(2), []string{"a", "b"})))
}

func offset(n int, x int) int {
	switch n {
	case 0:
		return x
	default:
		return offset(n-1, x) + 1
	}
}

func prefixed(n int) func(string) string {
	switch n {
	case 0:
		return func(text string) string {
			return text
		}
	default:
		prefix := repeat(n)
		return func(text string) string {
			return prim.Append(prefix, prefixed(n-1)(text))
		}
	}
}

func repeat(n int) string {
	return string(appendRepeat(nil, n))
}

func appendRepeat(buffer []byte, n int) []byte {
	switch n {
	case 0:
	default:
		buffer = append(buffer, '*')
		buffer = appendRepeat(buffer, n-1)
	}
	return buffer
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
