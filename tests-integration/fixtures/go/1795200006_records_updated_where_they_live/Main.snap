// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() float64 {
	return -0.5 + (0.0 + toNumber(0)*1.0 + toNumber(1)*0.5) + toNumber(4)
}

func toNumber(i int) float64 {
	if i == 0 {
		return 0.0
	}
	return 1.0 + toNumber(i-1)
}

func main() {
	console.Print(prim.NumberToString(main_))
}
