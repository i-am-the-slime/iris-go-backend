// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type TupleIntBody struct {
	Second shared.Body
	First  int32
}

type TupleIntInt struct {
	First  int32
	Second int32
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() float64 {
	bodies := []shared.Body{{X: 0.0, Y: 0.0, Vx: 0.0, Vy: 0.0, Mass: 1.0}, {X: 1.0, Y: 2.0, Vx: 0.0, Vy: 0.0, Mass: 0.5}}
	accumulatorVx := 0.0
	accumulatorVy := 0.0
	accumulatorX := 0.5
	accumulatorY := 0.5
	for otherIndex := range bodies {
		accumulatorVx += (bodies[otherIndex].X - accumulatorX) * bodies[otherIndex].Mass
		accumulatorVy += (bodies[otherIndex].Y - accumulatorY) * bodies[otherIndex].Mass
	}
	accumulatorVx2 := 0.0
	accumulatorVy2 := 0.0
	accumulatorX2 := 0.5
	accumulatorY2 := 0.5
	for index := range bodies {
		i := int32(index)
		if 1 != i {
			accumulatorVx2 += (bodies[index].X - accumulatorX2) * bodies[index].Mass
			accumulatorVy2 += (bodies[index].Y - accumulatorY2) * bodies[index].Mass
		}
	}
	accumulator := 0.0
	for index := range bodies {
		i := int32(index)
		accumulator += toNumber(i) * bodies[index].Mass
	}
	array := []int32{3, 4}
	accumulator2 := []tuple.TupleIntInt{}
	for index, i := range array {
		i2 := int32(index)
		accumulator2 = arraypkg.Bounded(append(accumulator2, tuple.TupleIntInt{First: i2, Second: i}))
	}
	var accumulator3 int32 = 0
	for tupleIndex := range accumulator2 {
		accumulator3 += accumulator2[tupleIndex].First * accumulator2[tupleIndex].Second
	}
	return accumulatorVx + accumulatorVy + accumulatorVx2 + accumulator + toNumber(accumulator3)
}

func toNumber(i int32) float64 {
	if i == 0 {
		return 0.0
	}
	return 1.0 + toNumber(i-1)
}

func main() {
	console.Print(prim.NumberToString(main_))
}

// shared/shared.go
package shared

type Body struct {
	Mass float64
	Vx   float64
	Vy   float64
	X    float64
	Y    float64
}
