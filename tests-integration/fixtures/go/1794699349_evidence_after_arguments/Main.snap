// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{"value=42", "text=" + prim.ShowString("x"), "true", "different", boxed.Describe(7), local}
}

var local string = "local=13"

var boxed shared.Describe = shared.Describe{Describe: func(value int32) string {
	return "boxed " + strconv.Itoa(int(value))
}}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Describe struct {
	Describe func(int32) string
}
