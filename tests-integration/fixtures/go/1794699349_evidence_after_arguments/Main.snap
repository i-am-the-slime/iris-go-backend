// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Describe struct {
	Describe func(int32) string
}

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return []string{"value=" + prim.ShowInt(42), "text=" + prim.ShowString("x"), "true", "different", boxedInt.Describe(7), local}
}

var local = initializeLocal()

func initializeLocal() string {
	defer exception.ReportUncaught()
	return "local=" + prim.ShowInt(13)
}

var boxedInt Describe = Describe{Describe: func(value int32) string {
	return "boxed " + prim.ShowInt(value)
}}

func main() {
	fmt.Println(main_)
}
