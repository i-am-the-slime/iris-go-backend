// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	result := *array.Thaw([]int{3, 1, 2})
	size := len(result)
	for i := 1; i < size; i++ {
		within := i < len(result)
		var current int
		if within {
			current = result[i]
		} else {
			current = 0
		}
		var j int = i - 1
	mainShiftDown:
		for {
			if j < 0 {
				if len(result) > 0 {
					result[0] = current
				}
				break mainShiftDown
			}
			within2 := j < len(result)
			var previous int
			if within2 {
				previous = result[j]
			} else {
				previous = 0
			}
			if previous > current {
				index := j + 1
				if index < len(result) {
					result[index] = previous
				}
				j -= 1
				continue
			}
			index2 := j + 1
			if index2 < len(result) {
				result[index2] = current
			}
			break mainShiftDown
		}
	}
	performed := shared.Frozen(result)
	return array.Append([]int{mainGo(100, 0)}, performed)
}

func mainDigitSum(x int, acc int) int {
	for {
		if x == 0 {
			return acc
		}
		x, acc = prim.IntDivPositive(x, 10), acc+prim.IntModPositive(x, 10)
	}
}

func mainGo(i int, acc int) int {
	for {
		if i == 0 {
			return acc
		}
		i, acc = i-1, acc+mainDigitSum(i, 0)
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
