// Data/Either/either.go
package either

type Either struct {
	Left  string
	Right []int
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type MainResult struct {
	Appended []int
	Combined Either
	Escaping [][]int
	Snocs    []int
}

func Right(right []int) Either {
	return Either{Tag: EitherRight, Right: right}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"slices"
)

var main_ = initializeMain_()

func initializeMain_() either.MainResult {
	accumulator := []int{}
	for x := 1; x < 6; x++ {
		accumulator = append(accumulator, x)
	}
	accumulator2 := []int{1}
	accumulator2 = slices.Clip(accumulator2)
	for x := 1; x < 6; x++ {
		accumulator2 = append(accumulator2, x*2)
	}
	accumulator3 := shared.AccSeen{Acc: []int{}, Seen: [][]int{}}
	accumulator3.Seen = slices.Clip(accumulator3.Seen)
	for x := 1; x < 5; x++ {
		accumulator3 = shared.AccSeen{Acc: array.Append(accumulator3.Acc, []int{x}), Seen: append(accumulator3.Seen, accumulator3.Acc)}
	}
	return either.MainResult{Appended: accumulator, Snocs: accumulator2, Combined: either.Right([]int{1, 2, 3}), Escaping: accumulator3.Seen}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type AccSeen struct {
	Acc  []int
	Seen [][]int
}

// note: the entry's value of type { appended, combined, escaping, snocs } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
