// Data/Either/either.go
package either

type EitherStringArrayInt struct {
	Left  string
	Right []int32
	Tag   uint8
}

const (
	EitherStringArrayIntLeft = iota
	EitherStringArrayIntRight
)

type MainResult struct {
	Appended []int32
	Combined EitherStringArrayInt
	Escaping [][]int32
	Snocs    []int32
}

type EitherStringInt struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringIntLeft = iota
	EitherStringIntRight
)

func RightEitherStringInt(right int32) EitherStringInt {
	return EitherStringInt{Tag: EitherStringIntRight, Right: right}
}

func RightEitherStringArrayInt(right []int32) EitherStringArrayInt {
	return EitherStringArrayInt{Tag: EitherStringArrayIntRight, Right: right}
}

func Left(left string) EitherStringArrayInt {
	return EitherStringArrayInt{Tag: EitherStringArrayIntLeft, Left: left}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
)

var main_ = initializeMain_()

func initializeMain_() either.MainResult {
	accumulator := []int32{}
	accumulator = slices.Clip(accumulator)
	for x := int32(1); x < 6; x++ {
		accumulator = arraypkg.Bounded(append(accumulator, x))
	}
	accumulator2 := []int32{1}
	accumulator2 = slices.Clip(accumulator2)
	for x := int32(1); x < 6; x++ {
		accumulator2 = arraypkg.Bounded(append(accumulator2, x*2))
	}
	array := []either.EitherStringInt{either.RightEitherStringInt(1), either.RightEitherStringInt(2), either.RightEitherStringInt(3)}
	accumulator3 := either.RightEitherStringArrayInt([]int32{})
	accumulator3.Right = slices.Clip(accumulator3.Right)
	for elementIndex := range array {
		if accumulator3.Tag == either.EitherStringArrayIntLeft && array[elementIndex].Tag == either.EitherStringIntLeft {
			accumulator3 = either.Left(prim.Append(accumulator3.Left, array[elementIndex].Left))
		} else if accumulator3.Tag == either.EitherStringArrayIntLeft && array[elementIndex].Tag == either.EitherStringIntRight {
			accumulator3 = either.Left(accumulator3.Left)
		} else if accumulator3.Tag == either.EitherStringArrayIntRight && array[elementIndex].Tag == either.EitherStringIntRight {
			accumulator3 = either.RightEitherStringArrayInt(arraypkg.Bounded(append(accumulator3.Right, array[elementIndex].Right)))
		} else {
			accumulator3 = either.Left(array[elementIndex].Left)
		}
	}
	accumulator4 := shared.AccSeen{Acc: []int32{}, Seen: [][]int32{}}
	accumulator4.Seen = slices.Clip(accumulator4.Seen)
	for x := int32(1); x < 5; x++ {
		accumulator4 = shared.AccSeen{Acc: arraypkg.Append(accumulator4.Acc, []int32{x}), Seen: arraypkg.Bounded(append(accumulator4.Seen, accumulator4.Acc))}
	}
	return either.MainResult{Appended: accumulator, Snocs: accumulator2, Combined: accumulator3, Escaping: accumulator4.Seen}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type AccSeen struct {
	Acc  []int32
	Seen [][]int32
}

// note: the entry's value of type { appended, combined, escaping, snocs } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
