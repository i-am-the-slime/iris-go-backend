// Data/Either/either.go
package either

type EitherStringArrayInt struct {
	Left  string
	Right []int32
	Tag   uint8
}

const (
	EitherStringArrayIntLeft = iota
	EitherStringArrayIntRight
)

type MainResult struct {
	Appended []int32
	Combined EitherStringArrayInt
	Escaping [][]int32
	Snocs    []int32
}

type EitherStringInt struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringIntLeft = iota
	EitherStringIntRight
)

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
	"slices"
)

var main_ = initializeMain_()

func initializeMain_() either.MainResult {
	defer exception.ReportUncaught()
	accumulator := []int32{}
	accumulator = slices.Clip(accumulator)
	for x := int32(1); x < 6; x++ {
		accumulator = append(accumulator, x)
	}
	accumulator2 := []int32{1}
	accumulator2 = slices.Clip(accumulator2)
	for x := int32(1); x < 6; x++ {
		accumulator2 = append(accumulator2, prim.MultiplyInt32(x, 2))
	}
	array2 := []either.EitherStringInt{either.EitherStringInt{Tag: either.EitherStringIntRight, Right: 1}, either.EitherStringInt{Tag: either.EitherStringIntRight, Right: 2}, either.EitherStringInt{Tag: either.EitherStringIntRight, Right: 3}}
	accumulator3 := either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: []int32{}}
	accumulator3.Right = slices.Clip(accumulator3.Right)
	for elementIndex := range array2 {
		if accumulator3.Tag == either.EitherStringArrayIntLeft && array2[elementIndex].Tag == either.EitherStringIntLeft {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: prim.Append(accumulator3.Left, array2[elementIndex].Left)}
		} else if accumulator3.Tag == either.EitherStringArrayIntLeft && array2[elementIndex].Tag == either.EitherStringIntRight {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: accumulator3.Left}
		} else if accumulator3.Tag == either.EitherStringArrayIntRight && array2[elementIndex].Tag == either.EitherStringIntRight {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: append(accumulator3.Right, array2[elementIndex].Right)}
		} else {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: array2[elementIndex].Left}
		}
	}
	accumulator4 := shared.AccSeen{Acc: []int32{}, Seen: [][]int32{}}
	accumulator4.Seen = slices.Clip(accumulator4.Seen)
	for x := int32(1); x < 5; x++ {
		accumulator4 = shared.AccSeen{Acc: array.Append(accumulator4.Acc, []int32{x}), Seen: append(accumulator4.Seen, accumulator4.Acc)}
	}
	return either.MainResult{Appended: accumulator, Snocs: accumulator2, Combined: accumulator3, Escaping: accumulator4.Seen}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type AccSeen struct {
	Acc  []int32
	Seen [][]int32
}
