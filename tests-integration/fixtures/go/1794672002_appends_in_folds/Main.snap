// Data/Either/either.go
package either

type EitherStringArrayInt struct {
	Left  string
	Right []int32
	Tag   uint8
}

const (
	EitherStringArrayIntLeft = iota
	EitherStringArrayIntRight
)

type EitherStringInt struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringIntLeft = iota
	EitherStringIntRight
)

// main.go
package main

import (
	"fixture/Data/Either"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
	"slices"
)

type MainResult struct {
	Appended []int32
	Combined either.EitherStringArrayInt
	Escaping [][]int32
	Snocs    []int32
}

type AccSeen struct {
	Acc  []int32
	Seen [][]int32
}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	accumulator := []int32{}
	accumulator = slices.Clip(accumulator)
	for x := int32(1); x < 6; x++ {
		acc := accumulator
		accumulator = append(acc, x)
	}
	accumulator2 := []int32{1}
	accumulator2 = slices.Clip(accumulator2)
	for x2 := int32(1); x2 < 6; x2++ {
		acc2 := accumulator2
		accumulator2 = append(acc2, prim.MultiplyInt32(x2, 2))
	}
	array2 := []either.EitherStringInt{either.EitherStringInt{Tag: either.EitherStringIntRight, Right: 1}, either.EitherStringInt{Tag: either.EitherStringIntRight, Right: 2}, either.EitherStringInt{Tag: either.EitherStringIntRight, Right: 3}}
	accumulator3 := either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: []int32{}}
	accumulator3.Right = slices.Clip(accumulator3.Right)
	for elementIndex := range array2 {
		acc3 := accumulator3
		if acc3.Tag == either.EitherStringArrayIntLeft && array2[elementIndex].Tag == either.EitherStringIntLeft {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: acc3.Left + array2[elementIndex].Left}
		} else if acc3.Tag == either.EitherStringArrayIntLeft && array2[elementIndex].Tag == either.EitherStringIntRight {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: acc3.Left}
		} else if acc3.Tag == either.EitherStringArrayIntRight && array2[elementIndex].Tag == either.EitherStringIntRight {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: append(acc3.Right, array2[elementIndex].Right)}
		} else {
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: array2[elementIndex].Left}
		}
	}
	accumulator4 := AccSeen{Acc: []int32{}, Seen: [][]int32{}}
	accumulator4.Seen = slices.Clip(accumulator4.Seen)
	for x3 := int32(1); x3 < 5; x3++ {
		r := accumulator4
		accumulator4 = AccSeen{Acc: array.Append(r.Acc, []int32{x3}), Seen: append(r.Seen, r.Acc)}
	}
	return MainResult{Appended: accumulator, Snocs: accumulator2, Combined: accumulator3, Escaping: accumulator4.Seen}
}

func main() {
	fmt.Println(main_)
}
