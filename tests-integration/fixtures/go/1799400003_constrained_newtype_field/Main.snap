// Data/Either/either.go
package either

type EitherString struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringLeft = iota
	EitherStringRight
)

type EitherInt struct {
	Field0 int32
	Tag    uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type IntFailure struct {
	Failed bool
	Left   int
}

type StringFailure struct {
	Failed bool
	Left   string
}

// main.go
package main

import (
	"fixture/Data/Either"
	journal "fixture/Journal_ffi"
	"strconv"
)

type ParserProblemInt func(int) (int, either.StringFailure)

type ParserCodeInt func(int) (int, either.IntFailure)

func main() {
	i, err := positiveProblem(0)
	var result string
	if err.Failed {
		result = "problem: " + err.Left
	} else {
		result = strconv.Itoa(i)
	}
	journal.Log(result)
	i2, err := positiveProblem(3)
	var result2 string
	if err.Failed {
		result2 = "problem: " + err.Left
	} else {
		result2 = strconv.Itoa(i2)
	}
	journal.Log(result2)
	i3, err2 := positiveCode(-1)
	var result3 string
	if err2.Failed {
		result3 = "code " + strconv.Itoa(err2.Left)
	} else {
		result3 = strconv.Itoa(i3)
	}
	journal.Log(result3)
}

var positiveProblem ParserProblemInt = func(n int) (int, either.StringFailure) {
	if n > 0 {
		return n, either.StringFailure{}
	}
	return 0, either.StringFailure{Failed: true, Left: "end"}
}

var positiveCode ParserCodeInt = func(n int) (int, either.IntFailure) {
	if n > 0 {
		return n, either.IntFailure{}
	}
	return 0, either.IntFailure{Failed: true, Left: 404}
}
