// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"math"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	return shared.MainResult{Steps: walk(0, 27), Halved: halve(0, 64.0), Even: isEven(100000)}
}

func walkOrHalve(step int, steps int32, n int32, x float64) int32 {
	for {
		switch step {
		case shared.WalkStep:
			if n <= 1 {
				return steps
			}
			if n%2 == 0 {
				step, steps, x = shared.HalveStep, steps+1, float64(n)
				continue
			}
			steps, n = steps+1, 3*n+1
		default: // shared.HalveStep
			x2 := prim.NumberFloor(x / 2.0)
			var result int32
			if !prim.NumberIsFinite(x2) {
				result = 0
			} else if !(x2 < float64(int32(prim.TopInt))) {
				result = int32(prim.TopInt)
			} else if x2 <= float64(int32(prim.BottomInt)) {
				result = int32(prim.BottomInt)
			} else {
				var integer maybe.Int
				if math.Trunc(x2) == x2 && (x2 >= math.MinInt32 && x2 <= math.MaxInt32) {
					integer = maybe.Int(int32(x2))
				} else {
					integer = maybe.NoInt
				}
				if integer == maybe.NoInt {
					result = 0
				} else {
					result = int32(integer)
				}
			}
			step, n = shared.WalkStep, result
		}
	}
}

func walk(steps int32, n int32) int32 {
	return walkOrHalve(shared.WalkStep, steps, n, 0)
}

func halve(steps int32, x float64) int32 {
	return walkOrHalve(shared.HalveStep, steps, 0, x)
}

func isEvenOrIsOdd(step int, k int32) bool {
	for {
		switch step {
		case shared.IsEvenStep:
			switch k {
			case 0:
				return true
			default:
				step, k = shared.IsOddStep, k-1
				continue
			}
		default: // shared.IsOddStep
			switch k {
			case 0:
				return false
			default:
				step, k = shared.IsEvenStep, k-1
				continue
			}
		}
	}
}

func isEven(k int32) bool {
	return isEvenOrIsOdd(shared.IsEvenStep, k)
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Halved int32
	Steps  int32
	Even   bool
}

const (
	WalkStep = iota
	HalveStep
)

const (
	IsEvenStep = iota
	IsOddStep
)

// note: the entry's value of type { even, halved, steps } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
