		read = foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemRight, Right: decoded}
	} else {
		performed := direct.CatchException(func(x exception.Error) either.EitherErrorForeign {
			return either.EitherErrorForeign{Tag: either.EitherErrorForeignLeft, Left: x}
		}, func() either.EitherErrorForeign {
			argument := foreignvalue.ParseJSON("[{\"id\":1,\"name\":\"a\",\"label\":null,\"tags\":[true,null],\"extra\":{}}]")
			return either.EitherErrorForeign{Tag: either.EitherErrorForeignRight, Right: argument}
		})
		var result2 foreign.EitherNonEmptyListForeignErrorArrayItem
		switch performed.Tag {
		case either.EitherErrorForeignLeft:
			result2 = foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorForeignError, ForeignError: exception.Message(performed.Left)}, Second: foreign.SharedListForeignErrorNil}}
		default: // either.EitherErrorForeignRight
			r := performed.Right
			if foreignvalue.IsArray(r) {
				array := r.([]any)
				accumulator := foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemRight, Right: maybe.MemptyItem}
				accumulator.Right = slices.Clip(accumulator.Right)
				for index, element := range array {
					elem := json.ReadAtIdxItem(int32(index), element)
					if accumulator.Tag == foreign.EitherNonEmptyListForeignErrorArrayItemLeft && elem.Tag == foreign.EitherNonEmptyListForeignErrorItemLeft {
						accumulator = foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemLeft, Left: foreign.NonEmptyListForeignError{First: accumulator.Left.First, Second: json.MainGoReusing(&foreign.ListForeignError{Cons0: elem.Left.First, Cons1: elem.Left.Second}, json.MainGo(foreign.SharedListForeignErrorNil, accumulator.Left.Second))}}
					} else if accumulator.Tag == foreign.EitherNonEmptyListForeignErrorArrayItemLeft && elem.Tag == foreign.EitherNonEmptyListForeignErrorItemRight {
						accumulator = foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemLeft, Left: accumulator.Left}
					} else if accumulator.Tag == foreign.EitherNonEmptyListForeignErrorArrayItemRight && elem.Tag == foreign.EitherNonEmptyListForeignErrorItemRight {
						accumulator = foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemRight, Right: arraypkg.Bounded(append(accumulator.Right, elem.Right))}
					} else {
						accumulator = foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemLeft, Left: elem.Left}
					}
				}
				result2 = accumulator
			} else {
				result2 = foreign.EitherNonEmptyListForeignErrorArrayItem{Tag: foreign.EitherNonEmptyListForeignErrorArrayItemLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "array", TypeMismatch1: foreignvalue.TagOf(r)}, Second: foreign.SharedListForeignErrorNil}}
			}
		}
		read = result2
	}
	var result []string
	switch read.Tag {
	case foreign.EitherNonEmptyListForeignErrorArrayItemLeft:
		result = []string{"rejected"}
	default: // foreign.EitherNonEmptyListForeignErrorArrayItemRight
		result = []string{foreignvalue.Encode(maybe.EncodeJSONArrayItem, read.Right)}
	}
	return result
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

