func MapFunctionChunkedRevMapReverseUnrolledMap3(i int, list *ListListForeignError, acc *ListForeignError) *ListForeignError {
	var foreignErrorCells alloc.Cells[ForeignError]
	var listForeignErrorCells alloc.Cells[ListForeignError]
	for {
		if list != SharedListListForeignErrorNil && list.Cons0 != SharedListForeignErrorNil && list.Cons0.Cons1 != SharedListForeignErrorNil && list.Cons0.Cons1.Cons1 != SharedListForeignErrorNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtIndex, ErrorAtIndex0: i, ErrorAtIndex1: x1}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtIndex, ErrorAtIndex0: i, ErrorAtIndex1: x2}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtIndex, ErrorAtIndex0: i, ErrorAtIndex1: x3}), Cons1: acc})})})
			continue
		}
		return acc
