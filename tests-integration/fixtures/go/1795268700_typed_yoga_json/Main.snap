// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Foreign"
	"fixture/Yoga/JSON"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	scrutinee := json.ReadJSONArrayItem("[{\"id\":1,\"name\":\"a\",\"label\":null,\"tags\":[true,null],\"extra\":{}}]")
	var result []string
	switch scrutinee.Tag {
	case foreign.EitherNonEmptyListForeignErrorArrayItemLeft:
		result = []string{"rejected"}
	default: // foreign.EitherNonEmptyListForeignErrorArrayItemRight
		result = []string{foreignvalue.Encode(maybe.EncodeJSONArrayItem, scrutinee.Right)}
	}
	return result
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

