func ReadImplObject(a any) (*struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int32
}, foreign.NonEmptyFailure) {
	if foreignvalue.TagOf(a) == "Object" {
		xs := object.ToArrayWithKey(func(s string, either foreign.EitherInt) foreign.TupleString {
			return foreign.TupleString{First: s, Second: either}
		}, object.MapWithKey(a.(*struct {
			Index map[string]int
