				hasId = true
			case "label":
				if d.Null() {
					label = nil
				} else {
					label = nullable.NotNull(d.Number())
				}
				hasLabel = true
			case "name":
				name = d.String()
				hasName = true
			case "note":
				if d.Null() {
					note = maybe.NoString
				} else {
