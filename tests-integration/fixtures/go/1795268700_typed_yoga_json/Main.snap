func DecodeJSONObjectInt(d *foreignvalue.Decoder) *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int32
} {
	var keys []string
	var values []int32
	if d.Object() {
		for {
			keys = append(keys, d.Key())
			values = append(values, d.Int())
			if !d.MoreMembers() {
				break
			}
		}
	}
	return object.FromEntries(keys, values)
}

func DecodeJSONArrayMaybeBoolean(d *foreignvalue.Decoder) []maybe.Boolean {
	items := []maybe.Boolean{}
	if d.Array() {
		for {
			var optional maybe.Boolean
			if d.Null() {
				optional = maybe.NoBoolean
			} else {
				optional = maybe.JustBoolean(d.Boolean())
			}
			items = append(items, optional)
			if !d.MoreElements() {
				break
			}
		}
	}
	return arraypkg.Bounded(slices.Clip(items))
}

func DecodeJSONItem(d *foreignvalue.Decoder) maybe.Item {
	var extra *struct {
		Index map[string]int
		Ints  int
		Keys  []string
		Vals  []int32
	}
	hasExtra := false
	var id int32
	hasId := false
	var label *float64
	hasLabel := false
	var name string
	hasName := false
	note := maybe.NoString
	var tags []maybe.Boolean
	hasTags := false
	if d.Object() {
		for {
			switch d.Key() {
			case "extra":
				extra = DecodeJSONObjectInt(d)
				hasExtra = true
			case "id":
				id = d.Int()
				hasId = true
			case "label":
				if d.Null() {
					label = nil
				} else {
					label = nullable.NotNull(d.Number())
				}
				hasLabel = true
			case "name":
				name = d.String()
				hasName = true
			case "note":
				if d.Null() {
					note = maybe.NoString
				} else {
					note = maybe.JustString(d.String())
				}
			case "tags":
				tags = DecodeJSONArrayMaybeBoolean(d)
				hasTags = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasExtra || !hasId || !hasLabel || !hasName || !hasTags {
		d.Fail()
	}
	return maybe.Item{Extra: extra, Id: id, Label: label, Name: name, Note: note, Tags: tags}
}

func DecodeJSONArrayItem(d *foreignvalue.Decoder) []maybe.Item {
	items := []maybe.Item{}
	if d.Array() {
		for {
			items = append(items, DecodeJSONItem(d))
			if !d.MoreElements() {
				break
			}
		}
	}
	return arraypkg.Bounded(slices.Clip(items))
}

func ReadJSON(text string) ([]maybe.Item, foreign.NonEmptyFailure) {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONArrayItem)
	if ok {
		return decoded, foreign.NonEmptyFailure{}
	}
	performed := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		argument := foreignvalue.ParseJSON(text)
		return either.Either{Tag: either.EitherRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherLeft:
		return nil, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherRight
		r := performed.Right
		if foreignvalue.IsArray(r) {
			array := r.([]any)
			array_ := maybe.MemptyItem
			var err foreign.NonEmptyFailure
			array_ = slices.Clip(array_)
			for index, element := range array {
				elem := foreign.EitherItemFromResults(ReadAtIdxItem(int32(index), element))
				if err.Failed && elem.Tag == foreign.EitherItemLeft {
					err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: err.Left.First, Second: ReadJSONGoArrayItemReusing(foreign.Cons(elem.Left.First, elem.Left.Second), ReadJSONGoArrayItem(foreign.SharedListForeignErrorNil, err.Left.Second))}}
				} else if err.Failed && elem.Tag == foreign.EitherItemRight {
				} else if !err.Failed && elem.Tag == foreign.EitherItemRight {
					array_, err = arraypkg.Bounded(append(array_, elem.Right)), foreign.NonEmptyFailure{}
				} else {
					err = foreign.NonEmptyFailure{Failed: true, Left: elem.Left}
				}
			}
			return array_, err
		}
		return nil, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("array", foreignvalue.TagOf(r)), Second: foreign.SharedListForeignErrorNil}}
	}
}

