			Keys  []string
			Vals  []any
		}), func(key string, value any) foreign.EitherInt {
			error_ := foreign.LeftEitherInt(foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(value)), Second: foreign.SharedListForeignErrorNil})
			var result foreign.EitherInt
			if foreignvalue.TagOf(value) == "Number" {
				number := foreignvalue.Number(value)
				var integer maybe.Int
				if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
					integer = maybe.Int(int32(number))
				} else {
					integer = maybe.NoInt
				}
				if integer == maybe.NoInt {
					result = error_
				} else {
					result = foreign.RightEitherInt(int32(integer))
				}
			} else {
				result = error_
			}
			switch result.Tag {
			case foreign.EitherIntLeft:
				return foreign.LeftEitherInt(foreign.MapFunction(key, result.Left))
			default: // foreign.EitherIntRight
				return foreign.RightEitherInt(result.Right)
			}
		}))
		len_ := int32(len(xs))
		array := arraypkg.Unfoldr(func(value foreign.MaybeTupleTupleStringEitherNonEmptyListForeignErrorIntInt) bool {
			return value.Tag == maybe.TagNothing
		}, func(value foreign.MaybeTupleTupleStringEitherNonEmptyListForeignErrorIntInt) foreign.TupleTupleStringEitherNonEmptyListForeignErrorInt {
			return value.Just
		}, func(value foreign.TupleTupleStringEitherNonEmptyListForeignErrorInt) foreign.TupleString {
			return value.First
		}, func(value foreign.TupleTupleStringEitherNonEmptyListForeignErrorInt) int32 {
			return value.Second
		}, func(i int32) foreign.MaybeTupleTupleStringEitherNonEmptyListForeignErrorIntInt {
			if i < len_ {
				return foreign.JustTupleTupleStringEitherNonEmptyListForeignErrorIntInt(foreign.TupleTupleStringEitherNonEmptyListForeignErrorInt{First: xs[i], Second: i + 1})
			}
			return foreign.NoTupleTupleStringEitherNonEmptyListForeignErrorIntInt
		}, int32(0))
		object_ := object.Empty[int32]()
		var err foreign.NonEmptyFailure
		object_ = object.Lend(object_)
		for tupleIndex := range array {
			if err.Failed && array[tupleIndex].Second.Tag == foreign.EitherIntLeft {
				err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: err.Left.First, Second: ReadJSONGoArrayItemReusing(foreign.Cons(array[tupleIndex].Second.Left.First, array[tupleIndex].Second.Left.Second), ReadJSONGoArrayItem(foreign.SharedListForeignErrorNil, err.Left.Second))}}
			} else if err.Failed && array[tupleIndex].Second.Tag == foreign.EitherIntRight {
			} else if !err.Failed && array[tupleIndex].Second.Tag == foreign.EitherIntRight {
				object_, err = object.InsertOwned(array[tupleIndex].First, array[tupleIndex].Second.Right, object_), foreign.NonEmptyFailure{}
			} else {
				err = foreign.NonEmptyFailure{Failed: true, Left: array[tupleIndex].Second.Left}
			}
		}
		return object_, err
	}
	return nil, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Object", foreignvalue.TagOf(a)), Second: foreign.SharedListForeignErrorNil}}
}

func ReadAtIdxMaybeBoolean(i int32, f any) (maybe.Boolean, foreign.NonEmptyFailure) {
	if foreignvalue.IsNull(f) || foreignvalue.IsUndefined(f) {
		return maybe.NoBoolean, foreign.NonEmptyFailure{}
