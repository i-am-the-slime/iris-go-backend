// Data/Maybe/maybe.go
package maybe

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/nullable"
	"github.com/i-am-the-slime/iris-go/object"
	"slices"
)

const TagNothing = 0

const TagJust = 1

type String struct {
	Just string
	Tag  uint8
}

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

type Item struct {
	Extra *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int32
}
	Label *float64
	Name  string
	Note  String
	Tags  []Boolean
	Id    int32
}

func DecodeJSONObjectInt(d *foreignvalue.Decoder) *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int32
} {
	var keys []string
	var values []int32
	if d.Object() {
		for {
			keys = append(keys, d.Key())
			values = append(values, d.Int())
			if !d.MoreMembers() {
				break
			}
		}
	}
	return object.FromEntries(keys, values)
}

var NoString = String{Tag: TagNothing}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

func JustBoolean(just bool) Boolean {
	if just {
		return True
	}
	return False
}

func DecodeJSONArrayMaybeBoolean(d *foreignvalue.Decoder) []Boolean {
	items := []Boolean{}
	if d.Array() {
		for {
			var optional Boolean
			if d.Null() {
				optional = NoBoolean
			} else {
				optional = JustBoolean(d.Boolean())
			}
			items = append(items, optional)
			if !d.MoreElements() {
				break
			}
		}
	}
	return array.Bounded(slices.Clip(items))
}

func DecodeJSONItem(d *foreignvalue.Decoder) Item {
	var extra *struct {
		Index map[string]int
		Ints  int
		Keys  []string
		Vals  []int32
	}
	hasExtra := false
	var id int32
	hasId := false
	var label *float64
	hasLabel := false
	var name string
	hasName := false
	note := NoString
	var tags []Boolean
	hasTags := false
	if d.Object() {
		for {
			switch d.Key() {
			case "extra":
				extra = DecodeJSONObjectInt(d)
				hasExtra = true
			case "id":
				id = d.Int()
				hasId = true
			case "label":
				if d.Null() {
					label = nil
				} else {
					label = nullable.NotNull(d.Number())
				}
				hasLabel = true
			case "name":
				name = d.String()
				hasName = true
			case "note":
				if d.Null() {
					note = NoString
				} else {
					note = JustString(d.String())
				}
			case "tags":
				tags = DecodeJSONArrayMaybeBoolean(d)
				hasTags = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasExtra || !hasId || !hasLabel || !hasName || !hasTags {
		d.Fail()
	}
	return Item{Extra: extra, Id: id, Label: label, Name: name, Note: note, Tags: tags}
}

func DecodeJSONArrayItem(d *foreignvalue.Decoder) []Item {
	items := []Item{}
	if d.Array() {
		for {
			items = append(items, DecodeJSONItem(d))
			if !d.MoreElements() {
				break
			}
		}
	}
	return array.Bounded(slices.Clip(items))
}

func EncodeJSONArrayMaybeBoolean(e *foreignvalue.Encoder, value []Boolean) {
	e.Raw("[")
	for index, item := range value {
		if index > 0 {
			e.Raw(",")
		}
		if item != NoBoolean {
			e.Boolean(item == True)
		} else {
			e.Raw("null")
		}
	}
	e.Raw("]")
}

func EncodeJSONObjectInt(e *foreignvalue.Encoder, value *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int32
}) {
	e.Raw("{")
	for index, key := range value.Keys {
		member := value.Vals[index]
		e.Key(key)
		e.Int(member)
	}
	e.Raw("}")
}

func EncodeJSONItem(e *foreignvalue.Encoder, value Item) {
	e.Raw("{\"tags\":")
	EncodeJSONArrayMaybeBoolean(e, value.Tags)
	note := value.Note
	if note.Tag == TagJust {
		e.Raw(",\"note\":")
		e.String(note.Just)
	}
	e.Raw(",\"name\":")
	e.String(value.Name)
	e.Raw(",\"label\":")
	optional := value.Label
	if optional == nil {
		e.Raw("null")
	} else {
		e.Number(*optional)
	}
	e.Raw(",\"id\":")
	e.Int(value.Id)
	e.Raw(",\"extra\":")
	EncodeJSONObjectInt(e, value.Extra)
	e.Raw("}")
}

func EncodeJSONArrayItem(e *foreignvalue.Encoder, value []Item) {
	e.Raw("[")
	for index, item := range value {
		if index > 0 {
			e.Raw(",")
		}
		EncodeJSONItem(e, item)
	}
	e.Raw("]")
}

type Int int64

const NoInt Int = 1 << 32

type IdLabelNameNoteTags struct {
	Label *float64
	Name  string
	Note  String
	Tags  []Boolean
	Id    int32
}

type LabelNameNoteTags struct {
	Label *float64
	Name  string
	Note  String
	Tags  []Boolean
}

type NameNoteTags struct {
	Name string
	Note String
	Tags []Boolean
}

type Foreign struct {
	Just any
	Tag  uint8
}

var NoForeign = Foreign{Tag: TagNothing}

type NoteTags struct {
	Note String
	Tags []Boolean
}

type Tags struct {
	Tags []Boolean
}

type Maybe struct {
	Just any
	Tag  uint8
}

var MemptyItem []Item = []Item{}

func IsNothing(maybe *Maybe) bool {
	switch maybe.Tag {
	case TagNothing:
		return true
	default: // TagJust
		return false
	}
}

func FromJust(maybe *Maybe) any {
	switch maybe.Tag {
	case TagJust:
		return maybe.Just
	default:
		panic("Failed pattern match")
	}
}

var MemptyMaybeBoolean []Boolean = []Boolean{}

// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  any
	Second any
}

func Fst(tuple *Tuple) any {
	return tuple.First
}

func Snd(tuple *Tuple) any {
	return tuple.Second
}

