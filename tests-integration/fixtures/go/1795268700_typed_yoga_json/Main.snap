// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type Either struct {
	Left  exception.Error
	Right any
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Left(left exception.Error) Either {
	return Either{Tag: EitherLeft, Left: left}
}

// Data/Maybe/maybe.go
package maybe

import (
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/object"
)

const TagNothing = 0

const TagJust = 1

type String struct {
	Just string
	Tag  uint8
}

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

type Item struct {
	Extra *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int32
}
	Label *float64
	Name  string
	Note  String
	Tags  []Boolean
	Id    int32
}

func EncodeJSONArrayMaybeBoolean(e *foreignvalue.Encoder, value []Boolean) {
	e.Raw("[")
	for index, item := range value {
		if index > 0 {
			e.Raw(",")
		}
		if item != NoBoolean {
			e.Boolean(item == True)
		} else {
			e.Raw("null")
		}
	}
	e.Raw("]")
}

func EncodeJSONObjectInt(e *foreignvalue.Encoder, value *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int32
}) {
	e.Raw("{")
	for key, member := range object.Entries(value) {
		e.Key(key)
		e.Int(member)
	}
	e.Raw("}")
}

func EncodeJSONItem(e *foreignvalue.Encoder, value Item) {
	e.Raw("{\"tags\":")
	EncodeJSONArrayMaybeBoolean(e, value.Tags)
	note := value.Note
	if note.Tag == TagJust {
		e.Raw(",\"note\":")
		e.String(note.Just)
	}
	e.Raw(",\"name\":")
	e.String(value.Name)
	e.Raw(",\"label\":")
	optional := value.Label
	if optional == nil {
		e.Raw("null")
	} else {
		e.Number(*optional)
	}
	e.Raw(",\"id\":")
	e.Int(value.Id)
	e.Raw(",\"extra\":")
	EncodeJSONObjectInt(e, value.Extra)
	e.Raw("}")
}

func EncodeJSONArrayItem(e *foreignvalue.Encoder, value []Item) {
	e.Raw("[")
	for index, item := range value {
		if index > 0 {
			e.Raw(",")
		}
		EncodeJSONItem(e, item)
	}
	e.Raw("]")
}

var NoString = String{Tag: TagNothing}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

func JustBoolean(just bool) Boolean {
	if just {
		return True
	}
	return False
}

type IdLabelNameNoteTags struct {
	Label *float64
	Name  string
	Note  String
	Tags  []Boolean
	Id    int32
}

type LabelNameNoteTags struct {
	Label *float64
	Name  string
	Note  String
	Tags  []Boolean
}

type Int int64

const NoInt Int = 1 << 32

type NameNoteTags struct {
	Name string
	Note String
	Tags []Boolean
}

type Foreign struct {
	Just any
	Tag  uint8
}

var NoForeign = Foreign{Tag: TagNothing}

type NoteTags struct {
	Note String
	Tags []Boolean
}

type Tags struct {
	Tags []Boolean
}

type Maybe struct {
	Just any
	Tag  uint8
}

var MemptyItem []Item = []Item{}

func IsNothing(maybe *Maybe) bool {
	switch maybe.Tag {
	case TagNothing:
		return true
	default: // TagJust
		return false
	}
}

func FromJust(maybe *Maybe) any {
	switch maybe.Tag {
	case TagJust:
		return maybe.Just
	default:
		panic("Failed pattern match")
	}
}

var MemptyMaybeBoolean []Boolean = []Boolean{}

