	if foreignvalue.TagOf(f) == "Boolean" {
		return maybe.JustBoolean(f.(bool)), foreign.NonEmptyFailure{}
	}
	return 0, foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction3(i, foreign.NonEmpty{First: foreign.TypeMismatch("Boolean", foreignvalue.TagOf(f)), Second: foreign.SharedListForeignErrorNil})}
}

func ReadJSONGoArrayItem(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	var listForeignErrorCells alloc.Cells[foreign.ListForeignError]
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		acc, list = listForeignErrorCells.New(foreign.ListForeignError{Cons0: x, Cons1: acc}), xs
	}
}

func ReadImplB(x maybe.Foreign) (*float64, foreign.NonEmptyFailure) {
	switch x.Tag {
	case maybe.TagNothing:
		return nullable.Null[float64](), foreign.NonEmptyFailure{}
	default: // maybe.TagJust
