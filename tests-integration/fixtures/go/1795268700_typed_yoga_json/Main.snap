// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Yoga/JSON"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array_, err := json.ReadJSON("[{\"id\":1,\"name\":\"a\",\"label\":null,\"tags\":[true,null],\"extra\":{}}]")
	var result []string
	if err.Failed {
		result = []string{"rejected"}
	} else {
		result = []string{foreignvalue.Encode(maybe.EncodeJSONArrayItem, array_)}
	}
	return result
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

