// Yoga/JSON/json.go
package json

import (
	"fixture/Data/Maybe"
	"fixture/Foreign"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/nullable"
	"github.com/i-am-the-slime/iris-go/object"
	"math"
	"slices"
)

func ReadAtIdxItem(i int32, f any) foreign.EitherNonEmptyListForeignErrorItem {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
		return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(f)}, Second: foreign.SharedListForeignErrorNil}}
	}, foreign.PureIdentityNonEmptyListForeignError, "extra", f)
	var result2 foreign.EitherNonEmptyListForeignErrorObjectInt
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherNonEmptyListForeignErrorForeignLeft:
		result2 = foreign.EitherNonEmptyListForeignErrorObjectInt{Tag: foreign.EitherNonEmptyListForeignErrorObjectIntLeft, Left: unsafeReadPropImpl.Left}
	default: // foreign.EitherNonEmptyListForeignErrorForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "Object" {
			xs := object.ToArrayWithKey(func(s string, either foreign.EitherNonEmptyListForeignErrorInt) foreign.TupleStringEitherNonEmptyListForeignErrorInt {
				return foreign.TupleStringEitherNonEmptyListForeignErrorInt{First: s, Second: either}
			}, object.MapWithKey(b.(*struct {
				Index map[string]int
				Ints  int
				Keys  []string
				Vals  []any
			}), func(key string, value any) foreign.EitherNonEmptyListForeignErrorInt {
				error_ := foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Int", TypeMismatch1: foreignvalue.TagOf(value)}, Second: foreign.SharedListForeignErrorNil}}
				var result3 foreign.EitherNonEmptyListForeignErrorInt
				if foreignvalue.TagOf(value) == "Number" {
					number := value.(float64)
					var integer maybe.Int
					if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
						integer = maybe.Int(int32(number))
					} else {
						integer = maybe.NoInt
					}
					if integer == maybe.NoInt {
						result3 = error_
					} else {
						result3 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntRight, Right: int32(integer)}
					}
				} else {
					result3 = error_
				}
				switch result3.Tag {
				case foreign.EitherNonEmptyListForeignErrorIntLeft:
