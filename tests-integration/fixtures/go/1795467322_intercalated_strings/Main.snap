// Data/Monoid/monoid.go
package monoid

var Mempty []int = []int{}

// Data/Show/show.go
package show

import "strconv"

func Show(i int) string {
	return strconv.Itoa(i)
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Monoid"
	"fixture/Data/Show"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := [][]int{{1}, {2, 3}}
	accumulator := shared.AccInit{Init: true, Acc: monoid.Mempty}
	for _, x := range array {
		if accumulator.Init {
			accumulator = shared.AccInit{Init: false, Acc: x}
		} else {
			accumulator = shared.AccInit{Init: false, Acc: arraypkg.Append(accumulator.Acc, arraypkg.Append([]int{0}, x))}
		}
	}
	return []string{prim.StringJoinWith(", ", []string{"a", "b", "c"}), prim.StringJoinWith("-", []string{"x"}), show.ArrayInt(accumulator.Acc)}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type AccInit struct {
	Acc  []int
	Init bool
}
