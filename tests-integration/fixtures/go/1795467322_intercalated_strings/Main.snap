// Data/Monoid/monoid.go
package monoid

var Mempty []int = []int{}

// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Monoid"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	scrutinee := shared.AccInit{Init: true, Acc: monoid.Mempty}
	var result2 shared.AccInit
	if scrutinee.Init {
		result2 = shared.AccInit{Init: false, Acc: []int{1}}
	} else {
		result2 = shared.AccInit{Init: false, Acc: array.Append(scrutinee.Acc, []int{0, 1})}
	}
	var result shared.AccInit
	if result2.Init {
		result = shared.AccInit{Init: false, Acc: []int{2, 3}}
	} else {
		result = shared.AccInit{Init: false, Acc: array.Append(result2.Acc, []int{0, 2, 3})}
	}
	return []string{prim.StringJoinWith(", ", []string{"a", "b", "c"}), prim.StringJoinWith("-", []string{"x"}), show.ArrayInt(result.Acc)}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type AccInit struct {
	Acc  []int
	Init bool
}
