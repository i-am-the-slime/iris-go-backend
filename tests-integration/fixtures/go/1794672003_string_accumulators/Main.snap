// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	accumulator := []byte("start:")
	for i := int32(1); i < 13; i++ {
		accumulator = append(accumulator, prim.ShowInt(i)...)
	}
	built := string(accumulator)
	accumulator2 := ""
	for i := int32(1); i < 11; i++ {
		acc := accumulator2
		if prim.CodeUnitLengthUpTo(6, acc) > 5 {
			accumulator2 = acc
		} else {
			accumulator2 = acc + prim.ShowInt(i)
		}
	}
	accumulator3 := ""
	for i := int32(1); i < 6; i++ {
		accumulator3 = prim.ShowInt(i) + accumulator3
	}
	return shared.MainResult{Fold: built, Loop: mainGo(0, ""), Exit: mainGo2(0, "x"), ReadInFold: accumulator2, ReadInLoop: mainGo3(0, ""), Prepended: accumulator3}
}

func mainGo(i int32, acc string) string {
	accBytes := []byte(acc)
	for {
		if i >= 10 {
			return string(accBytes)
		}
		if prim.IntMod(i, 3) == 0 {
			i = i + 1
			continue
		}
		i, accBytes = i + 1, append(accBytes, "é"...)
	}
}

func mainGo2(i int32, acc string) int32 {
	accBytes := []byte(acc)
	for {
		if i >= 5 {
			return prim.CodeUnitLength(string(accBytes))
		}
		i, accBytes = i + 1, append(accBytes, "yz"...)
	}
}

func mainGo3(i int32, acc string) string {
	for {
		if i >= 12 {
			return acc
		}
		i, acc = i + 1, acc + prim.ShowInt(prim.CodeUnitLength(acc))
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	Fold       string
	Loop       string
	Prepended  string
	ReadInFold string
	ReadInLoop string
	Exit       int32
}
