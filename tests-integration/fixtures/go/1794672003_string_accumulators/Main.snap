// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type ExitFoldLoopPrependedReadInFoldReadInLoop struct {
	Exit       int32
	Fold       string
	Loop       string
	Prepended  string
	ReadInFold string
	ReadInLoop string
}

var main_ = initializeMain_()

func initializeMain_() ExitFoldLoopPrependedReadInFoldReadInLoop {
	accumulator := []byte("start:")
	for i := int32(1); i < 13; i++ {
		acc := accumulator
		accumulator = append(acc, prim.ShowInt(i)...)
	}
	built := string(accumulator)
	accumulator2 := ""
	for i2 := int32(1); i2 < 11; i2++ {
		acc2 := accumulator2
		if prim.CodeUnitLengthUpTo(6, acc2) > 5 {
			accumulator2 = acc2
		} else {
			accumulator2 = acc2 + prim.ShowInt(i2)
		}
	}
	accumulator3 := ""
	for i3 := int32(1); i3 < 6; i3++ {
		acc3 := accumulator3
		accumulator3 = prim.ShowInt(i3) + acc3
	}
	return ExitFoldLoopPrependedReadInFoldReadInLoop{Fold: built, Loop: mainGo(0, ""), Exit: mainGo2(0, "x"), ReadInFold: accumulator2, ReadInLoop: mainGo3(0, ""), Prepended: accumulator3}
}

func mainGo(i int32, acc string) string {
	accBytes := []byte(acc)
	for {
		if i >= 10 {
			return string(accBytes)
		}
		if prim.IntMod(i, 3) == 0 {
			i = i + 1
			continue
		}
		i, accBytes = i + 1, append(accBytes, "é"...)
	}
}

func mainGo2(i int32, acc string) int32 {
	accBytes := []byte(acc)
	for {
		if i >= 5 {
			return prim.CodeUnitLength(string(accBytes))
		}
		i, accBytes = i + 1, append(accBytes, "yz"...)
	}
}

func mainGo3(i int32, acc string) string {
	for {
		if i >= 12 {
			return acc
		}
		i, acc = i + 1, acc + prim.ShowInt(prim.CodeUnitLength(acc))
	}
}

func main() {
	fmt.Println(main_)
}
