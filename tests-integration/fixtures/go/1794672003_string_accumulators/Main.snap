// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	accumulator := []byte("start:")
	for i := 1; i < 13; i++ {
		accumulator = strconv.AppendInt(accumulator, int64(i), 10)
	}
	built := string(accumulator)
	accumulator2 := []byte(nil)
	for i := 1; i < 13; i++ {
		accumulator2 = strconv.AppendInt(accumulator2, int64(i), 10)
		accumulator2 = append(accumulator2, ',')
	}
	built2 := string(accumulator2)
	accumulator3 := []byte(nil)
	for i := 1; i < 6; i++ {
		accumulator3 = append(accumulator3, '<')
		accumulator3 = strconv.AppendInt(accumulator3, int64(i), 10)
		accumulator3 = append(accumulator3, '>')
	}
	built3 := string(accumulator3)
	accumulator4 := ""
	for i := 1; i < 11; i++ {
		if !(prim.CodeUnitLengthUpTo(6, accumulator4) > 5) {
			accumulator4 += strconv.Itoa(i)
		}
	}
	accumulator5 := ""
	for value := 1; value < 7; value++ {
		accumulator5 = accumulator5 + strconv.Itoa(prim.CodeUnitLength(accumulator5)) + ","
	}
	accumulator6 := ""
	for i := 1; i < 6; i++ {
		accumulator6 = strconv.Itoa(i) + accumulator6
	}
	accumulator7 := ""
	for i := 1; i < 5; i++ {
		accumulator7 = "[" + accumulator7 + strconv.Itoa(i) + "]"
	}
	return []string{built, mainGo(0, ""), strconv.Itoa(mainGo2(0, "x")), built2, mainGo3(0, ""), built3, accumulator4, mainGo4(0, ""), accumulator5, accumulator6, accumulator7}
}

func mainGo(i int, acc string) string {
	accBytes := []byte(acc)
	for {
		if i >= 10 {
			return string(accBytes)
		}
		if i%3 == 0 {
			i += 1
			continue
		}
		accBytes = append(accBytes, "é"...)
		i += 1
	}
}

func mainGo2(i int, acc string) int {
	accBytes := []byte(acc)
	for {
		if i >= 5 {
			return prim.CodeUnitLength(string(accBytes))
		}
		accBytes = append(accBytes, "yz"...)
		i += 1
	}
}

func mainGo3(i int, acc string) string {
	accBytes := []byte(acc)
	for {
		if i >= 12 {
			return string(accBytes)
		}
		accBytes = strconv.AppendInt(accBytes, int64(i), 10)
		accBytes = append(accBytes, ';')
		i += 1
	}
}

func mainGo4(i int, acc string) string {
	for {
		if i >= 12 {
			return acc
		}
		i, acc = i+1, acc+strconv.Itoa(prim.CodeUnitLength(acc))
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
