// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	accumulator := []byte("start:")
	for i := int32(1); i < 13; i++ {
		accumulator = append(accumulator, strconv.Itoa(int(i))...)
	}
	built := string(accumulator)
	accumulator2 := ""
	for i := int32(1); i < 11; i++ {
		if !(prim.CodeUnitLengthUpTo(6, accumulator2) > 5) {
			accumulator2 += strconv.Itoa(int(i))
		}
	}
	accumulator3 := ""
	for i := int32(1); i < 6; i++ {
		accumulator3 = strconv.Itoa(int(i)) + accumulator3
	}
	return shared.MainResult{Fold: built, Loop: mainGo(0, ""), Exit: mainGo2(0, "x"), ReadInFold: accumulator2, ReadInLoop: mainGo3(0, ""), Prepended: accumulator3}
}

func mainGo(i int32, acc string) string {
	accBytes := []byte(acc)
	for {
		if i >= 10 {
			return string(accBytes)
		}
		if i%3 == 0 {
			i += 1
			continue
		}
		i, accBytes = i+1, append(accBytes, "é"...)
	}
}

func mainGo2(i int32, acc string) int32 {
	accBytes := []byte(acc)
	for {
		if i >= 5 {
			return prim.CodeUnitLength(string(accBytes))
		}
		i, accBytes = i+1, append(accBytes, "yz"...)
	}
}

func mainGo3(i int32, acc string) string {
	for {
		if i >= 12 {
			return acc
		}
		i, acc = i+1, acc+strconv.Itoa(int(prim.CodeUnitLength(acc)))
	}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Fold       string
	Loop       string
	Prepended  string
	ReadInFold string
	ReadInLoop string
	Exit       int32
}

// note: the entry's value of type { exit, fold, loop, prepended, readInFold, readInLoop } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
