// Data/Monoid/Endo/endo.go
package endo

func MemptyFnInt(x int32) int32 {
	return x
}

// main.go
package main

import (
	"fixture/Data/Monoid/Endo"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() int32 {
	defer exception.ReportUncaught()
	array := []int32{1, 2, 3}
	accumulator := endo.MemptyFnInt
	for index := len(array) - 1; index >= 0; index-- {
		x := array[index]
		acc := accumulator
		accumulator = func(x2 int32) int32 {
			return acc(x2)*10 + x
		}
	}
	return accumulator(0)
}

func main() {
	fmt.Println(main_)
}
