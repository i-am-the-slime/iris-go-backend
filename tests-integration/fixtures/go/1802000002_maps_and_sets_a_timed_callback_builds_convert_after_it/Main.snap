		iter, value = mapIterStringIntCells.New(MapIterString{Tag: MapIterStringIterEmit, IterEmit0: k, IterEmit1: v, IterEmit2: mapIterStringIntCells.New(MapIterString{Tag: MapIterStringIterNode, IterNode0: r, IterNode1: iter})}), l
	}
}

func TreeFromKeys(keys []int, values []int, low int, high int) *MapIntInt {
	var cells alloc.Cells[MapIntInt]
	return TreeFromKeysChunked(keys, values, low, high, &cells)
}

func TreeFromKeysChunked(keys []int, values []int, low int, high int, cells *alloc.Cells[MapIntInt]) *MapIntInt {
	if low == high {
		return SharedMapIntIntLeaf
	}
	var middle int
	var key int
	var count int
	middle = (low + high) >> 1
	key = keys[middle]
	count = high - low
	return cells.New(MapIntInt{Node0: bits.Len(uint(count)), Node1: count, Node2: key, Node3: values[middle], Node4: TreeFromKeysChunked(keys, values, low, middle, cells), Node5: TreeFromKeysChunked(keys, values, middle+1, high, cells)})
}

func TreeFromTable(table map[int]int) *MapIntInt {
	var entries EntriesOfArrayIntArrayInt
	var keys []int
	var values []int
	keys2, values2 := SortedIntegerEntries(table)
	entries = EntriesOfArrayIntArrayInt{Keys: keys2, Values: values2}
	keys = entries.Keys
	values = entries.Values
	return TreeFromKeys(keys, values, 0, len(keys))
}

func TreeFromKeys2(keys []tuple.TupleInt, values []int, low int, high int) *MapTupleIntInt {
	if low == high {
		return SharedMapTupleIntIntLeaf
	}
	var middle int
	var key tuple.TupleInt
	var count int
	middle = (low + high) >> 1
	key = keys[middle]
	count = high - low
	return Node(bits.Len(uint(count)), count, key, values[middle], TreeFromKeys2(keys, values, low, middle), TreeFromKeys2(keys, values, middle+1, high))
}

func TreeFromTable2(table map[tuple.TupleInt]int) *MapTupleIntInt {
	var entries EntriesOfArrayTupleIntIntArrayInt
	var keys []tuple.TupleInt
	var values []int
	keys2, values2 := SortedFieldEntries(table, CompareKeys, func(key tuple.TupleInt) int64 {
		return int64(key.First)
	}, func(key tuple.TupleInt) int64 {
		return int64(key.Second)
	})
	entries = EntriesOfArrayTupleIntIntArrayInt{Keys: keys2, Values: values2}
	keys = entries.Keys
	values = entries.Values
	return TreeFromKeys2(keys, values, 0, len(keys))
}

func TreeFromKeys3(keys []string, values []int, low int, high int) *MapStringInt {
	var cells alloc.Cells[MapStringInt]
	return TreeFromKeys3Chunked(keys, values, low, high, &cells)
}

func TreeFromKeys3Chunked(keys []string, values []int, low int, high int, cells *alloc.Cells[MapStringInt]) *MapStringInt {
	if low == high {
		return SharedMapStringIntLeaf
	}
	var middle int
	var key string
	var count int
	middle = (low + high) >> 1
	key = keys[middle]
	count = high - low
	return cells.New(MapStringInt{Node0: bits.Len(uint(count)), Node1: count, Node2: key, Node3: values[middle], Node4: TreeFromKeys3Chunked(keys, values, low, middle, cells), Node5: TreeFromKeys3Chunked(keys, values, middle+1, high, cells)})
}

func TreeFromTable3(table map[string]int) *MapStringInt {
	var entries EntriesOfArrayStringArrayInt
	var keys []string
	var values []int
	keys2, values2 := SortedStringEntries(table, prim.CompareString)
	entries = EntriesOfArrayStringArrayInt{Keys: keys2, Values: values2}
	keys = entries.Keys
	values = entries.Values
	return TreeFromKeys3(keys, values, 0, len(keys))
}

