}

func TreeFromTable5(table map[string]struct{}) *MapStringUnit {
	var entries EntriesOfArrayStringArrayUnit
	var keys []string
	var values []struct{}
	keys2, values2 := SortedStringEntries(table, prim.CompareString)
	entries = EntriesOfArrayStringArrayUnit{Keys: keys2, Values: values2}
	keys = entries.Keys
	values = entries.Values
	return TreeFromKeys5(keys, values, 0, len(keys))
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Maybe struct {
	Just any
	Tag  uint8
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// Data/Tuple/tuple.go
package tuple

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type TupleInt struct {
	First  int
	Second int
}

type TupleTupleIntInt struct {
	First  TupleInt
	Second int
}

type TupleString struct {
	First  string
	Second int
}

type Tuple struct {
	First  any
	Second any
}

func AppendShowArrayTupleStringInt(buffer []byte, array []TupleString) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowTupleStringInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowTupleStringInt(buffer []byte, tuple TupleString) []byte {
	buffer = append(buffer, "(Tuple "...)
	buffer = prim.AppendShowString(buffer, tuple.First)
	buffer = append(buffer, ' ')
	buffer = strconv.AppendInt(buffer, int64(tuple.Second), 10)
	buffer = append(buffer, ')')
	return buffer
}

func AppendShowArrayTupleTupleIntIntInt(buffer []byte, array []TupleTupleIntInt) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowTupleTupleIntIntInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowTupleTupleIntIntInt(buffer []byte, tuple TupleTupleIntInt) []byte {
	buffer = append(buffer, "(Tuple (Tuple "...)
	buffer = strconv.AppendInt(buffer, int64(tuple.First.First), 10)
	buffer = append(buffer, ' ')
	buffer = strconv.AppendInt(buffer, int64(tuple.First.Second), 10)
	buffer = append(buffer, ')')
	buffer = append(buffer, ' ')
	buffer = strconv.AppendInt(buffer, int64(tuple.Second), 10)
	buffer = append(buffer, ')')
	return buffer
}

func AppendShowArrayTupleIntInt(buffer []byte, array []TupleInt) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowTupleIntInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowTupleIntInt(buffer []byte, tuple TupleInt) []byte {
	buffer = append(buffer, "(Tuple "...)
	buffer = strconv.AppendInt(buffer, int64(tuple.First), 10)
	buffer = append(buffer, ' ')
	buffer = strconv.AppendInt(buffer, int64(tuple.Second), 10)
	buffer = append(buffer, ')')
	return buffer
}

func ArrayTupleStringInt(array []TupleString) string {
	return string(AppendShowArrayTupleStringInt(nil, array))
}

func ArrayTupleTupleIntIntInt(array []TupleTupleIntInt) string {
	return string(AppendShowArrayTupleTupleIntIntInt(nil, array))
}

func ArrayTupleIntInt(array []TupleInt) string {
	return string(AppendShowArrayTupleIntInt(nil, array))
}

