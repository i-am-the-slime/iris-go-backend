type EntriesOfArrayIntArrayInt struct {
	Keys   []int
	Values []int
}

func SortedIntegerEntries[K ~int | ~int32, V any](table map[K]V) ([]K, []V) {
	count := len(table)
	keys := make([]K, 0, count)
	values := make([]V, 0, count)
	for key, value := range table {
		keys = append(keys, key)
		values = append(values, value)
	}
	if count <= 32 {
		for index := 1; index < count; index++ {
			key, value := keys[index], values[index]
			at := index
			for ; at > 0 && keys[at-1] > key; at-- {
				keys[at], values[at] = keys[at-1], values[at-1]
			}
			keys[at], values[at] = key, value
		}
		return keys, values
	}
	lowest, highest := keys[0], keys[0]
	for _, key := range keys {
		lowest = min(lowest, key)
		highest = max(highest, key)
	}
	base := uint64(int64(lowest))
	span := uint64(int64(highest)) - base
	spareKeys := make([]K, count)
	spareValues := make([]V, count)
	for shift := 0; shift < 64 && span>>shift != 0; shift += 8 {
		var starts [256]int
		for _, key := range keys {
			starts[byte((uint64(int64(key))-base)>>shift)]++
		}
		total := 0
		for digit := range starts {
			starts[digit], total = total, total+starts[digit]
		}
		for index, key := range keys {
			digit := byte((uint64(int64(key)) - base) >> shift)
			at := starts[digit]
			spareKeys[at], spareValues[at] = key, values[index]
			starts[digit] = at + 1
		}
		keys, spareKeys = spareKeys, keys
		values, spareValues = spareValues, values
	}
	return keys, values
}

type EntriesOfArrayTupleIntIntArrayInt struct {
	Keys   []tuple.TupleInt
	Values []int
}

func CompareKeys(left tuple.TupleInt, right tuple.TupleInt) int {
	order := cmp.Compare(left.First, right.First)
	if order != 0 {
		return order
	}
	return cmp.Compare(left.Second, right.Second)
}

func SortedFieldEntries[K comparable, V any](table map[K]V, compare func(K, K) int, fields ...func(K) int64) ([]K, []V) {
	count := len(table)
	keys := make([]K, 0, count)
	values := make([]V, 0, count)
	for key, value := range table {
		keys = append(keys, key)
		values = append(values, value)
	}
	if count <= 32 {
		for index := 1; index < count; index++ {
			key, value := keys[index], values[index]
			at := index
			for ; at > 0 && compare(keys[at-1], key) > 0; at-- {
				keys[at], values[at] = keys[at-1], values[at-1]
			}
			keys[at], values[at] = key, value
		}
		return keys, values
	}
	order := make([]int32, count)
	for index := range order {
		order[index] = int32(index)
	}
	spare := make([]int32, count)
	digits := make([]uint64, count)
	for field := len(fields) - 1; field >= 0; field-- {
		project := fields[field]
		lowest := project(keys[0])
		highest := lowest
		for index, key := range keys {
			digit := project(key)
			digits[index] = uint64(digit)
			lowest = min(lowest, digit)
			highest = max(highest, digit)
		}
		base := uint64(lowest)
		span := uint64(highest) - base
		for shift := 0; shift < 64 && span>>shift != 0; shift += 8 {
			var starts [256]int
			for _, at := range order {
				starts[byte((digits[at]-base)>>shift)]++
			}
			total := 0
			for bucket := range starts {
				starts[bucket], total = total, total+starts[bucket]
			}
			for _, at := range order {
				bucket := byte((digits[at] - base) >> shift)
				spare[starts[bucket]] = at
				starts[bucket]++
			}
			order, spare = spare, order
		}
	}
	sortedKeys := make([]K, count)
	sortedValues := make([]V, count)
	for index, at := range order {
		sortedKeys[index], sortedValues[index] = keys[at], values[at]
	}
	return sortedKeys, sortedValues
}

type EntriesOfArrayStringArrayInt struct {
	Keys   []string
	Values []int
}

func SortedStringEntries[V any](table map[string]V, compare func(string, string) int) ([]string, []V) {
	count := len(table)
	keys := make([]string, 0, count)
	values := make([]V, 0, count)
	for key, value := range table {
		keys = append(keys, key)
		values = append(values, value)
	}
	for _, key := range keys {
		for at := 0; at < len(key); at++ {
			if key[at] >= 0xEE {
				slices.SortFunc(keys, compare)
				for index, key := range keys {
					values[index] = table[key]
				}
				return keys, values
			}
		}
	}
	insertion := func(keys []string, values []V) {
		for index := 1; index < len(keys); index++ {
			key, value := keys[index], values[index]
			at := index
			for ; at > 0 && keys[at-1] > key; at-- {
				keys[at], values[at] = keys[at-1], values[at-1]
			}
			keys[at], values[at] = key, value
		}
	}
	if count <= 32 {
		insertion(keys, values)
		return keys, values
	}
	prefixes := make([]uint64, count)
	var counts [8][256]int
	for index, key := range keys {
		var prefix uint64
		for at := 0; at < 8 && at < len(key); at++ {
			prefix |= uint64(key[at]) << (56 - 8*at)
		}
		prefixes[index] = prefix
		for digit := range 8 {
			counts[digit][byte(prefix>>(8*digit))]++
		}
	}
	sparePrefixes := make([]uint64, count)
	spareKeys := make([]string, count)
	spareValues := make([]V, count)
	for digit := range 8 {
		starts := &counts[digit]
		shift := 8 * digit
		if starts[byte(prefixes[0]>>shift)] == count {
			continue
		}
		total := 0
		for bucket := range starts {
			starts[bucket], total = total, total+starts[bucket]
		}
		for index, prefix := range prefixes {
			bucket := byte(prefix >> shift)
			at := starts[bucket]
			sparePrefixes[at], spareKeys[at], spareValues[at] = prefix, keys[index], values[index]
			starts[bucket] = at + 1
		}
		prefixes, sparePrefixes = sparePrefixes, prefixes
		keys, spareKeys = spareKeys, keys
		values, spareValues = spareValues, values
	}
	for low := 0; low < count; {
		high := low + 1
		for high < count && prefixes[high] == prefixes[low] {
			high++
		}
		if high-low <= 16 {
			insertion(keys[low:high], values[low:high])
		} else {
			order := make([]int, high-low)
			for index := range order {
				order[index] = low + index
			}
			slices.SortFunc(order, func(left int, right int) int { return compare(keys[left], keys[right]) })
			for index, from := range order {
				spareKeys[index], spareValues[index] = keys[from], values[from]
			}
			copy(keys[low:high], spareKeys[:high-low])
			copy(values[low:high], spareValues[:high-low])
		}
		low = high
	}
	return keys, values
}

type EntriesOfArrayIntArrayUnit struct {
	Keys   []int
	Values []struct{}
}

type EntriesOfArrayStringArrayUnit struct {
	Keys   []string
	Values []struct{}
}

func IterNodeMapIterInt(iterNode0 *MapIntInt, iterNode1 *MapIterInt) *MapIterInt {
	return &MapIterInt{Tag: MapIterIntIterNode, IterNode0: iterNode0, IterNode1: iterNode1}
}

func IterNodeMapIterTupleIntInt(iterNode0 *MapTupleIntInt, iterNode1 *MapIterTupleIntInt) *MapIterTupleIntInt {
	return &MapIterTupleIntInt{Tag: MapIterTupleIntIntIterNode, IterNode0: iterNode0, IterNode1: iterNode1}
}

func IterNodeMapIterString(iterNode0 *MapStringInt, iterNode1 *MapIterString) *MapIterString {
	return &MapIterString{Tag: MapIterStringIterNode, IterNode0: iterNode0, IterNode1: iterNode1}
}

func Node(node0 int, node1 int, node2 tuple.TupleInt, node3 int, node4 *MapTupleIntInt, node5 *MapTupleIntInt) *MapTupleIntInt {
	return &MapTupleIntInt{Node0: node0, Node1: node1, Node2: node2, Node3: node3, Node4: node4, Node5: node5}
}

var IterMapLInt func(*MapIterInt, *MapIntInt) *MapIterInt = IterMapLGoInt

var IterMapLTupleIntInt func(*MapIterTupleIntInt, *MapTupleIntInt) *MapIterTupleIntInt = IterMapLGoTupleIntInt

var IterMapLString func(*MapIterString, *MapStringInt) *MapIterString = IterMapLGoString

func StepUnfoldrGoInt(value *MapIterInt) MaybeTupleTupleIntIntMapIterIntInt {
	for {
		switch value.Tag {
		case MapIterIntIterLeaf:
			return NoTupleTupleIntIntMapIterIntInt
		case MapIterIntIterEmit:
			k := value.IterEmit0
			v := value.IterEmit1
			iter := value.IterEmit2
			return JustTupleTupleIntIntMapIterIntInt(TupleTupleIntInt{First: tuple.TupleInt{First: k, Second: v}, Second: iter})
		default: // MapIterIntIterNode
			m := value.IterNode0
			iter := value.IterNode1
			value = IterMapLInt(iter, m)
			continue
		}
	}
}

func StepUnfoldrGoTupleIntInt(value *MapIterTupleIntInt) MaybeTupleTupleTupleIntIntIntMapIterTupleIntIntInt {
	for {
		switch value.Tag {
		case MapIterTupleIntIntIterLeaf:
			return NoTupleTupleTupleIntIntIntMapIterTupleIntIntInt
		case MapIterTupleIntIntIterEmit:
			k := value.IterEmit0
			v := value.IterEmit1
			iter := value.IterEmit2
			return JustTupleTupleTupleIntIntIntMapIterTupleIntIntInt(TupleTupleTupleIntIntInt{First: tuple.TupleTupleIntInt{First: k, Second: v}, Second: iter})
		default: // MapIterTupleIntIntIterNode
			m := value.IterNode0
			iter := value.IterNode1
			value = IterMapLTupleIntInt(iter, m)
			continue
		}
	}
}

func StepUnfoldrGoString(value *MapIterString) MaybeTupleTupleStringIntMapIterStringInt {
	for {
		switch value.Tag {
		case MapIterStringIterLeaf:
			return NoTupleTupleStringIntMapIterStringInt
		case MapIterStringIterEmit:
			k := value.IterEmit0
			v := value.IterEmit1
			iter := value.IterEmit2
			return JustTupleTupleStringIntMapIterStringInt(TupleTupleStringInt{First: tuple.TupleString{First: k, Second: v}, Second: iter})
		default: // MapIterStringIterNode
			m := value.IterNode0
			iter := value.IterNode1
			value = IterMapLString(iter, m)
			continue
		}
	}
}

func IterMapLGoInt(iter *MapIterInt, value *MapIntInt) *MapIterInt {
	var mapIterIntIntCells alloc.Cells[MapIterInt]
	for {
		if value == SharedMapIntIntLeaf {
			return iter
		}
		k := value.Node2
		v := value.Node3
		l := value.Node4
		r := value.Node5
		if r == SharedMapIntIntLeaf {
			iter, value = mapIterIntIntCells.New(MapIterInt{Tag: MapIterIntIterEmit, IterEmit0: k, IterEmit1: v, IterEmit2: iter}), l
			continue
		}
		iter, value = mapIterIntIntCells.New(MapIterInt{Tag: MapIterIntIterEmit, IterEmit0: k, IterEmit1: v, IterEmit2: mapIterIntIntCells.New(MapIterInt{Tag: MapIterIntIterNode, IterNode0: r, IterNode1: iter})}), l
	}
}

func IterMapLGoTupleIntInt(iter *MapIterTupleIntInt, value *MapTupleIntInt) *MapIterTupleIntInt {
	var mapIterTupleIntIntIntCells alloc.Cells[MapIterTupleIntInt]
	for {
		if value == SharedMapTupleIntIntLeaf {
			return iter
		}
		k := value.Node2
		v := value.Node3
		l := value.Node4
		r := value.Node5
		if r == SharedMapTupleIntIntLeaf {
			iter, value = mapIterTupleIntIntIntCells.New(MapIterTupleIntInt{Tag: MapIterTupleIntIntIterEmit, IterEmit0: k, IterEmit1: v, IterEmit2: iter}), l
			continue
		}
		iter, value = mapIterTupleIntIntIntCells.New(MapIterTupleIntInt{Tag: MapIterTupleIntIntIterEmit, IterEmit0: k, IterEmit1: v, IterEmit2: mapIterTupleIntIntIntCells.New(MapIterTupleIntInt{Tag: MapIterTupleIntIntIterNode, IterNode0: r, IterNode1: iter})}), l
	}
}

func IterMapLGoString(iter *MapIterString, value *MapStringInt) *MapIterString {
	var mapIterStringIntCells alloc.Cells[MapIterString]
	for {
		if value == SharedMapStringIntLeaf {
			return iter
		}
		k := value.Node2
		v := value.Node3
		l := value.Node4
		r := value.Node5
		if r == SharedMapStringIntLeaf {
			iter, value = mapIterStringIntCells.New(MapIterString{Tag: MapIterStringIterEmit, IterEmit0: k, IterEmit1: v, IterEmit2: iter}), l
			continue
