}

func TreeFromTable4(table map[int]struct{}) *MapIntUnit {
	var entries EntriesOfArrayIntArrayUnit
	var keys []int
	var values []struct{}
	keys2, values2 := SortedIntegerEntries(table)
	entries = EntriesOfArrayIntArrayUnit{Keys: keys2, Values: values2}
	keys = entries.Keys
	values = entries.Values
	return TreeFromKeys4(keys, values, 0, len(keys))
}

