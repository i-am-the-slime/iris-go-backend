	mainffi "fixture/Main_ffi"
	"github.com/i-am-the-slime/iris-go/array"
)

func main() {
	ints := mainffi.Timed(func(_ struct{}) map[int]int {
		table := make(map[int]int)
		table[17] = 17
		table[3] = 3
		table[11] = 11
		table[3] = 3
		table[29] = 29
		table[0] = 0
		table[8] = 8
		table[17] = 17
		table[22] = 22
		table[5] = 5
		table[14] = 14
		return table
	})
	mainffi.Log(tuple.ArrayTupleIntInt(array.Unfoldr(func(value internal.MaybeTupleTupleIntIntMapIterIntInt) bool {
		return value.Tag == maybe.TagNothing
	}, func(value internal.MaybeTupleTupleIntIntMapIterIntInt) internal.TupleTupleIntInt {
		return value.Just
	}, func(value internal.TupleTupleIntInt) tuple.TupleInt {
		return value.First
	}, func(value internal.TupleTupleIntInt) *internal.MapIterInt {
		return value.Second
	}, internal.StepUnfoldrGoInt, internal.IterNodeMapIterInt(internal.TreeFromTable(ints), internal.SharedMapIterIntIterLeaf))))
	pairs := mainffi.Timed(func(_ struct{}) map[tuple.TupleInt]int {
		table := make(map[tuple.TupleInt]int)
		table[tuple.TupleInt{First: 2, Second: 5}] = 17
		table[tuple.TupleInt{First: 0, Second: 1}] = 3
		table[tuple.TupleInt{First: 2, Second: 3}] = 11
		table[tuple.TupleInt{First: 0, Second: 1}] = 3
		table[tuple.TupleInt{First: 2, Second: 9}] = 29
		table[tuple.TupleInt{First: 0, Second: 0}] = 0
		table[tuple.TupleInt{First: 2, Second: 2}] = 8
		table[tuple.TupleInt{First: 2, Second: 5}] = 17
		table[tuple.TupleInt{First: 1, Second: 7}] = 22
		table[tuple.TupleInt{First: 2, Second: 1}] = 5
		table[tuple.TupleInt{First: 2, Second: 4}] = 14
		return table
	})
	mainffi.Log(tuple.ArrayTupleTupleIntIntInt(array.Unfoldr(func(value internal.MaybeTupleTupleTupleIntIntIntMapIterTupleIntIntInt) bool {
		return value.Tag == maybe.TagNothing
	}, func(value internal.MaybeTupleTupleTupleIntIntIntMapIterTupleIntIntInt) internal.TupleTupleTupleIntIntInt {
		return value.Just
	}, func(value internal.TupleTupleTupleIntIntInt) tuple.TupleTupleIntInt {
		return value.First
	}, func(value internal.TupleTupleTupleIntIntInt) *internal.MapIterTupleIntInt {
		return value.Second
	}, internal.StepUnfoldrGoTupleIntInt, internal.IterNodeMapIterTupleIntInt(internal.TreeFromTable2(pairs), internal.SharedMapIterTupleIntIntIterLeaf))))
	words := mainffi.Timed(func(_ struct{}) map[string]int {
		table := make(map[string]int)
		table["pear"] = 1
		table["apple"] = 1
		table["fig"] = 1
		table["apple"] = 1
		table["kiwi"] = 1
		table["banana"] = 1
		table["fig"] = 1
		return table
	})
	mainffi.Log(tuple.ArrayTupleStringInt(array.Unfoldr(func(value internal.MaybeTupleTupleStringIntMapIterStringInt) bool {
		return value.Tag == maybe.TagNothing
	}, func(value internal.MaybeTupleTupleStringIntMapIterStringInt) internal.TupleTupleStringInt {
		return value.Just
	}, func(value internal.TupleTupleStringInt) tuple.TupleString {
		return value.First
	}, func(value internal.TupleTupleStringInt) *internal.MapIterString {
		return value.Second
	}, internal.StepUnfoldrGoString, internal.IterNodeMapIterString(internal.TreeFromTable3(words), internal.SharedMapIterStringIterLeaf))))
	intSet := mainffi.Timed(func(_ struct{}) map[int]struct{} {
		table := make(map[int]struct{})
		table[17] = struct{}{}
		table[3] = struct{}{}
		table[11] = struct{}{}
		table[3] = struct{}{}
		table[29] = struct{}{}
		table[0] = struct{}{}
		table[8] = struct{}{}
		table[17] = struct{}{}
		table[22] = struct{}{}
		table[5] = struct{}{}
		table[14] = struct{}{}
		return table
	})
	mainffi.Log(show.ArrayInt(array.Unfoldr(func(value types.MaybeTupleIntListInt) bool {
		return value.Tag == maybe.TagNothing
	}, func(value types.MaybeTupleIntListInt) types.TupleInt {
		return value.Just
	}, func(value types.TupleInt) int {
		return value.First
	}, func(value types.TupleInt) *types.ListInt {
		return value.Second
	}, func(xs *types.ListInt) types.MaybeTupleIntListInt {
		if xs == types.SharedListIntNil {
			return types.NoTupleIntListInt
		}
		return types.JustTupleIntListInt(types.TupleInt{First: xs.Cons0, Second: xs.Cons1})
	}, mainGo(internal.TreeFromTable4(intSet), types.SharedListIntNil))))
	wordSet := mainffi.Timed(func(_ struct{}) map[string]struct{} {
		table := make(map[string]struct{})
		table["pear"] = struct{}{}
		table["apple"] = struct{}{}
		table["fig"] = struct{}{}
		table["apple"] = struct{}{}
		table["kiwi"] = struct{}{}
		table["banana"] = struct{}{}
		table["fig"] = struct{}{}
		return table
	})
	mainffi.Log(show.ArrayString(array.Unfoldr(func(value types.MaybeTupleStringListString) bool {
		return value.Tag == maybe.TagNothing
	}, func(value types.MaybeTupleStringListString) types.TupleString {
		return value.Just
	}, func(value types.TupleString) string {
		return value.First
	}, func(value types.TupleString) *types.ListString {
		return value.Second
	}, func(xs *types.ListString) types.MaybeTupleStringListString {
		if xs == types.SharedListStringNil {
			return types.NoTupleStringListString
		}
		return types.JustTupleStringListString(types.TupleString{First: xs.Cons0, Second: xs.Cons1})
	}, mainGo2(internal.TreeFromTable5(wordSet), types.SharedListStringNil))))
}

func mainGo(m_ *internal.MapIntUnit, z_ *types.ListInt) *types.ListInt {
	for {
		if m_ == internal.SharedMapIntUnitLeaf {
			return z_
		}
		k := m_.Node2
		l := m_.Node4
		r := m_.Node5
		m_, z_ = l, types.ConsListInt(k, mainGo(r, z_))
	}
}

func mainGo2(m_ *internal.MapStringUnit, z_ *types.ListString) *types.ListString {
	for {
		if m_ == internal.SharedMapStringUnitLeaf {
			return z_
		}
		k := m_.Node2
		l := m_.Node4
		r := m_.Node5
		m_, z_ = l, types.ConsListString(k, mainGo2(r, z_))
	}
}
