// Data/List/Types/types.go
package types

import "fixture/Data/Maybe"

type ListInt struct {
	Cons1 *ListInt
	Cons0 int
}

var SharedListIntNil = &ListInt{}

type TupleInt struct {
	Second *ListInt
	First  int
}

type MaybeTupleIntListInt struct {
	Just TupleInt
	Tag  uint8
}

var NoTupleIntListInt = MaybeTupleIntListInt{Tag: maybe.TagNothing}

func JustTupleIntListInt(just TupleInt) MaybeTupleIntListInt {
	return MaybeTupleIntListInt{Tag: maybe.TagJust, Just: just}
}

type ListString struct {
	Cons0 string
	Cons1 *ListString
}

var SharedListStringNil = &ListString{}

type TupleString struct {
	First  string
	Second *ListString
}

type MaybeTupleStringListString struct {
	Just TupleString
	Tag  uint8
}

var NoTupleStringListString = MaybeTupleStringListString{Tag: maybe.TagNothing}

func JustTupleStringListString(just TupleString) MaybeTupleStringListString {
	return MaybeTupleStringListString{Tag: maybe.TagJust, Just: just}
}

func ConsListInt(cons0 int, cons1 *ListInt) *ListInt {
	return &ListInt{Cons0: cons0, Cons1: cons1}
}

func ConsListString(cons0 string, cons1 *ListString) *ListString {
	return &ListString{Cons0: cons0, Cons1: cons1}
}

