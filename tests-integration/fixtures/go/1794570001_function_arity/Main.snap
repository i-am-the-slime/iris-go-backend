// Data/Semiring/semiring.go
package semiring

func Add(i int32, i2 int32) int32 {
	return i + i2
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(i int32) string {
	return prim.ShowInt(i)
}

func Show2(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Data/Semiring"
	"fixture/Data/Show"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	function := fromInt(4)
	array2 := []int32{1, 2}
	mapped := make([]string, len(array2))
	for index, x := range array2 {
		a := prim.MultiplyInt32(x, x)
		partial := func(b int32) int32 {
			return mainOp(a, b)
		}
		mapped[index] = prim.ShowArray(show.Show, []int32{mainOp(1, 2), partial(3), partial(4)})
	}
	array3 := []func(int32) func(string) string{prepared, func(a int32) func(string) string {
		return func(b string) string {
			return prim.ShowInt(a) + b
		}
	}}
	mapped2 := make([]string, len(array3))
	for index, x := range array3 {
		g := x(4)
		mapped2[index] = prim.ShowArray(show.Show2, []string{x(1)("a"), g("b"), g("c")})
	}
	array4 := []func(int32, int32) int32{semiring.Add, func(a int32, b int32) int32 {
		return prim.MultiplyInt32(a, b) + 1
	}}
	mapped3 := make([]string, len(array4))
	for index, combine := range array4 {
		mapped3[index] = prim.ShowInt(array.Foldl(combine, int32(0), []int32{1, 2, 3}))
	}
	return array.Append([]string{prim.ShowInt(fromInt(3)(func(i int32) int32 {
		return function(func(value int32) int32 {
			return value + 1
		}, i)
	}, 0))}, array.Append(mapped, array.Append(mapped2, mapped3)))
}

func fromInt(n int32) func(func(int32) int32, int32) int32 {
	switch n {
	case 0:
		return zeroCInt
	default:
		n2 := fromInt(n - 1)
		return func(f func(int32) int32, x int32) int32 {
			return f(n2(f, x))
		}
	}
}

func prepared(a int32) func(string) string {
	prefix := repeat(a)
	return func(b string) string {
		return prim.Append(prefix, b)
	}
}

func zeroCInt(ignored func(int32) int32, x int32) int32 {
	return x
}

func repeat(n int32) string {
	switch n {
	case 0:
		return ""
	default:
		return "*" + repeat(n - 1)
	}
}

func mainOp(a int32, b int32) int32 {
	return prim.MultiplyInt32(a, 10) + b
}

func main() {
	fmt.Println(main_)
}
