// Data/Semiring/semiring.go
package semiring

func Add(i int32, i2 int32) int32 {
	return i + i2
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int32) string {
	return strconv.Itoa(int(i))
}

func ShowString(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Data/Semiring"
	"fixture/Data/Show"
	"fmt"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	function := fromInt(4)
	array := []int32{1, 2}
	mapped := make([]string, len(array))
	for index, x := range array {
		a := x * x
		partial := func(b int32) int32 {
			return mainOp(a, b)
		}
		mapped[index] = prim.ShowArray(show.ShowInt, []int32{mainOp(1, 2), partial(3), partial(4)})
	}
	array2 := []func(int32) func(string) string{prepared, func(a int32) func(string) string {
		return func(b string) string {
			return strconv.Itoa(int(a)) + b
		}
	}}
	mapped2 := make([]string, len(array2))
	for index, x := range array2 {
		g := x(4)
		mapped2[index] = prim.ShowArray(show.ShowString, []string{x(1)("a"), g("b"), g("c")})
	}
	array3 := []func(int32, int32) int32{semiring.Add, func(a int32, b int32) int32 {
		return a*b + 1
	}}
	mapped3 := make([]string, len(array3))
	for index, combine := range array3 {
		mapped3[index] = strconv.Itoa(int(arraypkg.Foldl(combine, int32(0), []int32{1, 2, 3})))
	}
	return arraypkg.Append([]string{strconv.Itoa(int(fromInt(3)(func(i int32) int32 {
		return function(func(value int32) int32 {
			return value + 1
		}, i)
	}, 0)))}, arraypkg.Append(mapped, arraypkg.Append(mapped2, mapped3)))
}

func fromInt(n int32) func(func(int32) int32, int32) int32 {
	switch n {
	case 0:
		return zeroCInt
	default:
		n2 := fromInt(n - 1)
		return func(f func(int32) int32, x int32) int32 {
			return f(n2(f, x))
		}
	}
}

func prepared(a int32) func(string) string {
	prefix := repeat(a)
	return func(b string) string {
		return prim.Append(prefix, b)
	}
}

func zeroCInt(ignored func(int32) int32, x int32) int32 {
	return x
}

func repeat(n int32) string {
	switch n {
	case 0:
		return ""
	default:
		return "*" + repeat(n-1)
	}
}

func mainOp(a int32, b int32) int32 {
	return a*10 + b
}

func main() {
	fmt.Println(main_)
}
