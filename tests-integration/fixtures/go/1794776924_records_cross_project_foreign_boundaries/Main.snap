// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/Shapes_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	nullablepkg "github.com/i-am-the-slime/iris-go/nullable"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() string {
	defer exception.ReportUncaught()
	original := shared.NameSides{Name: "square", Sides: 4}
	nullable := Shapes_ffi.Measure("square")
	var converted *[]shared.Shape
	if nullable != nil {
		present := array.Map(func(element any) shared.Shape {
			return shared.Shape{Kind: direct.ForeignField(element, "kind").(string), Size: direct.ForeignField(element, "size").(int32)}
		}, *nullable)
		converted = &present
	}
	return Shapes_ffi.Describe(direct.ForeignRecord([]string{"name", "sides"}, []any{original.Name, original.Sides})) + ": " + nullablepkg.Nullable(converted, "unknown", sizes)
}

func sizes(shapes []shared.Shape) string {
	mapped := make([]int32, len(shapes))
	for index := range shapes {
		mapped[index] = shapes[index].Size
	}
	return prim.ShowArray(show.Show, mapped)
}

func main() {
	console.Print(main_)
}

// shared/shared.go
package shared

type NameSides struct {
	Name  string
	Sides int32
}

type Shape struct {
	Kind string
	Size int32
}
