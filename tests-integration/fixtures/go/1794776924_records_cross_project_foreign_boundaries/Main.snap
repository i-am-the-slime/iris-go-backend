// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(i int32) string {
	return prim.ShowInt(i)
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/Shapes_ffi"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/nullable"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() string {
	defer exception.ReportUncaught()
	original := shared.NameSides{Name: "square", Sides: 4}
	nullable2 := Shapes_ffi.Measure("square")
	var converted *[]shared.Shape
	if nullable2 != nil {
		present := array.Map(func(element any) shared.Shape {
			return shared.Shape{Kind: direct.ForeignField(element, "kind").(string), Size: direct.ForeignField(element, "size").(int32)}
		}, *nullable2)
		converted = &present
	}
	return Shapes_ffi.Describe(direct.ForeignRecord([]string{"name", "sides"}, []any{original.Name, original.Sides})) + ": " + nullable.Nullable(converted, "unknown", sizes)
}

func sizes(shapes []shared.Shape) string {
	mapped := make([]int32, len(shapes))
	for index := range shapes {
		mapped[index] = shapes[index].Size
	}
	return prim.ShowArray(show.Show, mapped)
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type NameSides struct {
	Name  string
	Sides int32
}

type Shape struct {
	Kind string
	Size int32
}
