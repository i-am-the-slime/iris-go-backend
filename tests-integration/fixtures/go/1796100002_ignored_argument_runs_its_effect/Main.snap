// Control/Monad/Rec/Class/class.go
package class

import "fixture/shared"

type Step struct {
	Loop shared.AccI
	Done int
	Tag  uint8
}

const (
	StepLoop = iota
	StepDone
)

func Done(done int) Step {
	return Step{Tag: StepDone, Done: done}
}

func Loop(loop shared.AccI) Step {
	return Step{Tag: StepLoop, Loop: loop}
}

// main.go
package main

import (
	"fixture/Control/Monad/Rec/Class"
	"fixture/shared"
	"os"
)

func main_() int {
	count := &shared.Ref[int]{Value: 0}
	mainGo(count, mainF(count, shared.AccI{Acc: 3, I: 0}))
	countdown(count, 1, 3)
	iterateF(count, 1, 3)
	return count.Value
}

func countdown(count *shared.Ref[int], n int, acc int) int {
	for {
		countCaptured := count
		if n <= 0 {
			return acc
		}
		s := countCaptured.Value
		s_ := s + 10
		countCaptured.Value = s_
		count, n = countCaptured, n-1
	}
}

func iterateF(ref *shared.Ref[int], n int, x int) int {
	for {
		refCaptured := ref
		if n <= 0 {
			return x
		}
		s := refCaptured.Value
		s_ := s + 100
		refCaptured.Value = s_
		ref, n = refCaptured, n-1
	}
}

func mainF(count *shared.Ref[int], st shared.AccI) class.Step {
	if st.I >= 1 {
		return class.Done(st.Acc)
	}
	s := count.Value
	s_ := s + 1
	count.Value = s_
	performed := st.Acc
	accI := shared.AccI{Acc: performed, I: st.I + 1}
	return class.Loop(accI)
}

func mainGo(count *shared.Ref[int], step class.Step) int {
	for {
		switch step.Tag {
		case class.StepLoop:
			a := step.Loop
			step = mainF(count, a)
			continue
		default: // class.StepDone
			return step.Done
		}
	}
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type AccI struct {
	Acc int
	I   int
}

type StateValue struct {
	State int
	Value int
}
