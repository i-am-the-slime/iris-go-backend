// Control/Monad/Rec/Class/class.go
package class

import "fixture/shared"

type StepAccIInt struct {
	Loop shared.AccI
	Done int32
	Tag  uint8
}

const (
	StepAccIIntLoop = iota
	StepAccIIntDone
)

// main.go
package main

import (
	"fixture/Control/Monad/Rec/Class"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

func main_() int32 {
	ref := &shared.Ref[int32]{Value: 0}
	mainGo(ref, mainF(ref, shared.AccI{Acc: 3, I: 0}))
	countdown(ref, 1, 3)
	iterate(func(value int32) int32 {
		s := ref.Value
		s_ := s + 100
		ref.Value = s_
		return value
	}, 1, 3)
	i := ref.Value
	return i
}

func countdown(count *shared.Ref[int32], n int32, acc int32) int32 {
	for {
		countCaptured := count
		if n <= 0 {
			return acc
		}
		s := countCaptured.Value
		s_ := s + 10
		countCaptured.Value = s_
		count, n = countCaptured, n - 1
	}
}

func iterate(f func(int32) int32, n int32, x int32) int32 {
	for {
		if n <= 0 {
			return x
		}
		n, x = n - 1, f(x)
	}
}

func mainF(ref *shared.Ref[int32], st shared.AccI) class.StepAccIInt {
	if st.I >= 1 {
		return class.StepAccIInt{Tag: class.StepAccIIntDone, Done: st.Acc}
	}
	s := ref.Value
	s_ := s + 1
	ref.Value = s_
	performed := st.Acc
	accI := shared.AccI{Acc: performed, I: st.I + 1}
	return class.StepAccIInt{Tag: class.StepAccIIntLoop, Loop: accI}
}

func mainGo(ref *shared.Ref[int32], step class.StepAccIInt) int32 {
	for {
		switch step.Tag {
		case class.StepAccIIntLoop:
			a := step.Loop
			step = mainF(ref, a)
			continue
		default: // class.StepAccIIntDone
			b := step.Done
			return b
		}
	}
}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type AccI struct {
	Acc int32
	I   int32
}

type StateValue struct {
	State int32
	Value int32
}
