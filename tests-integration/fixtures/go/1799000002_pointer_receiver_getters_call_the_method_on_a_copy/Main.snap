// main.go
package main

import (
	counter "fixture/Counter_ffi"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	var result int
	receiver := counter.Zero
	if receiver.Bump() > 0 {
		result = counter.Count(counter.Zero)
	} else {
		result = -1
	}
	receiver2 := counter.Zero
	receiver3 := counter.Zero
	receiver4 := counter.Zero
	return []int{receiver2.Bump(), receiver3.Bump() + receiver4.Bump(), result, counter.Count(counter.Zero)}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
