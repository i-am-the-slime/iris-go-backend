// main.go
package main

import "fmt"

type Never struct{}

type Step struct {
	Impossible Never
	Done       int32
	Tag        uint8
}

const (
	StepDone = iota
	StepImpossible
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	mapped := make([]int32, len(steps))
	for index, element := range steps {
		mapped[index] = value(element)
	}
	return mapped
}

func value(step *Step) int32 {
	switch step.Tag {
	case StepDone:
		return step.Done
	default: // StepImpossible
		return absurdInt(step.Impossible)
	}
}

var steps []*Step = []*Step{&Step{Tag: StepDone, Done: 7}, &Step{Tag: StepDone, Done: 8}}

func absurdInt(never Never) int32 {
	for {
	}
}

func main() {
	fmt.Println(main_)
}
