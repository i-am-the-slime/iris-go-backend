// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Never any

type Step struct {
	Impossible Never
	Done       int32
	Tag        uint8
}

const (
	StepDone = iota
	StepImpossible
)

func Done(done int) Step {
	return Step{Tag: StepDone, Done: int32(done)}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	mapped := make([]int, len(steps))
	for index, element := range steps {
		mapped[index] = value(element)
	}
	return mapped
}

func value(step Step) int {
	switch step.Tag {
	case StepDone:
		return int(step.Done)
	default: // StepImpossible
		return absurd(step.Impossible)
	}
}

var steps []Step = []Step{Done(7), Done(8)}

func absurd(never Never) int {
	for {
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
