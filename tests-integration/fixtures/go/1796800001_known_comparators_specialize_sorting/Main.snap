// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int32) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
}

var sharedListIntNil = &ListInt{}

func Cons(cons0 int32, cons1 *ListInt) *ListInt {
	return &ListInt{Cons0: cons0, Cons1: cons1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	accumulator := sharedListIntNil
	var listIntCells alloc.Cells[ListInt]
	for index := len(numbers) - 1; index >= 0; index-- {
		i := numbers[index]
		accumulator = listIntCells.New(ListInt{Cons0: i, Cons1: accumulator})
	}
	accumulator2 := sharedListIntNil
	var listIntCells2 alloc.Cells[ListInt]
	for index := len(numbers) - 1; index >= 0; index-- {
		i := numbers[index]
		accumulator2 = listIntCells2.New(ListInt{Cons0: i, Cons1: accumulator2})
	}
	accumulator3 := sharedListIntNil
	var listIntCells3 alloc.Cells[ListInt]
	for index := len(numbers) - 1; index >= 0; index-- {
		i := numbers[index]
		accumulator3 = listIntCells3.New(ListInt{Cons0: i, Cons1: accumulator3})
	}
	return []string{show.ArrayInt(sortByIntCompare(numbers)), show.ArrayInt(sortByIntDescending(numbers)), show.ArrayInt(sortByIntOrder(numbers)), show.ArrayInt(sortByIntOrder2(numbers)), show.ArrayInt(toArrayInt(mainGoReusing(sharedListIntNil, accumulator))), show.ArrayInt(toArrayInt(mainGoReusing2(sharedListIntNil, accumulator2))), show.ArrayInt(toArrayInt(mainGoReusing3(sharedListIntNil, accumulator3)))}
}

var numbers []int32 = []int32{7, 3, 9, 1, 4, 8, 2, 6, 5, 0}

func toArrayInt(value *ListInt) []int32 {
	if value == sharedListIntNil {
		return []int32{}
	}
	return array.Append([]int32{value.Cons0}, toArrayInt(value.Cons1))
}

func sortByIntCompare(xs []int32) []int32 {
	result := array.Thaw(xs)
	sortByIntCompareQuicksort(*result, 0, int32(len(xs))-1)
	performed := shared.Frozen(*result)
	return performed
}

func sortByIntDescending(xs []int32) []int32 {
	result := array.Thaw(xs)
	sortByIntDescendingQuicksort(*result, 0, int32(len(xs))-1)
	performed := shared.Frozen(*result)
	return performed
}

func sortByIntOrder(xs []int32) []int32 {
	result := array.Thaw(xs)
	sortByIntOrderQuicksort(*result, 0, int32(len(xs))-1)
	performed := shared.Frozen(*result)
	return performed
}

func sortByIntOrder2(xs []int32) []int32 {
	result := array.Thaw(xs)
	sortByIntOrderQuicksort2(*result, 0, int32(len(xs))-1)
	performed := shared.Frozen(*result)
	return performed
}

func sortByIntCompareSwap(array []int32, i int32, j int32) {
	var peeked maybe.Int
	peeked = maybe.Int(array[i])
	var peeked2 maybe.Int
	peeked2 = maybe.Int(array[j])
	if peeked != maybe.NoInt && peeked2 != maybe.NoInt {
		array[i] = int32(peeked2)
		array[j] = int32(peeked)
	}
}

func sortByIntCompareQuicksort(array []int32, low int32, high int32) {
	for {
		if low < high {
			within := int(high) < len(array)
			var pivotIndex int32
			if within {
				element := array[high]
				var pivotIndex2 int32
				var i int32 = low
				var j int32 = low
			sortByIntComparePartitionFrom:
				for {
					if j < high {
						element2 := array[j]
						if element2 <= element {
							sortByIntCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntComparePartitionFrom
				}
				sortByIntCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByIntCompareQuicksort(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func sortByIntDescendingQuicksort(array []int32, low int32, high int32) {
	for {
		if low < high {
			within := int(high) < len(array)
			var pivotIndex int32
			if within {
				element := array[high]
				var pivotIndex2 int32
				var i int32 = low
				var j int32 = low
			sortByIntDescendingPartitionFrom:
				for {
					if j < high {
						element2 := array[j]
						if element <= element2 {
							sortByIntCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntDescendingPartitionFrom
				}
				sortByIntCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByIntDescendingQuicksort(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func sortByIntOrderQuicksort(array []int32, low int32, high int32) {
	for {
		if low < high {
			within := int(high) < len(array)
			var pivotIndex int32
			if within {
				element := array[high]
				var pivotIndex2 int32
				var i int32 = low
				var j int32 = low
			sortByIntOrderPartitionFrom:
				for {
					if j < high {
						element2 := array[j]
						var i2 int32
						if element2 < 4 {
							i2 = 4 - element2
						} else {
							i2 = element2 - 4
						}
						var i3 int32
						if element < 4 {
							i3 = 4 - element
						} else {
							i3 = element - 4
						}
						if i2 <= i3 {
							sortByIntCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntOrderPartitionFrom
				}
				sortByIntCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByIntOrderQuicksort(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func sortByIntOrderQuicksort2(array []int32, low int32, high int32) {
	for {
		if low < high {
			within := int(high) < len(array)
			var pivotIndex int32
			if within {
				element := array[high]
				var pivotIndex2 int32
				var i int32 = low
				var j int32 = low
			sortByIntOrderPartitionFrom2:
				for {
					if j < high {
						element2 := array[j]
						i2 := -element2
						i3 := -element
						if i2 <= i3 {
							sortByIntCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntOrderPartitionFrom2
				}
				sortByIntCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByIntOrderQuicksort2(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func mainGoReusing(sorted *ListInt, value *ListInt) *ListInt {
	for {
		if value == sharedListIntNil {
			return sorted
		}
		x := value.Cons0
		rest := value.Cons1
		sorted, value = insertByIntCompareReusing(x, sorted), rest
	}
}

func mainGoReusing2(sorted *ListInt, value *ListInt) *ListInt {
	for {
		if value == sharedListIntNil {
			return sorted
		}
		x := value.Cons0
		rest := value.Cons1
		sorted, value = insertByIntDescendingReusing(x, sorted), rest
	}
}

func mainGoReusing3(sorted *ListInt, value *ListInt) *ListInt {
	for {
		if value == sharedListIntNil {
			return sorted
		}
		x := value.Cons0
		rest := value.Cons1
		sorted, value = insertByIntOrderReusing(x, sorted), rest
	}
}

func insertByIntOrderReusing(x int32, value *ListInt) *ListInt {
	if value == sharedListIntNil {
		return Cons(x, sharedListIntNil)
	}
	y := value.Cons0
	rest := value.Cons1
	var i int32
	if x < 6 {
		i = 6 - x
	} else {
		i = x - 6
	}
	var i2 int32
	if y < 6 {
		i2 = 6 - y
	} else {
		i2 = y - 6
	}
	if i > i2 {
		field := insertByIntOrderReusing(x, rest)
		value.Cons1 = field
		return value
	}
	return Cons(x, value)
}

func insertByIntDescendingReusing(x int32, value *ListInt) *ListInt {
	if value == sharedListIntNil {
		return Cons(x, sharedListIntNil)
	}
	y := value.Cons0
	rest := value.Cons1
	if y > x {
		field := insertByIntDescendingReusing(x, rest)
		value.Cons1 = field
		return value
	}
	return Cons(x, value)
}

func insertByIntCompareReusing(x int32, value *ListInt) *ListInt {
	if value == sharedListIntNil {
		return Cons(x, sharedListIntNil)
	}
	y := value.Cons0
	rest := value.Cons1
	if x > y {
		field := insertByIntCompareReusing(x, rest)
		value.Cons1 = field
		return value
	}
	return Cons(x, value)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
