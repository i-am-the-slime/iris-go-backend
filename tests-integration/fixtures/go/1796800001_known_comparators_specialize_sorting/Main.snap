// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

type List struct {
	Cons1 *List
	Cons0 int
}

var sharedListNil = &List{}

func Cons(cons0 int, cons1 *List) *List {
	return &List{Cons0: cons0, Cons1: cons1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	accumulator := sharedListNil
	var listIntCells alloc.Cells[List]
	for index := len(numbers) - 1; index >= 0; index-- {
		i := numbers[index]
		accumulator = listIntCells.New(List{Cons0: i, Cons1: accumulator})
	}
	accumulator2 := sharedListNil
	var listIntCells2 alloc.Cells[List]
	for index := len(numbers) - 1; index >= 0; index-- {
		i := numbers[index]
		accumulator2 = listIntCells2.New(List{Cons0: i, Cons1: accumulator2})
	}
	accumulator3 := sharedListNil
	var listIntCells3 alloc.Cells[List]
	for index := len(numbers) - 1; index >= 0; index-- {
		i := numbers[index]
		accumulator3 = listIntCells3.New(List{Cons0: i, Cons1: accumulator3})
	}
	return []string{show.ArrayInt(sortByCompare(numbers)), show.ArrayInt(sortByDescending(numbers)), show.ArrayInt(sortByOrder(numbers)), show.ArrayInt(sortByOrder2(numbers)), show.ArrayInt(toArray(mainGoReusing(sharedListNil, accumulator))), show.ArrayInt(toArray(mainGoReusing2(sharedListNil, accumulator2))), show.ArrayInt(toArray(mainGoReusing3(sharedListNil, accumulator3)))}
}

var numbers []int = []int{7, 3, 9, 1, 4, 8, 2, 6, 5, 0}

func toArray(value *List) []int {
	if value == sharedListNil {
		return []int{}
	}
	return array.Append([]int{value.Cons0}, toArray(value.Cons1))
}

func sortByCompare(xs []int) []int {
	result := array.Thaw(xs)
	sortByCompareQuicksort(*result, 0, len(xs)-1)
	return shared.Frozen(*result)
}

func sortByDescending(xs []int) []int {
	result := array.Thaw(xs)
	sortByDescendingQuicksort(*result, 0, len(xs)-1)
	return shared.Frozen(*result)
}

func sortByOrder(xs []int) []int {
	result := array.Thaw(xs)
	sortByOrderQuicksort(*result, 0, len(xs)-1)
	return shared.Frozen(*result)
}

func sortByOrder2(xs []int) []int {
	result := array.Thaw(xs)
	sortByOrderQuicksort2(*result, 0, len(xs)-1)
	return shared.Frozen(*result)
}

func sortByCompareSwap(array []int, i int, j int) {
	var peeked maybe.Int
	peeked = maybe.JustInt(array[i])
	var peeked2 maybe.Int
	peeked2 = maybe.JustInt(array[j])
	if peeked.Tag == maybe.TagJust && peeked2.Tag == maybe.TagJust {
		array[i] = peeked2.Just
		array[j] = peeked.Just
	}
}

func sortByCompareQuicksort(array []int, low int, high int) {
	for {
		if low < high {
			within := high < len(array)
			var pivotIndex int
			if within {
				element := array[high]
				var pivotIndex2 int
				var i int = low
				var j int = low
			sortByIntComparePartitionFrom:
				for {
					if j < high {
						element2 := array[j]
						if element2 <= element {
							sortByCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntComparePartitionFrom
				}
				sortByCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByCompareQuicksort(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func sortByDescendingQuicksort(array []int, low int, high int) {
	for {
		if low < high {
			within := high < len(array)
			var pivotIndex int
			if within {
				element := array[high]
				var pivotIndex2 int
				var i int = low
				var j int = low
			sortByIntDescendingPartitionFrom:
				for {
					if j < high {
						element2 := array[j]
						if element <= element2 {
							sortByCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntDescendingPartitionFrom
				}
				sortByCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByDescendingQuicksort(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func sortByOrderQuicksort(array []int, low int, high int) {
	for {
		if low < high {
			within := high < len(array)
			var pivotIndex int
			if within {
				element := array[high]
				var pivotIndex2 int
				var i int = low
				var j int = low
			sortByIntOrderPartitionFrom:
				for {
					if j < high {
						element2 := array[j]
						var i2 int
						if element2 < 4 {
							i2 = 4 - element2
						} else {
							i2 = element2 - 4
						}
						var i3 int
						if element < 4 {
							i3 = 4 - element
						} else {
							i3 = element - 4
						}
						if i2 <= i3 {
							sortByCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntOrderPartitionFrom
				}
				sortByCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByOrderQuicksort(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func sortByOrderQuicksort2(array []int, low int, high int) {
	for {
		if low < high {
			within := high < len(array)
			var pivotIndex int
			if within {
				element := array[high]
				var pivotIndex2 int
				var i int = low
				var j int = low
			sortByIntOrderPartitionFrom2:
				for {
					if j < high {
						element2 := array[j]
						i2 := -element2
						i3 := -element
						if i2 <= i3 {
							sortByCompareSwap(array, i, j)
							i, j = i+1, j+1
							continue
						}
						j += 1
						continue
					}
					pivotIndex2 = i
					break sortByIntOrderPartitionFrom2
				}
				sortByCompareSwap(array, pivotIndex2, high)
				pivotIndex = pivotIndex2
			} else {
				pivotIndex = low
			}
			sortByOrderQuicksort2(array, low, pivotIndex-1)
			low = pivotIndex + 1
			continue
		}
		return
	}
}

func mainGoReusing(sorted *List, value *List) *List {
	for {
		if value == sharedListNil {
			return sorted
		}
		x := value.Cons0
		rest := value.Cons1
		sorted, value = insertByCompare(x, sorted), rest
	}
}

func mainGoReusing2(sorted *List, value *List) *List {
	for {
		if value == sharedListNil {
			return sorted
		}
		x := value.Cons0
		rest := value.Cons1
		sorted, value = insertByDescending(x, sorted), rest
	}
}

func mainGoReusing3(sorted *List, value *List) *List {
	for {
		if value == sharedListNil {
			return sorted
		}
		x := value.Cons0
		rest := value.Cons1
		sorted, value = insertByOrder(x, sorted), rest
	}
}

func insertByOrder(x int, value *List) *List {
	if value == sharedListNil {
		return Cons(x, sharedListNil)
	}
	y := value.Cons0
	rest := value.Cons1
	var i int
	if x < 6 {
		i = 6 - x
	} else {
		i = x - 6
	}
	var i2 int
	if y < 6 {
		i2 = 6 - y
	} else {
		i2 = y - 6
	}
	if i > i2 {
		field := insertByOrder(x, rest)
		value.Cons1 = field
		return value
	}
	return Cons(x, value)
}

func insertByDescending(x int, value *List) *List {
	if value == sharedListNil {
		return Cons(x, sharedListNil)
	}
	y := value.Cons0
	rest := value.Cons1
	if y > x {
		field := insertByDescending(x, rest)
		value.Cons1 = field
		return value
	}
	return Cons(x, value)
}

func insertByCompare(x int, value *List) *List {
	if value == sharedListNil {
		return Cons(x, sharedListNil)
	}
	y := value.Cons0
	rest := value.Cons1
	if x > y {
		field := insertByCompare(x, rest)
		value.Cons1 = field
		return value
	}
	return Cons(x, value)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
