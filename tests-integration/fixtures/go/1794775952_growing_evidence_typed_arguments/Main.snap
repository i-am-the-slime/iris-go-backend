// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayBoolean(buffer []byte, array []bool) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendBool(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayBoolean(array []bool) string {
	return string(AppendShowArrayBoolean(nil, array))
}

// main.go
package main

import (
	datashow "fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{describeShowDictionary(func(coerced any) string {
		return datashow.ArrayBoolean(shared.Convert(coerced))
	}, []int{2}, ">", 1, shared.Convert2([]bool{true}))}
}

func describeShowDictionary(show func(any) string, depths []int, label string, depth int, value any) string {
	depths = slices.Clip(depths)
	labelBytes := []byte(label)
	for {
		showCaptured := show
		switch depth {
		case 0:
			text := prim.AppendString(nil, string(labelBytes))
			text = datashow.AppendShowArrayInt(text, depths)
			text = append(text, ": "...)
			text = prim.AppendString(text, showCaptured(value))
			return string(text)
		default:
			labelBytes = append(labelBytes, '>')
			show, depths, depth, value = func(coerced any) string {
				return prim.ShowArray(showCaptured, coerced.([]any))
			}, append(depths, depth), depth-1, []any{value}
			continue
		}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value any) []bool {
	array := value.([]any)
	converted := make([]bool, len(array))
	for index, element := range array {
		converted[index] = element.(bool)
	}
	return converted
}

func Convert2(value []bool) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}

// note: Main.describe takes its Show dictionary at run time, because polymorphic recursion reaches it at ever larger types; only this definition is slower
