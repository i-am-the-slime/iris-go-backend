// Data/Show/show.go
package show

import "strconv"

func ShowBoolean(boolean bool) string {
	if boolean {
		return "true"
	}
	return "false"
}

func ShowInt(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayBoolean(buffer []byte, array []bool) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendBool(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayBoolean(array []bool) string {
	return string(AppendShowArrayBoolean(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{describeArrayBoolean(shared.Show{Show: func(coerced any) string {
		return show.ArrayBoolean(shared.Convert(coerced))
	}}, array.Append([]int32{}, []int32{2}), ">", 1, shared.Convert2([]bool{true}))}
}

func describeArrayBoolean(showDictionary shared.Show, depths []int32, label string, depth int32, value any) string {
	depths = slices.Clip(depths)
	labelBytes := []byte(label)
	for {
		showDictionaryCaptured := showDictionary
		switch depth {
		case 0:
			text := prim.AppendString(nil, string(labelBytes))
			text = show.AppendShowArrayInt(text, depths)
			text = append(text, ": "...)
			text = prim.AppendString(text, showDictionaryCaptured.Show(value))
			return string(text)
		default:
			labelBytes = append(labelBytes, '>')
			showDictionary, depths, depth, value = shared.Show{Show: func(coerced any) string {
				return prim.ShowArray(showDictionaryCaptured.Show, coerced.([]any))
			}}, array.Bounded(append(depths, depth)), depth-1, []any{value}
			continue
		}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value any) []bool {
	array := value.([]any)
	converted := make([]bool, len(array))
	for index, element := range array {
		converted[index] = element.(bool)
	}
	return converted
}

type Show struct {
	Show func(any) string
}

func Convert2(value []bool) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}
