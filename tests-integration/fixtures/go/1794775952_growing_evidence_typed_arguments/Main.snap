// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowBoolean2(boolean bool) string {
	if boolean {
		return "true"
	}
	return "false"
}

func ShowBoolean(array []bool) string {
	return prim.ShowArray(ShowBoolean2, array)
}

func ShowInt(i int32) string {
	return strconv.Itoa(int(i))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return []string{describeArrayBoolean(shared.Show{Show: func(coerced any) string {
		return show.ShowBoolean(shared.Convert(coerced))
	}}, array.Append([]int32{}, []int32{2}), ">", 1, shared.Convert2([]bool{true}))}
}

func describeArrayBoolean(showDictionary shared.Show, depths []int32, label string, depth int32, value any) string {
	depths = slices.Clip(depths)
	labelBytes := []byte(label)
	for {
		showDictionaryCaptured := showDictionary
		switch depth {
		case 0:
			return string(labelBytes) + prim.ShowArray(show.ShowInt, depths) + ": " + showDictionaryCaptured.Show(value)
		default:
			showDictionary, depths, labelBytes, depth, value = shared.Show{Show: func(coerced any) string {
				return prim.ShowArray(showDictionaryCaptured.Show, coerced.([]any))
			}}, array.Bounded(append(depths, depth)), append(labelBytes, ">"...), depth-1, []any{value}
			continue
		}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value any) []bool {
	array := value.([]any)
	converted := make([]bool, len(array))
	for index, element := range array {
		converted[index] = element.(bool)
	}
	return converted
}

type Show struct {
	Show func(any) string
}

func Convert2(value []bool) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}
