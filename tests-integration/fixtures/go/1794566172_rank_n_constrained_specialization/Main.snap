// Data/Tuple/tuple.go
package tuple

type TupleInt struct {
	First  int
	Second int
}

type TupleUnit struct {
	First  struct{}
	Second int
}

type Interpreter struct {
	Emit    func(int, int) TupleUnit
	Measure func(string) func(int) TupleInt
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type SceneInt struct {
	ForIdentity          func(shared.InterpreterIdentity) int
	ForST                func(shared.InterpreterST) int
	ForStateTIntIdentity func(tuple.Interpreter) func(int) tuple.TupleInt
}

type SceneUnit struct {
	ForIdentity          func(shared.InterpreterIdentity)
	ForST                func(shared.InterpreterST)
	ForStateTIntIdentity func(tuple.Interpreter) func(int) tuple.TupleUnit
}

var main_ []int = []int{recorded, counted, measured}

var recorded = initializeRecorded()

func initializeRecorded() int {
	total := 0
	result := program.ForST(shared.InterpreterST{Emit: func(value int) {
		total += value
	}, Measure: func(text string) int {
		return direct.CodePointLength(text)
	}})
	return total + result
}

var counted = initializeCounted()

func initializeCounted() int {
	scrutinee := program.ForStateTIntIdentity(tuple.Interpreter{Emit: func(_ int, x int) tuple.TupleUnit {
		return tuple.TupleUnit{First: struct{}{}, Second: x + 1}
	}, Measure: func(_ string) func(int) tuple.TupleInt {
		return func(s int) tuple.TupleInt {
			return tuple.TupleInt{First: 3, Second: s}
		}
	}})(0)
	return scrutinee.Second
}

var measured = initializeMeasured()

func initializeMeasured() int {
	return program.ForIdentity(shared.InterpreterIdentity{Emit: func(_ int) {
	}, Measure: func(text string) int {
		return direct.CodePointLength(text)
	}})
}

var program SceneInt = SceneInt{ForIdentity: func(interpreter shared.InterpreterIdentity) int {
	return programNext(interpreter.Measure("hello")).ForIdentity(interpreter)
}, ForST: func(interpreter shared.InterpreterST) int {
	i := interpreter.Measure("hello")
	return programNext(i).ForST(interpreter)
}, ForStateTIntIdentity: func(interpreter tuple.Interpreter) func(int) tuple.TupleInt {
	f := interpreter.Measure("hello")
	return func(s int) tuple.TupleInt {
		scrutinee := f(s)
		return programNext(scrutinee.First).ForStateTIntIdentity(interpreter)(scrutinee.Second)
	}
}}

func discardNext(run SceneUnit, i int) SceneInt {
	return SceneInt{ForIdentity: func(_ shared.InterpreterIdentity) int {
		return i + 1
	}, ForST: func(interpreter shared.InterpreterST) int {
		run.ForST(interpreter)
		interpreter.Emit(i * 2)
		return i + 1
	}, ForStateTIntIdentity: func(interpreter tuple.Interpreter) func(int) tuple.TupleInt {
		f := run.ForStateTIntIdentity(interpreter)
		return func(s int) tuple.TupleInt {
			scrutinee := f(s)
			scrutinee2 := interpreter.Emit(i*2, scrutinee.Second)
			return tuple.TupleInt{First: i + 1, Second: scrutinee2.Second}
		}
	}}
}

func programNext(width int) SceneInt {
	return discardNext(SceneUnit{ForIdentity: func(interpreter shared.InterpreterIdentity) {
		interpreter.Emit(width)
	}, ForST: func(interpreter shared.InterpreterST) {
		interpreter.Emit(width)
	}, ForStateTIntIdentity: func(interpreter tuple.Interpreter) func(int) tuple.TupleUnit {
		return func(i int) tuple.TupleUnit {
			return interpreter.Emit(width, i)
		}
	}}, width)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}

type InterpreterST struct {
	Emit    func(int)
	Measure func(string) int
}

type InterpreterIdentity struct {
	Emit    func(int)
	Measure func(string) int
}
