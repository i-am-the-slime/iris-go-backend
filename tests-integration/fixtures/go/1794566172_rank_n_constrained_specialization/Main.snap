// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type TupleIntInt struct {
	First  int32
	Second int32
}

type TupleUnitInt struct {
	First  struct{}
	Second int32
}

type Interpreter struct {
	Emit    func(int32) func(int32) TupleUnitInt
	Measure func(string) func(int32) TupleIntInt
}

type SceneInt struct {
	Identity          func(shared.InterpreterIdentity) int32
	ST                func(shared.InterpreterST) int32
	StateTIntIdentity func(Interpreter) func(int32) TupleIntInt
}

type SceneUnit struct {
	Identity          func(shared.InterpreterIdentity)
	ST                func(shared.InterpreterST)
	StateTIntIdentity func(Interpreter) func(int32) TupleUnitInt
}

func Discard(argument SceneUnit, argument2 func(struct{}) SceneInt) SceneInt {
	return SceneInt{Identity: func(interpreter shared.InterpreterIdentity) int32 {
		argument.Identity(interpreter)
		return argument2(struct{}{}).Identity(interpreter)
	}, ST: func(interpreter2 shared.InterpreterST) int32 {
		argument.ST(interpreter2)
		return argument2(struct{}{}).ST(interpreter2)
	}, StateTIntIdentity: func(interpreter3 Interpreter) func(int32) TupleIntInt {
		argument0 := argument.StateTIntIdentity(interpreter3)
		return func(s int32) TupleIntInt {
			scrutinee := argument0(s)
			return argument2(scrutinee.First).StateTIntIdentity(interpreter3)(scrutinee.Second)
		}
	}}
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

var main_ []int32 = []int32{recorded, counted, measured}

var recorded = initializeRecorded()

func initializeRecorded() int32 {
	value := &Ref[int32]{Value: 0}
	value2 := program.ST(shared.InterpreterST{Emit: func(value3 int32) {
		s2 := value.Value
		s_2 := s2 + value3
		modified := StateValue{State: s_2, Value: s_2}
		value.Value = modified.State
	}, Measure: func(text string) int32 {
		return direct.CodePointLength(text)
	}})
	value4 := value.Value
	performed := value4 + value2
	return performed
}

var counted = initializeCounted()

func initializeCounted() int32 {
	scrutinee := program.StateTIntIdentity(tuple.Interpreter{Emit: func(_ int32) func(int32) tuple.TupleUnitInt {
		return func(x int32) tuple.TupleUnitInt {
			return tuple.TupleUnitInt{First: struct{}{}, Second: x + 1}
		}
	}, Measure: func(_ string) func(int32) tuple.TupleIntInt {
		return func(s int32) tuple.TupleIntInt {
			return tuple.TupleIntInt{First: 3, Second: s}
		}
	}})(0)
	return scrutinee.Second
}

var measured int32 = program.Identity(shared.InterpreterIdentity{Emit: func(_ int32) {
}, Measure: func(text string) int32 {
	return direct.CodePointLength(text)
}})

var program tuple.SceneInt = tuple.SceneInt{Identity: func(interpreter shared.InterpreterIdentity) int32 {
	return programArgument1(interpreter.Measure("hello")).Identity(interpreter)
}, ST: func(interpreter2 shared.InterpreterST) int32 {
	value := interpreter2.Measure("hello")
	return programArgument1(value).ST(interpreter2)
}, StateTIntIdentity: func(interpreter3 tuple.Interpreter) func(int32) tuple.TupleIntInt {
	argument0 := interpreter3.Measure("hello")
	return func(s int32) tuple.TupleIntInt {
		scrutinee := argument0(s)
		return programArgument1(scrutinee.First).StateTIntIdentity(interpreter3)(scrutinee.Second)
	}
}}

func programArgument1(width int32) tuple.SceneInt {
	return tuple.Discard(tuple.SceneUnit{Identity: func(interpreter shared.InterpreterIdentity) {
		interpreter.Emit(width)
	}, ST: func(interpreter2 shared.InterpreterST) {
		interpreter2.Emit(width)
	}, StateTIntIdentity: func(interpreter3 tuple.Interpreter) func(int32) tuple.TupleUnitInt {
		return interpreter3.Emit(width)
	}}, func(_ struct{}) tuple.SceneInt {
		value := prim.MultiplyInt32(width, 2)
		return tuple.Discard(tuple.SceneUnit{Identity: func(interpreter4 shared.InterpreterIdentity) {
			interpreter4.Emit(value)
		}, ST: func(interpreter5 shared.InterpreterST) {
			interpreter5.Emit(value)
		}, StateTIntIdentity: func(interpreter6 tuple.Interpreter) func(int32) tuple.TupleUnitInt {
			return interpreter6.Emit(value)
		}}, func(_ struct{}) tuple.SceneInt {
			value2 := width + 1
			return tuple.SceneInt{Identity: func(_ shared.InterpreterIdentity) int32 {
				return value2
			}, ST: func(_ shared.InterpreterST) int32 {
				return value2
			}, StateTIntIdentity: func(_ tuple.Interpreter) func(int32) tuple.TupleIntInt {
				return func(s int32) tuple.TupleIntInt {
					return tuple.TupleIntInt{First: value2, Second: s}
				}
			}}
		})
	})
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type InterpreterST struct {
	Emit    func(int32)
	Measure func(string) int32
}

type InterpreterIdentity struct {
	Emit    func(int32)
	Measure func(string) int32
}
