// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type TupleIntInt struct {
	First  int32
	Second int32
}

type TupleUnitInt struct {
	First  struct{}
	Second int32
}

type Interpreter struct {
	Emit    func(int32, int32) TupleUnitInt
	Measure func(string) func(int32) TupleIntInt
}

type SceneInt struct {
	Identity          func(shared.InterpreterIdentity) int32
	ST                func(shared.InterpreterST) int32
	StateTIntIdentity func(Interpreter) func(int32) TupleIntInt
}

type SceneUnit struct {
	Identity          func(shared.InterpreterIdentity)
	ST                func(shared.InterpreterST)
	StateTIntIdentity func(Interpreter) func(int32) TupleUnitInt
}

func DiscardNext(run SceneUnit, i int32) SceneInt {
	return SceneInt{Identity: func(_ shared.InterpreterIdentity) int32 {
		return i + 1
	}, ST: func(interpreter shared.InterpreterST) int32 {
		run.ST(interpreter)
		interpreter.Emit(i * 2)
		return i + 1
	}, StateTIntIdentity: func(interpreter Interpreter) func(int32) TupleIntInt {
		f := run.StateTIntIdentity(interpreter)
		return func(s int32) TupleIntInt {
			scrutinee := f(s)
			scrutinee2 := interpreter.Emit(i*2, scrutinee.Second)
			return TupleIntInt{First: i + 1, Second: scrutinee2.Second}
		}
	}}
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ []int32 = []int32{recorded, counted, measured}

var recorded = initializeRecorded()

func initializeRecorded() int32 {
	var total int32 = 0
	result := program.ST(shared.InterpreterST{Emit: func(value int32) {
		total += value
	}, Measure: func(text string) int32 {
		return direct.CodePointLength(text)
	}})
	performed := total + result
	return performed
}

var counted = initializeCounted()

func initializeCounted() int32 {
	scrutinee := program.StateTIntIdentity(tuple.Interpreter{Emit: func(_ int32, x int32) tuple.TupleUnitInt {
		return tuple.TupleUnitInt{First: struct{}{}, Second: x + 1}
	}, Measure: func(_ string) func(int32) tuple.TupleIntInt {
		return func(s int32) tuple.TupleIntInt {
			return tuple.TupleIntInt{First: 3, Second: s}
		}
	}})(0)
	return scrutinee.Second
}

var measured = initializeMeasured()

func initializeMeasured() int32 {
	return program.Identity(shared.InterpreterIdentity{Emit: func(_ int32) {
	}, Measure: func(text string) int32 {
		return direct.CodePointLength(text)
	}})
}

var program tuple.SceneInt = tuple.SceneInt{Identity: func(interpreter shared.InterpreterIdentity) int32 {
	return programNext(interpreter.Measure("hello")).Identity(interpreter)
}, ST: func(interpreter shared.InterpreterST) int32 {
	i := interpreter.Measure("hello")
	return programNext(i).ST(interpreter)
}, StateTIntIdentity: func(interpreter tuple.Interpreter) func(int32) tuple.TupleIntInt {
	f := interpreter.Measure("hello")
	return func(s int32) tuple.TupleIntInt {
		scrutinee := f(s)
		return programNext(scrutinee.First).StateTIntIdentity(interpreter)(scrutinee.Second)
	}
}}

func programNext(width int32) tuple.SceneInt {
	return tuple.DiscardNext(tuple.SceneUnit{Identity: func(interpreter shared.InterpreterIdentity) {
		interpreter.Emit(width)
	}, ST: func(interpreter shared.InterpreterST) {
		interpreter.Emit(width)
	}, StateTIntIdentity: func(interpreter tuple.Interpreter) func(int32) tuple.TupleUnitInt {
		return func(i int32) tuple.TupleUnitInt {
			return interpreter.Emit(width, i)
		}
	}}, width)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

type InterpreterST struct {
	Emit    func(int32)
	Measure func(string) int32
}

type InterpreterIdentity struct {
	Emit    func(int32)
	Measure func(string) int32
}
