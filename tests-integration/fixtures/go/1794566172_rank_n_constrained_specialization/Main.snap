		}
		return IdentitySTStateTIntIdentity{Identity: func(interpreter13 EmitMeasure3) int32 {
			argument.Identity(interpreter13)
			return argument2(struct{}{}).Identity(interpreter13)
		}, ST: func(interpreter14 EmitMeasure) int32 {
			argument.ST(interpreter14)
			return argument2(struct{}{}).ST(interpreter14)
		}, StateTIntIdentity: func(interpreter15 EmitMeasure2) func(int32) TupleIntInt {
			return func(s3 int32) TupleIntInt {
				return bindIdentityInt2(argument.StateTIntIdentity(interpreter15), func(value4 struct{}) func(int32) TupleIntInt {
					return argument2(value4).StateTIntIdentity(interpreter15)
				}, s3)
			}
		}}
	}
	return IdentitySTStateTIntIdentity{Identity: func(interpreter16 EmitMeasure3) int32 {
		return argument1(argument0.Identity(interpreter16)).Identity(interpreter16)
	}, ST: func(interpreter17 EmitMeasure) int32 {
		value5 := argument0.ST(interpreter17)
		return argument1(value5).ST(interpreter17)
	}, StateTIntIdentity: func(interpreter18 EmitMeasure2) func(int32) TupleIntInt {
		return func(s4 int32) TupleIntInt {
			return bindIdentityInt(argument0.StateTIntIdentity(interpreter18), func(value6 int32) func(int32) TupleIntInt {
				return argument1(value6).StateTIntIdentity(interpreter18)
			}, s4)
		}
	}}
}

func pureIdentityInt(a int32, s int32) TupleIntInt {
	return TupleIntInt{Tuple0: a, Tuple1: s}
}

func bindIdentityInt(argument0 func(int32) TupleIntInt, argument1 func(int32) func(int32) TupleIntInt, s int32) TupleIntInt {
	scrutinee := argument0(s)
	return argument1(scrutinee.Tuple0)(scrutinee.Tuple1)
}

func compose(f func(TupleUnitInt) TupleUnitInt, g func(int32) TupleUnitInt, x int32) TupleUnitInt {
	return f(g(x))
}

func pure(value TupleUnitInt) TupleUnitInt {
	return value
}

func bindIdentityInt2(argument0 func(int32) TupleUnitInt, argument1 func(struct{}) func(int32) TupleIntInt, s int32) TupleIntInt {
	scrutinee := argument0(s)
	return argument1(scrutinee.Tuple0)(scrutinee.Tuple1)
}

func main() {
	fmt.Println(main_)
