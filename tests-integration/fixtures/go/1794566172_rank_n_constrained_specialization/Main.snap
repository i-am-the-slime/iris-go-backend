)

type Ref[T any] struct {
	Value T
}

type EmitMeasure struct {
	emit    func(int32)
	measure func(string) int32
}

type StateValue struct {
	state int32
	value int32
}

type TupleIntInt struct {
	Tuple0 int32
	Tuple1 int32
}

type TupleUnitInt struct {
	Tuple0 struct{}
	Tuple1 int32
}

type EmitMeasure2 struct {
	emit    func(int32) func(int32) TupleUnitInt
	measure func(string) func(int32) TupleIntInt
}

type EmitMeasure3 struct {
	emit    func(int32)
	measure func(string) int32
}

type IdentitySTStateTIntIdentity struct {
	Identity          func(EmitMeasure3) int32
	ST                func(EmitMeasure) int32
	StateTIntIdentity func(EmitMeasure2) func(int32) TupleIntInt
}

type IdentitySTStateTIntIdentity2 struct {
	Identity          func(EmitMeasure3)
	ST                func(EmitMeasure)
	StateTIntIdentity func(EmitMeasure2) func(int32) TupleUnitInt
}

var main_ []int32 = []int32{recorded, counted, measured}

var recorded = initializeRecorded()

func initializeRecorded() int32 {
	value := &Ref[int32]{Value: 0}
	value2 := program.ST(EmitMeasure{emit: func(value3 int32) {
		s2 := value.Value
		s_2 := s2 + value3
		modified := StateValue{state: s_2, value: s_2}
		value.Value = modified.state
	}, measure: func(text string) int32 {
		return int32(len(direct.ToCodePointArray(nil, nil, text)))
	}})
	value4 := value.Value
	performed := value4 + value2
	return performed
}

var counted = initializeCounted()

func initializeCounted() int32 {
	scrutinee := program.StateTIntIdentity(EmitMeasure2{emit: func(_ int32) func(int32) TupleUnitInt {
		return func(x int32) TupleUnitInt {
			return compose(pure, func(s int32) TupleUnitInt {
				return TupleUnitInt{Tuple0: struct{}{}, Tuple1: s + 1}
			}, x)
		}
	}, measure: func(_ string) func(int32) TupleIntInt {
		return func(s2 int32) TupleIntInt {
			return pureIdentityInt(3, s2)
		}
	}})(0)
	return scrutinee.Tuple1
}

var measured int32 = program.Identity(EmitMeasure3{emit: func(_ int32) {
}, measure: func(text string) int32 {
	return int32(len(direct.ToCodePointArray(nil, nil, text)))
}})

var program = initializeProgram()

