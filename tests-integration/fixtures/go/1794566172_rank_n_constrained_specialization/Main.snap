// Data/Tuple/tuple.go
package tuple

import "fixture/shared"

type TupleIntInt struct {
	Tuple0 int32
	Tuple1 int32
}

type TupleUnitInt struct {
	Tuple0 struct{}
	Tuple1 int32
}

type EmitMeasure struct {
	Emit    func(int32) func(int32) TupleUnitInt
	Measure func(string) func(int32) TupleIntInt
}

type IdentitySTStateTIntIdentity struct {
	Identity          func(shared.EmitMeasure2) int32
	ST                func(shared.EmitMeasure) int32
	StateTIntIdentity func(EmitMeasure) func(int32) TupleIntInt
}

type IdentitySTStateTIntIdentity2 struct {
	Identity          func(shared.EmitMeasure2)
	ST                func(shared.EmitMeasure)
	StateTIntIdentity func(EmitMeasure) func(int32) TupleUnitInt
}

func Discard(argument IdentitySTStateTIntIdentity2, argument2 func(struct{}) IdentitySTStateTIntIdentity) IdentitySTStateTIntIdentity {
	return IdentitySTStateTIntIdentity{Identity: func(interpreter shared.EmitMeasure2) int32 {
		argument.Identity(interpreter)
		return argument2(struct{}{}).Identity(interpreter)
	}, ST: func(interpreter2 shared.EmitMeasure) int32 {
		argument.ST(interpreter2)
		return argument2(struct{}{}).ST(interpreter2)
	}, StateTIntIdentity: func(interpreter3 EmitMeasure) func(int32) TupleIntInt {
		argument0 := argument.StateTIntIdentity(interpreter3)
		return func(s int32) TupleIntInt {
			scrutinee := argument0(s)
			return argument2(scrutinee.Tuple0).StateTIntIdentity(interpreter3)(scrutinee.Tuple1)
		}
	}}
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

var main_ []int32 = []int32{recorded, counted, measured}

var recorded = initializeRecorded()

func initializeRecorded() int32 {
	value := &Ref[int32]{Value: 0}
	value2 := program.ST(shared.EmitMeasure{Emit: func(value3 int32) {
		s2 := value.Value
		s_2 := s2 + value3
		modified := StateValue{State: s_2, Value: s_2}
		value.Value = modified.State
	}, Measure: func(text string) int32 {
		return int32(len(direct.ToCodePointArray(nil, nil, text)))
	}})
	value4 := value.Value
	performed := value4 + value2
	return performed
}

var counted = initializeCounted()

func initializeCounted() int32 {
	scrutinee := program.StateTIntIdentity(tuple.EmitMeasure{Emit: func(_ int32) func(int32) tuple.TupleUnitInt {
		return func(x int32) tuple.TupleUnitInt {
			return tuple.TupleUnitInt{Tuple0: struct{}{}, Tuple1: x + 1}
		}
	}, Measure: func(_ string) func(int32) tuple.TupleIntInt {
		return func(s int32) tuple.TupleIntInt {
			return tuple.TupleIntInt{Tuple0: 3, Tuple1: s}
		}
	}})(0)
	return scrutinee.Tuple1
}

var measured int32 = program.Identity(shared.EmitMeasure2{Emit: func(_ int32) {
}, Measure: func(text string) int32 {
	return int32(len(direct.ToCodePointArray(nil, nil, text)))
}})

var program tuple.IdentitySTStateTIntIdentity = tuple.IdentitySTStateTIntIdentity{Identity: func(interpreter shared.EmitMeasure2) int32 {
	return programArgument1(interpreter.Measure("hello")).Identity(interpreter)
}, ST: func(interpreter2 shared.EmitMeasure) int32 {
	value := interpreter2.Measure("hello")
	return programArgument1(value).ST(interpreter2)
}, StateTIntIdentity: func(interpreter3 tuple.EmitMeasure) func(int32) tuple.TupleIntInt {
	argument0 := interpreter3.Measure("hello")
	return func(s int32) tuple.TupleIntInt {
		scrutinee := argument0(s)
		return programArgument1(scrutinee.Tuple0).StateTIntIdentity(interpreter3)(scrutinee.Tuple1)
	}
}}

func programArgument1(width int32) tuple.IdentitySTStateTIntIdentity {
	return tuple.Discard(tuple.IdentitySTStateTIntIdentity2{Identity: func(interpreter shared.EmitMeasure2) {
		interpreter.Emit(width)
	}, ST: func(interpreter2 shared.EmitMeasure) {
		interpreter2.Emit(width)
	}, StateTIntIdentity: func(interpreter3 tuple.EmitMeasure) func(int32) tuple.TupleUnitInt {
		return interpreter3.Emit(width)
	}}, func(_ struct{}) tuple.IdentitySTStateTIntIdentity {
		value := prim.MultiplyInt32(width, 2)
		return tuple.Discard(tuple.IdentitySTStateTIntIdentity2{Identity: func(interpreter4 shared.EmitMeasure2) {
			interpreter4.Emit(value)
		}, ST: func(interpreter5 shared.EmitMeasure) {
			interpreter5.Emit(value)
		}, StateTIntIdentity: func(interpreter6 tuple.EmitMeasure) func(int32) tuple.TupleUnitInt {
			return interpreter6.Emit(value)
		}}, func(_ struct{}) tuple.IdentitySTStateTIntIdentity {
			value2 := width + 1
			return tuple.IdentitySTStateTIntIdentity{Identity: func(_ shared.EmitMeasure2) int32 {
				return value2
			}, ST: func(_ shared.EmitMeasure) int32 {
				return value2
			}, StateTIntIdentity: func(_ tuple.EmitMeasure) func(int32) tuple.TupleIntInt {
				return func(s int32) tuple.TupleIntInt {
					return tuple.TupleIntInt{Tuple0: value2, Tuple1: s}
				}
			}}
		})
	})
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type EmitMeasure struct {
	Emit    func(int32)
	Measure func(string) int32
}

type EmitMeasure2 struct {
	Emit    func(int32)
	Measure func(string) int32
}
