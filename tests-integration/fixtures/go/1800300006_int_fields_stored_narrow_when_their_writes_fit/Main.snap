// main.go
package main

import (
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Tally struct {
	Tally1 *Tally
	Tally0 int
}

var sharedTallyDone = &Tally{}

type Ladder struct {
	Rung2 *Ladder
	Rung0 int32
	Rung1 int32
}

var sharedLadderGround = &Ladder{}

type Span struct {
	Span1 *Span
	Span0 int
}

var sharedSpanClosed = &Span{}

func TallyTally(tally0 int, tally1 *Tally) *Tally {
	return &Tally{Tally0: tally0, Tally1: tally1}
}

func Rung(rung0 int, rung1 int, rung2 *Ladder) *Ladder {
	return &Ladder{Rung0: int32(rung0), Rung1: int32(rung1), Rung2: rung2}
}

func main() {
	ladder := climb(100)
	journal.Log(strconv.Itoa(spread(ladder)))
	journal.Log(strconv.Itoa(spread(swapped(ladder))))
	number, found := prim.IntFromStringAs(10, "41")
	if !found {
		number = 0
	}
	journal.Log(strconv.Itoa(counted(TallyTally(number, TallyTally(number+1, sharedTallyDone)))))
	journal.Log(strconv.Itoa(measured(stretched(100))))
}

func climb(n int) *Ladder {
	return climbGo(sharedLadderGround, n)
}

func spread(value *Ladder) int {
	return spreadGo(0, value)
}

func swapped(value *Ladder) *Ladder {
	if value != sharedLadderGround {
		return Rung(int(value.Rung1), int(value.Rung0), swapped(value.Rung2))
	}
	return sharedLadderGround
}

func counted(value *Tally) int {
	if value != sharedTallyDone {
		return value.Tally0 + counted(value.Tally1)
	}
	return 0
}

func measured(value *Span) int {
	return measuredGo(0, value)
}

func stretched(n int) *Span {
	return stretchedGo(sharedSpanClosed, n)
}

func climbGo(ladder *Ladder, n int) *Ladder {
	var ladderCells alloc.Cells[Ladder]
	for {
		if n <= 0 {
			return ladder
		}
		ladder, n = ladderCells.New(Ladder{Rung0: int32(n), Rung1: int32(n * 3), Rung2: ladder}), n-1
	}
}

func spreadGo(total int, value *Ladder) int {
	for {
		if value != sharedLadderGround {
			low := int(value.Rung0)
			high := int(value.Rung1)
			rest := value.Rung2
			total, value = total+high-low, rest
			continue
		}
		return total
	}
}

func measuredGo(total int, value *Span) int {
	for {
		if value != sharedSpanClosed {
			width := value.Span0
			rest := value.Span1
			total, value = total+width, rest
			continue
		}
		return total
	}
}

func stretchedGo(span *Span, n int) *Span {
	var spanCells alloc.Cells[Span]
	for {
		if n <= 0 {
			return span
		}
		span, n = spanCells.New(Span{Span0: n * 100000000, Span1: span}), n-1
	}
}
