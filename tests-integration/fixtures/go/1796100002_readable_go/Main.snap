// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	strconvpkg "strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	counts := array.RangeInt32(1, 3)
	text := string(show.AppendShowArrayInt(nil, counts))
	mapped := make([]string, len(counts))
	for index, element := range counts {
		mapped[index] = describe(element)
	}
	codeUnitIndexOf := prim.CodeUnitIndexOf(func(payload int32) maybe.Int {
		return maybe.Int(payload)
	}, maybe.NoInt, "-", text)
	result2 := codeUnitIndexOf != maybe.NoInt
	var result []string
	if result2 {
		result = strings.Split(text, "-")
	} else {
		result = []string{text}
	}
	mapped2 := make([]string, len(counts))
	for index, element := range counts {
		mapped2[index] = lengths(element)
	}
	mapped3 := make([]string, len(counts))
	for index, count := range counts {
		var discount float64
		if count >= 10 {
			discount = 0.15
		} else {
			discount = 0.0
		}
		mapped3[index] = prim.ShowNumber(1.0 - discount)
	}
	return array.Append(mapped, array.Append(result, array.Append(mapped2, mapped3)))
}

func describe(count int32) string {
	return "count " + strconvpkg.Itoa(int(count)) + ", many " + strconvpkg.FormatBool(count > 1)
}

func lengths(n int32) string {
	strconv := array.Snoc(array.RangeInt32(1, n), int32(9))
	text := strconvpkg.AppendInt(nil, int64(int32(len(strconv))), 10)
	text = show.AppendShowArrayInt(text, strconv)
	return string(text)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
