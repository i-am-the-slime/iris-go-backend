// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int
	Tag    uint8
}

const (
	ExprAdd = iota
	ExprMul
	ExprVal
)

func Val(val int) *Expr {
	return &Expr{Tag: ExprVal, Val: val}
}

func Add(field0 *Expr, field1 *Expr) *Expr {
	return &Expr{Tag: ExprAdd, Field0: field0, Field1: field1}
}

func Mul(field0 *Expr, field1 *Expr) *Expr {
	return &Expr{Tag: ExprMul, Field0: field0, Field1: field1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	tree := expression(4)
	tree2 := expression(4)
	tree3 := expression(4)
	argument := strconv.Itoa(evaluate(tree3)) + " then "
	argument2 := strconv.Itoa(evaluate(tree)) + " then "
	tree4 := expression(4)
	return []string{argument + strconv.Itoa(evaluate(doubledReusing(tree3))), argument2 + strconv.Itoa(evaluate(swappedReusing(doubledReusing(tree)))), strconv.Itoa(evaluate(doubled(tree2))) + " before " + strconv.Itoa(evaluate(tree2)), strconv.Itoa(evaluate(doubled(tree4))*100000 + evaluate(tree4))}
}

func expression(depth int) *Expr {
	var cells alloc.Cells[Expr]
	return expressionChunked(depth, &cells)
}

func expressionChunked(depth int, cells *alloc.Cells[Expr]) *Expr {
	if depth == 0 {
		return cells.New(Expr{Tag: ExprVal, Val: 1})
	}
	return cells.New(Expr{Tag: ExprAdd, Field0: expressionChunked(depth-1, cells), Field1: cells.New(Expr{Tag: ExprMul, Field0: cells.New(Expr{Tag: ExprVal, Val: depth}), Field1: expressionChunked(depth-1, cells)})})
}

func evaluate(value *Expr) int {
	switch value.Tag {
	case ExprVal:
		return value.Val
	case ExprAdd:
		return evaluate(value.Field0) + evaluate(value.Field1)
	default: // ExprMul
		return evaluate(value.Field0) * evaluate(value.Field1)
	}
}

func doubled(value *Expr) *Expr {
	switch value.Tag {
	case ExprVal:
		return Val(value.Val * 2)
	case ExprAdd:
		return Add(doubled(value.Field0), doubled(value.Field1))
	default: // ExprMul
		return Mul(doubled(value.Field0), doubled(value.Field1))
	}
}

func swappedReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprAdd, ExprMul:
		left := value.Field0
		right := value.Field1
		field := swappedReusing(right)
		field2 := swappedReusing(left)
		value.Field0 = field
		value.Field1 = field2
		return value
	default:
		return value
	}
}

func doubledReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprVal:
		value2 := value.Val
		value.Val = value2 * 2
		return value
	case ExprAdd:
		left := value.Field0
		right := value.Field1
		field := doubledReusing(left)
		field2 := doubledReusing(right)
		value.Field0 = field
		value.Field1 = field2
		return value
	default: // ExprMul
		left := value.Field0
		right := value.Field1
		field := doubledReusing(left)
		field2 := doubledReusing(right)
		value.Field0 = field
		value.Field1 = field2
		return value
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
