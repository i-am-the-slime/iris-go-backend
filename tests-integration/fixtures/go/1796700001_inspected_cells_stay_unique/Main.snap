// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int32
	Tag    uint8
}

const (
	ExprAdd = iota
	ExprMul
	ExprVal
)

func Val(val int32) *Expr {
	return &Expr{Tag: ExprVal, Val: val}
}

func Add(field0 *Expr, field1 *Expr) *Expr {
	return &Expr{Tag: ExprAdd, Field0: field0, Field1: field1}
}

func Mul(field0 *Expr, field1 *Expr) *Expr {
	return &Expr{Tag: ExprMul, Field0: field0, Field1: field1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	tree := expression(4)
	tree2 := expression(4)
	tree3 := expression(4)
	argument := strconv.Itoa(int(evaluate(tree3))) + " then "
	argument2 := strconv.Itoa(int(evaluate(tree))) + " then "
	tree4 := expression(4)
	return []string{argument + strconv.Itoa(int(evaluate(doubledReusing(tree3)))), argument2 + strconv.Itoa(int(evaluate(swappedReusing(doubledReusing(tree))))), strconv.Itoa(int(evaluate(doubled(tree2)))) + " before " + strconv.Itoa(int(evaluate(tree2))), strconv.Itoa(int(evaluate(doubled(tree4))*100000 + evaluate(tree4)))}
}

func expression(depth int32) *Expr {
	if depth == 0 {
		return Val(1)
	}
	exprs := make([]Expr, 3)
	exprs[0] = Expr{Tag: ExprAdd, Field0: expression(depth - 1), Field1: &exprs[1]}
	exprs[1] = Expr{Tag: ExprMul, Field0: &exprs[2], Field1: expression(depth - 1)}
	exprs[2] = Expr{Tag: ExprVal, Val: depth}
	return &exprs[0]
}

func evaluate(value *Expr) int32 {
	switch value.Tag {
	case ExprVal:
		return value.Val
	case ExprAdd:
		return evaluate(value.Field0) + evaluate(value.Field1)
	default: // ExprMul
		return evaluate(value.Field0) * evaluate(value.Field1)
	}
}

func doubled(value *Expr) *Expr {
	switch value.Tag {
	case ExprVal:
		return Val(value.Val * 2)
	case ExprAdd:
		return Add(doubled(value.Field0), doubled(value.Field1))
	default: // ExprMul
		return Mul(doubled(value.Field0), doubled(value.Field1))
	}
}

func swappedReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprAdd:
		left := value.Field0
		right := value.Field1
		field := swappedReusing(right)
		field2 := swappedReusing(left)
		value.Field0 = field
		value.Field1 = field2
		return value
	case ExprMul:
		left := value.Field0
		right := value.Field1
		field := swappedReusing(right)
		field2 := swappedReusing(left)
		value.Field0 = field
		value.Field1 = field2
		return value
	default:
		return value
	}
}

func doubledReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprVal:
		value2 := value.Val
		value.Val = value2 * 2
		return value
	case ExprAdd:
		left := value.Field0
		right := value.Field1
		field := doubledReusing(left)
		field2 := doubledReusing(right)
		value.Field0 = field
		value.Field1 = field2
		return value
	default: // ExprMul
		left := value.Field0
		right := value.Field1
		field := doubledReusing(left)
		field2 := doubledReusing(right)
		value.Field0 = field
		value.Field1 = field2
		return value
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
