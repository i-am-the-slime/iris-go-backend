// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type Expr struct {
	Field0 *Expr
	Field1 *Expr
	Val    int32
	Tag    uint8
}

const (
	ExprAdd = iota
	ExprMul
	ExprVal
)

var main_ = initializeMain_()

func initializeMain_() []string {
	tree := expression(4)
	tree2 := expression(4)
	tree3 := expression(4)
	argument := strconv.Itoa(int(evaluate(tree3))) + " then "
	argument2 := strconv.Itoa(int(evaluate(tree))) + " then "
	tree4 := expression(4)
	return []string{argument + strconv.Itoa(int(evaluate(doubledReusing(tree3)))), argument2 + strconv.Itoa(int(evaluate(swappedReusing(doubledReusing(tree))))), strconv.Itoa(int(evaluate(doubled(tree2)))) + " before " + strconv.Itoa(int(evaluate(tree2))), strconv.Itoa(int(evaluate(doubled(tree4))*100000 + evaluate(tree4)))}
}

func expression(depth int32) *Expr {
	if depth == 0 {
		return &Expr{Tag: ExprVal, Val: 1}
	}
	exprs := make([]Expr, 3)
	exprs[0] = Expr{Tag: ExprAdd, Field0: expression(depth - 1), Field1: &exprs[1]}
	exprs[1] = Expr{Tag: ExprMul, Field0: &exprs[2], Field1: expression(depth - 1)}
	exprs[2] = Expr{Tag: ExprVal, Val: depth}
	return &exprs[0]
}

func evaluate(value *Expr) int32 {
	switch value.Tag {
	case ExprVal:
		return value.Val
	case ExprAdd:
		return evaluate(value.Field0) + evaluate(value.Field1)
	default: // ExprMul
		return evaluate(value.Field0) * evaluate(value.Field1)
	}
}

func doubled(value *Expr) *Expr {
	switch value.Tag {
	case ExprVal:
		return &Expr{Tag: ExprVal, Val: value.Val * 2}
	case ExprAdd:
		return &Expr{Tag: ExprAdd, Field0: doubled(value.Field0), Field1: doubled(value.Field1)}
	default: // ExprMul
		return &Expr{Tag: ExprMul, Field0: doubled(value.Field0), Field1: doubled(value.Field1)}
	}
}

func swappedReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprAdd:
		left := value.Field0
		right := value.Field1
		*value = Expr{Tag: ExprAdd, Field0: swappedReusing(right), Field1: swappedReusing(left)}
		return value
	case ExprMul:
		left := value.Field0
		right := value.Field1
		*value = Expr{Tag: ExprMul, Field0: swappedReusing(right), Field1: swappedReusing(left)}
		return value
	default:
		return value
	}
}

func doubledReusing(value *Expr) *Expr {
	switch value.Tag {
	case ExprVal:
		value2 := value.Val
		*value = Expr{Tag: ExprVal, Val: value2 * 2}
		return value
	case ExprAdd:
		left := value.Field0
		right := value.Field1
		*value = Expr{Tag: ExprAdd, Field0: doubledReusing(left), Field1: doubledReusing(right)}
		return value
	default: // ExprMul
		left := value.Field0
		right := value.Field1
		*value = Expr{Tag: ExprMul, Field0: doubledReusing(left), Field1: doubledReusing(right)}
		return value
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
