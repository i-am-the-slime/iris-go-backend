// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/exception"
)

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
	Tag   uint8
}

const (
	ListIntNil = iota
	ListIntCons
)

type MainResult struct {
	Largest      *ListInt
	Numbers      *ListInt
	OwnedLargest *ListInt
	Total        int32
}

var sharedListIntNil = &ListInt{Tag: ListIntNil}

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int32
	Tag   uint8
}

const (
	TreeLeaf = iota
	TreeNode
)

var sharedTreeLeaf = &Tree{Tag: TreeLeaf}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	defer exception.ReportUncaught()
	numbers := mainGo(20, sharedListIntNil)
	return MainResult{Numbers: numbers, Largest: largestReplacesItsCell(numbers), OwnedLargest: largestReplacesItsCellReusing(mainGo(10, sharedListIntNil)), Total: total(mainGo2(5, sharedTreeLeaf))}
}

func largestReplacesItsCell(list *ListInt) *ListInt {
	return largestReplacesItsCellGo(sharedListIntNil, list)
}

func total(tree *Tree) int32 {
	switch tree.Tag {
	case TreeLeaf:
		return 0
	default: // TreeNode
		return total(tree.Node0) + tree.Node1 + total(tree.Node2)
	}
}

func mainGo(current int32, accumulator *ListInt) *ListInt {
	var listIntCells alloc.Cells[ListInt]
	for {
		if current < 1 {
			return accumulator
		}
		current, accumulator = current - 1, listIntCells.New(ListInt{Tag: ListIntCons, Cons0: current, Cons1: accumulator})
	}
}

func mainGo2(remaining int32, tree *Tree) *Tree {
	var treeCells alloc.Cells[Tree]
	for {
		if remaining <= 0 {
			return tree
		}
		remaining, tree = remaining - 1, treeCells.New(Tree{Tag: TreeNode, Node0: tree, Node1: remaining, Node2: treeCells.New(Tree{Tag: TreeNode, Node0: sharedTreeLeaf, Node1: remaining * 2, Node2: sharedTreeLeaf})})
	}
}

func largestReplacesItsCellGo(best *ListInt, list *ListInt) *ListInt {
	for {
		switch list.Tag {
		case ListIntNil:
			return best
		default: // ListIntCons
			value := list.Cons0
			rest := list.Cons1
			if best.Tag == ListIntCons {
				known := best.Cons0
				if known >= value {
					list = rest
					continue
				}
			}
			best, list = &ListInt{Tag: ListIntCons, Cons0: value, Cons1: sharedListIntNil}, rest
			continue
		}
	}
}

func largestReplacesItsCellReusing(list *ListInt) *ListInt {
	return largestReplacesItsCellGoReusing(sharedListIntNil, list)
}

func largestReplacesItsCellGoReusing(best *ListInt, list *ListInt) *ListInt {
	for {
		switch list.Tag {
		case ListIntNil:
			return best
		default: // ListIntCons
			value := list.Cons0
			rest := list.Cons1
			if best.Tag == ListIntCons {
				known := best.Cons0
				if known >= value {
					list = rest
					continue
				}
			}
			*list = ListInt{Tag: ListIntCons, Cons0: value, Cons1: sharedListIntNil}
			best, list = list, rest
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
