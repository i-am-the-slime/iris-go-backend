// main.go
package main

import "github.com/i-am-the-slime/iris-go/alloc"

type List struct {
	Cons1 *List
	Cons0 int32
}

var sharedListNil = &List{}

type MainResult struct {
	Largest      *List
	Numbers      *List
	OwnedLargest *List
	Total        int32
}

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int32
}

var sharedTreeLeaf = &Tree{}

func Cons(cons0 int32, cons1 *List) *List {
	return &List{Cons0: cons0, Cons1: cons1}
}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	numbers := mainGo(20, sharedListNil)
	return MainResult{Numbers: numbers, Largest: largestReplacesItsCell(numbers), OwnedLargest: largestReplacesItsCellReusing(mainGo(10, sharedListNil)), Total: total(mainGo2(5, sharedTreeLeaf))}
}

func largestReplacesItsCell(list *List) *List {
	return largestReplacesItsCellGo(sharedListNil, list)
}

func total(tree *Tree) int32 {
	if tree == sharedTreeLeaf {
		return 0
	}
	return total(tree.Node0) + tree.Node1 + total(tree.Node2)
}

func mainGo(current int32, accumulator *List) *List {
	var listIntCells alloc.Cells[List]
	for {
		if current < 1 {
			return accumulator
		}
		current, accumulator = current-1, listIntCells.New(List{Cons0: current, Cons1: accumulator})
	}
}

func mainGo2(remaining int32, tree *Tree) *Tree {
	var treeCells alloc.Cells[Tree]
	for {
		if remaining <= 0 {
			return tree
		}
		remaining, tree = remaining-1, treeCells.New(Tree{Node0: tree, Node1: remaining, Node2: treeCells.New(Tree{Node0: sharedTreeLeaf, Node1: remaining * 2, Node2: sharedTreeLeaf})})
	}
}

func largestReplacesItsCellGo(best *List, list *List) *List {
	for {
		if list == sharedListNil {
			return best
		}
		value := list.Cons0
		rest := list.Cons1
		if best != sharedListNil {
			known := best.Cons0
			if known >= value {
				list = rest
				continue
			}
		}
		best, list = Cons(value, sharedListNil), rest
	}
}

func largestReplacesItsCellReusing(list *List) *List {
	return largestReplacesItsCellGoReusing(sharedListNil, list)
}

func largestReplacesItsCellGoReusing(best *List, list *List) *List {
	for {
		if list == sharedListNil {
			return best
		}
		value := list.Cons0
		rest := list.Cons1
		if best != sharedListNil {
			known := best.Cons0
			if known >= value {
				list = rest
				continue
			}
		}
		list.Cons1 = sharedListNil
		best, list = list, rest
	}
}

func main() {
	_ = main_
}

// note: the entry's value of type { largest, numbers, ownedLargest, total } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
