// main.go
package main

import "github.com/i-am-the-slime/iris-go/alloc"

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
}

var sharedListIntNil = &ListInt{}

type MainResult struct {
	Largest      *ListInt
	Numbers      *ListInt
	OwnedLargest *ListInt
	Total        int32
}

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int32
}

var sharedTreeLeaf = &Tree{}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	numbers := mainGo(20, sharedListIntNil)
	return MainResult{Numbers: numbers, Largest: largestReplacesItsCell(numbers), OwnedLargest: largestReplacesItsCellReusing(mainGo(10, sharedListIntNil)), Total: total(mainGo2(5, sharedTreeLeaf))}
}

func largestReplacesItsCell(list *ListInt) *ListInt {
	return largestReplacesItsCellGo(sharedListIntNil, list)
}

func total(tree *Tree) int32 {
	if tree == sharedTreeLeaf {
		return 0
	}
	return total(tree.Node0) + tree.Node1 + total(tree.Node2)
}

func mainGo(current int32, accumulator *ListInt) *ListInt {
	var listIntCells alloc.Cells[ListInt]
	for {
		if current < 1 {
			return accumulator
		}
		current, accumulator = current-1, listIntCells.New(ListInt{Cons0: current, Cons1: accumulator})
	}
}

func mainGo2(remaining int32, tree *Tree) *Tree {
	var treeCells alloc.Cells[Tree]
	for {
		if remaining <= 0 {
			return tree
		}
		remaining, tree = remaining-1, treeCells.New(Tree{Node0: tree, Node1: remaining, Node2: treeCells.New(Tree{Node0: sharedTreeLeaf, Node1: remaining * 2, Node2: sharedTreeLeaf})})
	}
}

func largestReplacesItsCellGo(best *ListInt, list *ListInt) *ListInt {
	for {
		if list == sharedListIntNil {
			return best
		}
		value := list.Cons0
		rest := list.Cons1
		if best != sharedListIntNil {
			known := best.Cons0
			if known >= value {
				list = rest
				continue
			}
		}
		best, list = &ListInt{Cons0: value, Cons1: sharedListIntNil}, rest
	}
}

func largestReplacesItsCellReusing(list *ListInt) *ListInt {
	return largestReplacesItsCellGoReusing(sharedListIntNil, list)
}

func largestReplacesItsCellGoReusing(best *ListInt, list *ListInt) *ListInt {
	for {
		if list == sharedListIntNil {
			return best
		}
		value := list.Cons0
		rest := list.Cons1
		if best != sharedListIntNil {
			known := best.Cons0
			if known >= value {
				list = rest
				continue
			}
		}
		list.Cons1 = sharedListIntNil
		best, list = list, rest
	}
}

func main() {
	_ = main_
}

// note: the entry's value of type { largest, numbers, ownedLargest, total } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
