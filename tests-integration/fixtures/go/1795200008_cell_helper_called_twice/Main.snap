// Control/Monad/Rec/Class/class.go
package class

type Step struct {
	Done struct{}
	Loop int32
	Tag  uint8
}

const (
	StepLoop = iota
	StepDone
)

func Loop(loop int) Step {
	return Step{Tag: StepLoop, Loop: int32(loop)}
}

func Done(done struct{}) Step {
	return Step{Tag: StepDone, Done: done}
}

// main.go
package main

import (
	"fixture/Control/Monad/Rec/Class"
	"fixture/shared"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	total := 0
	total += 1
	ref := class.Loop(2)
	for {
		var result bool
		switch ref.Tag {
		case class.StepLoop:
			result = true
		default:
			result = false
		}
		if !result {
			break
		}
		switch ref.Tag {
		case class.StepLoop:
			a_ := int(ref.Loop)
			var step class.Step
			if a_ > 10 {
				step = class.Done(struct{}{})
			} else {
				total += a_
				step = class.Loop(a_ + 1)
			}
			ref = step
		default: // class.StepDone
		}
	}
	return shared.MainResult{Total: total, Scaled: []int{41, 42}}
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Scaled []int
	Total  int
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}

// note: the entry's value of type { scaled, total } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
