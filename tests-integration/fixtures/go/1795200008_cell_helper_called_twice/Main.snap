// Control/Monad/Rec/Class/class.go
package class

type StepIntUnit struct {
	Done struct{}
	Loop int32
	Tag  uint8
}

const (
	StepIntUnitLoop = iota
	StepIntUnitDone
)

// main.go
package main

import (
	"fixture/Control/Monad/Rec/Class"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	var total int32 = 0
	var step class.StepIntUnit
	if false {
		step = class.StepIntUnit{Tag: class.StepIntUnitDone, Done: struct{}{}}
	} else {
		total += 1
		step = class.StepIntUnit{Tag: class.StepIntUnitLoop, Loop: 2}
	}
	for {
		var result bool
		switch step.Tag {
		case class.StepIntUnitLoop:
			result = true
		default:
			result = false
		}
		if !result {
			break
		}
		switch step.Tag {
		case class.StepIntUnitLoop:
			a_ := step.Loop
			var step2 class.StepIntUnit
			if a_ > 10 {
				step2 = class.StepIntUnit{Tag: class.StepIntUnitDone, Done: struct{}{}}
			} else {
				total += a_
				step2 = class.StepIntUnit{Tag: class.StepIntUnitLoop, Loop: a_ + 1}
			}
			step = step2
		default: // class.StepIntUnitDone
		}
	}
	return shared.MainResult{Total: total, Scaled: []int32{mainScale(1), mainScale(2)}}
}

func mainScale(x int32) int32 {
	return 40 + x
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	Scaled []int32
	Total  int32
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
