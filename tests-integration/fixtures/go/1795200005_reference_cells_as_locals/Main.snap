// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

func main_() int32 {
	ref := &shared.Ref[int32]{Value: 0}
	drain(ref, 3)
	i := ref.Value
	var ref2 int32 = 0
	var ref3 int32 = 0
	for {
		continuing := ref3 < 4
		if !continuing {
			break
		}
		s_ := ref2 + ref3
		ref2 = s_
		written := ref3 + 1
		ref3 = written
	}
	for i2 := int32(0); i2 < 4; i2++ {
		s_ := ref2 + i2
		ref2 = s_
	}
	var ref4 int32 = 0
	array.Foldr(func(x int32, b func()) func() {
		return func() {
			s_ := ref4 + x
			ref4 = s_
			b()
		}
	}, func() {
	}, []int32{1, 2})()
	return ref2 + ref4 + i
}

func drain(cell *shared.Ref[int32], n int32) {
	for {
		if n <= 0 {
			return
		}
		s := cell.Value
		s_ := s + n
		cell.Value = s_
		n -= 1
	}
}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
