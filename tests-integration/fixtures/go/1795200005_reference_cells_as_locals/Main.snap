// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"os"
)

func main_() int32 {
	hits := &shared.Ref[int32]{Value: 0}
	drain(hits, 3)
	hits2 := hits.Value
	var total int32 = 0
	var index int32 = 0
	for {
		continuing := index < 4
		if !continuing {
			break
		}
		total += index
		index += 1
	}
	for i := int32(0); i < 4; i++ {
		total += i
	}
	var total2 int32 = 0
	array.Foldr(func(x int32, b func()) func() {
		return func() {
			total2 += x
			b()
		}
	}, func() {
	}, []int32{1, 2})()
	return total + total2 + hits2
}

func drain(cell *shared.Ref[int32], n int32) {
	for {
		if n <= 0 {
			return
		}
		s := cell.Value
		s_ := s + n
		cell.Value = s_
		n -= 1
	}
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
