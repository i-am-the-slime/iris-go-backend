// main.go
package main

import (
	"fixture/shared"
	"os"
)

func main_() int {
	hits := &shared.Ref[int]{Value: 0}
	drain(hits, 3)
	hits2 := hits.Value
	total := 0
	index := 0
	for {
		continuing := index < 4
		if !continuing {
			break
		}
		total += index
		index += 1
	}
	for i := 0; i < 4; i++ {
		total += i
	}
	total2 := 0
	for _, i := range []int{1, 2} {
		total2 += i
	}
	return total + total2 + hits2
}

func drain(cell *shared.Ref[int], n int) {
	cellValue := cell.Value
	for {
		if n <= 0 {
			cell.Value = cellValue
			return
		}
		s := cellValue
		s_ := s + n
		cellValue = s_
		n -= 1
	}
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
