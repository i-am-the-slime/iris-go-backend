// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type Either struct {
	Left  exception.Error
	Right any
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Left(left exception.Error) Either {
	return Either{Tag: EitherLeft, Left: left}
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

// Foreign/foreign.go
package foreign

import (
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"math/big"
	"strconv"
)

type ForeignError struct {
	Field0           string
	Field1           string
	ErrorAtIndex1    *ForeignError
	ErrorAtProperty0 string
	ErrorAtProperty1 *ForeignError
	ErrorAtIndex0    int32
	Tag              uint8
}

const (
	ForeignErrorForeignError2 = iota
	ForeignErrorTypeMismatch
	ForeignErrorErrorAtIndex
	ForeignErrorErrorAtProperty
)

type ListForeignError struct {
	Cons0 *ForeignError
	Cons1 *ListForeignError
}

var SharedListForeignErrorNil = &ListForeignError{}

type NonEmpty struct {
	First  *ForeignError
	Second *ListForeignError
}

func ShowNonEmptyListForeignError(errors NonEmpty) string {
	shown := []string{Show(errors.First)}
	cell := errors.Second
	for {
		if cell == SharedListForeignErrorNil {
			break
		}
		shown = append(shown, Show(cell.Cons0))
		cell = cell.Cons1
	}
	return foreignvalue.ShowErrors(shown)
}

type EitherInt struct {
	Left  NonEmpty
	Right int
	Tag   uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type EitherChar struct {
	Left  NonEmpty
	Right rune
	Tag   uint8
}

const (
	EitherCharLeft = iota
	EitherCharRight
)

type EitherForeign struct {
	Left  NonEmpty
	Right any
	Tag   uint8
}

const (
	EitherForeignLeft = iota
	EitherForeignRight
)

type EitherBigInt struct {
	Left  NonEmpty
	Right *big.Int
	Tag   uint8
}

const (
	EitherBigIntLeft = iota
	EitherBigIntRight
)

type ListListForeignError struct {
	Cons0 *ListForeignError
	Cons1 *ListListForeignError
}

var SharedListListForeignErrorNil = &ListListForeignError{}

type NonEmptyFailure struct {
	Failed bool
	Left   NonEmpty
}

func TypeMismatch(field0 string, field1 string) *ForeignError {
	return &ForeignError{Tag: ForeignErrorTypeMismatch, Field0: field0, Field1: field1}
}

func LeftEitherInt(left NonEmpty) EitherInt {
	return EitherInt{Tag: EitherIntLeft, Left: left}
}

func RightEitherInt(right int) EitherInt {
	return EitherInt{Tag: EitherIntRight, Right: right}
}

func ForeignErrorForeignError(field0 string) *ForeignError {
	return &ForeignError{Tag: ForeignErrorForeignError2, Field0: field0}
}

func LeftEitherForeign(left NonEmpty) EitherForeign {
	return EitherForeign{Tag: EitherForeignLeft, Left: left}
}

func RightEitherBigInt(right *big.Int) EitherBigInt {
	return EitherBigInt{Tag: EitherBigIntRight, Right: right}
}

func LeftEitherBigInt(left NonEmpty) EitherBigInt {
	return EitherBigInt{Tag: EitherBigIntLeft, Left: left}
}

func Cons(cons0 *ForeignError, cons1 *ListForeignError) *ListForeignError {
	return &ListForeignError{Cons0: cons0, Cons1: cons1}
}

func ErrorAtProperty(errorAtProperty0 string, errorAtProperty1 *ForeignError) *ForeignError {
	return &ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: errorAtProperty0, ErrorAtProperty1: errorAtProperty1}
}

func Show(foreignError *ForeignError) string {
	return string(AppendShow(nil, foreignError))
}

func Alt(bigInt *big.Int, err NonEmptyFailure, either EitherBigInt) (*big.Int, NonEmptyFailure) {
	if err.Failed {
		switch either.Tag {
		case EitherBigIntRight:
			return either.Right, NonEmptyFailure{}
		default: // EitherBigIntLeft
			return nil, NonEmptyFailure{Failed: true, Left: NonEmpty{First: err.Left.First, Second: AltGoIdentityReusing(Cons(either.Left.First, either.Left.Second), AltGoIdentity(SharedListForeignErrorNil, err.Left.Second))}}
		}
	}
	return bigInt, NonEmptyFailure{}
}

func Pure(x any) EitherForeign {
	return EitherForeign{Tag: EitherForeignRight, Right: x}
}

func AltGoIdentity(acc *ListForeignError, list *ListForeignError) *ListForeignError {
	var listForeignErrorCells alloc.Cells[ListForeignError]
	for {
		if list == SharedListForeignErrorNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		acc, list = listForeignErrorCells.New(ListForeignError{Cons0: x, Cons1: acc}), xs
	}
}

func AltGoIdentityReusing(acc *ListForeignError, list *ListForeignError) *ListForeignError {
	for {
		if list == SharedListForeignErrorNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

func AppendShow(buffer []byte, foreignError *ForeignError) []byte {
	switch foreignError.Tag {
	case ForeignErrorForeignError2:
		buffer = append(buffer, "(ForeignError "...)
		buffer = prim.AppendShowString(buffer, foreignError.Field0)
		buffer = append(buffer, ')')
	case ForeignErrorErrorAtIndex:
		buffer = append(buffer, "(ErrorAtIndex "...)
		buffer = strconv.AppendInt(buffer, int64(int(foreignError.ErrorAtIndex0)), 10)
		buffer = append(buffer, ' ')
		buffer = AppendShow(buffer, foreignError.ErrorAtIndex1)
		buffer = append(buffer, ')')
	case ForeignErrorErrorAtProperty:
		buffer = append(buffer, "(ErrorAtProperty "...)
		buffer = prim.AppendShowString(buffer, foreignError.ErrorAtProperty0)
		buffer = append(buffer, ' ')
		buffer = AppendShow(buffer, foreignError.ErrorAtProperty1)
		buffer = append(buffer, ')')
	default: // ForeignErrorTypeMismatch
		buffer = append(buffer, "(TypeMismatch "...)
		buffer = prim.AppendShowString(buffer, foreignError.Field0)
		buffer = append(buffer, ' ')
		buffer = prim.AppendShowString(buffer, foreignError.Field1)
		buffer = append(buffer, ')')
	}
	return buffer
}

func EitherBigIntFromResults(value *big.Int, err NonEmptyFailure) EitherBigInt {
	if err.Failed {
		return LeftEitherBigInt(err.Left)
	}
	return RightEitherBigInt(value)
}

// Yoga/JSON/json.go
package json

import (
	"fixture/Data/Maybe"
	"fixture/Foreign"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/jsbigint"
	"github.com/i-am-the-slime/iris-go/prim"
	"math"
	"math/big"
)

func ReadImpl(fValue any) (*big.Int, foreign.NonEmptyFailure) {
	error_ := foreign.LeftEitherInt(foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(fValue)), Second: foreign.SharedListForeignErrorNil})
	var result foreign.EitherInt
	if foreignvalue.TagOf(fValue) == "Number" {
		number := foreignvalue.Number(fValue)
		var integer maybe.Int
		if math.Trunc(number) == number && (number >= math.MinInt && number < -math.MinInt) {
			integer = maybe.JustInt(int(number))
		} else {
			integer = maybe.NoInt
		}
		switch integer.Tag {
		case maybe.TagNothing:
			result = error_
		default: // maybe.TagJust
			result = foreign.RightEitherInt(integer.Just)
		}
	} else {
		result = error_
	}
	var bigInt *big.Int
	var err foreign.NonEmptyFailure
	switch result.Tag {
	case foreign.EitherIntLeft:
		err = foreign.NonEmptyFailure{Failed: true, Left: result.Left}
	default: // foreign.EitherIntRight
		bigInt, err = jsbigint.FromInt(result.Right), foreign.NonEmptyFailure{}
	}
	var bigInt2 *big.Int
	var err2 foreign.NonEmptyFailure
	if foreignvalue.TagOf(fValue) == "Number" {
		field := foreignvalue.Number(fValue)
		if prim.NumberRound(field) == field {
			a, found := jsbigint.FromNumber(field)
			if found {
				bigInt2, err2 = a, foreign.NonEmptyFailure{}
			} else {
				err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError("Cannot convert Number " + prim.ShowNumber(field) + " to BigInt"), Second: foreign.SharedListForeignErrorNil}}
			}
		} else {
			err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError("Cannot convert decimal Number " + prim.ShowNumber(field) + " to BigInt"), Second: foreign.SharedListForeignErrorNil}}
		}
	} else {
		err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Number", foreignvalue.TagOf(fValue)), Second: foreign.SharedListForeignErrorNil}}
	}
	var bigInt3 *big.Int
	var err3 foreign.NonEmptyFailure
	if foreignvalue.TagOf(fValue) == "BigInt" {
		bigInt3, err3 = fValue.(*big.Int), foreign.NonEmptyFailure{}
	} else {
		err3 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("BigInt", foreignvalue.TagOf(fValue)), Second: foreign.SharedListForeignErrorNil}}
	}
	var result2 foreign.EitherBigInt
	if foreignvalue.TagOf(fValue) == "String" {
		field := fValue.(string)
		a, found := jsbigint.FromString(field)
		if found {
			result2 = foreign.RightEitherBigInt(a)
		} else {
			result2 = foreign.LeftEitherBigInt(foreign.NonEmpty{First: foreign.ForeignErrorForeignError("Cannot convert String " + field + " to BigInt"), Second: foreign.SharedListForeignErrorNil})
		}
	} else {
		result2 = foreign.LeftEitherBigInt(foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(fValue)), Second: foreign.SharedListForeignErrorNil})
	}
	return foreign.Alt(bigInt, err, foreign.EitherBigIntFromResults(foreign.Alt(bigInt2, err2, foreign.EitherBigIntFromResults(foreign.Alt(bigInt3, err3, result2)))))
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
	"fixture/Foreign"
	"fixture/Yoga/JSON"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/jsbigint"
	nullablepkg "github.com/i-am-the-slime/iris-go/nullable"
	"github.com/i-am-the-slime/iris-go/prim"
	"math"
	"math/big"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	var value any = int(7)
	var result string
	if foreignvalue.TagOf(value) == "Number" {
		result = "(Right " + prim.ShowNumber(foreignvalue.Number(value)) + ")"
	} else {
		result = "(Left " + foreign.ShowNonEmptyListForeignError(foreign.NonEmpty{First: foreign.TypeMismatch("Number", foreignvalue.TagOf(value)), Second: foreign.SharedListForeignErrorNil}) + ")"
	}
	var value2 any = int(-200)
	error_ := foreign.LeftEitherInt(foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(value2)), Second: foreign.SharedListForeignErrorNil})
	var result2 foreign.EitherInt
	if foreignvalue.TagOf(value2) == "Number" {
		number := foreignvalue.Number(value2)
		var integer maybe.Int
		if math.Trunc(number) == number && (number >= math.MinInt && number < -math.MinInt) {
			integer = maybe.JustInt(int(number))
		} else {
			integer = maybe.NoInt
		}
		switch integer.Tag {
		case maybe.TagNothing:
			result2 = error_
		default: // maybe.TagJust
			result2 = foreign.RightEitherInt(integer.Just)
		}
	} else {
		result2 = error_
	}
	var result3 string
	switch result2.Tag {
	case foreign.EitherIntLeft:
		result3 = "(Left " + foreign.ShowNonEmptyListForeignError(result2.Left) + ")"
	default: // foreign.EitherIntRight
		result3 = "(Right " + strconv.Itoa(result2.Right) + ")"
	}
	nullable := nullablepkg.Nullable(nullablepkg.Null[int](), maybe.NoInt, maybe.JustInt)
	var result4 any
	switch nullable.Tag {
	case maybe.TagNothing:
		result4 = shared.Convert(nullablepkg.Null[any]())
	default: // maybe.TagJust
		result4 = nullable.Just
	}
	performed := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		argument := foreignvalue.ParseJSON("\"a\"")
		return either.Either{Tag: either.EitherRight, Right: argument}
	})
	var char rune
	var err foreign.NonEmptyFailure
	switch performed.Tag {
	case either.EitherLeft:
		err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherRight
		r := performed.Right
		if foreignvalue.TagOf(r) == "String" {
			a, found := prim.CodeUnitToChar(r.(string))
			if found {
				char, err = a, foreign.NonEmptyFailure{}
			} else {
				err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Char", foreignvalue.TagOf(r)), Second: foreign.SharedListForeignErrorNil}}
			}
		} else {
			err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Char", foreignvalue.TagOf(r)), Second: foreign.SharedListForeignErrorNil}}
		}
	}
	var result5 string
	if err.Failed {
		result5 = "(Left " + foreign.ShowNonEmptyListForeignError(err.Left) + ")"
	} else {
		result5 = "(Right " + prim.ShowChar(char) + ")"
	}
	performed2 := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		argument := foreignvalue.ParseJSON("{\"big\":12}")
		return either.Either{Tag: either.EitherRight, Right: argument}
	})
	var result6 string
	switch performed2.Tag {
	case either.EitherLeft:
		result6 = "(Left " + foreign.ShowNonEmptyListForeignError(foreign.NonEmpty{First: foreign.ForeignErrorForeignError(exception.Message(performed2.Left)), Second: foreign.SharedListForeignErrorNil}) + ")"
	default: // either.EitherRight
		r := performed2.Right
		unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
			return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(r)), Second: foreign.SharedListForeignErrorNil})
		}, foreign.Pure, "big", r)
		var bigInt *big.Int
		var err2 foreign.NonEmptyFailure
		switch unsafeReadPropImpl.Tag {
		case foreign.EitherForeignLeft:
			bigInt, err2 = mainJoin(unsafeReadPropImpl.Left)
		default: // foreign.EitherForeignRight
			bigInt2, err3 := json.ReadImpl(unsafeReadPropImpl.Right)
			if err3.Failed {
				bigInt, err2 = mainJoin(err3.Left)
			} else {
				bigInt, err2 = bigInt2, foreign.NonEmptyFailure{}
			}
		}
		if err2.Failed {
			result6 = "(Left " + foreign.ShowNonEmptyListForeignError(err2.Left) + ")"
		} else {
			result6 = "(Right { big: " + jsbigint.ToString(bigInt) + " })"
		}
	}
	return []string{foreignvalue.TypeOf(any(array.Snoc[any](array.Snoc[any]([]any{}, int(1)), "Freddy"))), result, result3, foreignvalue.UnsafeStringify(prim.CharSingleton('a')), foreignvalue.UnsafeStringify(jsbigint.FromInt(10)), foreignvalue.UnsafeStringify(direct.ForeignRecord([]string{"missing", "letter", "big"}, []any{result4, prim.CharSingleton('x'), jsbigint.FromInt(7)})), result5, result6}
}

func mainJoin(x foreign.NonEmpty) (*big.Int, foreign.NonEmptyFailure) {
	return nil, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ErrorAtProperty("big", x.First), Second: mainJoinChunkedRevMap(foreign.SharedListListForeignErrorNil, x.Second)}}
}

func mainJoinChunkedRevMap(chunksAcc *foreign.ListListForeignError, chunk *foreign.ListForeignError) *foreign.ListForeignError {
	var listListForeignErrorCells alloc.Cells[foreign.ListListForeignError]
	for {
		if chunk != foreign.SharedListForeignErrorNil && chunk.Cons1 != foreign.SharedListForeignErrorNil && chunk.Cons1.Cons1 != foreign.SharedListForeignErrorNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListForeignErrorCells.New(foreign.ListListForeignError{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *foreign.ListForeignError
		if chunk != foreign.SharedListForeignErrorNil && chunk.Cons1 != foreign.SharedListForeignErrorNil && chunk.Cons1.Cons1 == foreign.SharedListForeignErrorNil {
			result = foreign.Cons(foreign.ErrorAtProperty("big", chunk.Cons0), foreign.Cons(foreign.ErrorAtProperty("big", chunk.Cons1.Cons0), foreign.SharedListForeignErrorNil))
		} else if chunk != foreign.SharedListForeignErrorNil && chunk.Cons1 == foreign.SharedListForeignErrorNil {
			result = foreign.Cons(foreign.ErrorAtProperty("big", chunk.Cons0), foreign.SharedListForeignErrorNil)
		} else {
			result = foreign.SharedListForeignErrorNil
		}
		return mainJoinChunkedRevMapReverseUnrolledMap(chunksAcc, result)
	}
}

func mainJoinChunkedRevMapReverseUnrolledMap(list *foreign.ListListForeignError, acc *foreign.ListForeignError) *foreign.ListForeignError {
	var foreignErrorCells alloc.Cells[foreign.ForeignError]
	var listForeignErrorCells alloc.Cells[foreign.ListForeignError]
	for {
		if list != foreign.SharedListListForeignErrorNil && list.Cons0 != foreign.SharedListForeignErrorNil && list.Cons0.Cons1 != foreign.SharedListForeignErrorNil && list.Cons0.Cons1.Cons1 != foreign.SharedListForeignErrorNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listForeignErrorCells.New(foreign.ListForeignError{Cons0: foreignErrorCells.New(foreign.ForeignError{Tag: foreign.ForeignErrorErrorAtProperty, ErrorAtProperty0: "big", ErrorAtProperty1: x1}), Cons1: listForeignErrorCells.New(foreign.ListForeignError{Cons0: foreignErrorCells.New(foreign.ForeignError{Tag: foreign.ForeignErrorErrorAtProperty, ErrorAtProperty0: "big", ErrorAtProperty1: x2}), Cons1: listForeignErrorCells.New(foreign.ListForeignError{Cons0: foreignErrorCells.New(foreign.ForeignError{Tag: foreign.ForeignErrorErrorAtProperty, ErrorAtProperty0: "big", ErrorAtProperty1: x3}), Cons1: acc})})})
			continue
		}
		return acc
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func Convert(value *any) any {
	if value == nil {
		return nil
	}
	return *value
}
