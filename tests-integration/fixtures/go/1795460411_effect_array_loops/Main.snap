// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type EitherUnit struct {
	Right struct{}
	Left  exception.Error
	Tag   uint8
}

const (
	EitherUnitLeft = iota
	EitherUnitRight
)

type EitherArrayInt struct {
	Left  exception.Error
	Right []int
	Tag   uint8
}

const (
	EitherArrayIntLeft = iota
	EitherArrayIntRight
)

func LeftEitherUnit(left exception.Error) EitherUnit {
	return EitherUnit{Tag: EitherUnitLeft, Left: left}
}

func RightEitherUnit(right struct{}) EitherUnit {
	return EitherUnit{Tag: EitherUnitRight, Right: right}
}

func LeftEitherArrayInt(left exception.Error) EitherArrayInt {
	return EitherArrayInt{Tag: EitherArrayIntLeft, Left: left}
}

func RightEitherArrayInt(right []int) EitherArrayInt {
	return EitherArrayInt{Tag: EitherArrayIntRight, Right: right}
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

