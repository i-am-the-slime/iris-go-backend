// Effect/Exception/exception.go
package effectexception

import "github.com/i-am-the-slime/iris-go/exception"

func Throw(x string) {
	panic(exception.NewError(x))
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Show"
	"fixture/Effect/Exception"
	journal "fixture/Journal_ffi"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/object"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	traversals()
	failures()
	folds()
	journal.Log("st")
	seen := []int{}
	for _, i := range []int{3, 1, 2} {
		seen = arraypkg.Append(seen, []int{i})
	}
	for _, i := range []int{3, 1, 2} {
		seen = arraypkg.Append(seen, []int{i * 100})
	}
	journal.Log(show.ArrayInt(seen))
	seen2 := []int{}
	for index := 0; index < 3; index++ {
		x := []int{10, 20, 30}[index]
		seen2 = arraypkg.Append(seen2, []int{index + x})
	}
	journal.Log(show.ArrayInt(seen2))
	counter := 0
	array := []int{1, 2, 3}
	collected := make([]string, len(array))
	for index, i := range array {
		s_ := counter + 1
		counter = s_
		value := strconv.Itoa(s_) + ":" + strconv.Itoa(i)
		collected[index] = value
	}
	journal.Log(show.ArrayString(collected))
	accumulator := 1
	for _, i := range []int{1, 2, 3} {
		accumulator = accumulator*2 + i
	}
	journal.Log(strconv.Itoa(accumulator))
	large()
}

func traversals() {
	journal.Log("for_ effect")
	for _, i := range []int{1, 2, 3} {
		journal.Log(strconv.Itoa(i))
	}
	journal.Log("traverse_ effect")
	for _, s := range []string{"a", "b"} {
		journal.Log("t" + prim.ShowString(s))
	}
	journal.Log("forWithIndex_ effect")
	for index := 0; index < 3; index++ {
		journal.Log(strconv.Itoa(index) + []string{"x", "y", "z"}[index])
	}
	journal.Log("traverseWithIndex_ effect")
	for index := 0; index < 2; index++ {
		journal.Log(strconv.Itoa(index * []int{5, 6}[index]))
	}
	journal.Log("for effect")
	array := []int{1, 2, 3}
	collected := make([]int, len(array))
	for index, i := range array {
		journal.Log("visit " + strconv.Itoa(i))
		value := i * 2
		collected[index] = value
	}
	journal.Log(show.ArrayInt(collected))
	journal.Log("traverse effect")
	array2 := []int{7, 8}
	collected2 := make([]string, len(array2))
	for index, i := range array2 {
		value := strconv.Itoa(i)
		journal.Log("see " + value)
		collected2[index] = value
	}
	journal.Log(show.ArrayString(collected2))
	journal.Log("foldM effect")
	accumulator := 0
	for _, i := range []int{1, 2, 3, 4} {
		journal.Log("add " + strconv.Itoa(i))
		accumulator += i
	}
	journal.Log(strconv.Itoa(accumulator))
	accumulator2 := 0
	for _, i := range []int{4, 2} {
		journal.Log("digit " + strconv.Itoa(i))
		accumulator2 = accumulator2*10 + i
	}
	journal.Log(strconv.Itoa(accumulator2))
	journal.Log("sequence_ effect")
	journal.Log("first")
	journal.Log("second")
	journal.Log("third")
	journal.Log("nested")
	inners := []string{"a", "b"}
	for _, outer := range []int{1, 2} {
		for _, inner := range inners {
			journal.Log(strconv.Itoa(outer) + inner)
		}
	}
	journal.Log("empty")
	for _, i := range []int{} {
		journal.Log(strconv.Itoa(i))
	}
	collected3 := make([]int, len([]int{}))
	for index, i := range []int{} {
		value := i + 1
		collected3[index] = value
	}
	journal.Log(show.ArrayInt(collected3))
}

func failures() {
	journal.Log("throws midway")
	visited := []int{}
	outcome := direct.CatchException(func(x exception.Error) either.EitherUnit {
		return either.LeftEitherUnit(x)
	}, func() either.EitherUnit {
		for _, i := range []int{1, 2, 3, 4} {
			s := visited
			visited = arraypkg.Append(s, []int{i})
			if i == 3 {
				effectexception.Throw("three")
			}
		}
		return either.RightEitherUnit(struct{}{})
	})
	seen := visited
	var text []byte
	switch outcome.Tag {
	case either.EitherUnitLeft:
		text = prim.AppendString(text, exception.Message(outcome.Left))
	default: // either.EitherUnitRight
		text = append(text, "no error"...)
	}
	text = append(text, " after "...)
	text = show.AppendShowArrayInt(text, seen)
	journal.Log(string(text))
	traversed := []int{}
	traverseOutcome := direct.CatchException(func(x exception.Error) either.EitherArrayInt {
		return either.LeftEitherArrayInt(x)
	}, func() either.EitherArrayInt {
		array := []int{1, 2, 3}
		collected := make([]int, len(array))
		for index, i := range array {
			s := traversed
			traversed = arraypkg.Append(s, []int{i})
			if i == 2 {
				effectexception.Throw("two")
			}
			collected[index] = i
		}
		return either.RightEitherArrayInt(collected)
	})
	traversedSeen := traversed
	var text2 []byte
	switch traverseOutcome.Tag {
	case either.EitherArrayIntLeft:
		text2 = prim.AppendString(text2, exception.Message(traverseOutcome.Left))
	default: // either.EitherArrayIntRight
		text2 = show.AppendShowArrayInt(text2, traverseOutcome.Right)
	}
	text2 = append(text2, " after "...)
	text2 = show.AppendShowArrayInt(text2, traversedSeen)
	journal.Log(string(text2))
}

func folds() {
	journal.Log("range")
	for i := 1; i < 5; i++ {
		journal.Log("r" + strconv.Itoa(i))
	}
	journal.Log("maybe")
	journal.Log("just 9")
	journal.Log("wrapped")
	journal.Log("p0")
	journal.Log("q1")
	for _, i := range []int{4, 5} {
		journal.Log("w" + strconv.Itoa(i))
	}
	accumulator := 100
	for _, i := range []int{1, 10} {
		journal.Log("minus " + strconv.Itoa(i))
		accumulator -= i
	}
	journal.Log(strconv.Itoa(accumulator))
	journal.Log("stops early")
	arraypkg.Foldr(func(x int, rest func()) func() {
		if x == 3 {
			return func() {
			}
		}
		return func() {
			journal.Log("upto " + strconv.Itoa(x))
			rest()
		}
	}, func() {
	}, []int{1, 2, 3, 4, 5})()
	journal.Log("reversed")
	arraypkg.Foldr(func(x int, rest func()) func() {
		return func() {
			rest()
			journal.Log("back " + strconv.Itoa(x))
		}
	}, func() {
	}, []int{1, 2, 3})()
	journal.Log("left fold")
	journal.Log("seed")
	for _, x := range []int{1, 2} {
		journal.Log("left " + strconv.Itoa(x))
	}
	journal.Log("object")
	object2 := object.New[int]()
	value, found := object.LookupST("a", object2)
	var lookupST int
	if found {
		lookupST = 1 + value
	} else {
		lookupST = 1
	}
	object.Poke("a", lookupST, object2)
	value2, found2 := object.LookupST("b", object2)
	var lookupST2 int
	if found2 {
		lookupST2 = 2 + value2
	} else {
		lookupST2 = 2
	}
	object.Poke("b", lookupST2, object2)
	value3, found3 := object.LookupST("a", object2)
	var lookupST3 int
	if found3 {
		lookupST3 = 30 + value3
	} else {
		lookupST3 = 30
	}
	object.Poke("a", lookupST3, object2)
	x2, found4 := object.Lookup("a", object2)
	var result string
	if found4 {
		result = "(Just " + strconv.Itoa(x2) + ")"
	} else {
		result = "Nothing"
	}
	journal.Log(result)
}

func large() {
	journal.Log("large")
	values := arraypkg.Replicate(1000000, 1)
	total := 0
	for _, i := range values {
		total += i
	}
	for _, effect := range arraypkg.Map(func(i int) func() {
		return func() {
		}
	}, values) {
		effect()
	}
	journal.Log(strconv.Itoa(total))
	array := arraypkg.Replicate(1000000, 2)
	collected := make([]int, len(array))
	for index, i := range array {
		value := i + 1
		collected[index] = value
	}
	journal.Log(strconv.Itoa(len(collected)))
	counter := 0
	for range 1000000 {
		i := 3
		counter += i
	}
	journal.Log(strconv.Itoa(counter))
	accumulator := 0
	for range 1000000 {
		i := 1
		accumulator += i
	}
	journal.Log(strconv.Itoa(accumulator))
	wrappedCounter := 0
	for index := range 1000000 {
		i := 1
		wrappedCounter += index * i
	}
	journal.Log(strconv.Itoa(wrappedCounter))
}

