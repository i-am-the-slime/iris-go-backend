// Data/Either/either.go
package either

type Either struct {
	Right struct{}
	Left  string
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type StringFailure struct {
	Failed bool
	Left   string
}

// main.go
package main

import (
	"fixture/Data/Either"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"strconv"
)

type Step struct {
	Emit []int
	Tag  uint8
}

const (
	StepEmit = iota
	StepEnd
)

type Either struct {
	Left  string
	Right Step
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Right(right Step) Either {
	return Either{Tag: EitherRight, Right: right}
}

func Emit(emit []int) Step {
	return Step{Tag: StepEmit, Emit: emit}
}

func main() {
	sent := &shared.Ref[int]{Value: 0}
	ref := &shared.Ref[int]{Value: 0}
	ref2 := &shared.Ref[int]{Value: 250}
	foldPulledFPullFF(sent, ref2, ref, 1000, struct{}{})
	total := sent.Value
	journal.Log(strconv.Itoa(total))
}

func foldPulledFPullFF(ref *shared.Ref[int], ref2 *shared.Ref[int], ref3 *shared.Ref[int], i int, context struct{}) (struct{}, either.StringFailure) {
	step2 := Step{Tag: StepEnd}
	eitherStringStep := Right(step2)
	for {
		i2 := ref2.Value
		var result Either
		if i2 <= 0 {
			result = eitherStringStep
		} else {
			i3 := ref3.Value
			if i3 >= i {
				result = eitherStringStep
			} else {
				y := i3 + 64
				stop := min(i, y)
				ref3.Value = stop
				var taken []int
				if i2 < 1 {
					taken = []int{}
				} else {
					step, count := array.RangeSteps(i3, stop-1)
					mapped := []int{}
					for index := range count {
						number := i3 + index*step
						if number&1 == 1 {
							mapped = append(mapped, number*3)
						}
					}
					taken = array.Slice(0, i2, mapped)
				}
				ref2.Value = i2 - len(taken)
				result = Right(Emit(taken))
			}
		}
		switch result.Tag {
		case EitherLeft:
			return struct{}{}, either.StringFailure{Failed: true, Left: result.Left}
		default: // EitherRight
			switch result.Right.Tag {
			case StepEnd:
				return struct{}{}, either.StringFailure{}
			default: // StepEmit
				var err either.StringFailure
				var chunk []int = result.Right.Emit
				index := 0
			foldPulledFPullFFFrom:
				for {
					if index < len(chunk) {
						n := chunk[index]
						s := ref.Value
						s_ := s + n
						ref.Value = s_
						index += 1
						continue
					}
					err = either.StringFailure{}
					break foldPulledFPullFFFrom
				}
				if err.Failed {
					return struct{}{}, err
				}
				continue
			}
		}
	}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
