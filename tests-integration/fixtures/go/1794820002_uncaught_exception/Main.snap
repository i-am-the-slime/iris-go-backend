// main.go
package main

import "github.com/i-am-the-slime/iris-go/exception"

func main() {
	defer exception.ReportUncaught()
	var ref int32 = 0
	s_ := ref + 1
	ref = s_
	scrutinee := ref > 0
	if scrutinee {
		panic(exception.NewError("boom"))
	}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
