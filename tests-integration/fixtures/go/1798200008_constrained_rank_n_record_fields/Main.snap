// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{prim.Append(bracketed.Render.ForInt(1), bracketed.Render.ForString("two")), prim.Append(bracketed.Render.ForInt(1), bracketed.Render.ForString("two"))}
}

var bracketed shared.Renderer = shared.Renderer{Render: shared.Render{ForInt: func(a int) string {
	return "[" + strconv.Itoa(a) + "]"
}, ForString: func(a string) string {
	return "[" + prim.ShowString(a) + "]"
}}}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Render struct {
	ForInt    func(int) string
	ForString func(string) string
}

type Renderer struct {
	Render Render
}
