// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	var ref int32 = 4
	ref2 := []int32{}
	step, count := array.RangeSteps(ref, 1)
	for index := range count {
		i := ref + int32(index)*step
		s_ := array.Append(ref2, []int32{i})
		ref2 = s_
	}
	step2, count2 := array.RangeSteps(1, ref)
	var accumulator int32 = 0
	for index := range count2 {
		value := 1 + int32(index)*step2
		accumulator += value
	}
	step3, count3 := array.RangeSteps(ref, 1)
	accumulator2 := ""
	for index := count3 - 1; index >= 0; index-- {
		x := ref + int32(index)*step3
		accumulator2 = prim.ShowInt(x) + "," + accumulator2
	}
	_, count4 := array.RangeSteps(1, ref)
	step4, count5 := array.RangeSteps(1, ref)
	mapped := make([]int32, count5)
	for slot := range count5 {
		x := 1 + int32(slot)*step4
		index := int32(slot)
		mapped[slot] = index * x
	}
	performed := shared.MainResult{Visited: ref2, Summed: accumulator, Listed: accumulator2, Counted: int32(count4), Indexed: mapped, Descending: descending}
	return performed
}

var descending = initializeDescending()

func initializeDescending() []int32 {
	defer exception.ReportUncaught()
	mapped := make([]int32, 3)
	for index := range 3 {
		value := 3 - int32(index)
		mapped[index] = value * 2
	}
	return mapped
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	Descending []int32
	Indexed    []int32
	Listed     string
	Visited    []int32
	Counted    int32
	Summed     int32
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State []int32
	Value []int32
}
