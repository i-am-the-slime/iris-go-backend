// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	bound := 4
	seen := []int{}
	step, count := array.RangeSteps(bound, 1)
	for index := range count {
		i := bound + index*step
		seen = array.Append(seen, []int{i})
	}
	step2, count2 := array.RangeSteps(1, bound)
	accumulator := 0
	for index := range count2 {
		value := 1 + index*step2
		accumulator += value
	}
	accumulator2 := ""
	for index := count - 1; index >= 0; index-- {
		x := bound + index*step
		accumulator2 = strconv.Itoa(x) + "," + accumulator2
	}
	mapped := make([]int, count2)
	for slot := range count2 {
		x := 1 + slot*step2
		mapped[slot] = slot * x
	}
	performed := shared.MainResult{Visited: seen, Summed: accumulator, Listed: accumulator2, Counted: count2, Indexed: mapped, Descending: descending}
	return performed
}

var descending = initializeDescending()

func initializeDescending() []int {
	mapped := make([]int, 3)
	for index := range 3 {
		value := 3 - index
		mapped[index] = value * 2
	}
	return mapped
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	Descending []int
	Indexed    []int
	Listed     string
	Visited    []int
	Counted    int
	Summed     int
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State []int
	Value []int
}

// note: the entry's value of type { counted, descending, indexed, listed, summed, visited } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
