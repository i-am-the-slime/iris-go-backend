// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type EitherString struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringLeft = iota
	EitherStringRight
)

type EitherError struct {
	Left  exception.Error
	Right int32
	Tag   uint8
}

const (
	EitherErrorLeft = iota
	EitherErrorRight
)

type StringFailure struct {
	Failed bool
	Left   string
}

func LeftEitherError(left exception.Error) EitherError {
	return EitherError{Tag: EitherErrorLeft, Left: left}
}

func RightEitherError(right int) EitherError {
	return EitherError{Tag: EitherErrorRight, Right: int32(right)}
}

func RightEitherString(right int) EitherString {
	return EitherString{Tag: EitherStringRight, Right: int32(right)}
}

func LeftEitherString(left string) EitherString {
	return EitherString{Tag: EitherStringLeft, Left: left}
}

func EitherStringFromResults(value int, err StringFailure) EitherString {
	if err.Failed {
		return LeftEitherString(err.Left)
	}
	return RightEitherString(value)
}

func EitherStringResults(either EitherString) (int, StringFailure) {
	if either.Tag == EitherStringLeft {
		return 0, StringFailure{Failed: true, Left: either.Left}
	}
	return int(either.Right), StringFailure{}
}

// main.go
package main

import (
	"fixture/Data/Either"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	counter := &shared.Ref[int]{Value: 0}
	journal.Log("(Right 2)")
	journal.Log("(Left " + prim.ShowString("odd 3") + ")")
	i, err := mainStep(7)
	var i2 int
	var err2 either.StringFailure
	if err.Failed {
		err2 = err
	} else {
		i2, err2 = mainStep(i)
	}
	var result string
	if err2.Failed {
		result = "(Left " + prim.ShowString(err2.Left) + ")"
	} else {
		result = "(Right " + strconv.Itoa(i2) + ")"
	}
	journal.Log(result)
	i3, err := retrying(3, func(n int) (int, either.StringFailure) {
		return mainCounted(counter, n)
	}, 5)
	var result2 string
	if err.Failed {
		result2 = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result2 = "(Right " + strconv.Itoa(i3) + ")"
	}
	journal.Log(result2)
	i4, err := retrying(2, func(n int) (int, either.StringFailure) {
		return mainCounted(counter, n)
	}, 1)
	var result3 string
	if err.Failed {
		result3 = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result3 = "(Right " + strconv.Itoa(i4) + ")"
	}
	journal.Log(result3)
	calls := counter.Value
	journal.Log(strconv.Itoa(calls))
	i5, err := runAll(3)
	var result4 string
	if err.Failed {
		result4 = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result4 = "(Right " + strconv.Itoa(i5) + ")"
	}
	journal.Log(result4)
	i6, err := runAll(4)
	var result5 string
	if err.Failed {
		result5 = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result5 = "(Right " + strconv.Itoa(i6) + ")"
	}
	journal.Log(result5)
	either2 := direct.CatchException(func(x exception.Error) either.EitherError {
		return either.LeftEitherError(x)
	}, func() either.EitherError {
		panic(exception.NewError("no"))
	})
	var result6 string
	switch either2.Tag {
	case either.EitherErrorLeft:
		result6 = "(Left " + prim.ShowString("thrown") + ")"
	default: // either.EitherErrorRight
		result6 = "(Right " + strconv.Itoa(int(either2.Right)) + ")"
	}
	journal.Log(result6)
	either3 := direct.CatchException(func(x exception.Error) either.EitherError {
		return either.LeftEitherError(x)
	}, func() either.EitherError {
		return either.RightEitherError(5)
	})
	var i7 int
	var err3 either.StringFailure
	switch either3.Tag {
	case either.EitherErrorLeft:
		err3 = either.StringFailure{Failed: true, Left: "thrown"}
	default: // either.EitherErrorRight
		i7, err3 = int(either3.Right), either.StringFailure{}
	}
	var i8 int
	var err4 either.StringFailure
	if err3.Failed {
		err4 = err3
	} else {
		b := i7
		if b&1 == 0 {
			i8, err4 = b>>1, either.StringFailure{}
		} else {
			err4 = either.StringFailure{Failed: true, Left: "odd " + strconv.Itoa(b)}
		}
	}
	var result7 string
	if err4.Failed {
		result7 = "(Left " + prim.ShowString(err4.Left) + ")"
	} else {
		result7 = "(Right " + strconv.Itoa(i8) + ")"
	}
	journal.Log(result7)
	journal.Log(strconv.Itoa(len(pipeline)))
}

func halve(n int) (int, either.StringFailure) {
	if n&1 == 0 {
		return n>>1, either.StringFailure{}
	}
	return 0, either.StringFailure{Failed: true, Left: "odd " + strconv.Itoa(n)}
}

func retrying(attempts int, step func(int) (int, either.StringFailure), n int) (int, either.StringFailure) {
	for {
		i, err := step(n)
		if !err.Failed {
			return i, either.StringFailure{}
		}
		if attempts <= 1 {
			return 0, err
		}
		attempts, n = attempts-1, n+1
	}
}

func runAll(start int) (int, either.StringFailure) {
	accumulator := either.RightEitherString(start)
	for _, a := range pipeline {
		var next either.EitherString
		switch accumulator.Tag {
		case either.EitherStringLeft:
			next = either.LeftEitherString(accumulator.Left)
		default: // either.EitherStringRight
			next = either.EitherStringFromResults(a(int(accumulator.Right)))
		}
		accumulator = next
	}
	return either.EitherStringResults(accumulator)
}

var pipeline []func(int) (int, either.StringFailure) = []func(int) (int, either.StringFailure){addOne, halve, func(n int) (int, either.StringFailure) {
	return n+2, either.StringFailure{}
}}

func addOne(n int) (int, either.StringFailure) {
	return n+1, either.StringFailure{}
}

func mainCounted(counter *shared.Ref[int], n int) (int, either.StringFailure) {
	s := counter.Value
	s_ := s + 1
	counter.Value = s_
	if n&1 == 0 {
		return n>>1, either.StringFailure{}
	}
	return 0, either.StringFailure{Failed: true, Left: "odd " + strconv.Itoa(n)}
}

func mainStep(n int) (int, either.StringFailure) {
	if n > 100 {
		return 0, either.StringFailure{Failed: true, Left: "big"}
	}
	return n*10, either.StringFailure{}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
