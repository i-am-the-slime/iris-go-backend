// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/refeq"
	"strconv"
	"strings"
)

type Room uint8

const (
	RoomKitchen Room = iota
	RoomGarden
)

type Shape struct {
	Field0 float64
	Tag    uint8
}

const (
	ShapeCircle = iota
	ShapeSquare
)

type Chain struct {
	Link1 *Chain
	Link0 int32
}

var sharedChainEnd = &Chain{}

func Circle(field0 float64) Shape {
	return Shape{Tag: ShapeCircle, Field0: field0}
}

func Square(field0 float64) Shape {
	return Shape{Tag: ShapeSquare, Field0: field0}
}

func Link(link0 int32, link1 *Chain) *Chain {
	return &Chain{Link0: link0, Link1: link1}
}

var main_ = initializeMain_()

func initializeMain_() []bool {
	left := shared.Handler{Name: "a", Run: func(n int32) int32 {
		return n + 1
	}}
	right := shared.Handler{Name: "a", Run: func(n int32) int32 {
		return n + 2
	}}
	return []bool{int32(1) == int32(2), float64(1.0) == float64(1.0), true == false, rune('a') == rune('a'), "a" == "b", struct{}{} == struct{}{}, RoomKitchen == RoomGarden, refeq.SameFunc(func(n int32) int32 {
		return n + 1
	}, func(n int32) int32 {
		return n + 2
	}), refeq.SameFunc(func() {
	}, func() {
	}), refeq.SameSlice([]int32{1}, []int32{1}), counter == counter, shared.XY{X: 1, Y: 2.0} == shared.XY{X: 1, Y: 3.0}, left.Name == right.Name && refeq.SameFunc(left.Run, right.Run), Circle(1.0) == Square(1.0), Link(1, sharedChainEnd) == sharedChainEnd}
}

var counter = initializeCounter()

func initializeCounter() *shared.Ref[int32] {
	performed := &shared.Ref[int32]{Value: 0}
	return performed
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, strconv.FormatBool(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type XY struct {
	Y float64
	X int32
}

type Handler struct {
	Name string
	Run  func(int32) int32
}
