// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"strconv"
)

func main_() []string {
	doubled := maybe.JustInt(30)
	var result string
	switch doubled.Tag {
	case maybe.TagJust:
		result = "(Just " + strconv.Itoa(doubled.Just) + ")"
	default: // maybe.TagNothing
		result = "Nothing"
	}
	return []string{"(Just 20)", "Nothing", result}
}

func main() {
	main_()
}
