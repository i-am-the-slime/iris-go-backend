// Effect/Exception/exception.go
package effectexception

import "github.com/i-am-the-slime/iris-go/exception"

func ThrowUnit(x string) {
	panic(exception.NewError(x))
}

// main.go
package main

import (
	"fixture/Effect/Exception"
	"github.com/i-am-the-slime/iris-go/exception"
)

func main() {
	defer exception.ReportUncaught()
//line Main.purs:22:3
	if sumFrom([]int32{1, 2, 3}, 0, 0) != 6 {
		effectexception.ThrowUnit("the total is wrong")
	}
//line Main.purs:24:3
	if sumFrom([]int32{4}, 0, 0) != 4 {
		effectexception.ThrowUnit("the second total is wrong")
	}
}

//line Main.purs:14:3
func sumFrom(numbers []int32, index int32, total int32) int32 {
	for {
//line Main.purs:14:3
		if index >= int32(len(numbers)) {
			return total
		}
//line Main.purs:16:5
		index, total = index+1, total+numbers[index]
	}
}
