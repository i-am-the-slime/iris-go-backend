// Data/Maybe/maybe.go
package maybe

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

type MaybeChar struct {
	Just rune
	Tag  uint8
}

const (
	MaybeCharNothing = iota
	MaybeCharJust
)

type MaybeInt struct {
	Just int32
	Tag  uint8
}

const (
	MaybeIntNothing = iota
	MaybeIntJust
)

func ShowChar(maybe MaybeChar) string {
	switch maybe.Tag {
	case MaybeCharJust:
		return "(Just " + prim.ShowChar(maybe.Just) + ")"
	default: // MaybeCharNothing
		return "Nothing"
	}
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
	"slices"
)

func rangeInt32(start int32, end int32) []int32 {
	step := int32(1)
	if start > end {
		step = -1
	}
	elements := []int32{start}
	for value := start; value != end; {
		value += step
		elements = append(elements, value)
	}
	return elements
}

var main_ = initializeMain_()

func initializeMain_() []string {
	text := prim.StringJoinWith(" ", []string{"a😀", "naïve 😀 banana 日本 a𝄞a"})
	array := rangeInt32(0, prim.CodeUnitLength(text) - 1)
	mapped := make([]maybe.MaybeChar, len(array))
	textUnits := prim.UTF16(text)
	for index, i := range array {
		mapped[index] = textUnits.CharAt(func(payload rune) maybe.MaybeChar {
			return maybe.MaybeChar{Tag: maybe.MaybeCharJust, Just: payload}
		}, maybe.MaybeChar{Tag: maybe.MaybeCharNothing}, i)
	}
	scrutinee := prim.CodeUnitCharAt(func(payload rune) maybe.MaybeChar {
		return maybe.MaybeChar{Tag: maybe.MaybeCharJust, Just: payload}
	}, maybe.MaybeChar{Tag: maybe.MaybeCharNothing}, prim.CodeUnitLength("naïve 😀 banana 日本 a𝄞a") - 3, "naïve 😀 banana 日本 a𝄞a")
	var result string
	switch scrutinee.Tag {
	case maybe.MaybeCharJust:
		result = "(Just " + prim.ShowChar(scrutinee.Just) + ")"
	default: // maybe.MaybeCharNothing
		result = "Nothing"
	}
	return []string{prim.ShowInt(charAtLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), unsafeCharAtLoopViewsTheText("ab😀c", 4, ""), prim.ShowInt(indexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), prim.ShowInt(lastIndexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 100, 0)), prim.ShowArray(show.Show, slicesInALoopViewTheText("a😀b𝄞", 0, []string{})), prim.ShowInt(codePointLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), prim.ShowInt(changedTextIsWalkedEachIteration("naïve 😀 banana 日本 a𝄞a", 0)), prim.ShowInt(literalIndexesAloneWalkTheText("naïve 😀 banana 日本 a𝄞a", 0)), prim.ShowArray(maybe.ShowChar, closureInTheLoopReadsTheView("x😀yz", 0, []maybe.MaybeChar{})), prim.ShowArray(maybe.ShowChar, mapped), result}
}

func charAtLoopViewsTheText(text string, i int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		if i >= textUnits.Length() {
			return count
		}
		scrutinee := textUnits.CharAt(func(payload rune) maybe.MaybeChar {
			return maybe.MaybeChar{Tag: maybe.MaybeCharJust, Just: payload}
		}, maybe.MaybeChar{Tag: maybe.MaybeCharNothing}, i)
		var result2 bool
		switch scrutinee.Tag {
		case maybe.MaybeCharJust:
			result2 = scrutinee.Just == 'a'
		default:
			result2 = false
		}
		var result int32
		if result2 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i + 1, result
	}
}

func unsafeCharAtLoopViewsTheText(text string, i int32, reversed string) string {
	reversedBytes := []byte(reversed)
	textUnits := prim.UTF16(text)
	for {
		if i < 0 {
			return string(reversedBytes)
		}
		i, reversedBytes = i - 1, append(reversedBytes, prim.CharSingleton(textUnits.UnsafeCharAt(i))...)
	}
}

func indexOfLoopViewsTheText(text string, offset int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		scrutinee := textUnits.IndexOfStartingAt(func(payload int32) maybe.MaybeInt {
			return maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just: payload}
		}, maybe.MaybeInt{Tag: maybe.MaybeIntNothing}, "a", offset)
		switch scrutinee.Tag {
		case maybe.MaybeIntJust:
			offset, count = scrutinee.Just + 1, count + 1
			continue
		default: // maybe.MaybeIntNothing
			return count
		}
	}
}

func lastIndexOfLoopViewsTheText(text string, offset int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		scrutinee := textUnits.LastIndexOfStartingAt(func(payload int32) maybe.MaybeInt {
			return maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just: payload}
		}, maybe.MaybeInt{Tag: maybe.MaybeIntNothing}, "a", offset)
		if scrutinee.Tag == maybe.MaybeIntJust {
			found := scrutinee.Just
			if found > 0 {
				offset, count = found - 1, count + 1
				continue
			}
		}
		if scrutinee.Tag == maybe.MaybeIntJust {
			return count + 1
		}
		return count
	}
}

func slicesInALoopViewTheText(text string, i int32, pieces []string) []string {
	pieces = slices.Clip(pieces)
	textUnits := prim.UTF16(text)
	for {
		if i >= textUnits.Length() {
			return pieces
		}
		i, pieces = i + 2, append(pieces, textUnits.Slice(i, i + 2), textUnits.Take(i), textUnits.Drop(i))
	}
}

func codePointLoopViewsTheText(text string, i int32, count int32) int32 {
	textPoints := direct.CodePoints(text)
	for {
		if i >= textPoints.Length() {
			return count
		}
		var result2 maybe.MaybeInt
		if i < 0 {
			result2 = maybe.MaybeInt{Tag: maybe.MaybeIntNothing}
		} else if i == 0 && text == "" {
			result2 = maybe.MaybeInt{Tag: maybe.MaybeIntNothing}
		} else if i == 0 {
			s := text
			result2 = maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just: direct.CodePointAt0(nil, s)}
		} else {
			n := i
			result2 = textPoints.CodePointAt(func(payload int32) maybe.MaybeInt {
				return maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just: payload}
			}, maybe.MaybeInt{Tag: maybe.MaybeIntNothing}, n)
		}
		scrutinee := textPoints.Take(i + 1)
		var result3 maybe.MaybeInt
		if false {
			result3 = maybe.MaybeInt{Tag: maybe.MaybeIntNothing}
		} else if scrutinee == "" {
			result3 = maybe.MaybeInt{Tag: maybe.MaybeIntNothing}
		} else {
			result3 = maybe.MaybeInt{Tag: maybe.MaybeIntJust, Just: direct.CodePointAt0(nil, scrutinee)}
		}
		var result4 bool
		if result2.Tag == maybe.MaybeIntNothing && result3.Tag == maybe.MaybeIntNothing {
			result4 = true
		} else if result2.Tag == maybe.MaybeIntJust && result3.Tag == maybe.MaybeIntJust {
			result4 = result2.Just == result3.Just
		} else {
			result4 = false
		}
		var result int32
		if result4 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i + 1, result
	}
}

func changedTextIsWalkedEachIteration(rest string, count int32) int32 {
	for {
		scrutinee := prim.CodeUnitCharAt(func(payload rune) maybe.MaybeChar {
			return maybe.MaybeChar{Tag: maybe.MaybeCharJust, Just: payload}
		}, maybe.MaybeChar{Tag: maybe.MaybeCharNothing}, prim.IntMod(count, 2), rest)
		switch scrutinee.Tag {
		case maybe.MaybeCharJust:
			rest, count = prim.CodeUnitDrop(1 + prim.IntMod(count, 2), rest), count + 1
			continue
		default: // maybe.MaybeCharNothing
			return count
		}
	}
}

func literalIndexesAloneWalkTheText(text string, count int32) int32 {
	for {
		if count >= 3 {
			return count
		}
		count = count + prim.CodeUnitLength(prim.CodeUnitTake(2, text))
	}
}

func closureInTheLoopReadsTheView(text string, i int32, found []maybe.MaybeChar) []maybe.MaybeChar {
	textUnits := prim.UTF16(text)
	for {
		textCaptured := text
		iCaptured := i
		if iCaptured >= textUnits.Length() {
			return found
		}
		array2 := []int32{0, 1}
		mapped := make([]maybe.MaybeChar, len(array2))
		for index, offset := range array2 {
			mapped[index] = textUnits.CharAt(func(payload rune) maybe.MaybeChar {
				return maybe.MaybeChar{Tag: maybe.MaybeCharJust, Just: payload}
			}, maybe.MaybeChar{Tag: maybe.MaybeCharNothing}, iCaptured + offset)
		}
		text, i, found = textCaptured, iCaptured + 3, array.Append(found, mapped)
	}
}

func main() {
	fmt.Println(main_)
}
