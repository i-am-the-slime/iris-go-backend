// Data/Maybe/maybe.go
package maybe

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

type Char int64

const NoChar Char = 1 << 32

type Int int64

const NoInt Int = 1 << 32

func ShowChar(maybe Char) string {
	if maybe != NoChar {
		return "(Just " + prim.ShowChar(rune(maybe)) + ")"
	}
	return "Nothing"
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/purs-backend-go/go-support/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
	"slices"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	text := prim.StringJoinWith(" ", []string{"a😀", "naïve 😀 banana 日本 a𝄞a"})
	step, count := shared.RangeSteps(0, prim.CodeUnitLength(text) - 1)
	mapped := make([]maybe.Char, count)
	textUnits := prim.UTF16(text)
	for index := range count {
		i := int32(index) * step
		mapped[index] = textUnits.CharAt(func(payload rune) maybe.Char {
			return maybe.Char(payload)
		}, maybe.NoChar, i)
	}
	scrutinee := prim.CodeUnitCharAt(func(payload rune) maybe.Char {
		return maybe.Char(payload)
	}, maybe.NoChar, prim.CodeUnitLength("naïve 😀 banana 日本 a𝄞a") - 3, "naïve 😀 banana 日本 a𝄞a")
	var result string
	if scrutinee != maybe.NoChar {
		result = "(Just " + prim.ShowChar(rune(scrutinee)) + ")"
	} else {
		result = "Nothing"
	}
	return []string{prim.ShowInt(charAtLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), unsafeCharAtLoopViewsTheText("ab😀c", 4, ""), prim.ShowInt(indexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), prim.ShowInt(lastIndexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 100, 0)), prim.ShowArray(show.Show, slicesInALoopViewTheText("a😀b𝄞", 0, []string{})), prim.ShowInt(codePointLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), prim.ShowInt(changedTextIsWalkedEachIteration("naïve 😀 banana 日本 a𝄞a", 0)), prim.ShowInt(literalIndexesAloneWalkTheText("naïve 😀 banana 日本 a𝄞a", 0)), prim.ShowArray(maybe.ShowChar, closureInTheLoopReadsTheView("x😀yz", 0, []maybe.Char{})), prim.ShowArray(maybe.ShowChar, mapped), result}
}

func charAtLoopViewsTheText(text string, i int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		if i >= textUnits.Length() {
			return count
		}
		scrutinee := textUnits.CharAt(func(payload rune) maybe.Char {
			return maybe.Char(payload)
		}, maybe.NoChar, i)
		var result2 bool
		if scrutinee != maybe.NoChar {
			result2 = rune(scrutinee) == 'a'
		} else {
			result2 = false
		}
		var result int32
		if result2 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i + 1, result
	}
}

func unsafeCharAtLoopViewsTheText(text string, i int32, reversed string) string {
	reversedBytes := []byte(reversed)
	textUnits := prim.UTF16(text)
	for {
		if i < 0 {
			return string(reversedBytes)
		}
		i, reversedBytes = i - 1, prim.AppendString(reversedBytes, prim.CharSingleton(textUnits.UnsafeCharAt(i)))
	}
}

func indexOfLoopViewsTheText(text string, offset int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		scrutinee := textUnits.IndexOfStartingAt(func(payload int32) maybe.Int {
			return maybe.Int(payload)
		}, maybe.NoInt, "a", offset)
		if scrutinee != maybe.NoInt {
			offset, count = int32(scrutinee) + 1, count + 1
			continue
		}
		return count
	}
}

func lastIndexOfLoopViewsTheText(text string, offset int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		scrutinee := textUnits.LastIndexOfStartingAt(func(payload int32) maybe.Int {
			return maybe.Int(payload)
		}, maybe.NoInt, "a", offset)
		if scrutinee != maybe.NoInt {
			found := int32(scrutinee)
			if found > 0 {
				offset, count = found - 1, count + 1
				continue
			}
		}
		if scrutinee != maybe.NoInt {
			return count + 1
		}
		return count
	}
}

func slicesInALoopViewTheText(text string, i int32, pieces []string) []string {
	pieces = slices.Clip(pieces)
	textUnits := prim.UTF16(text)
	for {
		if i >= textUnits.Length() {
			return pieces
		}
		i, pieces = i + 2, append(pieces, textUnits.Slice(i, i + 2), textUnits.Take(i), textUnits.Drop(i))
	}
}

func codePointLoopViewsTheText(text string, i int32, count int32) int32 {
	textPoints := direct.CodePoints(text)
	for {
		if i >= textPoints.Length() {
			return count
		}
		var result2 maybe.Int
		if i < 0 {
			result2 = maybe.NoInt
		} else if i == 0 && text == "" {
			result2 = maybe.NoInt
		} else if i == 0 {
			s := text
			result2 = maybe.Int(direct.CodePointAt0(nil, s))
		} else {
			n := i
			result2 = textPoints.CodePointAt(func(payload int32) maybe.Int {
				return maybe.Int(payload)
			}, maybe.NoInt, n)
		}
		scrutinee := textPoints.Take(i + 1)
		var result3 maybe.Int
		if false {
			result3 = maybe.NoInt
		} else if scrutinee == "" {
			result3 = maybe.NoInt
		} else {
			result3 = maybe.Int(direct.CodePointAt0(nil, scrutinee))
		}
		var result4 bool
		if result2 == maybe.NoInt && result3 == maybe.NoInt {
			result4 = true
		} else if result2 != maybe.NoInt && result3 != maybe.NoInt {
			result4 = int32(result2) == int32(result3)
		} else {
			result4 = false
		}
		var result int32
		if result4 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i + 1, result
	}
}

func changedTextIsWalkedEachIteration(rest string, count int32) int32 {
	for {
		scrutinee := prim.CodeUnitCharAt(func(payload rune) maybe.Char {
			return maybe.Char(payload)
		}, maybe.NoChar, prim.IntMod(count, 2), rest)
		if scrutinee != maybe.NoChar {
			rest, count = prim.CodeUnitDrop(1 + prim.IntMod(count, 2), rest), count + 1
			continue
		}
		return count
	}
}

func literalIndexesAloneWalkTheText(text string, count int32) int32 {
	for {
		if count >= 3 {
			return count
		}
		count = count + prim.CodeUnitLength(prim.CodeUnitTake(2, text))
	}
}

func closureInTheLoopReadsTheView(text string, i int32, found []maybe.Char) []maybe.Char {
	textUnits := prim.UTF16(text)
	for {
		textCaptured := text
		iCaptured := i
		if iCaptured >= textUnits.Length() {
			return found
		}
		array2 := []int32{0, 1}
		mapped := make([]maybe.Char, len(array2))
		for index, offset := range array2 {
			mapped[index] = textUnits.CharAt(func(payload rune) maybe.Char {
				return maybe.Char(payload)
			}, maybe.NoChar, iCaptured + offset)
		}
		text, i, found = textCaptured, iCaptured + 3, array.Append(found, mapped)
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

func RangeSteps(start int32, end int32) (int32, int64) {
	if start > end {
		return -1, int64(start) - int64(end) + 1
	}
	return 1, int64(end) - int64(start) + 1
}
