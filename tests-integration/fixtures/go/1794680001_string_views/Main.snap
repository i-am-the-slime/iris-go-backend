// Data/Maybe/maybe.go
package maybe

import "github.com/i-am-the-slime/iris-go/prim"

type Char int64

const NoChar Char = 1 << 32

type Int int64

const NoInt Int = 1 << 32

func ShowChar(maybe Char) string {
	return string(AppendShowChar(nil, maybe))
}

func AppendShowArrayMaybeChar(buffer []byte, array []Char) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowChar(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowChar(buffer []byte, maybe Char) []byte {
	if maybe != NoChar {
		buffer = append(buffer, "(Just "...)
		buffer = prim.AppendShowChar(buffer, rune(maybe))
		buffer = append(buffer, ")"...)
	} else {
		buffer = append(buffer, "Nothing"...)
	}
	return buffer
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	text := prim.StringJoinWith(" ", []string{"a😀", "naïve 😀 banana 日本 a𝄞a"})
	step, count := arraypkg.RangeSteps(0, prim.CodeUnitLength(text)-1)
	mapped := make([]maybe.Char, count)
	textUnits := prim.UTF16(text)
	for index := range count {
		i := int32(index) * step
		mapped[index] = textUnits.CharAt(func(payload rune) maybe.Char {
			return maybe.Char(payload)
		}, maybe.NoChar, i)
	}
	codeUnitCharAt := prim.CodeUnitCharAt(func(payload rune) maybe.Char {
		return maybe.Char(payload)
	}, maybe.NoChar, int32(23)-3, "naïve 😀 banana 日本 a𝄞a")
	var result string
	if codeUnitCharAt != maybe.NoChar {
		result = "(Just " + prim.ShowChar(rune(codeUnitCharAt)) + ")"
	} else {
		result = "Nothing"
	}
	return []string{strconv.Itoa(int(charAtLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0))), unsafeCharAtLoopViewsTheText("ab😀c", 4, ""), strconv.Itoa(int(indexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0))), strconv.Itoa(int(lastIndexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 100, 0))), string(show.AppendShowArrayString(nil, slicesInALoopViewTheText("a😀b𝄞", 0, []string{}))), strconv.Itoa(int(codePointLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0))), strconv.Itoa(int(changedTextIsWalkedEachIteration("naïve 😀 banana 日本 a𝄞a", 0))), strconv.Itoa(int(literalIndexesAloneWalkTheText("naïve 😀 banana 日本 a𝄞a", 0))), string(maybe.AppendShowArrayMaybeChar(nil, closureInTheLoopReadsTheView("x😀yz", 0, []maybe.Char{}))), string(maybe.AppendShowArrayMaybeChar(nil, mapped)), result}
}

func charAtLoopViewsTheText(text string, i int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	textASCII := textUnits.ASCII()
	for {
		if i >= textUnits.Length() {
			return count
		}
		codeUnitCharAt := maybe.NoChar
		if i >= 0 && int(i) < len(textASCII) {
			codeUnitCharAt = maybe.Char(rune(textASCII[i]))
		} else {
			codeUnitCharAt = textUnits.CharAt(func(payload rune) maybe.Char {
				return maybe.Char(payload)
			}, maybe.NoChar, i)
		}
		var result2 bool
		if codeUnitCharAt != maybe.NoChar {
			result2 = rune(codeUnitCharAt) == 'a'
		} else {
			result2 = false
		}
		var result int32
		if result2 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i+1, result
	}
}

func unsafeCharAtLoopViewsTheText(text string, i int32, reversed string) string {
	reversedBytes := []byte(reversed)
	textUnits := prim.UTF16(text)
	for {
		if i < 0 {
			return string(reversedBytes)
		}
		reversedBytes = prim.AppendString(reversedBytes, prim.CharSingleton(textUnits.UnsafeCharAt(i)))
		i -= 1
	}
}

func indexOfLoopViewsTheText(text string, offset int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		codeUnitIndexOfStartingAt := textUnits.IndexOfStartingAt(func(payload int32) maybe.Int {
			return maybe.Int(payload)
		}, maybe.NoInt, "a", offset)
		if codeUnitIndexOfStartingAt != maybe.NoInt {
			offset, count = int32(codeUnitIndexOfStartingAt)+1, count+1
			continue
		}
		return count
	}
}

func lastIndexOfLoopViewsTheText(text string, offset int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		codeUnitLastIndexOfStartingAt := textUnits.LastIndexOfStartingAt(func(payload int32) maybe.Int {
			return maybe.Int(payload)
		}, maybe.NoInt, "a", offset)
		if codeUnitLastIndexOfStartingAt != maybe.NoInt {
			found := int32(codeUnitLastIndexOfStartingAt)
			if found > 0 {
				offset, count = found-1, count+1
				continue
			}
		}
		if codeUnitLastIndexOfStartingAt != maybe.NoInt {
			return count + 1
		}
		return count
	}
}

func slicesInALoopViewTheText(text string, i int32, pieces []string) []string {
	pieces = slices.Clip(pieces)
	textUnits := prim.UTF16(text)
	for {
		if i >= textUnits.Length() {
			return pieces
		}
		i, pieces = i+2, arraypkg.Bounded(append(pieces, textUnits.Slice(i, i+2), textUnits.Take(i), textUnits.Drop(i)))
	}
}

func codePointLoopViewsTheText(text string, i int32, count int32) int32 {
	textPoints := direct.CodePoints(text)
	for {
		if i >= textPoints.Length() {
			return count
		}
		var result2 maybe.Int
		if i < 0 {
			result2 = maybe.NoInt
		} else if i == 0 && text == "" {
			result2 = maybe.NoInt
		} else if i == 0 {
			result2 = maybe.Int(direct.CodePointAt0(nil, text))
		} else {
			result2 = textPoints.CodePointAt(func(payload int32) maybe.Int {
				return maybe.Int(payload)
			}, maybe.NoInt, i)
		}
		codePointTake := textPoints.Take(i + 1)
		var result3 maybe.Int
		if false {
			result3 = maybe.NoInt
		} else if codePointTake == "" {
			result3 = maybe.NoInt
		} else {
			result3 = maybe.Int(direct.CodePointAt0(nil, codePointTake))
		}
		var result4 bool
		if result2 == maybe.NoInt && result3 == maybe.NoInt {
			result4 = true
		} else if result2 != maybe.NoInt && result3 != maybe.NoInt {
			result4 = int32(result2) == int32(result3)
		} else {
			result4 = false
		}
		var result int32
		if result4 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i+1, result
	}
}

func changedTextIsWalkedEachIteration(rest string, count int32) int32 {
	for {
		codeUnitCharAt := prim.CodeUnitCharAt(func(payload rune) maybe.Char {
			return maybe.Char(payload)
		}, maybe.NoChar, count&1, rest)
		if codeUnitCharAt != maybe.NoChar {
			rest, count = prim.CodeUnitDrop(1+count&1, rest), count+1
			continue
		}
		return count
	}
}

func literalIndexesAloneWalkTheText(text string, count int32) int32 {
	for {
		if count >= 3 {
			return count
		}
		count += prim.CodeUnitLength(prim.CodeUnitTake(2, text))
	}
}

func closureInTheLoopReadsTheView(text string, i int32, found []maybe.Char) []maybe.Char {
	textUnits := prim.UTF16(text)
	for {
		if i >= textUnits.Length() {
			return found
		}
		array := []int32{0, 1}
		mapped := make([]maybe.Char, len(array))
		for index, offset := range array {
			mapped[index] = textUnits.CharAt(func(payload rune) maybe.Char {
				return maybe.Char(payload)
			}, maybe.NoChar, i+offset)
		}
		i, found = i+3, arraypkg.Append(found, mapped)
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
