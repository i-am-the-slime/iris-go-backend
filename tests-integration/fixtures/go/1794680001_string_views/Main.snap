// Data/Maybe/maybe.go
package maybe

import "github.com/i-am-the-slime/iris-go/prim"

type Char int64

const NoChar Char = 1 << 32

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

func AppendShowArrayMaybeChar(buffer []byte, array []Char) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowMaybeChar(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowMaybeChar(buffer []byte, maybe Char) []byte {
	if maybe != NoChar {
		buffer = append(buffer, "(Just "...)
		buffer = prim.AppendShowChar(buffer, rune(maybe))
		buffer = append(buffer, ')')
	} else {
		buffer = append(buffer, "Nothing"...)
	}
	return buffer
}

func ArrayMaybeChar(array []Char) string {
	return string(AppendShowArrayMaybeChar(nil, array))
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	text := prim.StringJoinWith(" ", []string{"a😀", "naïve 😀 banana 日本 a𝄞a"})
	step, count := array.RangeSteps(0, prim.CodeUnitLength(text)-1)
	mapped := make([]maybe.Char, count)
	textUnits := prim.UTF16(text)
	textASCII := textUnits.ASCII()
	for index := range count {
		i := index * step
		var codeUnitCharAt maybe.Char
		if i >= 0 && i < len(textASCII) {
			codeUnitCharAt = maybe.Char(rune(textASCII[i]))
		} else {
			value, found := textUnits.CharAt(i)
			if found {
				codeUnitCharAt = maybe.Char(value)
			} else {
				codeUnitCharAt = maybe.NoChar
			}
		}
		mapped[index] = codeUnitCharAt
	}
	x, found2 := prim.CodeUnitCharAt(23-3, "naïve 😀 banana 日本 a𝄞a")
	var result string
	if found2 {
		result = "(Just " + prim.ShowChar(x) + ")"
	} else {
		result = "Nothing"
	}
	return []string{strconv.Itoa(charAtLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), unsafeCharAtLoopViewsTheText("ab😀c", 4, ""), strconv.Itoa(indexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), strconv.Itoa(lastIndexOfLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 100, 0)), show.ArrayString(slicesInALoopViewTheText("a😀b𝄞", 0, []string{})), strconv.Itoa(codePointLoopViewsTheText("naïve 😀 banana 日本 a𝄞a", 0, 0)), strconv.Itoa(changedTextIsWalkedEachIteration("naïve 😀 banana 日本 a𝄞a", 0)), strconv.Itoa(literalIndexesAloneWalkTheText("naïve 😀 banana 日本 a𝄞a", 0)), maybe.ArrayMaybeChar(closureInTheLoopReadsTheView("x😀yz", 0, []maybe.Char{})), maybe.ArrayMaybeChar(mapped), result}
}

func charAtLoopViewsTheText(text string, i int, count int) int {
	textUnits := prim.UTF16(text)
	textASCII := textUnits.ASCII()
	for {
		if i >= textUnits.Length() {
			return count
		}
		var result2 bool
		if i >= 0 && i < len(textASCII) {
			result2 = rune(textASCII[i]) == 'a'
		} else {
			left0, found := textUnits.CharAt(i)
			if found {
				result2 = left0 == 'a'
			} else {
				result2 = false
			}
		}
		var result int
		if result2 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i+1, result
	}
}

func unsafeCharAtLoopViewsTheText(text string, i int, reversed string) string {
	reversedBytes := []byte(reversed)
	textUnits := prim.UTF16(text)
	for {
		if i < 0 {
			return string(reversedBytes)
		}
		reversedBytes = prim.AppendString(reversedBytes, prim.CharSingleton(textUnits.UnsafeCharAt(i)))
		i -= 1
	}
}

func indexOfLoopViewsTheText(text string, offset int, count int) int {
	textUnits := prim.UTF16(text)
	for {
		found, found2 := textUnits.IndexOfStartingAt("a", offset)
		if found2 {
			offset, count = found+1, count+1
			continue
		} else {
			return count
		}
	}
}

func lastIndexOfLoopViewsTheText(text string, offset int, count int) int {
	textUnits := prim.UTF16(text)
	for {
		value, found := textUnits.LastIndexOfStartingAt("a", offset)
		var codeUnitLastIndexOfStartingAt maybe.Int
		if found {
			codeUnitLastIndexOfStartingAt = maybe.JustInt(value)
		} else {
			codeUnitLastIndexOfStartingAt = maybe.NoInt
		}
		if codeUnitLastIndexOfStartingAt.Tag == maybe.TagJust {
			found2 := codeUnitLastIndexOfStartingAt.Just
			if found2 > 0 {
				offset, count = found2-1, count+1
				continue
			}
			return count + 1
		}
		return count
	}
}

func slicesInALoopViewTheText(text string, i int, pieces []string) []string {
	pieces = slices.Clip(pieces)
	textUnits := prim.UTF16(text)
	textASCII := textUnits.ASCII()
	for {
		if i >= textUnits.Length() {
			return pieces
		}
		var textCut string
		if i > 0 && i <= len(textASCII) {
			textCut = textASCII[:i]
		} else {
			textCut = textUnits.Take(i)
		}
		var textCut2 string
		if i >= 0 && i < len(textASCII) {
			textCut2 = textASCII[i:]
		} else {
			textCut2 = textUnits.Drop(i)
		}
		i, pieces = i+2, append(pieces, textUnits.Slice(i, i+2), textCut, textCut2)
	}
}

func codePointLoopViewsTheText(text string, i int, count int) int {
	textPoints := direct.CodePoints(text)
	for {
		if i >= textPoints.Length() {
			return count
		}
		var result2 maybe.Int
		if i < 0 || i == 0 && text == "" {
			result2 = maybe.NoInt
		} else if i == 0 {
			result2 = maybe.JustInt(direct.CodePointAt0(nil, text))
		} else {
			value, found := textPoints.CodePointAt(i)
			var codePointAt maybe.Int
			if found {
				codePointAt = maybe.JustInt(value)
			} else {
				codePointAt = maybe.NoInt
			}
			result2 = codePointAt
		}
		codePointTake := textPoints.Take(i + 1)
		var result3 maybe.Int
		if codePointTake == "" {
			result3 = maybe.NoInt
		} else {
			result3 = maybe.JustInt(direct.CodePointAt0(nil, codePointTake))
		}
		var result4 bool
		if result2.Tag == maybe.TagNothing && result3.Tag == maybe.TagNothing {
			result4 = true
		} else if result2.Tag == maybe.TagJust && result3.Tag == maybe.TagJust {
			result4 = result2.Just == result3.Just
		} else {
			result4 = false
		}
		var result int
		if result4 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i+1, result
	}
}

func changedTextIsWalkedEachIteration(rest string, count int) int {
	for {
		_, found := prim.CodeUnitCharAt(count&1, rest)
		if found {
			rest, count = prim.CodeUnitDrop(1+count&1, rest), count+1
			continue
		} else {
			return count
		}
	}
}

func literalIndexesAloneWalkTheText(text string, count int) int {
	for {
		if count >= 3 {
			return count
		}
		count += prim.CodeUnitLength(prim.CodeUnitTake(2, text))
	}
}

func closureInTheLoopReadsTheView(text string, i int, found []maybe.Char) []maybe.Char {
	found = slices.Clip(found)
	textUnits := prim.UTF16(text)
	textASCII := textUnits.ASCII()
	for {
		if i >= textUnits.Length() {
			return found
		}
		var codeUnitCharAt maybe.Char
		if i >= 0 && i < len(textASCII) {
			codeUnitCharAt = maybe.Char(rune(textASCII[i]))
		} else {
			value, found2 := textUnits.CharAt(i)
			if found2 {
				codeUnitCharAt = maybe.Char(value)
			} else {
				codeUnitCharAt = maybe.NoChar
			}
		}
		value2, found3 := textUnits.CharAt(i + 1)
		var codeUnitCharAt2 maybe.Char
		if found3 {
			codeUnitCharAt2 = maybe.Char(value2)
		} else {
			codeUnitCharAt2 = maybe.NoChar
		}
		i, found = i+3, append(found, codeUnitCharAt, codeUnitCharAt2)
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
