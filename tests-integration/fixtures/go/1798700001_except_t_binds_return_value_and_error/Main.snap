// Data/Either/either.go
package either

type EitherStringInt struct {
	Left  string
	Right int32
	Tag   uint8
}

const (
	EitherStringIntLeft = iota
	EitherStringIntRight
)

type EitherIntInt struct {
	Field0 int32
	Tag    uint8
}

const (
	EitherIntIntLeft = iota
	EitherIntIntRight
)

func Left(field0 int32) EitherIntInt {
	return EitherIntInt{Tag: EitherIntIntLeft, Field0: field0}
}

func Right(field0 int32) EitherIntInt {
	return EitherIntInt{Tag: EitherIntIntRight, Field0: field0}
}

func EitherIntIntFromResults(value int32, err *int32) EitherIntInt {
	if err != nil {
		return Left(*err)
	}
	return Right(value)
}

// Data/Variant/variant.go
package variant

type NotFoundTooBig struct {
	NotFound string
	TooBig   int32
	Tag      uint8
}

const (
	NotFoundTooBigNotFound = iota
	NotFoundTooBigTooBig
)

type EitherVariantNotFoundTooBigString struct {
	Left  NotFoundTooBig
	Right string
	Tag   uint8
}

const (
	EitherVariantNotFoundTooBigStringLeft = iota
	EitherVariantNotFoundTooBigStringRight
)

func TooBig(tooBig int32) NotFoundTooBig {
	return NotFoundTooBig{Tag: NotFoundTooBigTooBig, TooBig: tooBig}
}

func NotFound(notFound string) NotFoundTooBig {
	return NotFoundTooBig{Tag: NotFoundTooBigNotFound, NotFound: notFound}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Variant"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	i, err := chain(5)
	var result string
	if err != nil {
		result = "(Left " + prim.ShowString(*err) + ")"
	} else {
		result = "(Right " + strconv.Itoa(int(i)) + ")"
	}
	journal.Log(result)
	i2, err := chain(0)
	var result2 string
	if err != nil {
		result2 = "(Left " + prim.ShowString(*err) + ")"
	} else {
		result2 = "(Right " + strconv.Itoa(int(i2)) + ")"
	}
	journal.Log(result2)
	i3, err := countdown(10)
	var result3 string
	if err != nil {
		result3 = "(Left " + prim.ShowString(*err) + ")"
	} else {
		result3 = "(Right " + strconv.Itoa(int(i3)) + ")"
	}
	journal.Log(result3)
	i4, err := countdown(9)
	var result4 string
	if err != nil {
		result4 = "(Left " + prim.ShowString(*err) + ")"
	} else {
		result4 = "(Right " + strconv.Itoa(int(i4)) + ")"
	}
	journal.Log(result4)
	s, err2 := greet(42)
	var result5 string
	if err2 != nil {
		switch err2.Tag {
		case variant.NotFoundTooBigNotFound:
			result5 = "missing: " + err2.NotFound
		default: // variant.NotFoundTooBigTooBig
			result5 = "too big: " + strconv.Itoa(int(err2.TooBig))
		}
	} else {
		result5 = s
	}
	journal.Log(result5)
	s2, err2 := greet(7)
	var result6 string
	if err2 != nil {
		switch err2.Tag {
		case variant.NotFoundTooBigNotFound:
			result6 = "missing: " + err2.NotFound
		default: // variant.NotFoundTooBigTooBig
			result6 = "too big: " + strconv.Itoa(int(err2.TooBig))
		}
	} else {
		result6 = s2
	}
	journal.Log(result6)
	s3, err2 := greet(5000)
	var result7 string
	if err2 != nil {
		switch err2.Tag {
		case variant.NotFoundTooBigNotFound:
			result7 = "missing: " + err2.NotFound
		default: // variant.NotFoundTooBigTooBig
			result7 = "too big: " + strconv.Itoa(int(err2.TooBig))
		}
	} else {
		result7 = s3
	}
	journal.Log(result7)
	s4, err2 := greet(9)
	var result8 string
	if err2 != nil {
		result8 = "failed"
	} else {
		result8 = s4
	}
	journal.Log(result8)
	ref := &shared.Ref[int32]{Value: 0}
	either2 := either.EitherIntIntFromResults(statuses(ref))
	var result9 string
	switch either2.Tag {
	case either.EitherIntIntLeft:
		result9 = "(Left " + strconv.Itoa(int(either2.Field0)) + ")"
	default: // either.EitherIntIntRight
		result9 = "(Right " + strconv.Itoa(int(either2.Field0)) + ")"
	}
	journal.Log(result9)
	ref.Value = 3
	either3 := either.EitherIntIntFromResults(statuses(ref))
	var result10 string
	switch either3.Tag {
	case either.EitherIntIntLeft:
		result10 = "(Left " + strconv.Itoa(int(either3.Field0)) + ")"
	default: // either.EitherIntIntRight
		result10 = "(Right " + strconv.Itoa(int(either3.Field0)) + ")"
	}
	journal.Log(result10)
	ref.Value = 19
	either4 := either.EitherIntIntFromResults(statuses(ref))
	var result11 string
	switch either4.Tag {
	case either.EitherIntIntLeft:
		result11 = "(Left " + strconv.Itoa(int(either4.Field0)) + ")"
	default: // either.EitherIntIntRight
		result11 = "(Right " + strconv.Itoa(int(either4.Field0)) + ")"
	}
	journal.Log(result11)
}

func chain(n int32) (int32, *string) {
	switch n {
	case 0:
		return 0, new("division by zero")
	default:
		field := 100 / n
		if field > 10 {
			scrutinee := n - 1
			switch scrutinee {
			case 0:
				return 0, new("division by zero")
			default:
				return chainJoin(field, prim.IntDiv(field, scrutinee))
			}
		} else {
			return chainJoin(field, field)
		}
	}
}

func countdown(n int32) (int32, *string) {
	if n < 0 {
		return 0, new("below zero")
	}
	if n == 0 {
		return 0, nil
	}
	i, err := countdown(n - 2)
	if err != nil {
		return 0, err
	}
	return i+n, nil
}

func greet(id int32) (string, *variant.NotFoundTooBig) {
	if id == 42 {
		journal.Log("found Alice")
		id2 := id*2 - id
		if id2 == 42 {
			return "hello Alice and Alice", nil
		}
		if id2 > 1000 {
			return "", new(variant.TooBig(id2))
		}
		return "", new(variant.NotFound("no user "+strconv.Itoa(int(id2))))
	}
	if id > 1000 {
		return "", new(variant.TooBig(id))
	}
	return "", new(variant.NotFound("no user "+strconv.Itoa(int(id))))
}

func statuses(ref *shared.Ref[int32]) (int32, *int32) {
	s := ref.Value
	s_ := s + 1
	ref.Value = s_
	var either2 either.EitherIntInt
	if s_ > 10 {
		either2 = either.Left(500)
	} else {
		either2 = either.EitherIntIntFromResults(status(s_))
	}
	switch either2.Tag {
	case either.EitherIntIntLeft:
		return 0, new(either2.Field0)
	default: // either.EitherIntIntRight
		b := either2.Field0
		var either3 either.EitherIntInt
		if b > 5 {
			either3 = either.Right(1)
		} else {
			either3 = either.EitherIntIntFromResults(status(s_ + 4))
		}
		switch either3.Tag {
		case either.EitherIntIntLeft:
			return 0, new(either3.Field0)
		default: // either.EitherIntIntRight
			return b+either3.Field0, nil
		}
	}
}

func status(n int32) (int32, *int32) {
	if n > 100 {
		return 0, new(int32(404))
	}
	if n > 3 {
		either2 := either.EitherIntIntFromResults(status(n * 2))
		switch either2.Tag {
		case either.EitherIntIntLeft:
			return 0, new(either2.Field0)
		default: // either.EitherIntIntRight
			return either2.Field0+1, nil
		}
	}
	return 7, nil
}

func chainJoin(field int32, b int32) (int32, *string) {
	journal.Log("chain " + strconv.Itoa(int(field)) + " " + strconv.Itoa(int(b)))
	return field+b, nil
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
