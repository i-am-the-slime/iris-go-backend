// Data/Either/either.go
package either

type EitherString struct {
	Left  string
	Right int
	Tag   uint8
}

const (
	EitherStringLeft = iota
	EitherStringRight
)

type EitherInt struct {
	Field0 int32
	Tag    uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type IntFailure struct {
	Failed bool
	Left   int
}

type StringFailure struct {
	Failed bool
	Left   string
}

// Data/Variant/variant.go
package variant

type NotFoundTooBig struct {
	NotFound string
	TooBig   int32
	Tag      uint8
}

const (
	NotFoundTooBigNotFound = iota
	NotFoundTooBigTooBig
)

type Either struct {
	Left  NotFoundTooBig
	Right string
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type NotFoundTooBigFailure struct {
	Failed bool
	Left   NotFoundTooBig
}

func TooBig(tooBig int) NotFoundTooBig {
	return NotFoundTooBig{Tag: NotFoundTooBigTooBig, TooBig: int32(tooBig)}
}

func NotFound(notFound string) NotFoundTooBig {
	return NotFoundTooBig{Tag: NotFoundTooBigNotFound, NotFound: notFound}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Variant"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func main() {
	i, err := chain(5)
	var result string
	if err.Failed {
		result = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result = "(Right " + strconv.Itoa(i) + ")"
	}
	journal.Log(result)
	i2, err := chain(0)
	var result2 string
	if err.Failed {
		result2 = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result2 = "(Right " + strconv.Itoa(i2) + ")"
	}
	journal.Log(result2)
	i3, err := countdown(10)
	var result3 string
	if err.Failed {
		result3 = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result3 = "(Right " + strconv.Itoa(i3) + ")"
	}
	journal.Log(result3)
	i4, err := countdown(9)
	var result4 string
	if err.Failed {
		result4 = "(Left " + prim.ShowString(err.Left) + ")"
	} else {
		result4 = "(Right " + strconv.Itoa(i4) + ")"
	}
	journal.Log(result4)
	s, err2 := greet(42)
	var result5 string
	if err2.Failed {
		switch err2.Left.Tag {
		case variant.NotFoundTooBigNotFound:
			result5 = "missing: " + err2.Left.NotFound
		default: // variant.NotFoundTooBigTooBig
			result5 = "too big: " + strconv.Itoa(int(err2.Left.TooBig))
		}
	} else {
		result5 = s
	}
	journal.Log(result5)
	s2, err2 := greet(7)
	var result6 string
	if err2.Failed {
		switch err2.Left.Tag {
		case variant.NotFoundTooBigNotFound:
			result6 = "missing: " + err2.Left.NotFound
		default: // variant.NotFoundTooBigTooBig
			result6 = "too big: " + strconv.Itoa(int(err2.Left.TooBig))
		}
	} else {
		result6 = s2
	}
	journal.Log(result6)
	s3, err2 := greet(5000)
	var result7 string
	if err2.Failed {
		switch err2.Left.Tag {
		case variant.NotFoundTooBigNotFound:
			result7 = "missing: " + err2.Left.NotFound
		default: // variant.NotFoundTooBigTooBig
			result7 = "too big: " + strconv.Itoa(int(err2.Left.TooBig))
		}
	} else {
		result7 = s3
	}
	journal.Log(result7)
	s4, err2 := greet(9)
	var result8 string
	if err2.Failed {
		result8 = "failed"
	} else {
		result8 = s4
	}
	journal.Log(result8)
	ref := &shared.Ref[int]{Value: 0}
	i5, err3 := statuses(ref)
	var result9 string
	if err3.Failed {
		result9 = "(Left " + strconv.Itoa(err3.Left) + ")"
	} else {
		result9 = "(Right " + strconv.Itoa(i5) + ")"
	}
	journal.Log(result9)
	ref.Value = 3
	i6, err3 := statuses(ref)
	var result10 string
	if err3.Failed {
		result10 = "(Left " + strconv.Itoa(err3.Left) + ")"
	} else {
		result10 = "(Right " + strconv.Itoa(i6) + ")"
	}
	journal.Log(result10)
	ref.Value = 19
	i7, err3 := statuses(ref)
	var result11 string
	if err3.Failed {
		result11 = "(Left " + strconv.Itoa(err3.Left) + ")"
	} else {
		result11 = "(Right " + strconv.Itoa(i7) + ")"
	}
	journal.Log(result11)
}

func chain(n int) (int, either.StringFailure) {
	switch n {
	case 0:
		return 0, either.StringFailure{Failed: true, Left: "division by zero"}
	default:
		field := 100 / n
		if field > 10 {
			scrutinee := n - 1
			switch scrutinee {
			case 0:
				return 0, either.StringFailure{Failed: true, Left: "division by zero"}
			default:
				return chainJoin(field, prim.IntDiv(field, scrutinee))
			}
		} else {
			return chainJoin(field, field)
		}
	}
}

func countdown(n int) (int, either.StringFailure) {
	if n < 0 {
		return 0, either.StringFailure{Failed: true, Left: "below zero"}
	}
	if n == 0 {
		return 0, either.StringFailure{}
	}
	i, err := countdown(n - 2)
	if err.Failed {
		return 0, err
	}
	return i+n, either.StringFailure{}
}

func greet(id int) (string, variant.NotFoundTooBigFailure) {
	if id == 42 {
		journal.Log("found Alice")
		id2 := id*2 - id
		if id2 == 42 {
			return "hello Alice and Alice", variant.NotFoundTooBigFailure{}
		}
		if id2 > 1000 {
			return "", variant.NotFoundTooBigFailure{Failed: true, Left: variant.TooBig(id2)}
		}
		return "", variant.NotFoundTooBigFailure{Failed: true, Left: variant.NotFound("no user " + strconv.Itoa(id2))}
	}
	if id > 1000 {
		return "", variant.NotFoundTooBigFailure{Failed: true, Left: variant.TooBig(id)}
	}
	return "", variant.NotFoundTooBigFailure{Failed: true, Left: variant.NotFound("no user " + strconv.Itoa(id))}
}

func statuses(ref *shared.Ref[int]) (int, either.IntFailure) {
	s := ref.Value
	s_ := s + 1
	ref.Value = s_
	if s_ > 10 {
		return 0, either.IntFailure{Failed: true, Left: 500}
	}
	b, err := status(s_)
	if err.Failed {
		return 0, err
	}
	if b > 5 {
		return b+1, either.IntFailure{}
	}
	i, err := status(s_ + 4)
	if err.Failed {
		return 0, err
	}
	return b+i, either.IntFailure{}
}

func status(n int) (int, either.IntFailure) {
	if n > 100 {
		return 0, either.IntFailure{Failed: true, Left: 404}
	}
	if n > 3 {
		i, err := status(n * 2)
		if err.Failed {
			return 0, err
		}
		return i+1, either.IntFailure{}
	}
	return 7, either.IntFailure{}
}

func chainJoin(field int, b int) (int, either.StringFailure) {
	journal.Log("chain " + strconv.Itoa(field) + " " + strconv.Itoa(b))
	return field+b, either.StringFailure{}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
