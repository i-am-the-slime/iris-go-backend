// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

type String struct {
	Just string
	Tag  uint8
}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

var NoString = String{Tag: TagNothing}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"strconv"
)

func main() {
	array := []maybe.Int{maybe.JustInt(1), maybe.NoInt, maybe.JustInt(3)}
	bound := make([]int, 0, len(array))
	for xIndex := range array {
		switch array[xIndex].Tag {
		case maybe.TagNothing:
		default: // maybe.TagJust
			bound = append(bound, array[xIndex].Just)
		}
	}
	journal.Log(show.ArrayInt(bound))
	array2 := []maybe.String{maybe.JustString("a"), maybe.NoString}
	bound2 := make([]string, 0, len(array2))
	for xIndex := range array2 {
		switch array2[xIndex].Tag {
		case maybe.TagNothing:
		default: // maybe.TagJust
			bound2 = append(bound2, array2[xIndex].Just)
		}
	}
	journal.Log(show.ArrayString(bound2))
	array3 := [][]shared.LeftRight{{{Left: 1, Right: "x"}}, {{Left: 2, Right: "x"}}}
	mapped := []string{}
	for _, value := range array3 {
		for leftRightIndex := range value {
			mapped = append(mapped, strconv.Itoa(value[leftRightIndex].Left)+value[leftRightIndex].Right)
		}
	}
	journal.Log(show.ArrayString(mapped))
}

// shared/shared.go
package shared

type LeftRight struct {
	Right string
	Left  int
}
