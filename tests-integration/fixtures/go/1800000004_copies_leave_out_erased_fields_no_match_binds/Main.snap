// main.go
package main

import (
	journal "fixture/Journal_ffi"
	"strconv"
)

type Nested struct {
	Deep0 any
	Deep1 *Nested
	Tag   uint8
}

const (
	NestedFlat = iota
	NestedDeep
)

func main() {
	journal.Log(strconv.Itoa(1 + depthDeep(&Nested{Tag: NestedFlat})))
	journal.Log(strconv.Itoa(2 + totalDeepDeep(&Nested{Tag: NestedFlat})))
}

func depth(value *Nested) int {
	switch value.Tag {
	case NestedFlat:
		return 0
	default: // NestedDeep
		return 1 + depth(value.Deep1)
	}
}

func total(value *Nested) int {
	if value.Tag == NestedFlat {
		return 0
	}
	if value.Tag == NestedDeep && value.Deep1.Tag == NestedFlat {
		return 1
	}
	return 2 + total(value.Deep1)
}

func depthDeep(rest *Nested) int {
	return 1 + depth(rest)
}

func totalDeep(rest *Nested) int {
	switch rest.Tag {
	case NestedFlat:
		return 1
	default:
		return 2 + total(rest)
	}
}

func totalDeepDeep(nested *Nested) int {
	return 2 + totalDeep(nested)
}
