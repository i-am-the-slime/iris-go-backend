// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"math/bits"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() [][]int {
	mapped := make([]int, len(numbers))
	for index, number := range numbers {
		mapped[index] = bits.OnesCount(uint(number))
	}
	mapped2 := make([]int, len(numbers))
	for index, number := range numbers {
		mapped2[index] = bits.OnesCount(uint(number))
	}
	mapped3 := make([]int, len(numbers))
	for index, number := range numbers {
		mapped3[index] = bits.OnesCount(uint(number))
	}
	mapped4 := make([]int, len(numbers))
	for index, element := range numbers {
		mapped4[index] = pairsOfBits(element)
	}
	return [][]int{mapped, mapped2, mapped3, mapped4}
}

var numbers []int = []int{0, 1, 2, 3, 255, 256, 1000, 123456789, 2147483647}

func pairsOfBits(number int) int {
	switch number {
	case 0:
		return 0
	default:
		return number&3 + pairsOfBits(int(uint(number)>>2))
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts2 := make([]string, 0, len(element))
		for _, element2 := range element {
			texts2 = append(texts2, prim.ShowInt(element2))
		}
		texts = append(texts, "["+strings.Join(texts2, " ")+"]")
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
