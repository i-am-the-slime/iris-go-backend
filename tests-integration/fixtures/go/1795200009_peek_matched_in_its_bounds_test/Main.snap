// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	array2 := *array.Thaw([]int32{10, 20, 30})
	for i := int32(0); i < 3; i++ {
		within := int(i) < len(array2)
		if within {
			element := array2[i]
			array2[i] = prim.IntModPositive(element, 7)
		}
	}
	within2 := 0 < len(array2)
	var first int32
	if within2 {
		first = array2[0]
	} else {
		first = 0
	}
	within3 := 5 < len(array2)
	var i2 int32
	if within3 {
		i2 = array2[5]
	} else {
		i2 = 0
	}
	array3 := shared.Frozen(array2)
	performed := array.Append(array3, []int32{first, i2, -1})
	return performed
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
