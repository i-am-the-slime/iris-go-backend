// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{10, 20, 30})()
	for i := int32(0); i < 3; i++ {
		within := i >= 0 && int(i) < len(*array2)
		if within {
			element := (*array2)[i]
			if i >= 0 && int(i) < len(*array2) {
				(*array2)[i] = prim.IntMod(element, 7)
			}
		}
	}
	within2 := 0 < len(*array2)
	var i2 int32
	if within2 {
		element := (*array2)[0]
		i2 = element
	} else {
		i2 = 0
	}
	within3 := 5 < len(*array2)
	var i3 int32
	if within3 {
		element := (*array2)[5]
		i3 = element
	} else {
		i3 = 0
	}
	array3 := array.UnsafeFreeze(array2)()
	performed := array.Append(array3, []int32{i2, i3, -1})
	return performed
}

func main() {
	fmt.Println(main_)
}
