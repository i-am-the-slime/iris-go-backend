// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	array2 := *array.Thaw([]int{10, 20, 30})
	for i := 0; i < 3; i++ {
		within := i < len(array2)
		if within {
			element := array2[i]
			array2[i] = prim.IntModPositive(element, 7)
		}
	}
	within2 := len(array2) > 0
	var first int
	if within2 {
		first = array2[0]
	} else {
		first = 0
	}
	within3 := len(array2) > 5
	var missing int
	if within3 {
		missing = array2[5]
	} else {
		missing = 0
	}
	elements := shared.Frozen(array2)
	performed := array.Append(elements, []int{first, missing, -1})
	return performed
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
