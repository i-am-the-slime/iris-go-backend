// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{10, 20, 30})()
	elements := *array2
	for i := int32(0); i < 3; i++ {
		within := int(i) < len(elements)
		if within {
			element := elements[i]
			elements[i] = prim.IntMod(element, 7)
		}
	}
	within2 := 0 < len(*array2)
	var i2 int32
	if within2 {
		element := (*array2)[0]
		i2 = element
	} else {
		i2 = 0
	}
	within3 := 5 < len(*array2)
	var i3 int32
	if within3 {
		element := (*array2)[5]
		i3 = element
	} else {
		i3 = 0
	}
	array3 := array.UnsafeFreeze(array2)()
	performed := array.Append(array3, []int32{i2, i3, -1})
	return performed
}

func main() {
	fmt.Println(main_)
}
