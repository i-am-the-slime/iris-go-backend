// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{10, 20, 30})()
	elements := *array2
	for i := int32(0); i < 3; i++ {
		within := int(i) < len(elements)
		if within {
			element := elements[i]
			elements[i] = prim.IntMod(element, 7)
		}
	}
	within2 := 0 < len(*array2)
	var first int32
	if within2 {
		first = (*array2)[0]
	} else {
		first = 0
	}
	within3 := 5 < len(*array2)
	var i2 int32
	if within3 {
		i2 = (*array2)[5]
	} else {
		i2 = 0
	}
	array3 := array.UnsafeFreeze(array2)()
	performed := array.Append(array3, []int32{first, i2, -1})
	return performed
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
