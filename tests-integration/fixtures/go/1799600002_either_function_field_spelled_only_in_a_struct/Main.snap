// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/array"
)

type ReadError struct {
	Unknown string
	Tag     uint8
}

const (
	ReadErrorUnknown = iota
	ReadErrorEmpty
)

type Either struct {
	Left  ReadError
	Right int
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type Reader struct {
	Name string
	Read func(string) (int, ReadErrorFailure)
}

type Parser struct {
	Option Reader
	Both0  *Parser
	Both1  *Parser
	Done   int
	Tag    uint8
}

const (
	ParserOption = iota
	ParserDone
	ParserBoth
)

type ReadErrorFailure struct {
	Failed bool
	Left   ReadError
}

func Done(done int) *Parser {
	return &Parser{Tag: ParserDone, Done: done}
}

func main() {
	journal.Log(show.ArrayString(namesBoth(Done(1), Done(2))))
	journal.Log(show.ArrayString(namesDone("a")))
}

func names(value *Parser) []string {
	switch value.Tag {
	case ParserOption:
		return []string{value.Option.Name}
	case ParserDone:
		return []string{}
	default: // ParserBoth
		return array.Append(names(value.Both0), names(value.Both1))
	}
}

func namesBoth(left *Parser, right *Parser) []string {
	return array.Append(names(left), names(right))
}

func namesDone(s string) []string {
	return []string{}
}
