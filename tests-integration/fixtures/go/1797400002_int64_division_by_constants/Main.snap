// Data/Int64/int64.go
package dataint64

import "strconv"

func AppendShowArrayInt64(buffer []byte, array []int64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowInt64(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowInt64(buffer []byte, long int64) []byte {
	buffer = strconv.AppendInt(buffer, long, 10)
	buffer = append(buffer, 'l')
	return buffer
}

func ArrayInt64(array []int64) string {
	return string(AppendShowArrayInt64(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Int64"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{dataint64.ArrayInt64([]int64{int64(-31), int64(31)}), dataint64.ArrayInt64([]int64{int64(-39), int64(31)}), strconv.FormatInt(int64(-9223372036854775808), 10) + "l", strconv.FormatUint(uint64(4), 10) + "ul", strconv.FormatInt(int64(0), 10) + "l", strconv.FormatUint(uint64(9223372036854775807), 10) + "ul"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
