// Data/Maybe/maybe.go
package maybe

type Char int64

const NoChar Char = 1 << 32

// Data/Semiring/semiring.go
package semiring

func Add(i int32, i2 int32) int32 {
	return i + i2
}

// Data/String/CodePoints/codepoints.go
package codepoints

import "github.com/i-am-the-slime/iris-go/prim"

func Eq(left int32, right int32) bool {
	return left == right
}

func CodePointFromChar(x rune) int32 {
	return prim.ToCharCode(x)
}

// main.go
package main

import (
	"fixture/Data/Semiring"
	"fixture/Data/String/CodePoints"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	codeUnitLength := int32(2)
	var result string
	switch codeUnitLength {
	case 0:
		result = "empty"
	case 1:
		result = "one"
	case 2:
		result = "two"
	default:
		result = "many"
	}
	return []string{strconv.Itoa(int(countSpacesUnconsingCountsUpToTwo("a b c", 0))), result, strconv.FormatBool(int(int32(4)) < 4), strconv.Itoa(int(int32(2))), strconv.Itoa(int(unchangedTextLengthIsCountedBeforeTheLoop("banana", 0, 0))), strconv.Itoa(int(changedRestLengthIsCountedEachIteration("abcdefghij", 0)))}
}

func countSpacesUnconsingCountsUpToTwoOrCountSpacesUnconsingCountsUpToTwoJoin(step int, text string, count int32, head int32) int32 {
	for {
		switch step {
		case shared.CountSpacesUnconsingCountsUpToTwoStep:
			codeUnitLength := prim.CodeUnitLengthUpTo(2, text)
			switch codeUnitLength {
			case 0:
				return count
			case 1:
				step, head, text = shared.CountSpacesUnconsingCountsUpToTwoJoinStep, prim.ToCharCode(prim.CharAt(0, text)), ""
				continue
			default:
				fieldHead := prim.ToCharCode(prim.CharAt(0, text))
				cu1 := prim.ToCharCode(prim.CharAt(1, text))
				if 55296 <= fieldHead && fieldHead <= 56319 && (56320 <= cu1 && cu1 <= 57343) {
					step, head, text = shared.CountSpacesUnconsingCountsUpToTwoJoinStep, (fieldHead-55296)*1024+(cu1-56320)+65536, prim.CodeUnitDrop(2, text)
					continue
				}
				step, head, text = shared.CountSpacesUnconsingCountsUpToTwoJoinStep, fieldHead, prim.CodeUnitDrop(1, text)
				continue
			}
		default: // shared.CountSpacesUnconsingCountsUpToTwoJoinStep
			var result int32
			if codepoints.Eq(head, codepoints.CodePointFromChar(' ')) {
				result = semiring.Add(count, 1)
			} else {
				result = count
			}
			step, count = shared.CountSpacesUnconsingCountsUpToTwoStep, result
		}
	}
}

func countSpacesUnconsingCountsUpToTwo(text string, count int32) int32 {
	return countSpacesUnconsingCountsUpToTwoOrCountSpacesUnconsingCountsUpToTwoJoin(shared.CountSpacesUnconsingCountsUpToTwoStep, text, count, 0)
}

func unchangedTextLengthIsCountedBeforeTheLoop(text string, i int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	textASCII := textUnits.ASCII()
	for {
		if i >= textUnits.Length() {
			return count
		}
		var result2 bool
		if i >= 0 && int(i) < len(textASCII) {
			result2 = rune(textASCII[i]) == 'a'
		} else {
			left0, found := textUnits.CharAt(i)
			if found {
				result2 = left0 == 'a'
			} else {
				result2 = false
			}
		}
		var result int32
		if result2 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i+1, result
	}
}

func changedRestLengthIsCountedEachIteration(rest string, count int32) int32 {
	for {
		if prim.CodeUnitLengthUpTo(4, rest) < 3 {
			return count
		}
		rest, count = prim.CodeUnitDrop(prim.CodeUnitLength(rest)>>1, rest), count+1
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

const (
	CountSpacesUnconsingCountsUpToTwoStep = iota
	CountSpacesUnconsingCountsUpToTwoJoinStep
)
