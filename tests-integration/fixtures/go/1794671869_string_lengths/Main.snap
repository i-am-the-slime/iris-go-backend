// Data/Maybe/maybe.go
package maybe

import "fixture/shared"

const TagNothing = 0

const TagJust = 1

type HeadTail struct {
	Just shared.HeadTail
	Tag  uint8
}

var NoHeadTail = HeadTail{Tag: TagNothing}

func JustHeadTail(just shared.HeadTail) HeadTail {
	return HeadTail{Tag: TagJust, Just: just}
}

type Char int64

const NoChar Char = 1 << 32

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	codeUnitLength := prim.CodeUnitLengthUpTo(3, "ab")
	var result string
	switch codeUnitLength {
	case 0:
		result = "empty"
	case 1:
		result = "one"
	case 2:
		result = "two"
	default:
		result = "many"
	}
	scrutinee := direct.CodePointLengthUpTo(5, "word") < 4
	var result2 string
	if scrutinee {
		result2 = "true"
	} else {
		result2 = "false"
	}
	return []string{prim.ShowInt(countSpacesUnconsingCountsUpToTwo("a b c", 0)), result, result2, prim.ShowInt(direct.CodePointLength("a😀")), prim.ShowInt(unchangedTextLengthIsCountedBeforeTheLoop("banana", 0, 0)), prim.ShowInt(changedRestLengthIsCountedEachIteration("abcdefghij", 0))}
}

func countSpacesUnconsingCountsUpToTwo(text string, count int32) int32 {
	for {
		codeUnitLength := prim.CodeUnitLengthUpTo(2, text)
		var result maybe.HeadTail
		switch codeUnitLength {
		case 0:
			result = maybe.NoHeadTail
		case 1:
			result = maybe.JustHeadTail(shared.HeadTail{Head: prim.ToCharCode(prim.CharAt(0, text)), Tail: ""})
		default:
			cu0 := prim.ToCharCode(prim.CharAt(0, text))
			cu1 := prim.ToCharCode(prim.CharAt(1, text))
			if 55296 <= cu0 && cu0 <= 56319 && (56320 <= cu1 && cu1 <= 57343) {
				result = maybe.JustHeadTail(shared.HeadTail{Head: prim.MultiplyInt32(cu0 - 55296, 1024) + (cu1 - 56320) + 65536, Tail: prim.CodeUnitDrop(2, text)})
			} else {
				result = maybe.JustHeadTail(shared.HeadTail{Head: cu0, Tail: prim.CodeUnitDrop(1, text)})
			}
		}
		switch result.Tag {
		case maybe.TagJust:
			var result2 int32
			if result.Just.Head == prim.ToCharCode(rune(' ')) {
				result2 = count + 1
			} else {
				result2 = count
			}
			text, count = result.Just.Tail, result2
			continue
		default: // maybe.TagNothing
			return count
		}
	}
}

func unchangedTextLengthIsCountedBeforeTheLoop(text string, i int32, count int32) int32 {
	textUnits := prim.UTF16(text)
	for {
		if i >= textUnits.Length() {
			return count
		}
		codeUnitCharAt := textUnits.CharAt(func(payload rune) maybe.Char {
			return maybe.Char(payload)
		}, maybe.NoChar, i)
		var result2 bool
		if codeUnitCharAt != maybe.NoChar {
			result2 = rune(codeUnitCharAt) == 'a'
		} else {
			result2 = false
		}
		var result int32
		if result2 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i + 1, result
	}
}

func changedRestLengthIsCountedEachIteration(rest string, count int32) int32 {
	for {
		if prim.CodeUnitLengthUpTo(4, rest) < 3 {
			return count
		}
		rest, count = prim.CodeUnitDrop(prim.IntDiv(prim.CodeUnitLength(rest), 2), rest), count + 1
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type HeadTail struct {
	Tail string
	Head int32
}
