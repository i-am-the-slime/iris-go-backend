// Data/Maybe/maybe.go
package maybe

type Char int64

const NoChar Char = 1 << 32

// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	codeUnitLength := 2
	var result string
	switch codeUnitLength {
	case 0:
		result = "empty"
	case 1:
		result = "one"
	case 2:
		result = "two"
	default:
		result = "many"
	}
	return []string{strconv.Itoa(countSpacesUnconsingCountsUpToTwo("a b c", 0)), result, strconv.FormatBool(4 < 4), strconv.Itoa(2), strconv.Itoa(unchangedTextLengthIsCountedBeforeTheLoop("banana", 0, 0)), strconv.Itoa(changedRestLengthIsCountedEachIteration("abcdefghij", 0))}
}

func countSpacesUnconsingCountsUpToTwoOrCountSpacesUnconsingCountsUpToTwoJoin(step int, text string, count int, head int) int {
	for {
		switch step {
		case shared.CountSpacesUnconsingCountsUpToTwoStep:
			codeUnitLength := prim.CodeUnitLengthUpTo(2, text)
			switch codeUnitLength {
			case 0:
				return count
			case 1:
				step, head, text = shared.CountSpacesUnconsingCountsUpToTwoJoinStep, prim.ToCharCode(prim.CharAt(0, text)), ""
				continue
			default:
				fieldHead := prim.ToCharCode(prim.CharAt(0, text))
				cu1 := prim.ToCharCode(prim.CharAt(1, text))
				if 55296 <= fieldHead && fieldHead <= 56319 && (56320 <= cu1 && cu1 <= 57343) {
					step, head, text = shared.CountSpacesUnconsingCountsUpToTwoJoinStep, (fieldHead-55296)*1024+(cu1-56320)+65536, prim.CodeUnitDrop(2, text)
					continue
				}
				step, head, text = shared.CountSpacesUnconsingCountsUpToTwoJoinStep, fieldHead, prim.CodeUnitDrop(1, text)
				continue
			}
		default: // shared.CountSpacesUnconsingCountsUpToTwoJoinStep
			var result int
			if head == prim.ToCharCode(' ') {
				result = count + 1
			} else {
				result = count
			}
			step, count = shared.CountSpacesUnconsingCountsUpToTwoStep, result
		}
	}
}

func countSpacesUnconsingCountsUpToTwo(text string, count int) int {
	return countSpacesUnconsingCountsUpToTwoOrCountSpacesUnconsingCountsUpToTwoJoin(shared.CountSpacesUnconsingCountsUpToTwoStep, text, count, 0)
}

func unchangedTextLengthIsCountedBeforeTheLoop(text string, i int, count int) int {
	textUnits := prim.UTF16(text)
	textASCII := textUnits.ASCII()
	for {
		if i >= textUnits.Length() {
			return count
		}
		var result2 bool
		if i >= 0 && i < len(textASCII) {
			result2 = rune(textASCII[i]) == 'a'
		} else {
			left0, found := textUnits.CharAt(i)
			if found {
				result2 = left0 == 'a'
			} else {
				result2 = false
			}
		}
		var result int
		if result2 {
			result = count + 1
		} else {
			result = count
		}
		i, count = i+1, result
	}
}

func changedRestLengthIsCountedEachIteration(rest string, count int) int {
	for {
		if prim.CodeUnitLengthUpTo(4, rest) < 3 {
			return count
		}
		rest, count = prim.CodeUnitDrop(prim.CodeUnitLength(rest)>>1, rest), count+1
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

const (
	CountSpacesUnconsingCountsUpToTwoStep = iota
	CountSpacesUnconsingCountsUpToTwoJoinStep
)
