// main.go
package main

import "fixture/shared"

func main() {
	output := &shared.Ref[[]int]{Value: []int{}}
	matches := []bool{true, false, true, true, false, true}
	numbers := []int{1, 5, 2, 7, 0}
	accumulatorBefore := 0
	accumulatorMatches := 0
	accumulatorTotal := 0
	for _, same := range matches {
		if same {
			accumulatorMatches += 1
		} else {
			starts := accumulatorMatches + 1
			accumulatorBefore, accumulatorMatches = starts, 0
		}
		accumulatorTotal += accumulatorBefore
	}
	accumulator := shared.Bounds{Low: 0, High: 0}
	for _, x := range numbers {
		if x < 3 {
			updated := accumulator
			updated.Low = accumulator.Low + x
			updated.High = accumulator.High + accumulator.Low
			accumulator = updated
		} else {
			accumulator = shared.Bounds{Low: accumulator.Low - 1, High: accumulator.High + accumulator.Low*2}
		}
	}
	output.Value = []int{accumulatorTotal, accumulator.High}
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type Run struct {
	Before  int
	Matches int
	Total   int
}

type Bounds struct {
	High int
	Low  int
}
