// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

// main.go
package main

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strconv"
	"strings"
)

type Rose struct {
	Second []Rose
	First  int32
}

type MaybeRoseInt struct {
	Just Rose
	Tag  uint8
}

type MaybeArrayRoseInt struct {
	Just []Rose
	Tag  uint8
}

func JustArrayRoseInt(just []Rose) MaybeArrayRoseInt {
	return MaybeArrayRoseInt{Tag: maybe.TagJust, Just: just}
}

var NoArrayRoseInt = MaybeArrayRoseInt{Tag: maybe.TagNothing}

func JustRoseInt(just Rose) MaybeRoseInt {
	return MaybeRoseInt{Tag: maybe.TagJust, Just: just}
}

var NoRoseInt = MaybeRoseInt{Tag: maybe.TagNothing}

var main_ = initializeMain_()

func initializeMain_() []string {
	scrutinee := traverseVisit(tree)
	var result string
	switch scrutinee.Tag {
	case maybe.TagJust:
		result = "(Just " + strconv.Itoa(int(foldlAdd(0, scrutinee.Just))) + ")"
	default:
		result = "Nothing"
	}
	var performed int32 = 3
	return []string{result, foldMapVisit(mapChange(tree)), strconv.Itoa(int(performed))}
}

var tree Rose = Rose{First: 1, Second: []Rose{{First: 2, Second: []Rose{}}, {First: 3, Second: []Rose{{First: 4, Second: []Rose{}}}}}}

func traverseVisit(rose Rose) MaybeRoseInt {
	accumulator := JustArrayRoseInt([]Rose{})
	accumulator.Just = slices.Clip(accumulator.Just)
	for _, element := range rose.Second {
		if accumulator.Tag == maybe.TagNothing {
			break
		}
		switch accumulator.Tag {
		case maybe.TagJust:
			scrutinee := traverseVisit(element)
			switch scrutinee.Tag {
			case maybe.TagJust:
				accumulator = JustArrayRoseInt(array.Bounded(append(accumulator.Just, scrutinee.Just)))
			default:
				accumulator = NoArrayRoseInt
			}
		default:
			accumulator = NoArrayRoseInt
		}
	}
	switch accumulator.Tag {
	case maybe.TagJust:
		return JustRoseInt(Rose{First: rose.First, Second: accumulator.Just})
	default:
		return NoRoseInt
	}
}

func foldlAdd(initial int32, rose Rose) int32 {
	accumulator := initial + rose.First
	for _, kid := range rose.Second {
		accumulator = foldlAdd(accumulator, kid)
	}
	return accumulator
}

func mapChange(rose Rose) Rose {
	mapped := make([]Rose, len(rose.Second))
	for index, element := range rose.Second {
		mapped[index] = mapChange(element)
	}
	return Rose{First: rose.First * 10, Second: mapped}
}

func foldMapVisit(rose Rose) string {
	return string(appendFoldMapVisit(nil, rose))
}

func appendFoldMapVisit(buffer []byte, rose Rose) []byte {
	buffer = strconv.AppendInt(buffer, int64(rose.First), 10)
	buffer = append(buffer, ';')
	accumulator := ""
	for index := len(rose.Second) - 1; index >= 0; index-- {
		x := rose.Second[index]
		text := appendFoldMapVisit(nil, x)
		text = prim.AppendString(text, accumulator)
		accumulator = string(text)
	}
	buffer = prim.AppendString(buffer, accumulator)
	return buffer
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
