// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := shared.SortByKey(intervals, func(x shared.Interval) int {
		return x.Start
	})
	mapped := make([]int, len(array))
	for index := range array {
		mapped[index] = array[index].End
	}
	array2 := direct.SortBy(intervals, func(x shared.Interval, y shared.Interval) int {
		return prim.CompareString(x.Name, y.Name)
	})
	mapped2 := make([]int, len(array2))
	for index := range array2 {
		mapped2[index] = array2[index].End
	}
	array3 := direct.SortBy(intervals, func(b shared.Interval, a shared.Interval) int {
		if a.Start < b.Start {
			return -1
		}
		if a.Start > b.Start {
			return 1
		}
		return 0
	})
	mapped3 := make([]int, len(array3))
	for index := range array3 {
		mapped3[index] = array3[index].End
	}
	cells := *arraypkg.Thaw(intervals)
	copy(cells, shared.SortByKey(cells, func(x shared.Interval) int {
		return x.Start
	}))
	performed := shared.Frozen(cells)
	mapped4 := make([]int, len(performed))
	for index := range performed {
		mapped4[index] = performed[index].End
	}
	return []string{show.ArrayInt(mapped), show.ArrayInt(mapped2), show.ArrayInt(mapped3), show.ArrayInt(mapped4)}
}

var intervals = initializeIntervals()

func initializeIntervals() []shared.Interval {
	mapped := make([]shared.Interval, 12)
	for index := range 12 {
		n := 1 + index
		mapped[index] = shared.Interval{Start: prim.IntModPositive(n*7, 5), End: n, Name: strconv.Itoa(n * 3 & 3)}
	}
	return mapped
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Interval struct {
	Name  string
	End   int
	Start int
}

type SortByKeyOrdered interface {
	~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64
}

type SortByKeyEntry[K SortByKeyOrdered] struct {
	key   K
	index int
}

func SortByKey[T any, K SortByKeyOrdered](xs []T, key func(T) K) []T {
	entries := make([]SortByKeyEntry[K], len(xs))
	for index, x := range xs {
		entries[index] = SortByKeyEntry[K]{key: key(x), index: index}
	}
	if len(xs) > 1 {
		scratch := make([]SortByKeyEntry[K], len(xs))
		copy(scratch, entries)
		SortByKeyMerge(entries, scratch, 0, len(xs))
	}
	sorted := make([]T, len(xs))
	for index, entry := range entries {
		sorted[index] = xs[entry.index]
	}
	return sorted
}

func SortByKeyMerge[K SortByKeyOrdered](into []SortByKeyEntry[K], from []SortByKeyEntry[K], low int, high int) {
	middle := low + (high-low)>>1
	if middle-low > 1 {
		SortByKeyMerge(from, into, low, middle)
	}
	if high-middle > 1 {
		SortByKeyMerge(from, into, middle, high)
	}
	i, j, k := low, middle, low
	for i < middle && j < high {
		if from[j].key < from[i].key {
			into[k] = from[j]
			j++
		} else {
			into[k] = from[i]
			i++
		}
		k++
	}
	k += copy(into[k:], from[i:middle])
	copy(into[k:], from[j:high])
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
