// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	Second struct{}
	First  int32
}

func Snd(tuple Tuple) {
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
	"os"
)

func main_() int {
	array := []int{1, 2}
	array2 := []int{1}
	count := min(len(array2), len(units))
	return len(units) + len(array)*10 + count*100 + 3000
}

var units = initializeUnits()

func initializeUnits() []struct{} {
	array2 := *arraypkg.UnsafeThaw([]tuple.Tuple{{First: 0, Second: struct{}{}}})
	shared.Frozen(array2)
	shared.Frozen(array2)
	performed := shared.Frozen(array2)
	array := direct.SortBy(performed, func(x tuple.Tuple, y tuple.Tuple) int {
		i := int(x.First)
		i2 := int(y.First)
		var result ordering.Ordering
		if i < i2 {
			result = ordering.OrderingLT
		} else if i == i2 {
			result = ordering.OrderingEQ
		} else {
			result = ordering.OrderingGT
		}
		switch result {
		case ordering.OrderingLT:
			return -1
		case ordering.OrderingGT:
			return 1
		}
		return 0
	})
	mapped := make([]struct{}, len(array))
	for index, element := range array {
		tuple.Snd(element)
		mapped[index] = struct{}{}
	}
	return mapped
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
