// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	Second struct{}
	First  int32
}

func Snd(tuple Tuple) {
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/direct"
	"os"
)

func main_() int32 {
	array := []int32{1, 2}
	array2 := []int32{1}
	count := min(len(array2), len(units))
	array3 := []int32{1}
	accumulator := func(_ int32) {
	}
	for range array3 {
		accumulator = func(_ int32) {
		}
	}
	return int32(len(units)) + int32(len(array))*10 + int32(count)*100 + int32(len(arraypkg.Map(func(i int32) struct{} {
		accumulator(i)
		return struct{}{}
	}, []int32{1, 2, 3})))*1000
}

var units = initializeUnits()

func initializeUnits() []struct{} {
	array := []struct{}{{}, {}}
	mapped := make([]tuple.Tuple, len(array))
	for slot, unit := range array {
		i := int32(slot)
		mapped[slot] = tuple.Tuple{First: i, Second: unit}
	}
	indexedAndSorted := direct.SortBy(mapped, func(_ tuple.Tuple, _ tuple.Tuple) int {
		return 0
	})
	var result []struct{}
	if len(indexedAndSorted) > 0 {
		array2 := *arraypkg.UnsafeThaw([]tuple.Tuple{indexedAndSorted[0]})
		for range indexedAndSorted {
			shared.Frozen(array2)
		}
		performed := shared.Frozen(array2)
		array3 := direct.SortBy(performed, func(x tuple.Tuple, y tuple.Tuple) int {
			i := x.First
			i2 := y.First
			var result2 ordering.Ordering
			if i < i2 {
				result2 = ordering.OrderingLT
			} else if i == i2 {
				result2 = ordering.OrderingEQ
			} else {
				result2 = ordering.OrderingGT
			}
			switch result2 {
			case ordering.OrderingLT:
				return -1
			case ordering.OrderingGT:
				return 1
			}
			return 0
		})
		mapped2 := make([]struct{}, len(array3))
		for index, element := range array3 {
			tuple.Snd(element)
			mapped2[index] = struct{}{}
		}
		result = mapped2
	} else {
		result = []struct{}{}
	}
	return result
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
