// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	Second struct{}
	First  int32
}

func Snd(tuple Tuple) {
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"os"
)

func main_() int {
	array := []int{1, 2}
	array2 := []int{1}
	count := min(len(array2), len(units))
	return len(units) + len(array)*10 + count*100 + 3000
}

var units = initializeUnits()

func initializeUnits() []struct{} {
	array2 := *arraypkg.UnsafeThaw([]tuple.Tuple{{First: 0, Second: struct{}{}}})
	shared.Frozen(array2)
	shared.Frozen(array2)
	performed := shared.Frozen(array2)
	array := shared.SortByKey(performed, func(x tuple.Tuple) int {
		return int(x.First)
	})
	mapped := make([]struct{}, len(array))
	for index, element := range array {
		tuple.Snd(element)
		mapped[index] = struct{}{}
	}
	return mapped
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}

type SortByKeyOrdered interface {
	~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64
}

type SortByKeyEntry[K SortByKeyOrdered] struct {
	key   K
	index int
}

func SortByKey[T any, K SortByKeyOrdered](xs []T, key func(T) K) []T {
	entries := make([]SortByKeyEntry[K], len(xs))
	for index, x := range xs {
		entries[index] = SortByKeyEntry[K]{key: key(x), index: index}
	}
	if len(xs) > 1 {
		scratch := make([]SortByKeyEntry[K], len(xs))
		copy(scratch, entries)
		SortByKeyMerge(entries, scratch, 0, len(xs))
	}
	sorted := make([]T, len(xs))
	for index, entry := range entries {
		sorted[index] = xs[entry.index]
	}
	return sorted
}

func SortByKeyMerge[K SortByKeyOrdered](into []SortByKeyEntry[K], from []SortByKeyEntry[K], low int, high int) {
	middle := low + (high-low)>>1
	if middle-low > 1 {
		SortByKeyMerge(from, into, low, middle)
	}
	if high-middle > 1 {
		SortByKeyMerge(from, into, middle, high)
	}
	i, j, k := low, middle, low
	for i < middle && j < high {
		if from[j].key < from[i].key {
			into[k] = from[j]
			j++
		} else {
			into[k] = from[i]
			i++
		}
		k++
	}
	k += copy(into[k:], from[i:middle])
	copy(into[k:], from[j:high])
}
