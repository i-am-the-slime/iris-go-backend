// main.go
package main

import (
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/array"
	"strconv"
)

func main() {
	xs_ := array.Range(1, 3)
	bound := make([]int, 0, 2*len(xs_))
	for _, x := range xs_ {
		bound = append(bound, x, x)
	}
	var result int
	if len(bound) == 1 {
		result = bound[0]
	} else {
		result = len(bound)
	}
	journal.Log(strconv.Itoa(result))
	accumulator := 0
	for _, a_ := range xs_ {
		value := a_ * 2
		accumulator += value
	}
	accumulator2 := 0
	for _, v_ := range xs_ {
		var result2 int
		if v_ > 1 {
			result2 = 1
		} else {
			result2 = 0
		}
		accumulator2 += result2
	}
	journal.Log(strconv.Itoa(accumulator + accumulator2))
	journal.Log("3")
	journal.Log(strconv.Itoa(mainGo_(4, 0)))
}

func mainGo_(k int, total_ int) int {
	for {
		switch k {
		case 0:
			return total_
		default:
			k, total_ = k-1, total_+k
			continue
		}
	}
}
