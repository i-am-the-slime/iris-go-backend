// Data/Either/either.go
package either

type EitherInt struct {
	Field0 int32
	Tag    uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type EitherString struct {
	Left  string
	Right EitherInt
	Tag   uint8
}

const (
	EitherStringLeft = iota
	EitherStringRight
)

type IntFailure struct {
	Failed bool
	Left   int
}

type StringFailure struct {
	Failed bool
	Left   string
}

// main.go
package main

import (
	"fixture/Data/Either"
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/prim"
)

func main() {
	for _, text := range []string{"4", "2001", "-3", "x"} {
		n, found := prim.IntFromStringAs(10, text)
		if found {
			_, _, err := readSide(n)
			if err.Failed {
				journal.Log("failed: " + err.Left)
			}
		} else {
			journal.Log("failed: not a number: " + text)
		}
		x, found2 := prim.IntFromStringAs(10, text)
		if found2 {
			_, _, err := readSide(x)
			if err.Failed {
				journal.Log("failed: " + err.Left)
			}
		}
	}
}

func readSide(n int) (int, either.IntFailure, either.StringFailure) {
	for {
		if n > 1000 {
			n -= 1000
			continue
		}
		if n < 0 {
			return 0, either.IntFailure{}, either.StringFailure{Failed: true, Left: "negative"}
		}
		if n%2 == 0 {
			return 0, either.IntFailure{Failed: true, Left: n / 2}, either.StringFailure{}
		}
		return n, either.IntFailure{}, either.StringFailure{}
	}
}
