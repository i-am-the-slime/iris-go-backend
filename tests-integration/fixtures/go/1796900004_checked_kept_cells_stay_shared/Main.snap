// RedBlack/redblack.go
package redblack

type Color uint8

const (
	ColorRed Color = iota
	ColorBlack
)

type Tree struct {
	Node1 *Tree
	Node4 *Tree
	Node2 int32
	Node0 Color
	Node3 bool
}

var SharedTreeLeaf = &Tree{}

type KeptTotal struct {
	Kept  *Tree
	Total int32
}

func Checksum(value *Tree) int32 {
	return ChecksumGo(0, value)
}

func Ins(kx int32, vx bool, value *Tree) *Tree {
	if value == SharedTreeLeaf {
		return &Tree{Node0: ColorRed, Node1: SharedTreeLeaf, Node2: kx, Node3: vx, Node4: SharedTreeLeaf}
	}
	if value != SharedTreeLeaf && value.Node0 == ColorRed {
		a := value.Node1
		ky := value.Node2
		vy := value.Node3
		b := value.Node4
		if kx < ky {
			return &Tree{Node0: ColorRed, Node1: Ins(kx, vx, a), Node2: ky, Node3: vy, Node4: b}
		}
		if kx == ky {
			return &Tree{Node0: ColorRed, Node1: a, Node2: kx, Node3: vx, Node4: b}
		}
		return &Tree{Node0: ColorRed, Node1: a, Node2: ky, Node3: vy, Node4: Ins(kx, vx, b)}
	}
	a2 := value.Node1
	ky2 := value.Node2
	vy2 := value.Node3
	b2 := value.Node4
	if kx < ky2 {
		result := a2 != SharedTreeLeaf && a2.Node0 == ColorRed
		if result {
			scrutinee := Ins(kx, vx, a2)
			if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
				trees := make([]Tree, 3)
				trees[0] = Tree{Node0: ColorRed, Node1: &trees[1], Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: &trees[2]}
				trees[1] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1.Node1, Node2: scrutinee.Node1.Node2, Node3: scrutinee.Node1.Node3, Node4: scrutinee.Node1.Node4}
				trees[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4, Node2: ky2, Node3: vy2, Node4: b2}
				return &trees[0]
			}
			if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
				trees2 := make([]Tree, 3)
				trees2[0] = Tree{Node0: ColorRed, Node1: &trees2[1], Node2: scrutinee.Node4.Node2, Node3: scrutinee.Node4.Node3, Node4: &trees2[2]}
				trees2[1] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4.Node1}
				trees2[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4.Node4, Node2: ky2, Node3: vy2, Node4: b2}
				return &trees2[0]
			}
			if scrutinee != SharedTreeLeaf {
				return &Tree{Node0: ColorBlack, Node1: &Tree{Node0: ColorRed, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}, Node2: ky2, Node3: vy2, Node4: b2}
			}
			return SharedTreeLeaf
		}
		return &Tree{Node0: ColorBlack, Node1: Ins(kx, vx, a2), Node2: ky2, Node3: vy2, Node4: b2}
	}
	if kx == ky2 {
		return &Tree{Node0: ColorBlack, Node1: a2, Node2: kx, Node3: vx, Node4: b2}
	}
	result2 := b2 != SharedTreeLeaf && b2.Node0 == ColorRed
	if result2 {
		scrutinee := Ins(kx, vx, b2)
		if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
			trees3 := make([]Tree, 3)
			trees3[0] = Tree{Node0: ColorRed, Node1: &trees3[1], Node2: scrutinee.Node1.Node2, Node3: scrutinee.Node1.Node3, Node4: &trees3[2]}
			trees3[1] = Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: scrutinee.Node1.Node1}
			trees3[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node1.Node4, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}
			return &trees3[0]
		}
		if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
			trees4 := make([]Tree, 3)
			trees4[0] = Tree{Node0: ColorRed, Node1: &trees4[1], Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: &trees4[2]}
			trees4[1] = Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: scrutinee.Node1}
			trees4[2] = Tree{Node0: ColorBlack, Node1: scrutinee.Node4.Node1, Node2: scrutinee.Node4.Node2, Node3: scrutinee.Node4.Node3, Node4: scrutinee.Node4.Node4}
			return &trees4[0]
		}
		if scrutinee != SharedTreeLeaf {
			return &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: &Tree{Node0: ColorRed, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}}
		}
		return SharedTreeLeaf
	}
	return &Tree{Node0: ColorBlack, Node1: a2, Node2: ky2, Node3: vy2, Node4: Ins(kx, vx, b2)}
}

func ChecksumGo(acc int32, value *Tree) int32 {
	for {
		if value == SharedTreeLeaf {
			return acc
		}
		l := value.Node1
		k := value.Node2
		v := value.Node3
		r := value.Node4
		var result int32
		if v {
			result = k
		} else {
			result = 1
		}
		acc, value = ChecksumGo(acc, l)+result, r
	}
}

func InsReusing(kx int32, vx bool, value *Tree) *Tree {
	if value == SharedTreeLeaf {
		return &Tree{Node0: ColorRed, Node1: SharedTreeLeaf, Node2: kx, Node3: vx, Node4: SharedTreeLeaf}
	}
	if value != SharedTreeLeaf && value.Node0 == ColorRed {
		a := value.Node1
		ky := value.Node2
		vy := value.Node3
		b := value.Node4
		if kx < ky {
			field := InsReusing(kx, vx, a)
			value.Node0 = ColorRed
			value.Node1 = field
			value.Node2 = ky
			value.Node3 = vy
			value.Node4 = b
			return value
		}
		if kx == ky {
			value.Node0 = ColorRed
			value.Node1 = a
			value.Node2 = kx
			value.Node3 = vx
			value.Node4 = b
			return value
		}
		field2 := InsReusing(kx, vx, b)
		value.Node0 = ColorRed
		value.Node1 = a
		value.Node2 = ky
		value.Node3 = vy
		value.Node4 = field2
		return value
	}
	a2 := value.Node1
	ky2 := value.Node2
	vy2 := value.Node3
	b2 := value.Node4
	if kx < ky2 {
		result := a2 != SharedTreeLeaf && a2.Node0 == ColorRed
		if result {
			scrutinee := InsReusing(kx, vx, a2)
			if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
				cell := scrutinee.Node1
				l := scrutinee.Node1.Node1
				kx2 := scrutinee.Node1.Node2
				vx2 := scrutinee.Node1.Node3
				r1 := scrutinee.Node1.Node4
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				r2 := scrutinee.Node4
				value.Node0 = ColorBlack
				value.Node1 = l
				value.Node2 = kx2
				value.Node3 = vx2
				value.Node4 = r1
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = r2
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				cell.Node0 = ColorRed
				cell.Node1 = value
				cell.Node2 = ky
				cell.Node3 = vy
				cell.Node4 = scrutinee
				return cell
			}
			if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
				l1 := scrutinee.Node1
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				cell := scrutinee.Node4
				l2 := scrutinee.Node4.Node1
				kx2 := scrutinee.Node4.Node2
				vx2 := scrutinee.Node4.Node3
				r := scrutinee.Node4.Node4
				value.Node0 = ColorBlack
				value.Node1 = l1
				value.Node2 = ky
				value.Node3 = vy
				value.Node4 = l2
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = r
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				cell.Node0 = ColorRed
				cell.Node1 = value
				cell.Node2 = kx2
				cell.Node3 = vx2
				cell.Node4 = scrutinee
				return cell
			}
			if scrutinee != SharedTreeLeaf {
				l := scrutinee.Node1
				ky := scrutinee.Node2
				vy := scrutinee.Node3
				r := scrutinee.Node4
				value.Node0 = ColorRed
				value.Node1 = l
				value.Node2 = ky
				value.Node3 = vy
				value.Node4 = r
				scrutinee.Node0 = ColorBlack
				scrutinee.Node1 = value
				scrutinee.Node2 = ky2
				scrutinee.Node3 = vy2
				scrutinee.Node4 = b2
				return scrutinee
			}
			return SharedTreeLeaf
		}
		field := InsReusing(kx, vx, a2)
		value.Node0 = ColorBlack
		value.Node1 = field
		value.Node2 = ky2
		value.Node3 = vy2
		value.Node4 = b2
		return value
	}
	if kx == ky2 {
		value.Node0 = ColorBlack
		value.Node1 = a2
		value.Node2 = kx
		value.Node3 = vx
		value.Node4 = b2
		return value
	}
	result2 := b2 != SharedTreeLeaf && b2.Node0 == ColorRed
	if result2 {
		scrutinee := InsReusing(kx, vx, b2)
		if scrutinee != SharedTreeLeaf && scrutinee.Node1 != SharedTreeLeaf && scrutinee.Node1.Node0 == ColorRed {
			cell := scrutinee.Node1
			l := scrutinee.Node1.Node1
			kx1 := scrutinee.Node1.Node2
			vx1 := scrutinee.Node1.Node3
			r1 := scrutinee.Node1.Node4
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			r2 := scrutinee.Node4
			value.Node0 = ColorBlack
			value.Node1 = a2
			value.Node2 = ky2
			value.Node3 = vy2
			value.Node4 = l
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = r1
			scrutinee.Node2 = ky
			scrutinee.Node3 = vy
			scrutinee.Node4 = r2
			cell.Node0 = ColorRed
			cell.Node1 = value
			cell.Node2 = kx1
			cell.Node3 = vx1
			cell.Node4 = scrutinee
			return cell
		}
		if scrutinee != SharedTreeLeaf && scrutinee.Node4 != SharedTreeLeaf && scrutinee.Node4.Node0 == ColorRed {
			l1 := scrutinee.Node1
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			cell := scrutinee.Node4
			l2 := scrutinee.Node4.Node1
			kx2 := scrutinee.Node4.Node2
			vx2 := scrutinee.Node4.Node3
			r2 := scrutinee.Node4.Node4
			value.Node0 = ColorBlack
			value.Node1 = a2
			value.Node2 = ky2
			value.Node3 = vy2
			value.Node4 = l1
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = l2
			scrutinee.Node2 = kx2
			scrutinee.Node3 = vx2
			scrutinee.Node4 = r2
			cell.Node0 = ColorRed
			cell.Node1 = value
			cell.Node2 = ky
			cell.Node3 = vy
			cell.Node4 = scrutinee
			return cell
		}
		if scrutinee != SharedTreeLeaf {
			l := scrutinee.Node1
			ky := scrutinee.Node2
			vy := scrutinee.Node3
			r := scrutinee.Node4
			value.Node0 = ColorRed
			value.Node1 = l
			value.Node2 = ky
			value.Node3 = vy
			value.Node4 = r
			scrutinee.Node0 = ColorBlack
			scrutinee.Node1 = a2
			scrutinee.Node2 = ky2
			scrutinee.Node3 = vy2
			scrutinee.Node4 = value
			return scrutinee
		}
		return SharedTreeLeaf
	}
	field3 := InsReusing(kx, vx, b2)
	value.Node0 = ColorBlack
	value.Node1 = a2
	value.Node2 = ky2
	value.Node3 = vy2
	value.Node4 = field3
	return value
}

// main.go
package main

import (
	"fixture/Keeper_ffi"
	"fixture/RedBlack"
	"fixture/shared"
	"fixture/shared/RedBlack+Data.List.Types"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	fromStoring := mainGo(redblack.SharedTreeLeaf, redblack_types.SharedListTreeNil, 0, 40)
	effect := func() []int32 {
		var fromTheRef *redblack.Tree
		if fromStoring > 0 {
			fromTheRef = stashed.Value
		} else {
			fromTheRef = redblack.SharedTreeLeaf
		}
		record := mainGoReusing(redblack.SharedTreeLeaf, redblack_types.SharedListTreeNil, redblack.KeptTotal{Kept: redblack.SharedTreeLeaf, Total: 0}, 40)
		closure := mainGoReusing2(redblack.SharedTreeLeaf, redblack_types.SharedListTreeNil, func(_ struct{}) int32 {
			return 0
		}, 40)
		fromKeeping := mainGoReusing3(redblack.SharedTreeLeaf, redblack_types.SharedListTreeNil, 0, 40)
		var fromTheForeign *redblack.Tree
		if fromKeeping > 0 {
			fromTheForeign = Keeper_ffi.Kept[*redblack.Tree]()
		} else {
			fromTheForeign = redblack.SharedTreeLeaf
		}
		return []int32{fromStoring, redblack.Checksum(fromTheRef), record.Total, redblack.Checksum(record.Kept), closure.Total, closure.Later(struct{}{}), fromKeeping, redblack.Checksum(fromTheForeign)}
	}
	performed := effect()
	return performed
}

var stashed = initializeStashed()

func initializeStashed() *shared.Ref[*redblack.Tree] {
	performed := &shared.Ref[*redblack.Tree]{Value: redblack.SharedTreeLeaf}
	return performed
}

func mainGo(tree *redblack.Tree, trail *redblack_types.ListTree, total int32, n int32) int32 {
	for {
		if n <= 0 {
			return total + redblack.Checksum(tree)
		}
		var next *redblack.Tree
	matched:
		for {
			result := tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed
			if result {
				scrutinee := redblack.Ins(n, true, tree)
				if scrutinee != redblack.SharedTreeLeaf {
					next = &redblack.Tree{Node0: redblack.ColorBlack, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}
				} else {
					next = redblack.SharedTreeLeaf
				}
				break matched
			}
			next = redblack.Ins(n, true, tree)
			break matched
		}
		var result2 *redblack_types.ListTree
		if n%4 == 0 {
			result2 = &redblack_types.ListTree{Cons0: next, Cons1: trail}
		} else {
			result2 = trail
		}
		var result3 int32
		if n == 7 {
			effect := func() int32 {
				stashed.Value = next
				return redblack.Checksum(next)
			}
			performed := effect()
			result3 = total + performed
		} else {
			result3 = total
		}
		tree, trail, total, n = next, result2, result3, n-1
	}
}

func mainGo2(tree *redblack.Tree, trail *redblack_types.ListTree, record redblack.KeptTotal, n int32) redblack.KeptTotal {
	for {
		if n <= 0 {
			updated := record
			updated.Total = record.Total + redblack.Checksum(tree)
			return updated
		}
		var next *redblack.Tree
	matched:
		for {
			result := tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed
			if result {
				scrutinee := redblack.Ins(n, true, tree)
				if scrutinee != redblack.SharedTreeLeaf {
					next = &redblack.Tree{Node0: redblack.ColorBlack, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}
				} else {
					next = redblack.SharedTreeLeaf
				}
				break matched
			}
			next = redblack.Ins(n, true, tree)
			break matched
		}
		var result2 *redblack_types.ListTree
		if n%4 == 0 {
			result2 = &redblack_types.ListTree{Cons0: next, Cons1: trail}
		} else {
			result2 = trail
		}
		var result3 redblack.KeptTotal
		if n == 7 {
			updated := record
			updated.Kept = next
			result3 = updated
		} else {
			result3 = record
		}
		tree, trail, record, n = next, result2, result3, n-1
	}
}

func mainGo3(tree *redblack.Tree, trail *redblack_types.ListTree, later func(struct{}) int32, n int32) shared.Closure {
	for {
		if n <= 0 {
			return shared.Closure{Later: later, Total: redblack.Checksum(tree)}
		}
		var next *redblack.Tree
	matched:
		for {
			result := tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed
			if result {
				scrutinee := redblack.Ins(n, true, tree)
				if scrutinee != redblack.SharedTreeLeaf {
					next = &redblack.Tree{Node0: redblack.ColorBlack, Node1: scrutinee.Node1, Node2: scrutinee.Node2, Node3: scrutinee.Node3, Node4: scrutinee.Node4}
				} else {
					next = redblack.SharedTreeLeaf
				}
				break matched
			}
			next = redblack.Ins(n, true, tree)
			break matched
		}
		var result2 *redblack_types.ListTree
		if n%4 == 0 {
			result2 = &redblack_types.ListTree{Cons0: next, Cons1: trail}
		} else {
			result2 = trail
		}
		var result3 func(struct{}) int32
		if n == 7 {
			result3 = func(_ struct{}) int32 {
				return redblack.Checksum(next)
			}
		} else {
			result3 = later
		}
		tree, trail, later, n = next, result2, result3, n-1
	}
}

