	var result3 func(struct{}) int32
	if n == 7 {
		result3 = func(_ struct{}) int32 {
			return redblack.Checksum(next)
		}
	} else {
		result3 = later
	}
	return mainGo3(next, result2, result3, n-1)
}

func mainGoReusing3(tree *redblack.Tree, trail *redblack_types.ListTree, total int32, n int32) int32 {
	if n <= 0 {
		return total + redblack.Checksum(tree)
	}
	var next *redblack.Tree
matched:
	for {
		result := tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed
		if result {
			scrutinee := redblack.InsReusing(n, true, tree)
			if scrutinee != redblack.SharedTreeLeaf {
				l := scrutinee.Node1
				k := scrutinee.Node2
				v := scrutinee.Node3
				r := scrutinee.Node4
				scrutinee.Node0 = redblack.ColorBlack
				scrutinee.Node1 = l
				scrutinee.Node2 = k
				scrutinee.Node3 = v
				scrutinee.Node4 = r
				next = scrutinee
			} else {
				next = redblack.SharedTreeLeaf
			}
			break matched
		}
		next = redblack.InsReusing(n, true, tree)
		break matched
	}
	var result2 *redblack_types.ListTree
	if n%4 == 0 {
		result2 = &redblack_types.ListTree{Cons0: next, Cons1: trail}
	} else {
		result2 = trail
	}
	var result3 int32
	if n == 7 {
		result3 = total + Keeper_ffi.Keep(next)
	} else {
		result3 = total
	}
	return mainGo4(next, result2, result3, n-1)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

