		result2 = trail
	}
	var result3 func(struct{}) int32
	if n == 7 {
		result3 = func(_ struct{}) int32 {
			return redblack.Checksum(next)
		}
	} else {
		result3 = later
	}
	return mainGoChecked2(next, result2, result3, n-1, !(n%4 == 0) && !(n == 7))
}

func mainGoReusing3(tree *redblack.Tree, trail *redblack_types.ListTree, total int32, n int32) int32 {
	if n <= 0 {
		return total + redblack.Checksum(tree)
	}
	var next *redblack.Tree
matched:
	for {
		result := tree != redblack.SharedTreeLeaf && tree.Node0 == redblack.ColorRed
		if result {
			scrutinee := redblack.InsReusing(n, true, tree)
			if scrutinee != redblack.SharedTreeLeaf {
				scrutinee.Node0 = redblack.ColorBlack
				scrutinee.Unique = 3
				next = scrutinee
			} else {
				next = redblack.SharedTreeLeaf
			}
