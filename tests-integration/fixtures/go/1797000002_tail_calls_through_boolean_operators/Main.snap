// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []bool {
	return []bool{allPositiveFrom(0, array.Range(1, 1000000)), allPositiveFrom(0, []int{1, 2, -3}), anyNegativeFrom(0, array.Range(1, 1000000)), anyNegativeFrom(0, []int{1, 2, -3}), mainGo(1), mainGo2(1), isEven(1000000), isOdd(7)}
}

func allPositiveFrom(i int, xs []int) bool {
	for {
		if i >= len(xs) {
			return true
		}
		if xs[i] > 0 {
			i += 1
			continue
		}
		return false
	}
}

func anyNegativeFrom(i int, xs []int) bool {
	for {
		if i < len(xs) {
			if xs[i] < 0 {
				return true
			}
			i += 1
			continue
		}
		return false
	}
}

func isEvenOrIsOdd(step int, n int) bool {
	for {
		switch step {
		case shared.IsEvenStep:
			if n == 0 {
				return true
			}
			if n > 0 {
				step, n = shared.IsOddStep, n-1
				continue
			}
			return false
		default: // shared.IsOddStep
			if n != 0 {
				if n > 0 {
					step, n = shared.IsEvenStep, n-1
					continue
				}
				return false
			}
			return false
		}
	}
}

func isEven(n int) bool {
	return isEvenOrIsOdd(shared.IsEvenStep, n)
}

func isOdd(n int) bool {
	return isEvenOrIsOdd(shared.IsOddStep, n)
}

func mainGo(i int) bool {
	for {
		if i >= 1000000 {
			return true
		}
		if 1+(i-1) <= 1+i {
			i += 1
			continue
		}
		return false
	}
}

func mainGo2(i int) bool {
	for {
		if i >= 3 {
			return true
		}
		if []int{1, 3, 2}[i-1] <= []int{1, 3, 2}[i] {
			i += 1
			continue
		}
		return false
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, strconv.FormatBool(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

const (
	IsEvenStep = iota
	IsOddStep
)
