// Data/Foldable/foldable.go
package foldable

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/direct"
)

func Foldr(f func(string) func(*direct.ConsList[string]) *direct.ConsList[string], z *direct.ConsList[string], maybe2 maybe.String) *direct.ConsList[string] {
	switch maybe2.Tag {
	case maybe.TagNothing:
		return z
	default: // maybe.TagJust
		return f(maybe2.Just)(z)
	}
}

// Data/List/Types/types.go
package types

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
}

var SharedListIntNil = &ListInt{}

type ListString struct {
	Cons0 string
	Cons1 *ListString
}

func ConsListInt(cons0 int32, cons1 *ListInt) *ListInt {
	return &ListInt{Cons0: cons0, Cons1: cons1}
}

func ConsListString(cons0 string, cons1 *ListString) *ListString {
	return &ListString{Cons0: cons0, Cons1: cons1}
}

// Data/Map/Internal/internal.go
package internal

type MapStringUnit struct {
	Node3 struct{}
	Node2 string
	Node4 *MapStringUnit
	Node5 *MapStringUnit
	Node0 int32
	Node1 int32
}

var SharedMapStringUnitLeaf = &MapStringUnit{}

func Node(node0 int32, node1 int32, node2 string, node3 struct{}, node4 *MapStringUnit, node5 *MapStringUnit) *MapStringUnit {
	return &MapStringUnit{Node0: node0, Node1: node1, Node2: node2, Node3: node3, Node4: node4, Node5: node5}
}

func UnsafeNodeStringUnit(k string, v struct{}, l *MapStringUnit, r *MapStringUnit) *MapStringUnit {
	if l == SharedMapStringUnitLeaf {
		if r == SharedMapStringUnitLeaf {
			return Node(1, 1, k, v, l, r)
		}
		return Node(1+r.Node0, 1+r.Node1, k, v, l, r)
	}
	h1 := l.Node0
	s1 := l.Node1
	if r == SharedMapStringUnitLeaf {
		return Node(1+h1, 1+s1, k, v, l, r)
	}
	h2 := r.Node0
	result := max(h1, h2)
	return Node(1+result, 1+s1+r.Node1, k, v, l, r)
}

func UnsafeBalancedNodeStringUnitReusing(k string, v struct{}, l *MapStringUnit, r *MapStringUnit, donor *MapStringUnit) *MapStringUnit {
	if l == SharedMapStringUnitLeaf {
		if r == SharedMapStringUnitLeaf {
			donor.Node0 = 1
			donor.Node1 = 1
			donor.Node2 = k
			donor.Node3 = v
			donor.Node4 = SharedMapStringUnitLeaf
			donor.Node5 = SharedMapStringUnitLeaf
			return donor
		}
		if r != SharedMapStringUnitLeaf {
			rh := r.Node0
			rk := r.Node2
			rl := r.Node4
			rr := r.Node5
			if rh > 1 {
				return UnsafeBalancedNodeStringUnitRotateLeftReusing(k, v, l, rk, struct{}{}, rl, rr, donor)
			}
		}
		return UnsafeNodeStringUnitReusing(k, v, l, r, donor)
	}
	lh := l.Node0
	lk := l.Node2
	ll := l.Node4
	lr := l.Node5
	if r != SharedMapStringUnitLeaf {
		rh := r.Node0
		rk := r.Node2
		rl := r.Node4
		rr := r.Node5
		if rh > lh+1 {
			return UnsafeBalancedNodeStringUnitRotateLeftReusing(k, v, l, rk, struct{}{}, rl, rr, donor)
		}
		if lh > rh+1 {
			return UnsafeBalancedNodeStringUnitRotateRightReusing(k, v, lk, struct{}{}, ll, lr, r, donor)
		}
	}
	if r == SharedMapStringUnitLeaf {
		if lh > 1 {
			return UnsafeBalancedNodeStringUnitRotateRightReusing(k, v, lk, struct{}{}, ll, lr, r, donor)
		}
	}
	return UnsafeNodeStringUnitReusing(k, v, l, r, donor)
}

func UnsafeNodeStringUnitReusing(k string, v struct{}, l *MapStringUnit, r *MapStringUnit, donor *MapStringUnit) *MapStringUnit {
	if l == SharedMapStringUnitLeaf {
		if r == SharedMapStringUnitLeaf {
			donor.Node0 = 1
			donor.Node1 = 1
			donor.Node2 = k
			donor.Node3 = v
			donor.Node4 = l
			donor.Node5 = r
			return donor
		}
		h2 := r.Node0
		s2 := r.Node1
		donor.Node0 = 1 + h2
		donor.Node1 = 1 + s2
		donor.Node2 = k
		donor.Node3 = v
		donor.Node4 = l
		donor.Node5 = r
		return donor
	}
	h1 := l.Node0
	s1 := l.Node1
	if r == SharedMapStringUnitLeaf {
		donor.Node0 = 1 + h1
		donor.Node1 = 1 + s1
		donor.Node2 = k
		donor.Node3 = v
		donor.Node4 = l
		donor.Node5 = r
		return donor
	}
	h22 := r.Node0
	s22 := r.Node1
	result := max(h1, h22)
	donor.Node0 = 1 + result
	donor.Node1 = 1 + s1 + s22
	donor.Node2 = k
	donor.Node3 = v
	donor.Node4 = l
	donor.Node5 = r
	return donor
}

func UnsafeBalancedNodeStringUnitRotateLeftReusing(k string, v struct{}, l *MapStringUnit, rk string, rv struct{}, rl *MapStringUnit, rr *MapStringUnit, donor *MapStringUnit) *MapStringUnit {
	if rl != SharedMapStringUnitLeaf {
		lh := rl.Node0
		lk := rl.Node2
		ll := rl.Node4
		lr := rl.Node5
		var result int32
		if rr == SharedMapStringUnitLeaf {
			result = 0
		} else {
			result = rr.Node0
		}
		if lh > result {
			return UnsafeNodeStringUnitReusing(lk, struct{}{}, UnsafeNodeStringUnit(k, v, l, ll), UnsafeNodeStringUnit(rk, rv, lr, rr), donor)
		}
	}
	return UnsafeNodeStringUnitReusing(rk, rv, UnsafeNodeStringUnit(k, v, l, rl), rr, donor)
}

func UnsafeBalancedNodeStringUnitRotateRightReusing(k string, v struct{}, lk string, lv struct{}, ll *MapStringUnit, lr *MapStringUnit, r *MapStringUnit, donor *MapStringUnit) *MapStringUnit {
	if lr != SharedMapStringUnitLeaf {
		rh := lr.Node0
		rk := lr.Node2
		rl := lr.Node4
		rr := lr.Node5
		var result int32
		if ll == SharedMapStringUnitLeaf {
			result = 0
		} else {
			result = ll.Node0
		}
		if result <= rh {
			return UnsafeNodeStringUnitReusing(rk, struct{}{}, UnsafeNodeStringUnit(lk, lv, ll, rl), UnsafeNodeStringUnit(k, v, rr, r), donor)
		}
	}
	return UnsafeNodeStringUnitReusing(lk, lv, ll, UnsafeNodeStringUnit(k, v, lr, r), donor)
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type String struct {
	Just string
	Tag  uint8
}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

// Data/Set/set.go
package set

import (
	list "fixture/Data/List/Types"
	m "fixture/Data/Map/Internal"
	"github.com/i-am-the-slime/iris-go/direct"
)

var SharedListStringNil = &list.ListString{}

func Foldr(f func(string) func(*direct.ConsList[string]) *direct.ConsList[string], x *direct.ConsList[string]) func(*m.MapStringUnit) *direct.ConsList[string] {
	return func(x2 *m.MapStringUnit) *direct.ConsList[string] {
		return FoldrGo(f, x, FoldrGoReusing(SharedListStringNil, FoldrGo2(x2, SharedListStringNil)))
	}
}

func FoldrGo(f func(string) func(*direct.ConsList[string]) *direct.ConsList[string], b *direct.ConsList[string], value *list.ListString) *direct.ConsList[string] {
	for {
		if value == SharedListStringNil {
			return b
		}
		a := value.Cons0
		as := value.Cons1
		b, value = f(a)(b), as
	}
}

func FoldrGo2(m_ *m.MapStringUnit, z_ *list.ListString) *list.ListString {
	for {
		if m_ == m.SharedMapStringUnitLeaf {
			return z_
		}
		k := m_.Node2
		l := m_.Node4
		r := m_.Node5
		m_, z_ = l, list.ConsListString(k, FoldrGo2(r, z_))
	}
}

func FoldrGoReusing(acc *list.ListString, list *list.ListString) *list.ListString {
	for {
		if list == SharedListStringNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// main.go
package main

import (
	"fixture/Data/Foldable"
	"fixture/Data/List/Types"
	"fixture/Data/Map/Internal"
	"fixture/Data/Maybe"
	"fixture/Data/Set"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
)

var main_ = initializeMain_()

func initializeMain_() int32 {
	cell := numbers
	elements := []int32{}
	for {
		if cell == types.SharedListIntNil {
			break
		}
		elements = append(elements, cell.Cons0)
		cell = cell.Cons1
	}
	return int32(len(arraypkg.Bounded(elements))) + int32(len(direct.FromFoldable(func(f func(string) func(*direct.ConsList[string]) *direct.ConsList[string]) func(*direct.ConsList[string]) func(maybe.String) *direct.ConsList[string] {
		return func(z *direct.ConsList[string]) func(maybe.String) *direct.ConsList[string] {
			return func(maybe maybe.String) *direct.ConsList[string] {
				return foldable.Foldr(f, z, maybe)
			}
		}
	}, maybe.JustString("x")))) + int32(len(direct.FromFoldable(func(f func(string) func(*direct.ConsList[string]) *direct.ConsList[string]) func(*direct.ConsList[string]) func(*internal.MapStringUnit) *direct.ConsList[string] {
		return func(x *direct.ConsList[string]) func(*internal.MapStringUnit) *direct.ConsList[string] {
			return set.Foldr(f, x)
		}
	}, words)))
}

var numbers *types.ListInt = types.ConsListInt(1, types.ConsListInt(2, types.ConsListInt(3, types.SharedListIntNil)))

var words = initializeWords()

func initializeWords() *internal.MapStringUnit {
	array := []string{"b", "a"}
	accumulator := internal.SharedMapStringUnitLeaf
	for _, a := range array {
		accumulator = wordsGoReusing(a, accumulator)
	}
	return accumulator
}

func wordsGoReusing(a string, value *internal.MapStringUnit) *internal.MapStringUnit {
	if value == internal.SharedMapStringUnitLeaf {
		return internal.Node(1, 1, a, struct{}{}, internal.SharedMapStringUnitLeaf, internal.SharedMapStringUnitLeaf)
	}
	mk := value.Node2
	ml := value.Node4
	mr := value.Node5
	if prim.CompareString(a, mk) < 0 {
		return internal.UnsafeBalancedNodeStringUnitReusing(mk, struct{}{}, wordsGoReusing(a, ml), mr, value)
	}
	if a == mk {
		value.Node2 = a
		return value
	}
	return internal.UnsafeBalancedNodeStringUnitReusing(mk, struct{}{}, ml, wordsGoReusing(a, mr), value)
}

func main() {
	console.Print(prim.ShowInt(main_))
}
