// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"strconv"
)

func main_() []string {
	flipped := maybe.JustInt(20)
	var result string
	switch flipped.Tag {
	case maybe.TagJust:
		result = "(Just " + strconv.Itoa(flipped.Just) + ")"
	default: // maybe.TagNothing
		result = "Nothing"
	}
	return []string{"(Just 1)", "Nothing", result, "(Just (Just 1))"}
}

func main() {
	main_()
}
