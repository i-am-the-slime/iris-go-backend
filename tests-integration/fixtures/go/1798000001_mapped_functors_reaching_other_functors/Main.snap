// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type StepInt struct {
	Emit0 []int
	Emit1 func(struct{}) StepInt
	Tag   uint8
}

const (
	StepIntDone = iota
	StepIntEmit
)

type StepNumber struct {
	Emit0 []float64
	Emit1 func(struct{}) StepNumber
	Tag   uint8
}

const (
	StepNumberDone = iota
	StepNumberEmit
)

type StepString struct {
	Emit0 []string
	Emit1 func(struct{}) StepString
	Tag   uint8
}

const (
	StepStringDone = iota
	StepStringEmit
)

func EmitStepInt(emit0 []int, emit1 func(struct{}) StepInt) StepInt {
	return StepInt{Tag: StepIntEmit, Emit0: emit0, Emit1: emit1}
}

func EmitStepNumber(emit0 []float64, emit1 func(struct{}) StepNumber) StepNumber {
	return StepNumber{Tag: StepNumberEmit, Emit0: emit0, Emit1: emit1}
}

func EmitStepString(emit0 []string, emit1 func(struct{}) StepString) StepString {
	return StepString{Tag: StepStringEmit, Emit0: emit0, Emit1: emit1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{prim.ShowNumber(foldAdd(0.0, func(ignored2 struct{}) StepNumber {
		return mapChunksChangeFNumber(func(ignored3 struct{}) StepNumber {
			return mapChunksChangeFInt(func(ignored struct{}) StepInt {
				return range_(0, 10, ignored)
			}, ignored3)
		}, ignored2)
	})), foldStep("", func(ignored struct{}) StepString {
		return mapChunksChangeFString(func(ignored2 struct{}) StepString {
			return mapChunksChangeShow(func(ignored3 struct{}) StepInt {
				return range_(0, 4, ignored3)
			}, ignored2)
		}, ignored)
	})}
}

func range_(from int, to int, ignored struct{}) StepInt {
	if from >= to {
		return StepInt{Tag: StepIntDone}
	}
	from2 := from + 2
	return EmitStepInt([]int{from, from + 1}, func(ignored2 struct{}) StepInt {
		return range_(from2, to, ignored2)
	})
}

func mapChunksChangeFInt(pull func(struct{}) StepInt, ignored struct{}) StepNumber {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepIntDone:
		return StepNumber{Tag: StepNumberDone}
	default: // StepIntEmit
		mapped := make([]float64, len(scrutinee.Emit0))
		for index, i := range scrutinee.Emit0 {
			mapped[index] = float64(i)
		}
		return EmitStepNumber(mapped, func(ignored2 struct{}) StepNumber {
			return mapChunksChangeFInt(scrutinee.Emit1, ignored2)
		})
	}
}

func mapChunksChangeFNumber(pull func(struct{}) StepNumber, ignored struct{}) StepNumber {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepNumberDone:
		return StepNumber{Tag: StepNumberDone}
	default: // StepNumberEmit
		return EmitStepNumber(mapLanes(scrutinee.Emit0), func(ignored2 struct{}) StepNumber {
			return mapChunksChangeFNumber(scrutinee.Emit1, ignored2)
		})
	}
}

func foldAdd(initial float64, run func(struct{}) StepNumber) float64 {
	for {
		scrutinee := run(struct{}{})
		switch scrutinee.Tag {
		case StepNumberDone:
			return initial
		default: // StepNumberEmit
			initial, run = foldLanes(scrutinee.Emit0, initial), scrutinee.Emit1
			continue
		}
	}
}

func mapChunksChangeShow(pull func(struct{}) StepInt, ignored struct{}) StepString {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepIntDone:
		return StepString{Tag: StepStringDone}
	default: // StepIntEmit
		mapped := make([]string, len(scrutinee.Emit0))
		for index, value := range scrutinee.Emit0 {
			mapped[index] = strconv.Itoa(value)
		}
		return EmitStepString(mapped, func(ignored2 struct{}) StepString {
			return mapChunksChangeShow(scrutinee.Emit1, ignored2)
		})
	}
}

func mapChunksChangeFString(pull func(struct{}) StepString, ignored struct{}) StepString {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepStringDone:
		return StepString{Tag: StepStringDone}
	default: // StepStringEmit
		mapped := make([]string, len(scrutinee.Emit0))
		for index, value := range scrutinee.Emit0 {
			mapped[index] = "tick " + value
		}
		return EmitStepString(mapped, func(ignored2 struct{}) StepString {
			return mapChunksChangeFString(scrutinee.Emit1, ignored2)
		})
	}
}

func foldStep(initial string, run func(struct{}) StepString) string {
	for {
		scrutinee := run(struct{}{})
		switch scrutinee.Tag {
		case StepStringDone:
			return initial
		default: // StepStringEmit
			accumulator := []byte(initial)
			for _, tick := range scrutinee.Emit0 {
				accumulator = prim.AppendString(accumulator, tick)
				accumulator = append(accumulator, ';')
			}
			built := string(accumulator)
			initial, run = built, scrutinee.Emit1
			continue
		}
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"math"
	"simd/archsimd"
)

func foldLanes(xs []float64, initial float64) float64 {
	acc0 := archsimd.BroadcastFloat64x2(math.Copysign(0, -1))
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadFloat64x2(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadFloat64x2(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadFloat64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadFloat64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [2]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

func mapLanes(xs []float64) []float64 {
	c0 := archsimd.BroadcastFloat64x2(1.5)
	out := make([]float64, len(xs))
	const step = 2
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadFloat64x2(xs[i : i+step])
		x.Mul(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadFloat64x2Part(xs[i:])
		x.Mul(c0).StorePart(out[i:])
	}
	return out
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []float64, initial float64) float64 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

func mapLanes(xs []float64) []float64 {
	out := make([]float64, len(xs))
	for i, x := range xs {
		out[i] = x * 1.5
	}
	return out
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"math"
	"simd"
)

func foldLanes(xs []float64, initial float64) float64 {
	acc0 := simd.BroadcastFloat64s(math.Copysign(0, -1))
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadFloat64s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadFloat64s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadFloat64s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadFloat64s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [8]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

func mapLanes(xs []float64) []float64 {
	c0 := simd.BroadcastFloat64s(1.5)
	out := make([]float64, len(xs))
	step := simd.Float64s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadFloat64s(xs[i : i+step])
		x.Mul(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadFloat64sPart(xs[i:])
		x.Mul(c0).StorePart(out[i:])
	}
	return out
}
