// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type StepInt struct {
	Emit0 []int32
	Emit1 func(struct{}) StepInt
	Tag   uint8
}

const (
	StepIntDone = iota
	StepIntEmit
)

type StepNumber struct {
	Emit0 []float64
	Emit1 func(struct{}) StepNumber
	Tag   uint8
}

const (
	StepNumberDone = iota
	StepNumberEmit
)

type StepString struct {
	Emit0 []string
	Emit1 func(struct{}) StepString
	Tag   uint8
}

const (
	StepStringDone = iota
	StepStringEmit
)

func EmitStepInt(emit0 []int32, emit1 func(struct{}) StepInt) StepInt {
	return StepInt{Tag: StepIntEmit, Emit0: emit0, Emit1: emit1}
}

func EmitStepNumber(emit0 []float64, emit1 func(struct{}) StepNumber) StepNumber {
	return StepNumber{Tag: StepNumberEmit, Emit0: emit0, Emit1: emit1}
}

func EmitStepString(emit0 []string, emit1 func(struct{}) StepString) StepString {
	return StepString{Tag: StepStringEmit, Emit0: emit0, Emit1: emit1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{prim.ShowNumber(foldNumberNumberAdd(0.0, func(ignored2 struct{}) StepNumber {
		return mapChunksNumberNumberChange(func(value float64) float64 {
			return value * 1.5
		}, func(ignored3 struct{}) StepNumber {
			return mapChunksIntNumberChange(func(i int32) float64 {
				return float64(i)
			}, func(ignored struct{}) StepInt {
				return range_(0, 10, ignored)
			}, ignored3)
		}, ignored2)
	})), foldStringString(func(text string, tick string) string {
		return prim.Concat(text, tick, ";")
	}, "", func(ignored struct{}) StepString {
		return mapChunksStringStringChange(func(value string) string {
			return "tick " + value
		}, func(ignored2 struct{}) StepString {
			return mapChunksIntStringChangeShow(func(ignored3 struct{}) StepInt {
				return range_(0, 4, ignored3)
			}, ignored2)
		}, ignored)
	})}
}

func range_(from int32, to int32, ignored struct{}) StepInt {
	if from >= to {
		return StepInt{Tag: StepIntDone}
	}
	from2 := from + 2
	return EmitStepInt([]int32{from, from + 1}, func(ignored2 struct{}) StepInt {
		return range_(from2, to, ignored2)
	})
}

func foldStringString(step func(string, string) string, initial string, run func(struct{}) StepString) string {
	for {
		scrutinee := run(struct{}{})
		switch scrutinee.Tag {
		case StepStringDone:
			return initial
		default: // StepStringEmit
			initial, run = array.Foldl(step, initial, scrutinee.Emit0), scrutinee.Emit1
			continue
		}
	}
}

func mapChunksNumberNumberChange(f func(float64) float64, pull func(struct{}) StepNumber, ignored struct{}) StepNumber {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepNumberDone:
		return StepNumber{Tag: StepNumberDone}
	default: // StepNumberEmit
		return EmitStepNumber(array.Map(f, scrutinee.Emit0), func(ignored2 struct{}) StepNumber {
			return mapChunksNumberNumberChange(f, scrutinee.Emit1, ignored2)
		})
	}
}

func mapChunksIntNumberChange(f func(int32) float64, pull func(struct{}) StepInt, ignored struct{}) StepNumber {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepIntDone:
		return StepNumber{Tag: StepNumberDone}
	default: // StepIntEmit
		return EmitStepNumber(array.Map(f, scrutinee.Emit0), func(ignored2 struct{}) StepNumber {
			return mapChunksIntNumberChange(f, scrutinee.Emit1, ignored2)
		})
	}
}

func mapChunksStringStringChange(f func(string) string, pull func(struct{}) StepString, ignored struct{}) StepString {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepStringDone:
		return StepString{Tag: StepStringDone}
	default: // StepStringEmit
		return EmitStepString(array.Map(f, scrutinee.Emit0), func(ignored2 struct{}) StepString {
			return mapChunksStringStringChange(f, scrutinee.Emit1, ignored2)
		})
	}
}

func foldNumberNumberAdd(initial float64, run func(struct{}) StepNumber) float64 {
	for {
		scrutinee := run(struct{}{})
		switch scrutinee.Tag {
		case StepNumberDone:
			return initial
		default: // StepNumberEmit
			initial, run = foldLanes(scrutinee.Emit0, initial), scrutinee.Emit1
			continue
		}
	}
}

func mapChunksIntStringChangeShow(pull func(struct{}) StepInt, ignored struct{}) StepString {
	scrutinee := pull(struct{}{})
	switch scrutinee.Tag {
	case StepIntDone:
		return StepString{Tag: StepStringDone}
	default: // StepIntEmit
		mapped := make([]string, len(scrutinee.Emit0))
		for index, value := range scrutinee.Emit0 {
			mapped[index] = strconv.Itoa(int(value))
		}
		return EmitStepString(mapped, func(ignored2 struct{}) StepString {
			return mapChunksIntStringChangeShow(scrutinee.Emit1, ignored2)
		})
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"math"
	"simd/archsimd"
)

func foldLanes(xs []float64, initial float64) float64 {
	acc0 := archsimd.BroadcastFloat64x2(math.Copysign(0, -1))
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadFloat64x2(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadFloat64x2(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadFloat64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadFloat64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [2]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []float64, initial float64) float64 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"math"
	"simd"
)

func foldLanes(xs []float64, initial float64) float64 {
	acc0 := simd.BroadcastFloat64s(math.Copysign(0, -1))
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadFloat64s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadFloat64s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadFloat64s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadFloat64s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [8]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
