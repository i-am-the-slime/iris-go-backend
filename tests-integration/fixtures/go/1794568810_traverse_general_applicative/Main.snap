// Data/Either/either.go
package either

type Either struct {
	Left  string
	Right []int32
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Right(right []int32) Either {
	return Either{Tag: EitherRight, Right: right}
}

func Left(left string) Either {
	return Either{Tag: EitherLeft, Left: left}
}

// Data/Traversable/traversable.go
package traversable

import (
	"fixture/Data/Either"
	"github.com/i-am-the-slime/iris-go/array"
	"slices"
	"strconv"
)

func TraversePositive(array2 []int32) either.Either {
	accumulator := either.Right([]int32{})
	accumulator.Right = slices.Clip(accumulator.Right)
	for _, element := range array2 {
		if accumulator.Tag == either.EitherLeft {
			break
		}
		switch accumulator.Tag {
		case either.EitherLeft:
			accumulator = either.Left(accumulator.Left)
		default: // either.EitherRight
			if element > 0 {
				accumulator = either.Right(array.Bounded(append(accumulator.Right, element)))
			} else {
				accumulator = either.Left("not positive: " + strconv.Itoa(int(element)))
			}
		}
	}
	return accumulator
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Traversable"
)

var main_ = initializeMain_()

func initializeMain_() []either.Either {
	return []either.Either{traversable.TraversePositive([]int32{1, 2, 3}), traversable.TraversePositive([]int32{1, -2, 3})}
}

func main() {
	_ = main_
}

// note: the entry's value of type Array Data.Either.Either is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
