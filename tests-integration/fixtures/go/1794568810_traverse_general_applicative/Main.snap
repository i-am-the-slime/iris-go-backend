// Data/Either/either.go
package either

type EitherStringArrayInt struct {
	Left  string
	Right []int32
	Tag   uint8
}

const (
	EitherStringArrayIntLeft = iota
	EitherStringArrayIntRight
)

func Right(right []int32) EitherStringArrayInt {
	return EitherStringArrayInt{Tag: EitherStringArrayIntRight, Right: right}
}

func Left(left string) EitherStringArrayInt {
	return EitherStringArrayInt{Tag: EitherStringArrayIntLeft, Left: left}
}

// main.go
package main

import (
	"fixture/Data/Either"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"slices"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() []either.EitherStringArrayInt {
	array := []int32{1, 2, 3}
	accumulator := either.Right([]int32{})
	accumulator.Right = slices.Clip(accumulator.Right)
	for _, element := range array {
		if accumulator.Tag == either.EitherStringArrayIntLeft {
			break
		}
		switch accumulator.Tag {
		case either.EitherStringArrayIntLeft:
			accumulator = either.Left(accumulator.Left)
		default: // either.EitherStringArrayIntRight
			if element > 0 {
				accumulator = either.Right(arraypkg.Bounded(append(accumulator.Right, element)))
			} else {
				accumulator = either.Left("not positive: " + strconv.Itoa(int(element)))
			}
		}
	}
	array2 := []int32{1, -2, 3}
	accumulator2 := either.Right([]int32{})
	accumulator2.Right = slices.Clip(accumulator2.Right)
	for _, element := range array2 {
		if accumulator2.Tag == either.EitherStringArrayIntLeft {
			break
		}
		switch accumulator2.Tag {
		case either.EitherStringArrayIntLeft:
			accumulator2 = either.Left(accumulator2.Left)
		default: // either.EitherStringArrayIntRight
			if element > 0 {
				accumulator2 = either.Right(arraypkg.Bounded(append(accumulator2.Right, element)))
			} else {
				accumulator2 = either.Left("not positive: " + strconv.Itoa(int(element)))
			}
		}
	}
	return []either.EitherStringArrayInt{accumulator, accumulator2}
}

func main() {
	_ = main_
}

// note: the entry's value of type Array Data.Either.Either is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
