// Data/Either/either.go
package either

type EitherStringArrayInt struct {
	Left  string
	Right []int32
	Tag   uint8
}

const (
	EitherStringArrayIntLeft = iota
	EitherStringArrayIntRight
)

// main.go
package main

import (
	"fixture/Data/Either"
	"github.com/i-am-the-slime/iris-go/direct"
	"strconv"
)

var main_ = initializeMain_()

func initializeMain_() []either.EitherStringArrayInt {
	append_ := direct.Appender[int32]()
	array := []int32{1, 2, 3}
	accumulator := either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: []int32{}}
	for _, element := range array {
		if accumulator.Tag == either.EitherStringArrayIntLeft {
			break
		}
		switch accumulator.Tag {
		case either.EitherStringArrayIntLeft:
			accumulator = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: accumulator.Left}
		default: // either.EitherStringArrayIntRight
			if element > 0 {
				accumulator = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: append_(accumulator.Right)(element)}
			} else {
				accumulator = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: "not positive: " + strconv.Itoa(int(element))}
			}
		}
	}
	append_2 := direct.Appender[int32]()
	array2 := []int32{1, -2, 3}
	accumulator2 := either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: []int32{}}
	for _, element := range array2 {
		if accumulator2.Tag == either.EitherStringArrayIntLeft {
			break
		}
		switch accumulator2.Tag {
		case either.EitherStringArrayIntLeft:
			accumulator2 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: accumulator2.Left}
		default: // either.EitherStringArrayIntRight
			if element > 0 {
				accumulator2 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right: append_2(accumulator2.Right)(element)}
			} else {
				accumulator2 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left: "not positive: " + strconv.Itoa(int(element))}
			}
		}
	}
	return []either.EitherStringArrayInt{accumulator, accumulator2}
}

func main() {
	_ = main_
}

// note: the entry's value of type Array Data.Either.Either is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
