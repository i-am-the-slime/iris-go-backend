// Data/Either/either.go
package either

type EitherStringArrayInt struct {
	Left0  string
	Right0 []int32
	Tag    uint8
}

const (
	EitherStringArrayIntLeft = iota
	EitherStringArrayIntRight
)

// main.go
package main

import (
	"fixture/Data/Either"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/direct"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []either.EitherStringArrayInt {
	append_ := direct.Appender[int32]()
	array2 := []int32{1, 2, 3}
	accumulator := either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right0: []int32{}}
	for _, element := range array2 {
		accumulator2 := accumulator
		switch accumulator2.Tag {
		case either.EitherStringArrayIntLeft:
			accumulator = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left0: accumulator2.Left0}
		default: // either.EitherStringArrayIntRight
			if element > 0 {
				accumulator = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right0: append_(accumulator2.Right0)(element)}
			} else {
				accumulator = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left0: "not positive: " + prim.ShowInt(element)}
			}
		}
	}
	performed := accumulator
	append_2 := direct.Appender[int32]()
	array3 := []int32{1, -2, 3}
	accumulator3 := either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right0: []int32{}}
	for _, element2 := range array3 {
		accumulator4 := accumulator3
		switch accumulator4.Tag {
		case either.EitherStringArrayIntLeft:
			accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left0: accumulator4.Left0}
		default: // either.EitherStringArrayIntRight
			if element2 > 0 {
				accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntRight, Right0: append_2(accumulator4.Right0)(element2)}
			} else {
				accumulator3 = either.EitherStringArrayInt{Tag: either.EitherStringArrayIntLeft, Left0: "not positive: " + prim.ShowInt(element2)}
			}
		}
	}
	performed2 := accumulator3
	return []either.EitherStringArrayInt{performed, performed2}
}

func main() {
	fmt.Println(main_)
}
