// Data/Either/either.go
package either

type Either struct {
	Left  string
	Right []int
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Right(right []int) Either {
	return Either{Tag: EitherRight, Right: right}
}

func Left(left string) Either {
	return Either{Tag: EitherLeft, Left: left}
}

// Data/Traversable/traversable.go
package traversable

import (
	"fixture/Data/Either"
	"slices"
	"strconv"
)

func TraversePositive(array []int) either.Either {
	accumulator := either.Right([]int{})
	accumulator.Right = slices.Grow(slices.Clip(accumulator.Right), len(array))
	carried := accumulator.Right
	for _, element := range array {
		if element > 0 {
			carried = append(carried, element)
		} else {
			accumulator = either.Left("not positive: " + strconv.Itoa(element))
			break
		}
	}
	if accumulator.Tag != either.EitherLeft {
		accumulator.Right = carried
	}
	return accumulator
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Traversable"
)

var main_ = initializeMain_()

func initializeMain_() []either.Either {
	return []either.Either{traversable.TraversePositive([]int{1, 2, 3}), traversable.TraversePositive([]int{1, -2, 3})}
}

func main() {
	_ = main_
}

// note: the entry's value of type Array Data.Either.Either is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
