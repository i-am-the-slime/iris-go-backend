// Data/Tuple/tuple.go
package tuple

type TupleInt struct {
	First  int
	Second int
}

type Tuple struct {
	First  any
	Second any
	Origin any
}

func Convert(value TupleInt) *Tuple {
	return &Tuple{First: value.First, Second: value.Second, Origin: value}
}

func Convert2(value *Tuple) TupleInt {
	if original, ok := value.Origin.(TupleInt); ok {
		return original
	}
	return TupleInt{First: value.First.(int), Second: value.Second.(int)}
}

// main.go
package main

import (
	"fixture/Data/Tuple"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Sequence struct {
	Zero *Sequence
	One0 any
	One1 *Sequence
	Tag  uint8
}

const (
	SequenceEmpty = iota
	SequenceZero
	SequenceOne
)

var main_ = initializeMain_()

func initializeMain_() []int {
	array := [][]int{{1}, {1, 2, 3}, {4, 5, 6}, {9, 3}, {}}
	mapped := make([]int, len(array))
	var sequenceCells alloc.Cells[Sequence]
	for index, x := range array {
		accumulator := &Sequence{Tag: SequenceEmpty}
		for _, a := range x {
			switch accumulator.Tag {
			case SequenceEmpty:
				accumulator = &Sequence{Tag: SequenceOne, One0: a, One1: &Sequence{Tag: SequenceEmpty}}
			case SequenceZero:
				accumulator = sequenceCells.New(Sequence{Tag: SequenceOne, One0: a, One1: accumulator.Zero})
			default: // SequenceOne
				original := func(x2 any) func(*Sequence) *Sequence {
					return func(value *Sequence) *Sequence {
						return cons(x2, value)
					}
				}
				accumulator = &Sequence{Tag: SequenceZero, Zero: original(tuple.Convert(tuple.TupleInt{First: a, Second: accumulator.One0.(int)}))(accumulator.One1)}
			}
		}
		var result int
	matched:
		for {
			if accumulator.Tag == SequenceOne {
				guarded := accumulator.One0.(int)
				if guarded == 1 {
					result = 100
					break matched
				}
			}
			if accumulator.Tag == SequenceOne && accumulator.One1.Tag == SequenceOne {
				guarded := accumulator.One0.(int)
				guarded2 := tuple.Convert2(accumulator.One1.One0.(*tuple.Tuple))
				result = guarded + guarded2.First*10 + guarded2.Second
				break matched
			}
			if accumulator.Tag == SequenceOne {
				result = accumulator.One0.(int)
				break matched
			}
			if accumulator.Tag == SequenceZero && accumulator.Zero.Tag == SequenceOne {
				guarded := tuple.Convert2(accumulator.Zero.One0.(*tuple.Tuple))
				result = guarded.First - guarded.Second
				break matched
			}
			result = 0
			break matched
		}
		mapped[index] = result
	}
	return mapped
}

func cons(x any, value *Sequence) *Sequence {
	switch value.Tag {
	case SequenceEmpty:
		return &Sequence{Tag: SequenceOne, One0: x, One1: &Sequence{Tag: SequenceEmpty}}
	case SequenceZero:
		return &Sequence{Tag: SequenceOne, One0: x, One1: value.Zero}
	default: // SequenceOne
		original := func(x2 any) func(*Sequence) *Sequence {
			return func(value2 *Sequence) *Sequence {
				return cons(x2, value2)
			}
		}
		return &Sequence{Tag: SequenceZero, Zero: original(&tuple.Tuple{First: x, Second: value.One0})(value.One1)}
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
