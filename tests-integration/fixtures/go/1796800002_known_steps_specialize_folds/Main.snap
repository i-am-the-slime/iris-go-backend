// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type List struct {
	Cons1 *List
	Cons0 int
}

var sharedListNil = &List{}

var main_ = initializeMain_()

func initializeMain_() []int {
	accumulator := 0
	for element := 1; element < 11; element++ {
		accumulator = addSquare(accumulator, element)
	}
	accumulator2 := 0
	for x := 1; x < 11; x++ {
		accumulator2 += 2 * x
	}
	return []int{foldListAddSquare(0, range_(1, 10)), foldListStep3(0, range_(1, 10)), foldListStep(5, 0, range_(1, 10)), foldListStep(7, 0, range_(1, 4)), foldListStep2(100, 0, range_(1, 3)), foldListMax(0, range_(3, 9)), accumulator, accumulator2}
}

func addSquare(total int, x int) int {
	return total + x*x
}

func range_(low int, high int) *List {
	var cells alloc.Cells[List]
	return range_Chunked(low, high, &cells)
}

func range_Chunked(low int, high int, cells *alloc.Cells[List]) *List {
	if low > high {
		return sharedListNil
	}
	return cells.New(List{Cons0: low, Cons1: range_Chunked(low+1, high, cells)})
}

func foldListStep(i int, accumulator int, value *List) int {
	for {
		if value == sharedListNil {
			return accumulator
		}
		x := value.Cons0
		rest := value.Cons1
		accumulator, value = accumulator+i*x, rest
	}
}

func foldListStep2(i int, accumulator int, value *List) int {
	for {
		if value == sharedListNil {
			return accumulator
		}
		x := value.Cons0
		rest := value.Cons1
		accumulator, value = accumulator+x+i, rest
	}
}

func foldListAddSquare(accumulator int, value *List) int {
	for {
		if value == sharedListNil {
			return accumulator
		}
		x := value.Cons0
		rest := value.Cons1
		accumulator, value = accumulator+x*x, rest
	}
}

func foldListStep3(accumulator int, value *List) int {
	for {
		if value == sharedListNil {
			return accumulator
		}
		x := value.Cons0
		rest := value.Cons1
		accumulator, value = accumulator+3*x, rest
	}
}

func foldListMax(accumulator int, value *List) int {
	for {
		if value == sharedListNil {
			return accumulator
		}
		x := value.Cons0
		rest := value.Cons1
		result := max(accumulator, x)
		accumulator, value = result, rest
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
