// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	n := opaque(1)
	var result float64
	if n > 0 {
		result = 2.25
	} else if n*n > 0 {
		result = 4.0
	} else {
		result = 0.0
	}
	n2 := opaque(-2)
	var result2 float64
	if n2 > 0 {
		result2 = 2.25
	} else if n2*n2 > 0 {
		result2 = 4.0
	} else {
		result2 = 0.0
	}
	n3 := opaque(3)
	var result3 string
	if n3 > 0 {
		result3 = "circle " + prim.ShowNumber(1.5)
	} else {
		result3 = "square " + strconv.Itoa(int(n3))
	}
	return []string{prim.ShowNumber(result), prim.ShowNumber(result2), result3, "tag", "a shape", "label x"}
}

func opaque(x int32) int32 {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
