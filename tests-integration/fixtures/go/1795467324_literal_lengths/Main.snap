// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	after, before := direct.SplitAt(3, "😀ab")
	var result string
	if before == "😀a" {
		result = "(Just " + prim.ShowString(after) + ")"
	} else {
		result = "Nothing"
	}
	return []string{result, strconv.Itoa(literalCodeUnitLengthIsAConstant), strconv.Itoa(literalCodePointLengthIsAConstant)}
}

var literalCodeUnitLengthIsAConstant = initializeLiteralCodeUnitLengthIsAConstant()

func initializeLiteralCodeUnitLengthIsAConstant() int {
	return 4
}

var literalCodePointLengthIsAConstant = initializeLiteralCodePointLengthIsAConstant()

func initializeLiteralCodePointLengthIsAConstant() int {
	return 3
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type AfterBefore struct {
	After  string
	Before string
}
