// Data/Semiring/semiring.go
package semiring

func Add(i int32, i2 int32) int32 {
	return i + i2
}

// main.go
package main

import (
	"fixture/Data/Semiring"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

func convert(value any) []int32 {
	return value.([]int32)
}

func convert2(value any) []string {
	return value.([]string)
}

func convert3(value []int32) any {
	return value
}

func convert4(value []string) any {
	return value
}

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	mapped := make([]int32, len(numbers))
	for index, hidden := range numbers {
		array := convert(hidden)
		var accumulator int32 = 0
		for _, element := range array {
			accumulated := accumulator
			accumulator = semiring.Add(accumulated, element)
		}
		mapped[index] = accumulator
	}
	mapped2 := make([]int32, len(words))
	for index, hidden := range words {
		array := convert2(hidden)
		var accumulator int32 = 0
		for range array {
			accumulated := accumulator
			accumulator = semiring.Add(accumulated, 1)
		}
		mapped2[index] = prim.MultiplyInt32(0, accumulator)
	}
	return array.Append(mapped, mapped2)
}

var numbers = initializeNumbers()

func initializeNumbers() []any {
	defer exception.ReportUncaught()
	return []any{convert3([]int32{1, 2}), convert3([]int32{3})}
}

var words = initializeWords()

func initializeWords() []any {
	defer exception.ReportUncaught()
	return []any{convert4([]string{"a", "b"})}
}

func main() {
	fmt.Println(main_)
}
