// main.go
package main

import (
	"fixture/shared"
	arraypkg "github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	mapped := make([]int, len(numbers))
	for index, hidden := range numbers {
		mapped[index] = foldLanes(shared.Convert(hidden), 0)
	}
	mapped2 := make([]int, len(words))
	for index, hidden := range words {
		array := shared.Convert2(hidden)
		accumulator := 0
		for range array {
			value := 1
			accumulator += value
		}
		mapped2[index] = 0 * accumulator
	}
	return arraypkg.Append(mapped, mapped2)
}

var numbers = initializeNumbers()

func initializeNumbers() []any {
	return []any{shared.Convert3([]int{1, 2}), shared.Convert3([]int{3})}
}

var words = initializeWords()

func initializeWords() []any {
	return []any{shared.Convert4([]string{"a", "b"})}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"simd/archsimd"
	"unsafe"
)

func foldLanesLanes(xs []int64, initial int64) int64 {
	acc0 := archsimd.BroadcastInt64x2(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt64x2(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt64x2(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [2]int64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
func foldLanes(xs []int, initial int) int {
	return int(foldLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)), int64(initial)))
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int, initial int) int {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"simd"
	"unsafe"
)

func foldLanesLanes(xs []int64, initial int64) int64 {
	acc0 := simd.BroadcastInt64s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt64s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt64s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt64s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt64s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [8]int64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
func foldLanes(xs []int, initial int) int {
	return int(foldLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)), int64(initial)))
}

// shared/shared.go
package shared

func Convert(value any) []int {
	return value.([]int)
}

func Convert2(value any) []string {
	return value.([]string)
}

func Convert3(value []int) any {
	return value
}

func Convert4(value []string) any {
	return value
}
