// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	mapped := make([]int32, len(numbers))
	for index, hidden := range numbers {
		array := shared.Convert(hidden)
		var accumulator int32 = 0
		for _, value := range array {
			accumulator = accumulator + value
		}
		mapped[index] = accumulator
	}
	mapped2 := make([]int32, len(words))
	for index, hidden := range words {
		array := shared.Convert2(hidden)
		var accumulator int32 = 0
		for range array {
			var value int32 = 1
			accumulator = accumulator + value
		}
		mapped2[index] = 0 * accumulator
	}
	return array.Append(mapped, mapped2)
}

var numbers = initializeNumbers()

func initializeNumbers() []any {
	defer exception.ReportUncaught()
	return []any{shared.Convert3([]int32{1, 2}), shared.Convert3([]int32{3})}
}

var words = initializeWords()

func initializeWords() []any {
	defer exception.ReportUncaught()
	return []any{shared.Convert4([]string{"a", "b"})}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

func Convert(value any) []int32 {
	return value.([]int32)
}

func Convert2(value any) []string {
	return value.([]string)
}

func Convert3(value []int32) any {
	return value
}

func Convert4(value []string) any {
	return value
}
