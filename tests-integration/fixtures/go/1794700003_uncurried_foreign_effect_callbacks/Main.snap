// main.go
package main

import "os"

func main_() int {
	seen := 0
	accumulator := 0
	for _, i := range []int{1, 2, 3} {
		seen += 1
		accumulator += i
	}
	return accumulator*10 + seen
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
