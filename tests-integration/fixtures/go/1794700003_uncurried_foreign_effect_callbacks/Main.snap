// Data/Array/array.go
package dataarray

import "github.com/i-am-the-slime/purs-backend-go/go-support/direct"

func FoldMEffectIntInt(f func(int32, int32) int32, b int32, array []int32) int32 {
	function := func(_ struct{}) int32 {
		return b
	}
	return direct.Uncons(func(unit struct{}) func() int32 {
		return func() int32 {
			return function(unit)
		}
	}, func(a int32, as []int32) func() int32 {
		return func() int32 {
			i := f(b, a)
			return FoldMEffectIntInt(f, i, as)
		}
	}, array)()
}

// main.go
package main

import (
	"fixture/Data/Array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
	"os"
)

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

func main_() int32 {
	ref := &Ref[int32]{Value: 0}
	i := dataarray.FoldMEffectIntInt(func(acc int32, n int32) int32 {
		s := ref.Value
		s_ := s + 1
		modified := StateValue{State: s_, Value: s_}
		ref.Value = modified.State
		return acc + n
	}, 0, []int32{1, 2, 3})
	i2 := ref.Value
	return prim.MultiplyInt32(i, 10) + i2
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}
