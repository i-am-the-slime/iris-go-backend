// main.go
package main

import "os"

func main_() int32 {
	var seen int32 = 0
	var accumulator int32 = 0
	for _, i := range []int32{1, 2, 3} {
		seen += 1
		accumulator += i
	}
	return accumulator*10 + seen
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
