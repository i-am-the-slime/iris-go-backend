// Data/Array/array.go
package dataarray

import "github.com/i-am-the-slime/iris-go/direct"

func FoldMEffectIntInt(f func(int32, int32) int32, b int32, array []int32) int32 {
	function := func(_ struct{}) int32 {
		return b
	}
	return direct.Uncons(func(unit struct{}) func() int32 {
		return func() int32 {
			return function(unit)
		}
	}, func(a int32, as []int32) func() int32 {
		return func() int32 {
			i := f(b, a)
			return FoldMEffectIntInt(f, i, as)
		}
	}, array)()
}

// main.go
package main

import (
	"fixture/Data/Array"
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

func main_() int32 {
	var ref int32 = 0
	i := dataarray.FoldMEffectIntInt(func(acc int32, n int32) int32 {
		s_ := ref + 1
		ref = s_
		return acc + n
	}, 0, []int32{1, 2, 3})
	return i*10 + ref
}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
