// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{strconv.Itoa(func(coerced any) int {
		return coerced.(int)
	}(int(21))), strconv.Itoa(func(coerced any) int {
		return coerced.(int)
	}(int(42)))}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
