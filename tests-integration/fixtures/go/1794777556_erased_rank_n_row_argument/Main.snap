// Control/Category/category.go
package category

func Identity(x int32) int32 {
	return x
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	array := []int32{20, 41}
	mapped := make([]string, len(array))
	for index, x := range array {
		mapped[index] = prim.ShowInt(func(coerced any) int32 {
			return category.Identity(coerced.(int32))
		}(x + 1))
	}
	return mapped
}

func main() {
	fmt.Println(main_)
}
