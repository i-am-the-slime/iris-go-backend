// Data/Either/either.go
package either

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type EitherIntString struct {
	Right string
	Left  int32
	Tag   uint8
}

const (
	EitherIntStringLeft = iota
	EitherIntStringRight
)

func Left(left int32) EitherIntString {
	return EitherIntString{Tag: EitherIntStringLeft, Left: left}
}

func Right(right string) EitherIntString {
	return EitherIntString{Tag: EitherIntStringRight, Right: right}
}

func ShowIntString(either EitherIntString) string {
	return string(AppendShowIntString(nil, either))
}

func AppendShowArrayEitherIntString(buffer []byte, array []EitherIntString) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowIntString(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowIntString(buffer []byte, either EitherIntString) []byte {
	switch either.Tag {
	case EitherIntStringLeft:
		buffer = append(buffer, "(Left "...)
		buffer = strconv.AppendInt(buffer, int64(either.Left), 10)
		buffer = append(buffer, ")"...)
	default: // EitherIntStringRight
		buffer = append(buffer, "(Right "...)
		buffer = prim.AppendShowString(buffer, either.Right)
		buffer = append(buffer, ")"...)
	}
	return buffer
}

// Data/Maybe/maybe.go
package maybe

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Int int64

const NoInt Int = 1 << 32

type XY struct {
	X Int
	Y Int
}

const TagNothing = 0

const TagJust = 1

type Number struct {
	Just float64
	Tag  uint8
}

func JustNumber(just float64) Number {
	return Number{Tag: TagJust, Just: just}
}

func ShowXYConsMaybeIntConsMaybeIntNil(record XY) string {
	return string(AppendShowXYConsMaybeIntConsMaybeIntNil(nil, record))
}

func ShowNumber(maybe Number) string {
	return string(AppendShowNumber(nil, maybe))
}

func AppendShowArrayMaybeNumber(buffer []byte, array []Number) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowNumber(buffer []byte, maybe Number) []byte {
	switch maybe.Tag {
	case TagJust:
		buffer = append(buffer, "(Just "...)
		buffer = prim.AppendShowNumber(buffer, maybe.Just)
		buffer = append(buffer, ")"...)
	default: // TagNothing
		buffer = append(buffer, "Nothing"...)
	}
	return buffer
}

func AppendShowArrayXY(buffer []byte, array []XY) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowXYConsMaybeIntConsMaybeIntNil(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowXYConsMaybeIntConsMaybeIntNil(buffer []byte, record XY) []byte {
	buffer = append(buffer, "{ x: "...)
	if record.X != NoInt {
		buffer = append(buffer, "(Just "...)
		buffer = strconv.AppendInt(buffer, int64(int32(record.X)), 10)
		buffer = append(buffer, ")"...)
	} else {
		buffer = append(buffer, "Nothing"...)
	}
	buffer = append(buffer, ", y: "...)
	if record.Y != NoInt {
		buffer = append(buffer, "(Just "...)
		buffer = strconv.AppendInt(buffer, int64(int32(record.Y)), 10)
		buffer = append(buffer, ")"...)
	} else {
		buffer = append(buffer, "Nothing"...)
	}
	buffer = append(buffer, " }"...)
	return buffer
}

