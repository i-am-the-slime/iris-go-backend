// Data/Either/either.go
package either

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Either struct {
	Right string
	Left  int
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type IntFailure struct {
	Failed bool
	Left   int
}

func Left(left int) Either {
	return Either{Tag: EitherLeft, Left: left}
}

func Right(right string) Either {
	return Either{Tag: EitherRight, Right: right}
}

func Show(s string, err IntFailure) string {
	return string(AppendShow(nil, s, err))
}

func AppendShowArrayEitherIntString(buffer []byte, array []Either) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShow(buffer, element.Right, EitherFailure(element))
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShow(buffer []byte, s string, err IntFailure) []byte {
	if err.Failed {
		buffer = append(buffer, "(Left "...)
		buffer = strconv.AppendInt(buffer, int64(err.Left), 10)
		buffer = append(buffer, ')')
	} else {
		buffer = append(buffer, "(Right "...)
		buffer = prim.AppendShowString(buffer, s)
		buffer = append(buffer, ')')
	}
	return buffer
}

func EitherFailure(either Either) IntFailure {
	if either.Tag == EitherLeft {
		return IntFailure{Failed: true, Left: either.Left}
	}
	return IntFailure{}
}

// Data/Maybe/maybe.go
package maybe

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

type XY struct {
	X Int
	Y Int
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

type Number struct {
	Just float64
	Tag  uint8
}

func JustNumber(just float64) Number {
	return Number{Tag: TagJust, Just: just}
}

func ShowXYConsMaybeIntConsMaybeIntNil(record XY) string {
	return string(AppendShowXYConsMaybeIntConsMaybeIntNil(nil, record))
}

func ShowMaybe(maybe Number) string {
	return string(AppendShowMaybe(nil, maybe))
}

func AppendShowArrayMaybeNumber(buffer []byte, array []Number) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowMaybe(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowMaybe(buffer []byte, maybe Number) []byte {
	switch maybe.Tag {
	case TagJust:
		buffer = append(buffer, "(Just "...)
		buffer = prim.AppendShowNumber(buffer, maybe.Just)
		buffer = append(buffer, ')')
	default: // TagNothing
		buffer = append(buffer, "Nothing"...)
	}
	return buffer
}

func AppendShowArrayXY(buffer []byte, array []XY) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowXYConsMaybeIntConsMaybeIntNil(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowXYConsMaybeIntConsMaybeIntNil(buffer []byte, record XY) []byte {
	buffer = append(buffer, "{ x: "...)
	switch record.X.Tag {
	case TagJust:
		buffer = append(buffer, "(Just "...)
		buffer = strconv.AppendInt(buffer, int64(record.X.Just), 10)
		buffer = append(buffer, ')')
	default: // TagNothing
		buffer = append(buffer, "Nothing"...)
	}
	buffer = append(buffer, ", y: "...)
	switch record.Y.Tag {
	case TagJust:
		buffer = append(buffer, "(Just "...)
		buffer = strconv.AppendInt(buffer, int64(record.Y.Just), 10)
		buffer = append(buffer, ')')
	default: // TagNothing
		buffer = append(buffer, "Nothing"...)
	}
	buffer = append(buffer, " }"...)
	return buffer
}

func ArrayXY(array []XY) string {
	return string(AppendShowArrayXY(nil, array))
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func ShowInt(i int) string {
	return strconv.Itoa(i)
}

func ShowNumber(number float64) string {
	return prim.ShowNumber(number)
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayArrayInt(buffer []byte, array [][]int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowArrayInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayArrayInt(array [][]int) string {
	return string(AppendShowArrayArrayInt(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"fixture/shared/Data.Maybe+Data.Tuple"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type Shape struct {
	Circle float64
	Rect   shared.HW
	Pair0  int32
	Pair1  maybe.Int
	Tag    uint8
}

const (
	ShapeCircle = iota
	ShapeRect
	ShapeEmpty
	ShapePair
)

type Colour struct {
	Mixed0 *Colour
	Mixed1 *Colour
	Named  string
	Tag    uint8
}

const (
	ColourRed = iota
	ColourMixed
	ColourNamed
)

var sharedColourRed = &Colour{Tag: ColourRed}

type Wrapped struct {
	A int
}

type Point struct {
	First  int
	Second int
}

func Circle(circle float64) Shape {
	return Shape{Tag: ShapeCircle, Circle: circle}
}

func Rect(rect shared.HW) Shape {
	return Shape{Tag: ShapeRect, Rect: rect}
}

func Pair(pair0 int, pair1 maybe.Int) Shape {
	return Shape{Tag: ShapePair, Pair0: int32(pair0), Pair1: pair1}
}

func Named(named string) *Colour {
	return &Colour{Tag: ColourNamed, Named: named}
}

func Mixed(mixed0 *Colour, mixed1 *Colour) *Colour {
	return &Colour{Tag: ColourMixed, Mixed0: mixed0, Mixed1: mixed1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	text := []byte("{ age: ")
	text = strconv.AppendInt(text, int64(3), 10)
	text = append(text, ", b: true, name: "...)
	text = prim.AppendShowString(text, "x")
	text = append(text, ", z: "...)
	text = show.AppendShowArrayNumber(text, []float64{1.5})
	text = append(text, " }"...)
	text2 := either.AppendShowArrayEitherIntString(nil, []either.Either{either.Left(1), either.Right("x")})
	text2 = maybe_tuple.AppendShowArrayTupleCharArrayMaybeNumber(text2, []maybe_tuple.Tuple{{First: 'a', Second: []maybe.Number{maybe.JustNumber(2.5)}}})
	text3 := appendShowArrayNumber(nil, []float64{1.0})
	text3 = show.AppendShowArrayNumber(text3, []float64{1.0})
	return []string{show.ArrayInt([]int{1, 2, 3}), show.ArrayInt([]int{}), show.ArrayArrayInt([][]int{{1}, {}, {-2, 3}}), string(text), maybe.ArrayXY([]maybe.XY{{X: maybe.JustInt(1), Y: maybe.NoInt}}), string(text2), arrayShape([]Shape{Circle(1.0), Rect(shared.HW{W: 1, H: -2}), {Tag: ShapeEmpty}, Pair(-3, maybe.JustInt(-4))}), arrayColour([]*Colour{sharedColourRed, Mixed(sharedColourRed, Named("x\"y"))}), string(text3), arrayWrapped([]Wrapped{{A: 1}}), arrayPoint([]Point{{First: 1, Second: 2}})}
}

func showShape(shape Shape) string {
	return string(appendShowShape(nil, shape))
}

func showColour(colour *Colour) string {
	return string(appendShowColour(nil, colour))
}

func showMeters(number float64) string {
	return string(appendShowMeters(nil, number))
}

func showWrappedConsIntNil(record Wrapped) string {
	return string(appendShowWrappedConsIntNil(nil, record))
}

func showPoint(point Point) string {
	return string(appendShowPoint(nil, point))
}

func appendShowColour(buffer []byte, colour *Colour) []byte {
	switch colour.Tag {
	case ColourRed:
		buffer = append(buffer, "Red"...)
	case ColourMixed:
		buffer = append(buffer, "(Mixed "...)
		buffer = appendShowColour(buffer, colour.Mixed0)
		buffer = append(buffer, ' ')
		buffer = appendShowColour(buffer, colour.Mixed1)
		buffer = append(buffer, ')')
	default: // ColourNamed
		buffer = append(buffer, "(Named "...)
		buffer = prim.AppendShowString(buffer, colour.Named)
		buffer = append(buffer, ')')
	}
	return buffer
}

func appendShowArrayPoint(buffer []byte, array []Point) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = appendShowPoint(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func appendShowPoint(buffer []byte, point Point) []byte {
	buffer = append(buffer, '<')
	buffer = strconv.AppendInt(buffer, int64(point.First), 10)
	buffer = append(buffer, ',')
	buffer = strconv.AppendInt(buffer, int64(point.Second), 10)
	buffer = append(buffer, '>')
	return buffer
}

func appendShowArrayWrapped(buffer []byte, array []Wrapped) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = appendShowWrappedConsIntNil(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func appendShowWrappedConsIntNil(buffer []byte, record Wrapped) []byte {
	buffer = append(buffer, "{ a: "...)
	buffer = strconv.AppendInt(buffer, int64(record.A), 10)
	buffer = append(buffer, " }"...)
	return buffer
}

func appendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = appendShowMeters(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func appendShowMeters(buffer []byte, number float64) []byte {
	buffer = append(buffer, "(Meters "...)
	buffer = prim.AppendShowNumber(buffer, number)
	buffer = append(buffer, ')')
	return buffer
}

func appendShowArrayColour(buffer []byte, array []*Colour) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = appendShowColour(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func appendShowArrayShape(buffer []byte, array []Shape) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = appendShowShape(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func appendShowShape(buffer []byte, shape Shape) []byte {
	switch shape.Tag {
	case ShapeCircle:
		buffer = append(buffer, "(Circle "...)
		buffer = prim.AppendShowNumber(buffer, shape.Circle)
		buffer = append(buffer, ')')
	case ShapeRect:
		hw := shape.Rect
		buffer = append(buffer, "(Rect { h: "...)
		buffer = strconv.AppendInt(buffer, int64(hw.H), 10)
		buffer = append(buffer, ", w: "...)
		buffer = strconv.AppendInt(buffer, int64(hw.W), 10)
		buffer = append(buffer, " })"...)
	case ShapeEmpty:
		buffer = append(buffer, "Empty"...)
	default: // ShapePair
		buffer = append(buffer, "(Pair "...)
		buffer = strconv.AppendInt(buffer, int64(int(shape.Pair0)), 10)
		buffer = append(buffer, ' ')
		switch shape.Pair1.Tag {
		case maybe.TagJust:
			buffer = append(buffer, "(Just "...)
			buffer = strconv.AppendInt(buffer, int64(shape.Pair1.Just), 10)
			buffer = append(buffer, ')')
		default: // maybe.TagNothing
			buffer = append(buffer, "Nothing"...)
		}
		buffer = append(buffer, ')')
	}
	return buffer
}

func arrayPoint(array []Point) string {
	return string(appendShowArrayPoint(nil, array))
}

func arrayWrapped(array []Wrapped) string {
	return string(appendShowArrayWrapped(nil, array))
}

func arrayColour(array []*Colour) string {
	return string(appendShowArrayColour(nil, array))
}

func arrayShape(array []Shape) string {
	return string(appendShowArrayShape(nil, array))
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/Data.Maybe+Data.Tuple/maybe_tuple.go
package maybe_tuple

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/prim"
)

type Tuple struct {
	Second []maybe.Number
	First  rune
}

func Show(tuple Tuple) string {
	return string(AppendShow(nil, tuple))
}

func AppendShowArrayTupleCharArrayMaybeNumber(buffer []byte, array []Tuple) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShow(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShow(buffer []byte, tuple Tuple) []byte {
	buffer = append(buffer, "(Tuple "...)
	buffer = prim.AppendShowChar(buffer, tuple.First)
	buffer = append(buffer, ' ')
	buffer = maybe.AppendShowArrayMaybeNumber(buffer, tuple.Second)
	buffer = append(buffer, ')')
	return buffer
}

// shared/shared.go
package shared

type HW struct {
	H int
	W int
}
