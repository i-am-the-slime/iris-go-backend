}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"fixture/shared"
	"fixture/shared/Data.Maybe+Data.Tuple"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

type Shape struct {
	Circle float64
	Pair1  maybe.Int
	Rect   shared.HW
	Pair0  int32
	Tag    uint8
}

const (
	ShapeCircle = iota
	ShapeRect
	ShapeEmpty
	ShapePair
)

type Colour struct {
	Mixed0 *Colour
	Mixed1 *Colour
	Named  string
	Tag    uint8
}

const (
	ColourRed = iota
	ColourMixed
	ColourNamed
)

var sharedColourRed = &Colour{Tag: ColourRed}

type Point struct {
	First  int32
	Second int32
}

func Circle(circle float64) Shape {
	return Shape{Tag: ShapeCircle, Circle: circle}
}

func Rect(rect shared.HW) Shape {
	return Shape{Tag: ShapeRect, Rect: rect}
}

func Pair(pair0 int32, pair1 maybe.Int) Shape {
	return Shape{Tag: ShapePair, Pair0: pair0, Pair1: pair1}
}

func Named(named string) *Colour {
	return &Colour{Tag: ColourNamed, Named: named}
}

func Mixed(mixed0 *Colour, mixed1 *Colour) *Colour {
	return &Colour{Tag: ColourMixed, Mixed0: mixed0, Mixed1: mixed1}
}

var main_ = initializeMain_()

func initializeMain_() []string {
	record := shared.AgeBNameZ{Name: "x", Age: 3, B: true, Z: []float64{1.5}}
	text := []byte("{ age: ")
	text = strconv.AppendInt(text, int64(record.Age), 10)
	text = append(text, ", b: "...)
	text = strconv.AppendBool(text, record.B)
	text = append(text, ", name: "...)
	text = prim.AppendShowString(text, record.Name)
	text = append(text, ", z: "...)
	text = show.AppendShowArrayNumber(text, record.Z)
	text = append(text, " }"...)
	text2 := either.AppendShowArrayEitherIntString(nil, []either.EitherIntString{either.Left(1), either.Right("x")})
	text2 = maybe_tuple.AppendShowArrayTupleCharArrayMaybeNumber(text2, []maybe_tuple.TupleCharArrayMaybeNumber{{First: 'a', Second: []maybe.Number{maybe.JustNumber(2.5)}}})
	text3 := appendShowArrayNumber(nil, []float64{1.0})
	text3 = show.AppendShowArrayNumber(text3, []float64{1.0})
	return []string{string(show.AppendShowArrayInt(nil, []int32{1, 2, 3})), string(show.AppendShowArrayInt(nil, []int32{})), string(show.AppendShowArrayArrayInt(nil, [][]int32{{1}, {}, {-2, 3}})), string(text), string(maybe.AppendShowArrayXY(nil, []maybe.XY{{X: maybe.Int(1), Y: maybe.NoInt}})), string(text2), string(appendShowArrayShape(nil, []Shape{Circle(1.0), Rect(shared.HW{W: 1, H: -2}), {Tag: ShapeEmpty}, Pair(-3, maybe.Int(-4))})), string(appendShowArrayColour(nil, []*Colour{sharedColourRed, Mixed(sharedColourRed, Named("x\"y"))})), string(text3), string(show.AppendShowArrayWrapped(nil, []shared.Wrapped{{A: 1}})), string(appendShowArrayPoint(nil, []Point{{First: 1, Second: 2}}))}
}

func showShape(shape Shape) string {
	return string(appendShowShape(nil, shape))
}

func showColour(colour *Colour) string {
	return string(appendShowColour(nil, colour))
}

func showMeters(number float64) string {
	return string(appendShowMeters(nil, number))
}

func showPoint(point Point) string {
	return string(appendShowPoint(nil, point))
}

func appendShowColour(buffer []byte, colour *Colour) []byte {
	switch colour.Tag {
	case ColourRed:
		buffer = append(buffer, "Red"...)
	case ColourMixed:
		buffer = append(buffer, "(Mixed "...)
		buffer = appendShowColour(buffer, colour.Mixed0)
		buffer = append(buffer, " "...)
		buffer = appendShowColour(buffer, colour.Mixed1)
		buffer = append(buffer, ")"...)
	default: // ColourNamed
		buffer = append(buffer, "(Named "...)
		buffer = prim.AppendShowString(buffer, colour.Named)
		buffer = append(buffer, ")"...)
	}
	return buffer
}

func appendShowArrayPoint(buffer []byte, array []Point) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = appendShowPoint(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func appendShowPoint(buffer []byte, point Point) []byte {
	buffer = append(buffer, "<"...)
	buffer = strconv.AppendInt(buffer, int64(point.First), 10)
	buffer = append(buffer, ","...)
	buffer = strconv.AppendInt(buffer, int64(point.Second), 10)
	buffer = append(buffer, ">"...)
	return buffer
}

func appendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = appendShowMeters(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func appendShowMeters(buffer []byte, number float64) []byte {
	buffer = append(buffer, "(Meters "...)
	buffer = prim.AppendShowNumber(buffer, number)
	buffer = append(buffer, ")"...)
	return buffer
}

func appendShowArrayColour(buffer []byte, array []*Colour) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = appendShowColour(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func appendShowArrayShape(buffer []byte, array []Shape) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = appendShowShape(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func appendShowShape(buffer []byte, shape Shape) []byte {
	switch shape.Tag {
	case ShapeCircle:
		buffer = append(buffer, "(Circle "...)
		buffer = prim.AppendShowNumber(buffer, shape.Circle)
		buffer = append(buffer, ")"...)
	case ShapeRect:
		hw := shape.Rect
		buffer = append(buffer, "(Rect { h: "...)
		buffer = strconv.AppendInt(buffer, int64(hw.H), 10)
		buffer = append(buffer, ", w: "...)
		buffer = strconv.AppendInt(buffer, int64(hw.W), 10)
		buffer = append(buffer, " })"...)
	case ShapeEmpty:
		buffer = append(buffer, "Empty"...)
	default: // ShapePair
		buffer = append(buffer, "(Pair "...)
		buffer = strconv.AppendInt(buffer, int64(shape.Pair0), 10)
		buffer = append(buffer, " "...)
		if shape.Pair1 != maybe.NoInt {
			buffer = append(buffer, "(Just "...)
			buffer = strconv.AppendInt(buffer, int64(int32(shape.Pair1)), 10)
			buffer = append(buffer, ")"...)
		} else {
			buffer = append(buffer, "Nothing"...)
		}
		buffer = append(buffer, ")"...)
	}
	return buffer
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/Data.Maybe+Data.Tuple/maybe_tuple.go
package maybe_tuple

import (
	"fixture/Data/Maybe"
	"github.com/i-am-the-slime/iris-go/prim"
)

type TupleCharArrayMaybeNumber struct {
	Second []maybe.Number
	First  rune
}

func ShowCharArrayMaybeNumber(tuple TupleCharArrayMaybeNumber) string {
	return string(AppendShowCharArrayMaybeNumber(nil, tuple))
}

func AppendShowArrayTupleCharArrayMaybeNumber(buffer []byte, array []TupleCharArrayMaybeNumber) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShowCharArrayMaybeNumber(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShowCharArrayMaybeNumber(buffer []byte, tuple TupleCharArrayMaybeNumber) []byte {
	buffer = append(buffer, "(Tuple "...)
	buffer = prim.AppendShowChar(buffer, tuple.First)
	buffer = append(buffer, " "...)
	buffer = maybe.AppendShowArrayMaybeNumber(buffer, tuple.Second)
	buffer = append(buffer, ")"...)
	return buffer
}

// shared/shared.go
package shared

type AgeBNameZ struct {
	Name string
	Z    []float64
	Age  int32
	B    bool
}

type HW struct {
	H int32
	W int32
}

type Wrapped struct {
	A int32
}
