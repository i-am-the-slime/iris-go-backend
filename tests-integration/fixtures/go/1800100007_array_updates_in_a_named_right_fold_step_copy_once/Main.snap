// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	accumulator := []int{1, 1, 1, 1, 1}
	accumulator = slices.Clone(accumulator)
	for index := 3; index >= 0; index-- {
		accumulator = squaredIntoOwning(index, accumulator)
	}
	accumulator2 := []int{}
	accumulator2 = slices.Clone(accumulator2)
	for index := 3; index >= 0; index-- {
		accumulator2 = squaredIntoOwning(index, accumulator2)
	}
	return []string{show.ArrayInt(accumulator), show.ArrayInt(accumulator2), show.ArrayInt([]int{1, 1, 1, 1, 1})}
}

func squaredIntoOwning(position int, current []int) []int {
	if position < len(current) {
		value := position * position
		updated := current
		updated[position] = value
		return updated
	}
	return current
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
