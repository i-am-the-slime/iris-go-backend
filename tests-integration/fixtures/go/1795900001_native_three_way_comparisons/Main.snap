// Data/Int64/int64.go
package dataint64

import "strconv"

func FromInt(a int32) int64 {
	return int64(a)
}

func Show(long int64) string {
	return string(AppendShow(nil, long))
}

func AppendShowArrayInt64(buffer []byte, array []int64) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShow(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShow(buffer []byte, long int64) []byte {
	buffer = strconv.AppendInt(buffer, long, 10)
	buffer = append(buffer, "l"...)
	return buffer
}

// Data/Ord/ord.go
package ord

func MaxInt64(x int64, y int64) int64 {
	if x >= y {
		return x
	}
	return y
}

func MinUInt64(x uint64, y uint64) uint64 {
	if x <= y {
		return x
	}
	return y
}

func MaxInt(x int32, y int32) int32 {
	if x < y {
		return y
	}
	return x
}

func MaxNumber(x float64, y float64) float64 {
	if x < y {
		return y
	}
	return x
}

// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// Data/UInt64/uint64.go
package datauint64

import "strconv"

func UnsafeFromInt(a int32) uint64 {
	return uint64(a)
}

func Show(long uint64) string {
	return string(AppendShow(nil, long))
}

func AppendShowArrayUInt64(buffer []byte, array []uint64) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = AppendShow(buffer, element)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

func AppendShow(buffer []byte, long uint64) []byte {
	buffer = strconv.AppendUint(buffer, long, 10)
	buffer = append(buffer, "ul"...)
	return buffer
}

// main.go
package main

import (
	"fixture/Data/Int64"
	"fixture/Data/Show"
	"fixture/Data/UInt64"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	ints := []int32{3, -1, 4, 1, -5, 9, 2, 6, 5, 3, -5, 8, 9, 7, 9, 3, 2, 3, 8, 4, -6, 2, 6, 4, 3, 3, 8, 3, 2, 7, 9, 5, 0}
	mapped := make([]int64, len(ints))
	for index, element := range ints {
		mapped[index] = dataint64.FromInt(element)
	}
	mapped2 := make([]uint64, len(ints))
	for index, element := range ints {
		mapped2[index] = datauint64.UnsafeFromInt(element)
	}
	pivot := int64(2)
	kept := []int64{}
	for _, x := range mapped {
		if x < pivot {
			kept = append(kept, x)
		}
	}
	pivot2 := uint64(2)
	kept2 := []uint64{}
	for _, x := range mapped2 {
		if x <= pivot2 {
			kept2 = append(kept2, x)
		}
	}
	pivot3 := int64(3)
	mapped3 := make([]int32, len(mapped))
	for index, x := range mapped {
		var result int32
		if x == pivot3 {
			result = 2
		} else if x > pivot3 {
			result = 3
		} else {
			result = 1
		}
		mapped3[index] = result
	}
	return []string{strconv.FormatInt(foldLanes(mapped, int64(-9223372036854775808)), 10) + "l", strconv.FormatUint(foldLanes2(mapped2, uint64(18446744073709551615)), 10) + "ul", strconv.Itoa(int(foldLanes3(ints, int32(prim.BottomInt)))), prim.ShowNumber(foldLanes4([]float64{3.5, -1.0, 4.0, 1.0, -5.0, 9.25, 2.0, 6.0, 5.0, 3.0, -5.0, 8.0, 9.0, 7.0, 9.0, 3.0, 2.0, 3.0, 8.0, 4.0, -6.0, 2.0, 6.0, 4.0, 3.0, 3.0, 8.0, 3.0, 2.0, 7.0, 9.0, 5.0, 0.0}, 0.0)), string(dataint64.AppendShowArrayInt64(nil, kept)), string(datauint64.AppendShowArrayUInt64(nil, kept2)), string(show.AppendShowArrayInt(nil, mapped3)), "true"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func foldLanes(xs []int64, initial int64) int64 {
	acc0 := archsimd.BroadcastInt64x2(initial)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt64x2(xs[i : i+step])
		acc0 = acc0.IfElse(acc0.GreaterEqual(x0), x0)
		x1 := archsimd.LoadInt64x2(xs[i+step : i+2*step])
		acc1 = acc1.IfElse(acc1.GreaterEqual(x1), x1)
		x2 := archsimd.LoadInt64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.IfElse(acc2.GreaterEqual(x2), x2)
		x3 := archsimd.LoadInt64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.IfElse(acc3.GreaterEqual(x3), x3)
	}
	acc0 = acc3.IfElse(acc2.Less(acc3), acc2).IfElse(acc1.IfElse(acc0.Less(acc1), acc0).Less(acc3.IfElse(acc2.Less(acc3), acc2)), acc1.IfElse(acc0.Less(acc1), acc0))
	var lanes [2]int64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		if accumulator < lane {
			accumulator = lane
		}
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		s0 := x
		if accumulator >= x {
			s0 = accumulator
		}
		accumulator = s0
	}
	return accumulator
}

func foldLanes2(xs []uint64, initial uint64) uint64 {
	acc0 := archsimd.BroadcastUint64x2(initial)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadUint64x2(xs[i : i+step])
		acc0 = acc0.IfElse(acc0.LessEqual(x0), x0)
		x1 := archsimd.LoadUint64x2(xs[i+step : i+2*step])
		acc1 = acc1.IfElse(acc1.LessEqual(x1), x1)
		x2 := archsimd.LoadUint64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.IfElse(acc2.LessEqual(x2), x2)
		x3 := archsimd.LoadUint64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.IfElse(acc3.LessEqual(x3), x3)
	}
	acc0 = acc3.IfElse(acc3.Less(acc2), acc2).IfElse(acc3.IfElse(acc3.Less(acc2), acc2).Less(acc1.IfElse(acc1.Less(acc0), acc0)), acc1.IfElse(acc1.Less(acc0), acc0))
	var lanes [2]uint64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		if lane < accumulator {
			accumulator = lane
		}
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		s0 := x
		if accumulator <= x {
			s0 = accumulator
		}
		accumulator = s0
	}
	return accumulator
}

func foldLanes3(xs []int32, initial int32) int32 {
	acc0 := archsimd.BroadcastInt32x4(initial)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 4
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt32x4(xs[i : i+step])
		acc0 = acc0.Max(x0)
		x1 := archsimd.LoadInt32x4(xs[i+step : i+2*step])
		acc1 = acc1.Max(x1)
		x2 := archsimd.LoadInt32x4(xs[i+2*step : i+3*step])
		acc2 = acc2.Max(x2)
		x3 := archsimd.LoadInt32x4(xs[i+3*step : i+4*step])
		acc3 = acc3.Max(x3)
	}
	acc0 = acc0.Max(acc1).Max(acc2.Max(acc3))
	var lanes [4]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		if accumulator < lane {
			accumulator = lane
		}
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		s0 := accumulator
		if accumulator < x {
			s0 = x
		}
		accumulator = s0
	}
	return accumulator
}

func foldLanes4(xs []float64, initial float64) float64 {
	acc0 := archsimd.BroadcastFloat64x2(initial)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadFloat64x2(xs[i : i+step])
		acc0 = x0.IfElse(acc0.Less(x0), acc0)
		x1 := archsimd.LoadFloat64x2(xs[i+step : i+2*step])
		acc1 = x1.IfElse(acc1.Less(x1), acc1)
		x2 := archsimd.LoadFloat64x2(xs[i+2*step : i+3*step])
		acc2 = x2.IfElse(acc2.Less(x2), acc2)
		x3 := archsimd.LoadFloat64x2(xs[i+3*step : i+4*step])
		acc3 = x3.IfElse(acc3.Less(x3), acc3)
	}
	acc0 = acc3.IfElse(acc2.Less(acc3), acc2).IfElse(acc1.IfElse(acc0.Less(acc1), acc0).Less(acc3.IfElse(acc2.Less(acc3), acc2)), acc1.IfElse(acc0.Less(acc1), acc0))
	var lanes [2]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		if accumulator < lane {
			accumulator = lane
		}
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		s0 := accumulator
		if accumulator < x {
			s0 = x
		}
		accumulator = s0
	}
	return accumulator
}

