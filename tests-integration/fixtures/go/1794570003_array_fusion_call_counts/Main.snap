// Data/Semiring/semiring.go
package semiring

func Add(argument0 int32, argument1 int32) int32 {
	return argument0 + argument1
}

// main.go
package main

import (
	"fixture/Data/Semiring"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type MainResult struct {
	EarlyExit             bool
	EarlyExitMappingCalls int32
	Fused                 int32
	FusedMappingCalls     int32
	KeptLength            int32
	PredicateCalls        int32
	Shared                int32
	SharedMappingCalls    int32
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

var main_ = initializeMain_()

func initializeMain_() MainResult {
	value := &Ref[int32]{Value: 0}
	value2 := &Ref[int32]{Value: 0}
	value3 := &Ref[int32]{Value: 0}
	value4 := &Ref[int32]{Value: 0}
	value5 := &Ref[bool]{Value: false}
	var accumulator int32 = 0
	for _, x := range numbers {
		s2 := value.Value
		s_2 := s2 + 1
		modified := StateValue{State: s_2, Value: s_2}
		value.Value = modified.State
		performed2 := x > 2
		if performed2 {
			s4 := value2.Value
			s_4 := s4 + 1
			modified2 := StateValue{State: s_4, Value: s_4}
			value2.Value = modified2.State
			performed3 := prim.MultiplyInt32(x, 3)
			accumulated := accumulator
			accumulator = semiring.Add(accumulated, performed3)
		}
	}
	value3.Value = accumulator
	value6 := value.Value
	calls2 := value2.Value
	modified3 := StateValue{State: 0, Value: calls2}
	value2.Value = modified3.State
	value7 := modified3.Value
	mapped := make([]int32, len(numbers))
	for index, x2 := range numbers {
		s6 := value2.Value
		s_6 := s6 + 1
		modified4 := StateValue{State: s_6, Value: s_6}
		value2.Value = modified4.State
		performed4 := prim.MultiplyInt32(x2, 3)
		mapped[index] = performed4
	}
	tripled := mapped
	var accumulator2 int32 = 0
	for _, element := range tripled {
		accumulated2 := accumulator2
		accumulator2 = semiring.Add(accumulated2, element)
	}
	value4.Value = accumulator2 + int32(len(tripled))
	calls4 := value2.Value
	modified5 := StateValue{State: 0, Value: calls4}
	value2.Value = modified5.State
	value8 := modified5.Value
	found := false
	for _, x3 := range numbers {
		s8 := value2.Value
		s_8 := s8 + 1
		modified6 := StateValue{State: s_8, Value: s_8}
		value2.Value = modified6.State
		performed5 := prim.MultiplyInt32(x3, 3)
		value9 := performed5
		if value9 > 20 {
			found = true
			break
		}
	}
	value5.Value = found
	value10 := value2.Value
	value11 := value3.Value
	value12 := value4.Value
	value13 := value5.Value
	var count int32 = 0
	for _, value14 := range numbers {
		value15 := prim.MultiplyInt32(value14, 3)
		if value15 > 10 {
			count = count + 1
		}
	}
	performed := MainResult{Fused: value11, Shared: value12, EarlyExit: value13, PredicateCalls: value6, FusedMappingCalls: value7, SharedMappingCalls: value8, EarlyExitMappingCalls: value10, KeptLength: count}
	return performed
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	fmt.Println(main_)
}
