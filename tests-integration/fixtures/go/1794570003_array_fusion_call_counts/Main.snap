// main.go
package main

import shared2 "fixture/shared"

var main_ = initializeMain_()

func initializeMain_() shared2.MainResult {
	predicates := 0
	mappings := 0
	fused := 0
	shared := 0
	earlyExit := false
	kept := []int{}
	for _, x := range numbers {
		predicates += 1
		performed2 := x > 2
		if performed2 {
			kept = append(kept, x)
		}
	}
	mapped := make([]int, len(kept))
	for index, x := range kept {
		mappings += 1
		performed2 := x * 3
		mapped[index] = performed2
	}
	accumulator := 0
	for _, value := range mapped {
		accumulator += value
	}
	fused = accumulator
	predicateCalls := predicates
	modified := shared2.StateValue{State: 0, Value: mappings}
	mappings = modified.State
	fusedMappingCalls := modified.Value
	mapped2 := make([]int, len(numbers))
	for index, x := range numbers {
		mappings += 1
		performed2 := x * 3
		mapped2[index] = performed2
	}
	accumulator2 := 0
	for _, value := range mapped2 {
		accumulator2 += value
	}
	shared = accumulator2 + len(mapped2)
	modified2 := shared2.StateValue{State: 0, Value: mappings}
	mappings = modified2.State
	sharedMappingCalls := modified2.Value
	mapped3 := make([]int, len(numbers))
	for index, x := range numbers {
		mappings += 1
		performed2 := x * 3
		mapped3[index] = performed2
	}
	found := false
	for _, value := range mapped3 {
		if value > 20 {
			found = true
			break
		}
	}
	earlyExit = found
	earlyExitMappingCalls := mappings
	i := fused
	i2 := shared
	boolean := earlyExit
	f := func(value int) shared2.MainResult {
		return shared2.MainResult{Fused: i, Shared: i2, EarlyExit: boolean, PredicateCalls: predicateCalls, FusedMappingCalls: fusedMappingCalls, SharedMappingCalls: sharedMappingCalls, EarlyExitMappingCalls: earlyExitMappingCalls, KeptLength: value}
	}
	accumulator3 := 0
	for _, value := range numbers {
		value2 := value * 3
		var result int
		if value2 > 10 {
			result = 1
		} else {
			result = 0
		}
		accumulator3 += result
	}
	performed := f(accumulator3)
	return performed
}

var numbers []int = []int{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	EarlyExitMappingCalls int
	Fused                 int
	FusedMappingCalls     int
	KeptLength            int
	PredicateCalls        int
	Shared                int
	SharedMappingCalls    int
	EarlyExit             bool
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}

// note: the entry's value of type { earlyExit, earlyExitMappingCalls, fused, fusedMappingCalls, keptLength, predicateCalls, shared, sharedMappingCalls } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
