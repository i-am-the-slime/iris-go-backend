// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	var ref int32 = 0
	var ref2 int32 = 0
	var ref3 int32 = 0
	var ref4 int32 = 0
	ref5 := false
	var accumulator int32 = 0
	for _, x := range numbers {
		s_ := ref + 1
		ref = s_
		performed2 := x > 2
		if performed2 {
			s_2 := ref2 + 1
			ref2 = s_2
			performed3 := x * 3
			accumulator = accumulator + performed3
		}
	}
	ref3 = accumulator
	i := ref
	modified := shared.StateValue{State: 0, Value: ref2}
	ref2 = modified.State
	i2 := modified.Value
	mapped := make([]int32, len(numbers))
	for index, x := range numbers {
		s_ := ref2 + 1
		ref2 = s_
		performed2 := x * 3
		mapped[index] = performed2
	}
	ref4 = foldLanes(mapped, 0) + int32(len(mapped))
	modified2 := shared.StateValue{State: 0, Value: ref2}
	ref2 = modified2.State
	i3 := modified2.Value
	found := false
	for _, x := range numbers {
		s_ := ref2 + 1
		ref2 = s_
		performed2 := x * 3
		if performed2 > 20 {
			found = true
			break
		}
	}
	ref5 = found
	i4 := ref2
	i5 := ref3
	i6 := ref4
	boolean := ref5
	f := func(value int32) shared.MainResult {
		return shared.MainResult{Fused: i5, Shared: i6, EarlyExit: boolean, PredicateCalls: i, FusedMappingCalls: i2, SharedMappingCalls: i3, EarlyExitMappingCalls: i4, KeptLength: value}
	}
	var count int32 = 0
	for _, value := range numbers {
		value2 := value * 3
		if value2 > 10 {
			count = count + 1
		}
	}
	performed := f(count)
	return performed
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	fmt.Println(main_)
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := archsimd.BroadcastInt32x4(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 4
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt32x4(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt32x4(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt32x4(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt32x4(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [4]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int32, initial int32) int32 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// shared/shared.go
package shared

type MainResult struct {
	EarlyExitMappingCalls int32
	Fused                 int32
	FusedMappingCalls     int32
	KeptLength            int32
	PredicateCalls        int32
	Shared                int32
	SharedMappingCalls    int32
	EarlyExit             bool
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
