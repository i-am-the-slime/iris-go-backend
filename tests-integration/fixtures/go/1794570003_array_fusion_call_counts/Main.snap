// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	var ref int32 = 0
	var ref2 int32 = 0
	var ref3 int32 = 0
	var ref4 int32 = 0
	ref5 := false
	var accumulator int32 = 0
	for _, x := range numbers {
		s_ := ref + 1
		modified := shared.StateValue{State: s_, Value: s_}
		ref = modified.State
		performed2 := x > 2
		if performed2 {
			s_2 := ref2 + 1
			modified2 := shared.StateValue{State: s_2, Value: s_2}
			ref2 = modified2.State
			performed3 := prim.MultiplyInt32(x, 3)
			accumulator = accumulator + performed3
		}
	}
	ref3 = accumulator
	modified3 := shared.StateValue{State: 0, Value: ref2}
	ref2 = modified3.State
	i := modified3.Value
	mapped := make([]int32, len(numbers))
	for index, x := range numbers {
		s_ := ref2 + 1
		modified := shared.StateValue{State: s_, Value: s_}
		ref2 = modified.State
		performed2 := prim.MultiplyInt32(x, 3)
		mapped[index] = performed2
	}
	tripled := mapped
	var accumulator2 int32 = 0
	for _, value := range tripled {
		accumulator2 = accumulator2 + value
	}
	ref4 = accumulator2 + int32(len(tripled))
	modified4 := shared.StateValue{State: 0, Value: ref2}
	ref2 = modified4.State
	i2 := modified4.Value
	found := false
	for _, x := range numbers {
		s_ := ref2 + 1
		modified := shared.StateValue{State: s_, Value: s_}
		ref2 = modified.State
		performed2 := prim.MultiplyInt32(x, 3)
		if performed2 > 20 {
			found = true
			break
		}
	}
	ref5 = found
	var count int32 = 0
	for _, value := range numbers {
		value2 := prim.MultiplyInt32(value, 3)
		if value2 > 10 {
			count = count + 1
		}
	}
	performed := shared.MainResult{Fused: ref3, Shared: ref4, EarlyExit: ref5, PredicateCalls: ref, FusedMappingCalls: i, SharedMappingCalls: i2, EarlyExitMappingCalls: ref2, KeptLength: count}
	return performed
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	EarlyExitMappingCalls int32
	Fused                 int32
	FusedMappingCalls     int32
	KeptLength            int32
	PredicateCalls        int32
	Shared                int32
	SharedMappingCalls    int32
	EarlyExit             bool
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
