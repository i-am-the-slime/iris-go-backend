// main.go
package main

import shared2 "fixture/shared"

var main_ = initializeMain_()

func initializeMain_() shared2.MainResult {
	var counter int32 = 0
	var counter2 int32 = 0
	var fused int32 = 0
	var shared int32 = 0
	earlyExit := false
	kept := []int32{}
	for _, x := range numbers {
		counter += 1
		performed2 := x > 2
		if performed2 {
			kept = append(kept, x)
		}
	}
	mapped := make([]int32, len(kept))
	for index, x := range kept {
		counter2 += 1
		performed2 := x * 3
		mapped[index] = performed2
	}
	fused = foldLanes(mapped, 0)
	predicateCalls := counter
	modified := shared2.StateValue{State: 0, Value: counter2}
	counter2 = modified.State
	fusedMappingCalls := modified.Value
	mapped2 := make([]int32, len(numbers))
	for index, x := range numbers {
		counter2 += 1
		performed2 := x * 3
		mapped2[index] = performed2
	}
	shared = foldLanes(mapped2, 0) + int32(len(mapped2))
	modified2 := shared2.StateValue{State: 0, Value: counter2}
	counter2 = modified2.State
	sharedMappingCalls := modified2.Value
	mapped3 := make([]int32, len(numbers))
	for index, x := range numbers {
		counter2 += 1
		performed2 := x * 3
		mapped3[index] = performed2
	}
	found := false
	for _, value := range mapped3 {
		if value > 20 {
			found = true
			break
		}
	}
	earlyExit = found
	earlyExitMappingCalls := counter2
	i := fused
	i2 := shared
	boolean := earlyExit
	f := func(value int32) shared2.MainResult {
		return shared2.MainResult{Fused: i, Shared: i2, EarlyExit: boolean, PredicateCalls: predicateCalls, FusedMappingCalls: fusedMappingCalls, SharedMappingCalls: sharedMappingCalls, EarlyExitMappingCalls: earlyExitMappingCalls, KeptLength: value}
	}
	var count int32 = 0
	for _, value := range numbers {
		value2 := value * 3
		if value2 > 10 {
			count += 1
		}
	}
	performed := f(count)
	return performed
}

var numbers []int32 = []int32{3, 1, 4, 1, 5, 9, 2, 6}

func main() {
	_ = main_
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := archsimd.BroadcastInt32x4(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 4
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt32x4(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt32x4(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt32x4(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt32x4(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [4]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int32, initial int32) int32 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// shared/shared.go
package shared

type MainResult struct {
	EarlyExitMappingCalls int32
	Fused                 int32
	FusedMappingCalls     int32
	KeptLength            int32
	PredicateCalls        int32
	Shared                int32
	SharedMappingCalls    int32
	EarlyExit             bool
}

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

// note: the entry's value of type { earlyExit, earlyExitMappingCalls, fused, fusedMappingCalls, keptLength, predicateCalls, shared, sharedMappingCalls } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
