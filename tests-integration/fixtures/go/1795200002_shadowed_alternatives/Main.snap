// Data/Either/either.go
package either

import (
	"fixture/Data/Maybe"
	"fixture/Data/Ordering"
)

type EitherMaybeBoolean struct {
	Right int32
	Tag   uint8
	Left  maybe.Boolean
}

const (
	EitherMaybeBooleanLeft = iota
	EitherMaybeBooleanRight
)

type EitherInt struct {
	Left  int32
	Right ordering.BV
	Tag   uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

func Right(right ordering.BV) EitherInt {
	return EitherInt{Tag: EitherIntRight, Right: right}
}

// Data/Maybe/maybe.go
package maybe

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

type BV struct {
	V int32
	B Ordering
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Ordering"
	"os"
)

func main_() int32 {
	var scrutineeTag uint8 = either.EitherMaybeBooleanLeft
	var result bool
	switch scrutineeTag {
	case either.EitherMaybeBooleanLeft:
		result = false
	default:
		result = false
	}
	var first int32
	if result {
		first = 1
	} else {
		first = 0
	}
	scrutinee := either.Right(ordering.BV{B: ordering.OrderingEQ, V: 1000})
	var result2 int32
	switch scrutinee.Tag {
	case either.EitherIntRight:
		result2 = scrutinee.Right.V
	default:
		result2 = 3
	}
	return first + 3 + result2
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}
