// Data/Either/either.go
package either

import (
	"fixture/Data/Maybe"
	"fixture/Data/Ordering"
)

type EitherMaybeBooleanInt struct {
	Right int32
	Tag   uint8
	Left  maybe.Boolean
}

const (
	EitherMaybeBooleanIntLeft = iota
	EitherMaybeBooleanIntRight
)

type EitherIntBV struct {
	Left  int32
	Right ordering.BV
	Tag   uint8
}

const (
	EitherIntBVLeft = iota
	EitherIntBVRight
)

// Data/Maybe/maybe.go
package maybe

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

type BV struct {
	V int32
	B Ordering
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
	"fixture/Data/Ordering"
	"os"
)

func main_() int32 {
	scrutinee := either.EitherMaybeBooleanInt{Tag: either.EitherMaybeBooleanIntLeft, Left: maybe.NoBoolean}
	var result bool
	switch scrutinee.Tag {
	case either.EitherMaybeBooleanIntLeft:
		result = false
	default:
		result = false
	}
	var first int32
	if result {
		first = 1
	} else {
		first = 0
	}
	scrutinee2 := either.EitherIntBV{Tag: either.EitherIntBVRight, Right: ordering.BV{B: ordering.OrderingEQ, V: 1000}}
	var result2 int32
	switch scrutinee2.Tag {
	case either.EitherIntBVRight:
		result2 = scrutinee2.Right.V
	default:
		result2 = 3
	}
	return first + 3 + result2
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}
