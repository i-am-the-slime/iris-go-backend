// Data/Either/either.go
package either

import "fixture/Data/Maybe"

type Either struct {
	Right int32
	Tag   uint8
	Left  maybe.Boolean
}

const (
	EitherLeft = iota
	EitherRight
)

// Data/Maybe/maybe.go
package maybe

type Boolean uint8

const (
	False Boolean = iota
	True
	NoBoolean
)

// main.go
package main

import (
	"fixture/Data/Either"
	"os"
)

func main_() int32 {
	var scrutineeTag uint8 = either.EitherLeft
	var result bool
	switch scrutineeTag {
	case either.EitherLeft:
		result = false
	default:
		result = false
	}
	var first int32
	if result {
		first = 1
	} else {
		first = 0
	}
	return first + 1003
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}
