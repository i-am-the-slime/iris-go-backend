// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type RetryStatus struct {
	CumulativeDelay float64
	IterNumber      int
}

func main_() []string {
	attempts := &shared.Ref[int]{Value: 0}
	recovered := mainGoStatus(attempts, 0.0, 0)
	exhausted := mainGoStatus2(0.0, 0)
	delayed := mainGoStatus3(0.0, 0)
	return []string{"stopped after " + strconv.Itoa(recovered.IterNumber) + " retries, waiting " + prim.ShowNumber(recovered.CumulativeDelay), "stopped after " + strconv.Itoa(exhausted.IterNumber) + " retries, waiting " + prim.ShowNumber(exhausted.CumulativeDelay), "stopped after " + strconv.Itoa(delayed.IterNumber) + " retries, waiting " + prim.ShowNumber(delayed.CumulativeDelay)}
}

func mainGoStatus(attempts *shared.Ref[int], cumulativeDelay float64, iterNumber int) RetryStatus {
	attemptsValue := attempts.Value
	for {
		status := RetryStatus{CumulativeDelay: cumulativeDelay, IterNumber: iterNumber}
		s_ := attemptsValue + 1
		attemptsValue = s_
		if s_ >= 3 {
			attempts.Value = attemptsValue
			return status
		}
		if status.IterNumber >= 5 {
			attempts.Value = attemptsValue
			return status
		}
		cumulativeDelay, iterNumber = status.CumulativeDelay+50.0, status.IterNumber+1
	}
}

func mainGoStatus2(cumulativeDelay float64, iterNumber int) RetryStatus {
	for {
		status := RetryStatus{CumulativeDelay: cumulativeDelay, IterNumber: iterNumber}
		if status.IterNumber >= 2 {
			return status
		}
		cumulativeDelay, iterNumber = status.CumulativeDelay+0.0, status.IterNumber+1
	}
}

func mainGoStatus3(cumulativeDelay float64, iterNumber int) RetryStatus {
	for {
		status := RetryStatus{CumulativeDelay: cumulativeDelay, IterNumber: iterNumber}
		if status.IterNumber >= 4 {
			return status
		}
		cumulativeDelay, iterNumber = status.CumulativeDelay+10.0, status.IterNumber+1
	}
}

func main() {
	main_()
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
