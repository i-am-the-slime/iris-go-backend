// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type RetryStatus struct {
	CumulativeDelay float64
	IterNumber      int32
}

func main_() []string {
	attempts := &shared.Ref[int32]{Value: 0}
	recovered := mainGo(attempts, RetryStatus{IterNumber: 0, CumulativeDelay: 0.0})
	exhausted := mainGo2(RetryStatus{IterNumber: 0, CumulativeDelay: 0.0})
	delayed := mainGo3(RetryStatus{IterNumber: 0, CumulativeDelay: 0.0})
	return []string{"stopped after " + strconv.Itoa(int(recovered.IterNumber)) + " retries, waiting " + prim.ShowNumber(recovered.CumulativeDelay), "stopped after " + strconv.Itoa(int(exhausted.IterNumber)) + " retries, waiting " + prim.ShowNumber(exhausted.CumulativeDelay), "stopped after " + strconv.Itoa(int(delayed.IterNumber)) + " retries, waiting " + prim.ShowNumber(delayed.CumulativeDelay)}
}

func mainGo(attempts *shared.Ref[int32], status RetryStatus) RetryStatus {
	attemptsValue := attempts.Value
	for {
		cumulativeDelay := status.CumulativeDelay
		iterNumber := status.IterNumber
		s := attemptsValue
		s_ := s + 1
		attemptsValue = s_
		if s_ >= 3 {
			attempts.Value = attemptsValue
			return status
		}
		if status.IterNumber >= 5 {
			attempts.Value = attemptsValue
			return status
		}
		status = RetryStatus{IterNumber: iterNumber + 1, CumulativeDelay: cumulativeDelay + 50.0}
	}
}

func mainGo2(status RetryStatus) RetryStatus {
	for {
		cumulativeDelay := status.CumulativeDelay
		iterNumber := status.IterNumber
		if status.IterNumber >= 2 {
			return status
		}
		status = RetryStatus{IterNumber: iterNumber + 1, CumulativeDelay: cumulativeDelay + 0.0}
	}
}

func mainGo3(status RetryStatus) RetryStatus {
	for {
		cumulativeDelay := status.CumulativeDelay
		iterNumber := status.IterNumber
		if status.IterNumber >= 4 {
			return status
		}
		status = RetryStatus{IterNumber: iterNumber + 1, CumulativeDelay: cumulativeDelay + 10.0}
	}
}

func main() {
	main_()
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}
