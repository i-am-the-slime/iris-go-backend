// Data/List/Types/types.go
package types

type List struct {
	Cons1 *List
	Cons0 int32
}

var SharedListNil = &List{}

// main.go
package main

import (
	list "fixture/Data/List/Types"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"os"
)

type Shape struct {
	Leaf    *list.List
	Branch0 *Shape
	Branch1 shared.FlagsItems
	Branch2 *Shape
	Wrap    *Shape
	Tag     uint8
}

const (
	ShapeLeaf = iota
	ShapeBranch
	ShapeWrap
)

func Leaf(leaf *list.List) *Shape {
	return &Shape{Tag: ShapeLeaf, Leaf: leaf}
}

func main_() int32 {
	accumulator := list.SharedListNil
	var listIntCells alloc.Cells[list.List]
	for index := len([]int32{}) - 1; index >= 0; index-- {
		i := []int32{}[index]
		accumulator = listIntCells.New(list.List{Cons0: i, Cons1: accumulator})
	}
	var result2 *Shape
	if accumulator != list.SharedListNil {
		accumulator2 := list.SharedListNil
		var listIntCells2 alloc.Cells[list.List]
		for index := len([]int32{}) - 1; index >= 0; index-- {
			i := []int32{}[index]
			accumulator2 = listIntCells2.New(list.List{Cons0: i, Cons1: accumulator2})
		}
		result2 = Leaf(accumulator2)
	} else {
		array := []int32{1}
		accumulator2 := list.SharedListNil
		var listIntCells3 alloc.Cells[list.List]
		for index := len(array) - 1; index >= 0; index-- {
			i := array[index]
			accumulator2 = listIntCells3.New(list.List{Cons0: i, Cons1: accumulator2})
		}
		result2 = Leaf(accumulator2)
	}
	var result int32
	if result2.Tag == ShapeLeaf && result2.Leaf != list.SharedListNil {
		result = result2.Leaf.Cons0
	} else {
		result = 0
	}
	return result
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type FlagsItems struct {
	Flags []struct{}
	Items int32
}
