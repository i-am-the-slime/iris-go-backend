// Data/List/Types/types.go
package types

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
}

var SharedListIntNil = &ListInt{}

// main.go
package main

import (
	list "fixture/Data/List/Types"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"os"
)

type Shape struct {
	Leaf    *list.ListInt
	Branch0 *Shape
	Branch1 shared.FlagsItems
	Branch2 *Shape
	Wrap    *Shape
	Tag     uint8
}

const (
	ShapeLeaf = iota
	ShapeBranch
	ShapeWrap
)

func main_() int32 {
	accumulator := list.SharedListIntNil
	var listIntCells alloc.Cells[list.ListInt]
	for index := len([]int32{}) - 1; index >= 0; index-- {
		i := []int32{}[index]
		accumulator = listIntCells.New(list.ListInt{Cons0: i, Cons1: accumulator})
	}
	scrutinee := &Shape{Tag: ShapeLeaf, Leaf: accumulator}
	var result2 *Shape
	if scrutinee.Tag == ShapeBranch && scrutinee.Branch0.Tag == ShapeWrap && scrutinee.Branch2.Tag == ShapeBranch {
		accumulator2 := list.SharedListIntNil
		var listIntCells2 alloc.Cells[list.ListInt]
		for index := len([]int32{}) - 1; index >= 0; index-- {
			i := []int32{}[index]
			accumulator2 = listIntCells2.New(list.ListInt{Cons0: i, Cons1: accumulator2})
		}
		*scrutinee = Shape{Tag: ShapeLeaf, Leaf: accumulator2}
		result2 = scrutinee
	} else if scrutinee.Tag == ShapeLeaf && scrutinee.Leaf != list.SharedListIntNil {
		accumulator2 := list.SharedListIntNil
		var listIntCells3 alloc.Cells[list.ListInt]
		for index := len([]int32{}) - 1; index >= 0; index-- {
			i := []int32{}[index]
			accumulator2 = listIntCells3.New(list.ListInt{Cons0: i, Cons1: accumulator2})
		}
		scrutinee.Leaf = accumulator2
		result2 = scrutinee
	} else {
		array := []int32{1}
		accumulator2 := list.SharedListIntNil
		var listIntCells4 alloc.Cells[list.ListInt]
		for index := len(array) - 1; index >= 0; index-- {
			i := array[index]
			accumulator2 = listIntCells4.New(list.ListInt{Cons0: i, Cons1: accumulator2})
		}
		result2 = &Shape{Tag: ShapeLeaf, Leaf: accumulator2}
	}
	var result int32
	if result2.Tag == ShapeLeaf && result2.Leaf != list.SharedListIntNil {
		result = result2.Leaf.Cons0
	} else {
		result = 0
	}
	return result
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type FlagsItems struct {
	Flags []struct{}
	Items int32
}
