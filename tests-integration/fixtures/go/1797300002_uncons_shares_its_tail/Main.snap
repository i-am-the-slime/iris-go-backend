// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"os"
)

func main_() int {
	return summed(0, []int{1, 2, 3}) + len(array.Tail([]int{4, 5})) + 399
}

func summed(total int, remaining []int) int {
	for {
		if len(remaining) == 0 {
			return total
		}
		total, remaining = total+remaining[0], array.Tail(remaining)
	}
}

func main() {
	os.Exit(main_())
}
