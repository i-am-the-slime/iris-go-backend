// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"os"
)

func main_() int32 {
	numbers := []int32{4, 5}
	numbers2 := []int32{}
	var result int32
	if len(numbers) == 0 {
		result = -1
	} else {
		result = numbers[0]*100 + int32(len(array.Tail(numbers)))
	}
	var result2 int32
	if len(numbers2) == 0 {
		result2 = -1
	} else {
		result2 = numbers2[0]*100 + int32(len(array.Tail(numbers2)))
	}
	return summed(0, []int32{1, 2, 3}) + result + result2
}

func summed(total int32, remaining []int32) int32 {
	for {
		if len(remaining) == 0 {
			return total
		}
		total, remaining = total+remaining[0], array.Tail(remaining)
	}
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}
