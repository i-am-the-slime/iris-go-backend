// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"os"
)

func main_() int {
	numbers := []int{4, 5}
	numbers2 := []int{}
	var result int
	if len(numbers) == 0 {
		result = -1
	} else {
		result = numbers[0]*100 + len(array.Tail(numbers))
	}
	var result2 int
	if len(numbers2) == 0 {
		result2 = -1
	} else {
		result2 = numbers2[0]*100 + len(array.Tail(numbers2))
	}
	return summed(0, []int{1, 2, 3}) + result + result2
}

func summed(total int, remaining []int) int {
	for {
		if len(remaining) == 0 {
			return total
		}
		total, remaining = total+remaining[0], array.Tail(remaining)
	}
}

func main() {
	os.Exit(main_())
}
