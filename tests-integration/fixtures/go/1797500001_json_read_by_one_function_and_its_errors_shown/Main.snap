func ShowNonEmptyListForeignError(errors NonEmptyListForeignError) string {
	shown := []string{Show(errors.First)}
	cell := errors.Second
	for {
		if cell == SharedListForeignErrorNil {
			break
		}
		shown = append(shown, Show(cell.Cons0))
		cell = cell.Cons1
	}
	return foreignvalue.ShowErrors(shown)
}

