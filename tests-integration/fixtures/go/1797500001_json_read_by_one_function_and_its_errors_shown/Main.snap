// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type Either struct {
	Left  exception.Error
	Right any
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Left(left exception.Error) Either {
	return Either{Tag: EitherLeft, Left: left}
}

// Data/Monoid/monoid.go
package monoid

var Mempty []string = []string{}

// Foreign/foreign.go
package foreign

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type ForeignError struct {
	Field0           string
	Field1           string
	ErrorAtIndex1    *ForeignError
	ErrorAtProperty0 string
	ErrorAtProperty1 *ForeignError
	ErrorAtIndex0    int
	Tag              uint8
}

const (
	ForeignErrorForeignError2 = iota
	ForeignErrorTypeMismatch
	ForeignErrorErrorAtIndex
	ForeignErrorErrorAtProperty
)

type ListForeignError struct {
	Cons0 *ForeignError
	Cons1 *ListForeignError
}

var SharedListForeignErrorNil = &ListForeignError{}

type NonEmpty struct {
	First  *ForeignError
	Second *ListForeignError
}

type EitherTodo struct {
	Left  NonEmpty
	Right shared.Todo
	Tag   uint8
}

const (
	EitherTodoLeft = iota
	EitherTodoRight
)

func ShowNonEmptyListForeignError(errors NonEmpty) string {
	shown := []string{Show(errors.First)}
	cell := errors.Second
	for {
		if cell == SharedListForeignErrorNil {
			break
		}
		shown = append(shown, Show(cell.Cons0))
		cell = cell.Cons1
	}
	return foreignvalue.ShowErrors(shown)
}

type EitherForeign struct {
	Left  NonEmpty
	Right any
	Tag   uint8
}

const (
	EitherForeignLeft = iota
	EitherForeignRight
)

type EitherFnEmptyTitle struct {
	Left  NonEmpty
	Right func(shared.Empty) shared.Title
	Tag   uint8
}

const (
	EitherFnEmptyTitleLeft = iota
	EitherFnEmptyTitleRight
)

type EitherArrayString struct {
	Left  NonEmpty
	Right []string
	Tag   uint8
}

const (
	EitherArrayStringLeft = iota
	EitherArrayStringRight
)

type EitherString struct {
	Left  NonEmpty
	Right string
	Tag   uint8
}

const (
	EitherStringLeft = iota
	EitherStringRight
)

type EitherFnEmptyTagsTitle struct {
	Left  NonEmpty
	Right func(shared.Empty) shared.TagsTitle
	Tag   uint8
}

const (
	EitherFnEmptyTagsTitleLeft = iota
	EitherFnEmptyTagsTitleRight
)

type ListListForeignError struct {
	Cons0 *ListForeignError
	Cons1 *ListListForeignError
}

var SharedListListForeignErrorNil = &ListListForeignError{}

type NonEmptyFailure struct {
	Failed bool
	Left   NonEmpty
}

func ForeignErrorForeignError(field0 string) *ForeignError {
	return &ForeignError{Tag: ForeignErrorForeignError2, Field0: field0}
}

func TypeMismatch(field0 string, field1 string) *ForeignError {
	return &ForeignError{Tag: ForeignErrorTypeMismatch, Field0: field0, Field1: field1}
}

func LeftEitherForeign(left NonEmpty) EitherForeign {
	return EitherForeign{Tag: EitherForeignLeft, Left: left}
}

func Cons(cons0 *ForeignError, cons1 *ListForeignError) *ListForeignError {
	return &ListForeignError{Cons0: cons0, Cons1: cons1}
}

func ErrorAtIndex(errorAtIndex0 int, errorAtIndex1 *ForeignError) *ForeignError {
	return &ForeignError{Tag: ForeignErrorErrorAtIndex, ErrorAtIndex0: errorAtIndex0, ErrorAtIndex1: errorAtIndex1}
}

func ErrorAtProperty(errorAtProperty0 string, errorAtProperty1 *ForeignError) *ForeignError {
	return &ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: errorAtProperty0, ErrorAtProperty1: errorAtProperty1}
}

func LeftEitherString(left NonEmpty) EitherString {
	return EitherString{Tag: EitherStringLeft, Left: left}
}

func Right(right string) EitherString {
	return EitherString{Tag: EitherStringRight, Right: right}
}

func Show(foreignError *ForeignError) string {
	return string(AppendShow(nil, foreignError))
}

func Pure(x any) EitherForeign {
	return EitherForeign{Tag: EitherForeignRight, Right: x}
}

func MapFunction(i int, value NonEmpty) NonEmpty {
	return NonEmpty{First: ErrorAtIndex(i, value.First), Second: MapFunctionChunkedRevMap(i, SharedListListForeignErrorNil, value.Second)}
}

func MapFunction2(s string, value NonEmpty) NonEmpty {
	return NonEmpty{First: ErrorAtProperty(s, value.First), Second: MapFunctionChunkedRevMap2(s, SharedListListForeignErrorNil, value.Second)}
}

func MapFunctionChunkedRevMap(i int, chunksAcc *ListListForeignError, chunk *ListForeignError) *ListForeignError {
	var listListForeignErrorCells alloc.Cells[ListListForeignError]
	for {
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 != SharedListForeignErrorNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListForeignErrorCells.New(ListListForeignError{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *ListForeignError
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 == SharedListForeignErrorNil {
			result = Cons(ErrorAtIndex(i, chunk.Cons0), Cons(ErrorAtIndex(i, chunk.Cons1.Cons0), SharedListForeignErrorNil))
		} else if chunk != SharedListForeignErrorNil && chunk.Cons1 == SharedListForeignErrorNil {
			result = Cons(ErrorAtIndex(i, chunk.Cons0), SharedListForeignErrorNil)
		} else {
			result = SharedListForeignErrorNil
		}
		return MapFunctionChunkedRevMapReverseUnrolledMap(i, chunksAcc, result)
	}
}

func MapFunctionChunkedRevMapReverseUnrolledMap(i int, list *ListListForeignError, acc *ListForeignError) *ListForeignError {
	var foreignErrorCells alloc.Cells[ForeignError]
	var listForeignErrorCells alloc.Cells[ListForeignError]
	for {
		if list != SharedListListForeignErrorNil && list.Cons0 != SharedListForeignErrorNil && list.Cons0.Cons1 != SharedListForeignErrorNil && list.Cons0.Cons1.Cons1 != SharedListForeignErrorNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtIndex, ErrorAtIndex0: i, ErrorAtIndex1: x1}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtIndex, ErrorAtIndex0: i, ErrorAtIndex1: x2}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtIndex, ErrorAtIndex0: i, ErrorAtIndex1: x3}), Cons1: acc})})})
			continue
		}
		return acc
	}
}

func MapFunctionChunkedRevMap2(s string, chunksAcc *ListListForeignError, chunk *ListForeignError) *ListForeignError {
	var listListForeignErrorCells alloc.Cells[ListListForeignError]
	for {
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 != SharedListForeignErrorNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListForeignErrorCells.New(ListListForeignError{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *ListForeignError
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 == SharedListForeignErrorNil {
			result = Cons(ErrorAtProperty(s, chunk.Cons0), Cons(ErrorAtProperty(s, chunk.Cons1.Cons0), SharedListForeignErrorNil))
		} else if chunk != SharedListForeignErrorNil && chunk.Cons1 == SharedListForeignErrorNil {
			result = Cons(ErrorAtProperty(s, chunk.Cons0), SharedListForeignErrorNil)
		} else {
			result = SharedListForeignErrorNil
		}
		return MapFunctionChunkedRevMapReverseUnrolledMap2(s, chunksAcc, result)
	}
}

func MapFunctionChunkedRevMapReverseUnrolledMap2(s string, list *ListListForeignError, acc *ListForeignError) *ListForeignError {
	var foreignErrorCells alloc.Cells[ForeignError]
	var listForeignErrorCells alloc.Cells[ListForeignError]
	for {
		if list != SharedListListForeignErrorNil && list.Cons0 != SharedListForeignErrorNil && list.Cons0.Cons1 != SharedListForeignErrorNil && list.Cons0.Cons1.Cons1 != SharedListForeignErrorNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x1}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x2}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x3}), Cons1: acc})})})
			continue
		}
		return acc
	}
}

func AppendShow(buffer []byte, foreignError *ForeignError) []byte {
	switch foreignError.Tag {
	case ForeignErrorForeignError2:
		buffer = append(buffer, "(ForeignError "...)
		buffer = prim.AppendShowString(buffer, foreignError.Field0)
		buffer = append(buffer, ')')
	case ForeignErrorErrorAtIndex:
		buffer = append(buffer, "(ErrorAtIndex "...)
		buffer = strconv.AppendInt(buffer, int64(foreignError.ErrorAtIndex0), 10)
		buffer = append(buffer, ' ')
		buffer = AppendShow(buffer, foreignError.ErrorAtIndex1)
		buffer = append(buffer, ')')
	case ForeignErrorErrorAtProperty:
		buffer = append(buffer, "(ErrorAtProperty "...)
		buffer = prim.AppendShowString(buffer, foreignError.ErrorAtProperty0)
		buffer = append(buffer, ' ')
		buffer = AppendShow(buffer, foreignError.ErrorAtProperty1)
		buffer = append(buffer, ')')
	default: // ForeignErrorTypeMismatch
		buffer = append(buffer, "(TypeMismatch "...)
		buffer = prim.AppendShowString(buffer, foreignError.Field0)
		buffer = append(buffer, ' ')
		buffer = prim.AppendShowString(buffer, foreignError.Field1)
		buffer = append(buffer, ')')
	}
	return buffer
}

func EitherStringFromResults(value string, err NonEmptyFailure) EitherString {
	if err.Failed {
		return LeftEitherString(err.Left)
	}
	return Right(value)
}

// Yoga/JSON/json.go
package json

import (
	"fixture/Data/Either"
	"fixture/Data/Monoid"
	"fixture/Foreign"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"slices"
)

func DecodeJSONArrayString(d *foreignvalue.Decoder) []string {
	items := []string{}
	if d.Array() {
		for {
			items = append(items, d.String())
			if !d.MoreElements() {
				break
			}
		}
	}
	return slices.Clip(items)
}

func DecodeJSONTodo(d *foreignvalue.Decoder) shared.Todo {
	var done bool
	hasDone := false
	var tags []string
	hasTags := false
	var title string
	hasTitle := false
	if d.Object() {
		for {
			switch d.Key() {
			case "done":
				done = d.Boolean()
				hasDone = true
			case "tags":
				tags = DecodeJSONArrayString(d)
				hasTags = true
			case "title":
				title = d.String()
				hasTitle = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasDone || !hasTags || !hasTitle {
		d.Fail()
	}
	return shared.Todo{Done: done, Tags: tags, Title: title}
}

func ReadJSON(text string) (shared.Todo, foreign.NonEmptyFailure) {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONTodo)
	if ok {
		return decoded, foreign.NonEmptyFailure{}
	}
	performed := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		argument := foreignvalue.ParseJSON(text)
		return either.Either{Tag: either.EitherRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherLeft:
		return shared.Todo{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherRight
		return ReadImpl(performed.Right)
	}
}

func ReadImpl(o any) (shared.Todo, foreign.NonEmptyFailure) {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "title", o)
	var f func(shared.Empty) shared.Title
	var err foreign.NonEmptyFailure
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherForeignLeft:
		err = foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction2("title", unsafeReadPropImpl.Left)}
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "String" {
			f, err = func(_ shared.Empty) shared.Title {
				return shared.Title{Title: b.(string)}
			}, foreign.NonEmptyFailure{}
		} else {
			err = foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction2("title", foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})}
		}
	}
	unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "tags", o)
	var array_ []string
	var err2 foreign.NonEmptyFailure
	switch unsafeReadPropImpl2.Tag {
	case foreign.EitherForeignLeft:
		err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction2("tags", unsafeReadPropImpl2.Left)}
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl2.Right
		if foreignvalue.IsArray(b) {
			array := b.([]any)
			array_2 := monoid.Mempty
			var err3 foreign.NonEmptyFailure
			array_2 = slices.Grow(slices.Clip(array_2), len(array))
			for index, element := range array {
				elem := foreign.EitherStringFromResults(ReadAtIdx(index, element))
				if err3.Failed && elem.Tag == foreign.EitherStringLeft {
					err3 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: err3.Left.First, Second: ReadImplGoConsBooleanConsArrayStringConsStringNilReusing(foreign.Cons(elem.Left.First, elem.Left.Second), ReadImplGoConsBooleanConsArrayStringConsStringNil(foreign.SharedListForeignErrorNil, err3.Left.Second))}}
				} else if err3.Failed && elem.Tag == foreign.EitherStringRight {
				} else if !err3.Failed && elem.Tag == foreign.EitherStringRight {
					array_2, err3 = append(array_2, elem.Right), foreign.NonEmptyFailure{}
				} else {
					err3 = foreign.NonEmptyFailure{Failed: true, Left: elem.Left}
				}
			}
			if err3.Failed {
				err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction2("tags", err3.Left)}
			} else {
				array_, err2 = array_2, foreign.NonEmptyFailure{}
			}
		} else {
			err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction2("tags", foreign.NonEmpty{First: foreign.TypeMismatch("array", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})}
		}
	}
	var f2 func(shared.Empty) shared.TagsTitle
	var err4 foreign.NonEmptyFailure
	if err2.Failed {
		field0 := err2.Left
		if err.Failed {
			err4 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: field0.First, Second: ReadImplGoConsBooleanConsArrayStringConsStringNilReusing(foreign.Cons(err.Left.First, err.Left.Second), ReadImplGoConsBooleanConsArrayStringConsStringNil(foreign.SharedListForeignErrorNil, field0.Second))}}
		} else {
			err4 = foreign.NonEmptyFailure{Failed: true, Left: field0}
		}
	} else if err.Failed {
		err4 = err
	} else {
		f2, err4 = func(x shared.Empty) shared.TagsTitle {
			return shared.TagsTitle{Title: f(x).Title, Tags: array_}
		}, foreign.NonEmptyFailure{}
	}
	unsafeReadPropImpl3 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "done", o)
	switch unsafeReadPropImpl3.Tag {
	case foreign.EitherForeignLeft:
		return ReadImplJoin(f2, err4, foreign.MapFunction2("done", unsafeReadPropImpl3.Left))
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl3.Right
		if foreignvalue.TagOf(b) == "Boolean" {
			if err4.Failed {
				return shared.Todo{}, err4
			}
			record := f2(shared.Empty{})
			return shared.Todo{Tags: record.Tags, Title: record.Title, Done: b.(bool)}, foreign.NonEmptyFailure{}
		}
		return ReadImplJoin(f2, err4, foreign.MapFunction2("done", foreign.NonEmpty{First: foreign.TypeMismatch("Boolean", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
	}
}

func ReadAtIdx(i int, f any) (string, foreign.NonEmptyFailure) {
	if foreignvalue.TagOf(f) == "String" {
		return f.(string), foreign.NonEmptyFailure{}
	}
	return "", foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction(i, foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(f)), Second: foreign.SharedListForeignErrorNil})}
}

func ReadImplGoConsBooleanConsArrayStringConsStringNil(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	var listForeignErrorCells alloc.Cells[foreign.ListForeignError]
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		acc, list = listForeignErrorCells.New(foreign.ListForeignError{Cons0: x, Cons1: acc}), xs
	}
}

func ReadImplJoin(f func(shared.Empty) shared.TagsTitle, err foreign.NonEmptyFailure, field0 foreign.NonEmpty) (shared.Todo, foreign.NonEmptyFailure) {
	if err.Failed {
		return shared.Todo{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: field0.First, Second: ReadImplGoConsBooleanConsArrayStringConsStringNilReusing(foreign.Cons(err.Left.First, err.Left.Second), ReadImplGoConsBooleanConsArrayStringConsStringNil(foreign.SharedListForeignErrorNil, field0.Second))}}
	}
	return shared.Todo{}, foreign.NonEmptyFailure{Failed: true, Left: field0}
}

func ReadImplGoConsBooleanConsArrayStringConsStringNilReusing(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// main.go
package main

import (
	"fixture/Foreign"
	"fixture/Yoga/JSON"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	todo, err := json.ReadJSON("{ \"title\": \"write docs\", \"done\": false, \"tags\": [\"iris\"] }")
	var result string
	if err.Failed {
		result = "bad: " + foreign.ShowNonEmptyListForeignError(err.Left)
	} else {
		result = todo.Title
	}
	todo2, err := json.ReadJSON("{ \"title\": 1, \"done\": \"no\", \"tags\": [\"iris\", 2] }")
	var result2 string
	if err.Failed {
		result2 = "bad: " + foreign.ShowNonEmptyListForeignError(err.Left)
	} else {
		result2 = todo2.Title
	}
	todo3, err := json.ReadJSON("{ \"done\": true }")
	var result3 string
	if err.Failed {
		result3 = "bad again: " + foreign.ShowNonEmptyListForeignError(err.Left)
	} else if todo3.Done {
		result3 = "true"
	} else {
		result3 = "false"
	}
	return []string{result, result2, result3}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Todo struct {
	Tags  []string
	Title string
	Done  bool
}

type Empty struct{}

type Title struct {
	Title string
}

type TagsTitle struct {
	Tags  []string
	Title string
}
