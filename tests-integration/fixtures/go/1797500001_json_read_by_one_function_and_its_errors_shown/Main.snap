// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type EitherErrorForeign struct {
	Left  exception.Error
	Right any
	Tag   uint8
}

const (
	EitherErrorForeignLeft = iota
	EitherErrorForeignRight
)

// Data/Monoid/monoid.go
package monoid

var MemptyString []string = []string{}

// Foreign/foreign.go
package foreign

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type ForeignError struct {
	ForeignError     string
	TypeMismatch0    string
	TypeMismatch1    string
	ErrorAtIndex1    *ForeignError
	ErrorAtProperty0 string
	ErrorAtProperty1 *ForeignError
	ErrorAtIndex0    int32
	Tag              uint8
}

const (
	ForeignErrorForeignError = iota
	ForeignErrorTypeMismatch
	ForeignErrorErrorAtIndex
	ForeignErrorErrorAtProperty
)

type ListForeignError struct {
	Cons0 *ForeignError
	Cons1 *ListForeignError
}

var SharedListForeignErrorNil = &ListForeignError{}

type NonEmptyListForeignError struct {
	First  *ForeignError
	Second *ListForeignError
}

type EitherNonEmptyListForeignErrorTodo struct {
	Left  NonEmptyListForeignError
	Right shared.Todo
	Tag   uint8
}

const (
	EitherNonEmptyListForeignErrorTodoLeft = iota
	EitherNonEmptyListForeignErrorTodoRight
)

func ShowNonEmptyListForeignError(errors NonEmptyListForeignError) string {
	shown := []string{Show(errors.First)}
	cell := errors.Second
	for {
		if cell == SharedListForeignErrorNil {
			break
		}
		shown = append(shown, Show(cell.Cons0))
		cell = cell.Cons1
	}
	return foreignvalue.ShowErrors(shown)
}

type EitherNonEmptyListForeignErrorForeign struct {
	Left  NonEmptyListForeignError
	Right any
	Tag   uint8
}

const (
	EitherNonEmptyListForeignErrorForeignLeft = iota
	EitherNonEmptyListForeignErrorForeignRight
)

type EitherNonEmptyListForeignErrorFnTagsTitleTodo struct {
	Left  NonEmptyListForeignError
	Right func(shared.TagsTitle) shared.Todo
	Tag   uint8
}

const (
	EitherNonEmptyListForeignErrorFnTagsTitleTodoLeft = iota
	EitherNonEmptyListForeignErrorFnTagsTitleTodoRight
)

type EitherNonEmptyListForeignErrorFnTitleTagsTitle struct {
	Left  NonEmptyListForeignError
	Right func(shared.Title) shared.TagsTitle
	Tag   uint8
}

const (
	EitherNonEmptyListForeignErrorFnTitleTagsTitleLeft = iota
	EitherNonEmptyListForeignErrorFnTitleTagsTitleRight
)

type EitherNonEmptyListForeignErrorArrayString struct {
	Left  NonEmptyListForeignError
	Right []string
	Tag   uint8
}

const (
	EitherNonEmptyListForeignErrorArrayStringLeft = iota
	EitherNonEmptyListForeignErrorArrayStringRight
)

type EitherNonEmptyListForeignErrorString struct {
