// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type ArrayInt struct {
	Just []int
	Tag  uint8
}

// Data/Ord/ord.go
package ord

import "fixture/Data/Ordering"

func Compare(char rune, char2 rune) ordering.Ordering {
	if char < char2 {
		return ordering.OrderingLT
	}
	if char == char2 {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"os"
	"slices"
)

func main_() int {
	prim.IntTrunc(0.5)
	direct.DeleteAt(0, []int{})
	counter := 0
	counter += 1
	sorted := slices.Clone([]rune{'b', 'a'})
	slices.Sort(sorted)
	return counter*10 + 2
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}

type Items struct {
	Items []rune
}
