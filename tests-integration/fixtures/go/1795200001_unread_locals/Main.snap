// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"os"
)

func main_() int {
	prim.IntTrunc(0.5)
	counter := 0
	counter += 1
	return counter*10 + 2
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
