// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type ArrayInt struct {
	Just []int32
	Tag  uint8
}

func JustArrayInt(just []int32) ArrayInt {
	return ArrayInt{Tag: TagJust, Just: just}
}

var NoArrayInt = ArrayInt{Tag: TagNothing}

// Data/Ord/ord.go
package ord

import "fixture/Data/Ordering"

func Compare(char rune, char2 rune) ordering.Ordering {
	if char < char2 {
		return ordering.OrderingLT
	}
	if char == char2 {
		return ordering.OrderingEQ
	}
	return ordering.OrderingGT
}

// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"os"
	"slices"
)

func main_() int32 {
	prim.IntTrunc(0.5)
	direct.DeleteAt(func(payload []int32) maybe.ArrayInt {
		return maybe.JustArrayInt(payload)
	}, maybe.NoArrayInt, 0, []int32{})
	var counter int32 = 0
	elements := []int32{10, 20}
	var result int32
	result = elements[counter]
	modified := shared.StateValue{State: counter + 1, Value: result}
	counter = modified.State
	sorted := slices.Clone([]rune{'b', 'a'})
	slices.Sort(sorted)
	return counter*10 + 2
}

func main() {
	exitStatus := main_()
	os.Exit(int(exitStatus))
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int32
	Value int32
}

type Items struct {
	Items []rune
}
