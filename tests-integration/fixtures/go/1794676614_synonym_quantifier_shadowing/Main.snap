// Control/Category/category.go
package category

func Identity(x int) int {
	return x
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Instruction struct {
	Store1 any
	Load   func(int) any
	Store0 int32
	Tag    uint8
}

const (
	InstructionStore = iota
	InstructionLoad
)

type Command struct {
	Push1  any
	Pop    func(int) any
	Origin any
	Push0  int32
	Tag    uint8
}

const (
	CommandPush = iota
	CommandPop
)

type CommandVal struct {
	Push1 any
	Pop   func(int) any
	Push0 int32
	Tag   uint8
}

const (
	CommandValPush = iota
	CommandValPop
)

func convert(value *Command) CommandVal {
	if original, ok := value.Origin.(CommandVal); ok {
		return original
	}
	switch value.Tag {
	case CommandPush:
		return CommandVal{Tag: CommandValPush, Push0: value.Push0, Push1: value.Push1}
	default: // CommandPop
		return CommandVal{Tag: CommandValPop, Pop: value.Pop}
	}
}

type FreeCommand struct {
	Pure   any
	Bind0  CommandVal
	Bind1  func(any) *FreeCommand
	Origin any
	Tag    uint8
}

const (
	FreeCommandPure = iota
	FreeCommandBind
)

func PureFreeCommand(pure any) *FreeCommand {
	return &FreeCommand{Tag: FreeCommandPure, Pure: pure}
}

type FreeCommandInt struct {
	Bind0 CommandVal
	Bind1 func(any) FreeCommandInt
	Pure  int
	Tag   uint8
}

const (
	FreeCommandIntPure = iota
	FreeCommandIntBind
)

type CommandUnit struct {
	Push1 struct{}
	Pop   func(int)
	Push0 int32
	Tag   uint8
}

const (
	CommandUnitPush = iota
	CommandUnitPop
)

func convert2(value CommandUnit) CommandVal {
	switch value.Tag {
	case CommandUnitPush:
		return CommandVal{Tag: CommandValPush, Push0: value.Push0, Push1: value.Push1}
	default: // CommandUnitPop
		return CommandVal{Tag: CommandValPop, Pop: func(coerced int) any {
			value.Pop(coerced)
			return struct{}{}
		}}
	}
}

type FreeCommandUnit struct {
	Pure  struct{}
	Bind0 CommandVal
	Bind1 func(any) FreeCommandUnit
	Tag   uint8
}

const (
	FreeCommandUnitPure = iota
	FreeCommandUnitBind
)

type InstructionVal struct {
	Store1 any
	Load   func(int) any
	Store0 int32
	Tag    uint8
}

const (
	InstructionValStore = iota
	InstructionValLoad
)

type FreeInstructionInt struct {
	Bind0 InstructionVal
	Bind1 func(any) FreeInstructionInt
	Pure  int
	Tag   uint8
}

const (
	FreeInstructionIntPure = iota
	FreeInstructionIntBind
)

type InstructionUnit struct {
	Store1 struct{}
	Load   func(int)
	Store0 int32
	Tag    uint8
}

const (
	InstructionUnitStore = iota
	InstructionUnitLoad
)

func convert3(value InstructionUnit) InstructionVal {
	switch value.Tag {
	case InstructionUnitStore:
		return InstructionVal{Tag: InstructionValStore, Store0: value.Store0, Store1: value.Store1}
	default: // InstructionUnitLoad
		return InstructionVal{Tag: InstructionValLoad, Load: func(coerced int) any {
			value.Load(coerced)
			return struct{}{}
		}}
	}
}

type FreeInstructionUnit struct {
	Pure  struct{}
	Bind0 InstructionVal
	Bind1 func(any) FreeInstructionUnit
	Tag   uint8
}

const (
	FreeInstructionUnitPure = iota
	FreeInstructionUnitBind
)

type FreeVal struct {
	Pure  any
	Bind0 CommandVal
	Bind1 func(any) FreeVal
	Tag   uint8
}

const (
	FreeValPure = iota
	FreeValBind
)

func convert4(value InstructionVal) *Instruction {
	switch value.Tag {
	case InstructionValStore:
		return &Instruction{Tag: InstructionStore, Store0: value.Store0, Store1: value.Store1}
	default: // InstructionValLoad
		return &Instruction{Tag: InstructionLoad, Load: value.Load}
	}
}

func convert5(value *FreeCommand) FreeVal {
	switch value.Tag {
	case FreeCommandPure:
		return FreeVal{Tag: FreeValPure, Pure: value.Pure}
	default: // FreeCommandBind
		original := value.Bind1
		return FreeVal{Tag: FreeValBind, Bind0: value.Bind0, Bind1: func(coerced any) FreeVal {
			return convert5(original(coerced))
		}}
	}
}

type CommandInt struct {
	Pop   func(int) int
	Push0 int32
	Push1 int
	Tag   uint8
}

const (
	CommandIntPush = iota
	CommandIntPop
)

func convert6(value CommandInt) CommandVal {
	switch value.Tag {
	case CommandIntPush:
		return CommandVal{Tag: CommandValPush, Push0: value.Push0, Push1: value.Push1}
	default: // CommandIntPop
		return CommandVal{Tag: CommandValPop, Pop: func(coerced int) any {
			return value.Pop(coerced)
		}}
	}
}

type InstructionInt struct {
	Load   func(int) int
	Store0 int32
	Store1 int
	Tag    uint8
}

const (
	InstructionIntStore = iota
	InstructionIntLoad
)

func convert7(value InstructionInt) InstructionVal {
	switch value.Tag {
	case InstructionIntStore:
		return InstructionVal{Tag: InstructionValStore, Store0: value.Store0, Store1: value.Store1}
	default: // InstructionIntLoad
		return InstructionVal{Tag: InstructionValLoad, Load: func(coerced int) any {
			return value.Load(coerced)
		}}
	}
}

func convert8(value CommandVal) *Command {
	switch value.Tag {
	case CommandValPush:
		return &Command{Tag: CommandPush, Push0: value.Push0, Push1: value.Push1, Origin: value}
	default: // CommandValPop
		return &Command{Tag: CommandPop, Pop: value.Pop, Origin: value}
	}
}

func Push(push0 int, push1 struct{}) CommandUnit {
	return CommandUnit{Tag: CommandUnitPush, Push0: int32(push0), Push1: push1}
}

func PureFreeCommandUnit(pure struct{}) FreeCommandUnit {
	return FreeCommandUnit{Tag: FreeCommandUnitPure, Pure: pure}
}

func Store(store0 int, store1 struct{}) InstructionUnit {
	return InstructionUnit{Tag: InstructionUnitStore, Store0: int32(store0), Store1: store1}
}

func PureFreeInstructionUnit(pure struct{}) FreeInstructionUnit {
	return FreeInstructionUnit{Tag: FreeInstructionUnitPure, Pure: pure}
}

func PureFreeCommandInt(pure int) FreeCommandInt {
	return FreeCommandInt{Tag: FreeCommandIntPure, Pure: pure}
}

func Pop(pop func(int) int) CommandInt {
	return CommandInt{Tag: CommandIntPop, Pop: pop}
}

func Load(load func(int) int) InstructionInt {
	return InstructionInt{Tag: InstructionIntLoad, Load: load}
}

func PureFreeInstructionInt(pure int) FreeInstructionInt {
	return FreeInstructionInt{Tag: FreeInstructionIntPure, Pure: pure}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	return []int{foldFreeIntoState(program, 0).Value + 1, foldFreeIntoState(substFree(func(x *Instruction) *FreeCommand {
		var result *Command
		switch x.Tag {
		case InstructionStore:
			result = &Command{Tag: CommandPush, Push0: x.Store0, Push1: x.Store1}
		default: // InstructionLoad
			result = &Command{Tag: CommandPop, Pop: x.Load}
		}
		return &FreeCommand{Tag: FreeCommandBind, Bind0: convert(result), Bind1: PureFreeCommand}
	}, instructions), 0).Value}
}

var program = initializeProgram()

func initializeProgram() FreeCommandInt {
	return andThenNextCommandUnit(FreeCommandUnit{Tag: FreeCommandUnitBind, Bind0: convert2(Push(41, struct{}{})), Bind1: func(_ any) FreeCommandUnit {
		return PureFreeCommandUnit(struct{}{})
	}})
}

var instructions = initializeInstructions()

func initializeInstructions() FreeInstructionInt {
	return andThenNextInstruction(FreeInstructionUnit{Tag: FreeInstructionUnitBind, Bind0: convert3(Store(6, struct{}{})), Bind1: func(_ any) FreeInstructionUnit {
		return PureFreeInstructionUnit(struct{}{})
	}})
}

func substFreeOrAndThenCommandValIntNext(step int, k func(*Instruction) *FreeCommand, value FreeInstructionInt, program FreeVal, f func(any) FreeInstructionInt) FreeCommandInt {
	for {
		switch step {
		case shared.SubstFreeStep:
			switch value.Tag {
			case FreeInstructionIntPure:
				a := value.Pure
				return PureFreeCommandInt(a)
			default: // FreeInstructionIntBind
				command := value.Bind0
				continue_ := value.Bind1
				step, program, f = shared.AndThenNextValStep, convert5(k(convert4(command))), continue_
				continue
			}
		default: // shared.AndThenNextValStep
			kCaptured := k
			fCaptured := f
			switch program.Tag {
			case FreeValPure:
				a := program.Pure
				step, k, value = shared.SubstFreeStep, kCaptured, fCaptured(a)
				continue
			default: // FreeValBind
				command := program.Bind0
				continue_ := program.Bind1
				return FreeCommandInt{Tag: FreeCommandIntBind, Bind0: command, Bind1: func(value2 any) FreeCommandInt {
					return andThenNextVal(continue_(value2), kCaptured, fCaptured)
				}}
			}
		}
	}
}

func substFree(k func(*Instruction) *FreeCommand, value FreeInstructionInt) FreeCommandInt {
	var program FreeVal
	return substFreeOrAndThenCommandValIntNext(shared.SubstFreeStep, k, value, program, nil)
}

func andThenNextCommandUnit(program FreeCommandUnit) FreeCommandInt {
	switch program.Tag {
	case FreeCommandUnitPure:
		return FreeCommandInt{Tag: FreeCommandIntBind, Bind0: convert6(Pop(category.Identity)), Bind1: func(value any) FreeCommandInt {
			return PureFreeCommandInt(value.(int))
		}}
	default: // FreeCommandUnitBind
		return FreeCommandInt{Tag: FreeCommandIntBind, Bind0: program.Bind0, Bind1: func(value any) FreeCommandInt {
			return andThenNextCommandUnit(program.Bind1(value))
		}}
	}
}

func andThenNextVal(program FreeVal, f func(*Instruction) *FreeCommand, f2 func(any) FreeInstructionInt) FreeCommandInt {
	var value FreeInstructionInt
	return substFreeOrAndThenCommandValIntNext(shared.AndThenNextValStep, f, value, program, f2)
}

func andThenNextInstruction(program FreeInstructionUnit) FreeInstructionInt {
	switch program.Tag {
	case FreeInstructionUnitPure:
		return FreeInstructionInt{Tag: FreeInstructionIntBind, Bind0: convert7(Load(func(value int) int {
			return value * 7
		})), Bind1: func(value any) FreeInstructionInt {
			return PureFreeInstructionInt(value.(int))
		}}
	default: // FreeInstructionUnitBind
		return FreeInstructionInt{Tag: FreeInstructionIntBind, Bind0: program.Bind0, Bind1: func(value any) FreeInstructionInt {
			return andThenNextInstruction(program.Bind1(value))
		}}
	}
}

func foldFreeIntoState(program FreeCommandInt, state int) shared.StateValueOfInt {
	for {
		switch program.Tag {
		case FreeCommandIntPure:
			a := program.Pure
			return shared.StateValueOfInt{Value: a, State: state}
		default: // FreeCommandIntBind
			command := program.Bind0
			continue_ := program.Bind1
			scrutinee := convert8(command)
			var result shared.StateValueOfValue
			switch scrutinee.Tag {
			case CommandPush:
				result = shared.StateValueOfValue{Value: scrutinee.Push1, State: int(scrutinee.Push0)}
			default: // CommandPop
				result = shared.StateValueOfValue{Value: scrutinee.Pop(state), State: state}
			}
			program, state = continue_(result.Value), result.State
			continue
		}
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type StateValueOfInt struct {
	State int
	Value int
}

type StateValueOfValue struct {
	Value any
	State int
}

const (
	SubstFreeStep = iota
	AndThenNextValStep
)
