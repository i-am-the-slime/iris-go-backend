// Data/List/Types/types.go
package types

type List struct {
	Cons0 string
	Cons1 *List
}

var SharedListNil = &List{}

func Cons(cons0 string, cons1 *List) *List {
	return &List{Cons0: cons0, Cons1: cons1}
}

// Data/Maybe/maybe.go
package maybe

import "github.com/i-am-the-slime/iris-go/prim"

const TagNothing = 0

const TagJust = 1

type String struct {
	Just string
	Tag  uint8
}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

var NoString = String{Tag: TagNothing}

func Show(maybe String) string {
	return string(AppendShow(nil, maybe))
}

func AppendShowArrayMaybeString(buffer []byte, array []String) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShow(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShow(buffer []byte, maybe String) []byte {
	switch maybe.Tag {
	case TagJust:
		buffer = append(buffer, "(Just "...)
		buffer = prim.AppendShowString(buffer, maybe.Just)
		buffer = append(buffer, ')')
	default: // TagNothing
		buffer = append(buffer, "Nothing"...)
	}
	return buffer
}

func ArrayMaybeString(array []String) string {
	return string(AppendShowArrayMaybeString(nil, array))
}

// Data/Show/show.go
package show

import "github.com/i-am-the-slime/iris-go/prim"

func Show(s string) string {
	return prim.ShowString(s)
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// Data/Variant/Internal/internal.go
package internal

import "fixture/shared"

type VariantRepNumber struct {
	Type  string
	Value float64
}

func Convert(value VariantRepNumber) shared.TypeValue {
	return shared.TypeValue{Type: value.Type, Value: value.Value}
}

type VariantRepInt struct {
	Type  string
	Value int32
}

func Convert2(value VariantRepInt) shared.TypeValue {
	return shared.TypeValue{Type: value.Type, Value: value.Value}
}

type VariantRepString struct {
	Type  string
	Value string
}

func Convert3(value VariantRepString) shared.TypeValue {
	return shared.TypeValue{Type: value.Type, Value: value.Value}
}

// Data/Variant/variant.go
package variant

import (
	exports "fixture/Data/Variant/Internal"
	"fixture/Type/Proxy"
	"fixture/shared"
)

type UnvariantRecordCaptionSquare func(proxy.Unvariant_RecordCaptionSquareString) string

type UnvariantCaptionCircleSquare func(proxy.Unvariant_CaptionCircleSquareString) string

func InjString(p proxy.Proxy, value string) shared.TypeValue {
	return exports.Convert3(exports.VariantRepString{Type: "caption", Value: value})
}

func InjNumber(p proxy.Proxy, value float64) shared.TypeValue {
	return exports.Convert(exports.VariantRepNumber{Type: "circle", Value: value})
}

// Type/Proxy/proxy.go
package proxy

import "fixture/shared"

type Proxy uint8

const (
	ProxyProxy Proxy = iota
)

type Unvariant_RecordCaptionSquareString struct {
	ForIntRecordCaption   func(Proxy, int32) string
	ForStringRecordSquare func(Proxy, string) string
}

type Unvariant_CaptionCircleSquareString struct {
	ForIntRecordCaptionCircle    func(Proxy, int32) string
	ForNumberRecordCaptionSquare func(Proxy, float64) string
	ForStringRecordCircleSquare  func(Proxy, string) string
}

type NumberRecordCaptionStringRecordCircle struct {
	ForNumberRecordCaption func(Proxy, float64) shared.TypeValue
	ForStringRecordCircle  func(Proxy, string) shared.TypeValue
}

type Unvariant_CaptionCircleString struct {
	ForNumberRecordCaption func(Proxy, float64) string
	ForStringRecordCircle  func(Proxy, string) string
}

type StringVariantRecordCaptionCircle struct {
	ForString                     func(Unvariant_CaptionCircleString) string
	ForVariantRecordCaptionCircle func(NumberRecordCaptionStringRecordCircle) shared.TypeValue
}

// main.go
package main

import (
	"fixture/Data/List/Types"
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	datavariant "fixture/Data/Variant"
	"fixture/Data/Variant/Internal"
	"fixture/Type/Proxy"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	mapped := make([]maybe.String, len(shapes))
	for index, x := range shapes {
		tag := x.Type
		var result maybe.String
		if mainGoCons(tag, "caption", types.Cons("square", types.SharedListNil)) {
			var run datavariant.UnvariantRecordCaptionSquare
			if x.Type == "caption" {
				run = func(continuation proxy.Unvariant_RecordCaptionSquareString) string {
					return continuation.ForStringRecordSquare(proxy.ProxyProxy, x.Value.(string))
				}
			} else if x.Type == "square" {
				run = func(continuation proxy.Unvariant_RecordCaptionSquareString) string {
					return continuation.ForIntRecordCaption(proxy.ProxyProxy, x.Value.(int32))
				}
			} else {
				panic("Failed pattern match")
			}
			result = maybe.JustString(run(proxy.Unvariant_RecordCaptionSquareString{ForIntRecordCaption: func(_ proxy.Proxy, _ int32) string {
				return "square"
			}, ForStringRecordSquare: func(_ proxy.Proxy, _ string) string {
				return "caption"
			}}))
		} else {
			result = maybe.NoString
		}
		mapped[index] = result
	}
	mapped2 := make([]string, len(shapes))
	for index, element := range shapes {
		mapped2[index] = labelOf(element)
	}
	mapped3 := make([]string, len(shapes))
	for index, element := range shapes {
		mapped3[index] = roundTripped(element)
	}
	return []string{maybe.ArrayMaybeString(mapped), show.ArrayString(mapped2), show.ArrayString(mapped3)}
}

var shapes = initializeShapes()

func initializeShapes() []shared.TypeValue {
	return []shared.TypeValue{internal.Convert(internal.VariantRepNumber{Type: "circle", Value: 1.5}), internal.Convert2(internal.VariantRepInt{Type: "square", Value: 2}), internal.Convert3(internal.VariantRepString{Type: "caption", Value: "hi"})}
}

func labelOf(variant shared.TypeValue) string {
	var run datavariant.UnvariantCaptionCircleSquare
	if variant.Type == "caption" {
		run = func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForStringRecordCircleSquare(proxy.ProxyProxy, variant.Value.(string))
		}
	} else if variant.Type == "circle" {
		run = func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForNumberRecordCaptionSquare(proxy.ProxyProxy, variant.Value.(float64))
		}
	} else if variant.Type == "square" {
		run = func(continuation proxy.Unvariant_CaptionCircleSquareString) string {
			return continuation.ForIntRecordCaptionCircle(proxy.ProxyProxy, variant.Value.(int32))
		}
	} else {
		panic("Failed pattern match")
	}
	return run(proxy.Unvariant_CaptionCircleSquareString{ForIntRecordCaptionCircle: func(_ proxy.Proxy, _ int32) string {
		return "square"
	}, ForNumberRecordCaptionSquare: func(_ proxy.Proxy, _ float64) string {
		return "circle"
	}, ForStringRecordCircleSquare: func(_ proxy.Proxy, _ string) string {
		return "caption"
	}})
}

func roundTripped(r shared.TypeValue) string {
	if r.Type == "square" {
		return "side " + strconv.Itoa(int(r.Value.(int32)))
	}
	var result proxy.StringVariantRecordCaptionCircle
	if r.Type == "caption" {
		argument := r.Value
		result = proxy.StringVariantRecordCaptionCircle{ForString: func(continuation proxy.Unvariant_CaptionCircleString) string {
			return continuation.ForStringRecordCircle(proxy.ProxyProxy, argument.(string))
		}, ForVariantRecordCaptionCircle: func(continuation proxy.NumberRecordCaptionStringRecordCircle) shared.TypeValue {
			return continuation.ForStringRecordCircle(proxy.ProxyProxy, argument.(string))
		}}
	} else if r.Type == "circle" {
		argument := r.Value
		result = proxy.StringVariantRecordCaptionCircle{ForString: func(continuation proxy.Unvariant_CaptionCircleString) string {
			return continuation.ForNumberRecordCaption(proxy.ProxyProxy, argument.(float64))
		}, ForVariantRecordCaptionCircle: func(continuation proxy.NumberRecordCaptionStringRecordCircle) shared.TypeValue {
			return continuation.ForNumberRecordCaption(proxy.ProxyProxy, argument.(float64))
		}}
	} else {
		panic("Failed pattern match")
	}
	scrutinee := result.ForVariantRecordCaptionCircle(proxy.NumberRecordCaptionStringRecordCircle{ForNumberRecordCaption: datavariant.InjNumber, ForStringRecordCircle: datavariant.InjString})
	var run proxy.StringVariantRecordCaptionCircle
	if scrutinee.Type == "caption" {
		argument := scrutinee.Value
		run = proxy.StringVariantRecordCaptionCircle{ForString: func(continuation proxy.Unvariant_CaptionCircleString) string {
			return continuation.ForStringRecordCircle(proxy.ProxyProxy, argument.(string))
		}, ForVariantRecordCaptionCircle: func(continuation proxy.NumberRecordCaptionStringRecordCircle) shared.TypeValue {
			return continuation.ForStringRecordCircle(proxy.ProxyProxy, argument.(string))
		}}
	} else if scrutinee.Type == "circle" {
		argument := scrutinee.Value
		run = proxy.StringVariantRecordCaptionCircle{ForString: func(continuation proxy.Unvariant_CaptionCircleString) string {
			return continuation.ForNumberRecordCaption(proxy.ProxyProxy, argument.(float64))
		}, ForVariantRecordCaptionCircle: func(continuation proxy.NumberRecordCaptionStringRecordCircle) shared.TypeValue {
			return continuation.ForNumberRecordCaption(proxy.ProxyProxy, argument.(float64))
		}}
	} else {
		panic("Failed pattern match")
	}
	return run.ForString(proxy.Unvariant_CaptionCircleString{ForNumberRecordCaption: func(_ proxy.Proxy, _ float64) string {
		return "circle"
	}, ForStringRecordCircle: func(_ proxy.Proxy, _ string) string {
		return "caption"
	}})
}

func mainGo(tag string, value *types.List) bool {
	for {
		if value != types.SharedListNil {
			t := value.Cons0
			ts := value.Cons1
			if t == tag {
				return true
			}
			value = ts
			continue
		}
		return false
	}
}

func mainGoCons(tag string, t string, ts *types.List) bool {
	if t == tag {
		return true
	}
	return mainGo(tag, ts)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type TypeValue struct {
	Type  string
	Value any
}
