// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/exception"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	mapped := make([]string, len(names))
	for index, value := range names {
		mapped[index] = value + strconv.Itoa(int(total))
	}
	return mapped
}

var total = initializeTotal()

func initializeTotal() int32 {
	defer exception.ReportUncaught()
	return count(5)
}

var names []string = []string{"a", "b"}

func count(n int32) int32 {
	if n <= 0 {
		return 0
	}
	return 1 + count(n-1)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
