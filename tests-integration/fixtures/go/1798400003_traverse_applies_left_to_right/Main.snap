// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"strconv"
	"strings"
)

type ShapeArrayInt struct {
	Shape string
	Value []int
}

type ShapeFnIntArrayInt struct {
	Shape string
	Value func(int) []int
}

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{shapeOf([]int{}), shapeOf([]int{1, 2}), shapeOf([]int{1, 2, 3, 4, 5})}
}

func shapeOf(xs []int) string {
	append_ := direct.Appender[int]()
	accumulator := ShapeArrayInt{Shape: "pure", Value: []int{}}
	for _, element := range xs {
		shapeFnIntArrayInt := ShapeFnIntArrayInt{Shape: accumulator.Shape, Value: append_(accumulator.Value)}
		accumulator = ShapeArrayInt{Shape: "(" + shapeFnIntArrayInt.Shape + " " + strconv.Itoa(element) + ")", Value: shapeFnIntArrayInt.Value(element)}
	}
	return accumulator.Shape
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
