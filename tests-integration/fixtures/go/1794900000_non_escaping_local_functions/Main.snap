// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"os"
)

type ListInt struct {
	Cons1 *ListInt
	Cons0 int32
	Tag   uint8
}

const (
	ListIntNil = iota
	ListIntCons
)

var sharedListIntNil = &ListInt{Tag: ListIntNil}

func main_() int32 {
	array := direct.FromFoldable(func(f func(int32) func(*direct.ConsList[int32]) *direct.ConsList[int32]) func(*direct.ConsList[int32]) func(*ListInt) *direct.ConsList[int32] {
		return func(b *direct.ConsList[int32]) func(*ListInt) *direct.ConsList[int32] {
			return foldr(f, b)
		}
	}, &ListInt{Tag: ListIntCons, Cons0: 1, Cons1: &ListInt{Tag: ListIntCons, Cons0: 2, Cons1: sharedListIntNil}})
	var accumulator int32 = 0
	for _, value := range array {
		accumulator = accumulator + value
	}
	return accumulator
}

func foldr(f func(int32) func(*direct.ConsList[int32]) *direct.ConsList[int32], b *direct.ConsList[int32]) func(*ListInt) *direct.ConsList[int32] {
	return func(x *ListInt) *direct.ConsList[int32] {
		return foldrGo2(f, b, foldrGo(sharedListIntNil, x))
	}
}

func foldrGo(accumulator *ListInt, list *ListInt) *ListInt {
	var listIntCells alloc.Cells[ListInt]
	for {
		switch list.Tag {
		case ListIntNil:
			return accumulator
		default: // ListIntCons
			x := list.Cons0
			xs := list.Cons1
			accumulator, list = listIntCells.New(ListInt{Tag: ListIntCons, Cons0: x, Cons1: accumulator}), xs
			continue
		}
	}
}

func foldrGo2(f func(int32) func(*direct.ConsList[int32]) *direct.ConsList[int32], accumulator *direct.ConsList[int32], list *ListInt) *direct.ConsList[int32] {
	for {
		switch list.Tag {
		case ListIntNil:
			return accumulator
		default: // ListIntCons
			x := list.Cons0
			xs := list.Cons1
			accumulator, list = f(x)(accumulator), xs
			continue
		}
	}
}

func main() {
	defer exception.ReportUncaught()
	exitStatus := main_()
	os.Exit(int(exitStatus))
}
