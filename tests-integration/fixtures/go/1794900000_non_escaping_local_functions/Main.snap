// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/direct"
	"os"
)

type List struct {
	Cons1 *List
	Cons0 int
}

var sharedListNil = &List{}

func Cons(cons0 int, cons1 *List) *List {
	return &List{Cons0: cons0, Cons1: cons1}
}

func main_() int {
	return foldLanes(direct.FromFoldable(func(f func(int) func(*direct.ConsList[int]) *direct.ConsList[int]) func(*direct.ConsList[int]) func(*List) *direct.ConsList[int] {
		return func(b *direct.ConsList[int]) func(*List) *direct.ConsList[int] {
			return foldr(f, b)
		}
	}, Cons(1, Cons(2, sharedListNil))), 0)
}

func foldr(f func(int) func(*direct.ConsList[int]) *direct.ConsList[int], b *direct.ConsList[int]) func(*List) *direct.ConsList[int] {
	return func(x *List) *direct.ConsList[int] {
		return foldrGo2(f, b, foldrGo(sharedListNil, x))
	}
}

func foldrGo(accumulator *List, list *List) *List {
	var listIntCells alloc.Cells[List]
	for {
		if list == sharedListNil {
			return accumulator
		}
		x := list.Cons0
		xs := list.Cons1
		accumulator, list = listIntCells.New(List{Cons0: x, Cons1: accumulator}), xs
	}
}

func foldrGo2(f func(int) func(*direct.ConsList[int]) *direct.ConsList[int], accumulator *direct.ConsList[int], list *List) *direct.ConsList[int] {
	for {
		if list == sharedListNil {
			return accumulator
		}
		x := list.Cons0
		xs := list.Cons1
		accumulator, list = f(x)(accumulator), xs
	}
}

func main() {
	os.Exit(main_())
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"simd/archsimd"
	"unsafe"
)

func foldLanesLanes(xs []int64, initial int64) int64 {
	acc0 := archsimd.BroadcastInt64x2(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 2
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt64x2(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt64x2(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt64x2(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt64x2(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [2]int64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
func foldLanes(xs []int, initial int) int {
	return int(foldLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)), int64(initial)))
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int, initial int) int {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"simd"
	"unsafe"
)

func foldLanesLanes(xs []int64, initial int64) int64 {
	acc0 := simd.BroadcastInt64s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt64s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt64s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt64s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt64s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [8]int64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}
func foldLanes(xs []int, initial int) int {
	return int(foldLanesLanes(unsafe.Slice((*int64)(unsafe.Pointer(unsafe.SliceData(xs))), len(xs)), int64(initial)))
}
