// Data/Either/either.go
package either

import "strconv"

type Either struct {
	Field0 int
	Tag    uint8
}

const (
	EitherLeft = iota
	EitherRight
)

type IntFailure struct {
	Failed bool
	Left   int
}

func Left(field0 int) Either {
	return Either{Tag: EitherLeft, Field0: field0}
}

func Right(field0 int) Either {
	return Either{Tag: EitherRight, Field0: field0}
}

func AppendShowArrayEitherIntInt(buffer []byte, array []Either) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowEitherIntInt(buffer, element.Field0, EitherFailure(element))
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowEitherIntInt(buffer []byte, i int, err IntFailure) []byte {
	if err.Failed {
		buffer = append(buffer, "(Left "...)
		buffer = strconv.AppendInt(buffer, int64(err.Left), 10)
		buffer = append(buffer, ')')
	} else {
		buffer = append(buffer, "(Right "...)
		buffer = strconv.AppendInt(buffer, int64(i), 10)
		buffer = append(buffer, ')')
	}
	return buffer
}

func ArrayEitherIntInt(array []Either) string {
	return string(AppendShowArrayEitherIntInt(nil, array))
}

func EitherFailure(either Either) IntFailure {
	if either.Tag == EitherLeft {
		return IntFailure{Failed: true, Left: either.Field0}
	}
	return IntFailure{}
}

// main.go
package main

import (
	"fixture/Data/Either"
	journal "fixture/Journal_ffi"
	"github.com/i-am-the-slime/iris-go/array"
)

func main() {
	journal.Log(either.ArrayEitherIntInt(array.Apply([]func(int) either.Either{tenfoldAboveOne, func(x int) either.Either {
		return either.Left(x + 100)
	}}, []int{1, 2, 3})))
}

func tenfoldAboveOne(x int) either.Either {
	if x > 1 {
		return either.Right(x * 10)
	}
	return either.Left(x)
}
