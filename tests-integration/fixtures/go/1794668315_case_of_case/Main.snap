// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Id struct {
	Id string
}

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	xs := []Id{Id{Id: "a"}}
	var result string
	if 0 < int32(len(xs)) {
		result = xs[0].Id
	} else {
		result = ""
	}
	xs2 := []int32{1, 2}
	var result2 int32
	if 1 < int32(len(xs2)) {
		result2 = xs2[1] + 1
	} else {
		result2 = 0
	}
	field := opaque(3)
	scrutinee := opaque(1)
	var result3 string
	switch scrutinee {
	case 0:
		result3 = "zero"
	case 1:
		result3 = "one"
	default:
		result3 = "many"
	}
	n := opaque(11)
	var result4 string
	if n > 10 {
		result4 = mainJoin(n)
	} else if n > 5 {
		result4 = mainJoin(prim.MultiplyInt32(n, 2))
	} else {
		result4 = "none"
	}
	n2 := opaque(12)
	var result5 string
	if n2 > 10 {
		result5 = mainJoin2(n2)
	} else if n2 > 5 {
		result5 = mainJoin2(prim.MultiplyInt32(n2, 2))
	} else {
		result5 = "none"
	}
	return []string{result, prim.ShowInt(result2), prim.ShowInt(prim.MultiplyInt32(field, field)), result3, result4, result5}
}

func opaque(x int32) int32 {
	for {
		if x == 12345 {
			continue
		}
		return x
	}
}

func mainJoin(m int32) string {
	return prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m)
}

func mainJoin2(m int32) string {
	return prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m) + prim.ShowInt(m)
}

func main() {
	fmt.Println(main_)
}
