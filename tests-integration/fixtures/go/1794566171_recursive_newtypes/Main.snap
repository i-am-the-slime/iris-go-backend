// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Step = func(int32) *MaybeStep

type MaybeStep struct {
	Just Step
	Tag  uint8
}

const (
	MaybeStepNothing = iota
	MaybeStepJust
)

var sharedMaybeStepNothing = &MaybeStep{Tag: MaybeStepNothing}

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return array.Append(names(shared.Level{Name: "root", Minis: []shared.Level{shared.Level{Name: "a", Minis: []shared.Level{}}}}), []string{prim.ShowInt(countSteps(func(n int32) *MaybeStep {
		if n < 3 {
			return &MaybeStep{Tag: MaybeStepJust, Just: func(_ int32) *MaybeStep {
				return sharedMaybeStepNothing
			}}
		}
		return sharedMaybeStepNothing
	}, 0))})
}

func names(level shared.Level) []string {
	return array.Append([]string{level.Name}, array.Bind(level.Minis, names))
}

func countSteps(step Step, n int32) int32 {
	for {
		scrutinee := step(n)
		switch scrutinee.Tag {
		case MaybeStepNothing:
			return n
		default: // MaybeStepJust
			step, n = scrutinee.Just, n + 1
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type Level struct {
	Minis []Level
	Name  string
}
