// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type Step func(int) Step

var main_ = initializeMain_()

func initializeMain_() []string {
	return array.Append(namesLevel([]shared.Level{{Name: "a", Minis: []shared.Level{}}}, "root"), []string{strconv.Itoa(countSteps(func(n int) Step {
		if n < 3 {
			return func(_ int) Step {
				return nil
			}
		}
		return nil
	}, 0))})
}

func names(level shared.Level) []string {
	return array.Append([]string{level.Name}, array.Bind(level.Minis, names))
}

func countSteps(step Step, n int) int {
	for {
		scrutinee := step(n)
		if scrutinee == nil {
			return n
		}
		step, n = scrutinee, n+1
	}
}

func namesLevel(minis []shared.Level, name string) []string {
	return array.Append([]string{name}, array.Bind(minis, names))
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Level struct {
	Minis []Level
	Name  string
}
