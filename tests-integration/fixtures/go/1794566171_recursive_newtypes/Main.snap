// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
	"strconv"
)

type Step func(int32) Step

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	return array.Append(names(shared.Level{Name: "root", Minis: []shared.Level{{Name: "a", Minis: []shared.Level{}}}}), []string{strconv.Itoa(int(countSteps(func(n int32) Step {
		if n < 3 {
			return func(_ int32) Step {
				return nil
			}
		}
		return nil
	}, 0)))})
}

func names(level shared.Level) []string {
	return array.Append([]string{level.Name}, array.Bind(level.Minis, names))
}

func countSteps(step Step, n int32) int32 {
	for {
		scrutinee := step(n)
		if scrutinee == nil {
			return n
		}
		step, n = scrutinee, n+1
	}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type Level struct {
	Minis []Level
	Name  string
}
