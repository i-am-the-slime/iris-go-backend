// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

type Level struct {
	Minis []Level
	Name  string
}

type Step = func(int32) *MaybeStep

type MaybeStep struct {
	Just Step
	Tag  uint8
}

const (
	MaybeStepNothing = iota
	MaybeStepJust
)

var sharedMaybeStepNothing = &MaybeStep{Tag: MaybeStepNothing}

var main_ []string = array.Append(names(Level{Name: "root", Minis: []Level{Level{Name: "a", Minis: []Level{}}}}), []string{prim.ShowInt(countSteps(func(n int32) *MaybeStep {
	if n < 3 {
		return &MaybeStep{Tag: MaybeStepJust, Just: func(_ int32) *MaybeStep {
			return sharedMaybeStepNothing
		}}
	}
	return sharedMaybeStepNothing
}, 0))})

func names(level Level) []string {
	return array.Append([]string{level.Name}, array.Bind(level.Minis, func(argument0 Level) []string {
		return names(argument0)
	}))
}

func countSteps(argument0 Step, argument1 int32) int32 {
	for {
		scrutinee := argument0(argument1)
		switch scrutinee.Tag {
		case MaybeStepNothing:
			return argument1
		default: // MaybeStepJust
			argument0, argument1 = scrutinee.Just, argument1 + 1
			continue
		}
	}
}

func main() {
	fmt.Println(main_)
}
