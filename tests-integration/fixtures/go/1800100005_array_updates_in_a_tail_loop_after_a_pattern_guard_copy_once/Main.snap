// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

var NoInt = Int{Tag: TagNothing}

// Data/Show/show.go
package show

import "strconv"

func Show(i int) string {
	return strconv.Itoa(i)
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	shared := array.Range(1, 5)
	return []string{show.ArrayInt(doubled(0, shared)), show.ArrayInt(doubled(3, shared)), show.ArrayInt(shared)}
}

func doubled(position int, values []int) []int {
	values = slices.Clip(values)
	copied := false
	for {
		var element maybe.Int
		if position >= 0 && position < len(values) {
			element = maybe.JustInt(values[position])
		} else {
			element = maybe.NoInt
		}
		if element.Tag == maybe.TagJust {
			var result []int
			if position >= 0 && position < len(values) {
				value := element.Just * 2
				updated := values
				if !copied {
					updated = slices.Clone(updated)
					copied = true
				}
				updated[position] = value
				result = updated
			} else {
				result = values
			}
			position, values = position+1, result
			continue
		}
		return values
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
