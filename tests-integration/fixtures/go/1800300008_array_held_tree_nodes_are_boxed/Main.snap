// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strings"
)

type Wide struct {
	First  []int
	Second []string
	Third  []*Wide
}

type Rose struct {
	Second []Rose
	First  int
}

var main_ = initializeMain_()

func initializeMain_() []int {
	leaf := &Wide{First: []int{1, 2}, Second: []string{"a", "b"}, Third: []*Wide{}}
	field := []*Wide{leaf, leaf}
	var result []*Wide
	updated := slices.Clone(field)
	updated[0] = &Wide{First: []int{3}, Second: []string{"c"}, Third: []*Wide{}}
	result = updated
	return []int{sizeWide([]int{5}, result), roseTotalRose(1, []Rose{{First: 2, Second: []Rose{}}, {First: 3, Second: []Rose{{First: 4, Second: []Rose{}}}}}), len([]shared.Point{{X: 1.0, Y: 2.0, Z: 3.0, W: 4.0, Label: "p"}})}
}

func size(wide *Wide) int {
	accumulator := 0
	for _, child := range wide.Third {
		accumulator += size(child)
	}
	return len(wide.First) + accumulator
}

func roseTotal(rose Rose) int {
	accumulator := 0
	for _, child := range rose.Second {
		accumulator += roseTotal(child)
	}
	return rose.First + accumulator
}

func roseTotalRose(here int, children []Rose) int {
	accumulator := 0
	for _, child := range children {
		accumulator += roseTotal(child)
	}
	return here + accumulator
}

func sizeWide(keys []int, children []*Wide) int {
	accumulator := 0
	for _, child := range children {
		accumulator += size(child)
	}
	return len(keys) + accumulator
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

type Point struct {
	Label string
	W     float64
	X     float64
	Y     float64
	Z     float64
}
