// main.go
package main

import (
	box "fixture/Box_ffi"
	journal "fixture/Journal_ffi"
	"fixture/shared"
	"strconv"
)

func main() {
	model := box.ReadBox(box.NewBox(any(shared.Model{Count: 1, Name: "first", Size: shared.Size{Width: 80, Height: 24}}))).(shared.Model)
	journal.Log(model.Name + " " + strconv.Itoa(model.Count) + " " + strconv.Itoa(model.Size.Width))
}

// shared/shared.go
package shared

type Size struct {
	Height int
	Width  int
}

type Model struct {
	Name  string
	Count int
	Size  Size
}
