// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{1, 2, 3, 4, 5})()
	i := int32(len(*array2))
	end := i / 2
	elements := *array2
	for i2 := int32(0); i2 < end; i2++ {
		j := i - 1 - i2
		var i3 int32
		var i4 int32
		if j >= 0 {
			element := elements[i2]
			i3 = element
			element2 := elements[j]
			i4 = element2
			elements[i2] = i4
			elements[j] = i3
		} else {
			element := elements[i2]
			i3 = element
			i4 = 0
			elements[i2] = i4
		}
	}
	var i5 int32
	i5 = 0
	if 0 < len(*array2) {
		(*array2)[0] = i5
	}
	if 1 < len(*array2) {
		(*array2)[1] = 0
	}
	performed := array.UnsafeFreeze(array2)()
	return performed
}

func main() {
	fmt.Println(main_)
}
