// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{1, 2, 3, 4, 5})()
	size := int32(len(*array2))
	end := size / 2
	elements := *array2
	for i := int32(0); i < end; i++ {
		j := size - 1 - i
		var i2 int32
		var i3 int32
		if j >= 0 {
			i2 = elements[i]
			i3 = elements[j]
			elements[i] = i3
			elements[j] = i2
		} else {
			i2 = elements[i]
			i3 = 0
			elements[i] = i3
		}
	}
	var i4 int32
	i4 = 0
	if 0 < len(*array2) {
		(*array2)[0] = i4
	}
	if 1 < len(*array2) {
		(*array2)[1] = 0
	}
	performed := array.UnsafeFreeze(array2)()
	return performed
}

func main() {
	fmt.Println(main_)
}
