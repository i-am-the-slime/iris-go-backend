// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	result := array.Thaw([]int{1, 2, 3, 4, 5})
	reversed(result)
	performed := shared.Frozen(*result)
	return performed
}

func reversed(array *[]int) {
	array2 := *array
	size := len(array2)
	end := size / 2
	for i := 0; i < end; i++ {
		j := size - 1 - i
		var i2 int
		var i3 int
		if j >= 0 {
			i2 = array2[i]
			i3 = array2[j]
			array2[i] = i3
			array2[j] = i2
		} else {
			i2 = array2[i]
			i3 = 0
			array2[i] = i3
		}
	}
	var i4 int
	i4 = 0
	if len(array2) > 0 {
		array2[0] = i4
	}
	if len(array2) > 1 {
		array2[1] = 0
	}
	*array = array2
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
