// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	array2 := *array.Thaw([]int32{1, 2, 3, 4, 5})
	size := int32(len(array2))
	end := size >> 1
	for i := int32(0); i < end; i++ {
		j := size - 1 - i
		var i2 int32
		var i3 int32
		if int(i) < len(array2) && j >= 0 && int(j) < len(array2) {
			i2 = array2[i]
			i3 = array2[j]
			array2[i] = i3
			array2[j] = i2
		} else {
			within := int(i) < len(array2)
			if within {
				i2 = array2[i]
			} else {
				i2 = 0
			}
			within2 := j >= 0 && int(j) < len(array2)
			if within2 {
				i3 = array2[j]
			} else {
				i3 = 0
			}
			if int(i) < len(array2) {
				array2[i] = i3
			}
			if j >= 0 && int(j) < len(array2) {
				array2[j] = i2
			}
		}
	}
	var i4 int32
	var i5 int32
	if 0 < len(array2) && size >= 0 && int(size) < len(array2) && 1 < len(array2) {
		i4 = array2[0]
		i5 = array2[size]
		array2[0] = i5
		array2[size] = i4
		array2[1] = 0
	} else {
		within := 0 < len(array2)
		if within {
			i4 = array2[0]
		} else {
			i4 = 0
		}
		within2 := size >= 0 && int(size) < len(array2)
		if within2 {
			i5 = array2[size]
		} else {
			i5 = 0
		}
		if 0 < len(array2) {
			array2[0] = i5
		}
		if size >= 0 && int(size) < len(array2) {
			array2[size] = i4
		}
		if 1 < len(array2) {
			array2[1] = 0
		}
	}
	performed := shared.Frozen(array2)
	return performed
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
