// main.go
package main

import (
	"fixture/shared"
	"fmt"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	defer exception.ReportUncaught()
	scrutinee := []shared.Operation{{Name: "add", Run: func(x int32) int32 {
		return x + 3
	}}, {Name: "scale", Run: func(x int32) int32 {
		return x * 3
	}}}
	var result int32
	if len(scrutinee) == 2 {
		first := scrutinee[0]
		result = first.Run(10)
	} else {
		result = 10
	}
	scrutinee2 := []shared.Operation{{Name: "add", Run: func(x int32) int32 {
		return x + 3
	}}, {Name: "scale", Run: func(x int32) int32 {
		return x * 3
	}}}
	var result2 int32
	if len(scrutinee2) == 2 {
		second := scrutinee2[1]
		result2 = second.Run(10)
	} else {
		result2 = 10
	}
	return shared.MainResult{Added: result, Scaled: result2}
}

func main() {
	fmt.Println(main_)
}

// shared/shared.go
package shared

type MainResult struct {
	Added  int32
	Scaled int32
}

type Operation struct {
	Name string
	Run  func(int32) int32
}
