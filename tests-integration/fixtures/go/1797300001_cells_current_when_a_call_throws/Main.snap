// Data/Either/either.go
package either

import "github.com/i-am-the-slime/iris-go/exception"

type Either struct {
	Right struct{}
	Left  exception.Error
	Tag   uint8
}

const (
	EitherLeft = iota
	EitherRight
)

func Left(left exception.Error) Either {
	return Either{Tag: EitherLeft, Left: left}
}

func Right(right struct{}) Either {
	return Either{Tag: EitherRight, Right: right}
}

// main.go
package main

import (
	"fixture/Data/Either"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	"os"
)

func main_() int {
	total := &shared.Ref[int]{Value: 0}
	either2 := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		addCodes(total, "abc", 0)
		return either.Right(struct{}{})
	})
	read := total.Value
	var result int
	switch either2.Tag {
	case either.EitherLeft:
		result = 1
	default: // either.EitherRight
		result = 0
	}
	return read + result
}

func addCodes(total *shared.Ref[int], text string, index int) {
	totalValue := total.Value
	textUnits := prim.UTF16(text)
	for {
		total.Value = totalValue
		if index > textUnits.Length() {
			total.Value = totalValue
			return
		}
		total.Value = totalValue
		totalValue += prim.ToCharCode(textUnits.UnsafeCharAt(index))
		index += 1
	}
}

func main() {
	os.Exit(main_())
}

// shared/shared.go
package shared

type Ref[T any] struct {
	Value T
}

type StateValue struct {
	State int
	Value int
}
