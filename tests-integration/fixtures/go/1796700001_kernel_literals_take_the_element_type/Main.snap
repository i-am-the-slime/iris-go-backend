package main

func foldLanes(xs []int32, ys []int32, initial int32) int32 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	accumulator := initial
	for i := range len(xs) {
		x := xs[i]
		y := ys[i]
		s0 := int32(0)
		if x > y {
			s0 = 1
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func foldLanes2(xs []float64, ys []float64, initial float64) float64 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	accumulator := initial
	for i := range len(xs) {
		x := xs[i]
		y := ys[i]
		s0 := 1.0
		if x <= y {
			s0 = 0.0
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func foldLanes3(xs []int32, initial int32) int32 {
	accumulator := initial
	for _, x := range xs {
		s0 := int32(2)
		if x < 0 {
			s0 = -1
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func foldLanes4(xs []int32, initial int32) int32 {
	accumulator := initial
	for _, x := range xs {
		s0 := int32(0)
		if x > 0 {
			s0 = 1
		}
		s1 := s0
		if x < 0 {
			s1 = -1
		}
		accumulator = accumulator + s1
	}
	return accumulator
}

func foldLanes5(xs []int32, ys []int32, initial int32) int32 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	accumulator := initial
	for i := range len(xs) {
		x := xs[i]
		y := ys[i]
		s0 := int32(0)
		if x > y {
			s0 = x - y
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func mapLanes(xs []float64) []float64 {
	out := make([]float64, len(xs))
	for i, x := range xs {
		out[i] = 0.5 * x
	}
	return out
}

func zipLanes(xs []int32, ys []int32) []int32 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	out := make([]int32, len(xs))
	for i := range out {
		x := xs[i]
		y := ys[i]
		s0 := int32(0)
		if x > y {
			s0 = x - y
		}
		out[i] = s0
	}
	return out
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import (
	"math"
	"simd"
)

func foldLanes(xs []int32, ys []int32, initial int32) int32 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	c0 := simd.BroadcastInt32s(1)
	c1 := simd.BroadcastInt32s(0)
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		y0 := simd.LoadInt32s(ys[i : i+step])
		acc0 = acc0.Add(c0.IfElse(x0.Greater(y0), c1))
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		y1 := simd.LoadInt32s(ys[i+step : i+2*step])
		acc1 = acc1.Add(c0.IfElse(x1.Greater(y1), c1))
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		y2 := simd.LoadInt32s(ys[i+2*step : i+3*step])
		acc2 = acc2.Add(c0.IfElse(x2.Greater(y2), c1))
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		y3 := simd.LoadInt32s(ys[i+3*step : i+4*step])
		acc3 = acc3.Add(c0.IfElse(x3.Greater(y3), c1))
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		y := ys[i]
		s0 := int32(0)
		if x > y {
			s0 = 1
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func foldLanes2(xs []float64, ys []float64, initial float64) float64 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	c0 := simd.BroadcastFloat64s(0.0)
	c1 := simd.BroadcastFloat64s(1.0)
	acc0 := simd.BroadcastFloat64s(math.Copysign(0, -1))
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadFloat64s(xs[i : i+step])
		y0 := simd.LoadFloat64s(ys[i : i+step])
		acc0 = acc0.Add(c0.IfElse(x0.LessEqual(y0), c1))
		x1 := simd.LoadFloat64s(xs[i+step : i+2*step])
		y1 := simd.LoadFloat64s(ys[i+step : i+2*step])
		acc1 = acc1.Add(c0.IfElse(x1.LessEqual(y1), c1))
		x2 := simd.LoadFloat64s(xs[i+2*step : i+3*step])
		y2 := simd.LoadFloat64s(ys[i+2*step : i+3*step])
		acc2 = acc2.Add(c0.IfElse(x2.LessEqual(y2), c1))
		x3 := simd.LoadFloat64s(xs[i+3*step : i+4*step])
		y3 := simd.LoadFloat64s(ys[i+3*step : i+4*step])
		acc3 = acc3.Add(c0.IfElse(x3.LessEqual(y3), c1))
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [8]float64
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		y := ys[i]
		s0 := 1.0
		if x <= y {
			s0 = 0.0
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func foldLanes3(xs []int32, initial int32) int32 {
	c0 := simd.BroadcastInt32s(0)
	c1 := simd.BroadcastInt32s(-1)
	c2 := simd.BroadcastInt32s(2)
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		acc0 = acc0.Add(c1.IfElse(x0.Less(c0), c2))
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		acc1 = acc1.Add(c1.IfElse(x1.Less(c0), c2))
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(c1.IfElse(x2.Less(c0), c2))
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(c1.IfElse(x3.Less(c0), c2))
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		s0 := int32(2)
		if x < 0 {
			s0 = -1
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func foldLanes4(xs []int32, initial int32) int32 {
	c0 := simd.BroadcastInt32s(0)
	c1 := simd.BroadcastInt32s(-1)
	c2 := simd.BroadcastInt32s(1)
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		acc0 = acc0.Add(c1.IfElse(x0.Less(c0), c2.IfElse(x0.Greater(c0), c0)))
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		acc1 = acc1.Add(c1.IfElse(x1.Less(c0), c2.IfElse(x1.Greater(c0), c0)))
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(c1.IfElse(x2.Less(c0), c2.IfElse(x2.Greater(c0), c0)))
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(c1.IfElse(x3.Less(c0), c2.IfElse(x3.Greater(c0), c0)))
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		s0 := int32(0)
		if x > 0 {
			s0 = 1
		}
		s1 := s0
		if x < 0 {
			s1 = -1
		}
		accumulator = accumulator + s1
	}
	return accumulator
}

func foldLanes5(xs []int32, ys []int32, initial int32) int32 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	c0 := simd.BroadcastInt32s(0)
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		y0 := simd.LoadInt32s(ys[i : i+step])
		acc0 = acc0.Add(x0.Sub(y0).IfElse(x0.Greater(y0), c0))
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		y1 := simd.LoadInt32s(ys[i+step : i+2*step])
		acc1 = acc1.Add(x1.Sub(y1).IfElse(x1.Greater(y1), c0))
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		y2 := simd.LoadInt32s(ys[i+2*step : i+3*step])
		acc2 = acc2.Add(x2.Sub(y2).IfElse(x2.Greater(y2), c0))
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		y3 := simd.LoadInt32s(ys[i+3*step : i+4*step])
		acc3 = acc3.Add(x3.Sub(y3).IfElse(x3.Greater(y3), c0))
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		y := ys[i]
		s0 := int32(0)
		if x > y {
			s0 = x - y
		}
		accumulator = accumulator + s0
	}
	return accumulator
}

func mapLanes(xs []float64) []float64 {
	c0 := simd.BroadcastFloat64s(0.5)
	out := make([]float64, len(xs))
	step := simd.Float64s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadFloat64s(xs[i : i+step])
		c0.Mul(x).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadFloat64sPart(xs[i:])
		c0.Mul(x).StorePart(out[i:])
	}
	return out
}

func zipLanes(xs []int32, ys []int32) []int32 {
	n := min(len(xs), len(ys))
	xs, ys = xs[:n], ys[:n]
	c0 := simd.BroadcastInt32s(0)
	out := make([]int32, len(xs))
	step := simd.Int32s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadInt32s(xs[i : i+step])
		y := simd.LoadInt32s(ys[i : i+step])
		x.Sub(y).IfElse(x.Greater(y), c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadInt32sPart(xs[i:])
		y, _ := simd.LoadInt32sPart(ys[i:])
		x.Sub(y).IfElse(x.Greater(y), c0).StorePart(out[i:])
	}
	return out
}
