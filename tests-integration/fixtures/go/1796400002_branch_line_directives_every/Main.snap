//line Main.purs:22:1
func insert(x int32, value *Tree) *Tree {
//line Main.purs:23:3
	if value == sharedTreeLeaf {
//line Main.purs:23:11
		return &Tree{Node0: sharedTreeLeaf, Node1: x, Node2: sharedTreeLeaf}
//line Main.purs:23:3
	}
//line Main.purs:24:3
	left := value.Node0
//line Main.purs:24:3
	y := value.Node1
//line Main.purs:24:3
	right := value.Node2
//line Main.purs:25:7
	if x < y {
//line Main.purs:25:16
		return &Tree{Node0: insert(x, left), Node1: y, Node2: right}
//line Main.purs:25:7
	}
//line Main.purs:26:7
	if x > y {
//line Main.purs:26:16
		return &Tree{Node0: left, Node1: y, Node2: insert(x, right)}
//line Main.purs:26:7
	}
//line Main.purs:27:20
	return value
//line Main.purs:22:1
}

//line Main.purs:30:1
func size(value *Tree) int32 {
//line Main.purs:31:3
	if value == sharedTreeLeaf {
//line Main.purs:31:11
		return 0
//line Main.purs:31:3
	}
//line Main.purs:32:24
	return size(value.Node0) + 1 + size(value.Node2)
//line Main.purs:30:1
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import (
	"math"
	"simd/archsimd"
)

//line Main.purs:58:13
func foldLanes(xs []float64, initial float64) float64 {
//line Main.purs:58:13
	acc0 := archsimd.BroadcastFloat64x2(math.Copysign(0, -1))
//line Main.purs:58:13
	acc1, acc2, acc3 := acc0, acc0, acc0
//line Main.purs:58:13
	const step = 2
//line Main.purs:58:13
	i := 0
//line Main.purs:58:13
	for ; i < len(xs)-4*step+1; i += 4 * step {
//line Main.purs:58:13
		x0 := archsimd.LoadFloat64x2(xs[i : i+step])
//line Main.purs:58:13
		acc0 = acc0.Add(x0)
//line Main.purs:58:13
		x1 := archsimd.LoadFloat64x2(xs[i+step : i+2*step])
//line Main.purs:58:13
		acc1 = acc1.Add(x1)
//line Main.purs:58:13
		x2 := archsimd.LoadFloat64x2(xs[i+2*step : i+3*step])
//line Main.purs:58:13
		acc2 = acc2.Add(x2)
//line Main.purs:58:13
		x3 := archsimd.LoadFloat64x2(xs[i+3*step : i+4*step])
//line Main.purs:58:13
		acc3 = acc3.Add(x3)
//line Main.purs:58:13
	}
//line Main.purs:58:13
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
//line Main.purs:58:13
	var lanes [2]float64
//line Main.purs:58:13
	acc0.Store(lanes[:])
//line Main.purs:58:13
	accumulator := initial
//line Main.purs:58:13
	for _, lane := range lanes[:step] {
//line Main.purs:58:13
		accumulator = accumulator + lane
//line Main.purs:58:13
	}
//line Main.purs:58:13
	for ; i < len(xs); i++ {
//line Main.purs:58:13
		x := xs[i]
//line Main.purs:58:13
		accumulator = accumulator + x
//line Main.purs:58:13
	}
//line Main.purs:58:13
	return accumulator
//line Main.purs:58:13
}

