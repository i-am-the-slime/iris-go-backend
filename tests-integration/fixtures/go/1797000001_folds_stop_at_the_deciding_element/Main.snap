// Data/Tuple/tuple.go
package tuple

type Tuple struct {
	First  int32
	Second int32
}

// Partial/Unsafe/unsafe.go
package partialunsafe

func UnsafeCrashWith(msg string) bool {
	panic(msg)
}

// main.go
package main

import (
	"fixture/Partial/Unsafe"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []bool {
	array := []int{1, -2, 0}
	every := true
	for _, element := range array {
		if !positiveUnlessCrashing(element) {
			every = false
			break
		}
	}
	array2 := []int{1, -2, 0}
	found := false
	for _, element := range array2 {
		if negativeUnlessCrashing(element) {
			found = true
			break
		}
	}
	array3 := []int{1, 2, -3, 4}
	every2 := true
	for _, x := range array3 {
		if !(x > 0) {
			every2 = false
			break
		}
	}
	array4 := []int{1, 2, -3, 4}
	found2 := false
	for _, x := range array4 {
		if x < 0 {
			found2 = true
			break
		}
	}
	every3 := true
	for _, x := range []int{} {
		if !(x > 0) {
			every3 = false
			break
		}
	}
	found3 := false
	for _, x := range []int{} {
		if x < 0 {
			found3 = true
			break
		}
	}
	array5 := []int{1, 2, 3, 2}
	every4 := true
	for index, i := range array5 {
		if !(i > index) {
			every4 = false
			break
		}
	}
	array6 := []int{1, 2, 2, 4}
	found4 := false
	for index, i := range array6 {
		if i == index {
			found4 = true
			break
		}
	}
	array7 := []bool{true, false, true}
	every5 := true
	for _, x := range array7 {
		if !x {
			every5 = false
			break
		}
	}
	array8 := []bool{false, true, false}
	found5 := false
	for _, x := range array8 {
		if x {
			found5 = true
			break
		}
	}
	array9 := []int{1, 2, 3, 4}
	found6 := false
	for _, x := range array9 {
		if 3 == x {
			found6 = true
			break
		}
	}
	array10 := []int{1, 2, 3, 4}
	found7 := false
	for _, x := range array10 {
		if 5 == x {
			found7 = true
			break
		}
	}
	array11 := []int{1, -2, 3}
	every6 := true
	for _, x := range array11 {
		if !(x > 0) {
			every6 = false
			break
		}
	}
	array12 := []int{1, -2, 3}
	found8 := false
	for _, x := range array12 {
		if x < 0 {
			found8 = true
			break
		}
	}
	array13 := []int{3, 4, 1}
	every7 := true
	for _, x := range array13 {
		if !(x > 2) {
			every7 = false
			break
		}
	}
	return []bool{every, found, every2, found2, every3, found3, every4, found4, every5, found5, found6, !found7, every6, found8, every7, safeFrom([]int{2, 4, 1}, 3), safeFrom([]int{2, 4, 1}, 5)}
}

func positiveUnlessCrashing(x int) bool {
	if x == 0 {
		return partialunsafe.UnsafeCrashWith("evaluated past the deciding element")
	}
	return x > 0
}

func negativeUnlessCrashing(x int) bool {
	if x == 0 {
		return partialunsafe.UnsafeCrashWith("evaluated past the deciding element")
	}
	return x < 0
}

func safeFrom(placed []int, queen int) bool {
	every := true
	for index, i := range placed {
		var result int
		if i > queen {
			result = i - queen
		} else {
			result = queen - i
		}
		if !(i != queen && result != index+1) {
			every = false
			break
		}
	}
	return every
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, strconv.FormatBool(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
