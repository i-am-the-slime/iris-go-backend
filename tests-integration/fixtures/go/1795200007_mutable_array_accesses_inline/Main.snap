// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

const TagNothing = 0

const TagJust = 1

type String struct {
	Just string
	Tag  uint8
}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

var NoString = String{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	array2 := *array.Thaw([]int32{1, 2, 3})()
	size := int32(len(array2))
	for i := int32(0); i < size; i++ {
		var peeked maybe.Int
		var result int32
		if int(i) < len(array2) {
			peeked = maybe.Int(array2[i])
			if peeked == maybe.NoInt {
				result = 0
			} else {
				result = int32(peeked)
			}
			array2[i] = 2 * result
		} else {
			peeked = maybe.NoInt
			if peeked == maybe.NoInt {
				result = 0
			} else {
				result = int32(peeked)
			}
		}
	}
	size2 := int32(len(array2))
	i2 := array2[size2-1]
	array2[size2-1] = i2 + 1
	var poked bool
	if size2 >= 0 && int(size2) < len(array2) {
		array2[size2] = 0
		poked = true
	} else {
		poked = false
	}
	names := *array.Thaw([]string{"a", "b"})()
	within := 1 < len(names)
	var maybe2 maybe.String
	if within {
		element := names[1]
		maybe2 = maybe.JustString("#" + element)
	} else {
		maybe2 = maybe.NoString
	}
	array3 := shared.Frozen(array2)
	var result2 int32
	if poked {
		result2 = 1
	} else {
		result2 = 0
	}
	var result3 bool
	switch maybe2.Tag {
	case maybe.TagJust:
		result3 = maybe2.Just == "#b"
	default:
		result3 = false
	}
	var result4 int32
	if result3 {
		result4 = 1
	} else {
		result4 = 0
	}
	performed := array.Append(array3, []int32{size, result2, result4})
	return performed
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
