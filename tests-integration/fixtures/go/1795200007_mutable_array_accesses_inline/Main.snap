// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

const TagNothing = 0

const TagJust = 1

type String struct {
	Just string
	Tag  uint8
}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

var NoString = String{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fmt"
	"github.com/i-am-the-slime/purs-backend-go/go-support/array"
	"github.com/i-am-the-slime/purs-backend-go/go-support/exception"
	"github.com/i-am-the-slime/purs-backend-go/go-support/prim"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	array2 := array.Thaw([]int32{1, 2, 3})()
	i := int32(len(*array2))
	for i2 := int32(0); i2 < i; i2++ {
		var peeked maybe.Int
		if i2 >= 0 && int(i2) < len(*array2) {
			peeked = maybe.Int((*array2)[i2])
		} else {
			peeked = maybe.NoInt
		}
		var result int32
		if peeked == maybe.NoInt {
			result = 0
		} else {
			result = int32(peeked)
		}
		if i2 >= 0 && int(i2) < len(*array2) {
			(*array2)[i2] = prim.MultiplyInt32(2, result)
		}
	}
	i3 := int32(len(*array2))
	i4 := (*array2)[i3 - 1]
	(*array2)[i3 - 1] = i4 + 1
	var poked bool
	if i3 >= 0 && int(i3) < len(*array2) {
		(*array2)[i3] = 0
		poked = true
	} else {
		poked = false
	}
	array3 := array.Thaw([]string{"a", "b"})()
	within := 1 < len(*array3)
	var maybe2 maybe.String
	if within {
		element := (*array3)[1]
		maybe2 = maybe.JustString("#" + element)
	} else {
		maybe2 = maybe.NoString
	}
	array4 := array.UnsafeFreeze(array2)()
	var result2 int32
	if poked {
		result2 = 1
	} else {
		result2 = 0
	}
	var result3 bool
	switch maybe2.Tag {
	case maybe.TagJust:
		result3 = maybe2.Just == "#b"
	default:
		result3 = false
	}
	var result4 int32
	if result3 {
		result4 = 1
	} else {
		result4 = 0
	}
	performed := array.Append(array4, []int32{i, result2, result4})
	return performed
}

func main() {
	fmt.Println(main_)
}
