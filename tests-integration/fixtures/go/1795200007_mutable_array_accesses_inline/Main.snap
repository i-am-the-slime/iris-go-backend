// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

type String struct {
	Just string
	Tag  uint8
}

func JustString(just string) String {
	return String{Tag: TagJust, Just: just}
}

var NoString = String{Tag: TagNothing}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	array2 := *array.Thaw([]int{1, 2, 3})
	size := len(array2)
	for i := 0; i < size; i++ {
		var peeked maybe.Int
		if i < len(array2) {
			peeked = maybe.JustInt(array2[i])
		} else {
			peeked = maybe.NoInt
		}
		var result int
		switch peeked.Tag {
		case maybe.TagNothing:
			result = 0
		default: // maybe.TagJust
			result = peeked.Just
		}
		if i < len(array2) {
			array2[i] = 2 * result
		}
	}
	size2 := len(array2)
	last := array2[size2-1]
	array2[size2-1] = last + 1
	var poked bool
	if size2 >= 0 && size2 < len(array2) {
		array2[size2] = 0
		poked = true
	} else {
		poked = false
	}
	names := *array.Thaw([]string{"a", "b"})
	within := len(names) > 1
	var left maybe.String
	if within {
		element := names[1]
		left = maybe.JustString("#" + element)
	} else {
		left = maybe.NoString
	}
	elements := shared.Frozen(array2)
	var result2 int
	if poked {
		result2 = 1
	} else {
		result2 = 0
	}
	var result3 bool
	switch left.Tag {
	case maybe.TagJust:
		result3 = left.Just == "#b"
	default:
		result3 = false
	}
	var result4 int
	if result3 {
		result4 = 1
	} else {
		result4 = 0
	}
	return array.Append(elements, []int{size, result2, result4})
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
