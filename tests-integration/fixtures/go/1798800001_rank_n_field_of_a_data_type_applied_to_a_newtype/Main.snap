// Control/Category/category.go
package category

func Identity(x string) string {
	return x
}

// main.go
package main

import (
	"fixture/Control/Category"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

type RunScopeString struct {
	ForInt    func(int32, func(string) int32) int32
	ForString func(int32, func(string) string) string
}

type LayerInt struct {
	Layer RunScopeString
}

type RunLabelScopeString func(shared.LabelScope, func(string) string) string

type LayerLabelScope struct {
	Layer RunLabelScopeString
}

var main_ = initializeMain_()

func initializeMain_() []string {
	continue_ := scoped.Layer
	continue_2 := labelled.Layer
	return []string{continue_.ForString(3, category.Identity), strconv.Itoa(int(continue_.ForInt(4, func(_ string) int32 {
		return 7
	}))), continue_2(shared.LabelScope{Scope: 5, Label: "outer"}, category.Identity)}
}

var scoped LayerInt = LayerInt{Layer: RunScopeString{ForInt: func(depth int32, done func(string) int32) int32 {
	return done("depth " + strconv.Itoa(int(depth)))
}, ForString: func(depth int32, done func(string) string) string {
	return done("depth " + strconv.Itoa(int(depth)))
}}}

var labelled LayerLabelScope = LayerLabelScope{Layer: func(labelScope shared.LabelScope, done func(string) string) string {
	return done(labelScope.Label + " " + strconv.Itoa(int(labelScope.Scope)))
}}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type LabelScope struct {
	Label string
	Scope int32
}
