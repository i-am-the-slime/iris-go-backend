// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// Data/Semiring/semiring.go
package semiring

func Add(i int, i2 int) int {
	return i + i2
}

// Data/Tuple/tuple.go
package tuple

import (
	hashmap "github.com/i-am-the-slime/iris-go/ffi/Data_HashMap_ffi"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type TupleString struct {
	First  string
	Second int
}

type TupleHashMapIntInt struct {
	First  hashmap.Native[int, int]
	Second int
}

func Show(tuple TupleString) string {
	return string(AppendShow(nil, tuple))
}

func AppendShowArrayTupleStringInt(buffer []byte, array []TupleString) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShow(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShow(buffer []byte, tuple TupleString) []byte {
	buffer = append(buffer, "(Tuple "...)
	buffer = prim.AppendShowString(buffer, tuple.First)
	buffer = append(buffer, ' ')
	buffer = strconv.AppendInt(buffer, int64(tuple.Second), 10)
	buffer = append(buffer, ')')
	return buffer
}

func ArrayTupleStringInt(array []TupleString) string {
	return string(AppendShowArrayTupleStringInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Semiring"
	"fixture/Data/Tuple"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	hashmap "github.com/i-am-the-slime/iris-go/ffi/Data_HashMap_ffi"
	"github.com/i-am-the-slime/iris-go/object"
	"strconv"
	"strings"
)

type Point struct {
	X int
	Y int
}

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []string{"a", "b", "a", ""}
	accumulator := shared.Tally{ByWord: hashmap.NativeEmpty[string, int](), ByFirst: object.Empty[int](), Lengths: hashmap.NativeEmpty[int, int]()}
	accumulator.ByFirst = object.Lend(accumulator.ByFirst)
	accumulator.ByWord = hashmap.Lend(accumulator.ByWord)
	accumulator.Lengths = hashmap.Lend(accumulator.Lengths)
	for _, word := range array {
		nativeLookup := hashmap.NativeLookup(maybe.NoInt, func(payload int) maybe.Int {
			return maybe.JustInt(payload)
		}, nil, word, nil, accumulator.ByWord)
		var seen int
		switch nativeLookup.Tag {
		case maybe.TagNothing:
			seen = 0
		default: // maybe.TagJust
			seen = nativeLookup.Just
		}
		var result int
		if word == "" {
			result = 0
		} else {
			result = 1
		}
		accumulator = shared.Tally{ByWord: hashmap.NativeInsertOwned(nil, nil, word, seen+1, accumulator.ByWord), ByFirst: object.InsertOwned(word, seen+1, accumulator.ByFirst), Lengths: hashmap.NativeInsertWithOwned(nil, nil, semiring.Add, result, 1, accumulator.Lengths)}
	}
	nativeLookup2 := hashmap.NativeLookup(maybe.NoInt, func(payload int) maybe.Int {
		return maybe.JustInt(payload)
	}, nil, 1, nil, accumulator.Lengths)
	var result2 string
	switch nativeLookup2.Tag {
	case maybe.TagJust:
		result2 = "(Just " + strconv.Itoa(nativeLookup2.Just) + ")"
	default: // maybe.TagNothing
		result2 = "Nothing"
	}
	array2 := []int{1, 2, 3, 4}
	accumulator2 := hashmap.Empty[Point, int]()
	for _, n := range array2 {
		k := Point{X: n - 1, Y: 1 - n}
		accumulator2 = hashmap.Insert(eq, hash, Point{X: n, Y: -n}, n, hashmap.Delete(eq, k, k.X*31+k.Y*31, accumulator2))
	}
	array3 := []int{1, 2, 3}
	accumulator3 := tuple.TupleHashMapIntInt{First: hashmap.NativeEmpty[int, int](), Second: 0}
	for _, n := range array3 {
		table := accumulator3.First
		accumulator3 = tuple.TupleHashMapIntInt{First: hashmap.NativeInsert(nil, nil, n, n, table), Second: hashmap.NativeSize(table)}
	}
	return []string{tuple.ArrayTupleStringInt(hashmap.NativeToArrayBy(func(s string, i int) tuple.TupleString {
		return tuple.TupleString{First: s, Second: i}
	}, accumulator.ByWord)), strconv.Itoa(object.Size(accumulator.ByFirst)), result2, strconv.Itoa(hashmap.Size(accumulator2)), "(Tuple " + strconv.Itoa(hashmap.NativeSize(accumulator3.First)) + " " + strconv.Itoa(accumulator3.Second) + ")"}
}

func eq(ra Point, rb Point) bool {
	return ra == rb
}

func hash(record Point) int {
	return record.X*31 + record.Y*31
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

import hashmap "github.com/i-am-the-slime/iris-go/ffi/Data_HashMap_ffi"

type Tally struct {
	ByFirst *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int
}
	ByWord  hashmap.Native[string, int]
	Lengths hashmap.Native[int, int]
}
