// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

var NoInt = Int{Tag: TagNothing}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

// Data/Semiring/semiring.go
package semiring

func Add(i int, i2 int) int {
	return i + i2
}

// Data/Tuple/tuple.go
package tuple

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

type Tuple struct {
	First  string
	Second int
}

func AppendShowArrayTupleStringInt(buffer []byte, array []Tuple) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowTupleStringInt(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowTupleStringInt(buffer []byte, tuple Tuple) []byte {
	buffer = append(buffer, "(Tuple "...)
	buffer = prim.AppendShowString(buffer, tuple.First)
	buffer = append(buffer, ' ')
	buffer = strconv.AppendInt(buffer, int64(tuple.Second), 10)
	buffer = append(buffer, ')')
	return buffer
}

func ArrayTupleStringInt(array []Tuple) string {
	return string(AppendShowArrayTupleStringInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Maybe"
	"fixture/Data/Semiring"
	"fixture/Data/Tuple"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	hashmap "github.com/i-am-the-slime/iris-go/ffi/Data_HashMap_ffi"
	"github.com/i-am-the-slime/iris-go/object"
	"strconv"
	"strings"
)

type Point struct {
	X int
	Y int
}

var main_ = initializeMain_()

func initializeMain_() []string {
	array := []string{"a", "b", "a", ""}
	accumulator := shared.Tally{ByWord: hashmap.NativeEmpty[string, int](), ByFirst: object.Empty[int](), Lengths: hashmap.NativeEmpty[int, int]()}
	accumulator.ByFirst = object.Lend(accumulator.ByFirst)
	accumulator.ByWord = hashmap.Lend(accumulator.ByWord)
	accumulator.Lengths = hashmap.Lend(accumulator.Lengths)
	for _, word := range array {
		nativeLookup := hashmap.NativeLookup(maybe.NoInt, func(payload int) maybe.Int {
			return maybe.JustInt(payload)
		}, nil, word, nil, accumulator.ByWord)
		var seen int
		switch nativeLookup.Tag {
		case maybe.TagNothing:
			seen = 0
		default: // maybe.TagJust
			seen = nativeLookup.Just
		}
		var result int
		if word == "" {
			result = 0
		} else {
			result = 1
		}
		accumulator = shared.Tally{ByWord: hashmap.NativeInsertOwned(nil, nil, word, seen+1, accumulator.ByWord), ByFirst: object.InsertOwned(word, seen+1, accumulator.ByFirst), Lengths: hashmap.NativeInsertWithOwned(nil, nil, semiring.Add, result, 1, accumulator.Lengths)}
	}
	nativeLookup2 := hashmap.NativeLookup(maybe.NoInt, func(payload int) maybe.Int {
		return maybe.JustInt(payload)
	}, nil, 1, nil, accumulator.Lengths)
	var result2 string
	switch nativeLookup2.Tag {
	case maybe.TagJust:
		result2 = "(Just " + strconv.Itoa(nativeLookup2.Just) + ")"
	default: // maybe.TagNothing
		result2 = "Nothing"
	}
	field := hashmap.NativeInsert(nil, nil, 2, 2, hashmap.NativeInsert(nil, nil, 1, 1, hashmap.NativeEmpty[int, int]()))
	return []string{tuple.ArrayTupleStringInt(hashmap.NativeToArrayBy(func(s string, i int) tuple.Tuple {
		return tuple.Tuple{First: s, Second: i}
	}, accumulator.ByWord)), strconv.Itoa(object.Size(accumulator.ByFirst)), result2, strconv.Itoa(hashmap.Size(hashmap.Insert(eq, hash, Point{X: 4, Y: -4}, 4, hashmap.Delete(eq, Point{X: 3, Y: -3}, 0, hashmap.Insert(eq, hash, Point{X: 3, Y: -3}, 3, hashmap.Delete(eq, Point{X: 2, Y: -2}, 0, hashmap.Insert(eq, hash, Point{X: 2, Y: -2}, 2, hashmap.Delete(eq, Point{X: 1, Y: -1}, 0, hashmap.Insert(eq, hash, Point{X: 1, Y: -1}, 1, hashmap.Delete(eq, Point{X: 0, Y: 0}, 0, hashmap.Empty[Point, int]())))))))))), "(Tuple " + strconv.Itoa(hashmap.NativeSize(hashmap.NativeInsert(nil, nil, 3, 3, field))) + " " + strconv.Itoa(hashmap.NativeSize(field)) + ")"}
}

func eq(ra Point, rb Point) bool {
	return ra == rb
}

func hash(record Point) int {
	return record.X*31 + record.Y*31
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

import hashmap "github.com/i-am-the-slime/iris-go/ffi/Data_HashMap_ffi"

type Tally struct {
	ByFirst *struct {
	Index map[string]int
	Ints  int
	Keys  []string
	Vals  []int
}
	ByWord  hashmap.Native[string, int]
	Lengths hashmap.Native[int, int]
}
