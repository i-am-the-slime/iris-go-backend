// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/prim"
	stringspkg "strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	defer exception.ReportUncaught()
	strings := []string{",b", "c"}
	array2 := array.Thaw(strings)()
	accumulator := ",a"
	for _, s := range strings {
		accumulator = s
	}
	direct.SplitAt(prim.CodeUnitLength(","), accumulator)
	performed := array.UnsafeFreeze(array2)()
	return performed
}

func main() {
	console.Print("[" + stringspkg.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type AfterBefore struct {
	After  string
	Before string
}
