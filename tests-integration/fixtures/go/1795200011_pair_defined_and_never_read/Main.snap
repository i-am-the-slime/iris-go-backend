// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	stringspkg "strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	strings := []string{",b", "c"}
	array2 := *array.Thaw(strings)
	accumulator := ",a"
	for _, s := range strings {
		accumulator = s
	}
	direct.SplitAt(int32(1), accumulator)
	performed := shared.Frozen(array2)
	return performed
}

func main() {
	console.Print("[" + stringspkg.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type AfterBefore struct {
	After  string
	Before string
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
