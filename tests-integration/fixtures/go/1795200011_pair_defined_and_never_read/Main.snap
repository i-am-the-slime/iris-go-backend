// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array2 := *array.Thaw([]string{",b", "c"})
	direct.SplitAt(1, "c")
	return shared.Frozen(array2)
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type AfterBefore struct {
	After  string
	Before string
}

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
