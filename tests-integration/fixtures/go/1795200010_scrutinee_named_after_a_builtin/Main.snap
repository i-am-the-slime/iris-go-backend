// main.go
package main

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	xs := []int{4}
	xs2 := []int{}
	pushed := []int{}
	a := array.Append(xs, []int{5})
	if len(a) == 0 {
		pushed = append(pushed, 0)
	} else {
		pushed = append(pushed, 1)
	}
	mapped := make([]int, len(xs))
	for index, value := range xs {
		mapped[index] = value * 2
	}
	if len(mapped) == 1 {
		x := mapped[0]
		pushed = append(pushed, x)
	}
	performed := shared.Frozen(pushed)
	pushed2 := []int{}
	a2 := array.Append(xs2, []int{})
	if len(a2) == 0 {
		pushed2 = append(pushed2, 0)
	} else {
		pushed2 = append(pushed2, 1)
	}
	mapped2 := make([]int, len(xs2))
	for index, value := range xs2 {
		mapped2[index] = value * 2
	}
	if len(mapped2) == 1 {
		x := mapped2[0]
		pushed2 = append(pushed2, x)
	}
	performed2 := shared.Frozen(pushed2)
	return array.Append(performed, performed2)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}

// shared/shared.go
package shared

func Frozen[T any](elements []T) []T {
	return elements[:len(elements):len(elements)]
}
