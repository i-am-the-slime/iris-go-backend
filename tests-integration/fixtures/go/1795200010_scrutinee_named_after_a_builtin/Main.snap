// main.go
package main

import (
	"fmt"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/exception"
)

var main_ = initializeMain_()

func initializeMain_() []int32 {
	defer exception.ReportUncaught()
	xs := []int32{4}
	xs2 := []int32{}
	array2 := &[]int32{}
	a := array.Append(xs, []int32{5})
	if len(a) == 0 {
		*array2 = append(*array2, 0)
	} else {
		*array2 = append(*array2, 1)
	}
	scrutinee := mapLanes(xs)
	if len(scrutinee) == 1 {
		x := scrutinee[0]
		*array2 = append(*array2, x)
	}
	performed := array.UnsafeFreeze(array2)()
	array3 := &[]int32{}
	a2 := array.Append(xs2, []int32{})
	if len(a2) == 0 {
		*array3 = append(*array3, 0)
	} else {
		*array3 = append(*array3, 1)
	}
	scrutinee2 := mapLanes(xs2)
	if len(scrutinee2) == 1 {
		x := scrutinee2[0]
		*array3 = append(*array3, x)
	}
	performed2 := array.UnsafeFreeze(array3)()
	return array.Append(performed, performed2)
}

func main() {
	fmt.Println(main_)
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func mapLanes(xs []int32) []int32 {
	c0 := archsimd.BroadcastInt32x4(2)
	out := make([]int32, len(xs))
	const step = 4
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := archsimd.LoadInt32x4(xs[i : i+step])
		x.Mul(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := archsimd.LoadInt32x4Part(xs[i:])
		x.Mul(c0).StorePart(out[i:])
	}
	return out
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func mapLanes(xs []int32) []int32 {
	out := make([]int32, len(xs))
	for i, x := range xs {
		out[i] = x * 2
	}
	return out
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func mapLanes(xs []int32) []int32 {
	c0 := simd.BroadcastInt32s(2)
	out := make([]int32, len(xs))
	step := simd.Int32s{}.Len()
	i := 0
	for ; i < len(xs)-step+1; i += step {
		x := simd.LoadInt32s(xs[i : i+step])
		x.Mul(c0).Store(out[i : i+step])
	}
	if i < len(xs) {
		x, _ := simd.LoadInt32sPart(xs[i:])
		x.Mul(c0).StorePart(out[i:])
	}
	return out
}
