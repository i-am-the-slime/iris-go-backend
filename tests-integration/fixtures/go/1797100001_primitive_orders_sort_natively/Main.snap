// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayChar(buffer []byte, array []rune) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowChar(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayNumber(buffer []byte, array []float64) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowNumber(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayChar(array []rune) string {
	return string(AppendShowArrayChar(nil, array))
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

func ArrayNumber(array []float64) string {
	return string(AppendShowArrayNumber(nil, array))
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	"fixture/Data/Show"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"math"
	"slices"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	sorted := slices.Clone([]int{5, 3, -7, 3, 2147483647, -2147483648, 0})
	slices.Sort(sorted)
	sorted2 := slices.Clone([]int{})
	slices.Sort(sorted2)
	sorted3 := slices.Clone([]int{9, 1, 8, 2})
	slices.Sort(sorted3)
	sorted4 := slices.Clone([]int{9, 1, 8, 2})
	slices.Sort(sorted4)
	slices.Reverse(sorted4)
	array := shared.SortNumbers(signs)
	mapped := make([]string, len(array))
	for index, element := range array {
		mapped[index] = signed(element)
	}
	var result rune
	if 55296 >= prim.ToCharCode(prim.BottomChar) && 55296 <= prim.ToCharCode(prim.TopChar) {
		result = prim.FromCharCode(55296)
	} else {
		result = 'a'
	}
	var result2 rune
	if 65535 >= prim.ToCharCode(prim.BottomChar) && 65535 <= prim.ToCharCode(prim.TopChar) {
		result2 = prim.FromCharCode(65535)
	} else {
		result2 = 'a'
	}
	sorted5 := slices.Clone([]rune{'q', 'b', 'Z', 'a', result, result2})
	slices.Sort(sorted5)
	sorted6 := slices.Clone([]string{"pear", "apple", "Banana", "", "apple"})
	slices.SortFunc(sorted6, prim.CompareString)
	sorted7 := slices.Clone(surrogates)
	slices.SortFunc(sorted7, prim.CompareString)
	sorted8 := slices.Clone([]int{4, 1, 3})
	slices.Sort(sorted8)
	mapped2 := make([]int, len(sorted8))
	for index, score := range sorted8 {
		mapped2[index] = score
	}
	sorted9 := slices.Clone([]string{"b", "a", "c"})
	slices.SortFunc(sorted9, prim.CompareString)
	mapped3 := make([]string, len(sorted9))
	for index, label := range sorted9 {
		mapped3[index] = label
	}
	sorted10 := slices.Clone(entries)
	slices.SortStableFunc(sorted10, func(x shared.Entry, y shared.Entry) int {
		if x.Rank < y.Rank {
			return -1
		}
		if x.Rank > y.Rank {
			return 1
		}
		return 0
	})
	mapped4 := make([]string, len(sorted10))
	for index := range sorted10 {
		mapped4[index] = sorted10[index].Name
	}
	sorted11 := slices.Clone(entries)
	slices.SortStableFunc(sorted11, func(x shared.Entry, y shared.Entry) int {
		if x.Rank < y.Rank {
			return -1
		}
		if x.Rank > y.Rank {
			return 1
		}
		return 0
	})
	mapped5 := make([]string, len(sorted11))
	for index := range sorted11 {
		mapped5[index] = sorted11[index].Name
	}
	sorted12 := slices.Clone(entries)
	slices.SortStableFunc(sorted12, func(x shared.Entry, y shared.Entry) int {
		if x.Initial < y.Initial {
			return -1
		}
		if x.Initial > y.Initial {
			return 1
		}
		return 0
	})
	mapped6 := make([]string, len(sorted12))
	for index := range sorted12 {
		mapped6[index] = sorted12[index].Name
	}
	sorted13 := slices.Clone(entries)
	slices.SortStableFunc(sorted13, func(x shared.Entry, y shared.Entry) int {
		return prim.CompareString(x.Name, y.Name)
	})
	mapped7 := make([]string, len(sorted13))
	for index := range sorted13 {
		mapped7[index] = sorted13[index].Name
	}
	array2 := direct.SortBy(entries, func(x shared.Entry, y shared.Entry) int {
		number := x.Weight
		number2 := y.Weight
		var result3 ordering.Ordering
		if number < number2 {
			result3 = ordering.OrderingLT
		} else if number == number2 {
			result3 = ordering.OrderingEQ
		} else {
			result3 = ordering.OrderingGT
		}
		switch result3 {
		case ordering.OrderingLT:
			return -1
		case ordering.OrderingGT:
			return 1
		}
		return 0
	})
	mapped8 := make([]string, len(array2))
	for index := range array2 {
		mapped8[index] = array2[index].Name
	}
	sorted14 := slices.Clone(entries)
	slices.SortStableFunc(sorted14, func(x shared.Entry, y shared.Entry) int {
		key := x.Rank*10 - prim.CodeUnitLength(x.Name)
		key2 := y.Rank*10 - prim.CodeUnitLength(y.Name)
		if key < key2 {
			return -1
		}
		if key > key2 {
			return 1
		}
		return 0
	})
	mapped9 := make([]string, len(sorted14))
	for index := range sorted14 {
		mapped9[index] = sorted14[index].Name
	}
	sorted15 := slices.Clone([]string{"ccc", "a", "bb", "d", ""})
	slices.SortStableFunc(sorted15, func(x string, y string) int {
		key := prim.CodeUnitLength(x)
		key2 := prim.CodeUnitLength(y)
		if key < key2 {
			return -1
		}
		if key > key2 {
			return 1
		}
		return 0
	})
	sorted16 := slices.Clone([]int{3, 1, 2, 1})
	slices.SortStableFunc(sorted16, func(x int, y int) int {
		key := -x
		key2 := -y
		if key < key2 {
			return -1
		}
		if key > key2 {
			return 1
		}
		return 0
	})
	sorted17 := slices.Clone(prim.StringToCharArray("hello"))
	slices.Sort(sorted17)
	return []string{show.ArrayInt(sorted), show.ArrayInt(sorted2), show.ArrayInt(sorted3), show.ArrayInt(sorted4), show.ArrayNumber(shared.SortNumbers(numbers)), show.ArrayString(mapped), show.ArrayChar(sorted5), show.ArrayString(sorted6), show.ArrayString(sorted7), show.ArrayInt(mapped2), show.ArrayString(mapped3), show.ArrayString(mapped4), show.ArrayString(mapped5), show.ArrayString(mapped6), show.ArrayString(mapped7), show.ArrayString(mapped8), show.ArrayString(mapped9), show.ArrayString(sorted15), show.ArrayInt(sorted16), prim.CharArrayToString(sorted17)}
}

var numbers = initializeNumbers()

func initializeNumbers() []float64 {
	return []float64{3.0, math.Copysign(0, -1), math.NaN(), math.Inf(1), 0.0, math.Inf(-1), -2.5, math.NaN(), 0.0, math.Copysign(0, -1), 7.25}
}

func signed(n float64) string {
	if n == 0.0 {
		if 1.0/n < 0.0 {
			return "-0"
		}
		return "+0"
	}
	return prim.ShowNumber(n)
}

var signs = initializeSigns()

func initializeSigns() []float64 {
	return []float64{0.0, math.Copysign(0, -1), 1.0, math.Copysign(0, -1), 0.0, -1.0}
}

var surrogates []string = []string{"｡", "😀", "b", "", "a😀", "aa", "", "\xed\xa0\xbd", "\xed\xb8\x80", "a", "😀", "￿"}

var entries = initializeEntries()

func initializeEntries() []shared.Entry {
	return []shared.Entry{{Name: "delta", Rank: 2, Weight: 0.5, Initial: 'd'}, {Name: "alpha", Rank: 1, Weight: math.Copysign(0, -1), Initial: 'a'}, {Name: "echo", Rank: 2, Weight: 0.0, Initial: 'e'}, {Name: "bravo", Rank: 1, Weight: math.NaN(), Initial: 'b'}, {Name: "charlie", Rank: 3, Weight: 0.5, Initial: 'c'}, {Name: "foxtrot", Rank: 1, Weight: -1.0, Initial: 'a'}}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

func SortNumbers(xs []float64) []float64 {
	sorted := make([]float64, len(xs))
	copy(sorted, xs)
	if len(xs) < 2 {
		return sorted
	}
	scratch := make([]float64, len(xs))
	copy(scratch, xs)
	var merge func(into []float64, from []float64, low int, high int)
	merge = func(into []float64, from []float64, low int, high int) {
		middle := low + (high-low)>>1
		if middle-low > 1 {
			merge(from, into, low, middle)
		}
		if high-middle > 1 {
			merge(from, into, middle, high)
		}
		i, j, k := low, middle, low
		for i < middle && j < high {
			if from[i] <= from[j] {
				into[k] = from[i]
				i++
			} else {
				into[k] = from[j]
				j++
			}
			k++
		}
		k += copy(into[k:], from[i:middle])
		copy(into[k:], from[j:high])
	}
	merge(sorted, scratch, 0, len(xs))
	return sorted
}

type Entry struct {
	Name    string
	Weight  float64
	Initial rune
	Rank    int
}
