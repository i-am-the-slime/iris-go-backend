func foldr(step func(any) func(any) any, initial any, wrapped *WrappedArray) any {
	return array.Foldr(func(argument any, argument2 any) any {
		return step(argument)(argument2)
	}, initial, wrapped.Wrapped)
}

func foldl(step func(any) func(any) any, initial any, wrapped *WrappedArray) any {
	return array.Foldl(func(argument any, argument2 any) any {
		return step(argument)(argument2)
	}, initial, wrapped.Wrapped)
}

func counted(foldableDictionary shared.FoldMapFoldlFoldr, depth int32, values any) int32 {
	for {
		foldableDictionaryCaptured := foldableDictionary
		switch depth {
		case 0:
			original := foldableDictionaryCaptured.Foldl(func(coerced any) func(any) any {
				function := func(c int32, _ int32) int32 {
					return 1 + c
				}
				i := coerced.(int32)
				return func(coerced2 any) any {
					return function(i, coerced2.(int32))
				}
			})
			original2 := foldableDictionaryCaptured.Foldl(func(coerced any) func(any) any {
				i := coerced.(int32)
				return func(coerced2 any) any {
					return semiring.Add(i, coerced2.(int32))
				}
			})
			return func(coerced int32) func(any) int32 {
				original3 := original(coerced)
				return func(coerced2 any) int32 {
					return original3(coerced2).(int32)
				}
			}(0)(values) + func(coerced int32) func(any) int32 {
				original3 := original2(coerced)
				return func(coerced2 any) int32 {
					return original3(coerced2).(int32)
				}
			}(0)(values)
		default:
			foldableDictionary, depth, values = shared.FoldMapFoldlFoldr{FoldMap: func(coerced shared.Semigroup0Mempty) func(func(any) any) func(any) any {
				original := func(visit func(any) any) func(*Wrapped) any {
					return func(wrapped *Wrapped) any {
						return foldableDictionaryCaptured.FoldMap(coerced)(visit)(wrapped.Wrapped)
					}
