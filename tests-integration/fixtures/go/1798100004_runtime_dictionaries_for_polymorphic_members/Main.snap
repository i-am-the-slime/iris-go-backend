func foldrArray(step func(any) func(any) any, initial any, wrapped *WrappedArray) any {
	return array.Foldr(func(argument any, argument2 any) any {
		return step(argument)(argument2)
	}, initial, wrapped.Wrapped)
}

func foldlArray(step func(any) func(any) any, initial any, wrapped *WrappedArray) any {
	return array.Foldl(func(argument any, argument2 any) any {
		return step(argument)(argument2)
	}, initial, wrapped.Wrapped)
}

func mapWrapped(change func(any) any, wrapped *WrappedArray) *WrappedArray {
	return &WrappedArray{Wrapped: array.Map(change, wrapped.Wrapped)}
}

func applyEffect(change func() func(any) any, inner func() any) any {
	f := change()
	argument := inner()
	return f(argument)
}

func mapLift(change func(any) any, inner func() any) any {
	argument := inner()
	return change(argument)
}

func bindEffect(inner func() any, next func(any) any) any {
	argument := inner()
	return next(argument)
}

func bindMaybe(inner *maybe.Maybe, next func(any) *maybe.Maybe) *maybe.Maybe {
	switch inner.Tag {
	case maybe.TagJust:
		return next(inner.Just)
	default: // maybe.TagNothing
		return maybe.No
	}
}

