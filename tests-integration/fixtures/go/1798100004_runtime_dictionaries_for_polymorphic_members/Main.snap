func checkedWrappedArray(traversableDictionary shared.Foldable1Functor0SequenceTraverse, depth int32, values any) maybe.Int {
	for {
		traversableDictionaryCaptured := traversableDictionary
		switch depth {
		case 0:
			original2 := func(change func(any) any) func(*maybe.Maybe) *maybe.Maybe {
				return func(inner *maybe.Maybe) *maybe.Maybe {
					return maybe.Apply(change, inner)
				}
			}
			original3 := func(n int32) maybe.Int {
				if n > 0 {
					return maybe.Int(n)
				}
				return maybe.NoInt
			}
			original4 := traversableDictionaryCaptured.Traverse(shared.Apply0Pure{Apply0: shared.Functor0Apply{Functor0: shared.Map{Map: func(coerced func(any) any) func(any) any {
				original := func(inner *maybe.Maybe) *maybe.Maybe {
					return maybe.Map_(coerced, inner)
				}
				return func(coerced2 any) any {
					return original(coerced2.(*maybe.Maybe))
				}
			}}, Apply: func(coerced any) func(any) any {
				original := original2(maybe.Convert(coerced.(*maybe.Maybe)))
				return func(coerced2 any) any {
					return original(coerced2.(*maybe.Maybe))
				}
			}}, Pure: func(coerced any) any {
				return maybe.Pure(coerced)
			}})(func(coerced any) any {
				return maybe.Convert2(original3(coerced.(int32)))
			})
			scrutinee := func(coerced any) *maybe.Int2 {
				return maybe.Convert4(original4(coerced).(*maybe.Maybe))
			}(values)
			switch scrutinee.Tag {
			case maybe.TagJust:
				original := traversableDictionaryCaptured.Foldable1.Foldl(func(coerced any) func(any) any {
					i := coerced.(int32)
					return func(coerced2 any) any {
						return semiring.Add(i, coerced2.(int32))
					}
				})
				return maybe.Int(func(coerced int32) func(any) int32 {
					original5 := original(coerced)
					return func(coerced2 any) int32 {
						return original5(coerced2).(int32)
					}
				}(0)(scrutinee.Just))
			default:
				return maybe.NoInt
			}
		default:
			traversableDictionary, depth, values = shared.Foldable1Functor0SequenceTraverse{Foldable1: shared.FoldMapFoldlFoldr{FoldMap: func(coerced shared.Semigroup0Mempty) func(func(any) any) func(any) any {
				original := func(visit func(any) any) func(*Wrapped) any {
					return func(wrapped *Wrapped) any {
