// Control/Category/category.go
package category

func Pure(x any) any {
	return x
}

// Data/Maybe/maybe.go
package maybe

const TagNothing = 0

const TagJust = 1

type Int struct {
	Just int
	Tag  uint8
}

type Maybe struct {
	Just   any
	Origin any
	Tag    uint8
}

func Convert(value *Maybe) func(any) any {
	switch value.Tag {
	case TagNothing:
		return nil
	default: // TagJust
		return value.Just.(func(any) any)
	}
}

func JustInt(just int) Int {
	return Int{Tag: TagJust, Just: just}
}

func Convert2(value Int) *Maybe {
	switch value.Tag {
	case TagNothing:
		return &Maybe{Tag: TagNothing, Origin: value}
	default: // TagJust
		return &Maybe{Tag: TagJust, Just: value.Just, Origin: value}
	}
}

var NoInt = Int{Tag: TagNothing}

func Convert3(value *Maybe) Int {
	if original, ok := value.Origin.(Int); ok {
		return original
	}
	switch value.Tag {
	case TagNothing:
		return NoInt
	default: // TagJust
		return JustInt(value.Just.(int))
	}
}

type ArrayInt struct {
	Just []int
	Tag  uint8
}

func JustArrayInt(just []int) ArrayInt {
	return ArrayInt{Tag: TagJust, Just: just}
}

var NoArrayInt = ArrayInt{Tag: TagNothing}

var No = &Maybe{Tag: TagNothing}

type Int2 struct {
	Just any
	Tag  uint8
}

func Convert4(value *Maybe) *Int2 {
	if value == nil {
		return nil
	}
	switch value.Tag {
	case TagNothing:
		return &Int2{Tag: TagNothing}
	default: // TagJust
		return &Int2{Tag: TagJust, Just: value.Just}
	}
}

func Pure(x any) *Maybe {
	return &Maybe{Tag: TagJust, Just: x}
}

func Apply(change func(any) any, inner *Maybe) *Maybe {
	if change != nil {
		switch inner.Tag {
		case TagJust:
			return &Maybe{Tag: TagJust, Just: change(inner.Just)}
		default:
			return No
		}
	}
	return No
}

func Map_(change func(any) any, inner *Maybe) *Maybe {
	switch inner.Tag {
	case TagJust:
		return &Maybe{Tag: TagJust, Just: change(inner.Just)}
	default:
		return No
	}
}

// Data/Semigroup/semigroup.go
package semigroup

import "github.com/i-am-the-slime/iris-go/prim"

func Append_(s string, s2 string) string {
	return prim.Append(s, s2)
}

// Data/Semiring/semiring.go
package semiring

func Add(i int, i2 int) int {
	return i + i2
}

// Data/Show/show.go
package show

import "strconv"

func Show(i int) string {
	return strconv.Itoa(i)
}

