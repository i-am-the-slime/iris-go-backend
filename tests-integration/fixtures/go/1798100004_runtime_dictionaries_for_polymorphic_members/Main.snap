// Control/Category/category.go
package category

func Pure(x any) any {
	return x
}

// Data/Maybe/maybe.go
package maybe

type Int int64

const NoInt Int = 1 << 32

const TagNothing = 0

const TagJust = 1

type Maybe struct {
	Just   any
	Origin any
	Tag    uint8
}

func Convert(value *Maybe) func(any) any {
	switch value.Tag {
	case TagNothing:
		return nil
	default: // TagJust
		return value.Just.(func(any) any)
	}
}

func Convert2(value Int) *Maybe {
	if value == NoInt {
		return &Maybe{Tag: TagNothing, Origin: value}
	}
	return &Maybe{Tag: TagJust, Just: int32(value), Origin: value}
}

func Convert3(value *Maybe) Int {
	if original, ok := value.Origin.(Int); ok {
		return original
	}
	switch value.Tag {
	case TagNothing:
		return NoInt
	default: // TagJust
		return Int(value.Just.(int32))
	}
}

type ArrayInt struct {
	Just []int32
	Tag  uint8
}

func JustArrayInt(just []int32) ArrayInt {
	return ArrayInt{Tag: TagJust, Just: just}
}

var NoArrayInt = ArrayInt{Tag: TagNothing}

type Int2 struct {
	Just any
	Tag  uint8
}

func Convert4(value *Maybe) *Int2 {
	switch value.Tag {
	case TagNothing:
		return &Int2{Tag: TagNothing}
	default: // TagJust
		return &Int2{Tag: TagJust, Just: value.Just}
	}
}

var No = &Maybe{Tag: TagNothing}

func Pure(x any) *Maybe {
	return &Maybe{Tag: TagJust, Just: x}
}

func Apply(change func(any) any, inner *Maybe) *Maybe {
	if change != nil {
		switch inner.Tag {
		case TagJust:
			return &Maybe{Tag: TagJust, Just: change(inner.Just)}
		default:
			return No
		}
	}
	return No
}

func Map_(change func(any) any, inner *Maybe) *Maybe {
	switch inner.Tag {
	case TagJust:
		return &Maybe{Tag: TagJust, Just: change(inner.Just)}
	default:
		return No
	}
}

// Data/Semigroup/semigroup.go
package semigroup

import "github.com/i-am-the-slime/iris-go/prim"

func Append_(s string, s2 string) string {
	return prim.Append(s, s2)
}

// Data/Semiring/semiring.go
package semiring

func Add(i int32, i2 int32) int32 {
	return i + i2
}

// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

