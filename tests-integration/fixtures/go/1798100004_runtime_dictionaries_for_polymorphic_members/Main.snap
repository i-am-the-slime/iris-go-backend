func apply(change func() func(any) any, inner func() any) any {
	f := change()
	argument := inner()
	return f(argument)
}

func mapLift(change func(any) any, inner func() any) any {
	argument := inner()
	return change(argument)
}

func bindEffect(inner func() any, next func(any) any) any {
	argument := inner()
	return next(argument)
}

func stepped(monadDictionary shared.Applicative0Bind1, depth int32, action any) any {
	for {
		monadDictionaryCaptured := monadDictionary
		switch depth {
		case 0:
			original2 := func(n int32) any {
				original := func(m int32) any {
					return func(coerced int32) any {
						return monadDictionaryCaptured.Applicative0.Pure(coerced)
					}(m + 1)
				}
				return monadDictionaryCaptured.Bind1.Bind(func(coerced int32) any {
					return monadDictionaryCaptured.Applicative0.Pure(coerced)
				}(n * 10))(func(coerced any) any {
					return original(coerced.(int32))
				})
			}
			return monadDictionaryCaptured.Bind1.Bind(action)(func(coerced any) any {
				return original2(coerced.(int32))
			})
		default:
			monadDictionary, depth = shared.Applicative0Bind1{Applicative0: shared.Apply0Pure{Apply0: shared.Functor0Apply{Functor0: shared.Map{Map: func(change func(any) any) func(any) any {
				return func(inner any) any {
					return monadDictionaryCaptured.Applicative0.Apply0.Functor0.Map(change)(inner)
				}
			}}, Apply: func(change any) func(any) any {
				return func(inner any) any {
					return monadDictionaryCaptured.Applicative0.Apply0.Apply(change)(inner)
				}
			}}, Pure: monadDictionaryCaptured.Applicative0.Pure}, Bind1: shared.Apply0Bind{Apply0: shared.Functor0Apply{Functor0: shared.Map{Map: func(change func(any) any) func(any) any {
				return func(inner any) any {
					return monadDictionaryCaptured.Bind1.Apply0.Functor0.Map(change)(inner)
				}
			}}, Apply: func(change any) func(any) any {
				return func(inner any) any {
					return monadDictionaryCaptured.Bind1.Apply0.Apply(change)(inner)
				}
			}}, Bind: func(inner any) func(func(any) any) any {
				return func(next func(any) any) any {
					return monadDictionaryCaptured.Bind1.Bind(inner)(next)
				}
			}}}, depth-1
			continue
		}
	}
}

func bindMaybe(inner *maybe.Maybe, next func(any) *maybe.Maybe) *maybe.Maybe {
	switch inner.Tag {
	case maybe.TagJust:
		return next(inner.Just)
	default: // maybe.TagNothing
		return maybe.No
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// main_neon.go
//go:build goexperiment.simd && arm64

package main

import "simd/archsimd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := archsimd.BroadcastInt32x4(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	const step = 4
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := archsimd.LoadInt32x4(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := archsimd.LoadInt32x4(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := archsimd.LoadInt32x4(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := archsimd.LoadInt32x4(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [4]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// main_scalar.go
//go:build !(goexperiment.simd && (arm64 || wasm))

package main

func foldLanes(xs []int32, initial int32) int32 {
	accumulator := initial
	for _, x := range xs {
		accumulator = accumulator + x
	}
	return accumulator
}

// main_vector.go
//go:build goexperiment.simd && wasm

package main

import "simd"

func foldLanes(xs []int32, initial int32) int32 {
	acc0 := simd.BroadcastInt32s(0)
	acc1, acc2, acc3 := acc0, acc0, acc0
	step := acc0.Len()
	i := 0
	for ; i < len(xs)-4*step+1; i += 4 * step {
		x0 := simd.LoadInt32s(xs[i : i+step])
		acc0 = acc0.Add(x0)
		x1 := simd.LoadInt32s(xs[i+step : i+2*step])
		acc1 = acc1.Add(x1)
		x2 := simd.LoadInt32s(xs[i+2*step : i+3*step])
		acc2 = acc2.Add(x2)
		x3 := simd.LoadInt32s(xs[i+3*step : i+4*step])
		acc3 = acc3.Add(x3)
	}
	acc0 = acc0.Add(acc1).Add(acc2.Add(acc3))
	var lanes [16]int32
	acc0.Store(lanes[:])
	accumulator := initial
	for _, lane := range lanes[:step] {
		accumulator = accumulator + lane
	}
	for ; i < len(xs); i++ {
		x := xs[i]
		accumulator = accumulator + x
	}
	return accumulator
}

// shared/shared.go
package shared

type Append struct {
	Append func(any) func(any) any
}

type Semigroup0Mempty struct {
	Semigroup0 Append
	Mempty     any
}

type FoldMapFoldlFoldr struct {
	FoldMap func(Semigroup0Mempty) func(func(any) any) func(any) any
	Foldl   func(func(any) func(any) any) func(any) func(any) any
	Foldr   func(func(any) func(any) any) func(any) func(any) any
}

func Convert(value []int32) any {
	converted := make([]any, len(value))
	for index, element := range value {
		converted[index] = element
	}
	return converted
}

type Map struct {
	Map func(func(any) any) func(any) any
}

type Functor0Apply struct {
	Functor0 Map
	Apply    func(any) func(any) any
}

type Apply0Pure struct {
	Apply0 Functor0Apply
	Pure   func(any) any
}

type Apply0Bind struct {
	Apply0 Functor0Apply
	Bind   func(any) func(func(any) any) any
}

type Applicative0Bind1 struct {
	Applicative0 Apply0Pure
	Bind1        Apply0Bind
}

type Foldable1Functor0SequenceTraverse struct {
	Foldable1 FoldMapFoldlFoldr
	Functor0  Map
	Sequence  func(Apply0Pure) func(any) any
	Traverse  func(Apply0Pure) func(func(any) any) func(any) any
}

