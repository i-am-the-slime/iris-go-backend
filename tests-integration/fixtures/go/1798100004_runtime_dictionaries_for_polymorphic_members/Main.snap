func checkedArray(depth int32, values []int32) maybe.Int {
	switch depth {
	case 0:
		accumulator := maybe.JustArrayInt([]int32{})
		accumulator.Just = slices.Clip(accumulator.Just)
		for _, element := range values {
			if accumulator.Tag == maybe.TagNothing {
				break
			}
			switch accumulator.Tag {
			case maybe.TagJust:
				if element > 0 {
					accumulator = maybe.JustArrayInt(array.Bounded(append(accumulator.Just, element)))
				} else {
					accumulator = maybe.NoArrayInt
				}
			default:
				accumulator = maybe.NoArrayInt
			}
		}
		switch accumulator.Tag {
		case maybe.TagJust:
			return maybe.Int(foldLanes(accumulator.Just, 0))
		default:
			return maybe.NoInt
		}
	default:
		original2 := func(dictionary shared.Apply0Pure) func(*WrappedArray2) any {
			return func(wrapped *WrappedArray2) any {
				append_ := direct.Appender[any]()
				accumulator := func(coerced []any) any {
					return dictionary.Pure(coerced)
				}([]any{})
				for _, element := range wrapped.Wrapped {
					accumulator = dictionary.Apply0.Apply(dictionary.Apply0.Functor0.Map(func(coerced any) any {
						original := append_(coerced.([]any))
						return func(coerced2 any) any {
							return original(coerced2)
						}
					})(accumulator))(element)
				}
				return dictionary.Apply0.Functor0.Map(func(coerced any) any {
					return convert3(WrappedWrappedArray(coerced.([]any)))
				})(accumulator)
			}
		}
		original3 := func(dictionary shared.Apply0Pure) func(func(any) any) func(*WrappedArray) any {
			return func(visit func(any) any) func(*WrappedArray) any {
				return func(wrapped *WrappedArray) any {
					append_ := direct.Appender[any]()
					accumulator := func(coerced []any) any {
						return dictionary.Pure(coerced)
					}([]any{})
					for _, element := range wrapped.Wrapped {
						accumulator = dictionary.Apply0.Apply(dictionary.Apply0.Functor0.Map(func(coerced any) any {
							original := append_(coerced.([]any))
							return func(coerced2 any) any {
								return original(coerced2)
							}
						})(accumulator))(visit(element))
					}
					return dictionary.Apply0.Functor0.Map(func(coerced any) any {
						return convert3(WrappedWrappedArray(coerced.([]any)))
					})(accumulator)
				}
			}
		}
		return checkedWrappedArray(shared.Foldable1Functor0SequenceTraverse{Foldable1: shared.FoldMapFoldlFoldr{FoldMap: func(coerced shared.Semigroup0Mempty) func(func(any) any) func(any) any {
			original := func(visit func(any) any) func(*WrappedArray) any {
				return func(wrapped *WrappedArray) any {
					accumulator := coerced.Mempty
					for index := len(wrapped.Wrapped) - 1; index >= 0; index-- {
						x := wrapped.Wrapped[index]
						accumulator = coerced.Semigroup0.Append(visit(x))(accumulator)
					}
					return accumulator
				}
			}
			return func(coerced2 func(any) any) func(any) any {
				original4 := original(coerced2)
				return func(coerced3 any) any {
					return original4(convert(coerced3.(*Wrapped)))
				}
			}
		}, Foldl: func(coerced func(any) func(any) any) func(any) func(any) any {
			original := func(initial any) func(*WrappedArray) any {
				return func(wrapped *WrappedArray) any {
					return foldl(coerced, initial, wrapped)
				}
			}
			return func(coerced2 any) func(any) any {
				original4 := original(coerced2)
				return func(coerced3 any) any {
					return original4(convert(coerced3.(*Wrapped)))
				}
			}
		}, Foldr: func(coerced func(any) func(any) any) func(any) func(any) any {
			original := func(initial any) func(*WrappedArray) any {
				return func(wrapped *WrappedArray) any {
