type WrappedArray struct {
	Wrapped []any
	Origin  any
}

type Wrapped struct {
	Wrapped any
	Origin  any
}

func convert(value *Wrapped) *WrappedArray {
	if value == nil {
		return nil
	}
	if original, ok := value.Origin.(*WrappedArray); ok {
		return original
	}
	return &WrappedArray{Wrapped: value.Wrapped.([]any), Origin: value}
}

type WrappedArrayInt struct {
	Wrapped []int
}

func convert2(value WrappedArrayInt) *Wrapped {
	return &Wrapped{Wrapped: shared.Convert(value.Wrapped)}
}

func convert3(value *WrappedArray) *Wrapped {
	if value == nil {
		return nil
	}
	if original, ok := value.Origin.(*Wrapped); ok {
		return original
	}
	return &Wrapped{Wrapped: value.Wrapped, Origin: value}
}

type WrappedArray2 struct {
	Wrapped []any
}

func WrappedWrappedArray(wrapped []any) *WrappedArray {
	return &WrappedArray{Wrapped: wrapped}
}

func convert4(value *Wrapped) *WrappedArray2 {
	if value == nil {
		return nil
	}
	return &WrappedArray2{Wrapped: value.Wrapped.([]any)}
}

type WrappedInt struct {
	Wrapped any
	Origin  any
}

func convert5(value *WrappedInt) *Wrapped {
	if value == nil {
		return nil
	}
	return &Wrapped{Wrapped: value.Wrapped}
}

type Wrapped2 struct {
