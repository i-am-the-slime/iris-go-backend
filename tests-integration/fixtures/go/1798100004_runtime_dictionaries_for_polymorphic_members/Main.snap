					}
				}
				return func(coerced2 func(any) any) func(any) any {
					original2 := original(coerced2)
					return func(coerced3 any) any {
						return original2(coerced3.(*Wrapped))
					}
				}
			}, Foldl: func(coerced func(any) func(any) any) func(any) func(any) any {
				original := func(initial any) func(*Wrapped) any {
					return func(wrapped *Wrapped) any {
						return traversableDictionaryCaptured.Foldable1.Foldl(coerced)(initial)(wrapped.Wrapped)
					}
				}
				return func(coerced2 any) func(any) any {
					original2 := original(coerced2)
					return func(coerced3 any) any {
						return original2(coerced3.(*Wrapped))
					}
				}
			}, Foldr: func(coerced func(any) func(any) any) func(any) func(any) any {
				original := func(initial any) func(*Wrapped) any {
					return func(wrapped *Wrapped) any {
						return traversableDictionaryCaptured.Foldable1.Foldr(coerced)(initial)(wrapped.Wrapped)
					}
				}
				return func(coerced2 any) func(any) any {
					original2 := original(coerced2)
					return func(coerced3 any) any {
						return original2(coerced3.(*Wrapped))
					}
				}
			}}, Functor0: shared.Map{Map: func(coerced func(any) any) func(any) any {
				original := func(wrapped *Wrapped) *Wrapped {
					return &Wrapped{Wrapped: traversableDictionaryCaptured.Functor0.Map(coerced)(wrapped.Wrapped)}
				}
				return func(coerced2 any) any {
					return original(coerced2.(*Wrapped))
				}
			}}, Sequence: func(coerced shared.Apply0Pure) func(any) any {
				original := func(wrapped *Wrapped2) any {
					return coerced.Apply0.Functor0.Map(func(coerced2 any) any {
						return WrappedWrapped(coerced2)
					})(traversableDictionaryCaptured.Traverse(coerced)(category.Pure)(wrapped.Wrapped))
				}
				return func(coerced2 any) any {
