// Data/Variant/variant.go
package variant

import "fixture/shared"

type CountFlagNamePointRatioTags struct {
	Name  string
	Tags  []string
	Ratio float64
	Count int32
	Point shared.X
	Tag   uint8
	Flag  bool
}

const (
	CountFlagNamePointRatioTagsCount = iota
	CountFlagNamePointRatioTagsFlag
	CountFlagNamePointRatioTagsName
	CountFlagNamePointRatioTagsPoint
	CountFlagNamePointRatioTagsRatio
	CountFlagNamePointRatioTagsTags
)

