// Data/Variant/variant.go
package variant

import (
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
)

type CountFlagNamePointRatioTags struct {
	Name  string
	Tags  []string
	Ratio float64
	Count int32
	Point shared.X
	Tag   uint8
	Flag  bool
}

const (
	CountFlagNamePointRatioTagsCount = iota
	CountFlagNamePointRatioTagsFlag
	CountFlagNamePointRatioTagsName
	CountFlagNamePointRatioTagsPoint
	CountFlagNamePointRatioTagsRatio
	CountFlagNamePointRatioTagsTags
)

func EncodeJSONX(e *foreignvalue.Encoder, value shared.X) {
	e.Raw("{\"x\":")
	e.Int(value.X)
	e.Raw("}")
}

func EncodeJSONArrayString(e *foreignvalue.Encoder, value []string) {
	e.Raw("[")
	for index, item := range value {
		if index > 0 {
			e.Raw(",")
		}
		e.String(item)
	}
	e.Raw("]")
}

func EncodeJSONVariantCountFlagNamePointRatioTags(e *foreignvalue.Encoder, value CountFlagNamePointRatioTags) {
	switch value.Tag {
	case CountFlagNamePointRatioTagsCount:
		e.Raw("{\"count\":")
		e.Int(value.Count)
		e.Raw("}")
	case CountFlagNamePointRatioTagsFlag:
		e.Raw("{\"flag\":")
		e.Boolean(value.Flag)
		e.Raw("}")
	case CountFlagNamePointRatioTagsName:
		e.Raw("{\"name\":")
		e.String(value.Name)
		e.Raw("}")
	case CountFlagNamePointRatioTagsPoint:
		e.Raw("{\"point\":")
		EncodeJSONX(e, value.Point)
		e.Raw("}")
	case CountFlagNamePointRatioTagsRatio:
		e.Raw("{\"ratio\":")
		e.Number(value.Ratio)
		e.Raw("}")
	case CountFlagNamePointRatioTagsTags:
		e.Raw("{\"tags\":")
		EncodeJSONArrayString(e, value.Tags)
		e.Raw("}")
	}
}

func Name(name string) CountFlagNamePointRatioTags {
	return CountFlagNamePointRatioTags{Tag: CountFlagNamePointRatioTagsName, Name: name}
}

func Point(point shared.X) CountFlagNamePointRatioTags {
	return CountFlagNamePointRatioTags{Tag: CountFlagNamePointRatioTagsPoint, Point: point}
}

func Count(count int32) CountFlagNamePointRatioTags {
	return CountFlagNamePointRatioTags{Tag: CountFlagNamePointRatioTagsCount, Count: count}
}

func Ratio(ratio float64) CountFlagNamePointRatioTags {
	return CountFlagNamePointRatioTags{Tag: CountFlagNamePointRatioTagsRatio, Ratio: ratio}
}

func Flag(flag bool) CountFlagNamePointRatioTags {
	return CountFlagNamePointRatioTags{Tag: CountFlagNamePointRatioTagsFlag, Flag: flag}
}

func Tags(tags []string) CountFlagNamePointRatioTags {
	return CountFlagNamePointRatioTags{Tag: CountFlagNamePointRatioTagsTags, Tags: tags}
}

// main.go
package main

import (
	"fixture/Data/Variant"
	shared2 "fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/object"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	var shared any = "12"
	mapped := make([]string, len(shapes))
	for index, variant2 := range shapes {
		mapped[index] = foreignvalue.Encode(variant.EncodeJSONVariantCountFlagNamePointRatioTags, variant2)
	}
	object2 := object.New[any]()()
	performed := object.Poke("f", shared, object2)()
	return array.Append(mapped, []string{foreignvalue.UnsafeStringify(object.Insert("e", shared, performed))})
}

var shapes []variant.CountFlagNamePointRatioTags = []variant.CountFlagNamePointRatioTags{variant.Name("a"), variant.Point(shared2.X{X: 1}), variant.Count(3), variant.Ratio(1.5), variant.Flag(true), variant.Tags([]string{"p", "q"})}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type X struct {
	X int32
}
