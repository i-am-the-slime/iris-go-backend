					if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
						integer = maybe.Int(int32(number))
					} else {
						integer = maybe.NoInt
					}
					if integer == maybe.NoInt {
						result5 = foreign.LeftEitherNonEmptyListForeignErrorInt(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
					} else {
						result5 = foreign.RightEitherNonEmptyListForeignErrorInt(int32(integer))
					}
				} else {
					result5 = foreign.LeftEitherNonEmptyListForeignErrorInt(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
				}
