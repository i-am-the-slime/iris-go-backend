		return shared.Header{}, new(foreign.NonEmptyListForeignError{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil})
	default: // either.EitherErrorForeignRight
		return ReadImplHeaderConsStringConsStringNil(performed.Right)
	}
}

func ReadImplPairConsIntConsIntNil(o any) (shared.Pair, *foreign.NonEmptyListForeignError) {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
		return foreign.LeftEitherNonEmptyListForeignErrorForeign(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.PureIdentityNonEmptyListForeignError, "A", o)
	var i int32
	var err *foreign.NonEmptyListForeignError
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherNonEmptyListForeignErrorForeignLeft:
		err = new(unsafeReadPropImpl.Left)
	default: // foreign.EitherNonEmptyListForeignErrorForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "Number" {
			number := foreignvalue.Number(b)
			var integer maybe.Int
			if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
				integer = maybe.Int(int32(number))
			} else {
				integer = maybe.NoInt
			}
			if integer == maybe.NoInt {
				err = new(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
			} else {
				i, err = int32(integer), nil
			}
		} else {
			err = new(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
		}
	}
	var result foreign.EitherNonEmptyListForeignErrorFnAOfIntPair
	if err != nil {
		result = foreign.LeftEitherNonEmptyListForeignErrorFnAOfIntPair(foreign.MapListFunction("A", *err))
	} else {
		result = foreign.RightEitherNonEmptyListForeignErrorFnAOfIntPair(func(r1 shared.AOfInt) shared.Pair {
			return shared.Pair{A: r1.A, A_: i}
		})
	}
	unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
		return foreign.LeftEitherNonEmptyListForeignErrorForeign(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.PureIdentityNonEmptyListForeignError, "a", o)
	var i2 int32
	var err2 *foreign.NonEmptyListForeignError
	switch unsafeReadPropImpl2.Tag {
	case foreign.EitherNonEmptyListForeignErrorForeignLeft:
		err2 = new(unsafeReadPropImpl2.Left)
	default: // foreign.EitherNonEmptyListForeignErrorForeignRight
		b := unsafeReadPropImpl2.Right
		if foreignvalue.TagOf(b) == "Number" {
			number := foreignvalue.Number(b)
			var integer maybe.Int
			if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
				integer = maybe.Int(int32(number))
			} else {
				integer = maybe.NoInt
			}
			if integer == maybe.NoInt {
				err2 = new(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
			} else {
				i2, err2 = int32(integer), nil
			}
		} else {
			err2 = new(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
		}
	}
	var result2 foreign.EitherNonEmptyListForeignErrorFnEmptyAOfInt
	if err2 != nil {
		result2 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyAOfInt(foreign.MapListFunction("a", *err2))
	} else {
		result2 = foreign.RightEitherNonEmptyListForeignErrorFnEmptyAOfInt(func(_ shared.Empty) shared.AOfInt {
			return shared.AOfInt{A: i2}
		})
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfIntPairRight && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntRight {
		return result.Right(result2.Right(shared.Empty{})), nil
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfIntPairLeft && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntLeft {
		return shared.Pair{}, new(foreign.NonEmptyListForeignError{First: result.Left.First, Second: ReadImplPairConsIntConsIntNilGoReusing(foreign.Cons(result2.Left.First, result2.Left.Second), ReadImplPairConsIntConsIntNilGo(foreign.SharedListForeignErrorNil, result.Left.Second))})
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfIntPairRight && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntLeft {
		return shared.Pair{}, new(result2.Left)
	}
	return shared.Pair{}, new(result.Left)
}

