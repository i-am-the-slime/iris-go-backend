	switch read.Tag {
	case foreign.EitherNonEmptyListForeignErrorPairLeft:
		result = "bad"
	default: // foreign.EitherNonEmptyListForeignErrorPairRight
		read2 := read.Right
		result = "{ A: " + strconv.Itoa(int(read2.A_)) + ", a: " + strconv.Itoa(int(read2.A)) + " }"
	}
	s2 := foreignvalue.Encode(shared.EncodeJSONTriple, shared.Triple{A_: 3, A: "three", A2: 3.5})
	decoded2, ok2 := foreignvalue.Decode(s2, shared.DecodeJSONTriple)
	var read3 foreign.EitherNonEmptyListForeignErrorTriple
	if ok2 {
		read3 = foreign.RightEitherNonEmptyListForeignErrorTriple(decoded2)
