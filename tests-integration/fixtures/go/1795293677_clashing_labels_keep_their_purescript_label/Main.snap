		case either.EitherErrorForeignLeft:
			result2 = foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorForeignError, ForeignError: exception.Message(performed.Left)}, Second: foreign.SharedListForeignErrorNil}}
