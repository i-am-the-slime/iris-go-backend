	return &ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: errorAtProperty0, ErrorAtProperty1: errorAtProperty1}
}

func Pure(x any) EitherForeign {
	return EitherForeign{Tag: EitherForeignRight, Right: x}
}

func MapFunction(s string, value NonEmpty) NonEmpty {
	return NonEmpty{First: ErrorAtProperty(s, value.First), Second: MapFunctionChunkedRevMap(s, SharedListListForeignErrorNil, value.Second)}
}

func MapFunctionChunkedRevMap(s string, chunksAcc *ListListForeignError, chunk *ListForeignError) *ListForeignError {
	var listListForeignErrorCells alloc.Cells[ListListForeignError]
	for {
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 != SharedListForeignErrorNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListForeignErrorCells.New(ListListForeignError{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *ListForeignError
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 == SharedListForeignErrorNil {
			result = Cons(ErrorAtProperty(s, chunk.Cons0), Cons(ErrorAtProperty(s, chunk.Cons1.Cons0), SharedListForeignErrorNil))
		} else if chunk != SharedListForeignErrorNil && chunk.Cons1 == SharedListForeignErrorNil {
			result = Cons(ErrorAtProperty(s, chunk.Cons0), SharedListForeignErrorNil)
		} else {
			result = SharedListForeignErrorNil
		}
		return MapFunctionChunkedRevMapReverseUnrolledMap(s, chunksAcc, result)
	}
}

func MapFunctionChunkedRevMapReverseUnrolledMap(s string, list *ListListForeignError, acc *ListForeignError) *ListForeignError {
	var foreignErrorCells alloc.Cells[ForeignError]
	var listForeignErrorCells alloc.Cells[ListForeignError]
	for {
		if list != SharedListListForeignErrorNil && list.Cons0 != SharedListForeignErrorNil && list.Cons0.Cons1 != SharedListForeignErrorNil && list.Cons0.Cons1.Cons1 != SharedListForeignErrorNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x1}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x2}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x3}), Cons1: acc})})})
			continue
		}
		return acc
	}
}

// Yoga/JSON/json.go
package json

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
	"fixture/Foreign"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"math"
)

func DecodeJSONPair(d *foreignvalue.Decoder) shared.Pair {
	var a int
	hasA := false
	var a2 int
	hasA2 := false
	if d.Object() {
		for {
			switch d.Key() {
			case "A":
				a = d.Int()
				hasA = true
			case "a":
				a2 = d.Int()
				hasA2 = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasA || !hasA2 {
		d.Fail()
	}
	return shared.Pair{A_: a, A: a2}
}

func DecodeJSONTriple(d *foreignvalue.Decoder) shared.Triple {
	var a int
	hasA := false
	var a2 float64
	hasA2 := false
	var a3 string
	hasA3 := false
	if d.Object() {
		for {
			switch d.Key() {
			case "A":
				a = d.Int()
				hasA = true
			case "A2":
				a2 = d.Number()
				hasA2 = true
			case "a":
				a3 = d.String()
				hasA3 = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasA || !hasA2 || !hasA3 {
		d.Fail()
	}
	return shared.Triple{A_: a, A2: a2, A: a3}
}

func DecodeJSONHeader(d *foreignvalue.Decoder) shared.Header {
	var contenttype string
	hasContenttype := false
	var content_type string
	hasContent_type := false
	if d.Object() {
		for {
			switch d.Key() {
			case "content-type":
				contenttype = d.String()
				hasContenttype = true
			case "content_type":
				content_type = d.String()
				hasContent_type = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasContenttype || !hasContent_type {
		d.Fail()
	}
	return shared.Header{Content_type2: contenttype, Content_type: content_type}
}

func ReadJSONPair(text string) (shared.Pair, foreign.NonEmptyFailure) {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONPair)
	if ok {
		return decoded, foreign.NonEmptyFailure{}
	}
	performed := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		argument := foreignvalue.ParseJSON(text)
		return either.Either{Tag: either.EitherRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherLeft:
		return shared.Pair{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherRight
		return ReadImplPair(performed.Right)
	}
}

func ReadJSONTriple(text string) (shared.Triple, foreign.NonEmptyFailure) {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONTriple)
	if ok {
		return decoded, foreign.NonEmptyFailure{}
	}
	performed := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		argument := foreignvalue.ParseJSON(text)
		return either.Either{Tag: either.EitherRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherLeft:
		return shared.Triple{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherRight
		return ReadImplTriple(performed.Right)
	}
}

func ReadJSONHeader(text string) (shared.Header, foreign.NonEmptyFailure) {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONHeader)
	if ok {
		return decoded, foreign.NonEmptyFailure{}
	}
	performed := direct.CatchException(func(x exception.Error) either.Either {
		return either.Left(x)
	}, func() either.Either {
		argument := foreignvalue.ParseJSON(text)
		return either.Either{Tag: either.EitherRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherLeft:
		return shared.Header{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherRight
		return ReadImplHeader(performed.Right)
	}
}

func ReadImplPair(o any) (shared.Pair, foreign.NonEmptyFailure) {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "A", o)
	var i int
	var err foreign.NonEmptyFailure
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherForeignLeft:
		err = foreign.NonEmptyFailure{Failed: true, Left: unsafeReadPropImpl.Left}
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "Number" {
			number := foreignvalue.Number(b)
			var integer maybe.Int
			if math.Trunc(number) == number && (number >= math.MinInt && number < -math.MinInt) {
				integer = maybe.JustInt(int(number))
			} else {
				integer = maybe.NoInt
			}
			switch integer.Tag {
			case maybe.TagNothing:
				err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
			default: // maybe.TagJust
				i, err = integer.Just, foreign.NonEmptyFailure{}
			}
		} else {
			err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
		}
	}
	var result foreign.EitherFnAOfIntPair
	if err.Failed {
		result = foreign.LeftEitherFnAOfIntPair(foreign.MapFunction("A", err.Left))
	} else {
		result = foreign.RightEitherFnAOfIntPair(func(r1 shared.AOfInt) shared.Pair {
			return shared.Pair{A: r1.A, A_: i}
		})
	}
	unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "a", o)
	var i2 int
	var err2 foreign.NonEmptyFailure
	switch unsafeReadPropImpl2.Tag {
	case foreign.EitherForeignLeft:
		err2 = foreign.NonEmptyFailure{Failed: true, Left: unsafeReadPropImpl2.Left}
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl2.Right
		if foreignvalue.TagOf(b) == "Number" {
			number := foreignvalue.Number(b)
			var integer maybe.Int
			if math.Trunc(number) == number && (number >= math.MinInt && number < -math.MinInt) {
				integer = maybe.JustInt(int(number))
			} else {
				integer = maybe.NoInt
			}
			switch integer.Tag {
			case maybe.TagNothing:
				err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
			default: // maybe.TagJust
				i2, err2 = integer.Just, foreign.NonEmptyFailure{}
			}
		} else {
			err2 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
		}
	}
	var result2 foreign.EitherFnEmptyAOfInt
	if err2.Failed {
		result2 = foreign.LeftEitherFnEmptyAOfInt(foreign.MapFunction("a", err2.Left))
	} else {
		result2 = foreign.RightEitherFnEmptyAOfInt(func(_ shared.Empty) shared.AOfInt {
			return shared.AOfInt{A: i2}
		})
	}
	if result.Tag == foreign.EitherFnAOfIntPairRight && result2.Tag == foreign.EitherFnEmptyAOfIntRight {
		return result.Right(result2.Right(shared.Empty{})), foreign.NonEmptyFailure{}
	}
	if result.Tag == foreign.EitherFnAOfIntPairLeft && result2.Tag == foreign.EitherFnEmptyAOfIntLeft {
		return shared.Pair{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: result.Left.First, Second: ReadImplGoConsIntConsIntNilReusing(foreign.Cons(result2.Left.First, result2.Left.Second), ReadImplGoConsIntConsIntNil(foreign.SharedListForeignErrorNil, result.Left.Second))}}
	}
	if result.Tag == foreign.EitherFnAOfIntPairRight && result2.Tag == foreign.EitherFnEmptyAOfIntLeft {
		return shared.Pair{}, foreign.NonEmptyFailure{Failed: true, Left: result2.Left}
	}
	return shared.Pair{}, foreign.NonEmptyFailure{Failed: true, Left: result.Left}
}

func ReadImplTriple(o any) (shared.Triple, foreign.NonEmptyFailure) {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "A", o)
	var i int
	var err foreign.NonEmptyFailure
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherForeignLeft:
		err = foreign.NonEmptyFailure{Failed: true, Left: unsafeReadPropImpl.Left}
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "Number" {
			number := foreignvalue.Number(b)
			var integer maybe.Int
			if math.Trunc(number) == number && (number >= math.MinInt && number < -math.MinInt) {
				integer = maybe.JustInt(int(number))
			} else {
				integer = maybe.NoInt
			}
			switch integer.Tag {
			case maybe.TagNothing:
				err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
			default: // maybe.TagJust
				i, err = integer.Just, foreign.NonEmptyFailure{}
			}
		} else {
			err = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
		}
	}
	var result foreign.EitherFnA2ATriple
	if err.Failed {
		result = foreign.LeftEitherFnA2ATriple(foreign.MapFunction("A", err.Left))
	} else {
		result = foreign.RightEitherFnA2ATriple(func(r1 shared.A2A) shared.Triple {
			return shared.Triple{A2: r1.A2, A: r1.A, A_: i}
		})
	}
	unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "A2", o)
	var result2 foreign.EitherFnAOfStringA2A
	switch unsafeReadPropImpl2.Tag {
	case foreign.EitherForeignLeft:
		result2 = foreign.LeftEitherFnAOfStringA2A(foreign.MapFunction("A2", unsafeReadPropImpl2.Left))
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl2.Right
		if foreignvalue.TagOf(b) == "Number" {
			result2 = foreign.RightEitherFnAOfStringA2A(func(r1 shared.AOfString) shared.A2A {
				return shared.A2A{A: r1.A, A2: foreignvalue.Number(b)}
			})
		} else {
			result2 = foreign.LeftEitherFnAOfStringA2A(foreign.MapFunction("A2", foreign.NonEmpty{First: foreign.TypeMismatch("Number", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
		}
	}
	unsafeReadPropImpl3 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "a", o)
	var result3 foreign.EitherFnEmptyAOfString
	switch unsafeReadPropImpl3.Tag {
	case foreign.EitherForeignLeft:
		result3 = foreign.LeftEitherFnEmptyAOfString(foreign.MapFunction("a", unsafeReadPropImpl3.Left))
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl3.Right
		if foreignvalue.TagOf(b) == "String" {
			result3 = foreign.RightEitherFnEmptyAOfString(func(_ shared.Empty) shared.AOfString {
				return shared.AOfString{A: b.(string)}
			})
		} else {
			result3 = foreign.LeftEitherFnEmptyAOfString(foreign.MapFunction("a", foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
		}
	}
	var result4 foreign.EitherFnEmptyA2A
	if result2.Tag == foreign.EitherFnAOfStringA2ARight && result3.Tag == foreign.EitherFnEmptyAOfStringRight {
		result4 = foreign.RightEitherFnEmptyA2A(func(x shared.Empty) shared.A2A {
			return result2.Right(result3.Right(x))
		})
	} else if result2.Tag == foreign.EitherFnAOfStringA2ALeft && result3.Tag == foreign.EitherFnEmptyAOfStringLeft {
		result4 = foreign.LeftEitherFnEmptyA2A(foreign.NonEmpty{First: result2.Left.First, Second: ReadImplGoConsIntConsIntNilReusing(foreign.Cons(result3.Left.First, result3.Left.Second), ReadImplGoConsIntConsIntNil(foreign.SharedListForeignErrorNil, result2.Left.Second))})
	} else if result2.Tag == foreign.EitherFnAOfStringA2ARight && result3.Tag == foreign.EitherFnEmptyAOfStringLeft {
		result4 = foreign.LeftEitherFnEmptyA2A(result3.Left)
	} else {
		result4 = foreign.LeftEitherFnEmptyA2A(result2.Left)
	}
	if result.Tag == foreign.EitherFnA2ATripleRight && result4.Tag == foreign.EitherFnEmptyA2ARight {
		return result.Right(result4.Right(shared.Empty{})), foreign.NonEmptyFailure{}
	}
	if result.Tag == foreign.EitherFnA2ATripleLeft && result4.Tag == foreign.EitherFnEmptyA2ALeft {
		return shared.Triple{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: result.Left.First, Second: ReadImplGoConsIntConsIntNilReusing(foreign.Cons(result4.Left.First, result4.Left.Second), ReadImplGoConsIntConsIntNil(foreign.SharedListForeignErrorNil, result.Left.Second))}}
	}
	if result.Tag == foreign.EitherFnA2ATripleRight && result4.Tag == foreign.EitherFnEmptyA2ALeft {
		return shared.Triple{}, foreign.NonEmptyFailure{Failed: true, Left: result4.Left}
	}
	return shared.Triple{}, foreign.NonEmptyFailure{Failed: true, Left: result.Left}
}

func ReadImplHeader(o any) (shared.Header, foreign.NonEmptyFailure) {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "content-type", o)
	var result foreign.EitherFnContent_typeHeader
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherForeignLeft:
		result = foreign.LeftEitherFnContent_typeHeader(foreign.MapFunction("content-type", unsafeReadPropImpl.Left))
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "String" {
			result = foreign.RightEitherFnContent_typeHeader(func(r1 shared.Content_type) shared.Header {
				return shared.Header{Content_type: r1.Content_type, Content_type2: b.(string)}
			})
		} else {
			result = foreign.LeftEitherFnContent_typeHeader(foreign.MapFunction("content-type", foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
		}
	}
	unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.LeftEitherForeign(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "content_type", o)
	var result2 foreign.EitherFnEmptyContent_type
	switch unsafeReadPropImpl2.Tag {
	case foreign.EitherForeignLeft:
		result2 = foreign.LeftEitherFnEmptyContent_type(foreign.MapFunction("content_type", unsafeReadPropImpl2.Left))
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl2.Right
		if foreignvalue.TagOf(b) == "String" {
			result2 = foreign.RightEitherFnEmptyContent_type(func(_ shared.Empty) shared.Content_type {
				return shared.Content_type{Content_type: b.(string)}
			})
		} else {
			result2 = foreign.LeftEitherFnEmptyContent_type(foreign.MapFunction("content_type", foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
		}
	}
	if result.Tag == foreign.EitherFnContent_typeHeaderRight && result2.Tag == foreign.EitherFnEmptyContent_typeRight {
		return result.Right(result2.Right(shared.Empty{})), foreign.NonEmptyFailure{}
	}
	if result.Tag == foreign.EitherFnContent_typeHeaderLeft && result2.Tag == foreign.EitherFnEmptyContent_typeLeft {
		return shared.Header{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: result.Left.First, Second: ReadImplGoConsIntConsIntNilReusing(foreign.Cons(result2.Left.First, result2.Left.Second), ReadImplGoConsIntConsIntNil(foreign.SharedListForeignErrorNil, result.Left.Second))}}
	}
	if result.Tag == foreign.EitherFnContent_typeHeaderRight && result2.Tag == foreign.EitherFnEmptyContent_typeLeft {
		return shared.Header{}, foreign.NonEmptyFailure{Failed: true, Left: result2.Left}
	}
	return shared.Header{}, foreign.NonEmptyFailure{Failed: true, Left: result.Left}
}

func ReadImplGoConsIntConsIntNil(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	var listForeignErrorCells alloc.Cells[foreign.ListForeignError]
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		acc, list = listForeignErrorCells.New(foreign.ListForeignError{Cons0: x, Cons1: acc}), xs
	}
}

func ReadImplGoConsIntConsIntNilReusing(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// main.go
package main

import (
	"fixture/Yoga/JSON"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	read, err := json.ReadJSONPair(foreignvalue.Encode(shared.EncodeJSONPair, shared.Pair{A_: 1, A: 2}))
	var result string
	if err.Failed {
		result = "bad"
	} else {
		result = "{ A: " + strconv.Itoa(read.A_) + ", a: " + strconv.Itoa(read.A) + " }"
	}
	read2, err := json.ReadJSONTriple(foreignvalue.Encode(shared.EncodeJSONTriple, shared.Triple{A_: 3, A: "three", A2: 3.5}))
	var result2 string
	if err.Failed {
		result2 = "bad"
	} else {
		result2 = "{ A: " + strconv.Itoa(read2.A_) + ", A2: " + prim.ShowNumber(read2.A2) + ", a: " + prim.ShowString(read2.A) + " }"
	}
	read3, err := json.ReadJSONHeader(foreignvalue.Encode(shared.EncodeJSONHeader, shared.Header{Content_type2: "text/plain", Content_type: "underscore"}))
	var result3 string
	if err.Failed {
		result3 = "bad"
	} else {
		result3 = "{ content-type: " + prim.ShowString(read3.Content_type2) + ", content_type: " + prim.ShowString(read3.Content_type) + " }"
	}
	updated := shared.Pair{A_: 1, A: 2}
	updated.A_ = 10
	updated2 := shared.Triple{A_: 3, A: "three", A2: 3.5}
	updated2.A = "updated"
	updated2.A2 = 0.5
	updated3 := shared.Header{Content_type2: "text/plain", Content_type: "underscore"}
	updated3.Content_type2 = "application/json"
	return []string{result, result2, result3, "{ A: " + strconv.Itoa(updated.A_) + ", a: " + strconv.Itoa(updated.A) + " }", "{ A: " + strconv.Itoa(updated2.A_) + ", A2: " + prim.ShowNumber(updated2.A2) + ", a: " + prim.ShowString(updated2.A) + " }", "{ content-type: " + prim.ShowString(updated3.Content_type2) + ", content_type: " + prim.ShowString(updated3.Content_type) + " }"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

import "github.com/i-am-the-slime/iris-go/foreignvalue"

type Pair struct {
	A_ int `purescript:"A"`
	A  int
}

func EncodeJSONPair(e *foreignvalue.Encoder, value Pair) {
	e.Raw("{\"a\":")
	e.Int(value.A)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Triple struct {
	A  string
	A2 float64
	A_ int `purescript:"A"`
}

func EncodeJSONTriple(e *foreignvalue.Encoder, value Triple) {
	e.Raw("{\"a\":")
	e.String(value.A)
	e.Raw(",\"A2\":")
	e.Number(value.A2)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Header struct {
	Content_type2 string `purescript:"content-type"`
	Content_type  string
}

func EncodeJSONHeader(e *foreignvalue.Encoder, value Header) {
	e.Raw("{\"content_type\":")
	e.String(value.Content_type)
	e.Raw(",\"content-type\":")
	e.String(value.Content_type2)
	e.Raw("}")
}

type AOfInt struct {
	A int
}

type Empty struct{}

type A2A struct {
	A  string
	A2 float64
}

type AOfString struct {
	A string
}

type Content_type struct {
	Content_type string
}
