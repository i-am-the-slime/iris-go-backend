	switch performed.Tag {
	case either.EitherErrorForeignLeft:
		return shared.Triple{}, new(foreign.NonEmptyListForeignError{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil})
	default: // either.EitherErrorForeignRight
		return ReadImplTripleConsIntConsNumberConsStringNil(performed.Right)
	}
}

func ReadJSONHeader(text string) (shared.Header, *foreign.NonEmptyListForeignError) {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONHeader)
	if ok {
