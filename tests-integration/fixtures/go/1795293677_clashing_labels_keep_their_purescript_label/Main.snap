func ReadImplHeader(o any) (shared.Header, foreign.NonEmptyFailure) {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.Left(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "content_type", o)
	var f func(shared.Empty) shared.Content_type
	var err foreign.NonEmptyFailure
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherForeignLeft:
		err = foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction("content_type", unsafeReadPropImpl.Left)}
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "String" {
			f, err = func(_ shared.Empty) shared.Content_type {
				return shared.Content_type{Content_type: b.(string)}
			}, foreign.NonEmptyFailure{}
		} else {
			err = foreign.NonEmptyFailure{Failed: true, Left: foreign.MapFunction("content_type", foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})}
		}
	}
	unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.Left(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "content-type", o)
	switch unsafeReadPropImpl2.Tag {
	case foreign.EitherForeignLeft:
		return ReadImplJoin(f, err, foreign.MapFunction("content-type", unsafeReadPropImpl2.Left))
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl2.Right
		if foreignvalue.TagOf(b) == "String" {
			if err.Failed {
				return shared.Header{}, err
			}
			return shared.Header{Content_type: f(shared.Empty{}).Content_type, Content_type2: b.(string)}, foreign.NonEmptyFailure{}
		}
		return ReadImplJoin(f, err, foreign.MapFunction("content-type", foreign.NonEmpty{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
	}
}

func ReadImplGoConsIntConsIntNil(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	var listForeignErrorCells alloc.Cells[foreign.ListForeignError]
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		acc, list = listForeignErrorCells.New(foreign.ListForeignError{Cons0: x, Cons1: acc}), xs
	}
}

func ReadImplJoin(f func(shared.Empty) shared.Content_type, err foreign.NonEmptyFailure, field0 foreign.NonEmpty) (shared.Header, foreign.NonEmptyFailure) {
	if err.Failed {
		return shared.Header{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: field0.First, Second: ReadImplGoConsIntConsIntNilReusing(foreign.Cons(err.Left.First, err.Left.Second), ReadImplGoConsIntConsIntNil(foreign.SharedListForeignErrorNil, field0.Second))}}
	}
	return shared.Header{}, foreign.NonEmptyFailure{Failed: true, Left: field0}
}

func ReadImplGoConsIntConsIntNilReusing(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// main.go
package main

import (
	"fixture/Yoga/JSON"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	read, err := json.ReadJSONPair(foreignvalue.Encode(shared.EncodeJSONPair, shared.Pair{A_: 1, A: 2}))
	var result string
	if err.Failed {
		result = "bad"
	} else {
		result = "{ A: " + strconv.Itoa(read.A_) + ", a: " + strconv.Itoa(read.A) + " }"
	}
	read2, err := json.ReadJSONTriple(foreignvalue.Encode(shared.EncodeJSONTriple, shared.Triple{A_: 3, A: "three", A2: 3.5}))
	var result2 string
	if err.Failed {
		result2 = "bad"
	} else {
		result2 = "{ A: " + strconv.Itoa(read2.A_) + ", A2: " + prim.ShowNumber(read2.A2) + ", a: " + prim.ShowString(read2.A) + " }"
	}
	read3, err := json.ReadJSONHeader(foreignvalue.Encode(shared.EncodeJSONHeader, shared.Header{Content_type2: "text/plain", Content_type: "underscore"}))
	var result3 string
	if err.Failed {
		result3 = "bad"
	} else {
		result3 = "{ content-type: " + prim.ShowString(read3.Content_type2) + ", content_type: " + prim.ShowString(read3.Content_type) + " }"
	}
	return []string{result, result2, result3, "{ A: 10, a: 2 }", "{ A: 3, A2: 0.5, a: " + prim.ShowString("updated") + " }", "{ content-type: " + prim.ShowString("application/json") + ", content_type: " + prim.ShowString("underscore") + " }"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

import "github.com/i-am-the-slime/iris-go/foreignvalue"

type Pair struct {
	A_ int `purescript:"A"`
	A  int
}

func EncodeJSONPair(e *foreignvalue.Encoder, value Pair) {
	e.Raw("{\"a\":")
	e.Int(value.A)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Triple struct {
	A  string
	A2 float64
	A_ int `purescript:"A"`
}

func EncodeJSONTriple(e *foreignvalue.Encoder, value Triple) {
	e.Raw("{\"a\":")
	e.String(value.A)
	e.Raw(",\"A2\":")
	e.Number(value.A2)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Header struct {
	Content_type2 string `purescript:"content-type"`
	Content_type  string
}

func EncodeJSONHeader(e *foreignvalue.Encoder, value Header) {
	e.Raw("{\"content_type\":")
	e.String(value.Content_type)
	e.Raw(",\"content-type\":")
	e.String(value.Content_type2)
	e.Raw("}")
}

type AOfInt struct {
	A int
}

type Empty struct{}

type AOfString struct {
	A string
}

type A2A struct {
	A  string
	A2 float64
}

type Content_type struct {
	Content_type string
}
