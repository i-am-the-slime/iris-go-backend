var main_ = initializeMain_()

func initializeMain_() []string {
	s := foreignvalue.Encode(shared.EncodeJSONPair, shared.Pair{A_: 1, A: 2})
	decoded, ok := foreignvalue.Decode(s, shared.DecodeJSONPair)
	var read foreign.EitherNonEmptyListForeignErrorPair
	if ok {
		read = foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairRight, Right: decoded}
	} else {
		performed := direct.CatchException(func(x exception.Error) either.EitherErrorForeign {
			return either.EitherErrorForeign{Tag: either.EitherErrorForeignLeft, Left: x}
		}, func() either.EitherErrorForeign {
