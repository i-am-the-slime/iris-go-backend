			return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(r)}, Second: foreign.SharedListForeignErrorNil}}
		}, foreign.PureIdentityNonEmptyListForeignError, "a", r)
		var result4 foreign.EitherNonEmptyListForeignErrorFnEmptyAOfString
		switch unsafeReadPropImpl3.Tag {
		case foreign.EitherNonEmptyListForeignErrorForeignLeft:
			result4 = foreign.EitherNonEmptyListForeignErrorFnEmptyAOfString{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringLeft, Left: foreign.MapListFunction("a", unsafeReadPropImpl3.Left)}
		default: // foreign.EitherNonEmptyListForeignErrorForeignRight
			b := unsafeReadPropImpl3.Right
			if foreignvalue.TagOf(b) == "String" {
				result4 = foreign.EitherNonEmptyListForeignErrorFnEmptyAOfString{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringRight, Right: func(_ shared.Empty) shared.AOfString {
					return shared.AOfString{A: b.(string)}
				}}
			} else {
				result4 = foreign.EitherNonEmptyListForeignErrorFnEmptyAOfString{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringLeft, Left: foreign.MapListFunction("a", foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "String", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil})}
			}
		}
		var result5 foreign.EitherNonEmptyListForeignErrorFnEmptyA2A
		if result3.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ARight && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringRight {
			result5 = foreign.EitherNonEmptyListForeignErrorFnEmptyA2A{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyA2ARight, Right: func(x shared.Empty) shared.A2A {
				return result3.Right(result4.Right(x))
			}}
		} else if result3.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ALeft && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringLeft {
			result5 = foreign.EitherNonEmptyListForeignErrorFnEmptyA2A{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyA2ALeft, Left: foreign.NonEmptyListForeignError{First: result3.Left.First, Second: ReadJSONPairGoReusing(&foreign.ListForeignError{Cons0: result4.Left.First, Cons1: result4.Left.Second}, ReadJSONPairGo(foreign.SharedListForeignErrorNil, result3.Left.Second))}}
		} else if result3.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ARight && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringLeft {
			result5 = foreign.EitherNonEmptyListForeignErrorFnEmptyA2A{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyA2ALeft, Left: result4.Left}
		} else {
			result5 = foreign.EitherNonEmptyListForeignErrorFnEmptyA2A{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyA2ALeft, Left: result3.Left}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnA2ATripleRight && result5.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyA2ARight {
			return foreign.EitherNonEmptyListForeignErrorTriple{Tag: foreign.EitherNonEmptyListForeignErrorTripleRight, Right: result.Right(result5.Right(shared.Empty{}))}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnA2ATripleLeft && result5.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyA2ALeft {
			return foreign.EitherNonEmptyListForeignErrorTriple{Tag: foreign.EitherNonEmptyListForeignErrorTripleLeft, Left: foreign.NonEmptyListForeignError{First: result.Left.First, Second: ReadJSONPairGoReusing(&foreign.ListForeignError{Cons0: result5.Left.First, Cons1: result5.Left.Second}, ReadJSONPairGo(foreign.SharedListForeignErrorNil, result.Left.Second))}}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnA2ATripleRight && result5.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyA2ALeft {
			return foreign.EitherNonEmptyListForeignErrorTriple{Tag: foreign.EitherNonEmptyListForeignErrorTripleLeft, Left: result5.Left}
		}
		return foreign.EitherNonEmptyListForeignErrorTriple{Tag: foreign.EitherNonEmptyListForeignErrorTripleLeft, Left: result.Left}
	}
}

func ReadJSONHeader(text string) foreign.EitherNonEmptyListForeignErrorHeader {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONHeader)
	if ok {
		return foreign.EitherNonEmptyListForeignErrorHeader{Tag: foreign.EitherNonEmptyListForeignErrorHeaderRight, Right: decoded}
	}
	performed := direct.CatchException(func(x exception.Error) either.EitherErrorForeign {
		return either.EitherErrorForeign{Tag: either.EitherErrorForeignLeft, Left: x}
	}, func() either.EitherErrorForeign {
		argument := foreignvalue.ParseJSON(text)
		return either.EitherErrorForeign{Tag: either.EitherErrorForeignRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherErrorForeignLeft:
		return foreign.EitherNonEmptyListForeignErrorHeader{Tag: foreign.EitherNonEmptyListForeignErrorHeaderLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorForeignError, ForeignError: exception.Message(performed.Left)}, Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherErrorForeignRight
		r := performed.Right
		unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
			return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(r)}, Second: foreign.SharedListForeignErrorNil}}
		}, foreign.PureIdentityNonEmptyListForeignError, "content-type", r)
		var result foreign.EitherNonEmptyListForeignErrorFnContent_typeHeader
		switch unsafeReadPropImpl.Tag {
		case foreign.EitherNonEmptyListForeignErrorForeignLeft:
			result = foreign.EitherNonEmptyListForeignErrorFnContent_typeHeader{Tag: foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderLeft, Left: foreign.MapListFunction("content-type", unsafeReadPropImpl.Left)}
		default: // foreign.EitherNonEmptyListForeignErrorForeignRight
			b := unsafeReadPropImpl.Right
			if foreignvalue.TagOf(b) == "String" {
				result = foreign.EitherNonEmptyListForeignErrorFnContent_typeHeader{Tag: foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderRight, Right: func(r1 shared.Content_type) shared.Header {
					return shared.Header{Content_type: r1.Content_type, Content_type2: b.(string)}
				}}
			} else {
				result = foreign.EitherNonEmptyListForeignErrorFnContent_typeHeader{Tag: foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderLeft, Left: foreign.MapListFunction("content-type", foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "String", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil})}
			}
		}
		unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
			return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(r)}, Second: foreign.SharedListForeignErrorNil}}
		}, foreign.PureIdentityNonEmptyListForeignError, "content_type", r)
		var result2 foreign.EitherNonEmptyListForeignErrorFnEmptyContent_type
		switch unsafeReadPropImpl2.Tag {
		case foreign.EitherNonEmptyListForeignErrorForeignLeft:
			result2 = foreign.EitherNonEmptyListForeignErrorFnEmptyContent_type{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeLeft, Left: foreign.MapListFunction("content_type", unsafeReadPropImpl2.Left)}
		default: // foreign.EitherNonEmptyListForeignErrorForeignRight
			b := unsafeReadPropImpl2.Right
			if foreignvalue.TagOf(b) == "String" {
				result2 = foreign.EitherNonEmptyListForeignErrorFnEmptyContent_type{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeRight, Right: func(_ shared.Empty) shared.Content_type {
					return shared.Content_type{Content_type: b.(string)}
				}}
			} else {
				result2 = foreign.EitherNonEmptyListForeignErrorFnEmptyContent_type{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeLeft, Left: foreign.MapListFunction("content_type", foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "String", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil})}
			}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderRight && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeRight {
			return foreign.EitherNonEmptyListForeignErrorHeader{Tag: foreign.EitherNonEmptyListForeignErrorHeaderRight, Right: result.Right(result2.Right(shared.Empty{}))}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderLeft && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeLeft {
			return foreign.EitherNonEmptyListForeignErrorHeader{Tag: foreign.EitherNonEmptyListForeignErrorHeaderLeft, Left: foreign.NonEmptyListForeignError{First: result.Left.First, Second: ReadJSONPairGoReusing(&foreign.ListForeignError{Cons0: result2.Left.First, Cons1: result2.Left.Second}, ReadJSONPairGo(foreign.SharedListForeignErrorNil, result.Left.Second))}}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderRight && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeLeft {
			return foreign.EitherNonEmptyListForeignErrorHeader{Tag: foreign.EitherNonEmptyListForeignErrorHeaderLeft, Left: result2.Left}
		}
		return foreign.EitherNonEmptyListForeignErrorHeader{Tag: foreign.EitherNonEmptyListForeignErrorHeaderLeft, Left: result.Left}
	}
}

func ReadJSONPairGo(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	var listForeignErrorCells alloc.Cells[foreign.ListForeignError]
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		acc, list = listForeignErrorCells.New(foreign.ListForeignError{Cons0: x, Cons1: acc}), xs
	}
}

func ReadJSONPairGoReusing(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// main.go
package main

import (
	"fixture/Foreign"
	"fixture/Yoga/JSON"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	scrutinee := json.ReadJSONPair(foreignvalue.Encode(shared.EncodeJSONPair, shared.Pair{A_: 1, A: 2}))
	var result string
	switch scrutinee.Tag {
	case foreign.EitherNonEmptyListForeignErrorPairLeft:
		result = "bad"
	default: // foreign.EitherNonEmptyListForeignErrorPairRight
		read := scrutinee.Right
		result = "{ A: " + strconv.Itoa(int(read.A_)) + ", a: " + strconv.Itoa(int(read.A)) + " }"
	}
	scrutinee2 := json.ReadJSONTriple(foreignvalue.Encode(shared.EncodeJSONTriple, shared.Triple{A_: 3, A: "three", A2: 3.5}))
	var result2 string
	switch scrutinee2.Tag {
	case foreign.EitherNonEmptyListForeignErrorTripleLeft:
		result2 = "bad"
	default: // foreign.EitherNonEmptyListForeignErrorTripleRight
		read := scrutinee2.Right
		result2 = "{ A: " + strconv.Itoa(int(read.A_)) + ", A2: " + prim.ShowNumber(read.A2) + ", a: " + prim.ShowString(read.A) + " }"
	}
	scrutinee3 := json.ReadJSONHeader(foreignvalue.Encode(shared.EncodeJSONHeader, shared.Header{Content_type2: "text/plain", Content_type: "underscore"}))
	var result3 string
	switch scrutinee3.Tag {
	case foreign.EitherNonEmptyListForeignErrorHeaderLeft:
		result3 = "bad"
	default: // foreign.EitherNonEmptyListForeignErrorHeaderRight
		read := scrutinee3.Right
		result3 = "{ content-type: " + prim.ShowString(read.Content_type2) + ", content_type: " + prim.ShowString(read.Content_type) + " }"
	}
	updated := shared.Pair{A_: 1, A: 2}
	updated.A_ = 10
	updated2 := shared.Triple{A_: 3, A: "three", A2: 3.5}
	updated2.A = "updated"
	updated2.A2 = 0.5
	updated3 := shared.Header{Content_type2: "text/plain", Content_type: "underscore"}
	updated3.Content_type2 = "application/json"
	return []string{result, result2, result3, "{ A: " + strconv.Itoa(int(updated.A_)) + ", a: " + strconv.Itoa(int(updated.A)) + " }", "{ A: " + strconv.Itoa(int(updated2.A_)) + ", A2: " + prim.ShowNumber(updated2.A2) + ", a: " + prim.ShowString(updated2.A) + " }", "{ content-type: " + prim.ShowString(updated3.Content_type2) + ", content_type: " + prim.ShowString(updated3.Content_type) + " }"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

import "github.com/i-am-the-slime/iris-go/foreignvalue"

type Pair struct {
	A_ int32 `purescript:"A"`
	A  int32
}

func EncodeJSONPair(e *foreignvalue.Encoder, value Pair) {
	e.Raw("{\"a\":")
	e.Int(value.A)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Triple struct {
	A  string
	A2 float64
	A_ int32 `purescript:"A"`
}

func EncodeJSONTriple(e *foreignvalue.Encoder, value Triple) {
	e.Raw("{\"a\":")
	e.String(value.A)
	e.Raw(",\"A2\":")
	e.Number(value.A2)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Header struct {
	Content_type2 string `purescript:"content-type"`
	Content_type  string
}

func EncodeJSONHeader(e *foreignvalue.Encoder, value Header) {
	e.Raw("{\"content_type\":")
	e.String(value.Content_type)
	e.Raw(",\"content-type\":")
	e.String(value.Content_type2)
	e.Raw("}")
}

type AOfInt struct {
	A int32
}

type Empty struct{}

type A2A struct {
	A  string
	A2 float64
}

type AOfString struct {
	A string
}

type Content_type struct {
	Content_type string
}
