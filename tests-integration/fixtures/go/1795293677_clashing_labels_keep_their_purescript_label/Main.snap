	"github.com/i-am-the-slime/iris-go/prim"
	"math"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	s := foreignvalue.Encode(shared.EncodeJSONPair, shared.Pair{A_: 1, A: 2})
	decoded, ok := foreignvalue.Decode(s, shared.DecodeJSONPair)
	var read foreign.EitherNonEmptyListForeignErrorPair
	if ok {
		read = foreign.RightEitherNonEmptyListForeignErrorPair(decoded)
	} else {
		performed := direct.CatchException(func(x exception.Error) either.EitherErrorForeign {
			return either.Left(x)
		}, func() either.EitherErrorForeign {
			argument := foreignvalue.ParseJSON(s)
			return either.EitherErrorForeign{Tag: either.EitherErrorForeignRight, Right: argument}
		})
		var result2 foreign.EitherNonEmptyListForeignErrorPair
		switch performed.Tag {
		case either.EitherErrorForeignLeft:
			result2 = foreign.LeftEitherNonEmptyListForeignErrorPair(foreign.NonEmptyListForeignError{First: foreign.ForeignErrorForeignError(exception.Message(performed.Left)), Second: foreign.SharedListForeignErrorNil})
		default: // either.EitherErrorForeignRight
			r := performed.Right
			unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
				return foreign.LeftEitherNonEmptyListForeignErrorForeign(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(r)), Second: foreign.SharedListForeignErrorNil})
			}, foreign.PureIdentityNonEmptyListForeignError, "A", r)
			var result3 foreign.EitherNonEmptyListForeignErrorInt
			switch unsafeReadPropImpl.Tag {
			case foreign.EitherNonEmptyListForeignErrorForeignLeft:
				result3 = foreign.LeftEitherNonEmptyListForeignErrorInt(unsafeReadPropImpl.Left)
			default: // foreign.EitherNonEmptyListForeignErrorForeignRight
				b := unsafeReadPropImpl.Right
				if foreignvalue.TagOf(b) == "Number" {
					number := b.(float64)
					var integer maybe.Int
					if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
						integer = maybe.Int(int32(number))
					} else {
						integer = maybe.NoInt
					}
					if integer == maybe.NoInt {
						result3 = foreign.LeftEitherNonEmptyListForeignErrorInt(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
					} else {
						result3 = foreign.RightEitherNonEmptyListForeignErrorInt(int32(integer))
					}
				} else {
					result3 = foreign.LeftEitherNonEmptyListForeignErrorInt(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil})
				}
			}
			var result4 foreign.EitherNonEmptyListForeignErrorFnAOfIntPair
			switch result3.Tag {
			case foreign.EitherNonEmptyListForeignErrorIntRight:
				result4 = foreign.RightEitherNonEmptyListForeignErrorFnAOfIntPair(func(r1 shared.AOfInt) shared.Pair {
					return shared.Pair{A: r1.A, A_: result3.Right}
				})
			default: // foreign.EitherNonEmptyListForeignErrorIntLeft
				result4 = foreign.LeftEitherNonEmptyListForeignErrorFnAOfIntPair(foreign.MapListFunction("A", result3.Left))
			}
			unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
				return foreign.LeftEitherNonEmptyListForeignErrorForeign(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(r)), Second: foreign.SharedListForeignErrorNil})
			}, foreign.PureIdentityNonEmptyListForeignError, "a", r)
			var result5 foreign.EitherNonEmptyListForeignErrorInt
			switch unsafeReadPropImpl2.Tag {
			case foreign.EitherNonEmptyListForeignErrorForeignLeft:
				result5 = foreign.LeftEitherNonEmptyListForeignErrorInt(unsafeReadPropImpl2.Left)
			default: // foreign.EitherNonEmptyListForeignErrorForeignRight
				b := unsafeReadPropImpl2.Right
				if foreignvalue.TagOf(b) == "Number" {
