	unsafeReadPropImpl3 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
		return foreign.LeftEitherNonEmptyListForeignErrorForeign(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.PureIdentityNonEmptyListForeignError, "a", o)
	var result3 foreign.EitherNonEmptyListForeignErrorFnEmptyAOfString
	switch unsafeReadPropImpl3.Tag {
	case foreign.EitherNonEmptyListForeignErrorForeignLeft:
		result3 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyAOfString(foreign.MapListFunction("a", unsafeReadPropImpl3.Left))
	default: // foreign.EitherNonEmptyListForeignErrorForeignRight
		b := unsafeReadPropImpl3.Right
		if foreignvalue.TagOf(b) == "String" {
			result3 = foreign.RightEitherNonEmptyListForeignErrorFnEmptyAOfString(func(_ shared.Empty) shared.AOfString {
