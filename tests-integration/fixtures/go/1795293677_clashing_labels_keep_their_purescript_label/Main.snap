type ListListForeignError struct {
	Cons0 *ListForeignError
	Cons1 *ListListForeignError
}

var SharedListListForeignErrorNil = &ListListForeignError{}

func MapList(function func(*ForeignError) *ForeignError, value NonEmptyListForeignError) NonEmptyListForeignError {
	return NonEmptyListForeignError{First: function(value.First), Second: MapListChunkedRevMap(function, SharedListListForeignErrorNil, value.Second)}
}

func PureIdentityNonEmptyListForeignError(x any) EitherNonEmptyListForeignErrorForeign {
	return EitherNonEmptyListForeignErrorForeign{Tag: EitherNonEmptyListForeignErrorForeignRight, Right: x}
}

func MapListF(function func(*ForeignError) *ForeignError, element *ForeignError) *ForeignError {
	return function(element)
}

func MapListChunkedRevMap(function func(*ForeignError) *ForeignError, chunksAcc *ListListForeignError, chunk *ListForeignError) *ListForeignError {
	var listListForeignErrorCells alloc.Cells[ListListForeignError]
	for {
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 != SharedListForeignErrorNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListForeignErrorCells.New(ListListForeignError{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *ListForeignError
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 == SharedListForeignErrorNil {
			result = &ListForeignError{Cons0: MapListF(function, chunk.Cons0), Cons1: &ListForeignError{Cons0: MapListF(function, chunk.Cons1.Cons0), Cons1: SharedListForeignErrorNil}}
		} else if chunk != SharedListForeignErrorNil && chunk.Cons1 == SharedListForeignErrorNil {
			result = &ListForeignError{Cons0: MapListF(function, chunk.Cons0), Cons1: SharedListForeignErrorNil}
		} else {
			result = SharedListForeignErrorNil
		}
		return MapListChunkedRevMapReverseUnrolledMap(function, chunksAcc, result)
	}
}

func MapListChunkedRevMapReverseUnrolledMap(function func(*ForeignError) *ForeignError, list *ListListForeignError, acc *ListForeignError) *ListForeignError {
	var listForeignErrorCells alloc.Cells[ListForeignError]
	for {
		if list != SharedListListForeignErrorNil && list.Cons0 != SharedListForeignErrorNil && list.Cons0.Cons1 != SharedListForeignErrorNil && list.Cons0.Cons1.Cons1 != SharedListForeignErrorNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listForeignErrorCells.New(ListForeignError{Cons0: MapListF(function, x1), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: MapListF(function, x2), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: MapListF(function, x3), Cons1: acc})})})
			continue
		}
		return acc
	}
}

