		} else {
			err3 = foreign.NonEmptyFailure{Failed: true, Left: field0}
		}
	} else if err.Failed {
		err3 = err
	} else {
		f2, err3 = func(x shared.Empty) shared.A2A {
			return shared.A2A{A: f(x).A, A2: number2}
