	unsafeReadPropImpl3 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherForeign {
		return foreign.Left(foreign.NonEmpty{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.Pure, "A", o)
	var i int
	var err4 foreign.NonEmptyFailure
	switch unsafeReadPropImpl3.Tag {
	case foreign.EitherForeignLeft:
		err4 = foreign.NonEmptyFailure{Failed: true, Left: unsafeReadPropImpl3.Left}
	default: // foreign.EitherForeignRight
		b := unsafeReadPropImpl3.Right
		if foreignvalue.TagOf(b) == "Number" {
			number := foreignvalue.Number(b)
			var integer maybe.Int
			if math.Trunc(number) == number && (number >= math.MinInt && number < -math.MinInt) {
				integer = maybe.JustInt(int(number))
			} else {
				integer = maybe.NoInt
			}
			switch integer.Tag {
			case maybe.TagNothing:
				err4 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
			default: // maybe.TagJust
				i, err4 = integer.Just, foreign.NonEmptyFailure{}
			}
		} else {
			err4 = foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: foreign.TypeMismatch("Int", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}}
		}
	}
	if err4.Failed {
		field := foreign.MapFunction("A", err4.Left)
		if err3.Failed {
			return shared.Triple{}, foreign.NonEmptyFailure{Failed: true, Left: foreign.NonEmpty{First: field.First, Second: ReadImplGoConsIntConsIntNilReusing(foreign.Cons(err3.Left.First, err3.Left.Second), ReadImplGoConsIntConsIntNil(foreign.SharedListForeignErrorNil, field.Second))}}
		}
		return shared.Triple{}, foreign.NonEmptyFailure{Failed: true, Left: field}
	}
	if err3.Failed {
		return shared.Triple{}, err3
	}
	record := f2(shared.Empty{})
	return shared.Triple{A2: record.A2, A: record.A, A_: i}, foreign.NonEmptyFailure{}
