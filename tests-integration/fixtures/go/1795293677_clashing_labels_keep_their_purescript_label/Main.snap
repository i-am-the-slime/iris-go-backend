// shared/shared.go
package shared

import "github.com/i-am-the-slime/iris-go/foreignvalue"

type Pair struct {
	A_ int32 `purescript:"A"`
	A  int32
}

func EncodeJSONPair(e *foreignvalue.Encoder, value Pair) {
	e.Raw("{\"a\":")
	e.Int(value.A)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

func DecodeJSONPair(d *foreignvalue.Decoder) Pair {
	var a int32
	hasA := false
	var a2 int32
	hasA2 := false
	if d.Object() {
		for {
			switch d.Key() {
			case "A":
				a = d.Int()
				hasA = true
			case "a":
				a2 = d.Int()
				hasA2 = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasA || !hasA2 {
		d.Fail()
	}
	return Pair{A_: a, A: a2}
}

type AOfInt struct {
	A int32
}

type Empty struct{}

type Triple struct {
	A  string
	A2 float64
	A_ int32 `purescript:"A"`
}

func EncodeJSONTriple(e *foreignvalue.Encoder, value Triple) {
	e.Raw("{\"a\":")
	e.String(value.A)
	e.Raw(",\"A2\":")
	e.Number(value.A2)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

func DecodeJSONTriple(d *foreignvalue.Decoder) Triple {
	var a int32
	hasA := false
	var a2 float64
	hasA2 := false
	var a3 string
	hasA3 := false
	if d.Object() {
		for {
			switch d.Key() {
			case "A":
				a = d.Int()
				hasA = true
			case "A2":
				a2 = d.Number()
				hasA2 = true
			case "a":
				a3 = d.String()
				hasA3 = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasA || !hasA2 || !hasA3 {
		d.Fail()
	}
	return Triple{A_: a, A2: a2, A: a3}
}

type A2A struct {
	A  string
	A2 float64
}

type AOfString struct {
	A string
}

type Header struct {
	Content_type2 string `purescript:"content-type"`
	Content_type  string
}

func EncodeJSONHeader(e *foreignvalue.Encoder, value Header) {
	e.Raw("{\"content_type\":")
	e.String(value.Content_type)
	e.Raw(",\"content-type\":")
	e.String(value.Content_type2)
	e.Raw("}")
}

func DecodeJSONHeader(d *foreignvalue.Decoder) Header {
	var contenttype string
	hasContenttype := false
	var content_type string
	hasContent_type := false
	if d.Object() {
		for {
			switch d.Key() {
			case "content-type":
				contenttype = d.String()
				hasContenttype = true
			case "content_type":
				content_type = d.String()
				hasContent_type = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasContenttype || !hasContent_type {
		d.Fail()
	}
	return Header{Content_type2: contenttype, Content_type: content_type}
}

type Content_type struct {
	Content_type string
}
