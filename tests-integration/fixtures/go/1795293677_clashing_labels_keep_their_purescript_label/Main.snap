	Right any
	Tag   uint8
}

const (
	EitherForeignLeft = iota
	EitherForeignRight
)

type EitherInt struct {
	Left  NonEmpty
	Right int
	Tag   uint8
}

const (
	EitherIntLeft = iota
	EitherIntRight
)

type EitherFnAOfIntPair struct {
	Left  NonEmpty
	Right func(shared.AOfInt) shared.Pair
	Tag   uint8
}

const (
	EitherFnAOfIntPairLeft = iota
	EitherFnAOfIntPairRight
)

type EitherFnEmptyAOfString struct {
	Left  NonEmpty
	Right func(shared.Empty) shared.AOfString
	Tag   uint8
}

const (
	EitherFnEmptyAOfStringLeft = iota
	EitherFnEmptyAOfStringRight
)

type EitherNumber struct {
