		} else {
			result3 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyAOfString(foreign.MapListFunction("a", foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
		}
	}
	var result4 foreign.EitherNonEmptyListForeignErrorFnEmptyA2A
	if result2.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ARight && result3.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringRight {
		result4 = foreign.RightEitherNonEmptyListForeignErrorFnEmptyA2A(func(x shared.Empty) shared.A2A {
			return result2.Right(result3.Right(x))
		})
	} else if result2.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ALeft && result3.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringLeft {
		result4 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyA2A(foreign.NonEmptyListForeignError{First: result2.Left.First, Second: ReadImplPairConsIntConsIntNilGoReusing(foreign.Cons(result3.Left.First, result3.Left.Second), ReadImplPairConsIntConsIntNilGo(foreign.SharedListForeignErrorNil, result2.Left.Second))})
	} else if result2.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ARight && result3.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfStringLeft {
		result4 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyA2A(result3.Left)
	} else {
		result4 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyA2A(result2.Left)
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnA2ATripleRight && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyA2ARight {
		return result.Right(result4.Right(shared.Empty{})), nil
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnA2ATripleLeft && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyA2ALeft {
		return shared.Triple{}, new(foreign.NonEmptyListForeignError{First: result.Left.First, Second: ReadImplPairConsIntConsIntNilGoReusing(foreign.Cons(result4.Left.First, result4.Left.Second), ReadImplPairConsIntConsIntNilGo(foreign.SharedListForeignErrorNil, result.Left.Second))})
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnA2ATripleRight && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyA2ALeft {
		return shared.Triple{}, new(result4.Left)
	}
	return shared.Triple{}, new(result.Left)
}

func ReadImplHeaderConsStringConsStringNil(o any) (shared.Header, *foreign.NonEmptyListForeignError) {
	unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
		return foreign.LeftEitherNonEmptyListForeignErrorForeign(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.PureIdentityNonEmptyListForeignError, "content-type", o)
	var result foreign.EitherNonEmptyListForeignErrorFnContent_typeHeader
	switch unsafeReadPropImpl.Tag {
	case foreign.EitherNonEmptyListForeignErrorForeignLeft:
		result = foreign.LeftEitherNonEmptyListForeignErrorFnContent_typeHeader(foreign.MapListFunction("content-type", unsafeReadPropImpl.Left))
	default: // foreign.EitherNonEmptyListForeignErrorForeignRight
		b := unsafeReadPropImpl.Right
		if foreignvalue.TagOf(b) == "String" {
			result = foreign.RightEitherNonEmptyListForeignErrorFnContent_typeHeader(func(r1 shared.Content_type) shared.Header {
				return shared.Header{Content_type: r1.Content_type, Content_type2: b.(string)}
			})
		} else {
			result = foreign.LeftEitherNonEmptyListForeignErrorFnContent_typeHeader(foreign.MapListFunction("content-type", foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
		}
	}
	unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
		return foreign.LeftEitherNonEmptyListForeignErrorForeign(foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("object", foreignvalue.TypeOf(o)), Second: foreign.SharedListForeignErrorNil})
	}, foreign.PureIdentityNonEmptyListForeignError, "content_type", o)
	var result2 foreign.EitherNonEmptyListForeignErrorFnEmptyContent_type
	switch unsafeReadPropImpl2.Tag {
	case foreign.EitherNonEmptyListForeignErrorForeignLeft:
		result2 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyContent_type(foreign.MapListFunction("content_type", unsafeReadPropImpl2.Left))
	default: // foreign.EitherNonEmptyListForeignErrorForeignRight
		b := unsafeReadPropImpl2.Right
		if foreignvalue.TagOf(b) == "String" {
			result2 = foreign.RightEitherNonEmptyListForeignErrorFnEmptyContent_type(func(_ shared.Empty) shared.Content_type {
				return shared.Content_type{Content_type: b.(string)}
			})
		} else {
			result2 = foreign.LeftEitherNonEmptyListForeignErrorFnEmptyContent_type(foreign.MapListFunction("content_type", foreign.NonEmptyListForeignError{First: foreign.TypeMismatch("String", foreignvalue.TagOf(b)), Second: foreign.SharedListForeignErrorNil}))
		}
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderRight && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeRight {
		return result.Right(result2.Right(shared.Empty{})), nil
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderLeft && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeLeft {
		return shared.Header{}, new(foreign.NonEmptyListForeignError{First: result.Left.First, Second: ReadImplPairConsIntConsIntNilGoReusing(foreign.Cons(result2.Left.First, result2.Left.Second), ReadImplPairConsIntConsIntNilGo(foreign.SharedListForeignErrorNil, result.Left.Second))})
	}
	if result.Tag == foreign.EitherNonEmptyListForeignErrorFnContent_typeHeaderRight && result2.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyContent_typeLeft {
		return shared.Header{}, new(result2.Left)
	}
	return shared.Header{}, new(result.Left)
}

func ReadImplPairConsIntConsIntNilGo(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	var listForeignErrorCells alloc.Cells[foreign.ListForeignError]
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		x := list.Cons0
		xs := list.Cons1
		acc, list = listForeignErrorCells.New(foreign.ListForeignError{Cons0: x, Cons1: acc}), xs
	}
}

func ReadImplPairConsIntConsIntNilGoReusing(acc *foreign.ListForeignError, list *foreign.ListForeignError) *foreign.ListForeignError {
	for {
		if list == foreign.SharedListForeignErrorNil {
			return acc
		}
		xs := list.Cons1
		list.Cons1 = acc
		acc, list = list, xs
	}
}

// main.go
package main

import (
	"fixture/Yoga/JSON"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	read, err := json.ReadJSONPair(foreignvalue.Encode(shared.EncodeJSONPair, shared.Pair{A_: 1, A: 2}))
	var result string
	if err != nil {
		result = "bad"
	} else {
		result = "{ A: " + strconv.Itoa(int(read.A_)) + ", a: " + strconv.Itoa(int(read.A)) + " }"
	}
	read2, err := json.ReadJSONTriple(foreignvalue.Encode(shared.EncodeJSONTriple, shared.Triple{A_: 3, A: "three", A2: 3.5}))
	var result2 string
	if err != nil {
		result2 = "bad"
	} else {
		result2 = "{ A: " + strconv.Itoa(int(read2.A_)) + ", A2: " + prim.ShowNumber(read2.A2) + ", a: " + prim.ShowString(read2.A) + " }"
	}
	read3, err := json.ReadJSONHeader(foreignvalue.Encode(shared.EncodeJSONHeader, shared.Header{Content_type2: "text/plain", Content_type: "underscore"}))
	var result3 string
	if err != nil {
		result3 = "bad"
	} else {
		result3 = "{ content-type: " + prim.ShowString(read3.Content_type2) + ", content_type: " + prim.ShowString(read3.Content_type) + " }"
	}
	updated := shared.Pair{A_: 1, A: 2}
	updated.A_ = 10
	updated2 := shared.Triple{A_: 3, A: "three", A2: 3.5}
	updated2.A = "updated"
	updated2.A2 = 0.5
	updated3 := shared.Header{Content_type2: "text/plain", Content_type: "underscore"}
	updated3.Content_type2 = "application/json"
	return []string{result, result2, result3, "{ A: " + strconv.Itoa(int(updated.A_)) + ", a: " + strconv.Itoa(int(updated.A)) + " }", "{ A: " + strconv.Itoa(int(updated2.A_)) + ", A2: " + prim.ShowNumber(updated2.A2) + ", a: " + prim.ShowString(updated2.A) + " }", "{ content-type: " + prim.ShowString(updated3.Content_type2) + ", content_type: " + prim.ShowString(updated3.Content_type) + " }"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

import "github.com/i-am-the-slime/iris-go/foreignvalue"

type Pair struct {
	A_ int32 `purescript:"A"`
	A  int32
}

func EncodeJSONPair(e *foreignvalue.Encoder, value Pair) {
	e.Raw("{\"a\":")
	e.Int(value.A)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Triple struct {
	A  string
	A2 float64
	A_ int32 `purescript:"A"`
}

func EncodeJSONTriple(e *foreignvalue.Encoder, value Triple) {
	e.Raw("{\"a\":")
	e.String(value.A)
	e.Raw(",\"A2\":")
	e.Number(value.A2)
	e.Raw(",\"A\":")
	e.Int(value.A_)
	e.Raw("}")
}

type Header struct {
	Content_type2 string `purescript:"content-type"`
	Content_type  string
}

func EncodeJSONHeader(e *foreignvalue.Encoder, value Header) {
	e.Raw("{\"content_type\":")
	e.String(value.Content_type)
	e.Raw(",\"content-type\":")
	e.String(value.Content_type2)
	e.Raw("}")
}

type AOfInt struct {
	A int32
}

type Empty struct{}

type A2A struct {
	A  string
	A2 float64
}

type AOfString struct {
	A string
}

type Content_type struct {
	Content_type string
}
