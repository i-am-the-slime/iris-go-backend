type ListListForeignError struct {
	Cons0 *ListForeignError
	Cons1 *ListListForeignError
}

var SharedListListForeignErrorNil = &ListListForeignError{}

func PureIdentityNonEmptyListForeignError(x any) EitherNonEmptyListForeignErrorForeign {
	return EitherNonEmptyListForeignErrorForeign{Tag: EitherNonEmptyListForeignErrorForeignRight, Right: x}
}

func MapListFunction(s string, value NonEmptyListForeignError) NonEmptyListForeignError {
	return NonEmptyListForeignError{First: &ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: value.First}, Second: MapListFunctionChunkedRevMap(s, SharedListListForeignErrorNil, value.Second)}
}

func MapListFunctionChunkedRevMap(s string, chunksAcc *ListListForeignError, chunk *ListForeignError) *ListForeignError {
	var listListForeignErrorCells alloc.Cells[ListListForeignError]
	for {
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 != SharedListForeignErrorNil {
			xs := chunk.Cons1.Cons1.Cons1
			chunksAcc, chunk = listListForeignErrorCells.New(ListListForeignError{Cons0: chunk, Cons1: chunksAcc}), xs
			continue
		}
		var result *ListForeignError
		if chunk != SharedListForeignErrorNil && chunk.Cons1 != SharedListForeignErrorNil && chunk.Cons1.Cons1 == SharedListForeignErrorNil {
			result = &ListForeignError{Cons0: &ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: chunk.Cons0}, Cons1: &ListForeignError{Cons0: &ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: chunk.Cons1.Cons0}, Cons1: SharedListForeignErrorNil}}
		} else if chunk != SharedListForeignErrorNil && chunk.Cons1 == SharedListForeignErrorNil {
			result = &ListForeignError{Cons0: &ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: chunk.Cons0}, Cons1: SharedListForeignErrorNil}
		} else {
			result = SharedListForeignErrorNil
		}
		return MapListFunctionChunkedRevMapReverseUnrolledMap(s, chunksAcc, result)
	}
}

func MapListFunctionChunkedRevMapReverseUnrolledMap(s string, list *ListListForeignError, acc *ListForeignError) *ListForeignError {
	var foreignErrorCells alloc.Cells[ForeignError]
	var listForeignErrorCells alloc.Cells[ListForeignError]
	for {
		if list != SharedListListForeignErrorNil && list.Cons0 != SharedListForeignErrorNil && list.Cons0.Cons1 != SharedListForeignErrorNil && list.Cons0.Cons1.Cons1 != SharedListForeignErrorNil {
			x1 := list.Cons0.Cons0
			x2 := list.Cons0.Cons1.Cons0
			x3 := list.Cons0.Cons1.Cons1.Cons0
			cs := list.Cons1
			list, acc = cs, listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x1}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x2}), Cons1: listForeignErrorCells.New(ListForeignError{Cons0: foreignErrorCells.New(ForeignError{Tag: ForeignErrorErrorAtProperty, ErrorAtProperty0: s, ErrorAtProperty1: x3}), Cons1: acc})})})
			continue
		}
		return acc
	}
}

// Yoga/JSON/json.go
package json

import (
	"fixture/Data/Either"
	"fixture/Data/Maybe"
	"fixture/Foreign"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/alloc"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/exception"
	"github.com/i-am-the-slime/iris-go/foreignvalue"
	"math"
)

func DecodeJSONPair(d *foreignvalue.Decoder) shared.Pair {
	var a int32
	hasA := false
	var a2 int32
	hasA2 := false
	if d.Object() {
		for {
			switch d.Key() {
			case "A":
				a = d.Int()
				hasA = true
			case "a":
				a2 = d.Int()
				hasA2 = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasA || !hasA2 {
		d.Fail()
	}
	return shared.Pair{A_: a, A: a2}
}

func DecodeJSONTriple(d *foreignvalue.Decoder) shared.Triple {
	var a int32
	hasA := false
	var a2 float64
	hasA2 := false
	var a3 string
	hasA3 := false
	if d.Object() {
		for {
			switch d.Key() {
			case "A":
				a = d.Int()
				hasA = true
			case "A2":
				a2 = d.Number()
				hasA2 = true
			case "a":
				a3 = d.String()
				hasA3 = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasA || !hasA2 || !hasA3 {
		d.Fail()
	}
	return shared.Triple{A_: a, A2: a2, A: a3}
}

func DecodeJSONHeader(d *foreignvalue.Decoder) shared.Header {
	var contenttype string
	hasContenttype := false
	var content_type string
	hasContent_type := false
	if d.Object() {
		for {
			switch d.Key() {
			case "content-type":
				contenttype = d.String()
				hasContenttype = true
			case "content_type":
				content_type = d.String()
				hasContent_type = true
			default:
				d.Skip()
			}
			if !d.MoreMembers() {
				break
			}
		}
	}
	if !hasContenttype || !hasContent_type {
		d.Fail()
	}
	return shared.Header{Content_type2: contenttype, Content_type: content_type}
}

func ReadJSONPair(text string) foreign.EitherNonEmptyListForeignErrorPair {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONPair)
	if ok {
		return foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairRight, Right: decoded}
	}
	performed := direct.CatchException(func(x exception.Error) either.EitherErrorForeign {
		return either.EitherErrorForeign{Tag: either.EitherErrorForeignLeft, Left: x}
	}, func() either.EitherErrorForeign {
		argument := foreignvalue.ParseJSON(text)
		return either.EitherErrorForeign{Tag: either.EitherErrorForeignRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherErrorForeignLeft:
		return foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorForeignError, ForeignError: exception.Message(performed.Left)}, Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherErrorForeignRight
		r := performed.Right
		unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
			return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(r)}, Second: foreign.SharedListForeignErrorNil}}
		}, foreign.PureIdentityNonEmptyListForeignError, "A", r)
		var result2 foreign.EitherNonEmptyListForeignErrorInt
		switch unsafeReadPropImpl.Tag {
		case foreign.EitherNonEmptyListForeignErrorForeignLeft:
			result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: unsafeReadPropImpl.Left}
		default: // foreign.EitherNonEmptyListForeignErrorForeignRight
			b := unsafeReadPropImpl.Right
			if foreignvalue.TagOf(b) == "Number" {
				number := b.(float64)
				var integer maybe.Int
				if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
					integer = maybe.Int(int32(number))
				} else {
					integer = maybe.NoInt
				}
				if integer == maybe.NoInt {
					result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Int", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil}}
				} else {
					result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntRight, Right: int32(integer)}
				}
			} else {
				result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Int", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil}}
			}
		}
		var result foreign.EitherNonEmptyListForeignErrorFnAOfIntPair
		switch result2.Tag {
		case foreign.EitherNonEmptyListForeignErrorIntRight:
			result = foreign.EitherNonEmptyListForeignErrorFnAOfIntPair{Tag: foreign.EitherNonEmptyListForeignErrorFnAOfIntPairRight, Right: func(r1 shared.AOfInt) shared.Pair {
				return shared.Pair{A: r1.A, A_: result2.Right}
			}}
		default: // foreign.EitherNonEmptyListForeignErrorIntLeft
			result = foreign.EitherNonEmptyListForeignErrorFnAOfIntPair{Tag: foreign.EitherNonEmptyListForeignErrorFnAOfIntPairLeft, Left: foreign.MapListFunction("A", result2.Left)}
		}
		unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
			return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(r)}, Second: foreign.SharedListForeignErrorNil}}
		}, foreign.PureIdentityNonEmptyListForeignError, "a", r)
		var result3 foreign.EitherNonEmptyListForeignErrorInt
		switch unsafeReadPropImpl2.Tag {
		case foreign.EitherNonEmptyListForeignErrorForeignLeft:
			result3 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: unsafeReadPropImpl2.Left}
		default: // foreign.EitherNonEmptyListForeignErrorForeignRight
			b := unsafeReadPropImpl2.Right
			if foreignvalue.TagOf(b) == "Number" {
				number := b.(float64)
				var integer maybe.Int
				if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
					integer = maybe.Int(int32(number))
				} else {
					integer = maybe.NoInt
				}
				if integer == maybe.NoInt {
					result3 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Int", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil}}
				} else {
					result3 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntRight, Right: int32(integer)}
				}
			} else {
				result3 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Int", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil}}
			}
		}
		var result4 foreign.EitherNonEmptyListForeignErrorFnEmptyAOfInt
		switch result3.Tag {
		case foreign.EitherNonEmptyListForeignErrorIntRight:
			result4 = foreign.EitherNonEmptyListForeignErrorFnEmptyAOfInt{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntRight, Right: func(_ shared.Empty) shared.AOfInt {
				return shared.AOfInt{A: result3.Right}
			}}
		default: // foreign.EitherNonEmptyListForeignErrorIntLeft
			result4 = foreign.EitherNonEmptyListForeignErrorFnEmptyAOfInt{Tag: foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntLeft, Left: foreign.MapListFunction("a", result3.Left)}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfIntPairRight && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntRight {
			return foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairRight, Right: result.Right(result4.Right(shared.Empty{}))}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfIntPairLeft && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntLeft {
			return foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairLeft, Left: foreign.NonEmptyListForeignError{First: result.Left.First, Second: ReadJSONPairGoReusing(&foreign.ListForeignError{Cons0: result4.Left.First, Cons1: result4.Left.Second}, ReadJSONPairGo(foreign.SharedListForeignErrorNil, result.Left.Second))}}
		}
		if result.Tag == foreign.EitherNonEmptyListForeignErrorFnAOfIntPairRight && result4.Tag == foreign.EitherNonEmptyListForeignErrorFnEmptyAOfIntLeft {
			return foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairLeft, Left: result4.Left}
		}
		return foreign.EitherNonEmptyListForeignErrorPair{Tag: foreign.EitherNonEmptyListForeignErrorPairLeft, Left: result.Left}
	}
}

func ReadJSONTriple(text string) foreign.EitherNonEmptyListForeignErrorTriple {
	decoded, ok := foreignvalue.Decode(text, DecodeJSONTriple)
	if ok {
		return foreign.EitherNonEmptyListForeignErrorTriple{Tag: foreign.EitherNonEmptyListForeignErrorTripleRight, Right: decoded}
	}
	performed := direct.CatchException(func(x exception.Error) either.EitherErrorForeign {
		return either.EitherErrorForeign{Tag: either.EitherErrorForeignLeft, Left: x}
	}, func() either.EitherErrorForeign {
		argument := foreignvalue.ParseJSON(text)
		return either.EitherErrorForeign{Tag: either.EitherErrorForeignRight, Right: argument}
	})
	switch performed.Tag {
	case either.EitherErrorForeignLeft:
		return foreign.EitherNonEmptyListForeignErrorTriple{Tag: foreign.EitherNonEmptyListForeignErrorTripleLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorForeignError, ForeignError: exception.Message(performed.Left)}, Second: foreign.SharedListForeignErrorNil}}
	default: // either.EitherErrorForeignRight
		r := performed.Right
		unsafeReadPropImpl := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
			return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(r)}, Second: foreign.SharedListForeignErrorNil}}
		}, foreign.PureIdentityNonEmptyListForeignError, "A", r)
		var result2 foreign.EitherNonEmptyListForeignErrorInt
		switch unsafeReadPropImpl.Tag {
		case foreign.EitherNonEmptyListForeignErrorForeignLeft:
			result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: unsafeReadPropImpl.Left}
		default: // foreign.EitherNonEmptyListForeignErrorForeignRight
			b := unsafeReadPropImpl.Right
			if foreignvalue.TagOf(b) == "Number" {
				number := b.(float64)
				var integer maybe.Int
				if math.Trunc(number) == number && (number >= math.MinInt32 && number <= math.MaxInt32) {
					integer = maybe.Int(int32(number))
				} else {
					integer = maybe.NoInt
				}
				if integer == maybe.NoInt {
					result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Int", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil}}
				} else {
					result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntRight, Right: int32(integer)}
				}
			} else {
				result2 = foreign.EitherNonEmptyListForeignErrorInt{Tag: foreign.EitherNonEmptyListForeignErrorIntLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Int", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil}}
			}
		}
		var result foreign.EitherNonEmptyListForeignErrorFnA2ATriple
		switch result2.Tag {
		case foreign.EitherNonEmptyListForeignErrorIntRight:
			result = foreign.EitherNonEmptyListForeignErrorFnA2ATriple{Tag: foreign.EitherNonEmptyListForeignErrorFnA2ATripleRight, Right: func(r1 shared.A2A) shared.Triple {
				return shared.Triple{A2: r1.A2, A: r1.A, A_: result2.Right}
			}}
		default: // foreign.EitherNonEmptyListForeignErrorIntLeft
			result = foreign.EitherNonEmptyListForeignErrorFnA2ATriple{Tag: foreign.EitherNonEmptyListForeignErrorFnA2ATripleLeft, Left: foreign.MapListFunction("A", result2.Left)}
		}
		unsafeReadPropImpl2 := foreignvalue.UnsafeReadPropImpl(func() foreign.EitherNonEmptyListForeignErrorForeign {
			return foreign.EitherNonEmptyListForeignErrorForeign{Tag: foreign.EitherNonEmptyListForeignErrorForeignLeft, Left: foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "object", TypeMismatch1: foreignvalue.TypeOf(r)}, Second: foreign.SharedListForeignErrorNil}}
		}, foreign.PureIdentityNonEmptyListForeignError, "A2", r)
		var result3 foreign.EitherNonEmptyListForeignErrorFnAOfStringA2A
		switch unsafeReadPropImpl2.Tag {
		case foreign.EitherNonEmptyListForeignErrorForeignLeft:
			result3 = foreign.EitherNonEmptyListForeignErrorFnAOfStringA2A{Tag: foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ALeft, Left: foreign.MapListFunction("A2", unsafeReadPropImpl2.Left)}
		default: // foreign.EitherNonEmptyListForeignErrorForeignRight
			b := unsafeReadPropImpl2.Right
			if foreignvalue.TagOf(b) == "Number" {
				result3 = foreign.EitherNonEmptyListForeignErrorFnAOfStringA2A{Tag: foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ARight, Right: func(r1 shared.AOfString) shared.A2A {
					return shared.A2A{A: r1.A, A2: b.(float64)}
				}}
			} else {
				result3 = foreign.EitherNonEmptyListForeignErrorFnAOfStringA2A{Tag: foreign.EitherNonEmptyListForeignErrorFnAOfStringA2ALeft, Left: foreign.MapListFunction("A2", foreign.NonEmptyListForeignError{First: &foreign.ForeignError{Tag: foreign.ForeignErrorTypeMismatch, TypeMismatch0: "Number", TypeMismatch1: foreignvalue.TagOf(b)}, Second: foreign.SharedListForeignErrorNil})}
