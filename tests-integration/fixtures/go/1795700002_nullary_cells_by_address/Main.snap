// main.go
package main

import "fixture/shared"

type Route struct {
	Trip1 *Route
	Trip0 int32
}

var sharedRouteHome = &Route{}

var sharedRouteAway = &Route{}

func Trip(trip0 int, trip1 *Route) *Route {
	return &Route{Trip0: int32(trip0), Trip1: trip1}
}

var main_ = initializeMain_()

func initializeMain_() shared.MainResult {
	return shared.MainResult{Legs: legsTrip(1, Trip(2, sharedRouteAway)), Away: endsAway(sharedRouteAway), First: legsTrip(3, sharedRouteHome), Goes: true}
}

func legs(value *Route) int {
	if value == sharedRouteHome {
		return 0
	}
	if value == sharedRouteAway {
		return 100
	}
	return int(value.Trip0) + legs(value.Trip1)
}

func endsAway(value *Route) bool {
	for {
		if value != sharedRouteHome && value != sharedRouteAway {
			value = value.Trip1
			continue
		}
		if value == sharedRouteAway {
			return true
		}
		return false
	}
}

func legsTrip(n int, rest *Route) int {
	return n + legs(rest)
}

func main() {
	_ = main_
}

// shared/shared.go
package shared

type MainResult struct {
	First int
	Legs  int
	Away  bool
	Goes  bool
}

// note: the entry's value of type { away, first, goes, legs } is not printed; use an Effect entry or a value of a printable type (Int, Number, Boolean, Char, String or an Array of them)
