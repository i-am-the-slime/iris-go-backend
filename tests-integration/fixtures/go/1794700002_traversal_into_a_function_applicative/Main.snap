// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []int {
	append_ := direct.Appender[int]()
	array := []int{1, 2, 3}
	accumulator := func(_ int, _ int) []int {
		return []int{}
	}
	for _, element := range array {
		accumulator2 := accumulator
		accumulator = func(scale int, offset int) []int {
			return append_(accumulator2(scale, offset))(element*scale + offset)
		}
	}
	return accumulator(3, 1)
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
