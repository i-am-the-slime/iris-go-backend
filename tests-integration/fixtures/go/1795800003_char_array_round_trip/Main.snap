// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	array := prim.StringToCharArray("banana")
	mapped := make([]rune, len(array))
	for index, c := range array {
		var result rune
		if c == 'a' {
			result = 'A'
		} else {
			result = c
		}
		mapped[index] = result
	}
	return []string{prim.CharArrayToString([]rune{'A', 'A', 'c'}), prim.CharArrayToString([]rune{'é', 'A'}), prim.CharArrayToString(mapped)}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
