// Data/Ordering/ordering.go
package ordering

type Ordering uint8

const (
	OrderingLT Ordering = iota
	OrderingGT
	OrderingEQ
)

func AppendShowArrayOrdering(buffer []byte, array []Ordering) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = AppendShowOrdering(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowOrdering(buffer []byte, ordering Ordering) []byte {
	switch ordering {
	case OrderingLT:
		buffer = append(buffer, "LT"...)
	case OrderingGT:
		buffer = append(buffer, "GT"...)
	default: // OrderingEQ
		buffer = append(buffer, "EQ"...)
	}
	return buffer
}

func ArrayOrdering(array []Ordering) string {
	return string(AppendShowArrayOrdering(nil, array))
}

// Data/Show/show.go
package show

import (
	"github.com/i-am-the-slime/iris-go/prim"
	"strconv"
)

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayBoolean(buffer []byte, array []bool) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendBool(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func AppendShowArrayString(buffer []byte, array []string) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = prim.AppendShowString(buffer, element)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

func ArrayBoolean(array []bool) string {
	return string(AppendShowArrayBoolean(nil, array))
}

func ArrayString(array []string) string {
	return string(AppendShowArrayString(nil, array))
}

// main.go
package main

import (
	"fixture/Data/Ordering"
	datashow "fixture/Data/Show"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/direct"
	"slices"
	"strconv"
	"strings"
)

type Suit uint8

const (
	SuitHearts Suit = iota
	SuitSpades
	SuitClubs
)

type Card struct {
	Rank int
	Suit Suit
}

type Expression struct {
	Add0 *Expression
	Add1 *Expression
	Leaf int32
	Tag  uint8
}

const (
	ExpressionLeaf = iota
	ExpressionAdd
)

var main_ = initializeMain_()

func initializeMain_() []string {
	mapped := make([]string, len(cards))
	for index, element := range cards {
		mapped[index] = describe(element)
	}
	array := direct.SortBy(cards, func(left Card, right Card) int {
		switch compare(left, right) {
		case ordering.OrderingLT:
			return -1
		case ordering.OrderingGT:
			return 1
		}
		return 0
	})
	count := min(len(cards), len(array))
	built := make([]bool, count)
	for index := range count {
		element := sameCard(cards[index], array[index])
		built[index] = element
	}
	sorted := slices.Clone(suits)
	slices.Sort(sorted)
	mapped2 := make([]string, len(sorted))
	for index, element := range sorted {
		mapped2[index] = show(element)
	}
	sorted2 := slices.Clone(suits)
	slices.Sort(sorted2)
	count2 := min(len(suits), len(sorted2))
	built2 := make([]ordering.Ordering, count2)
	for index := range count2 {
		element := ordered(suits[index], sorted2[index])
		built2[index] = element
	}
	array2 := []int{3, 1}
	array3 := []int{2, 2}
	count3 := min(len(array2), len(array3))
	built3 := make([]bool, count3)
	for index := range count3 {
		value := array2[index]
		value2 := array3[index]
		element := value > value2
		built3[index] = element
	}
	expressions := make([]Expression, 5)
	expressions[0] = Expression{Tag: ExpressionAdd, Add0: &expressions[1], Add1: &expressions[2]}
	expressions[1] = Expression{Tag: ExpressionLeaf, Leaf: 1}
	expressions[2] = Expression{Tag: ExpressionAdd, Add0: &expressions[3], Add1: &expressions[4]}
	expressions[3] = Expression{Tag: ExpressionLeaf, Leaf: 2}
	expressions[4] = Expression{Tag: ExpressionLeaf, Leaf: 3}
	array4 := []*Expression{&expressions[0]}
	mapped3 := make([]int, len(array4))
	for index, element := range array4 {
		mapped3[index] = scaled(3, element)
	}
	mapped4 := make([]bool, len(suits))
	for index, element := range suits {
		mapped4[index] = isSpades(element)
	}
	return []string{datashow.ArrayString(mapped), datashow.ArrayBoolean(built), datashow.ArrayString(mapped2), ordering.ArrayOrdering(built2), datashow.ArrayBoolean(built3), datashow.ArrayInt(mapped3), datashow.ArrayBoolean(mapped4)}
}

func describe(card Card) string {
	return strconv.Itoa(card.Rank) + " of " + show(card.Suit)
}

var cards = initializeCards()

func initializeCards() []Card {
	mapped := make([]Card, len(suits))
	for index, suit := range suits {
		mapped[index] = Card{Rank: 7, Suit: suit}
	}
	return mapped
}

func sameCard(a Card, b Card) bool {
	return a == b
}

func show(suit Suit) string {
	switch suit {
	case SuitHearts:
		return "hearts"
	case SuitSpades:
		return "spades"
	default: // SuitClubs
		return "clubs"
	}
}

var suits []Suit = []Suit{SuitClubs, SuitHearts, SuitSpades}

func ordered(left Suit, right Suit) ordering.Ordering {
	if left == right {
		return ordering.OrderingEQ
	}
	if left < right {
		return ordering.OrderingLT
	}
	return ordering.OrderingGT
}

func scaled(factor int, value *Expression) int {
	switch value.Tag {
	case ExpressionLeaf:
		return int(value.Leaf) * factor
	default: // ExpressionAdd
		return scaled(factor, value.Add0) + scaled(factor, value.Add1)
	}
}

func isSpades(left Suit) bool {
	return left == SuitSpades
}

func compare(ra Card, rb Card) ordering.Ordering {
	i := ra.Rank
	i2 := rb.Rank
	var left ordering.Ordering
	if i < i2 {
		left = ordering.OrderingLT
	} else if i == i2 {
		left = ordering.OrderingEQ
	} else {
		left = ordering.OrderingGT
	}
	if left != ordering.OrderingEQ {
		return left
	}
	left2 := ra.Suit
	right := rb.Suit
	var left3 ordering.Ordering
	if left2 == right {
		left3 = ordering.OrderingEQ
	} else if left2 < right {
		left3 = ordering.OrderingLT
	} else {
		left3 = ordering.OrderingGT
	}
	if left3 != ordering.OrderingEQ {
		return left3
	}
	return ordering.OrderingEQ
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
