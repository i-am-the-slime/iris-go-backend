// main.go
package main

import "fmt"

type StepInt struct {
	More0 func(struct{}) StepInt
	Done0 int32
	Tag   uint8
}

const (
	StepIntMore = iota
	StepIntDone
)

type StepInt2 struct {
	StepInt func(func(func(struct{}) StepInt) StepInt, func(int32) StepInt) StepInt
}

var main_ []int32 = []int32{mainGo(countdown(10, 0).StepInt(func(value0 func(struct{}) StepInt) StepInt {
	return StepInt{Tag: StepIntMore, More0: value0}
}, func(value02 int32) StepInt {
	return StepInt{Tag: StepIntDone, Done0: value02}
}))}

func countdown(n int32, total int32) StepInt2 {
	if n <= 0 {
		return StepInt2{StepInt: func(_ func(func(struct{}) StepInt) StepInt, done func(int32) StepInt) StepInt {
			return done(total)
		}}
	}
	return StepInt2{StepInt: func(more func(func(struct{}) StepInt) StepInt, done2 func(int32) StepInt) StepInt {
		return more(func(_ struct{}) StepInt {
			n2 := countdown(n - 1, total + n)
			return more(func(_ struct{}) StepInt {
				return n2.StepInt(more, done2)
			})
		})
	}}
}

func mainGo(value StepInt) int32 {
	for {
		switch value.Tag {
		case StepIntMore:
			next := value.More0
			value = next(struct{}{})
			continue
		default: // StepIntDone
			a := value.Done0
			return a
		}
	}
}

func main() {
	fmt.Println(main_)
}
