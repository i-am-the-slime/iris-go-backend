// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"strings"
)

type Step struct {
	More func(struct{}) Step
	Done int
	Tag  uint8
}

const (
	StepMore = iota
	StepDone
)

func More(more func(struct{}) Step) Step {
	return Step{Tag: StepMore, More: more}
}

func Done(done int) Step {
	return Step{Tag: StepDone, Done: done}
}

type Count func(func(func(struct{}) Step) Step, func(int) Step) Step

var main_ = initializeMain_()

func initializeMain_() []int {
	return []int{mainGo(countdown(10, 0)(More, Done))}
}

func countdown(n int, total int) Count {
	if n <= 0 {
		return func(_ func(func(struct{}) Step) Step, done func(int) Step) Step {
			return done(total)
		}
	}
	return func(more func(func(struct{}) Step) Step, done func(int) Step) Step {
		return more(func(_ struct{}) Step {
			n2 := countdown(n-1, total+n)
			return more(func(_ struct{}) Step {
				return n2(more, done)
			})
		})
	}
}

func mainGo(value Step) int {
	for {
		switch value.Tag {
		case StepMore:
			next := value.More
			value = next(struct{}{})
			continue
		default: // StepDone
			a := value.Done
			return a
		}
	}
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
