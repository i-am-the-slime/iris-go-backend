// main.go
package main

import "fmt"

type StepInt struct {
	More func(struct{}) StepInt
	Done int32
	Tag  uint8
}

const (
	StepIntMore = iota
	StepIntDone
)

func More(more func(struct{}) StepInt) StepInt {
	return StepInt{Tag: StepIntMore, More: more}
}

func Done(done int32) StepInt {
	return StepInt{Tag: StepIntDone, Done: done}
}

type Count func(func(func(struct{}) StepInt) StepInt, func(int32) StepInt) StepInt

var main_ []int32 = []int32{mainGo(countdown(10, 0)(More, Done))}

func countdown(n int32, total int32) Count {
	if n <= 0 {
		return func(_ func(func(struct{}) StepInt) StepInt, done func(int32) StepInt) StepInt {
			return done(total)
		}
	}
	return func(more func(func(struct{}) StepInt) StepInt, done func(int32) StepInt) StepInt {
		return more(func(_ struct{}) StepInt {
			n2 := countdown(n - 1, total + n)
			return more(func(_ struct{}) StepInt {
				return n2(more, done)
			})
		})
	}
}

func mainGo(value StepInt) int32 {
	for {
		switch value.Tag {
		case StepIntMore:
			next := value.More
			value = next(struct{}{})
			continue
		default: // StepIntDone
			a := value.Done
			return a
		}
	}
}

func main() {
	fmt.Println(main_)
}
