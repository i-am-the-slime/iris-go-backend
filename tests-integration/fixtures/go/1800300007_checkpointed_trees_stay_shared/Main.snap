// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"slices"
	"strings"
)

type Tree struct {
	Node0 *Tree
	Node2 *Tree
	Node1 int32
}

var sharedTreeLeaf = &Tree{}

type Tuple struct {
	First  *Tree
	Second []*Tree
}

func Node(node0 *Tree, node1 int, node2 *Tree) *Tree {
	return &Tree{Node0: node0, Node1: int32(node1), Node2: node2}
}

var main_ = initializeMain_()

func initializeMain_() []int {
	scrutinee := mainGoReusing(sharedTreeLeaf, []*Tree{}, 9)
	first := total(scrutinee.First)
	first2 := total(mainGoReusing2(sharedTreeLeaf, 9))
	built := make([]int, len(scrutinee.Second)+2)
	built[0], built[1] = first, first2
	for index, element := range scrutinee.Second {
		built[index+2] = total(element)
	}
	return built
}

func total(value *Tree) int {
	if value == sharedTreeLeaf {
		return 0
	}
	return total(value.Node0) + int(value.Node1) + total(value.Node2)
}

func inserted(key int, value *Tree) *Tree {
	if value == sharedTreeLeaf {
		return Node(sharedTreeLeaf, key, sharedTreeLeaf)
	}
	left := value.Node0
	here := int(value.Node1)
	right := value.Node2
	if key < here {
		return Node(inserted(key, left), here, right)
	}
	if key > here {
		return Node(left, here, inserted(key, right))
	}
	return Node(left, key, right)
}

func mainGo(tree *Tree, checkpoints []*Tree, remaining int) Tuple {
	checkpoints = slices.Clip(checkpoints)
	for {
		if remaining <= 0 {
			return Tuple{First: tree, Second: checkpoints}
		}
		next := inserted(remaining, tree)
		var result []*Tree
		if remaining%3 == 0 {
			result = append(checkpoints, next)
		} else {
			result = checkpoints
		}
		tree, checkpoints, remaining = next, result, remaining-1
	}
}

func mainGoReusing(tree *Tree, checkpoints []*Tree, remaining int) Tuple {
	if remaining <= 0 {
		return Tuple{First: tree, Second: checkpoints}
	}
	next := insertedReusing(remaining, tree)
	var result []*Tree
	if remaining%3 == 0 {
		result = array.Snoc(checkpoints, next)
	} else {
		result = checkpoints
	}
	return mainGo(next, result, remaining-1)
}

func mainGoReusing2(tree *Tree, remaining int) *Tree {
	for {
		if remaining <= 0 {
			return tree
		}
		tree, remaining = insertedReusing(remaining, tree), remaining-1
	}
}

func insertedReusing(key int, value *Tree) *Tree {
	if value == sharedTreeLeaf {
		return Node(sharedTreeLeaf, key, sharedTreeLeaf)
	}
	left := value.Node0
	here := int(value.Node1)
	right := value.Node2
	if key < here {
		field := insertedReusing(key, left)
		value.Node0 = field
		return value
	}
	if key > here {
		field := insertedReusing(key, right)
		value.Node2 = field
		return value
	}
	value.Node1 = int32(key)
	return value
}

func main() {
	texts := make([]string, 0, len(main_))
	for _, element := range main_ {
		texts = append(texts, prim.ShowInt(element))
	}
	console.Print("[" + strings.Join(texts, " ") + "]")
}
