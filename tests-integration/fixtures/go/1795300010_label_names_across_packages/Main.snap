// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, "["...)
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ","...)
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, "]"...)
	return buffer
}

// Data/Variant/variant.go
package variant

type AX_respondNowALater struct {
	Later  string
	Field0 int32
	Tag    uint8
}

const (
	AX_respondNowALaterA = iota
	AX_respondNowALaterX_respondNow
	AX_respondNowALaterA2
	AX_respondNowALaterLater
)

type X_respondNowALater struct {
	Later  string
	Field0 int32
	Tag    uint8
}

const (
	X_respondNowALaterX_respondNow = iota
	X_respondNowALaterA
	X_respondNowALaterLater
)

type X_respondNowLater struct {
	Later        string
	X_respondNow int32
	Tag          uint8
}

const (
	X_respondNowLaterX_respondNow = iota
	X_respondNowLaterLater
)

// Labels/labels.go
package labels

import (
	"fixture/Data/Variant"
	"strconv"
)

func Describe(variant2 variant.AX_respondNowALater) string {
	switch variant2.Tag {
	case variant.AX_respondNowALaterA:
		return "A " + strconv.Itoa(int(variant2.Field0))
	case variant.AX_respondNowALaterX_respondNow:
		return DescribeX2(variant.X_respondNowALater{Tag: variant.X_respondNowALaterX_respondNow, Field0: variant2.Field0})
	case variant.AX_respondNowALaterA2:
		return DescribeX2(variant.X_respondNowALater{Tag: variant.X_respondNowALaterA, Field0: variant2.Field0})
	default: // variant.AX_respondNowALaterLater
		return DescribeX2(variant.X_respondNowALater{Tag: variant.X_respondNowALaterLater, Later: variant2.Later})
	}
}

func DescribeX(variant2 variant.X_respondNowLater) string {
	switch variant2.Tag {
	case variant.X_respondNowLaterX_respondNow:
		return "now " + strconv.Itoa(int(variant2.X_respondNow))
	default: // variant.X_respondNowLaterLater
		return "later " + variant2.Later
	}
}

func DescribeX2(variant2 variant.X_respondNowALater) string {
	switch variant2.Tag {
	case variant.X_respondNowALaterX_respondNow:
		return DescribeX(variant.X_respondNowLater{Tag: variant.X_respondNowLaterX_respondNow, X_respondNow: variant2.Field0})
	case variant.X_respondNowALaterA:
		return "a " + strconv.Itoa(int(variant2.Field0))
	default: // variant.X_respondNowALaterLater
		return DescribeX(variant.X_respondNowLater{Tag: variant.X_respondNowLaterLater, Later: variant2.Later})
	}
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/Data/Variant"
	"fixture/Labels"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	updated := shared.Odd{X_respondNow: 1, X1st: 2, Content_type: "dash", Content_type2: "underscore", X2: 2, X: 3, Über: 4}
	updated.X_respondNow = 10
	updated.Content_type = "changed"
	replies := []variant.AX_respondNowALater{{Tag: variant.AX_respondNowALaterX_respondNow, Field0: 7}, {Tag: variant.AX_respondNowALaterA2, Field0: 1}, {Tag: variant.AX_respondNowALaterA, Field0: 2}, {Tag: variant.AX_respondNowALaterLater, Later: "soon"}}
	mapped := make([]string, len(replies))
	for index, element := range replies {
		mapped[index] = labels.Describe(element)
	}
	return array.Append(mapped, []string{string(show.AppendShowArrayInt(nil, []int32{updated.X_respondNow, updated.X1st, updated.X2, updated.X, updated.Über})), updated.Content_type + " " + updated.Content_type2, strconv.Itoa(len(replies))})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Odd struct {
	Content_type  string
	Content_type2 string
	X1st          int32
	X             int32
	X_respondNow  int32
	X2            int32
	Über          int32
}
