// Data/Show/show.go
package show

import "strconv"

func Show(i int32) string {
	return strconv.Itoa(int(i))
}

func AppendShowArrayInt(buffer []byte, array []int32) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

// Data/Variant/variant.go
package variant

type AX_respondNowALater struct {
	Later  string
	Field0 int32
	Tag    uint8
}

const (
	AX_respondNowALaterA = iota
	AX_respondNowALaterX_respondNow
	AX_respondNowALaterA2
	AX_respondNowALaterLater
)

type X_respondNowALater struct {
	Later  string
	Field0 int32
	Tag    uint8
}

const (
	X_respondNowALaterX_respondNow = iota
	X_respondNowALaterA
	X_respondNowALaterLater
)

func X_respondNowAX_respondNowALater(field0 int32) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterX_respondNow, Field0: field0}
}

func AAX_respondNowALater(field0 int32) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterA2, Field0: field0}
}

func AAX_respondNowALater2(field0 int32) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterA, Field0: field0}
}

func LaterAX_respondNowALater(later string) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterLater, Later: later}
}

func X_respondNowX_respondNowALater(field0 int32) X_respondNowALater {
	return X_respondNowALater{Tag: X_respondNowALaterX_respondNow, Field0: field0}
}

func AX_respondNowALater2(field0 int32) X_respondNowALater {
	return X_respondNowALater{Tag: X_respondNowALaterA, Field0: field0}
}

func LaterX_respondNowALater(later string) X_respondNowALater {
	return X_respondNowALater{Tag: X_respondNowALaterLater, Later: later}
}

// Labels/labels.go
package labels

import (
	"fixture/Data/Variant"
	"strconv"
)

func Describe(variant2 variant.AX_respondNowALater) string {
	switch variant2.Tag {
	case variant.AX_respondNowALaterA:
		return "A " + strconv.Itoa(int(variant2.Field0))
	case variant.AX_respondNowALaterX_respondNow:
		return DescribeX(variant.X_respondNowX_respondNowALater(variant2.Field0))
	case variant.AX_respondNowALaterA2:
		return DescribeX(variant.AX_respondNowALater2(variant2.Field0))
	default: // variant.AX_respondNowALaterLater
		return DescribeX(variant.LaterX_respondNowALater(variant2.Later))
	}
}

func DescribeX(variant2 variant.X_respondNowALater) string {
	switch variant2.Tag {
	case variant.X_respondNowALaterX_respondNow:
		return "now " + strconv.Itoa(int(variant2.Field0))
	case variant.X_respondNowALaterA:
		return "a " + strconv.Itoa(int(variant2.Field0))
	default: // variant.X_respondNowALaterLater
		return "later " + variant2.Later
	}
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/Data/Variant"
	"fixture/Labels"
	"fixture/shared"
	"github.com/i-am-the-slime/iris-go/array"
	"github.com/i-am-the-slime/iris-go/console"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	updated := shared.Odd{X_respondNow: 1, X1st: 2, Content_type2: "dash", Content_type: "underscore", X: 2, X_: 3, Über: 4}
	updated.X_respondNow = 10
	updated.Content_type2 = "changed"
	replies := []variant.AX_respondNowALater{variant.X_respondNowAX_respondNowALater(7), variant.AAX_respondNowALater(1), variant.AAX_respondNowALater2(2), variant.LaterAX_respondNowALater("soon")}
	mapped := make([]string, len(replies))
	for index, element := range replies {
		mapped[index] = labels.Describe(element)
	}
	return array.Append(mapped, []string{string(show.AppendShowArrayInt(nil, []int32{updated.X_respondNow, updated.X1st, updated.X, updated.X_, updated.Über})), updated.Content_type2 + " " + updated.Content_type, strconv.Itoa(len(replies))})
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}

// shared/shared.go
package shared

type Odd struct {
	Content_type2 string `purescript:"content-type"`
	Content_type  string
	X1st          int32 `purescript:"1st"`
	X_            int32 `purescript:"X"`
	X_respondNow  int32 `purescript:"_respondNow"`
	X             int32
	Über          int32
}
