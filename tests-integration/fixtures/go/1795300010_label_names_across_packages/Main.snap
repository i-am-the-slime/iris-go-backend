// Data/Show/show.go
package show

import "strconv"

func AppendShowArrayInt(buffer []byte, array []int) []byte {
	buffer = append(buffer, '[')
	for index, element := range array {
		if index > 0 {
			buffer = append(buffer, ',')
		}
		buffer = strconv.AppendInt(buffer, int64(element), 10)
	}
	buffer = append(buffer, ']')
	return buffer
}

func ArrayInt(array []int) string {
	return string(AppendShowArrayInt(nil, array))
}

// Data/Variant/variant.go
package variant

type AX_respondNowALater struct {
	Later  string
	Field0 int32
	Tag    uint8
}

const (
	AX_respondNowALaterA = iota
	AX_respondNowALaterX_respondNow
	AX_respondNowALaterA2
	AX_respondNowALaterLater
)

type X_respondNowALater struct {
	Later  string
	Field0 int32
	Tag    uint8
}

const (
	X_respondNowALaterX_respondNow = iota
	X_respondNowALaterA
	X_respondNowALaterLater
)

func X_respondNowAX_respondNowALater(field0 int) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterX_respondNow, Field0: int32(field0)}
}

func AAX_respondNowALater(field0 int) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterA2, Field0: int32(field0)}
}

func AAX_respondNowALater2(field0 int) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterA, Field0: int32(field0)}
}

func LaterAX_respondNowALater(later string) AX_respondNowALater {
	return AX_respondNowALater{Tag: AX_respondNowALaterLater, Later: later}
}

func X_respondNowX_respondNowALater(field0 int) X_respondNowALater {
	return X_respondNowALater{Tag: X_respondNowALaterX_respondNow, Field0: int32(field0)}
}

func AX_respondNowALater2(field0 int) X_respondNowALater {
	return X_respondNowALater{Tag: X_respondNowALaterA, Field0: int32(field0)}
}

func LaterX_respondNowALater(later string) X_respondNowALater {
	return X_respondNowALater{Tag: X_respondNowALaterLater, Later: later}
}

// Labels/labels.go
package labels

import (
	"fixture/Data/Variant"
	"strconv"
)

func Describe(variant2 variant.AX_respondNowALater) string {
	switch variant2.Tag {
	case variant.AX_respondNowALaterA:
		return "A " + strconv.Itoa(int(variant2.Field0))
	case variant.AX_respondNowALaterX_respondNow:
		return DescribeFallback(variant.X_respondNowX_respondNowALater(int(variant2.Field0)))
	case variant.AX_respondNowALaterA2:
		return DescribeFallback(variant.AX_respondNowALater2(int(variant2.Field0)))
	default: // variant.AX_respondNowALaterLater
		return DescribeFallback(variant.LaterX_respondNowALater(variant2.Later))
	}
}

func DescribeFallback(variant2 variant.X_respondNowALater) string {
	switch variant2.Tag {
	case variant.X_respondNowALaterX_respondNow:
		return "now " + strconv.Itoa(int(variant2.Field0))
	case variant.X_respondNowALaterA:
		return "a " + strconv.Itoa(int(variant2.Field0))
	default: // variant.X_respondNowALaterLater
		return "later " + variant2.Later
	}
}

// main.go
package main

import (
	"fixture/Data/Show"
	"fixture/Data/Variant"
	"fixture/Labels"
	"github.com/i-am-the-slime/iris-go/console"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{labels.Describe(variant.X_respondNowAX_respondNowALater(7)), labels.Describe(variant.AAX_respondNowALater(1)), labels.Describe(variant.AAX_respondNowALater2(2)), labels.Describe(variant.LaterAX_respondNowALater("soon")), show.ArrayInt([]int{10, 2, 2, 3, 4}), "changed underscore", "4"}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
