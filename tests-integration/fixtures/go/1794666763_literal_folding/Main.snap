// main.go
package main

import (
	"github.com/i-am-the-slime/iris-go/console"
	"github.com/i-am-the-slime/iris-go/prim"
	"math"
	"strconv"
	"strings"
)

var main_ = initializeMain_()

func initializeMain_() []string {
	return []string{"-2147483648/" + strconv.Itoa(int(opaqueInt(12345, 2147483647)+1)), "2147483647/" + strconv.Itoa(int(opaqueInt(12345, -2147483648)-1)), "0/" + strconv.Itoa(int(opaqueInt(12345, 65536)*65536)), "1/" + strconv.Itoa(int(opaqueInt(12345, 2147483647)*2147483647)), "-67153019/" + strconv.Itoa(int(opaqueInt(12345, 123456789)*987654321)), "-2147483648/" + strconv.Itoa(int(-opaqueInt(12345, -2147483648))), "3/" + strconv.Itoa(int(prim.IntDiv(opaqueInt(12345, 7), 2))), "-4/" + strconv.Itoa(int(prim.IntDiv(opaqueInt(12345, -7), 2))), "-3/" + strconv.Itoa(int(prim.IntDiv(opaqueInt(12345, 7), -2))), "4/" + strconv.Itoa(int(prim.IntDiv(opaqueInt(12345, -7), -2))), "1/" + strconv.Itoa(int(prim.IntMod(opaqueInt(12345, 7), -2))), "1/" + strconv.Itoa(int(prim.IntMod(opaqueInt(12345, -7), 2))), "1/" + strconv.Itoa(int(prim.IntMod(opaqueInt(12345, -7), -2))), "0/" + strconv.Itoa(int(prim.IntDiv(opaqueInt(12345, 5), 0))), "0/" + strconv.Itoa(int(prim.IntMod(opaqueInt(12345, 5), 0))), strconv.Itoa(int(prim.IntDiv(-2147483648, -1))) + "/" + strconv.Itoa(int(prim.IntDiv(opaqueInt(12345, -2147483648), -1))), prim.ShowNumber(0.30000000000000004) + "/" + prim.ShowNumber(opaqueNumber(12345.0, 0.1)+0.2), prim.ShowNumber(math.Inf(-1)) + "/" + prim.ShowNumber(1.0/(opaqueNumber(12345.0, 0.0)*-1.0)), prim.ShowNumber(math.Inf(-1)) + "/" + prim.ShowNumber(1.0/opaqueNumber(12345.0, math.Copysign(0, -1))), prim.ShowNumber(math.NaN()) + "/" + prim.ShowNumber(opaqueNumber(12345.0, 0.0)/0.0), prim.ShowNumber(math.Inf(1)) + "/" + prim.ShowNumber(opaqueNumber(12345.0, 1.0e308)*10.0), "false/" + strconv.FormatBool(opaqueNumber(12345.0, 0.0)/0.0 == math.NaN()), "false/" + strconv.FormatBool(opaqueNumber(12345.0, 0.0)/0.0 < 1.0), "true/" + strconv.FormatBool(!(opaqueNumber(12345.0, 0.0)/0.0 < 1.0)), "true/" + strconv.FormatBool(opaqueNumber(12345.0, math.Copysign(0, -1)) == 0.0), prim.ShowNumber(0.3333333333333333) + "/" + prim.ShowNumber(opaqueNumber(12345.0, 1.0)/3.0), prim.ShowString("ab") + "/" + prim.ShowString(opaqueString("sentinel", "a")+"b"), "false/" + strconv.FormatBool(prim.CompareString(opaqueString("sentinel", "é"), "z") < 0), "true/" + strconv.FormatBool(prim.CompareString(opaqueString("sentinel", "😀"), "￿") < 0), "true/true", "false/" + strconv.FormatBool(opaqueInt(12345, 3) >= 4), "true/" + strconv.FormatBool(opaqueInt(12345, 1) < 2), "false/" + strconv.FormatBool(opaqueInt(12345, 1) >= 2), strconv.Itoa(int(opaqueInt(12345, 5)+3)) + "/" + strconv.Itoa(int(opaqueInt(12345, 5)+3)), strconv.Itoa(int(opaqueInt(12345, 1)+-2147483648)) + "/" + strconv.Itoa(int(opaqueInt(12345, 2147483647)+2)), prim.ShowString("xy"+opaqueString("sentinel", "z")) + "/" + prim.ShowString("xy"+opaqueString("sentinel", "z")), strconv.FormatBool(opaqueInt(12345, 3) < 4) + "/" + strconv.FormatBool(opaqueInt(12345, 0) >= 0 && opaqueInt(12345, 3) < 4)}
}

func opaqueInt(sentinel int32, x int32) int32 {
	for {
		if x == sentinel {
			continue
		}
		return x
	}
}

func opaqueNumber(sentinel float64, x float64) float64 {
	for {
		if x == sentinel {
			continue
		}
		return x
	}
}

func opaqueString(sentinel string, x string) string {
	for {
		if x == sentinel {
			continue
		}
		return x
	}
}

func main() {
	console.Print("[" + strings.Join(main_, " ") + "]")
}
